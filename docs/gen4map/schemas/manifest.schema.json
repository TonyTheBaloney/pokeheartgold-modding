{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gen4map/manifest.schema.json",
  "title": "Gen 4 map project manifest (gen4map.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "game",
    "paths",
    "binaries",
    "features"
  ],
  "properties": {
    "format": {
      "const": "gen4map"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "versions"
      ],
      "properties": {
        "family": {
          "enum": [
            "DP",
            "PLATINUM",
            "HGSS"
          ]
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": "string"
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "binaries": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        ]
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  }
}
