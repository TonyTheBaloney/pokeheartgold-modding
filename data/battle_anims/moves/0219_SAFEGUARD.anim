    LoadBattlerSpriteResources 2
    LoadBattlerSpriteResources 3
    CreateBattlerSprite 4, 0, 0, 0
    CreateBattlerSprite 5, 0, 1, 1
    CreateBattlerSprite 6, 0, 2, 2
