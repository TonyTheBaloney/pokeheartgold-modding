# member 104: DOUBLE_TEAM
    InitBattlerSpriteManager
    LoadBattlerSpriteResources 0
    LoadBattlerSpriteResources 1
    CreateBattlerSprite 0, 0, 0, 0
    CreateBattlerSprite 0, 0, 1, 0
    CreateBattlerSprite 0, 0, 2, 1
    CreateBattlerSprite 0, 0, 3, 1
    LoadBattlerSpriteResources 4
    CreateBattlerSprite 2, 0, 4, 4
    StartBattlerSpriteDraw 2, 0, 4
    CallFunc AttackerAfterimages, 0
    RepeatSE SEQ_SE_DP_053, -117, 4, 14
    CallFunc BlinkBattler, 50, 0
    WaitForTasks
    DeleteBattlerSprite 0
    DeleteBattlerSprite 1
    DeleteBattlerSprite 2
    DeleteBattlerSprite 3
    FreeBattlerSpriteManager
    StopBattlerSpriteDraw 0
    DeleteBattlerSprite 4
    End
