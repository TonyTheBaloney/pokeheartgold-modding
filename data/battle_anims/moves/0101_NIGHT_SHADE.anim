# member 101: NIGHT_SHADE
    CallFunc FadeBgPalette, 0, 1, 0, 12, 0
    WaitForTasks
    InitBattlerSpriteManager
    LoadBattlerSpriteResources 0
    CreateBattlerSprite 0, 0, 0, 0
    LoadBattlerSpriteResources 1
    CreateBattlerSprite 2, 0, 1, 1
    StartBattlerSpriteDraw 2, 1, 1
    CallFunc FadeInShrinkSprite
    PlaySEWithPan SEQ_SE_DP_W109, -117
    Wait 16
    PlaySEWithPan SEQ_SE_DP_201, 117
    CallFunc ShakeDefenderBlackFlash
    WaitForTasks
    FreeBattlerSpriteManager
    DeleteBattlerSprite 0
    StopBattlerSpriteDraw 1
    DeleteBattlerSprite 1
    CallFunc FadeBgPalette, 0, 1, 12, 0, 0
    WaitForTasks
    End
