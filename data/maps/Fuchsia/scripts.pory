        applymovement(obj_player, Fuchsia_Movement_PlayerWalkUp)
    } else {
        applymovement(obj_player, Fuchsia_Movement_PlayerWalkUpLeft)
        applymovement(obj_T08_gsmiddleman1_2, Fuchsia_Movement_PokefanMFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
