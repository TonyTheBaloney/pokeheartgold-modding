        giveitemnocheck(ITEM_WEPEAR_BERRY, 1)
        giveitemnocheck(ITEM_HONDEW_BERRY, 1)
        giveitemnocheck(ITEM_DURIN_BERRY, 1)
        takeitem(ITEM_GREEN_SHARD, 1, VAR_SPECIAL_RESULT)
