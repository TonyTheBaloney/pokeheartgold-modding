    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, Fuchsia_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
