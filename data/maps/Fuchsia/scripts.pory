    cameronphoto(62)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Fuchsia_Movement_PlayerWalkUp {
    walk_up * 3
    walk_in_place_down
}

movement Fuchsia_Movement_PlayerWalkUpLeft {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Fuchsia_Movement_PokefanMFaceUp {
    delay_8
    walk_in_place_up
}

movement Fuchsia_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

