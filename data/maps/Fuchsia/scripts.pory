script Fuchsia_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        clearflag(FLAG_UNK_149)
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 2) { goto(_0063) }
        if (var(VAR_TEMP_x4000) == 6) { goto(_0063) }
        setflag(FLAG_HIDE_CAMERON)
        end
    _0063:
        clearflag(FLAG_HIDE_CAMERON)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script Fuchsia_EventScript_PokefanM2 {
