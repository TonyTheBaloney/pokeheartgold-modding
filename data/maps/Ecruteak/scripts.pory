script scr_seq_T27_013 {
    simplenpcmsg("In the distant past...\r"
                 "When this tower burned in a fire,\n"
                 "three nameless Pokémon perished in it.\r"
                 "Then, a rainbow-hued Pokémon\n"
                 "descended from the sky and\f"
                 "somehow brought them back...\r"
                 "The people were afraid of power such as\n"
                 "the rainbow-hued Pokémon had shown.\r"
                 "They tried to control it by force.\r"
                 "The nameless Pokémon made no attempt\n"
                 "to fight back. Instead, their\f"
                 "great sorrow compelled them to leave.\r"
                 "This legend has been passed down\n"
                 "by the Ecruteak Gym Leader. Me?\r"
                 "I was a Trainer way back when.\n"
                 "Ho ho ho!")
    end
}

script scr_seq_T27_014 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 5)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, Ecruteak_Movement_033C)
        applymovement(obj_T27_gsmiddleman1, Ecruteak_Movement_0374)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, Ecruteak_Movement_0354)
    } else {
        applymovement(obj_player, Ecruteak_Movement_0360)
        applymovement(obj_T27_gsmiddleman1, Ecruteak_Movement_0374)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, Ecruteak_Movement_0380)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(19)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

