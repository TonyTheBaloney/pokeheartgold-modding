script scr_seq_T27_008 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_UNK_96A)) {
        npcmsg("Oh!\n"
               "That’s a nice Pokémon you’re walking\f"
               "with! They make you feel uplifted,\f"
               "don’t they?\r"
               "They give us the hope of the light,\n"
               "so to speak.\r"
               "Speaking of the light, I heard something\n"
               "about the Lighthouse in Olivine.\r"
               "The Pokémon that serves as the\n"
               "beacon has fallen ill.\f"
               "Sounds like it’s in trouble.")
    } else {
        npcmsg("The Pokémon at that Lighthouse in\n"
               "Olivine has fully recovered.\r"
               "I heard that boats can safely sail out\n"
               "to sea at night again.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T27_009 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GAME_CLEAR)) {
        npcmsg("Have you heard that they are talking\n"
               "about rebuilding the Burned Tower?\r"
               "There will be two towers again!\n"
               "I’m looking forward to it!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Ecruteak used to have two towers,\n"
           "one in the east and one in the west.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T27_010 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_410C) <= 2) {
        npcmsg("Hmm...\n"
               "I thought I just heard a woman\f"
               "screaming or something...\r"
               "Is that just me?")
    } else {
        npcmsg("Kimono Girls are always rehearsing their\n"
               "dances at the Dance Theater there.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T27_006 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GAME_CLEAR)) {
        npcmsg("They say that they will start the\n"
               "construction work to rebuild this\f"
               "tower soon!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_UNK_40A1) == 0) {
        npcmsg("The tower that used to be here...\n"
               "I heard that it used to be much taller\f"
               "before it was burned by a fire.")
    } else {
        npcmsg("Three big Pokémon ran off in different\n"
               "directions. What were they?")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T27_007 {
    simplenpcmsg("If you go west from this city, you’ll\n"
                 "reach a port called Olivine City.\r"
                 "When your Pokémon learns Surf,\n"
                 "you can go out to the ocean from\f"
                 "Route 40 without a ship!")
    end
}

script scr_seq_T27_011 {
    simplenpcmsg("I’m going to rehearse at the\n"
                 "Dance Theater. Care to join me?")
    end
}

