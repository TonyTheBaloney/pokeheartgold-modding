script Olivine_NorthHouse_EventScript_Fisherman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_TRADE_OLIVINE_CITY_KRABBY_VOLTORB)) {
        npcmsg("Hi! The KRABBY you traded me is\n"
               "doing great!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Hi, I’m looking for this Pokémon.\r"
           "If you have a KRABBY, would you\n"
           "trade it for my VOLTORB? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0037) }
    goto(_00A8)
_0037:
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    choosepartymonfortrade
    getpartyselection(VAR_SPECIAL_RESULT)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_RESULT) == 255) { goto(_00A8) }
    loadnpctrade(2)
    copyvar(VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT)
    getpartymonspecies(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    npctradegetreqspecies(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_x8005) != VAR_SPECIAL_RESULT) { goto(_009B) }
    npctradeexec(VAR_SPECIAL_x8004)
    npctradeend
    setflag(FLAG_TRADE_OLIVINE_CITY_KRABBY_VOLTORB)
    npcmsg("Great! Thank you!\r"
           "I finally got a KRABBY!")
    waitbuttonpress
    closemessage
    releaseall
    end
_009B:
    npctradeend
    npcmsg("You don’t have a KRABBY?\n"
           "That’s too bad, then.")
    waitbuttonpress
    closemessage
    releaseall
    end
_00A8:
    npcmsg("You don’t have one either?\r"
           "Gee, that’s really disappointing...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

