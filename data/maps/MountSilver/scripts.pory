        applymovement(obj_T31_gsmiddleman1, MountSilver_Movement_PokefanMFaceUp)
    } else {
        applymovement(obj_player, MountSilver_Movement_PlayerWalkUpLeft)
        applymovement(obj_T31_gsmiddleman1, MountSilver_Movement_PokefanMFaceUp)
