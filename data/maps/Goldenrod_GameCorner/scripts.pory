script Goldenrod_GameCorner_EventScript_Sign1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    hasitem(ITEM_COIN_CASE, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("It seems you need a Coin Case\n"
               "to play...\r")
        applymovement(obj_T25SP0101_suit, Goldenrod_GameCorner_Movement_BusinessmanFaceDown)
        waitmovement
        npcmsg(msg_0603_T25SP0101_00039)
        goto(_00E8)
    }
    applymovement(obj_T25SP0101_suit, Goldenrod_GameCorner_Movement_BusinessmanFaceDown)
    waitmovement
    npcmsg("Mr. Game: Show me how you play and\n"
           "make my heart pound with excitement!\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    casinogame(0, 0)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    setvar(VAR_TEMP_x4001, 2)
    releaseall
    end
}

text msg_0603_T25SP0101_00039 {
    "Mr. Game: Aha!\r"
    "You must be here to play my Coin game!\n"
    "Come here and I’ll give you a Coin Case!"
}

movement Goldenrod_GameCorner_Movement_BusinessmanFaceDown {
    face_down
}

movement Goldenrod_GameCorner_Movement_BusinessmanFaceLeft {
    face_left
}

movement Goldenrod_GameCorner_Movement_BusinessmanFaceRight {
    face_right
}

script Goldenrod_GameCorner_EventScript_Sign2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getplayerfacing(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) == 1) {
        call(_00F0)
    } else {
        applymovement(obj_T25SP0101_suit, Goldenrod_GameCorner_Movement_BusinessmanFaceDown)
    }
    waitmovement
    hasitem(ITEM_COIN_CASE, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 0) {
        npcmsg("Mr. Game: Huh?\r"
               "Why don’t you sit across from me\n"
               "and show me how you play?")
    } else {
        npcmsg(msg_0603_T25SP0101_00039)
    }
_00E8:
    waitbuttonpress
    closemessage
    releaseall
    end
_00F0:
    getplayercoords(VAR_TEMP_x4002, VAR_TEMP_x4003)
    if (var(VAR_TEMP_x4002) == 6) {
        applymovement(obj_T25SP0101_suit, Goldenrod_GameCorner_Movement_BusinessmanFaceLeft)
    } else {
        applymovement(obj_T25SP0101_suit, Goldenrod_GameCorner_Movement_BusinessmanFaceRight)
    }
    return
}

script Goldenrod_GameCorner_EventScript_Businessman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    hasitem(ITEM_COIN_CASE, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        if (var(VAR_TEMP_x4001) == 0) {
            npcmsg("My name is Mr. Game!\r"
                   "My heart pounds with excitement when\n"
                   "people enjoy my Coin game!\r"
                   "In fact, that’s what I live for!\n"
                   "You look like quite a challenger!\r"
                   "Why don’t you play my Coin game?\r"
                   "You can get fabulous prizes if\n"
                   "you manage to collect a lot\f"
                   "of Coins. {YESNO 0}")
        } else {
            npcmsg("Did you come back to play\n"
                   "my Coin game?")
        }
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            setvar(VAR_TEMP_x4001, 1)
            npcmsg("Playing my Coin game will make your\n"
                   "heart and my heart both pound with\f"
                   "excitement, you know?")
            goto(_00E8)
        }
        npcmsg("All right!\n"
               "Here is your Coin Case!\r")
        setvar(VAR_TEMP_x4001, 1)
        giveitemnocheck(ITEM_COIN_CASE, 1)
        npcmsg("Show me how you play, and my heart\n"
               "will pound with excitement!\r")
        goto(_00E8)
    }
    if (var(VAR_TEMP_x4001) == 0) {
        npcmsg("My name is Mr. Game!\r"
               "My heart pounds with excitement when\n"
               "people enjoy my Coin game!\r"
               "In fact, that’s what I live for!\n"
               "Go ahead and play it!\r"
               "Make my heart pound with excitement!")
        setvar(VAR_TEMP_x4001, 1)
    } elif (var(VAR_TEMP_x4001) == 1) {
        npcmsg("Go ahead and play my Coin game!\f"
               "Make my heart pound with excitement!")
    } else {
        npcmsg("What a feeling!\r"
               "Nothing beats Coin-game spectatorship!\n"
               "Oh! I almost forgot!\r"
               "You can exchange your Coins for prizes\n"
               "with the two gentlemen at the table\f"
               "over there.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

