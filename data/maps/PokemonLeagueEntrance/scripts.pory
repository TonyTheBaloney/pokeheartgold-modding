}

script PokemonLeagueEntrance_EventScript_BlackBelt {
    simplenpcmsg("At the Pokémon League, you’ll get\n"
                 "tested by the Elite Four.\f"
                 "You have to beat them all.\r"
                 "If you lose, you have to start\n"
                 "all over!")
    end
}

script PokemonLeagueEntrance_EventScript_OldMan {
    simplenpcmsg("Some Trainers suddenly feel\n"
                 "discouraged and leave.\r"
                 "My ABRA can take you home.\n"
                 "But...\r"
                 "Trainers just Fly home lately...\n"
                 "I feel left out.\f"
                 "I am sure my ABRA feels the same way.")
    end
}

script PokemonLeagueEntrance_EventScript_Abra {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_ABRA, 0)
    npcmsg("ABRA: Aabra...")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokemonLeagueEntrance_EventScript_RivalTrigger {
    followmonresetmovement
    lockall
    fadeoutbgm(0, 3)
    applymovement(obj_player, PokemonLeagueEntrance_Movement_PlayerExclamation)
    waitmovement
    callstd(std_play_rival_intro_music)
    getplayercoords(VAR_SPECIAL_x8000, VAR_SPECIAL_x8001)
    clearflag(FLAG_HIDE_INDIGO_PLATEAU_RIVAL)
    addobject(obj_T10R0101_gsrivel)
    movepersonfacing(obj_T10R0101_gsrivel, VAR_SPECIAL_x8000, 0, 23, DIR_NORTH)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_T10R0101_gsrivel, PokemonLeagueEntrance_Movement_RivalWalkUp)
    applymovement(obj_player, PokemonLeagueEntrance_Movement_PlayerWalkDown)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    bufferrivalsname(0)
    npcmsg("{STRVAR_1 3, 0, 0}: Hold it.\r"
           "You’re going to take the Pokémon\n"
           "League challenge now?\r"
           "You’ll have to give up on that.\r"
           "My well-trained-beyond-recognition\n"
           "Pokémon are going to pound you.\r"
           "Right now, right here!\n"
           "I challenge you!\r")
    closemessage
    getstarterchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 152) {
        trainerbattle(TRAINER_RIVAL_SILVER_20, 0, 0, 0)
    } elif (var(VAR_SPECIAL_RESULT) == 155) {
        trainerbattle(TRAINER_RIVAL_SILVER_21, 0, 0, 0)
    } else {
        trainerbattle(TRAINER_RIVAL_SILVER_19, 0, 0, 0)
    }
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        removeobject(obj_T10R0101_gsrivel)
        setflag(FLAG_HIDE_INDIGO_PLATEAU_RIVAL)
        whiteout
        releaseall
        end
    }
    callstd(std_play_rival_outro_music)
    bufferrivalsname(0)
    npcmsg("{STRVAR_1 3, 0, 0}: ...Oh, no... I still can’t\n"
           "win after all that training...\r"
           "I...I have to believe more in my\n"
           "Pokémon...\r"
           "...No big deal.\n"
           "Sorry to have got in the way.\r"
           "Don’t forget to rest your Pokémon\n"
           "before you challenge the Champion!\r")
    closemessage
    applymovement(obj_T10R0101_gsrivel, PokemonLeagueEntrance_Movement_RivalWalkDown)
    waitmovement
    setvar(VAR_UNK_4119, 0)
    setflag(FLAG_UNK_AA9)
    removeobject(obj_T10R0101_gsrivel)
    callstd(std_fade_end_rival_outro_music)
    releaseall
    end
}

movement PokemonLeagueEntrance_Movement_PlayerExclamation {
    emote_exclamation_mark
    delay_8
}

movement PokemonLeagueEntrance_Movement_PlayerWalkDown {
    delay_8 * 2
    walk_down
}

movement PokemonLeagueEntrance_Movement_01F4 {
    delay_8 * 2
    walk_right
    walk_up
    walk_in_place_down
}

movement PokemonLeagueEntrance_Movement_RivalWalkUp {
    walk_up * 7
}

movement PokemonLeagueEntrance_Movement_RivalWalkDown {
    walk_in_place_down
    walk_down * 7
}

script PokemonLeagueEntrance_EventScript_Nurse {
    setvar(VAR_SPECIAL_x8007, 0)
    callstd(std_nurse_joy)
    end
}

script PokemonLeagueEntrance_EventScript_Clerk {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    callstd(std_mart_intro)
    holdmsg
    setvar(VAR_SPECIAL_x8004, 13)
    callstd(std_special_mart)
    releaseall
    end
}

script PokemonLeagueEntrance_EventScript_Attendant {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_TEMP_x4005) >= 1) {
        npcmsg("Once you enter this door, you will be\n"
               "facing one of the Elite Four.\r"
               "They are really tough!\n"
               "You cannot exit once you enter.\f"
               "Are you ready?\f"
               "Be courageous and go for it!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Once you enter this door, you will be\n"
           "facing one of the Elite Four.\r"
           "They are really tough!\n"
           "You cannot exit once you enter.\f"
           "Are you ready?\f"
           "Be courageous and go for it!\r")
    closemessage
    getplayerfacing(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 2) {
        applymovement(obj_T10R0101_counterm, PokemonLeagueEntrance_Movement_AttendantWalkLeft)
    } else {
        applymovement(obj_T10R0101_counterm, PokemonLeagueEntrance_Movement_AttendantWalkRight)
        waitmovement
    }
    waitmovement
    setvar(VAR_TEMP_x4005, 1)
    releaseall
    end
}

movement PokemonLeagueEntrance_Movement_AttendantWalkLeft {
    lock_dir
    walk_left
    unlock_dir
}

movement PokemonLeagueEntrance_Movement_AttendantWalkRight {
    lock_dir
    walk_right
    unlock_dir
}

