script EmbeddedTowerGroudonRoom_OnLoad {
    if (flag(FLAG_ENGAGING_STATIC_POKEMON)) {
        setflag(FLAG_HIDE_EMBEDDED_TOWER_GROUDON)
        removeobject(obj_D52R0101_tsure_poke_static_groudon)
        clearflag(FLAG_ENGAGING_STATIC_POKEMON)
        end
    }
    end
}

script EmbeddedTowerGroudonRoom_EventScript_Groudon {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_GROUDON, 0)
    npcmsg("GROUDON: Grrgggrrrrah!\r")
    waitcry
    closemessage
    setflag(FLAG_ENGAGING_STATIC_POKEMON)
    wildbattle(SPECIES_GROUDON, 50, 0)
    clearflag(FLAG_ENGAGING_STATIC_POKEMON)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    getstaticencounteroutcome(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) != 3) {
        if (var(VAR_TEMP_x4002) == 4) { goto(_00FB) }
    }
    npcmsg("GROUDON disappeared...")
    waitbuttonpress
    closemessage
    setflag(FLAG_BEAT_OR_ESCAPED_FROM_GROUDON_OR_KYOGRE)
    releaseall
    end
_00FB:
    setvar(VAR_SCENE_EMBEDDED_TOWER, 4)
    setflag(FLAG_CAUGHT_GROUDON)
    clearflag(FLAG_HIDE_EMBEDDED_TOWER_GROUDON_HIKER)
    addobject(obj_D52R0101_mount_2)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 0) {
        applymovement(obj_D52R0101_mount_2, EmbeddedTowerGroudonRoom_Movement_HikerWalkUp1)
        waitmovement
        applymovement(obj_player, EmbeddedTowerGroudonRoom_Movement_PlayerWalkDown)
        waitmovement
    } else {
        applymovement(obj_D52R0101_mount_2, EmbeddedTowerGroudonRoom_Movement_HikerWalkUp2)
        waitmovement
        applymovement(obj_player, EmbeddedTowerGroudonRoom_Movement_PlayerFaceDown)
        waitmovement
    }
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("Well, hello!\n"
           "That was something you don’t see\f"
           "every day!\r"
           "That Pokémon is GROUDON,\n"
           "a legendary Pokémon in the Hoenn myth\f"
           "about the shaping of that region.\r"
           "I see...\r"
           "The Embedded Tower was built\n"
           "by the people from Hoenn.\r")
    closemessage
    applymovement(obj_D52R0101_mount_2, EmbeddedTowerGroudonRoom_Movement_HikerWalkDown1)
    waitmovement
    npcmsg("The Tower that binds together\n"
           "the sea, the land, and the sky...\r"
           "GROUDON was not the only Pokémon\n"
           "described in the Hoenn myth...\r"
           "This place may still be hiding\n"
           "its secrets...\r")
    closemessage
    applymovement(obj_D52R0101_mount_2, EmbeddedTowerGroudonRoom_Movement_HikerWalkUp3)
    waitmovement
    npcmsg("The knowledgeable Pokémon Professor\n"
           "may be able to tell you more when you\f"
           "show him GROUDON.\r"
           "Phew!\r"
           "There are so many connections between\n"
           "Pokémon and myths.\r"
           "See you around.\r")
    closemessage
    applymovement(obj_D52R0101_mount_2, EmbeddedTowerGroudonRoom_Movement_HikerWalkDown2)
    waitmovement
    removeobject(obj_D52R0101_mount_2)
    setflag(FLAG_HIDE_EMBEDDED_TOWER_GROUDON_HIKER)
    setflag(FLAG_HIDE_ROUTE_47_EMBEDDED_TOWER_HIKER)
    releaseall
    end
}

movement EmbeddedTowerGroudonRoom_Movement_HikerWalkUp1 {
    walk_up * 8
    walk_in_place_up
}

movement EmbeddedTowerGroudonRoom_Movement_PlayerWalkDown {
    walk_in_place_down
    walk_down
}

movement EmbeddedTowerGroudonRoom_Movement_HikerWalkUp2 {
    walk_up * 10
    walk_in_place_up
}

movement EmbeddedTowerGroudonRoom_Movement_PlayerFaceDown {
    walk_in_place_down
}

movement EmbeddedTowerGroudonRoom_Movement_HikerWalkDown1 {
    walk_in_place_down
    walk_slow_down * 2
    walk_in_place_up
}

movement EmbeddedTowerGroudonRoom_Movement_HikerWalkUp3 {
    walk_up * 2
    walk_in_place_up
}

movement EmbeddedTowerGroudonRoom_Movement_HikerWalkDown2 {
    walk_down * 8
}

