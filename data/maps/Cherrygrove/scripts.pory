    movepersonfacing(obj_T21_gsoldman1, VAR_TEMP_x4000, 1, 394, DIR_NORTH)
    if (var(VAR_TEMP_x4000) == 549) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_068C)
    } elif (var(VAR_TEMP_x4000) == 550) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_068C)
    } else {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_069C)
    }
    waitmovement
    if (var(VAR_TEMP_x4000) == 549) {
        applymovement(obj_player, Cherrygrove_Movement_0380)
    } elif (var(VAR_TEMP_x4000) == 550) {
        applymovement(obj_player, Cherrygrove_Movement_0380)
    } else {
