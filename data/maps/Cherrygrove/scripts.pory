script Cherrygrove_EventScript_GuideGentMapCard {
    followmonresetmovement
    lockall
    applymovement(obj_player, Cherrygrove_Movement_PlayerExclamation)
    waitmovement
    callstd(std_play_follow_music)
    clearflag(FLAG_HIDE_CHERRYGROVE_GUIDE_GENT)
    addobject(obj_T21_gsoldman1)
    lock(obj_T21_gsoldman1)
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    movepersonfacing(obj_T21_gsoldman1, VAR_TEMP_x4000, 1, 394, DIR_NORTH)
    if (var(VAR_TEMP_x4000) == 549) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkLeftUp10)
    } elif (var(VAR_TEMP_x4000) == 550) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkLeftUp10)
    } else {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkRightUp)
    }
    waitmovement
    if (var(VAR_TEMP_x4000) == 549) {
        applymovement(obj_player, Cherrygrove_Movement_PlayerFaceLeft1)
    } elif (var(VAR_TEMP_x4000) == 550) {
        applymovement(obj_player, Cherrygrove_Movement_PlayerFaceLeft1)
    } else {
        applymovement(obj_player, Cherrygrove_Movement_PlayerFaceRight)
    }
    waitmovement
    npcmsg("...Hffp... Hffp...\n"
           "I made it...\r"
           "I forgot about one thing.\n"
           "This is another token from me!\r"
           "Take it.\r")
    bufferplayersname(0)
    npcmsg("The Guide Gent loaded the Map Card\n"
           "on {STRVAR_1 3, 0, 0}’s Pokégear!")
    playfanfare(SEQ_ME_KEYITEM)
    waitfanfare
    npcmsg("{STRVAR_1 3, 0, 0}’s Pokégear\n"
           "can now show the Town Map!\r")
    npcmsg("Select the Pokégear on the\n"
           "Touch Screen and then select\f"
           "the Town Map icon.\r"
           "You’ll see the map of the region\n"
           "you’re currently in!\r"
           "The Pokégear becomes more useful as\n"
           "you add Cards.\r"
           "I wish you luck on your journey!\r")
    closemessage
    applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkDown4)
    waitmovement
    callstd(std_fade_end_mom_music)
    release(obj_T21_gsoldman1)
    removeobject(obj_T21_gsoldman1)
    setflag(FLAG_HIDE_CHERRYGROVE_GUIDE_GENT)
    registerpokegearcard(1)
    releaseall
    setvar(VAR_SCENE_CHERRYGROVE_CITY_OW, 2)
    end
}

