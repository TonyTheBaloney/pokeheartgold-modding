script Cherrygrove_EventScript_MysticWaterMan {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GOT_MYSTIC_WATER_FROM_CHERRYGROVE_CITY_MAN)) {
        npcmsg("A Pokémon I caught had an item.\n"
               "I think it’s Mystic Water.\r"
               "I don’t need it, so do you want it?\r")
        if (!itemspace(ITEM_MYSTIC_WATER, 1)) {
            npcmsg("You don’t have room for this.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_MYSTIC_WATER_FROM_CHERRYGROVE_CITY_MAN)
    }
    npcmsg("Back to fishing for me, then.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Cherrygrove_EventScript_Cameron {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 5)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, Cherrygrove_Movement_PlayerWalkRightUp)
        applymovement(obj_T21_gsmiddleman1, Cherrygrove_Movement_CameronFaceUp)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, Cherrygrove_Movement_PlayerWalkUp2)
    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_player, Cherrygrove_Movement_PlayerWalkDownRight2)
        applymovement(obj_T21_gsmiddleman1, Cherrygrove_Movement_CameronFaceUp)
    } else {
        applymovement(obj_player, Cherrygrove_Movement_PlayerWalkUpLeft2)
        applymovement(obj_T21_gsmiddleman1, Cherrygrove_Movement_CameronFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, Cherrygrove_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(1)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Cherrygrove_Movement_PlayerWalkRightUp {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Cherrygrove_Movement_PlayerWalkUp2 {
    walk_up * 3
    walk_in_place_down
}

movement Cherrygrove_Movement_PlayerWalkUpLeft2 {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Cherrygrove_Movement_PlayerWalkDownRight2 {
    walk_down
    walk_right * 2
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Cherrygrove_Movement_CameronFaceUp {
    delay_8
    walk_in_place_up
}

movement Cherrygrove_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

script Cherrygrove_EventScript_GuideGentsHouseSign {
    trainertipsex(2, "Guide Gent’s House\n"
                     "Full-of-Energy, High-Speed Old Man")
    end
}

script Cherrygrove_EventScript_CitySign {
    directionsignpostex(0, 12, "Cherrygrove City\n"
                               "The City of Fragrant Flowers")
    end
}

script Cherrygrove_EventScript_Boy {
    simplenpcmsg("I battled the Trainers on the road.\n"
                 "My Pokémon lost.\r"
                 "They’re a mess! I must take them to\n"
                 "a Pokémon Center.")
    end
}

script Cherrygrove_EventScript_Woman {
    simplenpcmsg("When you’re with Pokémon,\n"
                 "going anywhere is fun.")
    end
}

mapscripts Cherrygrove_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Cherrygrove_OnTransition
}
