           "For your effort keeping up with me,\n"
           "I’ll give you my Running Shoes!\f"
           "They’re still warm!\r"
           "...\n"
           "...\r"
           "Got you, didn’t I?\n"
           "Don’t worry, these are brand new!\r")
    giverunningshoes
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Running Shoes from the Guide Gent!")
    playfanfare(SEQ_ME_ITEM)
    waitfanfare
    npcmsg("The instructions read,\n"
           "“Touch the Sprint Button on the\f"
           "Touch Screen to sprint.”\r"
           "It also says,\n"
           "“Hold the B Button down to sprint.”\r")
    closemessage
    applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkUp)
    waitmovement
    dooranimationload(17, 12, 14, 17, 77)
    dooranimationopen(77)
    dooranimationwait(77)
    applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkUp)
    waitmovement
    release(obj_T21_gsoldman1)
    release(obj_partner_poke)
    playse(SEQ_SE_DP_KAIDAN2)
    removeobject(obj_T21_gsoldman1)
    waitse(SEQ_SE_DP_KAIDAN2)
    setflag(FLAG_HIDE_CHERRYGROVE_GUIDE_GENT)
    dooranimationclose(77)
    dooranimationwait(77)
    dooranimationunload(77)
    callstd(std_fade_end_mom_music)
    setvar(VAR_SCENE_CHERRYGROVE_CITY_OW, 1)
    end
}

