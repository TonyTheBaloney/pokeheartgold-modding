script Cherrygrove_EventScript_RivalBattle {
    followmonresetmovement
    lockall
    fadeoutbgm(0, 3)
    applymovement(obj_player, Cherrygrove_Movement_GuideGentExclamation)
    waitmovement
    callstd(std_play_rival_intro_music)
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    movepersonfacing(obj_T21_gsrivel, 583, 0, VAR_TEMP_x4001, DIR_WEST)
    applymovement(obj_T21_gsrivel, Cherrygrove_Movement_RivalWalkLeft1)
    waitmovement
    npcmsg("...\r"
           "You got a Pokémon at the Lab.\n"
           "What a waste.\r"
           "That’s a Pokémon that’s too good for\n"
           "a wimp like you.\r"
           "...\n"
           "Don’t you get what I’m saying?\r"
           "Well, I too have a good Pokémon.\n"
           "I’ll show you what I mean!\r")
    closemessage
    getstarterchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 152) {
        trainerbattle(TRAINER_PASSERBY_BOY_2, 0, 1, 0)
    } elif (var(VAR_SPECIAL_RESULT) == 155) {
        trainerbattle(TRAINER_PASSERBY_BOY_3, 0, 1, 0)
    } else {
        trainerbattle(TRAINER_PASSERBY_BOY, 0, 1, 0)
    }
    checkbattlewon(VAR_SPECIAL_RESULT)
    callstd(std_play_rival_outro_music)
    npcmsg("...\r"
           "Do you want to know who I am?\n"
           "...\r"
           "I’m going to be the world’s greatest\n"
           "Pokémon Trainer.\r")
    closemessage
    playse(SEQ_SE_DP_WALL_HIT2)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(56)
    getplayercoords(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_x8005) == 398) {
        applymovement(obj_player, Cherrygrove_Movement_PlayerWalkDown)
    } else {
        applymovement(obj_player, Cherrygrove_Movement_PlayerWalkUp1)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    if (var(VAR_SPECIAL_x8005) == 398) {
        applymovement(obj_T21_gsrivel, Cherrygrove_Movement_RivalWalkLeftRight1)
    } else {
        applymovement(obj_T21_gsrivel, Cherrygrove_Movement_RivalWalkLeftRight2)
    }
    waitmovement
    npcmsg("Give it back!\n"
           "That’s my Trainer Card!\r"
           "Oh no!\n"
           "You saw my name...\r")
    closemessage
    getpersoncoords(4, VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_x8005) == 401) {
        applymovement(obj_T21_gsrivel, Cherrygrove_Movement_RivalWalkLeftUp)
        applymovement(obj_player, Cherrygrove_Movement_PlayerFaceLeft2)
    } else {
        applymovement(obj_T21_gsrivel, Cherrygrove_Movement_RivalWalkLeft2)
        applymovement(obj_player, Cherrygrove_Movement_PlayerFaceLeft2)
    }
    waitmovement
    removeobject(obj_T21_gsrivel)
    setflag(FLAG_HIDE_CHERRYGROVE_RIVAL)
    callstd(std_fade_end_rival_outro_music)
    releaseall
    setvar(VAR_SCENE_CHERRYGROVE_CITY_OW, 4)
    setflag(FLAG_MET_PASSERBY_BOY)
    end
    whiteout
    releaseall
    end
}

