script Cherrygrove_EventScript_RivalBattle {
    followmonresetmovement
    lockall
    fadeoutbgm(0, 3)
    applymovement(obj_player, Cherrygrove_Movement_0350)
    waitmovement
    callstd(std_play_rival_intro_music)
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    movepersonfacing(obj_T21_gsrivel, 583, 0, VAR_TEMP_x4001, DIR_WEST)
    applymovement(obj_T21_gsrivel, Cherrygrove_Movement_0808)
    waitmovement
    npcmsg(msg_0550_T21_00013)
    closemessage
    getstarterchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 152) {
        trainerbattle(TRAINER_PASSERBY_BOY_2, 0, 1, 0)
    } elif (var(VAR_SPECIAL_RESULT) == 155) {
        trainerbattle(TRAINER_PASSERBY_BOY_3, 0, 1, 0)
    } else {
        trainerbattle(TRAINER_PASSERBY_BOY, 0, 1, 0)
    }
    checkbattlewon(VAR_SPECIAL_RESULT)
    callstd(std_play_rival_outro_music)
    npcmsg(msg_0550_T21_00014)
    closemessage
    playse(SEQ_SE_DP_WALL_HIT2)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(56)
    getplayercoords(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_x8005) == 398) {
        applymovement(obj_player, Cherrygrove_Movement_0890)
    } else {
        applymovement(obj_player, Cherrygrove_Movement_08A4)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    if (var(VAR_SPECIAL_x8005) == 398) {
        applymovement(obj_T21_gsrivel, Cherrygrove_Movement_0810)
    } else {
        applymovement(obj_T21_gsrivel, Cherrygrove_Movement_0844)
    }
    waitmovement
    npcmsg(msg_0550_T21_00015)
    closemessage
    getpersoncoords(4, VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_x8005) == 401) {
        applymovement(obj_T21_gsrivel, Cherrygrove_Movement_0880)
        applymovement(obj_player, Cherrygrove_Movement_08B8)
    } else {
        applymovement(obj_T21_gsrivel, Cherrygrove_Movement_0878)
        applymovement(obj_player, Cherrygrove_Movement_08B8)
    }
    waitmovement
    removeobject(obj_T21_gsrivel)
    setflag(FLAG_HIDE_CHERRYGROVE_RIVAL)
    callstd(std_fade_end_rival_outro_music)
    releaseall
    setvar(VAR_SCENE_CHERRYGROVE_CITY_OW, 4)
    setflag(FLAG_MET_PASSERBY_BOY)
    end
    whiteout
    releaseall
    end
}

