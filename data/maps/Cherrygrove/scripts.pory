    } elif (var(VAR_TEMP_x4001) == 399) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkDown2)
    } elif (var(VAR_TEMP_x4001) == 400) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkDown3)
    }
    applymovement(obj_player, Cherrygrove_Movement_PlayerFaceUp)
    waitmovement
    npcmsg("You’re a rookie Trainer, aren’t you?\n"
           "I can tell!\r"
           "That’s OK! Everyone is a rookie\n"
           "at some point!\r"
           "If you’d like, I can teach you a\n"
           "few things.\f"
           "OK, then! Follow me!\r")
    closemessage
    bufferplayersname(0)
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 397) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkLeftUp1)
    } elif (var(VAR_TEMP_x4001) == 398) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkLeftUp2)
    } elif (var(VAR_TEMP_x4001) == 399) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkLeftUp3)
    } elif (var(VAR_TEMP_x4001) == 400) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkLeftUp4)
    }
    waitmovement
    applymovement(obj_player, Cherrygrove_Movement_PlayerFaceLeft1)
    waitmovement
    npcmsg("Ohh... I’m sorry.\n"
           "I forgot that you weren’t wearing the\f"
           "Running Shoes!\r"
           "I’ll try to go as slow as possible, so\n"
           "try keeping up!\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    if (var(VAR_TEMP_x4001) == 397) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkLeftUp5)
        applymovement(obj_player, Cherrygrove_Movement_PlayerWalkLeftUp1)
    } elif (var(VAR_TEMP_x4001) == 398) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkLeftUp6)
        applymovement(obj_player, Cherrygrove_Movement_PlayerWalkLeftUp2)
    } elif (var(VAR_TEMP_x4001) == 399) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkLeftUp7)
        applymovement(obj_player, Cherrygrove_Movement_PlayerWalkLeftUp3)
    } elif (var(VAR_TEMP_x4001) == 400) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkLeftUp8)
        applymovement(obj_player, Cherrygrove_Movement_PlayerWalkLeftUp4)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("This is a Pokémon Center. They heal\n"
           "your Pokémon in no time at all.\r"
           "You’ll be relying on them a lot, so\n"
           "you better learn about them.\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkLeft)
    applymovement(obj_player, Cherrygrove_Movement_PlayerWalkUpLeft1)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("This is a Pokémon Mart.\n"
           "They sell Poké Balls for catching wild\f"
           "Pokémon and other useful items.\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkLeftUp9)
    applymovement(obj_player, Cherrygrove_Movement_PlayerWalkLeftUp5)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("Route 30 is out this way.\r"
           "Trainers will be battling their\n"
           "Pokémon there.\r"
           "If you go a little farther,\n"
           "you’ll see Mr. Pokémon’s House.\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkDownLeft)
    applymovement(obj_player, Cherrygrove_Movement_PlayerWalkLeftDown)
    waitmovement
    playse(SEQ_SE_GS_N_UMIBE)
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("This is the sea, as you can see.\r"
           "Some Pokémon are found only in water.\r")
    closemessage
    stopse(SEQ_SE_GS_N_UMIBE)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentWalkRightDown)
