script Cherrygrove_EventScript_GuideGentTour {
    lock(obj_T21_gsoldman1)
    applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentExclamation)
    waitmovement
    callstd(std_play_follow_music)
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 397) {
        applymovement(obj_T21_gsoldman1, Cherrygrove_Movement_GuideGentDelay)
    } elif (var(VAR_TEMP_x4001) == 398) {
