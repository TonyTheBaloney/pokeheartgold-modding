script Cherrygrove_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        checkbadge(BADGE_PLAIN, VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) != 0) {
            getweekday(VAR_TEMP_x4000)
            if (var(VAR_TEMP_x4000) == 1) { goto(_0083) }
            if (var(VAR_TEMP_x4000) == 3) { goto(_0083) }
            if (var(VAR_TEMP_x4000) == 5) { goto(_0083) }
        }
        setflag(FLAG_HIDE_CAMERON)
        end
    _0083:
        clearflag(FLAG_HIDE_CAMERON)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

