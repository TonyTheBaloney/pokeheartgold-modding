script scr_seq_D47_005 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_TEMP_x400B) == 0) {
        npcmsg("Safari, safari,\n"
               "it is so much fun.\r"
               "Safari, safari,\n"
               "so interesting, huh!\r"
               "So many Pokémon are waiting for us!\r"
               "...That’s a song I made up.\n"
               "I sing it when I am in the Safari Zone.")
    } else {
        npcmsg("Airily goes the Safari Ball under the\n"
               "blue sky. Sprinkly goes your sweat to\f"
               "celebrate a friendship.\r"
               "I love the Safari Zone!\r"
               "...I made a whole jingle out of it.\n"
               "You think anyone would be interested?")
    }
    waitbuttonpress
    closemessage
    releaseall
    if (var(VAR_TEMP_x400B) == 0) {
        addvar(VAR_TEMP_x400B, 1)
    } else {
        setvar(VAR_TEMP_x400B, 0)
    }
    end
}

