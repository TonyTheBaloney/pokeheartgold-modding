script scr_seq_D47_013 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 5)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, SafariZoneGate_Movement_0330)
        applymovement(obj_D47_gsmiddleman1, SafariZoneGate_Movement_037C)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, SafariZoneGate_Movement_0348)
    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_player, SafariZoneGate_Movement_0368)
        applymovement(obj_D47_gsmiddleman1, SafariZoneGate_Movement_037C)
    } else {
        applymovement(obj_player, SafariZoneGate_Movement_0354)
        applymovement(obj_D47_gsmiddleman1, SafariZoneGate_Movement_037C)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, SafariZoneGate_Movement_0388)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(38)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement SafariZoneGate_Movement_0330 {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement SafariZoneGate_Movement_0348 {
    walk_up * 3
    walk_in_place_down
}

movement SafariZoneGate_Movement_0354 {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement SafariZoneGate_Movement_0368 {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement SafariZoneGate_Movement_037C {
    delay_8
    walk_in_place_up
}

movement SafariZoneGate_Movement_0388 {
    walk_right
    walk_up
    face_down
}

