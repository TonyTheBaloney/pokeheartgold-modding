script scr_seq_T07R0501_002 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_172)) {
        npcmsg("I’ll tell you what type your Pokémon’s\n"
               "Hidden Power will be.\r"
               "My own hidden power lets me\n"
               "do that. {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_00F2) }
        goto(_006D)
        end
    _006D:
        closemessage
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        partyselectui
        getpartyselection(VAR_SPECIAL_x8000)
        restoreoverworld
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        if (var(VAR_SPECIAL_x8000) == 255) { goto(_00F2) }
        getpartymonspecies(VAR_SPECIAL_x8000, VAR_SPECIAL_x8001)
        if (var(VAR_SPECIAL_x8001) == 0) {
            npcmsg("A move that an Egg can learn?!\n"
                   "That’s flat-out impossible.")
            goto(_0118)
            end
        }
        gethiddenpowertype(VAR_SPECIAL_x8000, VAR_SPECIAL_x8004)
        if (var(VAR_SPECIAL_x8004) == 65535) { goto(_00E7) }
        monhasmove(VAR_SPECIAL_RESULT, MOVE_HIDDEN_POWER, VAR_SPECIAL_x8000)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            buffertypename(0, VAR_SPECIAL_x8004)
            npcmsg("If this Pokémon were to learn\n"
                   "Hidden Power, the move’s type\f"
                   "would be {STRVAR_1 15, 0, 0}.")
            goto(_0118)
            end
        _0118:
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        buffertypename(0, VAR_SPECIAL_x8004)
        npcmsg("This Pokémon’s Hidden Power is the\n"
               "{STRVAR_1 15, 0, 0} type.")
        goto(_0118)
        end
    _00E7:
        npcmsg("Oh, no. This Pokémon can’t learn the\n"
               "move Hidden Power in the first place.")
        goto(_0118)
        end
    _00F2:
        npcmsg("If you want to know, ask me, and I’ll\n"
               "activate my hidden power for you.")
        goto(_0118)
        end
    }
    setflag(FLAG_UNK_172)
    npcmsg("I woke up and realized my potential!\r"
           "So, what potential was woken in me?\n"
           "What’s my hidden power, you ask?\r"
           "It’s a power that lets me see the\n"
           "Hidden Power of a Pokémon.\r"
           "When they learn that move, I can tell\n"
           "what type the move will be.\r"
           "So, want me to use my hidden power?\r"
           "I’ll tell you what type your\n"
           "Pokémon’s Hidden Power will be. {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_00F2) }
    goto(_006D)
    end
}

