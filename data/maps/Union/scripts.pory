script Union_EventScript_Receptionist {
    playse(SEQ_SE_DP_SELECT)
    followmonresetmovement
    lockall
    faceplayer
    goto(_0C1F)
    end
_0C1F:
    unionroomrefusejoins
    callifset(FLAG_UNK_069, _0C87)
    touchscreenmenuhide
_0C2E:
    callifunset(FLAG_UNK_069, _0C8C)
    setflag(FLAG_UNK_069)
    menuinitstdgmm(21, 11, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(11, 255, 0)
    menuitemadd(169, 255, 1)
    menuitemadd(24, 255, 2)
    menuexec
    Switch(VAR_SPECIAL_RESULT)
    Case(0, _0CAF)
    Case(1, _0C91)
    goto(_0CA5)
    end
_0C87:
    npcmsg("How may I help you? {YESNO 0}")
    return
_0C8C:
    npcmsg("Welcome to the Union Room.\r"
           "If there is anything you need help\n"
           "with, please let me know! {YESNO 0}")
    return
_0C91:
    touchscreenmenushow
    getunionroomownchatmsg(VAR_SPECIAL_RESULT)
    nonnpcmsgvar(VAR_SPECIAL_RESULT)
    touchscreenmenuhide
    goto(_0C2E)
    end
_0CA5:
    touchscreenmenushow
    unionroomresumesearch
    closemessage
    releaseall
    end
_0CAF:
    npcmsg("Which topic would you\n"
           "like me to explain? {YESNO 0}")
    menuinitstdgmm(24, 3, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(52, 255, 0)
    menuitemadd(23, 255, 1)
    menuitemadd(142, 255, 2)
    menuitemadd(59, 255, 3)
    menuitemadd(170, 255, 4)
    menuitemadd(141, 255, 5)
    menuitemadd(13, 255, 6)
    menuexec
    Switch(VAR_SPECIAL_RESULT)
    Case(0, _0D50)
    Case(1, _0D5F)
    Case(2, _0D6E)
    Case(3, _0D7D)
    Case(4, _0D8C)
    Case(5, _0D9B)
    goto(_0C2E)
    end
_0D50:
    touchscreenmenushow
    npcmsg("In the Union Room, you may battle\n"
           "with two Pokémon of your choice\f"
           "that are Lv. 30 or lower.\r"
           "When you visit here, we recommend\n"
           "that you bring Pokémon that\f"
           "meet this requirement.\r")
    touchscreenmenuhide
    goto(_0CAF)
    end
_0D5F:
    touchscreenmenushow
    npcmsg("You may trade your Pokémon with\n"
           "other players.\r"
           "Meeting new people could be a\n"
           "shortcut to meeting rare Pokémon!\r")
    touchscreenmenuhide
    goto(_0CAF)
    end
_0D6E:
    touchscreenmenushow
    npcmsg("You may communicate with other\n"
           "players and mix your records.\r"
           "What will happen if you mix records,\n"
           "you ask?\r"
           "We recommend that you try it and\n"
           "see!\r"
           "Up to five players can take part,\n"
           "so try it with your friends!\r")
    touchscreenmenuhide
    goto(_0CAF)
    end
_0D7D:
    touchscreenmenushow
    npcmsg("You may get together with others\n"
           "and draw.\r"
           "You all get to work on one sheet\n"
           "of paper at the same time.\r"
           "I’m sure a drawing made by friends\n"
           "will be a memorable masterpiece!\r"
           "Up to five players can take part,\n"
           "so try it with your friends!\r")
    touchscreenmenuhide
    goto(_0CAF)
    end
_0D8C:
    touchscreenmenushow
    npcmsg("You can chat with other people\n"
           "by selecting “CHAT” in the menu.\r"
           "Go out and meet other players in\n"
           "the Union Room!\r"
           "Let people know what you’re like\n"
           "and what you’d like to do.\r"
           "Mingle, chat, and add to your\n"
           "circle of friends!\r")
    touchscreenmenuhide
    goto(_0CAF)
    end
_0D9B:
    touchscreenmenushow
    npcmsg("In a Spin Trade, participants each bring\n"
           "an Egg for trading with others.\r"
           "Which Egg will you end up with?\n"
           "What kind of Pokémon is in that Egg?\f"
           "It’s quite exciting and fun!\r"
           "Up to five players can take part, so\n"
           "try it with your friends!\r")
    touchscreenmenuhide
    goto(_0CAF)
    end
    goto(_0C2E)
    end
}

mapscripts Union_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Union_OnTransition
    INIT_SCRIPT_ON_LOAD: Union_OnLoad
    INIT_SCRIPT_ON_RESUME: Union_OnResume
}
