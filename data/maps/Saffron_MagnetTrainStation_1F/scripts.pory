script scr_seq_T11R0601_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_RESTORED_POWER)) {
        getplayerfacing(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 2) {
            npcmsg("Enjoy the attractive and magnetic\n"
                   "journey!")
            waitbuttonpress
            closemessage
        } else {
            npcmsg("Enjoy the attractive and magnetic\n"
                   "journey!\r")
            closemessage
            applymovement(obj_T11R0601_policeman, Saffron_MagnetTrainStation_1F_Movement_00EC)
            waitmovement
        }
        releaseall
        end
    }
    npcmsg("This is a problem!\r"
           "The machine at the Power Plant\n"
           "is broken, and we’re not receiving\f"
           "electricity!\r"
           "I don’t know how long it will be until\n"
           "we can get the Magnet Train going.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Saffron_MagnetTrainStation_1F_Movement_00EC {
    face_right
}

script scr_seq_T11R0601_004 {
    followmonresetmovement
    lockall
    applymovement(obj_player, Saffron_MagnetTrainStation_1F_Movement_017C)
    waitmovement
    if (flag(FLAG_UNK_123)) {
        npcmsg("Passengers need to go through the\n"
               "gate for the automatic ticket check...\r")
        closemessage
        goto(_0116)
    }
    npcmsg("Thanks to someone who got the\n"
           "Power Plant up and running,\f"
           "the Magnet Train is available again!\r"
           "Passengers need to go through the\n"
           "gate for the automatic ticket check...\r")
    closemessage
    setflag(FLAG_UNK_123)
_0116:
    wait(50, VAR_SPECIAL_x8004)
    hasitem(ITEM_PASS, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) >= 1) {
        npcmsg("Ping...fwip!\n"
               "Here is your Pass back.\r"
               "This train is about to leave\n"
               "for Goldenrod City.")
        waitbuttonpress
        closemessage
        setvar(VAR_UNK_411D, 1)
        setvar(VAR_UNK_411F, 1)
        releaseall
        end
    }
    npcmsg("...Beep!\r"
           "I am so sorry, but you need\n"
           "a Magnet Train Pass to get on\f"
           "the Magnet Train...\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, Saffron_MagnetTrainStation_1F_Movement_0184)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    releaseall
    end
}

movement Saffron_MagnetTrainStation_1F_Movement_017C {
    walk_in_place_left
}

movement Saffron_MagnetTrainStation_1F_Movement_0184 {
    walk_down * 2
}

script scr_seq_T11R0601_007 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("Lt. Surge: Oh! I never expected to see\n"
           "you at a place like this!\f"
           "What a coincidence!\r"
           "I can feel great electric power around\n"
           "the Magnet Train station!\r"
           "You had a PIKACHU, didn’t you?\n"
           "How about trading it for my\f"
           "French PIKACHU? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_024F) }
    npcmsg("Lt. Surge: Wow! Electrifying!\n"
           "Let’s trade ’em now!\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    choosepartymonfortrade
    getpartyselection(VAR_SPECIAL_RESULT)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_RESULT) == 255) { goto(_024F) }
    loadnpctrade(10)
    copyvar(VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT)
    getpartymonspecies(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    npctradegetreqspecies(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_x8005) != VAR_SPECIAL_RESULT) {
        npctradeend
        npcmsg("Lt. Surge: What? That is not\n"
               "the right Pokémon!\r"
               "I won’t trade my PIKACHU for\n"
               "anything other than PIKACHU.")
        waitbuttonpress
        closemessage
        releaseall
        end
    _024F:
        npcmsg("Lt. Surge: Shocking!\n"
               "I want to share my feelings for\f"
               "PIKACHU with you!\r"
               "I’m ready anytime, so just bring\n"
               "a PIKACHU, OK?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npctradeexec(VAR_SPECIAL_x8004)
    npctradeend
    setflag(FLAG_TRADE_LT_SURGE_PIKACHU)
    npcmsg("Lt. Surge: Yeah!\n"
           "I’m so ecstatic! I’ll see you around.\f"
           "Good-bye!\r")
    closemessage
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_T11R0601_gsleader9, Saffron_MagnetTrainStation_1F_Movement_025C)
    } else {
        applymovement(obj_T11R0601_gsleader9, Saffron_MagnetTrainStation_1F_Movement_0268)
    }
    waitmovement
    removeobject(obj_T11R0601_gsleader9)
    setflag(FLAG_HIDE_SAFFRON_TRAIN_STATION_LT_SURGE)
    releaseall
    end
}

movement Saffron_MagnetTrainStation_1F_Movement_025C {
    walk_slightly_fast_left * 5
    walk_slightly_fast_down * 10
}

movement Saffron_MagnetTrainStation_1F_Movement_0268 {
    walk_slightly_fast_down * 10
}

script scr_seq_T11R0601_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_RESTORED_POWER)) {
        npcmsg("Whew...\r"
               "How many times have I gone back\n"
               "and forth between Kanto and Johto?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("The Magnet Train is a super-modern\n"
           "rail liner that uses electricity and\f"
           "magnets to attain incredible speeds.\r"
           "However, there isn’t any electricity.\n"
           "It’s just an iron box.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T11R0601_002 {
    simplenpcmsg("Before the Magnet Train station was\n"
                 "built, there was a house here.\r"
                 "A little girl who was called Copycat\n"
                 "used to live in it.")
    end
}

script scr_seq_T11R0601_003 {
    simplenpcmsg("Hi. Do you have a Magnet Train Pass?\r"
                 "I have one.\r"
                 "All the people in Saffron who ride the\n"
                 "Magnet Train have Passes.")
    end
}

