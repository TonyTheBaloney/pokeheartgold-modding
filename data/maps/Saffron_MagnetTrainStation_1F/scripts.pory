    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("We request that you make sure your\n"
           "Pokémon are well behaved or put away\f"
           "in their Poké Balls so they won’t lick\f"
           "other passengers’ faces.\f"
           "Thank you.")
