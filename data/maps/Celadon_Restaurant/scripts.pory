    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("Maylene: Munch munch munch...\n"
           "The eatathon contest!\r"
           "I never dreamed of such a\n"
           "wonderful thing.\r"
           "After a strict diet during training,\n"
           "I can eat like a HIPPOWDON.\r"
           "The winner eats for free, too.\n"
           "That’s just a dream come true!\r")
    closemessage
    applymovement(obj_T07R0701_leader4, Celadon_Restaurant_Movement_MayleneFaceRight)
    waitmovement
    releaseall
    end
}

