script Route42_EventScript_EusineTrigger {
    followmonresetmovement
    lockall
    playcry(SPECIES_SUICUNE, 0)
    release(obj_R42_tsure_poke_static_suicune)
    spinobject(obj_R42_tsure_poke_static_suicune, 2, 90, 2, 0)
    lock(obj_R42_tsure_poke_static_suicune)
    waitcry
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(56)
    applymovement(obj_R42_tsure_poke_static_suicune, Route42_Movement_SuicuneWalkLeft)
    applymovement(obj_player, Route42_Movement_PlayerWalkUpRight)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    clearflag(FLAG_HIDE_ROUTE_42_EUSINE)
    addobject(obj_R42_minaki)
    callstd(std_play_eusine_music)
    applymovement(obj_R42_minaki, Route42_Movement_EusineWalkRightUp)
    waitmovement
    npcmsg("Eusine: SUICUNE...\n"
           "How brave it is!\f"
           "How refreshing it is!\f"
           "How beautiful it is!\f"
           "And how quickly it moves!\r")
    closemessage
    applymovement(obj_R42_minaki, Route42_Movement_EusineWalkUp)
    waitmovement
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0}!\n"
           "You seem to be around where\f"
           "SUICUNE would appear.\r"
           "Well, that’s OK.\n"
           "My desire to search for SUICUNE is\f"
           "far beyond yours...\r"
           "My grandpa was...quite into myths.\n"
           "I’ve heard so many stories about\f"
           "SUICUNE from him.\r")
    closemessage
    applymovement(obj_R42_minaki, Route42_Movement_EusineWalkRight2)
    waitmovement
    npcmsg("SUICUNE...\r"
           "I won’t stop following you until\n"
           "I’ve found out what you’re after...\r"
           "You hear me!\r")
    closemessage
    applymovement(obj_R42_minaki, Route42_Movement_EusineWalkRight1)
    waitmovement
    callstd(std_fade_end_eusine_music)
    removeobject(obj_R42_tsure_poke_static_suicune)
    removeobject(obj_R42_minaki)
    setflag(FLAG_HIDE_ROUTE_42_SUICUNE)
    setflag(FLAG_HIDE_ROUTE_42_EUSINE)
    setvar(VAR_UNK_4092, 0)
    setvar(VAR_UNK_4070, 1)
    setvar(VAR_UNK_4071, 1)
    clearflag(FLAG_HIDE_VERMILION_SUICUNE)
    releaseall
    end
}

