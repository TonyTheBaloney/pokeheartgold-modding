script FrontierAccessPokemart_EventScript_Boy {
    simplenpcmsg("Some Trainers rely on a Pokémon’s\n"
                 "potential alone. But you can use items\f"
                 "and medicines to help improve a\f"
                 "Pokémon’s capabilities.")
    end
}

script FrontierAccessPokemart_EventScript_Hiker {
    simplenpcmsg("Mountain climbing and Pokémon are\n"
                 "similar in a sense.\r"
                 "They both come down to potential!\r"
                 "I do not rely on items or medicines\n"
                 "but rather potential and training\f"
                 "for battle!")
    end
}

