text msg_0403_R43R0201_00000 {
    "Hold it there, kiddo!\r"
    "The toll is $1,000 to go through.\r"
}

text msg_0403_R43R0201_00001 {
    "Thank you very much!\r"
}

text msg_0403_R43R0201_00002 {
    "Then pay what you have, please.\r"
    "Those who have no money, hmm...\n"
    "can go through free of charge!\r"
}

script Route43_Gatehouse_OnTransition {
    if (flag(FLAG_ROCKET_HIDEOUT_CLEARED)) {
        end
    }
    setvar(VAR_UNK_410F, 0)
    end
}

movement Route43_Gatehouse_Movement_RocketGruntWalkDownRight {
    emote_exclamation_mark
    walk_faster_down * 3
    walk_faster_right * 2
    face_down
}

movement Route43_Gatehouse_Movement_RocketGruntWalkDownLeft {
    delay_8 * 6
    face_down
    emote_exclamation_mark
    walk_faster_down * 3
    walk_faster_left
    face_down
}

movement Route43_Gatehouse_Movement_RocketGruntWalkLeftUp {
    delay_4 * 3
    walk_faster_left * 2
    walk_faster_up * 3
    face_down
}

movement Route43_Gatehouse_Movement_RocketGruntWalkRightUp {
    walk_faster_right
    walk_faster_up * 3
}

movement Route43_Gatehouse_Movement_RocketGruntWalkUpRight {
    delay_8 * 6
    face_up
    emote_exclamation_mark
    walk_faster_up * 4
    walk_faster_right
    face_up
}

movement Route43_Gatehouse_Movement_RocketGruntWalkUpLeft {
    emote_exclamation_mark
    walk_faster_up * 4
    walk_faster_left * 2
    face_up
}

movement Route43_Gatehouse_Movement_RocketGruntWalkLeftDown {
    delay_4 * 3
    walk_faster_left
    walk_faster_down * 4
}

movement Route43_Gatehouse_Movement_RocketGruntWalkRightDown {
    walk_faster_right * 2
    walk_faster_down * 4
    face_up
}

script Route43_Gatehouse_EventScript_RocketGrunt {
    simplenpcmsg("He-he-he. We’re making a bundle.\r"
                 "Everyone wants to see what’s going\n"
                 "on up at Lake of Rage.")
    end
}

script Route43_Gatehouse_EventScript_Attendant {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GOT_TM36_FROM_ROUTE_43_GUARD)) {
        npcmsg("I got chased from my post by\n"
               "these Team Rocket thugs.\r"
               "Then they just disappeared.\n"
               "Someone apparently destroyed\f"
               "their hideout.\r"
               "...One more thing!\f"
               "I found this under the counter.\f"
               "It makes me uncomfortable.\f"
               "Could I give it to you?\r")
        if (!itemspace(ITEM_TM36, 1)) {
            callstd(std_bag_is_full)
            closemessage
            releaseall
            end
        }
        callstd(std_obtain_item_verbose)
        waitbuttonpress
        setflag(FLAG_GOT_TM36_FROM_ROUTE_43_GUARD)
    }
    npcmsg("It contains Sludge Bomb!\r"
           "It not only damages the target\n"
           "but also poisons it sometimes.\f"
           "See!\r"
           "Doesn’t it make you feel\n"
           "uncomfortable?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

mapscripts Route43_Gatehouse_MapScripts {
    INIT_SCRIPT_ON_FRAME_TABLE [
        VAR_UNK_410F, 0: Route43_Gatehouse_EventScript_RocketGruntScene
    ]
    INIT_SCRIPT_ON_TRANSITION: Route43_Gatehouse_OnTransition
}
