    waitmovement
    npcmsg("Could I ask for your cooperation?\r"
           "The shady character was hanging around\n"
           "the Cerulean Gym...\r")
    closemessage
    applymovement(obj_R10R0202_policeman, Route10_PowerPlantBroken_Movement_01E8)
    waitmovement
    clearflag(FLAG_HIDE_CERULEAN_GYM_ROCKET)
    setvar(VAR_SCENE_ROUTE_10_POWER_PLANT, 0)
