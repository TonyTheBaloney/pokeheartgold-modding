script scr_seq_R10R0202_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_POWER_PLANT_MANAGERS_STORY)) {
        npcmsg("Could I ask for your cooperation?\r"
               "The shady character was hanging around\n"
               "the Cerulean Gym...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("A thief broke into the Power Plant...\n"
           "What is the world coming to?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_R10R0202_005 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_TRADE_POWER_PLANT_DUGTRIO_MAGNETON)) {
        npcmsg("Hi, how’s my old MAGNETON doing?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("I collect Pokémon.\n"
           "Do you have a DUGTRIO?\r"
           "Want to trade it for my MAGNETON? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_02CD) }
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    choosepartymonfortrade
    getpartyselection(VAR_SPECIAL_RESULT)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_RESULT) == 255) { goto(_02CD) }
    loadnpctrade(8)
    copyvar(VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT)
    getpartymonspecies(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    npctradegetreqspecies(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_x8005) != VAR_SPECIAL_RESULT) { goto(_02C0) }
    npctradeexec(VAR_SPECIAL_x8004)
    npctradeend
    setflag(FLAG_TRADE_POWER_PLANT_DUGTRIO_MAGNETON)
    npcmsg("Yay! I got myself a DUGTRIO!\n"
           "Thanks!")
    waitbuttonpress
    closemessage
    releaseall
    end
_02C0:
    npctradeend
    npcmsg("Huh? That’s not DUGTRIO.\n"
           "What a letdown...")
    waitbuttonpress
    closemessage
    releaseall
    end
_02CD:
    npcmsg("You don’t want to trade? Aww...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_R10R0202_003 {
    simplenpcmsg("The Power Plant’s Manager is up ahead.\r"
                 "But since someone wrecked the\n"
                 "generator, he’s been both sad and,\f"
                 "at times, furious...\r"
                 "Sometimes he would burst out laughing\n"
                 "out of desperation.\f"
                 "We’ve had to go through so much...")
    end
}

script scr_seq_R10R0202_001 {
    simplenpcmsg("Someone made off with a part that’s\n"
                 "essential for the generator.\r"
                 "Without it, the new generator’s\n"
                 "useless!")
    end
}

script scr_seq_R10R0202_002 {
    simplenpcmsg("This Power Plant had been abandoned in\n"
                 "the past.\r"
                 "We got it back up and running to provide\n"
                 "power to the Magnet Train.")
    end
}

script scr_seq_R10R0202_004 {
    simplenpcmsg("The Magnet Train consumes a lot\n"
                 "of electricity.\r"
                 "It can’t move if the new generator\n"
                 "isn’t operating.")
    end
}

script scr_seq_R10R0202_008 {
    simplenpcmsg("Staff Mottos:\r"
                 "1. Electricity is not infinite.\n"
                 "2. Conserve wherever possible.\f"
                 "3. Watch out for each other.\f"
                 "4. Idle hands are not allowed.\f"
                 "5. Wear shoes with rubber soles.\f"
                 "6. The Manager is awesome.")
    end
}

script scr_seq_R10R0202_009 {
    simplenpcmsg("Use electricity wisely\n"
                 "for a bright and pleasant life.\f"
                 "           Kanto Power Plant")
    end
}

