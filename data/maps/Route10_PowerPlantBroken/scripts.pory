script scr_seq_R10R0202_006 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    hasitem(ITEM_MACHINE_PART, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) >= 1) {
        npcmsg("Manager: Ah! Yeah!\n"
               "The thing you have...\r"
               "Is that the part that was stolen from\n"
               "my beloved generator?\r"
               "You found it?\n"
               "Thank you so much!\r"
               "Now, all I have to do is...\n"
               "attach this part here...\r")
        closemessage
        takeitem(ITEM_MACHINE_PART, 1, VAR_SPECIAL_RESULT)
        applymovement(obj_R10R0202_gsbigman, Route10_PowerPlantBroken_Movement_0108)
        waitmovement
        waitse(SEQ_SE_GS_W012)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        warp(MAP_ROUTE_10_POWER_PLANT_REPAIRED, 0, 13, 7, DIR_SOUTH)
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        npcmsg("Manager: Whirrrrrr!\r"
               "Yes, it’s running!\n"
               "Whirrr, whirrr!\r")
        applymovement(obj_R10R0202_gsbigman, Route10_PowerPlantBroken_Movement_0120)
        waitmovement
        setflag(FLAG_RESTORED_POWER)
        npcmsg("Manager: Wahah! Thanks!\r"
               "Here! Go ahead and take this TM\n"
               "as a reward!\r")
        giveitemnocheck(ITEM_TM57, 1)
        npcmsg("Manager: TM57 is my Charge Beam!\r"
               "It will shoot beams, and it can also\n"
               "sometimes raise Special Attack!")
        waitbuttonpress
        closemessage
        setflag(FLAG_UNK_258)
        clearflag(FLAG_HIDE_LAVENDER_RADIO_TOWER_DIRECTOR)
        setflag(FLAG_HIDE_SAFFRON_CITY_COPYCAT_HOUSE_CLEFAIRY_DOLL)
        clearflag(FLAG_HIDE_VERMILION_FAN_CLUB_LOST_ITEM)
        setvar(VAR_UNK_40FF, 1)
        releaseall
        end
        callstd(std_bag_is_full)
        closemessage
        releaseall
        end
    }
    if (!flag(FLAG_GOT_POWER_PLANT_MANAGERS_STORY)) {
        setflag(FLAG_GOT_POWER_PLANT_MANAGERS_STORY)
        setvar(VAR_SCENE_ROUTE_10_POWER_PLANT, 1)
    }
    npcmsg("Manager: I-I-I’m ready to blast\n"
           "something!\r"
           "Who would dare steal a part from the\n"
           "generator?\r"
           "I spent so much time fixing it!\n"
           "If I catch him, he’s going to see\f"
           "what I can do with my Charge Beam!")
    waitbuttonpress
    closemessage
    applymovement(obj_R10R0202_policeman, Route10_PowerPlantBroken_Movement_0100)
    waitmovement
    releaseall
    end
}

