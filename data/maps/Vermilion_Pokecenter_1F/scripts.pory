    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_CAUGHT_SNORLAX)) {
        npcmsg("There used to be a sleeping Pokémon\n"
               "lying in the middle of the road.\f"
               "But it seems to have disappeared.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("A sleeping Pokémon is lying in the\n"
           "middle of the road.\r"
           "It’s a fantastic opportunity to get it,\n"
           "but how do you wake it up?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

