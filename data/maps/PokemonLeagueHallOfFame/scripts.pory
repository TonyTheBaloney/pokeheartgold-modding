movement PokemonLeagueHallOfFame_Movement_PlayerWalkUp1 {
    walk_up * 14
    face_right * 2
}

movement PokemonLeagueHallOfFame_Movement_LanceWalkUpRight {
    walk_up * 12
    face_right * 2
    walk_right
    face_left * 2
}

movement PokemonLeagueHallOfFame_Movement_PlayerWalkUp2 {
    face_up * 2
    walk_up * 4
}

