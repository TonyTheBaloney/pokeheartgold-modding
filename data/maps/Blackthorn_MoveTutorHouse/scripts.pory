script scr_seq_T30R0601_004 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("To the Pokémon listed here,\n"
           "the ultimate moves may be taught!\r"
           "The blazing Fire-type Pokémon\n"
           "{CURSOR_X 7}CHARIZARD TYPHLOSION\f"
           "{CURSOR_X 7}BLAZIKEN INFERNAPE\r"
           "The restless Water-type Pokémon\n"
           "{CURSOR_X 7}BLASTOISE FERALIGATR\f"
           "{CURSOR_X 7}SWAMPERT EMPOLEON\r"
           "The quiet Grass-type Pokémon\n"
           "{CURSOR_X 7}VENUSAUR MEGANIUM\f"
           "{CURSOR_X 7}SCEPTILE TORTERRA")
    waitbuttonpress
    closemessage
    releaseall
    end
}

