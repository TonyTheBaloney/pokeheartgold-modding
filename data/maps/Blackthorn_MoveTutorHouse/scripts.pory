script scr_seq_T30R0601_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_MET_MOVE_MANIAC)) {
        npcmsg("Me?\n"
               "I’m the Pokémon Move Maniac.\r"
               "I know every move that Pokémon learn\n"
               "while they’re leveling up, and I can\f"
               "make Pokémon remember those moves.\r"
               "I can make a Pokémon of yours remember\n"
               "a move if you’d like.\r"
               "But...ahem! It’ll cost you.\r"
               "I’ll make a Pokémon remember a move\n"
               "if you’ll trade me a Heart Scale.")
        waitbuttonpress
        closemessage
        releaseall
        setflag(FLAG_MET_MOVE_MANIAC)
        end
    }
    hasitem(ITEM_HEART_SCALE, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_022D) }
    npcmsg("Ha! That’s it! That’s an honest-to-\n"
           "goodness Heart Scale!\r"
           "Let me guess, you want me to teach\n"
           "one of your Pokémon a move?\r")
    npcmsg("Which Pokémon needs tutoring?\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    partyselectui
    getpartyselection(VAR_SPECIAL_x8005)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_x8005) == 255) { goto(_022D) }
    getpartymonspecies(VAR_SPECIAL_x8005, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Hunh?\r"
               "Don’t you think it’d be tough for\n"
               "an Egg to remember a move?\r"
               "It’s not even hatched.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    monhasrelearnablemoves(VAR_SPECIAL_RESULT, VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0222) }
    npcmsg("Which move should I make it remember?\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    moverelearnerinit(VAR_SPECIAL_x8005)
    moverelearnergetresult(VAR_SPECIAL_RESULT)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_RESULT) == 255) { goto(_022D) }
    takeitem(ITEM_HEART_SCALE, 1, VAR_SPECIAL_RESULT)
    bufferplayersname(3)
    npcmsg("{STRVAR_1 3, 3, 0} handed over one\n"
           "Heart Scale in exchange.")
    waitbuttonpress
    closemessage
    releaseall
    end
_0222:
    npcmsg("Sorry...\r"
           "There isn’t any move I can make\n"
           "that Pokémon remember.")
    waitbuttonpress
    closemessage
    releaseall
    end
_022D:
    npcmsg("If any of your Pokémon needs to learn a\n"
           "move, come back with a Heart Scale.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

