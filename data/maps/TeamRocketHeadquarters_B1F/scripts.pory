script scr_seq_D35R0102_004 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_40AC) >= 9) {
        npcmsg("The secret switch is not lit anymore...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_UNK_0D6)) { goto(_0E58) }
    npcmsg("A secret switch!\r"
           "The red switch is flashing in a\n"
           "suspicious manner.\f"
           "Will you press it? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) != 0) {
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0F1E) }
    }
    playse(SEQ_SE_DP_DENSI01)
    npcmsg(msg_0112_D35R0102_00007)
    closemessage
    setflag(FLAG_UNK_0D6)
    if (var(VAR_UNK_40AD) < 2) {
        setvar(VAR_UNK_40AD, 1)
        applymovement(obj_D35R0102_aji_peru, TeamRocketHeadquarters_B1F_Movement_04A4)
    }
    if (var(VAR_UNK_40AE) < 2) {
        setvar(VAR_UNK_40AE, 1)
        applymovement(obj_D35R0102_aji_peru_2, TeamRocketHeadquarters_B1F_Movement_04A4)
    }
    if (var(VAR_UNK_40AF) < 2) {
        setvar(VAR_UNK_40AF, 1)
        applymovement(obj_D35R0102_aji_peru_3, TeamRocketHeadquarters_B1F_Movement_04A4)
    }
    if (var(VAR_UNK_40B0) < 2) {
        setvar(VAR_UNK_40B0, 1)
        applymovement(obj_D35R0102_aji_peru_4, TeamRocketHeadquarters_B1F_Movement_04A4)
    }
    if (var(VAR_UNK_40B1) < 2) {
        setvar(VAR_UNK_40B1, 1)
        applymovement(obj_D35R0102_aji_peru_5, TeamRocketHeadquarters_B1F_Movement_04A4)
        waitmovement
    }
    npcmsg("The surveillance system is off!")
    waitbuttonpress
    closemessage
    releaseall
    end
_0E58:
    npcmsg("A secret switch!\r"
           "The blue switch is lit.\f"
           "Will you press it? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) != 0) {
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0F1E) }
    }
    playse(SEQ_SE_DP_DENSI01)
    npcmsg(msg_0112_D35R0102_00007)
    closemessage
    clearflag(FLAG_UNK_0D6)
    if (var(VAR_UNK_40AD) < 2) {
        setvar(VAR_UNK_40AD, 0)
        applymovement(obj_D35R0102_aji_peru, TeamRocketHeadquarters_B1F_Movement_04AC)
    }
    if (var(VAR_UNK_40AE) < 2) {
        setvar(VAR_UNK_40AE, 0)
        applymovement(obj_D35R0102_aji_peru_2, TeamRocketHeadquarters_B1F_Movement_04AC)
    }
    if (var(VAR_UNK_40AF) < 2) {
        setvar(VAR_UNK_40AF, 0)
        applymovement(obj_D35R0102_aji_peru_3, TeamRocketHeadquarters_B1F_Movement_04AC)
    }
    if (var(VAR_UNK_40B0) < 2) {
        setvar(VAR_UNK_40B0, 0)
        applymovement(obj_D35R0102_aji_peru_4, TeamRocketHeadquarters_B1F_Movement_04AC)
    }
    if (var(VAR_UNK_40B1) < 2) {
        setvar(VAR_UNK_40B1, 0)
        applymovement(obj_D35R0102_aji_peru_5, TeamRocketHeadquarters_B1F_Movement_04AC)
        waitmovement
    }
    npcmsg("The surveillance system is on!")
    waitbuttonpress
    closemessage
    releaseall
    end
_0F1E:
    closemessage
    releaseall
    end
}

