script scr_seq_T06GYM0101_021 {
    if (!flag(FLAG_HIDE_VERMILION_GYM_STOPS)) {
        clearflag(FLAG_SYS_SOLVED_LT_SURGE_GYM)
    }
    vermiliongyminit
    getphonebookrematch(PHONE_CONTACT_LT__SURGE, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 0) {
        setflag(FLAG_HIDE_VERMILION_GYM_LT_SURGE)
        end
    }
    if (!flag(FLAG_CAUGHT_ZAPDOS)) { goto(_0144) }
    checkregisteredphonenumber(PHONE_CONTACT_LT__SURGE, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_00FB) }
    getcurrenthour(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 9) {
        setflag(FLAG_HIDE_VERMILION_GYM_LT_SURGE)
    } elif (var(VAR_TEMP_x4000) == 10) {
        setflag(FLAG_HIDE_VERMILION_GYM_LT_SURGE)
    } elif (var(VAR_TEMP_x4000) == 11) {
        setflag(FLAG_HIDE_VERMILION_GYM_LT_SURGE)
    } else {
        clearflag(FLAG_HIDE_VERMILION_GYM_LT_SURGE)
    }
    end
_00FB:
    if (flag(FLAG_TRADE_LT_SURGE_PIKACHU)) { goto(_010C) }
    setflag(FLAG_HIDE_VERMILION_GYM_LT_SURGE)
    end
_010C:
    getweekday(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 5) {
        setflag(FLAG_HIDE_VERMILION_GYM_LT_SURGE)
    } elif (var(VAR_TEMP_x4000) == 6) {
        setflag(FLAG_HIDE_VERMILION_GYM_LT_SURGE)
    } else {
        clearflag(FLAG_HIDE_VERMILION_GYM_LT_SURGE)
    }
    end
_0144:
    clearflag(FLAG_HIDE_VERMILION_GYM_LT_SURGE)
    end
}

