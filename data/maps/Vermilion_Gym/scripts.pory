script scr_seq_T06GYM0101_014 {
    vermiliongymcancheck(14, VAR_SPECIAL_RESULT)
    goto(_023A)
    end
_023A:
    if (var(VAR_SPECIAL_RESULT) == 4) {
        playse(SEQ_SE_DP_SELECT)
        lockall
        npcmsg(msg_0485_T06GYM0101_00008)
        waitbuttonpress
        closemessage
        releaseall
        end
    _028E:
        playse(SEQ_SE_DP_SELECT)
        lockall
        npcmsg(msg_0485_T06GYM0101_00009)
        waitbuttonpress
        closemessage
        vermiliongymlockaction(0, 0)
        npcmsg("The first electric fence is unlocked!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_SPECIAL_RESULT) == 2) {
        playse(SEQ_SE_DP_SELECT)
        lockall
        npcmsg(msg_0485_T06GYM0101_00009)
        waitbuttonpress
        closemessage
        vermiliongymlockaction(1, 0)
        setflag(FLAG_SYS_SOLVED_LT_SURGE_GYM)
        stopse(SEQ_SE_GS_DENGEKIBARIA)
        npcmsg("The second electric fence is unlocked!\r"
               "Now the electric fences are gone, and\n"
               "the path to the Leader is clear!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_028E) }
    if (var(VAR_SPECIAL_RESULT) == 3) {
        playse(SEQ_SE_DP_SELECT)
        lockall
        npcmsg("Nope! Nothing here but trash.\n"
               "Oh no, the electric fence is\f"
               "locked again!")
        waitbuttonpress
        closemessage
        vermiliongymlockaction(0, 1)
        resamplevermiliongymcans
        releaseall
        end
    }
    if (var(VAR_SPECIAL_RESULT) == 0) {
        playse(SEQ_SE_DP_SELECT)
        lockall
        npcmsg(msg_0485_T06GYM0101_00008)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    end
}

