script scr_seq_T06GYM0101_023 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_THUNDER, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        if (!flag(FLAG_GOT_TM34_FROM_LT_SURGE)) { goto(_0389) }
        npcmsg("Lt. Surge: Hey, kid!\n"
               "Still slugging and chugging away?\r"
               "When you go north, you will see a\n"
               "big city called Saffron!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Lt. Surge: Hey, you little tyke!\r"
           "It may not be very smart to\n"
           "challenge me, but it takes guts!\r"
           "When it comes to Electric-type Pokémon,\n"
           "I’m number one!\r"
           "I’ve never lost on the battlefield.\r"
           "I’ll zap you just like I do all my\n"
           "enemies in battle!\r")
    closemessage
    trainerbattle(TRAINER_LEADER_LT_SURGE_LT__SURGE, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    givebadge(BADGE_THUNDER)
    addvar(VAR_UNK_4135, 1)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    setflag(FLAG_HIDE_VERMILION_GYM_STOPS)
    removeobject(obj_T06GYM0101_stop)
    removeobject(obj_T06GYM0101_stop_2)
    removeobject(obj_T06GYM0101_stop_3)
    removeobject(obj_T06GYM0101_stop_4)
    removeobject(obj_T06GYM0101_stop_5)
    removeobject(obj_T06GYM0101_stop_6)
    settrainerflag(TRAINER_GUITARIST_VINCENT)
    settrainerflag(TRAINER_GENTLEMAN_GREGORY)
    settrainerflag(TRAINER_JUGGLER_HORTON)
    npcmsg("Lt. Surge: Arrrgh!\n"
           "You are strong!\r"
           "OK, kid.\n"
           "You get the Thunder Badge!\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Thunder Badge from Lt. Surge!")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    npcmsg("Lt. Surge: That Thunder Badge suits\n"
           "those who’ve defeated me!\f"
           "Take good care of it, OK?\r"
           "There is something else.\n"
           "Here is a great TM for you!\r")
    goto(_0389)
_0389:
    if (!itemspace(ITEM_TM34, 1)) { goto(_03BD) }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM34_FROM_LT_SURGE)
    npcmsg("Lt. Surge: That TM contains\n"
           "Shock Wave... Zzzap!\r"
           "Use it to go like lightning!\r"
           "When you go north, you will see\n"
           "a big city called Saffron!")
    waitbuttonpress
    closemessage
    releaseall
    end
_03BD:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

script scr_seq_T06GYM0101_024 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_THUNDER, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Whew! That was an electrifying bout!\n"
               "It sure made my nerves tingle.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Yo! Legend in the making!\n"
           "You lucked out this time.\r"
           "The traps at this Gym have been out\n"
           "of order for a while.\r"
           "But the traps are back up and\n"
           "running now!\f"
           "Why lucky, you may ask...\r"
           "Because you can train yourself better\n"
           "that way!\r"
           "Make up your mind and go for Lt. Surge!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T06GYM0101_025 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_THUNDER, VAR_SPECIAL_RESULT)
    bufferplayersname(0)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Vermilion City Pokémon Gym")
    } else {
        npcmsg("Vermilion City Pokémon Gym\r"
               "Gym Leader: Lt. Surge\n"
               "Certified Trainer!\f"
               "{STRVAR_1 3, 0, 0}")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

