        setbikestatelock(1)
        setvar(VAR_UNK_4129, 1)
        setvar(VAR_UNK_412A, 1)
        setflag(FLAG_UNK_149)
        releaseall
        end
    }
    applymovement(obj_player, Route18_Gatehouse_Movement_PlayerFaceUp)
    waitmovement
    npcmsg("Hey, you!\r"
           "Cycling Road is for cyclists only.\n"
           "You have to be on a Bicycle if you want\f"
           "to proceed!\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, Route18_Gatehouse_Movement_PlayerWalkRight)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    releaseall
    end
}

movement Route18_Gatehouse_Movement_PlayerFaceUp {
    walk_in_place_up
}

movement Route18_Gatehouse_Movement_PlayerWalkRight {
    walk_right
}

