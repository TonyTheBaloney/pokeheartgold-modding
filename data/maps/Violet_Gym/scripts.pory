scrdefs {
    Violet_Gym_OnTransition
    Violet_Gym_EventScript_Falkner
    Violet_Gym_EventScript_GymGuide1
    Violet_Gym_EventScript_GymSign
    Violet_Gym_EventScript_Trigger
    Violet_Gym_EventScript_GymGuide2
}

script Violet_Gym_OnTransition {
    violetgyminit
    getphonebookrematch(PHONE_CONTACT_FALKNER, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 0) {
        setflag(FLAG_HIDE_VIOLET_GYM_FALKNER)
        end
    }
    checkregisteredphonenumber(PHONE_CONTACT_FALKNER, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_007E) }
    checkbadge(BADGE_SOUL, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_005B) }
    goto(_00A1)
_005B:
    getweekday(VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) {
        setflag(FLAG_HIDE_VIOLET_GYM_FALKNER)
    } else {
        goto(_00A1)
    }
    end
_007E:
    getweekday(VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 3) {
        setflag(FLAG_HIDE_VIOLET_GYM_FALKNER)
    } else {
        goto(_00A1)
    }
    end
_00A1:
    clearflag(FLAG_HIDE_VIOLET_GYM_FALKNER)
    end
}

script Violet_Gym_EventScript_Falkner {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_ZEPHYR, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        if (!flag(FLAG_GOT_TM51_FROM_FALKNER)) { goto(_0126) }
        npcmsg("Falkner: There are Pokémon Gyms in\n"
               "cities and towns ahead.\r"
               "You should test your skills at\n"
               "these Gyms.\r"
               "As for your next move...\f"
               "I would suggest Azalea Town.\r"
               "I’m going to train harder to become\n"
               "the greatest Bird Keeper of all!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Falkner: I’m Falkner, the Violet City\n"
           "Pokémon Gym Leader!\r"
           "People say you can clip Flying-type\n"
           "Pokémon’s wings with a jolt\f"
           "of electricity...\r"
           "I won’t allow such insults to bird\n"
           "Pokémon!\r"
           "I’ll show you the real power of the\n"
           "magnificent bird Pokémon!\r")
    closemessage
    trainerbattle(TRAINER_LEADER_FALKNER_FALKNER, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    givebadge(BADGE_ZEPHYR)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    settrainerflag(TRAINER_BIRD_KEEPER_GS_ROD)
    settrainerflag(TRAINER_BIRD_KEEPER_GS_ABE)
    setvar(VAR_SCENE_VIOLET_CITY_OW, 1)
    setflag(FLAG_UNK_192)
    setvar(VAR_SCENE_ELMS_LAB, 6)
    setflag(FLAG_UNK_0F4)
    setflag(FLAG_HIDE_WIFI_CLUB_CLOSED_LADY)
    npcmsg("Falkner: ...For pity’s sake!\n"
           "My dad’s cherished bird Pokémon...\r"
           "But a defeat is a defeat.\n"
           "All right.\r"
           "Take this official Pokémon\n"
           "League Badge.\f"
           "This one is the Zephyr Badge.\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Zephyr Badge from Falkner!")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    npcmsg("Falkner: With that Badge, Pokémon,\n"
           "including traded Pokémon up to Lv. 20,\f"
           "will obey you without question.\r"
           "It also enables you to use the hidden\n"
           "move Rock Smash anytime outside\f"
           "of battle.\r")
    goto(_0126)
_0126:
    if (!itemspace(ITEM_TM51, 1)) { goto(_015E) }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM51_FROM_FALKNER)
    clearflag(FLAG_HIDE_NEW_BARK_FRIENDS_ROOM_FRIEND)
    npcmsg("Falkner: By using a TM, a Pokémon will\n"
           "instantly learn a new move.\r"
           "Think before you act--a TM can be\n"
           "used only once.\r"
           "TM51 contains Roost.\n"
           "It restores half the max HP.\r"
           "There are Pokémon Gyms in cities and\n"
           "towns ahead. Make good use of them!\r"
           "As for your next move...\f"
           "I would suggest Azalea Town.")
    waitbuttonpress
    closemessage
    releaseall
    end
_015E:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

script Violet_Gym_EventScript_GymGuide1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_ZEPHYR, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Nice battle! Keep it up, and you’ll\n"
               "be the Champ in no time at all!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Yo, Champ in the making!\n"
           "I’m no Trainer, but I can give\f"
           "some advice!\f"
           "Believe me!\f"
           "If you believe, then a Championship\f"
           "dream can come true.\r"
           "You believe?\n"
           "Then listen.\r"
           "The Grass type is weak against the\n"
           "Flying type. Keep this in mind.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Violet_Gym_EventScript_GymGuide2 {
    simplenpcmsg("Yo! Champ in the making!\n"
                 "You must be here to challenge\f"
                 "Falkner, the Gym Leader, right?\r"
                 "You are quite welcome.\n"
                 "...Almost!\r"
                 "This city has a tower called the\n"
                 "Sprout Tower where Trainers\f"
                 "come to train themselves.\r"
                 "Challenging Falkner may be too\n"
                 "difficult if you haven’t gone through\f"
                 "their training.\f"
                 "Ha ha ha!")
    end
}

script Violet_Gym_EventScript_GymSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_ZEPHYR, VAR_SPECIAL_RESULT)
    bufferplayersname(0)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Violet City Pokémon Gym")
    } else {
        npcmsg("Violet City Pokémon Gym\r"
               "Gym Leader: Falkner\n"
               "Certified Trainer!\f"
               "{STRVAR_1 3, 0, 0}")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Violet_Gym_EventScript_Trigger {
    setvar(VAR_TEMP_x4000, 0)
    violetgymelevator
    end
}

mapscripts Violet_Gym_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Violet_Gym_OnTransition
}
