script Route14_EventScript_Woman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_LUCKY_PUNCH_FROM_ROUTE_14_WOMAN)) {
        playeronbikecheck(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) != 1) {
            getpartyleadalive(VAR_TEMP_x4000)
            getpartymonspecies(VAR_TEMP_x4000, VAR_TEMP_x4001)
            if (var(VAR_TEMP_x4001) == 113) {
                npcmsg("Hello, you lovely CHANSEY!")
                waitbuttonpress
                closemessage
                releaseall
                end
            }
        }
        npcmsg("Do you know which is the cutest Pokémon\n"
               "in the world?\f"
               "It is CHANSEY, of course!\f"
               "I say CHANSEY, and that’s final!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Do you know which is the cutest Pokémon\n"
           "in the world?\f"
           "It’s CHANSEY, of course!\f"
           "I say CHANSEY, and that’s final!\r")
    playeronbikecheck(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 1) {
        getpartyleadalive(VAR_TEMP_x4000)
        getpartymonspecies(VAR_TEMP_x4000, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) == 113) { goto(_060D) }
    }
    npcmsg("I will give you something good\n"
           "if you can bring me a CHANSEY!")
    waitbuttonpress
    closemessage
    releaseall
    end
_060D:
    applymovement(obj_R14_gswoman1, Route14_Movement_WomanExclamation)
    waitmovement
    npcmsg("That Pokémon is...CHANSEY!\r"
           "What are the chances of\n"
           "seeing CHANSEY this close?\r"
           "Take this as a token of my gratitude!\r")
    if (!itemspace(ITEM_LUCKY_PUNCH, 1)) { goto(_064E) }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_LUCKY_PUNCH_FROM_ROUTE_14_WOMAN)
    npcmsg("Let a CHANSEY hold this Lucky Punch,\n"
           "and it’ll have a better chance at\f"
           "getting critical hits!\r"
           "Isn’t that awesome?!")
    waitbuttonpress
    closemessage
    releaseall
    end
_064E:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

