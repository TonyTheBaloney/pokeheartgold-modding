script scr_seq_T07R0203_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkjohtodexcomplete(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0245) }
    if (!flag(FLAG_SAW_JOHTO_DEX_CERTIFICATE)) {
        npcmsg("Wow, you did it!\n"
               "You have filled up the\f"
               "Johto Pokédex!\r"
               "Impressive! I’m amazed!\n"
               "I will reward you for that!\f"
               "Seriously!\r")
        playfanfare(SEQ_ME_HYOUKA2)
        waitfanfare
        closemessage
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        showcertificate(0)
        restoreoverworld
        setflag(FLAG_SAW_JOHTO_DEX_CERTIFICATE)
        addspecialgamestat(SCORE_EVENT_REGIONAL_DEX_COMPLETE)
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
    }
    checknationaldexcomplete(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0245) }
    if (!flag(FLAG_SAW_NATIONAL_DEX_CERTIFICATE)) {
        npcmsg("Wow! Excellent!\n"
               "You completed your Pokédex!\f"
               "Congratulations!\r"
               "You must be the genius of the century!\n"
               "Seriously!\r"
               "Game Freak will give you an award\n"
               "and prove that it’s the truth!\r")
        playfanfare(SEQ_ME_HYOUKA2)
        waitfanfare
        closemessage
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        showcertificate(1)
        restoreoverworld
        setflag(FLAG_SAW_NATIONAL_DEX_CERTIFICATE)
        addspecialgamestat(SCORE_EVENT_NATIONAL_DEX_COMPLETE)
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
    }
    npcmsg("I bet it was a long way to complete\n"
           "the Pokédex.\r"
           "Remember, the most precious thing of\n"
           "all was the time you’ve worked hard\f"
           "going everywhere to complete\f"
           "the Pokédex.\r"
           "I just said something deep! Seriously!")
    waitbuttonpress
    closemessage
    releaseall
    end
_0245:
    npcmsg("I’m the Game Director!\r"
           "Filling up your Pokédex is tough,\n"
           "but don’t give up!\r"
           "You can do it! Seriously!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T07R0203_009 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_EARTH, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getitemquantity(ITEM_GB_SOUNDS, VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) != 0) {
            npcmsg("I find GB Sounds to be incredible!\n"
                   "Even places that were built recently\f"
                   "have nice, classic music.\r"
                   "Behold the full extent of my passion!\r"
                   "...Did I say “behold”? What am\n"
                   "I saying?\r"
                   "Anyway, try it at various places!\r"
                   "There are some places you won’t\n"
                   "hear classic music...\r"
                   "But that’s life!")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("I am the Sound Designer!\n"
               "I compose music.\r"
               "Wow, you have collected\n"
               "all the Kanto Badges already!\f"
               "That’s great!\r"
               "I’ll give you something cool\n"
               "for that.\r")
        giveitemnocheck(ITEM_GB_SOUNDS, 1)
        npcmsg("GB is a rectangular thing with a\n"
               "black-and-white screen that you used\f"
               "to play the original Pokémon...\f"
               "Oh, wait! That was a Game Boy!\r"
               "Turn it on and GB Sounds will let you\n"
               "hear some nostalgic sounds.\r"
               "It’s a gadget full of wonder!\n"
               "Try it at various places!\r"
               "There are some places you won’t\n"
               "hear classic music...\r"
               "But that’s life!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("I am the Sound Designer!\n"
           "I compose music.\r"
           "I’ll give you something cool if you\n"
           "manage to collect all eight\f"
           "Kanto Badges and show them to me.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

