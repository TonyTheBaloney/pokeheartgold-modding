}

script Celadon_Condominiums_3F_OnResume {
    if (var(VAR_UNK_412C) == 0) {
        movepersonfacing(obj_T07R0203_var_1, 12, 0, 6, DIR_WEST)
        movepersonfacing(obj_T07R0203_tsure_poke_static_marill, 13, 0, 6, DIR_WEST)
    }
    end
}

script Celadon_Condominiums_3F_EventScript_LyraScene {
    followmonresetmovement
    lockall
    callstd(std_play_friend_music)
    applymovement(obj_T07R0203_var_1, Celadon_Condominiums_3F_Movement_FriendWalkLeft1)
    applymovement(obj_T07R0203_tsure_poke_static_marill, Celadon_Condominiums_3F_Movement_MarillWalkLeft1)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("Lyra: Hi, {STRVAR_1 3, 0, 0}!\r", "Ethan: Hey, {STRVAR_1 3, 0, 0}!\r")
    closemessage
    applymovement(obj_T07R0203_var_1, Celadon_Condominiums_3F_Movement_FriendWalkLeft2)
    applymovement(obj_T07R0203_tsure_poke_static_marill, Celadon_Condominiums_3F_Movement_MarillWalkLeft2)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, Celadon_Condominiums_3F_Movement_PlayerWalkDown)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    bufferplayersname(0)
    gendermsgbox("Lyra: Guess what?\r"
                 "That Sound Designer over there\n"
                 "showed me something cool.\r"
                 "It’s a hi-tech, retro machine to\n"
                 "listen to music from the Game Boy!\r"
                 "He said he’ll give it to anyone\n"
                 "who has collected all of the\f"
                 "Kanto Badges.\r"
                 "Why don’t you go for it, {STRVAR_1 3, 0, 0}?\n"
                 "See ya!\r", "Ethan: Guess what?\r"
                              "That Sound Designer over there\n"
                              "showed me something cool.\r"
                              "It’s a hi-tech, retro machine to\n"
                              "listen to music from the Game Boy!\r"
                              "He said he’ll give it to anyone\n"
                              "who has collected all of the\f"
                              "Kanto Badges.\r"
                              "Why don’t you go for it, {STRVAR_1 3, 0, 0}?\n"
                              "See ya!\r")
    closemessage
    applymovement(obj_T07R0203_var_1, Celadon_Condominiums_3F_Movement_FriendWalkUpLeft)
    applymovement(obj_T07R0203_tsure_poke_static_marill, Celadon_Condominiums_3F_Movement_MarillWalkLeftUp)
    waitmovement
    dooranimationload(0, 0, 3, 2, 77)
    dooranimationopen(77)
    dooranimationwait(77)
    applymovement(obj_T07R0203_var_1, Celadon_Condominiums_3F_Movement_FriendExit)
    applymovement(obj_T07R0203_tsure_poke_static_marill, Celadon_Condominiums_3F_Movement_MarillExit)
    waitmovement
    dooranimationclose(77)
    dooranimationwait(77)
    dooranimationunload(77)
    callstd(std_fade_end_friend_music)
    setvar(VAR_UNK_412C, 1)
    movepersonfacing(obj_T07R0203_var_1, 29, 0, 29, DIR_WEST)
    movepersonfacing(obj_T07R0203_tsure_poke_static_marill, 29, 0, 29, DIR_WEST)
    releaseall
    end
}

movement Celadon_Condominiums_3F_Movement_FriendWalkLeft1 {
    walk_left * 4
    emote_exclamation_mark
}

movement Celadon_Condominiums_3F_Movement_MarillWalkLeft1 {
    walk_left * 4
}

movement Celadon_Condominiums_3F_Movement_FriendWalkLeft2 {
    walk_left * 4
}

movement Celadon_Condominiums_3F_Movement_MarillWalkLeft2 {
    walk_left * 4
}

movement Celadon_Condominiums_3F_Movement_PlayerWalkDown {
    walk_down * 3
    walk_in_place_right
}

movement Celadon_Condominiums_3F_Movement_FriendWalkUpLeft {
    walk_up * 2
    walk_left
    walk_up
}

movement Celadon_Condominiums_3F_Movement_MarillWalkLeftUp {
    walk_left
    walk_up * 2
    walk_left
    walk_in_place_up
}

movement Celadon_Condominiums_3F_Movement_FriendExit {
    walk_up
    set_invisible
}

movement Celadon_Condominiums_3F_Movement_MarillExit {
    walk_up * 2
    set_invisible
}

script Celadon_Condominiums_3F_EventScript_AceTrainerM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkjohtodexcomplete(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0245) }
    if (!flag(FLAG_SAW_JOHTO_DEX_CERTIFICATE)) {
        npcmsg("Wow, you did it!\n"
               "You have filled up the\f"
               "Johto Pokédex!\r"
               "Impressive! I’m amazed!\n"
               "I will reward you for that!\f"
               "Seriously!\r")
        playfanfare(SEQ_ME_HYOUKA2)
        waitfanfare
        closemessage
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        showcertificate(0)
        restoreoverworld
        setflag(FLAG_SAW_JOHTO_DEX_CERTIFICATE)
        addspecialgamestat(SCORE_EVENT_REGIONAL_DEX_COMPLETE)
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
    }
    checknationaldexcomplete(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0245) }
    if (!flag(FLAG_SAW_NATIONAL_DEX_CERTIFICATE)) {
        npcmsg("Wow! Excellent!\n"
               "You completed your Pokédex!\f"
               "Congratulations!\r"
               "You must be the genius of the century!\n"
               "Seriously!\r"
               "Game Freak will give you an award\n"
               "and prove that it’s the truth!\r")
        playfanfare(SEQ_ME_HYOUKA2)
        waitfanfare
        closemessage
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        showcertificate(1)
        restoreoverworld
        setflag(FLAG_SAW_NATIONAL_DEX_CERTIFICATE)
        addspecialgamestat(SCORE_EVENT_NATIONAL_DEX_COMPLETE)
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
    }
    npcmsg("I bet it was a long way to complete\n"
           "the Pokédex.\r"
           "Remember, the most precious thing of\n"
           "all was the time you’ve worked hard\f"
           "going everywhere to complete\f"
           "the Pokédex.\r"
           "I just said something deep! Seriously!")
    waitbuttonpress
    closemessage
    releaseall
    end
_0245:
    npcmsg("I’m the Game Director!\r"
           "Filling up your Pokédex is tough,\n"
           "but don’t give up!\r"
           "You can do it! Seriously!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Celadon_Condominiums_3F_EventScript_SchoolKidM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_EARTH, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getitemquantity(ITEM_GB_SOUNDS, VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) != 0) {
            npcmsg("I find GB Sounds to be incredible!\n"
                   "Even places that were built recently\f"
                   "have nice, classic music.\r"
                   "Behold the full extent of my passion!\r"
                   "...Did I say “behold”? What am\n"
                   "I saying?\r"
                   "Anyway, try it at various places!\r"
                   "There are some places you won’t\n"
                   "hear classic music...\r"
                   "But that’s life!")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("I am the Sound Designer!\n"
               "I compose music.\r"
               "Wow, you have collected\n"
               "all the Kanto Badges already!\f"
               "That’s great!\r"
               "I’ll give you something cool\n"
               "for that.\r")
        giveitemnocheck(ITEM_GB_SOUNDS, 1)
        npcmsg("GB is a rectangular thing with a\n"
               "black-and-white screen that you used\f"
               "to play the original Pokémon...\f"
               "Oh, wait! That was a Game Boy!\r"
               "Turn it on and GB Sounds will let you\n"
               "hear some nostalgic sounds.\r"
               "It’s a gadget full of wonder!\n"
               "Try it at various places!\r"
               "There are some places you won’t\n"
               "hear classic music...\r"
               "But that’s life!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("I am the Sound Designer!\n"
           "I compose music.\r"
           "I’ll give you something cool if you\n"
           "manage to collect all eight\f"
           "Kanto Badges and show them to me.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

