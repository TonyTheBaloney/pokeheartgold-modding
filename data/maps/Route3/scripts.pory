script scr_seq_R03_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    partyhasspecies(SPECIES_DEOXYS, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_02DF) }
    getpartyleadalive(VAR_TEMP_x4000)
    getpartymonspecies(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 386) {
        setpartydeoxysform(3)
    } else {
        setpartydeoxysform(3)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        getplayercoords(VAR_SPECIAL_x8006, VAR_SPECIAL_x8007)
        getplayerfacing(VAR_SPECIAL_RESULT)
        warp(MAP_ROUTE_3, 0, VAR_SPECIAL_x8006, VAR_SPECIAL_x8007, VAR_SPECIAL_RESULT)
        playeronbikecheck(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) != 1) {
            if (var(VAR_SPECIAL_RESULT) == 1) {
                followmonsetpositionnexttoplayer(0, 1)
            } else {
                followmonsetpositionnexttoplayer(3, 2)
            }
            togglefollowingpokemonmovement(0)
            followmonspawnreleaseball
            wait(10, VAR_SPECIAL_RESULT)
            togglefollowingpokemonmovement(1)
        }
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
    }
    playcry(SPECIES_DEOXYS, 0)
    npcmsg("Touching the meteorite boosted\n"
           "the Speed of a certain Pokémon.")
    goto(_02D5)
}

