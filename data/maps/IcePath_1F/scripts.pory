script IcePath_1F_EventScript_KimonoGirl {
    playse(SEQ_SE_DP_SELECT)
    lockall
    callstd(std_play_kimono_girl_music)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 1) { goto(_0157) }
    goto(_0169)
    goto(_0157)
_0157:
    bufferplayersname(0)
    npcmsg("Me oh my...\n"
           "Is that you, {STRVAR_1 3, 0, 0}?\f"
           "Fancy meeting you here!\r"
           "To tell the truth...my sandals are\n"
           "frozen on the ice, and I am stuck here.\r"
           "In other words, my flip-flops are\n"
           "quick-frozen to the ground.\r"
           "Tee hee.\r"
           "Well, it’s no laughing matter. Would you\n"
           "come around and push my back?")
    waitbuttonpress
    closemessage
    releaseall
    callstd(std_fade_end_kimono_girl_music)
    end
_0169:
    bufferplayersname(0)
    npcmsg("Me oh my...\n"
           "Is that you, {STRVAR_1 3, 0, 0}?\f"
           "Fancy meeting you here!\r"
           "To tell the truth...my sandals are\n"
           "frozen on the ice, and I am stuck here.\r"
           "In other words, my flip-flops are\n"
           "quick-frozen with the ground.\r"
           "Tee hee.\r"
           "Well, it’s no laughing matter.\n"
           "Would you push my back? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0193) }
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_01F3) }
    end
_0193:
    playse(SEQ_SE_DP_WALL_HIT)
    npcmsg("{SIZE 200}SHOVE!{SIZE 100}\r")
    closemessage
    getplayercoords(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    createcameratarget(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    applymovement(obj_D39R0101_dancer, IcePath_1F_Movement_KimonoGirlWalkDown1)
    applymovement(241, IcePath_1F_Movement_ObjectWalkDown)
    waitmovement
    npcmsg("You really are kind.\r"
           "Thank you so much!\r")
    closemessage
    applymovement(obj_D39R0101_dancer, IcePath_1F_Movement_KimonoGirlWalkDown2)
    waitmovement
    removeobject(obj_D39R0101_dancer)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    callstd(std_fade_end_kimono_girl_music)
    setflag(FLAG_UNK_239)
    setvar(VAR_UNK_40E8, 1)
    applymovement(241, IcePath_1F_Movement_ObjectWalkUp)
    waitmovement
    removecameratarget
    releaseall
    end
_01F3:
