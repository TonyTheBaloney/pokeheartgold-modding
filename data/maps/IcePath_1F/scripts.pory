        applymovement(obj_player, IcePath_1F_Movement_PlayerWalkUp)
    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_player, IcePath_1F_Movement_PlayerWalkUpRight)
        applymovement(obj_D39R0101_gsmiddleman1_2, IcePath_1F_Movement_PokefanMFaceUp)
    } else {
        applymovement(obj_player, IcePath_1F_Movement_PlayerWalkUpLeft)
        applymovement(obj_D39R0101_gsmiddleman1_2, IcePath_1F_Movement_PokefanMFaceUp)
    }
