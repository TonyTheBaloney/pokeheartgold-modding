           "won’t you? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0193) }
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_01F3) }
    end
}

