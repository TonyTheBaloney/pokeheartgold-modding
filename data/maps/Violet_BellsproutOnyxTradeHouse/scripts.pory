script Violet_BellsproutOnyxTradeHouse_EventScript_SchoolKidM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_TRADE_VIOLET_CITY_BELLSPROUT_ONIX)) {
        npcmsg("Hi, how’s my old ONIX doing?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("I collect Pokémon.\n"
           "Do you have BELLSPROUT?\r"
           "Want to trade it for my ONIX? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0041) }
    goto(_00B2)
_0041:
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    choosepartymonfortrade
    getpartyselection(VAR_SPECIAL_RESULT)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_RESULT) == 255) { goto(_00B2) }
    loadnpctrade(0)
    copyvar(VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT)
    getpartymonspecies(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    npctradegetreqspecies(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_x8005) != VAR_SPECIAL_RESULT) { goto(_00A5) }
    npctradeexec(VAR_SPECIAL_x8004)
    npctradeend
    setflag(FLAG_TRADE_VIOLET_CITY_BELLSPROUT_ONIX)
    npcmsg("Yay! I got myself BELLSPROUT!\n"
           "Thanks!")
    waitbuttonpress
    closemessage
    releaseall
    end
_00A5:
    npctradeend
    npcmsg("Huh? That’s not BELLSPROUT.\f"
           "What a letdown...")
    waitbuttonpress
    closemessage
    releaseall
    end
_00B2:
    npcmsg("You don’t want to trade? Aww...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

