    if (var(VAR_TEMP_x4002) == 6) {
        applymovement(obj_T07SP0101_suit, Celadon_GameCorner_Movement_BusinessmanFaceLeft)
    } elif (var(VAR_TEMP_x4002) == 8) {
        applymovement(obj_T07SP0101_suit, Celadon_GameCorner_Movement_BusinessmanFaceRight)
    }
    return
}

script Celadon_GameCorner_EventScript_Businessman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    hasitem(ITEM_COIN_CASE, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        if (var(VAR_TEMP_x4001) == 0) {
            npcmsg("My name is Mr. Game!\r"
                   "My heart pounds with excitement when\n"
                   "people enjoy my Coin game!\r"
                   "In fact, that’s what I live for!\n"
                   "You look like quite a challenger!\r"
                   "Why don’t you play my Coin game?\f"
                   "You can get fabulous prizes if you\n"
                   "manage to collect a lot of Coins. {YESNO 0}")
        } else {
            npcmsg("Did you come back to play\n"
                   "my Coin game?")
        }
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            setvar(VAR_TEMP_x4001, 1)
            npcmsg("Playing my Coin game will make your\n"
                   "heart and my heart both pound with\f"
                   "excitement, you know?")
            goto(_00E4)
        }
        npcmsg("All right!\n"
               "Here is your Coin Case!\r")
        setvar(VAR_TEMP_x4001, 1)
        giveitemnocheck(ITEM_COIN_CASE, 1)
        npcmsg("Show me how you play and make\n"
               "my heart pound with excitement!\r")
        goto(_00E4)
    }
    if (var(VAR_TEMP_x4001) == 0) {
        npcmsg("My name is Mr. Game!\r"
               "My heart pounds with excitement when\n"
               "people enjoy my Coin game!\r"
               "In fact, that’s what I live for!\n"
               "Go ahead and play it!\f"
               "Make my heart pound with excitement!")
        setvar(VAR_TEMP_x4001, 1)
    } elif (var(VAR_TEMP_x4001) == 1) {
        npcmsg("Go ahead and play my Coin game!\n"
               "Make my heart pound with excitement!")
    } else {
        npcmsg("What a feeling!\n"
               "Nothing beats Coin-game spectatorship!\r"
               "Oh! I almost forgot!\r"
               "You can go to the building next door\n"
               "and exchange your Coins for prizes.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

