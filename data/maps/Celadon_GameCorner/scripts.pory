script Celadon_GameCorner_EventScript_Sign1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    hasitem(ITEM_COIN_CASE, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("It seems you need a Coin Case\n"
               "to play...\r")
        applymovement(obj_T07SP0101_suit, Celadon_GameCorner_Movement_BusinessmanFaceDown)
        waitmovement
        npcmsg(msg_0511_T07SP0101_00011)
        goto(_00E4)
    }
    applymovement(obj_T07SP0101_suit, Celadon_GameCorner_Movement_BusinessmanFaceDown)
    waitmovement
    npcmsg("Mr. Game: Show me how you play and\n"
           "make my heart pound with excitement!\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    casinogame(0, 0)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    setvar(VAR_TEMP_x4001, 2)
    releaseall
    end
}

text msg_0511_T07SP0101_00011 {
    "Mr. Game: Aha!\n"
    "You must be here to play my Coin game!\r"
    "Come here and I’ll give you a Coin Case!"
}

