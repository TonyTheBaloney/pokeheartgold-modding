    emote_exclamation_mark
}

movement PokeathlonDome_Interior_B1FFriendshipRoom_Movement_MagnusFaceDown {
    walk_in_place_down
}

movement PokeathlonDome_Interior_B1FFriendshipRoom_Movement_MagnusWalkDown {
    walk_down * 3
}

movement PokeathlonDome_Interior_B1FFriendshipRoom_Movement_MagnusWalkUp1 {
    walk_up * 3
    walk_in_place_down
}

movement PokeathlonDome_Interior_B1FFriendshipRoom_Movement_PlayerWalkUp {
    walk_up * 3
}

movement PokeathlonDome_Interior_B1FFriendshipRoom_Movement_MagnusWalkUp2 {
    walk_slow_up
}

movement PokeathlonDome_Interior_B1FFriendshipRoom_Movement_MagnusWalkRight {
    walk_in_place_left
    lock_dir
    walk_slow_right * 2
    unlock_dir
}

script PokeathlonDome_Interior_B1FFriendshipRoom_EventScript_Magnus {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    bufferplayersname(0)
    npcmsg("Magnus: This is the “Friendship” room.\n"
           "It is the last of all. It’s the room\f"
           "where eternal friendship between\f"
           "people and Pokémon is pledged.\r"
           "...But this is not your goal, bud.\r"
           "Each room has Trophies to earn,\n"
           "but you can aim for any new height.\r"
           "It is entirely up to you whether\n"
           "you get there or not...\r"
           "That’s right!\r"
           "Your true goal is not something\n"
           "anyone else can decide for you, bud.\r"
           "{STRVAR_1 3, 0, 0}!\n"
           "You can overcome any difficulties\f"
           "with your friendship with your Pokémon.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokeathlonDome_Interior_B1FFriendshipRoom_EventScript_ItsYourStatueSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("It’s your statue!\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    launchpokeathlonrecordsapp(3)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

