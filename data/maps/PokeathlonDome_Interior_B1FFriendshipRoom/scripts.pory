script PokeathlonDome_Interior_B1FFriendshipRoom_OnResume {
    if (var(VAR_TEMP_x400F) == 0) {
        createpokeathlonfriendshiproomstatues
        setvar(VAR_TEMP_x400F, 1)
    }
    getplayergender(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 0) {
        movepersonfacing(obj_D49R0107_statueheroine, 28, 0, 28, DIR_NORTH)
    } else {
        movepersonfacing(obj_D49R0107_statuehero, 28, 0, 28, DIR_NORTH)
    }
    if (var(VAR_TEMP_x400E) == 1) {
        movepersonfacing(obj_D49R0107_thlonowner, 9, 0, 9, DIR_SOUTH)
        setvar(VAR_TEMP_x400E, 0)
    }
    end
}

script PokeathlonDome_Interior_B1FFriendshipRoom_EventScript_MagnusScene {
    followmonresetmovement
    lockall
    applymovement(obj_D49R0107_thlonowner, PokeathlonDome_Interior_B1FFriendshipRoom_Movement_MagnusExclamation)
    waitmovement
    npcmsg("Magnus: Oh, gosh!\r")
    closemessage
    applymovement(obj_D49R0107_thlonowner, PokeathlonDome_Interior_B1FFriendshipRoom_Movement_MagnusFaceDown)
    waitmovement
    wait(15, VAR_SPECIAL_RESULT)
    bufferplayersname(0)
    npcmsg("You are...!\n"
           "It is indeed you, {STRVAR_1 3, 0, 0}!\r"
           "Outstanding!\n"
           "Quite an achievement for you\f"
           "to come up here, bud!\r")
    closemessage
    applymovement(obj_D49R0107_thlonowner, PokeathlonDome_Interior_B1FFriendshipRoom_Movement_MagnusWalkDown)
    waitmovement
    npcmsg("This is the “Friendship” room.\r"
           "It was built to commemorate the\n"
           "solidarity, trust, and potential\f"
           "of Pokémon and people and\f"
           "to hope for the eternal friendship\f"
           "between Pokémon and people.\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_D49R0107_thlonowner, PokeathlonDome_Interior_B1FFriendshipRoom_Movement_MagnusWalkUp1)
    applymovement(obj_player, PokeathlonDome_Interior_B1FFriendshipRoom_Movement_PlayerWalkUp)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    bufferplayersname(0)
    npcmsg("Congratulations!\r"
           "This room is only for those true\n"
           "Pokéathletes who have earned\f"
           "real friendships with Pokémon!\r"
           "{STRVAR_1 3, 0, 0}!\n"
           "You are a true Pokéathlete, bud!\r")
    closemessage
    applymovement(obj_D49R0107_thlonowner, PokeathlonDome_Interior_B1FFriendshipRoom_Movement_MagnusWalkUp2)
    waitmovement
    npcmsg("Having said that...\n"
           "this is also the moment\f"
           "of a new beginning...\r")
    closemessage
    applymovement(obj_D49R0107_thlonowner, PokeathlonDome_Interior_B1FFriendshipRoom_Movement_MagnusFaceDown)
    waitmovement
    npcmsg("That’s right, bud!\n"
           "You have just heard a new starting\f"
           "signal. Your challenge continues\f"
           "for a whole new height and to become\f"
           "the legendary Pokéathlete!\r"
           "Take a look at this statue.\n"
           "You may be looking at your goal...\r")
    closemessage
    applymovement(obj_D49R0107_thlonowner, PokeathlonDome_Interior_B1FFriendshipRoom_Movement_MagnusWalkRight)
    waitmovement
    releaseall
    setvar(VAR_UNK_40D3, 1)
    natdexflagaction(2, VAR_TEMP_x4000)
    compare(VAR_TEMP_x4000, 1)
    callifeq(_0154)
    end
_0154:
    clearflag(FLAG_HIDE_POKEATHLON_SUPREME_CUP_RECEPTIONIST)
    return
}

