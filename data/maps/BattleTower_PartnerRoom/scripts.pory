    if (var(VAR_SPECIAL_RESULT) == 0) {
        closemessage
        releaseall
        setvar(VAR_UNK_414B, 3)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        warp(MAP_BATTLE_TOWER, 0, 11, 6, DIR_NORTH)
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        end
    }
    npcmsg(msg_0099_D31R0207_00000)
    closemessage
    releaseall
    end
}

