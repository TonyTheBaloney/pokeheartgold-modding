script scr_seq_D31R0207_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0}, you have not found\n"
           "a partner for your tag team.\r"
           "Would you like to quit looking and\n"
           "return to the reception counter? {YESNO 0}")
