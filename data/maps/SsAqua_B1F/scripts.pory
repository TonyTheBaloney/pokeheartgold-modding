script SsAqua_B1F_EventScript_Sailor {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_SS_AQUA) >= 3) {
        npcmsg("Thanks, kid!\n"
               "I yelled at him good so he’ll quit\f"
               "slacking off!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Hey, kid. Could I get you to look\n"
           "for my buddy?\r"
           "He’s taking it easy somewhere, that\n"
           "good for nothing!\f"
           "I want to go find him, but I’m on guard\f"
           "duty and have to stay right here.")
    waitbuttonpress
    closemessage
    setflag(FLAG_UNK_0ED)
    releaseall
    end
}

script SsAqua_B1F_EventScript_LittleGirl {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    applymovement(obj_P01R0307_gsbabygirl1, SsAqua_B1F_Movement_LittleGirlExclamation)
    waitmovement
    followmonisactive(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) != 0) {
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(56)
    }
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, SsAqua_B1F_Movement_PlayerWalkUp)
        applymovement(obj_P01R0307_gsbabygirl1, SsAqua_B1F_Movement_LittleGirlWalkUp)
    } else {
        applymovement(obj_player, SsAqua_B1F_Movement_PlayerWalkRight)
        applymovement(obj_P01R0307_gsbabygirl1, SsAqua_B1F_Movement_LittleGirlWalkRight)
    }
    waitmovement
    if (var(VAR_TEMP_x4002) != 0) {
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
    }
    npcmsg("Oh, you found me!\r"
           "I better go back to my grandpa!\r")
    closemessage
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    setvar(VAR_SCENE_SS_AQUA, 5)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    warp(MAP_SS_AQUA_1F_NORTHWEST_ROOMS, 0, 9, 10, DIR_NORTH)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

movement SsAqua_B1F_Movement_LittleGirlExclamation {
    emote_exclamation_mark
    delay_8
}

movement SsAqua_B1F_Movement_PlayerWalkUp {
    lock_dir
    walk_slow_up
    unlock_dir
}

movement SsAqua_B1F_Movement_PlayerWalkRight {
    lock_dir
    walk_slow_right * 2
    unlock_dir
}

movement SsAqua_B1F_Movement_LittleGirlWalkUp {
    face_up * 2
    walk_slow_up
}

movement SsAqua_B1F_Movement_LittleGirlWalkRight {
    face_right * 2
    walk_slow_right * 2
}

