script SsAqua_B1F_OnTransition {
    if (var(VAR_SCENE_SS_AQUA) == 4) {
        clearflag(FLAG_UNK_219)
    } else {
        setflag(FLAG_UNK_219)
    }
    end
}

script SsAqua_B1F_EventScript_SailorTrigger {
    followmonresetmovement
    lockall
    setflag(FLAG_UNK_0ED)
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 19) {
        applymovement(obj_P01R0307_seaman_2, SsAqua_B1F_Movement_SailorWalkDown2)
        if (var(VAR_TEMP_x4002) != 0) {
            applymovement(obj_partner_poke, SsAqua_B1F_Movement_FollowMonWalkLeft)
        }
        applymovement(obj_player, SsAqua_B1F_Movement_PlayerWalkLeft)
        waitmovement
        npcmsg(msg_0263_P01R0307_00000)
        closemessage
        applymovement(obj_P01R0307_seaman_2, SsAqua_B1F_Movement_SailorWalkUp2)
        waitmovement
        releaseall
        end
    }
    applymovement(obj_P01R0307_seaman_2, SsAqua_B1F_Movement_SailorWalkUp1)
    followmonisactive(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) != 0) {
        applymovement(obj_partner_poke, SsAqua_B1F_Movement_FollowMonWalkLeft)
    }
    applymovement(obj_player, SsAqua_B1F_Movement_PlayerWalkLeft)
    waitmovement
    npcmsg(msg_0263_P01R0307_00000)
    closemessage
    applymovement(obj_P01R0307_seaman_2, SsAqua_B1F_Movement_SailorWalkDown1)
    waitmovement
    releaseall
    end
}

text msg_0263_P01R0307_00000 {
    "Hey, kid. Could I get you to look\n"
    "for my buddy?\r"
    "He’s taking it easy somewhere, that\n"
    "good for nothing!\r"
    "I want to go find him, but I’m on guard\n"
    "duty and have to stay right here.\r"
}

