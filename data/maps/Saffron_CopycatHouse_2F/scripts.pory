script Saffron_CopycatHouse_2F_EventScript_Banette {
    if (var(VAR_TEMP_x400A) != 0) {
        playse(SEQ_SE_DP_SELECT)
        lockall
        faceplayer
        playcry(SPECIES_BANETTE, 0)
        npcmsg("BANETTE: Giggle!")
        waitcry
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("This Poké Doll looks just like the\n"
           "real thing...\r"
           "Aw! It moved!\n"
           "It’s a real BANETTE!")
    waitbuttonpress
    closemessage
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_T11R0802_jupetta, Saffron_CopycatHouse_2F_Movement_BanetteFaceDown)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_T11R0802_jupetta, Saffron_CopycatHouse_2F_Movement_BanetteFaceUp)
    } elif (var(VAR_SPECIAL_RESULT) == 2) {
        applymovement(obj_T11R0802_jupetta, Saffron_CopycatHouse_2F_Movement_BanetteFaceRight)
    } else {
        applymovement(obj_T11R0802_jupetta, Saffron_CopycatHouse_2F_Movement_BanetteFaceLeft)
    }
    waitmovement
    setvar(VAR_TEMP_x400A, 1)
    releaseall
    end
}

movement Saffron_CopycatHouse_2F_Movement_BanetteFaceUp {
    face_up
}

