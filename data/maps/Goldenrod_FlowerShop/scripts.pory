        giveitem(VAR_SPECIAL_x8001, 1, VAR_SPECIAL_RESULT)
        bufferitemname(0, VAR_SPECIAL_x8001)
        npcmsg("You bought the {STRVAR_1 8, 0, 0}.\r")
        npcmsg("That {STRVAR_1 8, 0, 0} is a mix of\n"
               "high-quality soil and Pokémon’s...\f"
               "er...you know...\r"
               "It’s full of nutrients!\n"
               "Berries will surely benefit from it.")
        goto(_031F)
    _031F:
        waitbuttonpress
        closemessage
        touchscreenmenushow
        hidemoneybox
        releaseall
