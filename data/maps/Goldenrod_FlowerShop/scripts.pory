                 "Hmmm...\r"
                 "Well, maybe if you manage to defeat\n"
                 "the Goldenrod Gym Leader, it might\f"
                 "be OK...")
    end
_0185:
    playse(SEQ_SE_DP_SELECT)
    lockall
