script Goldenrod_FlowerShop_EventScript_Lass {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_15D)) {
        getpartyslotwithfatefulencounter(VAR_SPECIAL_RESULT, 492)
        if (var(VAR_SPECIAL_RESULT) == 255) { goto(_03F2) }
        getpartyleadalive(VAR_TEMP_x4000)
        getpartymonspecies(VAR_TEMP_x4000, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) != 492) { goto(_03F2) }
        npcmsg(msg_0589_T25R0601_00007)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getpartyslotwithfatefulencounter(VAR_SPECIAL_RESULT, 492)
    if (var(VAR_SPECIAL_RESULT) != 255) {
        getpartyleadalive(VAR_TEMP_x4000)
        getpartymonspecies(VAR_TEMP_x4000, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) == 492) {
            applymovement(obj_T25R0601_gsgirl1, Goldenrod_FlowerShop_Movement_LassExclamation2)
            waitmovement
            npcmsg(msg_0589_T25R0601_00005)
            closemessage
            getplayerfacing(VAR_SPECIAL_RESULT)
            if (var(VAR_SPECIAL_RESULT) == 0) {
                applymovement(obj_T25R0601_gsgirl1, Goldenrod_FlowerShop_Movement_LassFaceDown)
            } elif (var(VAR_SPECIAL_RESULT) == 1) {
                applymovement(obj_T25R0601_gsgirl1, Goldenrod_FlowerShop_Movement_LassFaceUp)
            } elif (var(VAR_SPECIAL_RESULT) == 2) {
                applymovement(obj_T25R0601_gsgirl1, Goldenrod_FlowerShop_Movement_LassFaceRight)
            } else {
                applymovement(obj_T25R0601_gsgirl1, Goldenrod_FlowerShop_Movement_LassFaceLeft)
            }
            waitmovement
            npcmsg(msg_0589_T25R0601_00006)
            setvar(VAR_SPECIAL_x8004, 466)
            setvar(VAR_SPECIAL_x8005, 1)
            hasspaceforitem(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005, VAR_TEMP_x4002)
            if (var(VAR_TEMP_x4002) == 0) {
                callstd(std_bag_is_full)
                closemessage
                releaseall
                setvar(VAR_UNK_4082, 0)
                releaseall
                end
            }
            callstd(std_give_item_verbose)
            npcmsg(msg_0589_T25R0601_00007)
            waitbuttonpress
            closemessage
            setflag(FLAG_UNK_15D)
            setvar(VAR_UNK_4082, 0)
            releaseall
            end
        }
    }
_03F2:
    npcmsg("Are you using the Berry Pots?\r"
           "You can pick any of the Berries you\n"
           "have planted.\r"
           "Don’t forget to water them!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

