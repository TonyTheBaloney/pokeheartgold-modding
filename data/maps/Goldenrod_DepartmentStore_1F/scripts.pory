script Goldenrod_DepartmentStore_1F_EventScript_Gentleman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("What kind of business would a\n"
               "Team Rocket member have here?\r"
               "We aren’t selling sanity here.")
    } else {
        npcmsg("The department store has a\n"
               "decent selection.\r"
               "But some items are only available\n"
               "as Game Corner prizes.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

