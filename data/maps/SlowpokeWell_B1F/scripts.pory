movement SlowpokeWell_B1F_Movement_KurtWalkLeftDown {
    walk_left * 2
    walk_down * 2
    walk_left * 3
    walk_up * 2
    delay_4 * 4
    walk_left
    walk_up * 3
    face_left
}

movement SlowpokeWell_B1F_Movement_PlayerWalkRight {
    walk_right * 2
    face_up
    delay_8 * 6
    face_down
    delay_8 * 5
    face_right
}

movement SlowpokeWell_B1F_Movement_PlayerWalkDownRight {
    walk_down
    walk_right
    face_up
    delay_8 * 6
    face_down
    delay_8 * 5
    face_right
}

