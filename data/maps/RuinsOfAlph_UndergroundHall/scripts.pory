script RuinsOfAlph_UndergroundHall_EventScript_SuperNerdScene {
    followmonresetmovement
    lockall
    playse(SEQ_SE_GS_RAKKA01)
    applymovement(obj_player, RuinsOfAlph_UndergroundHall_Movement_PlayerWarpIn)
    makeobjectinvisible(obj_player)
    waitmovement
    screenshake(0, 1, 1, 8)
    playse(SEQ_SE_DP_SUTYA2)
    if (!flag(FLAG_UNK_111)) {
        if (!flag(FLAG_GOT_UNOWN_REPORT)) {
            wait(5, VAR_SPECIAL_RESULT)
            applymovement(obj_D24R0205_gsassistantm, RuinsOfAlph_UndergroundHall_Movement_SuperNerdWalkRightDown)
            applymovement(obj_D24R0205_gsassistantm_2, RuinsOfAlph_UndergroundHall_Movement_SuperNerdWalkRightDown)
            applymovement(obj_D24R0205_gsassistantm_3, RuinsOfAlph_UndergroundHall_Movement_SuperNerdWalkLeftDown)
            applymovement(obj_D24R0205_gsassistantm_4, RuinsOfAlph_UndergroundHall_Movement_SuperNerdWalkLeftDown)
            waitmovement
            npcmsg("Did you just come down from above...?\r"
                   "So! You must have solved the\n"
                   "stone-panel puzzle!\r"
                   "That is wonderful!\r"
                   "You seem to have some talent with\n"
                   "archaeology.\f"
                   "I will give you this UNOWN Report.\r"
                   "It records UNOWN as you capture them.\n"
                   "I am sure it’ll come in handy!\r")
            giveitemnocheck(ITEM_UNOWN_REPORT, 1)
            closemessage
            applymovement(obj_D24R0205_gsassistantm, RuinsOfAlph_UndergroundHall_Movement_SuperNerdWalkLeft)
            applymovement(obj_D24R0205_gsassistantm_2, RuinsOfAlph_UndergroundHall_Movement_SuperNerdWalkUp)
            applymovement(obj_D24R0205_gsassistantm_3, RuinsOfAlph_UndergroundHall_Movement_SuperNerdWalkRight)
            applymovement(obj_D24R0205_gsassistantm_4, RuinsOfAlph_UndergroundHall_Movement_SuperNerdWalkRight)
            waitmovement
            removeobject(obj_D24R0205_gsassistantm)
            removeobject(obj_D24R0205_gsassistantm_2)
            removeobject(obj_D24R0205_gsassistantm_3)
            removeobject(obj_D24R0205_gsassistantm_4)
            removeobject(obj_D24R0205_gsbigman)
            removeobject(obj_D24R0205_gswoman1)
            removeobject(obj_D24R0205_gsoldman1)
            setflag(FLAG_HIDE_RUINS_OF_ALPH_ASSISTANTS)
            setflag(FLAG_HIDE_RUINS_OF_ALPH_TOURISTS)
            setflag(FLAG_GOT_UNOWN_REPORT)
            npcmsg("There is a strange presence here...")
            waitbuttonpress
            closemessage
        }
    }
    setvar(VAR_UNK_40CE, 0)
    releaseall
    end
}

script RuinsOfAlph_UndergroundHall_OnResume {
    if (var(VAR_UNK_40CE) == 1) {
        makeobjectvisible(obj_player)
    }
    end
}

