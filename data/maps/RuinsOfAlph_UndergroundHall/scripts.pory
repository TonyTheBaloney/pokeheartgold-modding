script RuinsOfAlph_UndergroundHall_EventScript_BusinessmanScene1 {
    followmonresetmovement
    lockall
    applymovement(obj_D24R0205_suit, RuinsOfAlph_UndergroundHall_Movement_BusinessmanWalkLeft1)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, RuinsOfAlph_UndergroundHall_Movement_PlayerWalkLeft)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("Hmm.\r"
           "I have been studying the ruins for many\n"
           "years, but something feels...\f"
           "different.\r")
    closemessage
    applymovement(obj_D24R0205_suit, RuinsOfAlph_UndergroundHall_Movement_BusinessmanWalkUpLeft)
    waitmovement
    npcmsg("Wow!\r"
           "The UNOWN pictures on the wall...\r"
           "It feels like they’re staring at me!\r")
    closemessage
    fadeoutbgm(0, 30)
    playse(SEQ_SE_GS_ZENIGAME_JOURO)
    fadescreen(6, 6, 0, RGB_BLACK)
    waitfade
    wait(1, VAR_SPECIAL_RESULT)
    fadescreen(6, 6, 1, RGB_BLACK)
    waitfade
    stopse(SEQ_SE_GS_ZENIGAME_JOURO)
    applymovement(obj_D24R0205_suit, RuinsOfAlph_UndergroundHall_Movement_BusinessmanSpin)
    waitmovement
    npcmsg("What is this?\n"
           "There is something eerie that is making\f"
           "my legs shiver.\f"
           "I can’t stop them!\r")
    closemessage
    playse(SEQ_SE_GS_ZENIGAME_JOURO)
    fadescreen(6, 6, 0, RGB_BLACK)
    waitfade
    wait(1, VAR_SPECIAL_RESULT)
    fadescreen(6, 6, 1, RGB_BLACK)
    waitfade
    stopse(SEQ_SE_GS_ZENIGAME_JOURO)
    setvar(VAR_SCENE_SINJOH_MYSTRI_ROOM, 3)
    setflag(FLAG_HIDE_ALPH_OUTSIDE_ARCEUS_EVENT_SUIT)
    setflag(FLAG_HIDE_ALPH_MAIN_CHAMBER_ARCEUS_EVENT_PEOPLE)
    playse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    warp(MAP_SINJOH_RUINS_MYSTRI_STAGE, 0, 16, 24, DIR_SOUTH)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

