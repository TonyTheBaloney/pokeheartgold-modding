script RuinsOfAlph_UndergroundHall_EventScript_BusinessmanScene2 {
    followmonresetmovement
    lockall
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_D24R0205_suit, RuinsOfAlph_UndergroundHall_Movement_BusinessmanWalkLeft2)
    applymovement(obj_player, RuinsOfAlph_UndergroundHall_Movement_PlayerWalkRight)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    applymovement(obj_player, RuinsOfAlph_UndergroundHall_Movement_PlayerFaceRight)
    waitmovement
    npcmsg("Oh, are you all right?\n"
           "You disappeared right in front of me.\f"
           "I was so surprised!\r")
    closemessage
    applymovement(obj_D24R0205_suit, RuinsOfAlph_UndergroundHall_Movement_BusinessmanFaceLeft)
    waitmovement
    npcmsg("I see.\r"
           "The power of ARCEUS and UNOWN affected\n"
           "each other to create a huge energy,\f"
           "which sent you to the Sinjoh Ruins...?\r"
           "UNOWN, the Ruins of Alph, and ARCEUS...\f"
           "The mystery deepens...\r"
           "It has made me even more inquisitive!\r"
           "I will one day solve all the mysteries!\r")
    closemessage
    applymovement(obj_D24R0205_suit, RuinsOfAlph_UndergroundHall_Movement_BusinessmanWalkRight)
    waitmovement
    removeobject(obj_D24R0205_suit)
    setflag(FLAG_HIDE_ALPH_MAIN_CHAMBER_ARCEUS_EVENT_PEOPLE)
    setvar(VAR_SCENE_SINJOH_MYSTRI_ROOM, 10)
    releaseall
    end
}

