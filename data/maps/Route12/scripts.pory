    walk_up * 3
    walk_in_place_down
}

movement Route12_Movement_0214 {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement Route12_Movement_0228 {
    delay_8
    walk_in_place_up
}

movement Route12_Movement_0234 {
    walk_right
    walk_up
    face_down
}

script scr_seq_R12_005 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    radiomusicisplaying(5, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        playcry(SPECIES_SNORLAX, 0)
        npcmsg("...!\r"
               "The SNORLAX opened its eyes wide!\r")
        waitcry
        closemessage
        setflag(FLAG_ENGAGING_STATIC_POKEMON)
        wildbattle(SPECIES_SNORLAX, 50, 0)
        clearflag(FLAG_ENGAGING_STATIC_POKEMON)
        checkbattlewon(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            whiteout
            releaseall
            end
        _02B4:
            setflag(FLAG_CAUGHT_SNORLAX)
            return
            releaseall
            end
        }
        getstaticencounteroutcome(VAR_TEMP_x4005)
        compare(VAR_TEMP_x4005, 4)
        callifeq(_02B4)
        setflag(FLAG_SNORLAX_MEET)
        releaseall
        end
    }
    npcmsg("There is a large Pokémon sleeping\n"
           "peacefully.\f"
           "It looks so content!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

