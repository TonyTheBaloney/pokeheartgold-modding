movement Route12_Movement_01DC {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Route12_Movement_01F4 {
    walk_up * 3
    walk_in_place_down
}

movement Route12_Movement_0200 {
    walk_up
