        if (var(VAR_TEMP_x4000) == 7) {
            setflag(FLAG_UNK_2DA)
        } elif (var(VAR_TEMP_x4000) == 8) {
            setflag(FLAG_UNK_2DA)
        } elif (var(VAR_TEMP_x4000) == 9) {
            setflag(FLAG_UNK_2DA)
        } else {
            goto(_00FC)
        }
        end
    _00FC:
        clearflag(FLAG_UNK_2DA)
        end
    }
    goto(_00AB)
    goto(_00A9)
}

script Goldenrod_GameCorner_Jp_EventScript_Sign1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    call(_013D)
    if (var(VAR_TEMP_x4001) != 1) {
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        casinogame(0, 0)
        restoreoverworld
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
    }
    releaseall
    end
_013D:
    hasitem(ITEM_COIN_CASE, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg(msg_0599_T25R1101_00025)
        waitbuttonpress
        closemessage
        setvar(VAR_TEMP_x4001, 1)
        return
    }
    scriptoverlaycmd(3, 0)
    checkcoinsimmediate(VAR_SPECIAL_RESULT, 3)
