        npcmsg(msg_0599_T25R1101_00026)
        waitbuttonpress
        closemessage
        scriptoverlaycmd(3, 1)
        setvar(VAR_TEMP_x4001, 1)
        return
    }
    scriptoverlaycmd(3, 1)
    setvar(VAR_TEMP_x4001, 0)
    return
}

