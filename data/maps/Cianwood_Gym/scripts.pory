// Script numbers, from 1, in this order (map.json and mapscripts use the labels).
scrdefs {
    Cianwood_Gym_EventScript_Chuck
    Cianwood_Gym_OnTransition
    Cianwood_Gym_EventScript_Sign
    Cianwood_Gym_EventScript_GymSign
}

script Cianwood_Gym_OnTransition {
    cianwoodgyminit
    clearflag(FLAG_SYS_CIANWOOD_WATERFALL_DISABLE)
    end
}

script Cianwood_Gym_EventScript_Chuck {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_TEMP_x4000) == 0) {
        npcmsg("He’s so into his training, he\n"
               "doesn’t seem to notice you.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    checkbadge(BADGE_STORM, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_00EE) }
    npcmsg("Chuck: Ooomph!\n"
           "The pounding waterfall right onto\f"
           "my head...\f"
           "Arrgh!\r"
           "Why did you stop the waterfall from\n"
           "pouring on me!\r"
           "You just spoiled my training!\n"
           "I have to warn you that I am a strong\f"
           "Trainer training every day under\f"
           "this waterfall!\r"
           "What?\n"
           "It has nothing to do with Pokémon?\r"
           "...\n"
           "That’s true!\r"
           "...\n"
           "...\r"
           "Come on. We shall do battle!\r")
    closemessage
    trainerbattle(TRAINER_LEADER_CHUCK_CHUCK, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0104) }
    npcmsg("Chuck: Hmm... I lost?\r"
           "How about that!\n"
           "All right. You’re worthy of\f"
           "the Storm Badge!\r")
    settrainerflag(TRAINER_BLACK_BELT_YOSHI)
    settrainerflag(TRAINER_BLACK_BELT_LAO)
    settrainerflag(TRAINER_BLACK_BELT_NOB)
    settrainerflag(TRAINER_BLACK_BELT_LUNG)
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Storm Badge from Chuck!")
    givebadge(BADGE_STORM)
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    addvar(VAR_MIDGAME_BADGES, 1)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    setvar(VAR_UNK_4116, 1)
    if (var(VAR_MIDGAME_BADGES) == 3) {
        setvar(VAR_SCENE_ROCKET_TAKEOVER, 1)
    }
    npcmsg("Chuck: The Storm Badge lets your\n"
           "Pokémon Fly to any city or town you’ve\f"
           "already been to!\r"
           "Here, take this, too!\r")
    goto(_00AF)
_00AF:
    if (!itemspace(ITEM_TM01, 1)) { goto(_00E3) }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM01_FROM_CHUCK)
    npcmsg("Chuck: That is Focus Punch.\r"
           "It doesn’t land if the foe you’re\n"
           "attacking hits you first, but it’s very\f"
           "powerful if it manages to hit!")
    waitbuttonpress
    closemessage
    releaseall
    end
_00E3:
    npcmsg("Argh... Your Bag is jammed full!")
    waitbuttonpress
    closemessage
    releaseall
    end
_00EE:
    if (!flag(FLAG_GOT_TM01_FROM_CHUCK)) { goto(_00AF) }
    npcmsg("Chuck: Wahahah!\n"
           "I enjoyed battling you!\r"
           "But a loss is a loss!\r"
           "From now on, I’m going to train\n"
           "24 hours a day!")
    waitbuttonpress
    closemessage
    releaseall
    end
_0104:
    whiteout
    releaseall
    end
}

script Cianwood_Gym_EventScript_Sign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_TEMP_x4000) == 0) {
        npcmsg("There is a large winch.\n"
               "Will you turn it? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 0) {
            bufferplayersname(0)
            npcmsg("{STRVAR_1 3, 0, 0} turned the winch\n"
                   "with pure might!\r")
            closemessage
            setflag(FLAG_SYS_CIANWOOD_WATERFALL_DISABLE)
            stopse(SEQ_SE_GS_N_TAKI)
            playse(SEQ_SE_DP_SHIP03)
            playse(SEQ_SE_GS_TAKI2)
            cianwoodgymturnwinch(VAR_TEMP_x4000)
            releaseall
            end
        }
        closemessage
        releaseall
        end
    }
    npcmsg("It won’t turn anymore.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Cianwood_Gym_EventScript_GymSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_STORM, VAR_SPECIAL_RESULT)
    bufferplayersname(0)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Cianwood City Pokémon Gym")
    } else {
        npcmsg("Cianwood City Pokémon Gym\r"
               "Leader: Chuck\n"
               "Certified Trainer!\f"
               "{STRVAR_1 3, 0, 0}")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

mapscripts Cianwood_Gym_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Cianwood_Gym_OnTransition
}
