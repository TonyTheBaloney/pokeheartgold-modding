               "You are just busy right now,\f"
               "aren’t you? That must be it!\r"
               "Why don’t you answer my questions\n"
               "when you’ve got time for me?\r"
               "See you!")
        waitbuttonpress
        goto(_0235)
    _022A:
        npcmsg("Primo: ...!\r"
               "You are no ordinary fan, knowing such\n"
               "a thing!\r"
               "You’re a Trainer, right?\n"
               "I’ll pull some strings for you.\r"
               "I think I can swing a deal to get you\n"
               "a new wallpaper for your PC Boxes.\r"
               "Make sure you keep your channel\n"
               "tuned to “The Show Me Show!”\r"
               "And don’t forget about me, the\n"
               "big brother!")
        waitbuttonpress
        goto(_0235)
    _0235:
        closemessage
        releaseall
        end
    }
    setsavedbottomscreenapp(0)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    closemessage
    prompteasychat(VAR_SPECIAL_RESULT, VAR_SPECIAL_x8000, VAR_SPECIAL_x8001)
