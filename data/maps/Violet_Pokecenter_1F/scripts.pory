script Violet_Pokecenter_1F_EventScript_AceTrainerM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_UNK_2C5)) {
        npcmsg("Hmm...\r"
               "Can you tell me what kind of Trainer\n"
               "you like best?\r")
    } else {
        bufferplayerunionavatarclassname(0)
        npcmsg("Hello! You’ve been mistaken for\n"
               "{STRVAR_1 14, 0, 0}, haven’t you?\r"
               "But I think you can also pass for\n"
               "a different kind of Trainer.\r"
               "So, how about telling me what kind of\n"
               "Trainer you like?\r")
        goto(_028C)
    }
_028C:
    npcmsg("Which kind of Trainer would you like\n"
           "to be? {YESNO 0}")
    touchscreenmenuhide
    bufferunionroomavatarchoices
    menuinitstdgmm(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(msg_0191_00053, 255, 0)
    menuitemadd(msg_0191_00054, 255, 1)
    menuitemadd(msg_0191_00055, 255, 2)
    menuitemadd(msg_0191_00056, 255, 3)
    menuitemadd(msg_0191_00044, 255, 4)
    menuexec
    copyvar(VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT)
    Switch(VAR_SPECIAL_RESULT)
    Case(4, _0331)
    Case(-2, _0331)
    unionroomavataridxtotrainerclass(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    buffertrainerclassnameindef(0, VAR_SPECIAL_x8005)
    capitalize(0)
    npcmsg("{STRVAR_1 14, 0, 0} is the kind of Trainer\n"
           "you want to be? {YESNO 0}")
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        touchscreenmenushow
        buffertrainerclassnameindef(0, VAR_SPECIAL_x8005)
        npcmsg("I see! So {STRVAR_1 14, 0, 0} is the kind\n"
               "of Trainer you like.\r"
               "If that’s the case, others may\n"
               "come to see you in the same way.\r")
        setflag(FLAG_UNK_2C5)
        unionroomavataridxtosprite(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
        setplayerprofileavatar(VAR_SPECIAL_x8005)
        goto(_0333)
    _0331:
        touchscreenmenushow
    _0333:
        npcmsg("Talk to me again if you want to\n"
               "let me know what kind of Trainer\f"
               "you like best.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    goto(_028C)
}

script Violet_Pokecenter_1F_EventScript_Man {
    simplenpcmsg("A guy named Bill made the Pokémon\n"
                 "PC storage system.\r"
                 "You can access the Pokémon storage\n"
                 "system using the PC at the reception\f"
                 "there. Why don’t you try it once?")
    end
}

script Violet_Pokecenter_1F_EventScript_Gentleman {
    simplenpcmsg("It was about three years ago.\n"
                 "This group of thugs called Team Rocket\f"
                 "was involved in wrongdoing. They were\f"
                 "abusing Pokémon.\r"
                 "But!\n"
                 "Bad things never last!\r"
                 "A boy did a wonderful job and\n"
                 "Team Rocket was disbanded!\n"
                 "\n")
    end
}

script Violet_Pokecenter_1F_EventScript_SchoolKidM {
    simplenpcmsg("Pokémon are really smart.\n"
                 "Traded Pokémon might not listen to you\f"
                 "right away. For example, high-level\f"
                 "Pokémon sometimes refuse to obey\f"
                 "when you don’t have enough Gym Badges.")
    end
}

