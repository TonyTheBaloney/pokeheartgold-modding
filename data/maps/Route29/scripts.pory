script Route29_OnTransition {
    getfriendsprite(VAR_OBJ_1)
    checkbadge(BADGE_ZEPHYR, VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 1) {
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 2) {
            clearflag(FLAG_UNK_207)
        } else {
            setflag(FLAG_UNK_207)
        }
        end
    }
    setflag(FLAG_UNK_207)
    end
}

script Route29_EventScript_Beauty1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getpartyleadalive(VAR_SPECIAL_x8002)
    monhasribbon(VAR_SPECIAL_RESULT, VAR_SPECIAL_x8002, RIBBON_SHOCK)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 33)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_DAILY_GOT_SHOCK_RIBBON)) {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 35)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_NUM_MET_WEEKDAY_SIBLINGS) == 7) { goto(_0138) }
    if (flag(FLAG_GOT_TWISTEDSPOON_FROM_TUSCANY)) { goto(_011A) }
    getweekday(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 2) {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 7)
    } else {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 4)
        if (!itemspace(ITEM_TWISTEDSPOON, 1)) { goto(_012E) }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_TWISTEDSPOON_FROM_TUSCANY)
        addvar(VAR_NUM_MET_WEEKDAY_SIBLINGS, 1)
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 5)
    }
_0112:
    waitbuttonpress
    closemessage
    releaseall
    end
_011A:
    getstdmsgnaix(0, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 6)
    waitbuttonpress
    closemessage
    releaseall
    end
_012E:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
_0138:
    getweekday(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 2) { goto(_015B) }
    getstdmsgnaix(0, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 7)
    goto(_0112)
_015B:
    getstdmsgnaix(0, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 32)
    buffermonspeciesname(0, VAR_SPECIAL_x8002)
    msgboxextern(VAR_SPECIAL_RESULT, 34)
    giveribbon(VAR_SPECIAL_x8002, RIBBON_SHOCK)
    playfanfare(SEQ_ME_ITEM)
    waitfanfare
    setflag(FLAG_DAILY_GOT_SHOCK_RIBBON)
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route29_EventScript_LyraTrigger {
    followmonresetmovement
    lockall
    playcry(SPECIES_MARILL, 0)
    waitcry
    applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkDownRight)
    waitmovement
    applymovement(obj_R29_var_2, Route29_Movement_FriendExclamation2)
    waitmovement
    callstd(std_play_friend_music)
    gendermsgbox("Lyra: There you are!\r", "Ethan: There you are!\r")
    closemessage
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    release(obj_R29_tsure_poke_static_marill)
    if (var(VAR_TEMP_x4001) == 396) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkUpRight)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkLeftUp)
    } elif (var(VAR_TEMP_x4001) == 397) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkRightUp1)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkLeftRight1)
    } elif (var(VAR_TEMP_x4001) == 398) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkRightUp2)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkLeftRight2)
    } elif (var(VAR_TEMP_x4001) == 399) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkRightUp3)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkLeftRight3)
    } elif (var(VAR_TEMP_x4001) == 400) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkRight3)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkLeftRight4)
    } elif (var(VAR_TEMP_x4001) == 401) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkRightDown1)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkLeftRight5)
    } elif (var(VAR_TEMP_x4001) == 402) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkRightDown2)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkLeftRight6)
    }
    waitmovement
    lock(obj_R29_tsure_poke_static_marill)
    bufferplayersname(0)
    gendermsgbox("Lyra: {STRVAR_1 3, 0, 0}!\n"
                 "You can catch wild Pokémon\f"
                 "with Poké Balls.\r"
                 "Follow me!\r", "Ethan: {STRVAR_1 3, 0, 0}!\n"
                                 "You can catch wild Pokémon\f"
                                 "with Poké Balls.\r"
                                 "Follow me!\r")
    closemessage
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    getplayergender(VAR_TEMP_x4002)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    if (var(VAR_TEMP_x4001) == 396) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkDownLeft1)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkRightDown1)
        if (var(VAR_TEMP_x4002) == 0) {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeftDown1)
        } else {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeftDown7)
        }
    } elif (var(VAR_TEMP_x4001) == 397) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkDownLeft2)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkRightDown2)
        if (var(VAR_TEMP_x4002) == 0) {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeftDown2)
        } else {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeftDown8)
        }
    } elif (var(VAR_TEMP_x4001) == 398) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkDownLeft3)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkRightDown3)
        if (var(VAR_TEMP_x4002) == 0) {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeftDown3)
        } else {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeftDown9)
        }
    } elif (var(VAR_TEMP_x4001) == 399) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkDownLeft4)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkRightDown4)
        if (var(VAR_TEMP_x4002) == 0) {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeftDown4)
        } else {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeftDown10)
        }
    } elif (var(VAR_TEMP_x4001) == 400) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkDownLeft5)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkRightDown5)
        if (var(VAR_TEMP_x4002) == 0) {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeftDown5)
        } else {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeftDown11)
        }
    } elif (var(VAR_TEMP_x4001) == 401) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkDownLeft6)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkRightDown6)
        if (var(VAR_TEMP_x4002) == 0) {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeftDown6)
        } else {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeftDown12)
        }
    } elif (var(VAR_TEMP_x4001) == 402) {
        applymovement(obj_R29_var_2, Route29_Movement_FriendWalkLeft2)
        applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkRightLeft2)
        if (var(VAR_TEMP_x4002) == 0) {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeft2)
        } else {
            applymovement(obj_player, Route29_Movement_PlayerWalkLeft3)
        }
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    compare(VAR_TEMP_x4002, 0)
    callifeq(_0559)
    wait(10, VAR_SPECIAL_RESULT)
    catchingtutorial
    applymovement(obj_R29_var_2, Route29_Movement_FriendWalkRight2)
    applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkLeft)
    waitmovement
    gendermsgbox("See? Just like that!\r"
                 "It’s better to lower your\n"
                 "target’s HP more than I did,\f"
                 "or make it sleep or something.\r"
                 "You can try all kinds of things\n"
                 "to see what works.\r"
                 "I’ll give you these. Good luck!\r", "See? Just like that!\r"
                                                      "It’s better to lower your\n"
                                                      "target’s HP more than I did,\f"
                                                      "or make it sleep or something.\r"
                                                      "You can try all kinds of things\n"
                                                      "to see what works.\r"
                                                      "I’ll give you these. Good luck!\r")
    giveitemnocheck(ITEM_POKE_BALL, 5)
    gendermsgbox("Lyra: See you!\r", "Ethan: See ya!\r")
    closemessage
    applymovement(obj_R29_var_2, Route29_Movement_FriendWalkDownLeft7)
    applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkRightDown7)
    waitmovement
    removeobject(obj_R29_var_2)
    removeobject(obj_R29_tsure_poke_static_marill)
    setflag(FLAG_HIDE_ROUTE_29_FRIEND)
    setflag(FLAG_HIDE_ROUTE_29_MARILL)
    setvar(VAR_UNK_408B, 0)
    setflag(FLAG_WATCHED_CATCHING_TUTORIAL)
    releaseall
    end
_0559:
    applymovement(obj_R29_var_2, Route29_Movement_FriendExclamation1)
    waitmovement
    applymovement(obj_R29_var_2, Route29_Movement_FriendFaceLeft)
    applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillJumpLeft)
    waitmovement
    applymovement(obj_R29_var_2, Route29_Movement_FriendWalkRight1)
    applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkRight)
    waitmovement
    npcmsg("...Just like that!\r"
           "...\n"
           "Huh? Was I too fast?\r"
           "I’ll try again. Come this way!\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_R29_var_2, Route29_Movement_FriendWalkLeft1)
    applymovement(obj_R29_tsure_poke_static_marill, Route29_Movement_MarillWalkRightLeft1)
    applymovement(obj_player, Route29_Movement_PlayerWalkLeft1)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    return
}

