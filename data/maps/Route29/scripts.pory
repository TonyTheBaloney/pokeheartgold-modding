script Route29_EventScript_Man {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getcurrenttimeofday(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("I’m waiting for Pokémon that\n"
               "appear only in the daytime.")
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg(msg_0373_R29_00013)
    } elif (var(VAR_SPECIAL_RESULT) == 2) {
        npcmsg(msg_0373_R29_00013)
    } else {
        npcmsg("I’m waiting for Pokémon that\n"
               "appear only in the morning.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

text msg_0373_R29_00013 {
    "I’m waiting for Pokémon that\n"
    "appear only at night."
}

script Route29_EventScript_RouteSign1 {
    directionsignpostex(1, 1, "Rt. 29\n"
                              "East to New Bark Town")
    end
}

script Route29_EventScript_RouteSign2 {
    directionsignpostex(1, 2, "Rt. 29\n"
                              "West to Cherrygrove City")
    end
}

script Route29_EventScript_Youngster {
    simplenpcmsg("Hey, how are your Pokémon?\r"
                 "If they’re weak and not ready for\n"
                 "battle, keep out of the tall grass.")
    end
}

script Route29_EventScript_FatMan {
    simplenpcmsg("I wanted to take a break, so I\n"
                 "saved to record my progress.")
    end
}

script Route29_EventScript_Beauty2 {
    simplenpcmsg("Do you see those ledges?\n"
                 "It’s scary to jump off them.\r"
                 "But you can go to New Bark Town\n"
                 "without walking through tall grass.")
    end
}

mapscripts Route29_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Route29_OnTransition
}
