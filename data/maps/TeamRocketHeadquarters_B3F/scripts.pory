    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    bufferplayersname(0)
    npcmsg("Muhahaha, we’ve been waiting for you.\n"
           "So, you are {STRVAR_1 3, 0, 0}...\r"
           "Me?\n"
           "You don’t know who I am?\r"
           "It is me, Giovanni.\n"
           "The majestic Giovanni himself!\f"
           "Wahahaha!\r")
    closemessage
    applymovement(obj_D35R0104_sakaki, TeamRocketHeadquarters_B3F_Movement_044C)
    waitmovement
    npcmsg("...Huh?\n"
           "I don’t sound anything like Giovanni?\r"
           "I don’t even look like Giovanni?\n"
           "How come? I’ve worked so hard\f"
           "to mimic him!\r")
    closemessage
    applymovement(obj_D35R0104_sakaki, TeamRocketHeadquarters_B3F_Movement_0458)
    waitmovement
    clearflag(FLAG_HIDE_ROCKET_HIDEOUT_B3F_PETREL)
    addobject(obj_D35R0104_rkanbum2)
    setflag(FLAG_HIDE_ROCKET_HIDEOUT_B3F_GIOVANNI)
    removeobject(obj_D35R0104_sakaki)
    applymovement(obj_D35R0104_rkanbum2, TeamRocketHeadquarters_B3F_Movement_047C)
    waitmovement
    npcmsg("Petrel: I am a Team Rocket Executive!\r"
           "You must be trying to sneak into the\n"
           "radio-transmitter room.\f"
           "Well, that’s not going to happen.\r"
           "That room is protected with a special\n"
           "password. The password is\f"
           "“Hail Giovanni.”\f"
           "Surprised to hear it from me?\r"
           "Knowing the password won’t help\n"
           "you though.\r"
           "The door won’t open unless I say the\n"
           "password. It only reacts to my voice.\r")
    closemessage
    trainerbattle(TRAINER_EXECUTIVE_PETREL_PETREL_2, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    npcmsg("Petrel: Since disbanding Team Rocket\n"
           "three years ago, our Giovanni has\f"
           "been missing.\r"
           "But we’re certain he’s been waiting\n"
           "for the right time for our revival...\r"
           "Wahahaha!\r"
           "Losing to you won’t change the fact\n"
           "that you are unable to get in the\f"
           "radio-transmitter room!\r"
           "You need my voice to unlock it!\r")
    closemessage
    applymovement(obj_D35R0104_rkanbum2, TeamRocketHeadquarters_B3F_Movement_04A8)
