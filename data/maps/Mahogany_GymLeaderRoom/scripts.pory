script Mahogany_GymLeaderRoom_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        getphonebookrematch(PHONE_CONTACT_PRYCE, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) != 0) {
            setflag(FLAG_HIDE_MAHOGANY_GYM_PRYCE)
            end
        }
        if (!flag(FLAG_GAME_CLEAR)) { goto(_00B2) }
        checkregisteredphonenumber(PHONE_CONTACT_PRYCE, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) == 1) { goto(_00B2) }
        getcurrenthour(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 6) {
            setflag(FLAG_HIDE_MAHOGANY_GYM_PRYCE)
        } elif (var(VAR_TEMP_x4000) == 7) {
            setflag(FLAG_HIDE_MAHOGANY_GYM_PRYCE)
        } elif (var(VAR_TEMP_x4000) == 8) {
            setflag(FLAG_HIDE_MAHOGANY_GYM_PRYCE)
        } elif (var(VAR_TEMP_x4000) == 9) {
            setflag(FLAG_HIDE_MAHOGANY_GYM_PRYCE)
        } else {
            clearflag(FLAG_HIDE_MAHOGANY_GYM_PRYCE)
        }
        end
    _00B2:
        clearflag(FLAG_HIDE_MAHOGANY_GYM_PRYCE)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script Mahogany_GymLeaderRoom_EventScript_Pryce {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_GLACIER, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        if (flag(FLAG_GAME_CLEAR)) {
            npcmsg("Pryce: It is you...\r"
                   "Since you are here, why don’t we\n"
                   "take a picture together? {YESNO 0}")
            touchscreenmenuhide
            getmenuchoice(VAR_SPECIAL_RESULT)
            touchscreenmenushow
            if (var(VAR_SPECIAL_RESULT) == 1) {
                npcmsg("Pryce: That’s OK, too.\n"
                       "Suit yourself.")
                waitbuttonpress
                closemessage
                releaseall
                end
            }
            photoalbumisfull(VAR_SPECIAL_RESULT)
            if (var(VAR_SPECIAL_RESULT) == 1) {
                npcmsg("Your Photo Album is full.\r"
                       "Access your PC to delete\n"
                       "some pictures.")
                waitbuttonpress
                closemessage
                releaseall
                end
            }
            npcmsg("Pryce: I have advice to give you before\n"
                   "we take the picture.\r"
                   "Breathe in and relax first.\n"
                   "Then slowly begin to smile.\f"
                   "Are you ready?\r")
            closemessage
            setflag(FLAG_UNK_189)
            fadescreen(6, 1, 0, RGB_BLACK)
            waitfade
            cameronphoto(40)
            faceplayer
            lockall
            fadescreen(6, 1, 1, RGB_BLACK)
            waitfade
            clearflag(FLAG_UNK_189)
            npcmsg("Pryce: Let’s see...\n"
                   "Did we get a good one?")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Pryce: When the ice and snow melt,\n"
               "spring arrives.\r"
               "You and your Pokémon will be together\n"
               "for many years to come.\f"
               "Cherish your time together!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Pryce: Pokémon have many experiences\n"
           "in their lives, just like we do.\r"
           "I, too, have seen and suffered much in\n"
           "my life.\r"
           "Since I am your elder, let me show you\n"
           "what I mean.\r"
           "I have been training Pokémon since\n"
           "before you were born.\r"
           "I do not lose easily.\n"
           "I, Pryce--the Winter Trainer--\f"
           "shall demonstrate my power!\r")
    closemessage
    trainerbattle(TRAINER_LEADER_PRYCE_PRYCE, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0172) }
    settrainerflag(TRAINER_BOARDER_DEANDRE)
    settrainerflag(TRAINER_BOARDER_GERARDO)
    settrainerflag(TRAINER_SKIER_JILL)
    settrainerflag(TRAINER_SKIER_DIANA)
    settrainerflag(TRAINER_BOARDER_PATTON)
    npcmsg("Pryce: I am impressed by your prowess.\r"
           "With your strong will, I know you\n"
           "will overcome all life’s obstacles.\f"
           "You are worthy of this Badge!\r")
    givebadge(BADGE_GLACIER)
    addvar(VAR_MIDGAME_BADGES, 1)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    if (var(VAR_MIDGAME_BADGES) == 3) {
        setvar(VAR_SCENE_ROCKET_TAKEOVER, 1)
    }
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Glacier Badge from Pryce!")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    npcmsg("Pryce: That Badge will raise the Special\n"
           "stats of Pokémon.\r"
           "It also lets your Pokémon use\n"
           "Whirlpool to get across\f"
           "real whirlpools.\r"
           "And this... This is a gift from me!\r")
    if (!itemspace(ITEM_TM07, 1)) {
        callstd(std_bag_is_full)
        closemessage
        releaseall
        end
    }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM07_FROM_PRYCE)
    npcmsg("Pryce: That TM contains Hail.\r"
           "It summons a hailstorm that lasts for\n"
           "five turns. The hailstorm damages\f"
           "all types except Ice.")
    waitbuttonpress
    closemessage
    releaseall
    end
_0172:
    whiteout
    releaseall
    end
}

