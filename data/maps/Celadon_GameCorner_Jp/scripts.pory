        goto(_043E)
        end
    _04D7:
        hasenoughmoneyimmediate(VAR_SPECIAL_RESULT, 10000)
        if (var(VAR_SPECIAL_RESULT) == 0) { goto(_052E) }
        checkgivecoins(VAR_SPECIAL_RESULT, 500)
        noop
        if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0523) }
        submoneyimmediate(10000)
        givecoins(500)
        updatepointsbox(0)
        updatemoneybox
        playse(SEQ_SE_DP_REGI)
