script scr_seq_D44R0102_000 {
    followmonresetmovement
    lockall
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, DragonsDen_Movement_02C0)
    waitmovement
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 26) {
        applymovement(obj_D44R0102_gsleader8, DragonsDen_Movement_02C8)
    } elif (var(VAR_TEMP_x4000) == 27) {
        applymovement(obj_D44R0102_gsleader8, DragonsDen_Movement_02D0)
    } else {
        applymovement(obj_D44R0102_gsleader8, DragonsDen_Movement_02D8)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("Wait!\r")
    npcmsg("Clair: I’m sorry about this.\n"
           "Here, take this as my apology.\r")
    if (!itemspace(ITEM_TM59, 1)) {
        npcmsg("Oh? You don’t have any room for this.\r"
               "I’m going back to the Gym, so make\n"
               "room, then come see me there.\r")
        closemessage
        goto(_0236)
        end
    }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM59_FROM_CLAIR)
    npcmsg("That contains Dragon Pulse.\r"
           "Well, Dragon Pulse is a kind of er...\n"
           "never mind!\r"
           "It’s huge energy of some kind.\n"
           "If you don’t want it, you don’t\f"
           "have to take it.\r")
_0236:
    npcmsg("What’s the matter?\n"
           "If you are headed to the Pokémon\f"
           "League, go back to New Bark Town\f"
           "and Surf along Route 27.\r"
           "Your face...is telling me you have\n"
           "some unfinished business...\r"
           "Come on!\r"
           "Whatever you have to face from now,\n"
           "don’t you dare give up!\r"
           "If you do, I’ll feel even worse\n"
           "about having lost to you!\f"
           "Give it your all.\r")
    closemessage
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 26) {
        applymovement(obj_D44R0102_gsleader8, DragonsDen_Movement_02E0)
        applymovement(obj_player, DragonsDen_Movement_0310)
    } elif (var(VAR_TEMP_x4000) == 27) {
        applymovement(obj_D44R0102_gsleader8, DragonsDen_Movement_02F0)
        applymovement(obj_player, DragonsDen_Movement_0310)
    } else {
        applymovement(obj_D44R0102_gsleader8, DragonsDen_Movement_0300)
        applymovement(obj_player, DragonsDen_Movement_0310)
    }
    waitmovement
    removeobject(obj_D44R0102_gsleader8)
    setvar(VAR_UNK_40C4, 2)
    releaseall
    end
}

