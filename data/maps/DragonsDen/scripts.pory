                        setvar(VAR_OBJ_0, 1048)
                    } elif (var(VAR_TEMP_x4000) == 155) {
                        setvar(VAR_OBJ_0, 1049)
                    } else {
                        setvar(VAR_OBJ_0, 1047)
                    }
                    return
                }
                getcurrenthour(VAR_TEMP_x4000)
                if (var(VAR_TEMP_x4000) == 16) {
                    clearflag(FLAG_HIDE_VICTORY_ROAD_CLAIR)
                } elif (var(VAR_TEMP_x4000) == 17) {
                    clearflag(FLAG_HIDE_VICTORY_ROAD_CLAIR)
                } elif (var(VAR_TEMP_x4000) == 18) {
                    clearflag(FLAG_HIDE_VICTORY_ROAD_CLAIR)
                } else {
                    setflag(FLAG_HIDE_VICTORY_ROAD_CLAIR)
                }
                end
            }
            getcurrenthour(VAR_TEMP_x4000)
            if (var(VAR_TEMP_x4000) == 6) {
                clearflag(FLAG_HIDE_VICTORY_ROAD_CLAIR)
            } elif (var(VAR_TEMP_x4000) == 7) {
                clearflag(FLAG_HIDE_VICTORY_ROAD_CLAIR)
            } elif (var(VAR_TEMP_x4000) == 8) {
                clearflag(FLAG_HIDE_VICTORY_ROAD_CLAIR)
            } elif (var(VAR_TEMP_x4000) == 9) {
                clearflag(FLAG_HIDE_VICTORY_ROAD_CLAIR)
            } else {
                setflag(FLAG_HIDE_VICTORY_ROAD_CLAIR)
            }
            end
        }
        compare(VAR_UNK_40FC, 1)
        callifeq(_015E)
        end
    }
