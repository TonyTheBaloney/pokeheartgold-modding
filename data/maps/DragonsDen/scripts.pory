    walk_right * 3
    walk_up * 7
}

movement DragonsDen_Movement_ClairWalkUpRight2 {
    walk_up
    walk_right * 2
    walk_up * 7
}

movement DragonsDen_Movement_ClairWalkUpRight3 {
    walk_up
    walk_right
    walk_up * 7
}

movement DragonsDen_Movement_PlayerFaceUp {
