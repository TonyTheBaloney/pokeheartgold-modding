script scr_seq_D44R0102_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_0E2)) {
        bufferrivalsname(1)
        npcmsg("{STRVAR_1 3, 1, 0}: ...\r"
               "Whew...\r"
               "Learn to stay out\n"
               "of my way...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    bufferplayersname(0)
    bufferrivalsname(1)
    npcmsg("{STRVAR_1 3, 1, 0}: ...\n"
           "What? {STRVAR_1 3, 0, 0}?\r"
           "Yeah, I am training my Pokémon here.\n"
           "You can laugh at me now...\r"
           "But it needs to be done.\n"
           "My Pokémon aren’t ready to beat you.\f"
           "I can’t push them too hard now.\r"
           "I have to be disciplined to become\n"
           "the greatest Pokémon Trainer...")
    waitbuttonpress
    closemessage
    setflag(FLAG_UNK_0E2)
    releaseall
    end
}

script scr_seq_D44R0102_003 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkregisteredphonenumber(PHONE_CONTACT_CLAIR, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) {
        npcmsg("Clair: You...\n"
               "seem desperate to take pictures\f"
               "with me. {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Clair: That’s too bad.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        photoalbumisfull(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Your Photo Album is full.\r"
                   "Access your PC and delete\n"
                   "some pictures.\n")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Clair: Are you ready?\r")
        closemessage
        setflag(FLAG_UNK_189)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        cameronphoto(83)
        faceplayer
        lockall
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        clearflag(FLAG_UNK_189)
        npcmsg("Clair: Excellent one of me!\n"
               "Another cool picture.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_TEMP_x4002) >= 1) { goto(_03F1) }
    npcmsg("Clair: It’s still early, and you’ve got\n"
           "nothing to do already?\r"
           "I may have time to listen to you.\n"
           "If you insist, I can exchange\f"
           "numbers, too! {YESNO 0}")
_0379:
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_039D) }
    if (var(VAR_SPECIAL_RESULT) >= 1) { goto(_03E0) }
    end
_039D:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} registered Clair\n"
           "in the Pokégear!")
    playfanfare(SEQ_ME_POKEGEAR_REGIST)
    waitfanfare
    registergearnumber(PHONE_CONTACT_CLAIR)
    npcmsg("Clair: I can battle you on Friday\n"
           "nights if you insist!")
    waitbuttonpress
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setflag(FLAG_HIDE_VICTORY_ROAD_CLAIR)
    removeobject(obj_D44R0102_gsleader8)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
_03E0:
    setvar(VAR_TEMP_x4002, 1)
    npcmsg("Clair: ...")
    waitbuttonpress
    closemessage
    releaseall
    end
_03F1:
    npcmsg("Clair: So you do want to\n"
           "exchange numbers? {YESNO 0}")
    goto(_0379)
    end
}

script scr_seq_D44R0102_004 {
