}

script DragonsDen_EventScript_Rival {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_0E2)) {
        bufferrivalsname(1)
        npcmsg("{STRVAR_1 3, 1, 0}: ...\r"
               "Whew...\r"
               "Learn to stay out\n"
               "of my way...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    bufferplayersname(0)
    bufferrivalsname(1)
    npcmsg("{STRVAR_1 3, 1, 0}: ...\n"
           "What? {STRVAR_1 3, 0, 0}?\r"
           "Yeah, I am training my Pokémon here.\n"
           "You can laugh at me now...\r"
           "But it needs to be done.\n"
           "My Pokémon aren’t ready to beat you.\f"
           "I can’t push them too hard now.\r"
           "I have to be disciplined to become\n"
           "the greatest Pokémon Trainer...")
    waitbuttonpress
    closemessage
    setflag(FLAG_UNK_0E2)
    releaseall
    end
}

script DragonsDen_EventScript_Clair {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkregisteredphonenumber(PHONE_CONTACT_CLAIR, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) {
        npcmsg("Clair: You...\n"
               "seem desperate to take pictures\f"
               "with me. {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Clair: That’s too bad.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        photoalbumisfull(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Your Photo Album is full.\r"
                   "Access your PC and delete\n"
                   "some pictures.\n")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Clair: Are you ready?\r")
        closemessage
        setflag(FLAG_UNK_189)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        cameronphoto(83)
        faceplayer
        lockall
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        clearflag(FLAG_UNK_189)
        npcmsg("Clair: Excellent one of me!\n"
               "Another cool picture.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_TEMP_x4002) >= 1) { goto(_03F1) }
    npcmsg("Clair: It’s still early, and you’ve got\n"
           "nothing to do already?\r"
           "I may have time to listen to you.\n"
           "If you insist, I can exchange\f"
           "numbers, too! {YESNO 0}")
_0379:
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_039D) }
    if (var(VAR_SPECIAL_RESULT) >= 1) { goto(_03E0) }
    end
_039D:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} registered Clair\n"
           "in the Pokégear!")
    playfanfare(SEQ_ME_POKEGEAR_REGIST)
    waitfanfare
    registergearnumber(PHONE_CONTACT_CLAIR)
    npcmsg("Clair: I can battle you on Friday\n"
           "nights if you insist!")
    waitbuttonpress
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setflag(FLAG_HIDE_VICTORY_ROAD_CLAIR)
    removeobject(obj_D44R0102_gsleader8)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
_03E0:
    setvar(VAR_TEMP_x4002, 1)
    npcmsg("Clair: ...")
    waitbuttonpress
    closemessage
    releaseall
    end
_03F1:
    npcmsg("Clair: So you do want to\n"
           "exchange numbers? {YESNO 0}")
    goto(_0379)
    end
}

script DragonsDen_EventScript_LanceTrigger {
    followmonresetmovement
    lockall
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_D44R0102_gsrivel_2, DragonsDen_Movement_RivalExclamation1)
    if (var(VAR_TEMP_x4000) == 24) {
        applymovement(obj_player, DragonsDen_Movement_PlayerWalkDown)
    } else {
        applymovement(obj_player, DragonsDen_Movement_PlayerWalkDownLeft)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    callstd(std_play_rival_intro_music)
    bufferrivalsname(1)
    npcmsg("{STRVAR_1 3, 1, 0}: ...What?\n"
           "Are you here to make fun of\f"
           "my training?\r"
           "Humph!\n"
           "I took my time coming all the way here,\r"
           "but the Master won’t tell me anything,\n"
           "and he’s making a big deal out of it...\r"
           "So I decided to train my Pokémon\n"
           "here instead.\r")
    closemessage
    movepersonfacing(obj_D44R0102_wataru, 28, 0, 34, DIR_SOUTH)
    movepersonfacing(obj_D44R0102_gsleader8_2, 28, 0, 33, DIR_SOUTH)
    callstd(std_fade_end_rival_intro_music)
    applymovement(obj_D44R0102_gsrivel_2, DragonsDen_Movement_RivalExclamation1)
    applymovement(obj_player, DragonsDen_Movement_PlayerWalkRightDown)
    applymovement(obj_D44R0102_wataru, DragonsDen_Movement_LanceWalkDownLeft)
    applymovement(obj_D44R0102_gsleader8_2, DragonsDen_Movement_ClairWalkDownLeft)
    applymovement(obj_partner_poke, DragonsDen_Movement_FollowMonWalkRightDown)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("Lance: Hi, {STRVAR_1 3, 0, 0}!\n"
                 "And...you.\f"
                 "We met at the Team Rocket hideout.\r", "Lance: Hi, {STRVAR_1 3, 0, 0}!\n"
                                                         "And...you.\f"
                                                         "We met at the Team Rocket hideout.\r")
    applymovement(obj_D44R0102_gsrivel_2, DragonsDen_Movement_RivalExclamation2)
    waitmovement
    bufferrivalsname(1)
    npcmsg("{STRVAR_1 3, 1, 0}: You!\n"
           "Where have you been all this time?\r"
           "Prepare to lose to me this time.\n"
           "I challenge you!\r")
    npcmsg("Lance: Calm down.\n"
           "I was in a bit of a hurry then.\r"
           "Sorry for that.\n"
           "But...I always welcome challengers!\r"
           "Hey!\n"
           "How about a Double Battle?\r")
    applymovement(obj_D44R0102_gsrivel_2, DragonsDen_Movement_RivalFaceUp1)
    waitmovement
    bufferplayersname(0)
    bufferrivalsname(1)
    npcmsg("{STRVAR_1 3, 1, 0}: Humph!\n"
           "You can’t beat me one-on-one, can you?\r")
    gendermsgbox("Lance: Come on.\n"
                 "A Double Battle is really not bad.\f"
                 "{STRVAR_1 3, 0, 0}, you’ll be on my side!\r", "Lance: Come on.\n"
                                                                "A Double Battle is really not bad.\f"
                                                                "{STRVAR_1 3, 0, 0}, you’ll be on my side!\r")
    applymovement(obj_D44R0102_gsleader8_2, DragonsDen_Movement_ClairWalkDown)
    waitmovement
    npcmsg("Clair: Well then, you over there!\n"
           "Will you team up with me?\r")
    bufferrivalsname(1)
    npcmsg("{STRVAR_1 3, 1, 0}: You must be kidding!\r"
           "That embarrassing one in the weird\n"
           "costume for me?\f"
           "No way I can battle with her!\r")
    applymovement(obj_D44R0102_gsrivel_2, DragonsDen_Movement_RivalWalkUpDown)
    applymovement(obj_D44R0102_gsleader8_2, DragonsDen_Movement_ClairWalkUp)
    applymovement(obj_player, DragonsDen_Movement_PlayerFaceLeft1)
    waitmovement
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0}!\n"
           "Come to my side!\f"
           "We’ll beat Lance together!\r")
    closemessage
    applymovement(obj_D44R0102_gsrivel_2, DragonsDen_Movement_RivalFaceUp2)
    applymovement(obj_player, DragonsDen_Movement_RivalFaceUp2)
    applymovement(obj_D44R0102_gsleader8_2, DragonsDen_Movement_ClairWalkDown)
    waitmovement
    if (var(VAR_OBJ_0) == 1048) {
        multibattle(TRAINER_PARTNER_RIVAL_2, TRAINER_CHAMPION_LANCE_3, TRAINER_LEADER_CLAIR_CLAIR_3, 1)
    } elif (var(VAR_OBJ_0) == 1049) {
        multibattle(TRAINER_PARTNER_RIVAL_3, TRAINER_CHAMPION_LANCE_3, TRAINER_LEADER_CLAIR_CLAIR_3, 1)
    } else {
        multibattle(TRAINER_PARTNER_RIVAL_1, TRAINER_CHAMPION_LANCE_3, TRAINER_LEADER_CLAIR_CLAIR_3, 1)
    }
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    bufferplayersname(0)
    gendermsgbox("Lance: Just as I expected.\n"
                 "You two make quite a team...\r"
                 "Going solo is certainly one way to aim\n"
                 "for the top...\r"
                 "But that’s not all there is to Pokémon\n"
                 "battle. Although I don’t feel it’s\f"
                 "necessary to remind you guys.\r"
                 "See you, {STRVAR_1 3, 0, 0},\n"
                 "another time!\r", "Lance: Just as I expected.\n"
                                    "You two make quite a team...\r"
                                    "Going solo is certainly one way to aim\n"
                                    "for the top...\r"
                                    "But that’s not all there is to Pokémon\n"
                                    "battle. Although I don’t feel it’s\f"
                                    "necessary to remind you guys.\r"
                                    "See you, {STRVAR_1 3, 0, 0},\n"
                                    "another time!\r")
    closemessage
    applymovement(obj_D44R0102_wataru, DragonsDen_Movement_LanceWalkUpRight)
    waitmovement
    removeobject(obj_D44R0102_wataru)
    bufferplayersname(0)
    npcmsg("Clair: I must excuse myself.\r"
           "...{STRVAR_1 3, 0, 0}, it was a fun battle.\r"
           "That goes for you, too, wise guy.\r")
    closemessage
    applymovement(obj_D44R0102_gsleader8_2, DragonsDen_Movement_ClairWalkUpRight4)
    waitmovement
    removeobject(obj_D44R0102_gsleader8_2)
    applymovement(obj_D44R0102_gsrivel_2, DragonsDen_Movement_RivalFaceRight)
    applymovement(obj_player, DragonsDen_Movement_PlayerFaceLeft2)
    waitmovement
    bufferplayersname(0)
    bufferrivalsname(1)
    npcmsg("{STRVAR_1 3, 1, 0}: {STRVAR_1 3, 0, 0}...\r"
           "It wasn’t supposed to go this way...\n"
           "Anyway, I am not giving up beating you!\r"
           "I’ll train my Pokémon and...my own\n"
           "heart, too.\r"
           "I’ll come back as the toughest\n"
           "challenge for you!\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    removeobject(obj_D44R0102_gsrivel_2)
    removeobject(obj_D44R0102_var_1)
    wait(20, VAR_SPECIAL_x8004)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    applymovement(obj_partner_poke, DragonsDen_Movement_FollowMonWalkUp)
    waitmovement
    setvar(VAR_UNK_40FC, 2)
    setvar(VAR_UNK_4119, 1)
    releaseall
    end
}

