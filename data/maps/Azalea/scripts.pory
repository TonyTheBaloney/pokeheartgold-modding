movement Azalea_Movement_028C {
    walk_left * 9
    face_up
}

movement Azalea_Movement_0298 {
    walk_left * 9
    face_down
}

movement Azalea_Movement_02A4 {
    emote_exclamation_mark
}

movement Azalea_Movement_02AC {
    face_right
    delay_4 * 6
    delay_8 * 7
    face_down
}

movement Azalea_Movement_02C0 {
    face_right
    delay_4 * 6
    delay_8 * 7
    face_up
}

movement Azalea_Movement_02D4 {
    walk_left * 3
}

movement Azalea_Movement_02DC {
    walk_left
    walk_up
    walk_left * 2
}

movement Azalea_Movement_02EC {
    walk_left
    walk_up * 2
    walk_left * 2
}

script scr_seq_T23_003 {
    followmonresetmovement
    lockall
    applymovement(obj_T23_rocketm_3, Azalea_Movement_0350)
    waitmovement
    npcmsg("Who are you?\n"
           "You don’t know us?\r"
           "We are...\n"
           "Team Rocket!\r"
           "...What?\n"
           "We broke up a while ago?\r"
           "Give me a break!\n"
           "We have not broken up!\r"
           "Actually we did once.\n"
           "But we have come back to\f"
           "pursue Giovanni’s ambition.\r"
           "Enough talking.\n"
           "Shut up and just beat it!\r")
    playse(SEQ_SE_DP_WALL_HIT)
    npcmsg("{SIZE 200}Thud!{SIZE 100}\r")
    closemessage
    applymovement(obj_T23_gsmiddleman1_2, Azalea_Movement_0358)
    waitmovement
    movepersonfacing(obj_T23_gsmiddleman1_2, 23, 0, 16, DIR_EAST)
    applymovement(obj_T23_rocketm_3, Azalea_Movement_0374)
    waitmovement
    removeobject(obj_T23_gsmiddleman1_2)
    setflag(FLAG_AZALEA_HARASSED_CIVILIAN)
    setflag(FLAG_AZALEA_ROCKET_HARASSING_CIVILIAN)
    clearflag(FLAG_UNK_19F)
    setvar(VAR_UNK_4080, 1)
    releaseall
    end
}

movement Azalea_Movement_0350 {
    walk_in_place_left * 2
}

movement Azalea_Movement_0358 {
    lock_dir
    walk_faster_left
    delay_8 * 2
    walk_slow_left * 2
    unlock_dir
    walk_fast_left * 9
}

movement Azalea_Movement_0374 {
    walk_up * 2
    walk_in_place_down
}

script scr_seq_T23_006 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_BEAT_AZALEA_ROCKETS)) {
        npcmsg("We have this tough guy called Kurt\n"
               "in this town.\f"
               "He should be able to take care of it...")
    } else {
        npcmsg("I knew we could count on Kurt!")
    }
_039F:
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T23_007 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_BEAT_AZALEA_ROCKETS)) {
        npcmsg("The SLOWPOKE have returned.\r"
               "Knowing them, they could’ve just been\n"
               "taking it easy somewhere.")
        goto(_039F)
    }
    npcmsg("The SLOWPOKE have disappeared\n"
           "from town...\r"
           "I heard their tails are being sold\n"
           "somewhere.")
    goto(_039F)
}

