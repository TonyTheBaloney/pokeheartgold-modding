script Azalea_OnTransition {
    if (var(VAR_UNK_4080) == 0) {
        setflag(FLAG_UNK_19F)
        clearflag(FLAG_AZALEA_ROCKET_HARASSING_CIVILIAN)
        clearflag(FLAG_AZALEA_HARASSED_CIVILIAN)
    }
    end
}

script Azalea_EventScript_RocketGrunt1 {
scr_seq_T23_005:
    simplenpcmsg("Nothing is going on.\n"
                 "It’s unsafe to go in there, so I’m\f"
                 "standing guard to make sure\f"
                 "people don’t wander in.\r"
                 "Am I not a good Samaritan?")
    end
}

script Azalea_EventScript_Slowpoke {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("SLOWPOKE: ...\r"
           "...\r")
    playcry(SPECIES_SLOWPOKE, 0)
    npcmsg("...Yawn?")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Azalea_EventScript_RivalTrigger {
    followmonresetmovement
    lockall
    fadeoutbgm(0, 3)
    applymovement(obj_player, Azalea_Movement_PlayerExclamation)
    waitmovement
    setvar(VAR_FARFETCHD1_STICKS1, STICKS_ACTIVE)
    callstd(std_play_rival_intro_music)
    getplayercoords(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_x8005) == 462) {
        movepersonfacing(obj_T23_gsrivel, 404, 0, 463, DIR_WEST)
        applymovement(obj_T23_gsrivel, Azalea_Movement_RivalWalkLeft1)
        applymovement(obj_player, Azalea_Movement_PlayerFaceDown)
    } elif (var(VAR_SPECIAL_x8005) == 463) {
        movepersonfacing(obj_T23_gsrivel, 404, 0, 464, DIR_WEST)
        applymovement(obj_T23_gsrivel, Azalea_Movement_RivalWalkLeft1)
        applymovement(obj_player, Azalea_Movement_PlayerFaceDown)
    } elif (var(VAR_SPECIAL_x8005) == 464) {
        movepersonfacing(obj_T23_gsrivel, 404, 0, 463, DIR_WEST)
        applymovement(obj_T23_gsrivel, Azalea_Movement_RivalWalkLeft2)
        applymovement(obj_player, Azalea_Movement_PlayerFaceUp)
    } elif (var(VAR_SPECIAL_x8005) == 465) {
        movepersonfacing(obj_T23_gsrivel, 404, 0, 464, DIR_WEST)
        applymovement(obj_T23_gsrivel, Azalea_Movement_RivalWalkLeft2)
        applymovement(obj_player, Azalea_Movement_PlayerFaceUp)
    } else {
        movepersonfacing(obj_T23_gsrivel, 404, 0, 465, DIR_WEST)
        applymovement(obj_T23_gsrivel, Azalea_Movement_RivalWalkLeft2)
        applymovement(obj_player, Azalea_Movement_PlayerFaceUp)
    }
    waitmovement
    bufferrivalsname(0)
    npcmsg("{STRVAR_1 3, 0, 0}: ...Tell me something.\r"
           "Is it true that Team Rocket has\n"
           "returned?\r"
           "What? You beat them? Hah!\n"
           "Quit lying.\r"
           "Are you serious?\n"
           "Then let’s see how good you are.\r")
    closemessage
    getstarterchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 152) {
        trainerbattle(TRAINER_RIVAL_SILVER_7, 0, 0, 0)
    } elif (var(VAR_SPECIAL_RESULT) == 155) {
        trainerbattle(TRAINER_RIVAL_SILVER_10, 0, 0, 0)
    } else {
        trainerbattle(TRAINER_RIVAL_SILVER, 0, 0, 0)
    }
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    callstd(std_play_rival_outro_music)
    bufferrivalsname(0)
    npcmsg("{STRVAR_1 3, 0, 0}: I hate the weak.\r"
           "Pokémon, Trainers.\n"
           "It doesn’t matter who or what.\r"
           "I hate to see them hanging around.\n"
           "That goes for Team Rocket, too.\r"
           "They think they are big and tough\n"
           "as long as they are in a group.\r"
           "But get them alone, and they’re weak.\n"
           "I hate them all.\r"
           "You stay out of my way.\n"
           "You won’t be an exception\f"
           "if you get in my way.\r")
    closemessage
    setvar(VAR_UNK_4075, 2)
    getplayercoords(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_x8005) == 462) {
        applymovement(obj_T23_gsrivel, Azalea_Movement_RivalWalkLeft3)
    } elif (var(VAR_SPECIAL_x8005) == 463) {
        applymovement(obj_T23_gsrivel, Azalea_Movement_RivalWalkLeftUp1)
    } elif (var(VAR_SPECIAL_x8005) == 464) {
        applymovement(obj_T23_gsrivel, Azalea_Movement_RivalWalkLeft3)
    } elif (var(VAR_SPECIAL_x8005) == 465) {
        applymovement(obj_T23_gsrivel, Azalea_Movement_RivalWalkLeftUp1)
    } else {
        applymovement(obj_T23_gsrivel, Azalea_Movement_RivalWalkLeftUp2)
    }
    waitmovement
    removeobject(obj_T23_gsrivel)
    callstd(std_fade_end_rival_outro_music)
    releaseall
    end
}

movement Azalea_Movement_RivalWalkLeft1 {
    walk_left * 9
    face_up
}

movement Azalea_Movement_RivalWalkLeft2 {
    walk_left * 9
    face_down
}

movement Azalea_Movement_PlayerExclamation {
    emote_exclamation_mark
}

movement Azalea_Movement_PlayerFaceDown {
    face_right
    delay_4 * 6
    delay_8 * 7
    face_down
}

movement Azalea_Movement_PlayerFaceUp {
    face_right
    delay_4 * 6
    delay_8 * 7
    face_up
}

movement Azalea_Movement_RivalWalkLeft3 {
    walk_left * 3
}

movement Azalea_Movement_RivalWalkLeftUp1 {
    walk_left
    walk_up
    walk_left * 2
}

movement Azalea_Movement_RivalWalkLeftUp2 {
    walk_left
    walk_up * 2
    walk_left * 2
}

script Azalea_EventScript_RocketGruntTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_T23_rocketm_3, Azalea_Movement_RocketGruntFaceLeft)
    waitmovement
    npcmsg("Who are you?\n"
           "You don’t know us?\r"
           "We are...\n"
           "Team Rocket!\r"
           "...What?\n"
           "We broke up a while ago?\r"
           "Give me a break!\n"
           "We have not broken up!\r"
           "Actually we did once.\n"
           "But we have come back to\f"
           "pursue Giovanni’s ambition.\r"
           "Enough talking.\n"
           "Shut up and just beat it!\r")
    playse(SEQ_SE_DP_WALL_HIT)
    npcmsg("{SIZE 200}Thud!{SIZE 100}\r")
    closemessage
    applymovement(obj_T23_gsmiddleman1_2, Azalea_Movement_PokefanMWalkLeft)
    waitmovement
    movepersonfacing(obj_T23_gsmiddleman1_2, 23, 0, 16, DIR_EAST)
    applymovement(obj_T23_rocketm_3, Azalea_Movement_RocketGruntWalkUp)
    waitmovement
    removeobject(obj_T23_gsmiddleman1_2)
    setflag(FLAG_AZALEA_HARASSED_CIVILIAN)
    setflag(FLAG_AZALEA_ROCKET_HARASSING_CIVILIAN)
    clearflag(FLAG_UNK_19F)
    setvar(VAR_UNK_4080, 1)
    releaseall
    end
}

movement Azalea_Movement_RocketGruntFaceLeft {
    walk_in_place_left * 2
}

movement Azalea_Movement_PokefanMWalkLeft {
    lock_dir
    walk_faster_left
    delay_8 * 2
    walk_slow_left * 2
    unlock_dir
    walk_fast_left * 9
}

movement Azalea_Movement_RocketGruntWalkUp {
    walk_up * 2
    walk_in_place_down
}

script Azalea_EventScript_PokefanM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_BEAT_AZALEA_ROCKETS)) {
        npcmsg("We have this tough guy called Kurt\n"
               "in this town.\f"
               "He should be able to take care of it...")
    } else {
        npcmsg("I knew we could count on Kurt!")
    }
_039F:
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Azalea_EventScript_OldMan {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_BEAT_AZALEA_ROCKETS)) {
        npcmsg("The SLOWPOKE have returned.\r"
               "Knowing them, they could’ve just been\n"
               "taking it easy somewhere.")
        goto(_039F)
    }
    npcmsg("The SLOWPOKE have disappeared\n"
           "from town...\r"
           "I heard their tails are being sold\n"
           "somewhere.")
    goto(_039F)
}

