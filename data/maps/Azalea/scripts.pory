script Azalea_EventScript_RocketGrunt2 {
    simplenpcmsg("Do you know about SlowpokeTail?\n"
                 "I heard it’s tasty!\r"
                 "Aren’t you glad I told you that?")
    end
}

script Azalea_EventScript_Woman {
    simplenpcmsg("Did you come to get Kurt to make\n"
                 "some Poké Balls?\f"
                 "A lot of people do just that.")
    end
}

script Azalea_EventScript_Man {
    simplenpcmsg("Cut through Azalea and you’ll be in\n"
                 "Ilex Forest.\r"
                 "But these skinny trees make it\n"
                 "impossible to get through.\r"
                 "The Charcoal Man’s Pokémon can cut\n"
                 "down trees.")
    end
}

