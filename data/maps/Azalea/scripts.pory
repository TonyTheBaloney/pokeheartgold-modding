        applymovement(obj_player, Azalea_Movement_02C0)
    } else {
        movepersonfacing(obj_T23_gsrivel, 404, 0, 465, DIR_WEST)
        applymovement(obj_T23_gsrivel, Azalea_Movement_0298)
        applymovement(obj_player, Azalea_Movement_02C0)
