script Route34_IlexForestGatehouse_EventScript_Woman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_TM12_FROM_ILEX_FOREST_GATE_WOMAN)) { goto(_0055) }
    npcmsg("Oh, honey. You’re making a Pokédex?\r"
           "You must be battling all kinds\n"
           "of Pokémon.\r"
           "Try using this TM for a change.")
    waitabpress
    if (!itemspace(ITEM_TM12, 1)) {
        callstd(std_bag_is_full)
        closemessage
        releaseall
        end
    }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM12_FROM_ILEX_FOREST_GATE_WOMAN)
    goto(_0055)
_0055:
    npcmsg("It’s Taunt.\r"
           "Use it and the target Pokémon\n"
           "can only use moves that do damage\f"
           "to your Pokémon for a while.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route34_IlexForestGatehouse_EventScript_Butterfree {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_BUTTERFREE, 0)
    npcmsg("BUTTERFREE: Freeh!")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route34_IlexForestGatehouse_EventScript_Lass {
