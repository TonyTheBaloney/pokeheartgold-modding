script SsAquaCaptainRoom_OnTransition {
    if (var(VAR_SCENE_SS_AQUA) >= 4) {
        setflag(FLAG_HIDE_SS_AQUA_CAPTAINS_ROOM_GRANDDAUGHTER)
        end
    }
    end
}

script SsAquaCaptainRoom_EventScript_Captain {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_SS_AQUA) >= 6) {
        if (!flag(FLAG_DAILY_RECEIVED_PLATE_FROM_AQUA_CAPTAIN)) {
            if (!flag(FLAG_RECEIVED_PLATE_FROM_AQUA_CAPTAIN_THIS_TRIP)) {
                checkbadge(BADGE_EARTH, VAR_TEMP_x4002)
                if (var(VAR_TEMP_x4002) == 1) {
                    npcmsg("Long time no see.\n"
                           "How are you doing?\r"
                           "The S.S. Aqua is as smooth as she\n"
                           "can be!\r"
                           "By the way, I found this mysterious\n"
                           "thing when I went to Sinnoh\f"
                           "the other day.\r"
                           "Now that we’ve met again,\n"
                           "I would like you to have it.\r")
                    closemessage
                    if (var(VAR_RECEIVED_PLATES_COUNT) == 0) {
                        setvar(VAR_SPECIAL_x8004, ITEM_FLAME_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 1) {
                        setvar(VAR_SPECIAL_x8004, ITEM_SPLASH_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 2) {
                        setvar(VAR_SPECIAL_x8004, ITEM_ZAP_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 3) {
                        setvar(VAR_SPECIAL_x8004, ITEM_MEADOW_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 4) {
                        setvar(VAR_SPECIAL_x8004, ITEM_ICICLE_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 5) {
                        setvar(VAR_SPECIAL_x8004, ITEM_FIST_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 6) {
                        setvar(VAR_SPECIAL_x8004, ITEM_TOXIC_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 7) {
                        setvar(VAR_SPECIAL_x8004, ITEM_EARTH_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 8) {
                        setvar(VAR_SPECIAL_x8004, ITEM_SKY_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 9) {
                        setvar(VAR_SPECIAL_x8004, ITEM_MIND_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 10) {
                        setvar(VAR_SPECIAL_x8004, ITEM_INSECT_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 11) {
                        setvar(VAR_SPECIAL_x8004, ITEM_STONE_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 12) {
                        setvar(VAR_SPECIAL_x8004, ITEM_SPOOKY_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 13) {
                        setvar(VAR_SPECIAL_x8004, ITEM_DRACO_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 14) {
                        setvar(VAR_SPECIAL_x8004, ITEM_DREAD_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } elif (var(VAR_RECEIVED_PLATES_COUNT) == 15) {
                        setvar(VAR_SPECIAL_x8004, ITEM_IRON_PLATE)
                        setvar(VAR_SPECIAL_x8005, 1)
                    } else {
                        setvar(VAR_SPECIAL_x8004, ITEM_NUGGET)
                        setvar(VAR_SPECIAL_x8005, 1)
                        goto(_029C)
                    }
                    addvar(VAR_RECEIVED_PLATES_COUNT, 1)
                _029C:
                    hasspaceforitem(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005, VAR_SPECIAL_RESULT)
                    if (var(VAR_SPECIAL_RESULT) == 0) {
                        bufferitemname(1, VAR_SPECIAL_x8004)
                        npcmsg("Your Bag is full.\r"
                               "You must like the {STRVAR_1 8, 1, 0} a lot.")
                        waitbuttonpress
                        closemessage
                        releaseall
                        end
                    }
                    callstd(std_obtain_item_verbose)
                    setflag(FLAG_DAILY_RECEIVED_PLATE_FROM_AQUA_CAPTAIN)
                    setflag(FLAG_RECEIVED_PLATE_FROM_AQUA_CAPTAIN_THIS_TRIP)
                    closemessage
                    releaseall
                    end
                }
            }
        }
        npcmsg("How do you like S.S. Aqua’s ride?\r"
               "She practically skates across\n"
               "the waves.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_SCENE_SS_AQUA) == 4) { goto(_0050) }
    npcmsg("This little girl keeps asking me to play\n"
           "with her.\r"
           "Ouch! Please don’t stretch my ear!")
    waitbuttonpress
    closemessage
    releaseall
    end
_0050:
    npcmsg("Thank you for playing with her.\r"
           "You may think being a Captain\n"
           "is a somewhat easy job, but\f"
           "it’s actually quite demanding.\r"
           "That little passenger has gone out\n"
           "of the room.\r"
           "She can’t get off the ship, so she\n"
           "must be hiding somewhere\f"
           "around here.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script SsAquaCaptainRoom_EventScript_LittleGirl {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("Captain, play with me, please?\r"
           "I’m bored! I want to play more!\r")
    closemessage
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_P01R0302_gsbabygirl1, SsAquaCaptainRoom_Movement_LittleGirlExclamation1)
    } else {
        applymovement(obj_P01R0302_gsbabygirl1, SsAquaCaptainRoom_Movement_LittleGirlExclamation2)
    }
    waitmovement
    gendermsgbox("Wow, you are going to play with me?\r"
                 "Let’s play hide-and-seek!\n"
                 "I’ll hide, so close your eyes!\r", "Wow, you are going to play with me?\r"
                                                     "Let’s play hide-and-seek!\n"
                                                     "I’ll hide, so close your eyes!\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setvar(VAR_SCENE_SS_AQUA, 4)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    removeobject(obj_P01R0302_gsbabygirl1)
    setflag(FLAG_HIDE_SS_AQUA_CAPTAINS_ROOM_GRANDDAUGHTER)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

movement SsAquaCaptainRoom_Movement_LittleGirlExclamation1 {
    emote_exclamation_mark
    delay_8
    face_up * 2
}

movement SsAquaCaptainRoom_Movement_LittleGirlExclamation2 {
    emote_exclamation_mark
    delay_8
    face_right * 2
}

mapscripts SsAquaCaptainRoom_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: SsAquaCaptainRoom_OnTransition
}
