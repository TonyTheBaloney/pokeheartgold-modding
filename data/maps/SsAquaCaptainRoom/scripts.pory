script scr_seq_P01R0302_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg(msg_0260_P01R0302_00000)
    closemessage
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_P01R0302_gsbabygirl1, SsAquaCaptainRoom_Movement_0340)
    } else {
        applymovement(obj_P01R0302_gsbabygirl1, SsAquaCaptainRoom_Movement_0350)
    }
    waitmovement
    gendermsgbox(msg_0260_P01R0302_00003, msg_0260_P01R0302_00002)
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setvar(VAR_SCENE_SS_AQUA, 4)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    removeobject(obj_P01R0302_gsbabygirl1)
    setflag(FLAG_HIDE_SS_AQUA_CAPTAINS_ROOM_GRANDDAUGHTER)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

movement SsAquaCaptainRoom_Movement_0340 {
    emote_exclamation_mark
    delay_8
    face_up * 2
}

movement SsAquaCaptainRoom_Movement_0350 {
    emote_exclamation_mark
    delay_8
    face_right * 2
}

