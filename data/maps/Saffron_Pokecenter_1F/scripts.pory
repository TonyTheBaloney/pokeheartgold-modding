script scr_seq_T11PC0101_001 {
    simplenpcmsg("What are Johto’s Pokémon Centers like?\r"
                 "...Oh, I see. So they’re not much\n"
                 "different from the ones in Kanto.\r"
                 "Then I’ll get my friend in Johto to\n"
                 "catch a MARILL and trade it to me!")
    end
}

script scr_seq_T11PC0101_002 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_RESTORED_POWER)) {
        npcmsg("Adventures are not always full of\n"
               "oceans and mountains!\r"
               "Daily life can be quite adventurous!\r"
               "...By the way, I’ve heard people\n"
               "talking about a cave in Cerulean.\r"
               "Do you know anything?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("I just happened to come through the\n"
           "Rock Tunnel. There was some commotion\f"
           "at the Power Plant.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T11PC0101_003 {
    simplenpcmsg("Silph Co.’s head office and the\n"
                 "Magnet Train station--\f"
                 "they’re the places to see in Saffron.")
    end
}

