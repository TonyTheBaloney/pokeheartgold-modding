script SsAquaVermilionPortExterior_OnTransition {
    if (!flag(FLAG_UNK_168)) {
        setflag(FLAG_UNK_998)
    }
    setpokegearmapunlocklevel(2)
    setflag(FLAG_UNK_168)
    setflag(FLAG_SYS_FLYPOINT_VERMILION)
    setspecialspawnwarp(MAP_VERMILION, 1309, 340)
    end
}

script SsAquaVermilionPortExterior_OnResume {
    if (var(VAR_BOAT_DIRECTION) == 1) {
        movepersonfacing(obj_P01R0104_seaman_2, 24, 0, 19, DIR_WEST)
        end
    }
    end
}

script SsAquaVermilionPortExterior_EventScript_SailorScene {
    followmonresetmovement
    lockall
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, SsAquaVermilionPortExterior_Movement_PlayerWalkDown)
    waitmovement
    applymovement(obj_P01R0104_seaman_2, SsAquaVermilionPortExterior_Movement_SailorWalkLeft1)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    setvar(VAR_BOAT_DIRECTION, 0)
    clearflag(FLAG_RECEIVED_PLATE_FROM_AQUA_CAPTAIN_THIS_TRIP)
    releaseall
    end
}

movement SsAquaVermilionPortExterior_Movement_PlayerWalkDown {
    walk_down * 3
}

movement SsAquaVermilionPortExterior_Movement_SailorWalkLeft1 {
    walk_left
    walk_in_place_down
}

script SsAquaVermilionPortExterior_EventScript_Sailor {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_BOAT_ARRIVED)) {
        npcmsg("Huh?\n"
               "The ship won’t go anywhere today.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("OK!\n"
           "You must be the last passenger.\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 2) {
        applymovement(obj_P01R0104_seaman_2, SsAquaVermilionPortExterior_Movement_SailorWalkLeft2)
        waitmovement
        applymovement(obj_player, SsAquaVermilionPortExterior_Movement_PlayerWalkLeftUp)
    } elif (var(VAR_TEMP_x4000) == 3) {
        applymovement(obj_P01R0104_seaman_2, SsAquaVermilionPortExterior_Movement_SailorWalkRight1)
        waitmovement
        applymovement(obj_player, SsAquaVermilionPortExterior_Movement_PlayerWalkRightUp)
    } else {
        applymovement(obj_P01R0104_seaman_2, SsAquaVermilionPortExterior_Movement_SailorWalkRight2)
        waitmovement
        applymovement(obj_player, SsAquaVermilionPortExterior_Movement_PlayerWalkUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    playse(SEQ_SE_DP_KAIDAN2)
    shipvoyage(1, 0, 307, 24, 19)
    releaseall
    end
}

