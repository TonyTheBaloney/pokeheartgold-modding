        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, Route45_Movement_PlayerWalkUp)
    } else {
        applymovement(obj_player, Route45_Movement_PlayerWalkUpLeft)
        applymovement(obj_R45_gsmiddleman1, Route45_Movement_PokefanMFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, Route45_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(47)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Route45_Movement_PlayerWalkUp {
    walk_up * 3
    walk_in_place_down
}

movement Route45_Movement_PlayerWalkUpLeft {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Route45_Movement_PokefanMFaceUp {
    delay_8
    walk_in_place_up
}

movement Route45_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

script Route45_EventScript_Man {
    simplenpcmsg("Have you heard of a place called\n"
                 "the Battle Frontier?\r"
                 "It’s a huge place with many battle\n"
                 "facilities, and it’s located west of\f"
                 "Olivine City!\r"
                 "Let’s see...\r"
                 "If you manage to win all the way up\n"
                 "through the Pokémon League,\f"
                 "you might want to try it.")
    end
}

