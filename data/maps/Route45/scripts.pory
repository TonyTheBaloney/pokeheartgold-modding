script Route45_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 3) { goto(_004B) }
        if (var(VAR_TEMP_x4000) == 6) { goto(_004B) }
        setflag(FLAG_HIDE_CAMERON)
        end
    _004B:
        clearflag(FLAG_HIDE_CAMERON)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script Route45_EventScript_PokefanM {
