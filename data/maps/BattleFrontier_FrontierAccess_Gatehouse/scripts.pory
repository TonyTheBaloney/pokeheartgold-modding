        applymovement(obj_D32R0101_bfsw2, BattleFrontier_FrontierAccess_Gatehouse_Movement_AttendantFaceDown)
        applymovement(obj_D32R0101_bfsw2_2, BattleFrontier_FrontierAccess_Gatehouse_Movement_AttendantFaceDown)
        applymovement(obj_D32R0101_bfsw2_3, BattleFrontier_FrontierAccess_Gatehouse_Movement_AttendantFaceDown)
        applymovement(obj_D32R0101_bfsw2_4, BattleFrontier_FrontierAccess_Gatehouse_Movement_AttendantFaceDown)
        applymovement(obj_D32R0101_bfsw2_5, BattleFrontier_FrontierAccess_Gatehouse_Movement_AttendantFaceDown)
        applymovement(obj_D32R0101_bfsw2_6, BattleFrontier_FrontierAccess_Gatehouse_Movement_AttendantFaceDown)
        waitmovement
        return
    _0333:
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(55)
        applymovement(obj_D32R0101_bfsw2, BattleFrontier_FrontierAccess_Gatehouse_Movement_AttendantFaceRight)
        applymovement(obj_D32R0101_bfsw2_2, BattleFrontier_FrontierAccess_Gatehouse_Movement_AttendantFaceRight)
        applymovement(obj_D32R0101_bfsw2_3, BattleFrontier_FrontierAccess_Gatehouse_Movement_AttendantFaceRight)
