    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("Welcome to the Battle Frontier!\r"
           "Should I explain how the\n"
           "Battle Tower works? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("The Battle Tower is the building at the\n"
               "back of the Battle Frontier.\r"
               "The object here is to enter a team of\n"
               "different Pokémon and battle on until\f"
               "you lose.\r")
        goto(_01B8)
        end
    _01B8:
        npcmsg("We hope you enjoy your visit!")
        goto(_01C3)
        end
    _01C3:
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_01B8) }
    end
}

