script BattleFrontier_FrontierAccess_Gatehouse_EventScript_Scene {
    followmonresetmovement
    lockall
    setvar(VAR_UNK_40E6, 1)
    call(_02FF)
    npcmsg("Welcome to the Battle Frontier!\r"
           "This is your first visit?\n"
           "Right this way, please!\r")
    closemessage
    call(_0333)
    if (!flag(FLAG_UNK_176)) {
        npcmsg("Oh! You have a Vs. Recorder!\n"
               "How nice!\r"
               "We upgrade Vs. Recorders for first-time\n"
               "visitors for Battle Frontier use.\r"
               "I’ll borrow yours for a moment.\r"
               "Let’s see... Slide open this part here,\n"
               "and ticka-tacka-kachunk there!\r"
               "All done!\n"
               "Here you go.\r")
        bufferplayersname(0)
        playfanfare(SEQ_ME_ITEM)
        npcmsg("{STRVAR_1 3, 0, 0}’s Vs. Recorder was\n"
               "upgraded.")
        waitfanfare
        setflag(FLAG_UNK_176)
    }
    npcmsg("Our other staff will be pleased to\n"
           "explain how the individual facilities\f"
           "of the Battle Frontier operate.\r"
           "I can go over general topics.\n"
           "Do you have any questions? {YESNO 0}")
    call(_00A6)
    touchscreenmenushow
    npcmsg(msg_0103_D32R0101_00010)
    waitbuttonpress
    closemessage
    releaseall
    end
}

text msg_0103_D32R0101_00010 {
    "We hope you enjoy your visit!"
}

script BattleFrontier_FrontierAccess_Gatehouse_EventScript_Attendant1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg(msg_0103_D32R0101_00004)
    call(_00A6)
    goto(_012B)
    end
