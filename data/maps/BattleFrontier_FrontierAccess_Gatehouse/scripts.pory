script BattleFrontier_FrontierAccess_Gatehouse_EventScript_RuinManiac {
    simplenpcmsg("The Battle Frontier is up ahead!\n"
                 "I have explored places all over the\f"
                 "world, but nothing compares to the\f"
                 "excitement I feel right now!\r"
                 "What kinds of Trainers will I see?\n"
                 "What battles will I experience?\r"
                 "It’s a whole new adventure for me!")
    end
}

script BattleFrontier_FrontierAccess_Gatehouse_EventScript_OldMan {
    simplenpcmsg("The five facilities of the Battle\n"
                 "Frontier are...\r"
                 "Tower.\r"
                 "Hall.\r"
                 "Castle.\r"
                 "Factory.\r"
                 "And Arcade.\r"
                 "How do you make an acronym out of\n"
                 "that? THCFA?\r"
                 "Rearrange those letters, maybe?\n"
                 "FATCH! CHAFT!\r"
                 "...Nope! Nothing works!\n"
                 "Didn’t anyone think of this?!")
    end
}

script BattleFrontier_FrontierAccess_Gatehouse_EventScript_Man {
    simplenpcmsg("The Vs. Recorder is sure nifty!\r"
                 "Checking the Frontier Record\n"
                 "will tell you how much BP you have.")
    end
}

script BattleFrontier_FrontierAccess_Gatehouse_EventScript_Beauty {
    simplenpcmsg("My dream is to battle Palmer of the\n"
                 "Battle Tower.\r"
                 "I want to record it for posterity on\n"
                 "my Vs. Recorder.\r"
                 "But I left my Vs. Recorder\n"
                 "at home... I’m heartbroken!")
    end
}

