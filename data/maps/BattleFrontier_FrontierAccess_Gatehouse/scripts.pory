    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("The Battle Arcade is at the lower-right\n"
               "corner of the Battle Frontier.\r"
               "Here, a game board is activated\n"
               "before every match.\r"
               "Depending on what comes up on the\n"
               "game board, an event takes place.\r"
               "Some events will be good to the\n"
               "challenger, while others won’t be.\r"
               "The challenger may even avoid having\n"
               "to battle at all.\r"
               "The objective is to keep a winning\n"
               "streak alive as long as possible.\r")
        goto(_02EC)
        end
    _02EC:
        npcmsg("We hope you enjoy your visit!")
        goto(_02F7)
        end
