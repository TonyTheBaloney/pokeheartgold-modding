        applymovement(obj_D32R0101_bfsw2_6, BattleFrontier_FrontierAccess_Gatehouse_Movement_AttendantFaceLeft)
        applymovement(obj_player, BattleFrontier_FrontierAccess_Gatehouse_Movement_PlayerWalkUp)
