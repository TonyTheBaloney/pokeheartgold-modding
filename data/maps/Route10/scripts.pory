               "I can feel electric power around\n"
               "the Power Plant.\r"
               "You may want to catch a PIKACHU in\n"
               "the Viridian Forest and bring it here!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Lt. Surge: Oh, yay!\n"
           "You have the Pokémon I love best:\f"
           "PIKACHU!\r"
           "Excellent!\n"
           "I’ll give you my telephone number! {YESNO 0}")
_0114:
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0138) }
    if (var(VAR_SPECIAL_RESULT) >= 1) { goto(_017B) }
    end
_0138:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} registered Lt. Surge\n"
           "in the Pokégear!")
    playfanfare(SEQ_ME_POKEGEAR_REGIST)
    waitfanfare
    registergearnumber(PHONE_CONTACT_LT__SURGE)
_0148:
    npcmsg("Lt. Surge: Give me a call on Friday\n"
           "morning!\r"
           "We can have an electrifying battle!")
    waitbuttonpress
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setflag(FLAG_HIDE_ROUTE_10_LT_SURGE)
