}

script Route10_EventScript_WarpToRoute10PowerPlantRepaired {
    followmonresetmovement
    lockall
    if (flag(FLAG_RESTORED_POWER)) {
        followmonisactive(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) != 0) {
            followmonislarge(VAR_SPECIAL_RESULT)
            if (var(VAR_SPECIAL_RESULT) == 1) {
                followmonrecall
            }
        }
        playse(SEQ_SE_DP_KAIDAN2)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        warp(MAP_ROUTE_10_POWER_PLANT_REPAIRED, 0, 7, 20, DIR_NORTH)
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        setspecialspawnwarp(MAP_ROUTE_10, 1423, 185)
        releaseall
        end
    }
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 0) {
        followmonislarge(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            followmonrecall
        }
    }
    playse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    warp(MAP_ROUTE_10_POWER_PLANT_BROKEN, 0, 7, 20, DIR_NORTH)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    setspecialspawnwarp(MAP_ROUTE_10, 1423, 185)
    releaseall
    end
}

script Route10_EventScript_Zapdos {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_ZAPDOS, 0)
    waitcry
    setflag(FLAG_ENGAGING_STATIC_POKEMON)
    wildbattle(SPECIES_ZAPDOS, 50, 0)
    clearflag(FLAG_ENGAGING_STATIC_POKEMON)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    _02B9:
        setflag(FLAG_CAUGHT_ZAPDOS)
        return
    }
    getstaticencounteroutcome(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) != 3) {
        compare(VAR_TEMP_x4002, 4)
        callifeq(_02B9)
    }
    releaseall
    end
}

