script Route10_OnLoad {
    if (flag(FLAG_ENGAGING_STATIC_POKEMON)) {
        setflag(FLAG_HIDE_ROUTE_10_ZAPDOS)
        removeobject(obj_R10_tsure_poke_static_zapdos)
        clearflag(FLAG_ENGAGING_STATIC_POKEMON)
        end
    }
    end
}

