script Azalea_Gym_OnTransition {
    azaleagyminit
    getphonebookrematch(PHONE_CONTACT_BUGSY, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 0) {
        setflag(FLAG_HIDE_AZALEA_GYM_BUGSY)
        end
    }
    if (flag(FLAG_GAME_CLEAR)) { goto(_006C) }
    clearflag(FLAG_HIDE_AZALEA_GYM_BUGSY)
    end
_006C:
    checkregisteredphonenumber(PHONE_CONTACT_BUGSY, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_0096) }
    getweekday(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) != 4) { goto(_0096) }
    setflag(FLAG_HIDE_AZALEA_GYM_BUGSY)
    end
_0096:
    getweekday(VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_00C7) }
    if (var(VAR_TEMP_x4001) == 3) { goto(_00C7) }
    if (var(VAR_TEMP_x4001) == 5) { goto(_00C7) }
    clearflag(FLAG_HIDE_AZALEA_GYM_BUGSY)
    end
_00C7:
    setflag(FLAG_HIDE_AZALEA_GYM_BUGSY)
    end
}

script Azalea_Gym_EventScript_Bugsy {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_HIVE, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        if (!flag(FLAG_GOT_TM89_FROM_BUGSY)) { goto(_0136) }
        npcmsg("Bugsy: Bug-type Pokémon are deep.\n"
               "There are many mysteries to explore.\r"
               "Study your top choices thoroughly.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Bugsy: I’m Bugsy!\n"
           "I never lose when it comes to Bug-type\f"
           "Pokémon.\r"
           "My research is going to make me\n"
           "the authority on Bug-type Pokémon!\r"
           "Let me demonstrate what I’ve learned\n"
           "from my studies.\r")
    closemessage
    trainerbattle(TRAINER_LEADER_BUGSY_BUGSY, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0174) }
    npcmsg("Bugsy: Whoa, amazing!\n"
           "You’re an expert on Pokémon!\r"
           "My research isn’t complete yet.\n"
           "OK, you win. Take this Badge.\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Hive Badge from Bugsy!")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    givebadge(BADGE_HIVE)
    settrainerflag(TRAINER_BUG_CATCHER_AL)
    settrainerflag(TRAINER_BUG_CATCHER_BENNY)
    settrainerflag(TRAINER_BUG_CATCHER_JOSH)
    settrainerflag(TRAINER_TWINS_AMY_AND_MIMI)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    npcmsg("Bugsy: Do you know the benefits of the\n"
           "Hive Badge?\r"
           "If you have it, Pokémon up to Lv. 30\n"
           "will obey you, even traded ones.\r"
           "Pokémon that know Cut will be able\n"
           "to use it outside of battle, too.\r"
           "Here, I also want you to have this.\r")
_0136:
    if (!itemspace(ITEM_TM89, 1)) { goto(_016A) }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM89_FROM_BUGSY)
    npcmsg("Bugsy: TM89 contains U-turn.\r"
           "It lets your Pokémon attack, then\n"
           "switch with the next Pokémon\f"
           "in your party.\r"
           "Isn’t that great?")
    waitbuttonpress
    closemessage
    releaseall
    end
_016A:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
_0174:
    whiteout
    releaseall
    end
}

