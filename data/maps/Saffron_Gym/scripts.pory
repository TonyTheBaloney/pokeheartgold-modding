}

script Saffron_Gym_OnTransition {
    getphonebookrematch(PHONE_CONTACT_SABRINA, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 0) {
        setflag(FLAG_HIDE_SAFFRON_GYM_SABRINA)
        end
    }
    checkregisteredphonenumber(PHONE_CONTACT_SABRINA, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_006C) }
    checkbadge(BADGE_MARSH, VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 1) { goto(_0055) }
    goto(_0083)
_0055:
    getweekday(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) != 5) { goto(_0083) }
    setflag(FLAG_HIDE_SAFFRON_GYM_SABRINA)
    end
_006C:
    getweekday(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) != 1) { goto(_0083) }
    setflag(FLAG_HIDE_SAFFRON_GYM_SABRINA)
    end
_0083:
    clearflag(FLAG_HIDE_SAFFRON_GYM_SABRINA)
    end
}

script Saffron_Gym_EventScript_Sabrina {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_MARSH, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        if (!flag(FLAG_GOT_TM48_FROM_SABRINA)) { goto(_0102) }
        npcmsg("Sabrina: Your love for your Pokémon\n"
               "smashed my psychic abilities...\r"
               "The ability to love, I think, is some\n"
               "kind of psychic ability...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Sabrina: I knew you were coming...\r"
           "Three years ago I had a vision of\n"
           "your arrival. You’re after my Badge.\r"
           "I don’t enjoy battling, but it’s my\n"
           "duty as a Gym Leader to confer\f"
           "Badges on anyone who has proven\f"
           "him- or herself worthy.\r"
           "Since you wish it, I will show you my\n"
           "psychic powers!\r")
    closemessage
    trainerbattle(TRAINER_LEADER_SABRINA_SABRINA, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    givebadge(BADGE_MARSH)
    addvar(VAR_UNK_4135, 1)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    setflag(FLAG_UNK_998)
    settrainerflag(TRAINER_PSYCHIC_M_FRANKLIN)
    settrainerflag(TRAINER_PSYCHIC_M_JARED)
    settrainerflag(TRAINER_MEDIUM_REBECCA)
    settrainerflag(TRAINER_MEDIUM_DARCY)
    npcmsg("Sabrina: Your power...\n"
           "It far exceeds what I foresaw...\r"
           "Maybe it isn’t possible to fully\n"
           "predict what the future holds...\r"
           "OK, you win. You earned yourself\n"
           "the Marsh Badge.\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Marsh Badge!")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    npcmsg("Sabrina: I failed to accurately predict\n"
           "your power. That means that your\f"
           "power is beyond my psychic ability.\r"
           "You deserve this.\n"
           "Please take this TM, too!\r")
    goto(_0102)
_0102:
    if (!itemspace(ITEM_TM48, 1)) { goto(_0136) }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM48_FROM_SABRINA)
    npcmsg("Sabrina: It contains Skill Swap!\n"
           "It swaps Abilities between the user\f"
           "and the target.\r"
           "You will become a celebrated and\n"
           "beloved Champion!")
    waitbuttonpress
    closemessage
    releaseall
    end
_0136:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

script Saffron_Gym_EventScript_GymGuide {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_MARSH, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("That was another fantastic battle!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Yo, legend in the making!\r"
           "A Trainer as skilled as you doesn’t\n"
           "need to be told how to deal\f"
           "with Psychic-type Pokémon, right?\r"
           "I expect great things from you!\r"
           "Good luck!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Saffron_Gym_EventScript_GymSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_MARSH, VAR_SPECIAL_RESULT)
    bufferplayersname(0)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Saffron City Pokémon Gym")
    } else {
        npcmsg("Saffron City Pokémon Gym\r"
               "Leader: Sabrina\n"
               "Certified Trainer!\f"
               "{STRVAR_1 3, 0, 0}")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Saffron_Gym_EventScript_WarpToSaffronGym {
    followmonresetmovement
    lockall
    followmonrecall
    playse(SEQ_SE_PL_BOWABOWA)
    applymovement(obj_player, Saffron_Gym_Movement_PlayerExit)
    waitmovement
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    warp(MAP_SAFFRON_GYM, 0, 15, 23, DIR_SOUTH)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

movement Saffron_Gym_Movement_PlayerExit {
    face_down * 2
    face_left * 2
    face_up * 2
    face_right * 2
    face_down * 2
    face_left * 2
    face_up * 2
    face_right * 2
    face_down * 2
    face_left * 2
    face_up * 2
    face_right * 2
    face_down * 2
    face_left * 2
    face_up * 2
    face_right
    set_invisible * 0
}

mapscripts Saffron_Gym_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Saffron_Gym_OnTransition
}
