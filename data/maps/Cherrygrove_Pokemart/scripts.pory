scrdefs {
    Cherrygrove_Pokemart_EventScript_Clerk1
    Cherrygrove_Pokemart_EventScript_SchoolKidM
    Cherrygrove_Pokemart_EventScript_AceTrainerM
    Cherrygrove_Pokemart_EventScript_Clerk2
}

script Cherrygrove_Pokemart_EventScript_Clerk1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    callstd(std_mart_intro)
    holdmsg
    setvar(VAR_SPECIAL_x8004, 0)
    callstd(std_pokemart)
    releaseall
    end
}

script Cherrygrove_Pokemart_EventScript_Clerk2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    callstd(std_mart_intro)
    holdmsg
    setvar(VAR_SPECIAL_x8004, 0)
    callstd(std_special_mart)
    releaseall
    end
}

script Cherrygrove_Pokemart_EventScript_AceTrainerM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ELMS_LAB) >= 4) {
        npcmsg("Poké Balls are in stock!\n"
               "Now I can catch Pokémon!")
    } else {
        npcmsg("They’re fresh out of Poké Balls!\n"
               "When will they get more of them?")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Cherrygrove_Pokemart_EventScript_SchoolKidM {
    simplenpcmsg("When I was walking in the tall grass,\n"
                 "a Bug-type Pokémon poisoned\f"
                 "my Pokémon!\r"
                 "I just kept going, but my Pokémon\n"
                 "nearly fainted.\r"
                 "You should keep an Antidote with you.")
    end
}

mapscripts Cherrygrove_Pokemart_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: std_hide_show_deliverymen
}
