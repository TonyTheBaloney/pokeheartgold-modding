script Goldenrod_RadioTower_3F_EventScript_Man1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 4) {
        npcmsg("To Trainers, Pokémon are their\n"
               "beloved partners.\r"
               "It’s terrible how Team Rocket is trying\n"
               "to control Pokémon.")
    } else {
        npcmsg("We run 24 hours a day to broadcast\n"
               "entertaining programs.\r"
               "I’ll do my best to run around the\n"
               "clock, too!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Goldenrod_RadioTower_3F_EventScript_Man2 {
    simplenpcmsg("We have recordings of the cries of many\n"
                 "of the Pokémon that have been found.\r"
                 "We must have about 200 kinds.")
    end
}

script Goldenrod_RadioTower_3F_EventScript_Beauty {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 4) {
        getitemquantity(ITEM_BASEMENT_KEY, VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) != 0) {
            npcmsg("Is the Director safe?")
            waitbuttonpress
            closemessage
            releaseall
            end
        _0100:
            if (flag(FLAG_GOT_TM11_FROM_RADIO_TOWER_WOMAN)) {
                npcmsg("You were simply marvelous!")
                waitbuttonpress
                closemessage
                releaseall
                end
            }
            npcmsg("Thank you, kiddo! You’re the best!\n"
                   "This is a token of my appreciation.\r")
            if (!itemspace(ITEM_TM11, 1)) { goto(_0142) }
            callstd(std_give_item_verbose)
            npcmsg("It’s Sunny Day.\n"
                   "It powers up Fire-type moves for\f"
                   "a while.")
            waitbuttonpress
            closemessage
            releaseall
            setflag(FLAG_GOT_TM11_FROM_RADIO_TOWER_WOMAN)
            end
        _0142:
            npcmsg("Oh, your Bag is full.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("The Team Rocket boss has locked\n"
               "himself in.\r"
               "But the Director can open it.\r"
               "He’s up on the fifth floor.\n"
               "Please save him!")
    } else {
        goto(_0100)
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Goldenrod_RadioTower_3F_EventScript_LittleBoy {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getitemquantity(ITEM_CARD_KEY, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 0) { goto(_01B4) }
    npcmsg("The door is locked...\n"
           "You need a Card Key.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Goldenrod_RadioTower_3F_EventScript_Sign2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_090)) {
        npcmsg("It’s the Card Key slot.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("It’s the Card Key slot.\r")
    closemessage
    getitemquantity(ITEM_CARD_KEY, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 0) { goto(_01B4) }
    npcmsg("You should be able to unlock the door\n"
           "with the Card Key!")
    waitbuttonpress
    closemessage
    releaseall
    end
_01B4:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} inserted the Card Key.\r")
    closemessage
    applymovement(obj_D23R0103_babyboy1_9, Goldenrod_RadioTower_3F_Movement_LittleBoyWalkLeft)
    applymovement(obj_D23R0103_babyboy1_9_2, Goldenrod_RadioTower_3F_Movement_LittleBoyWalkRight)
    waitmovement
    releaseall
    setflag(FLAG_UNK_1BF)
    removeobject(obj_D23R0103_babyboy1_9)
    removeobject(obj_D23R0103_babyboy1_9_2)
    setflag(FLAG_UNK_090)
    end
}

