script MountMoon_Square_ClefairyEvent_EventScript_TrainerTips {
    trainertipsex(2, "This is Mt. Moon Square.\r"
                     "Please don’t litter. Put trash\n"
                     "where it belongs!")
    end
}

script MountMoon_Square_ClefairyEvent_EventScript_ItemBall {
    setvar(VAR_SPECIAL_x8008, 81)
    setvar(VAR_SPECIAL_x8009, 1)
    goto(_07E9)
    end
_07E9:
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    waitse(SEQ_SE_DP_SELECT)
    copyvar(VAR_SPECIAL_x8004, VAR_SPECIAL_x8008)
    copyvar(VAR_SPECIAL_x8005, VAR_SPECIAL_x8009)
    hasspaceforitem(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        callstd(std_hidden_item_fanfare)
        removeobject(VAR_SPECIAL_LAST_TALKED)
        giveitem(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005, VAR_SPECIAL_RESULT)
        bufferplayersname(0)
        bufferitemname(1, VAR_SPECIAL_x8004)
        npcmsg("{STRVAR_1 3, 0, 0} found\n"
               "{STRVAR_1 8, 1, 0}!")
        waitfanfare
        bufferplayersname(0)
        bufferitemname(1, VAR_SPECIAL_x8004)
        getitempocket(VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT)
        bufferpocketname(2, VAR_SPECIAL_RESULT)
        npcmsg("{STRVAR_1 3, 0, 0} put the {STRVAR_1 8, 1, 0}\n"
               "in the {COLOR 2}{STRVAR_1 31, 2, 0}{COLOR 0} Pocket.")
        waitbuttonpress
        setvar(VAR_SPECIAL_RESULT, 1)
    _0860:
        closemessage
        releaseall
        end
    }
    if (var(VAR_SPECIAL_RESULT) == 0) {
        bufferitemname(0, VAR_SPECIAL_x8004)
        npcmsg("Obtained the {STRVAR_1 8, 0, 0}!\r"
               "Too bad!\n"
               "The Bag is full...")
        waitbuttonpress
        setvar(VAR_SPECIAL_RESULT, 0)
        goto(_0860)
        end
    }
    end
}

script MountMoon_Square_ClefairyEvent_EventScript_Sign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("We are closed for the day.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

mapscripts MountMoon_Square_ClefairyEvent_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: MountMoon_Square_ClefairyEvent_OnTransition
    INIT_SCRIPT_ON_LOAD: MountMoon_Square_ClefairyEvent_OnLoad
}
