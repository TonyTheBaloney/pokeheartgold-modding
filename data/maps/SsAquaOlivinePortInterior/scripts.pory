script SsAquaOlivinePortInterior_OnTransition {
    getpreviousmapid(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 330) {
        setobjectfacing(obj_P01R0101_seaman_2, DIR_SOUTH)
        end
    }
    end
}

