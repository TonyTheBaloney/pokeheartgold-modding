}

movement SsAquaOlivinePortInterior_Movement_ProfOakExclamation1 {
    emote_exclamation_mark
}

movement SsAquaOlivinePortInterior_Movement_ProfOakWalkLeftUp {
    delay_8
    walk_left * 3
    walk_up
    walk_in_place_left
}

movement SsAquaOlivinePortInterior_Movement_PlayerWalkDown1 {
    delay_8 * 3
    walk_down * 3
    walk_in_place_right
}

movement SsAquaOlivinePortInterior_Movement_ProfOakFaceLeft {
    walk_in_place_left
    delay_8 * 2
    walk_in_place_left
}

movement SsAquaOlivinePortInterior_Movement_ProfOakExclamation2 {
    emote_exclamation_mark
}

movement SsAquaOlivinePortInterior_Movement_ProfOakWalkUpLeft {
    walk_up * 2
    walk_left
    walk_up
}

script SsAquaOlivinePortInterior_EventScript_Sailor {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GAME_CLEAR)) {
        npcmsg("Welcome to Fast Ship S.S. Aqua.\r"
               "...Except that the engine-maintenance\n"
               "team is taking some time off, and we\f"
               "don’t know when we can depart...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_TEMP_x4002) >= 1) { goto(_0356) }
    getplayerfacing(VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 0) { goto(_0320) }
    if (var(VAR_SCENE_SS_AQUA) >= 7) { goto(_01FB) }
    npcmsg("Welcome to Fast Ship S.S. Aqua.\n"
           "May I see your S.S. Ticket?\r")
    closemessage
    hasitem(ITEM_S_S__TICKET, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_02F9) }
    applymovement(obj_player, SsAquaOlivinePortInterior_Movement_PlayerFaceDown)
    waitmovement
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} flashed the S.S. Ticket.\r")
    closemessage
    applymovement(obj_P01R0101_seaman_2, SsAquaOlivinePortInterior_Movement_SailorFaceUp)
    waitmovement
    npcmsg("OK, you have a Ticket!\r"
           "We’re departing soon.\n"
           "Get on board quick!\r")
    closemessage
    applymovement(obj_P01R0101_seaman_2, SsAquaOlivinePortInterior_Movement_SailorWalkDownRight)
    waitmovement
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, SsAquaOlivinePortInterior_Movement_PlayerWalkDown2)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    setvar(VAR_TEMP_x4002, 1)
    setvar(VAR_BOAT_DIRECTION, 1)
    setvar(VAR_UNK_40DC, 0)
    clearflag(FLAG_BOAT_ARRIVED)
    setflag(FLAG_UNK_22C)
    setflag(FLAG_UNK_22B)
    releaseall
    end
_01FB:
    getweekday(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 0) { goto(_0218) }
    goto(_02EE)
    goto(_029B)
_0218:
    if (var(VAR_SPECIAL_RESULT) != 1) { goto(_0231) }
    goto(_029B)
    goto(_029B)
_0231:
    if (var(VAR_SPECIAL_RESULT) != 2) { goto(_024A) }
    goto(_02EE)
    goto(_029B)
_024A:
    if (var(VAR_SPECIAL_RESULT) != 3) { goto(_0263) }
    goto(_02EE)
    goto(_029B)
_0263:
    if (var(VAR_SPECIAL_RESULT) != 4) { goto(_027C) }
    goto(_02EE)
    goto(_029B)
_027C:
    if (var(VAR_SPECIAL_RESULT) != 5) { goto(_0295) }
    goto(_029B)
    goto(_029B)
_0295:
    goto(_02EE)
_029B:
    npcmsg("Welcome to the S.S. Aqua!\r"
           "Your Ticket is...right there.\n"
           "Please come through.\r")
    closemessage
    applymovement(obj_P01R0101_seaman_2, SsAquaOlivinePortInterior_Movement_SailorWalkDownRight)
    waitmovement
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, SsAquaOlivinePortInterior_Movement_PlayerWalkDown2)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    setvar(VAR_TEMP_x4002, 1)
    setvar(VAR_BOAT_DIRECTION, 1)
    setvar(VAR_UNK_40DC, 0)
    clearflag(FLAG_BOAT_ARRIVED)
    setflag(FLAG_UNK_22A)
    clearflag(FLAG_UNK_22B)
    setflag(FLAG_UNK_22C)
    releaseall
    end
_02EE:
    npcmsg("Operating a ship every day can wear\n"
           "you out!\f"
           "It’s not running today.\r"
           "It leaves for Vermilion City on Mondays\n"
           "and Fridays!")
    waitbuttonpress
    closemessage
    releaseall
    end
_02F9:
    applymovement(obj_player, SsAquaOlivinePortInterior_Movement_PlayerExclamation)
    waitmovement
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} tried to show the\n"
           "S.S. Ticket...\r"
           "...But no Ticket here!\r")
    closemessage
    applymovement(obj_P01R0101_seaman_2, SsAquaOlivinePortInterior_Movement_SailorFaceUp)
    waitmovement
    npcmsg("I’m sorry...\r"
           "Another person without a Ticket\n"
           "wouldn’t make much of a difference,\f"
           "I think.\r"
           "But a rule is a rule.\n"
           "Sorry, kiddo.")
    waitbuttonpress
    closemessage
    releaseall
    end
_0320:
    applymovement(obj_P01R0101_seaman_2, SsAquaOlivinePortInterior_Movement_SailorWalkUpRight)
    waitmovement
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, SsAquaOlivinePortInterior_Movement_PlayerWalkUp)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    applymovement(obj_P01R0101_seaman_2, SsAquaOlivinePortInterior_Movement_SailorWalkLeftDown)
    waitmovement
    releaseall
    end
_0356:
    npcmsg("What?\n"
           "You already showed me the Ticket.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement SsAquaOlivinePortInterior_Movement_PlayerFaceDown {
    walk_in_place_right
    face_down * 2
}

movement SsAquaOlivinePortInterior_Movement_PlayerExclamation {
    jump_in_place_fast_left
    jump_in_place_fast_right
    face_down * 2
    emote_exclamation_mark
}

movement SsAquaOlivinePortInterior_Movement_SailorWalkDownRight {
    lock_dir
    walk_down
    unlock_dir
    face_left * 2
    lock_dir
    walk_right
    unlock_dir
}

movement SsAquaOlivinePortInterior_Movement_PlayerWalkDown2 {
    walk_down * 2
}

movement SsAquaOlivinePortInterior_Movement_SailorWalkUpRight {
    lock_dir
    walk_up
    unlock_dir
    face_left * 2
    lock_dir
    walk_right
    unlock_dir
}

movement SsAquaOlivinePortInterior_Movement_PlayerWalkUp {
    delay_8
    walk_up * 4
}

movement SsAquaOlivinePortInterior_Movement_SailorWalkLeftDown {
    walk_left
    face_down * 2
    walk_down
    walk_in_place_up
}

movement SsAquaOlivinePortInterior_Movement_SailorFaceUp {
    walk_in_place_up
}

script SsAquaOlivinePortInterior_EventScript_Youngster {
    simplenpcmsg("The S.S. Aqua uses jets to travel.\n"
                 "It skims over water!")
    end
}

script SsAquaOlivinePortInterior_EventScript_AceTrainerF {
    simplenpcmsg("You’ve been to Kanto already?\r"
                 "I hear many rare Pokémon live\n"
                 "over there.\r"
                 "Sounds exciting.\n"
                 "I’d love to visit!")
    end
}

