script SsAquaOlivinePortExterior_OnResume {
    if (var(VAR_BOAT_DIRECTION) == 2) {
        movepersonfacing(obj_P01R0102_seaman_2, 28, 0, 22, DIR_WEST)
        end
    }
    end
}

script SsAquaOlivinePortExterior_OnTransition {
    setspecialspawnwarp(MAP_OLIVINE, 279, 276)
    if (!flag(FLAG_UNK_189)) { goto(_0054) }
    clearflag(FLAG_UNK_189)
    end
_0054:
    checkregisteredphonenumber(PHONE_CONTACT_SABRINA, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_0097) }
    checkbadge(BADGE_MARSH, VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 1) { goto(_0080) }
    goto(_00C1)
_0080:
    getweekday(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) != 5) { goto(_00C1) }
    clearflag(FLAG_UNK_2C9)
    end
_0097:
    getphonebookrematch(PHONE_CONTACT_SABRINA, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 0) { goto(_00C1) }
    getweekday(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) != 1) { goto(_00C1) }
    clearflag(FLAG_UNK_2C9)
    end
_00C1:
    setflag(FLAG_UNK_2C9)
    end
}

script SsAquaOlivinePortExterior_EventScript_SailorScene {
    followmonresetmovement
    lockall
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, SsAquaOlivinePortExterior_Movement_PlayerWalkDown)
    waitmovement
    applymovement(obj_P01R0102_seaman_2, SsAquaOlivinePortExterior_Movement_SailorWalkLeft1)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    setvar(VAR_BOAT_DIRECTION, 0)
    clearflag(FLAG_RECEIVED_PLATE_FROM_AQUA_CAPTAIN_THIS_TRIP)
    releaseall
    end
}

movement SsAquaOlivinePortExterior_Movement_PlayerWalkDown {
    walk_down * 3
}

movement SsAquaOlivinePortExterior_Movement_SailorWalkLeft1 {
    walk_left
    walk_in_place_down
}

script SsAquaOlivinePortExterior_EventScript_Sailor2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("If I manage to come back safely from\n"
           "this journey and take my first steps in\f"
           "Olivine City, will you live there with me?\r"
           "Please! I beg you!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script SsAquaOlivinePortExterior_EventScript_Beauty {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("He’s only a crewman of a\n"
           "pleasure cruise.\f"
           "He has a way of exaggerating things.\r")
    closemessage
    applymovement(obj_P01R0102_gswoman2, SsAquaOlivinePortExterior_Movement_BeautyFaceUp)
    waitmovement
    releaseall
    end
}

movement SsAquaOlivinePortExterior_Movement_BeautyFaceUp {
    walk_in_place_up
}

script SsAquaOlivinePortExterior_EventScript_Sailor1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_BOAT_ARRIVED)) {
        npcmsg("Huh?\n"
               "Doesn’t seem like the ship will be moving\f"
               "anytime soon.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("OK!\n"
           "You must be the last passenger.\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 2) {
        applymovement(obj_P01R0102_seaman_2, SsAquaOlivinePortExterior_Movement_SailorWalkLeft2)
        waitmovement
        applymovement(obj_player, SsAquaOlivinePortExterior_Movement_PlayerWalkLeftUp)
    } elif (var(VAR_TEMP_x4000) == 3) {
        applymovement(obj_P01R0102_seaman_2, SsAquaOlivinePortExterior_Movement_SailorWalkRight1)
        waitmovement
        applymovement(obj_player, SsAquaOlivinePortExterior_Movement_PlayerWalkRightUp)
    } elif (var(VAR_TEMP_x4000) == 0) {
        applymovement(obj_P01R0102_seaman_2, SsAquaOlivinePortExterior_Movement_SailorWalkRight2)
        waitmovement
        applymovement(obj_player, SsAquaOlivinePortExterior_Movement_PlayerWalkUp)
    } else {
        applymovement(obj_P01R0102_seaman_2, SsAquaOlivinePortExterior_Movement_SailorWalkRight2)
        waitmovement
        applymovement(obj_player, SsAquaOlivinePortExterior_Movement_PlayerWalkUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    playse(SEQ_SE_DP_KAIDAN2)
    shipvoyage(0, 0, 307, 24, 19)
    releaseall
    end
}

movement SsAquaOlivinePortExterior_Movement_SailorWalkLeft2 {
    face_left
    walk_left
    walk_in_place_right
}

movement SsAquaOlivinePortExterior_Movement_SailorWalkRight1 {
    face_right
    walk_right
    walk_in_place_left
}

movement SsAquaOlivinePortExterior_Movement_SailorWalkRight2 {
    face_right
    walk_right
    walk_in_place_left
}

movement SsAquaOlivinePortExterior_Movement_PlayerWalkLeftUp {
    walk_left
    face_up
    walk_up * 2
}

movement SsAquaOlivinePortExterior_Movement_PlayerWalkRightUp {
    walk_right
    face_up
    walk_up * 2
}

movement SsAquaOlivinePortExterior_Movement_PlayerWalkUp {
    walk_up * 2
}

script SsAquaOlivinePortExterior_EventScript_Sabrina {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkregisteredphonenumber(PHONE_CONTACT_SABRINA, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) {
        npcmsg("Sabrina: It’s you...\r"
               "How about a picture here\n"
               "against the pleasant sea breeze? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Sabrina: I see...\n"
                   "I thought you’d make a good\f"
                   "picture subject...")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        photoalbumisfull(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Your Photo Album is full.\r"
                   "Access your PC and delete\n"
                   "some pictures.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Sabrina: Are you ready?\r")
        closemessage
        setflag(FLAG_UNK_189)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        cameronphoto(88)
        faceplayer
        lockall
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        clearflag(FLAG_UNK_189)
        npcmsg("Sabrina: I think it looks good.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_TEMP_x4004) >= 1) { goto(_0317) }
    npcmsg("Sabrina: Out of the blue...\n"
           "I get the urge to see the ocean...\r"
           "It may be fun to exchange numbers\n"
           "with you...\r"
           "Do you want mine? {YESNO 0}")
_029F:
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_02C3) }
    if (var(VAR_SPECIAL_RESULT) >= 1) { goto(_0306) }
    end
_02C3:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} registered Sabrina\n"
           "in the Pokégear!")
    playfanfare(SEQ_ME_POKEGEAR_REGIST)
    waitfanfare
    registergearnumber(PHONE_CONTACT_SABRINA)
    npcmsg("Sabrina: I think I can keep my promises\n"
           "if you call me on Sundays around noon.")
    waitbuttonpress
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setflag(FLAG_UNK_2C9)
    removeobject(obj_P01R0102_gsleader10)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
_0306:
    setvar(VAR_TEMP_x4004, 1)
    npcmsg("Sabrina: I see...\n"
           "I thought you’d make a good friend.")
    waitbuttonpress
    closemessage
    releaseall
    end
_0317:
    npcmsg("Sabrina: Now you want to know\n"
           "my number?\f"
           "I can see it in your eyes... {YESNO 0}")
    goto(_029F)
    end
}

