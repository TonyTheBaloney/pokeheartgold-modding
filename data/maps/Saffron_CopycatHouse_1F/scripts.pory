script Saffron_CopycatHouse_1F_EventScript_PokefanF {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_RESTORED_POWER)) {
        npcmsg("She recently lost the Poké Doll that\n"
               "a boy gave her three years ago.\r"
               "Ever since then, she’s gotten even\n"
               "better at mimicry...")
