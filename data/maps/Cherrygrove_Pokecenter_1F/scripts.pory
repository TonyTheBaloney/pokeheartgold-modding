    simplenpcmsg("Welcome to the Pokémon\n"
                 "Communication Club Colosseum.\r"
                 "...Oh, I was just trying to learn that\n"
                 "line by heart.\r"
                 "It’ll take a little longer before\n"
                 "we open the Colosseum.")
    end
}

script Cherrygrove_Pokecenter_1F_EventScript_Woman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ELMS_LAB) >= 3) {
        npcmsg("The Communication Center upstairs\n"
               "was just built.\r"
               "I traded Pokémon there already!")
    } else {
        npcmsg("The Communication Center upstairs\n"
               "was just built.\r"
               "But they’re still finishing it up.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

