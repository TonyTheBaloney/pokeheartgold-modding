        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        playfanfare(SEQ_ME_ASA)
        waitfanfare
        healparty
        leaveoverworld
        restoreoverworld
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        return
    }
    setvar(VAR_UNK_40FE, 4)
    applymovement(obj_D45R0102_sakaki, TohjoFalls_HiddenRoom_Movement_GiovanniWalkUpRight)
    waitmovement
    npcmsg("Giovanni: How is this possible...?\r"
           "The past three years have been\n"
           "a waste...?\r"
           "How can a kid like you manage to\n"
           "destroy my dream once again?\r"
           "The precious dream of Team Rocket has\n"
           "become little more than an illusion...\r")
    closemessage
    applymovement(obj_D45R0102_sakaki, TohjoFalls_HiddenRoom_Movement_GiovanniWalkDownLeft)
    waitmovement
    removeobject(obj_D45R0102_sakaki)
    setflag(FLAG_HIDE_TOHJO_FALLS_GIOVANNI)
    applymovement(obj_player, TohjoFalls_HiddenRoom_Movement_PlayerWalkDown)
    applymovement(obj_D45R0102_var_1, TohjoFalls_HiddenRoom_Movement_PlayerWalkDown)
    waitmovement
    fadeoutbgm(0, 30)
    stopbgm(0)
    playse(SEQ_SE_PL_FR03)
    npcmsg("...\n"
           "...Hey!\f"
           "Where has Giovanni gone?\f"
           "I wonder if he is listening to\f"
           "our broadcast...\f"
           "...\r")
    stopse(SEQ_SE_PL_FR03)
    closemessage
    applymovement(obj_D45R0102_var_1, TohjoFalls_HiddenRoom_Movement_FriendWalkDown)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("Lyra: They keep calling for their boss.\n"
                 "I feel sorry they don’t know he’s\f"
                 "not coming.\r"
                 "After this, {STRVAR_1 3, 0, 0}, you will\n"
                 "defeat them!\r"
                 "...Wait a second!\r"
                 "{STRVAR_1 3, 0, 0}, you’re still here.\n"
                 "Then, who will defeat Team Rocket...?\r", "Ethan: They keep calling for their boss.\n"
                                                            "I feel sorry they don’t know he’s\f"
                                                            "not coming.\r"
                                                            "After this, {STRVAR_1 3, 0, 0}, you will\n"
                                                            "defeat them!\r"
                                                            "...Wait a second!\r"
                                                            "{STRVAR_1 3, 0, 0}, you’re still here.\n"
                                                            "Then, who will defeat Team Rocket...?\r")
    closemessage
    getpartyleadalive(VAR_TEMP_x4002)
    getpartymonspecies(VAR_TEMP_x4002, VAR_SPECIAL_RESULT)
    compare(VAR_SPECIAL_RESULT, 251)
    callifne(_02C0)
    applymovement(obj_partner_poke, TohjoFalls_HiddenRoom_Movement_FollowMonFaceDown)
    waitmovement
    playse(SEQ_SE_GS_SUZUSYUTUGEN_HO)
    fadescreen(6, 6, 0, RGB_WHITE)
    waitfade
    wait(15, VAR_SPECIAL_RESULT)
    fadescreen(6, 6, 1, RGB_WHITE)
    waitfade
    applymovement(obj_player, TohjoFalls_HiddenRoom_Movement_FriendExclamation)
    waitmovement
    applymovement(obj_D45R0102_var_1, TohjoFalls_HiddenRoom_Movement_FriendFaceRight1)
    waitmovement
    if (var(VAR_TEMP_x4003) == 1) {
        gendermsgbox("{COLOR 1}Time Travel{COLOR 0}......!\r"
                     "This is it! Please take us to our time!\r", "{COLOR 1}Time Travel{COLOR 0}......!\r"
                                                                  "This is it! Please take us to our time!\r")
        closemessage
    } else {
        gendermsgbox("Not again...!\n"
                     "I’ve had enough!\f"
                     "Please let me go back to my time!\r", "Not again...!\n"
                                                            "I’ve had enough!\f"
                                                            "Please let me go back to my time!\r")
