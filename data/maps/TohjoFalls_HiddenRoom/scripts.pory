    }
    playse(SEQ_SE_GS_TIMESLIP)
    celebitimetravel
    clearflag(FLAG_HIDE_ILEX_FOREST_FRIEND)
    warp(MAP_ILEX_FOREST, 0, 16, 57, DIR_SOUTH)
    fadescreen(6, 15, 1, RGB_WHITE)
    waitfade
    releaseall
    end
}

movement TohjoFalls_HiddenRoom_Movement_FriendWalkRight {
    walk_in_place_right
    emote_exclamation_mark
    delay_8
    walk_fast_right
    walk_in_place_up
}

movement TohjoFalls_HiddenRoom_Movement_GiovanniExclamation {
    emote_exclamation_mark
    delay_8
    walk_in_place_down
}

movement TohjoFalls_HiddenRoom_Movement_GiovanniWalkDown {
    walk_down
}

movement TohjoFalls_HiddenRoom_Movement_0334 {
    walk_in_place_down
}

movement TohjoFalls_HiddenRoom_Movement_GiovanniWalkUpRight {
    lock_dir
    walk_slow_up
    unlock_dir
    walk_slow_right * 2
}

movement TohjoFalls_HiddenRoom_Movement_GiovanniWalkDownLeft {
    walk_down * 4
    walk_left * 2
    walk_down * 2
}

movement TohjoFalls_HiddenRoom_Movement_GiovanniWalkRightDown {
    walk_slow_right * 2
    walk_slow_down * 3
    walk_slow_left * 2
    walk_slow_down * 2
}

movement TohjoFalls_HiddenRoom_Movement_PlayerWalkUp {
    walk_in_place_up
    walk_up
}

movement TohjoFalls_HiddenRoom_Movement_PlayerWalkDown {
    delay_8 * 3
    walk_down
}

movement TohjoFalls_HiddenRoom_Movement_FriendExclamation {
    emote_exclamation_mark
    delay_8
}

movement TohjoFalls_HiddenRoom_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
}

movement TohjoFalls_HiddenRoom_Movement_FollowMonFaceDown {
    jump_in_place_fast_down
}

movement TohjoFalls_HiddenRoom_Movement_FriendFaceUp {
    walk_in_place_up
}

movement TohjoFalls_HiddenRoom_Movement_FriendWalkUp {
    walk_up
    walk_in_place_right
}

movement TohjoFalls_HiddenRoom_Movement_FriendFaceRight1 {
    walk_in_place_left
    delay_8
    walk_in_place_right
    delay_8
}

movement TohjoFalls_HiddenRoom_Movement_FriendWalkDown {
    walk_down
}

movement TohjoFalls_HiddenRoom_Movement_FriendFaceRight2 {
    walk_in_place_fast_right * 4
}

script TohjoFalls_HiddenRoom_EventScript_Radio {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_40FE) >= 4) {
        npcmsg("You cannot turn on the radio.\n"
               "Giovanni must have left it here...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("There is a radio that no longer works...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

mapscripts TohjoFalls_HiddenRoom_MapScripts {
    INIT_SCRIPT_ON_RESUME: TohjoFalls_HiddenRoom_OnResume
    INIT_SCRIPT_ON_LOAD: TohjoFalls_HiddenRoom_OnLoad
    INIT_SCRIPT_ON_FRAME_TABLE [
        VAR_UNK_40FE, 2: TohjoFalls_HiddenRoom_EventScript_LyraScene
    ]
}
