}

script scr_seq_D45R0102_003 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_40FE) >= 4) {
        npcmsg("You cannot turn on the radio.\n"
               "Giovanni must have left it here...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("There is a radio that no longer works...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

