script TohjoFalls_HiddenRoom_EventScript_LyraScene {
    followmonresetmovement
    lockall
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, TohjoFalls_HiddenRoom_Movement_PlayerWalkUp)
