           "front of me three years ago...\f"
           "You have the same eyes...\r"
           "...\r"
           "I’m on my way to Goldenrod City to\n"
           "answer the call and join my team.\f"
           "Are you going to get in my way?\r")
    closemessage
    applymovement(obj_D45R0102_var_1, TohjoFalls_HiddenRoom_Movement_FriendWalkUp)
    waitmovement
    gendermsgbox("Lyra: Three years ago...?\n"
                 "Goldenrod City...?\r", "Ethan: Three years ago...?\n"
                                         "Goldenrod City...?\r")
    closemessage
    applymovement(obj_D45R0102_var_1, TohjoFalls_HiddenRoom_Movement_FriendExclamation)
    waitmovement
    gendermsgbox("Could this be the one that the radio\n"
                 "was trying to reach?\f"
                 "Giovanni, their boss?\r", "Could this be the one that the radio\n"
                                            "was trying to reach?\f"
                                            "Giovanni, their boss?\r")
    closemessage
    applymovement(obj_D45R0102_var_1, TohjoFalls_HiddenRoom_Movement_FriendFaceRight2)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("Do you hear it, {STRVAR_1 3, 0, 0}?\n"
                 "The radio is saying something strange!\r"
                 "Team Rocket has occupied the Radio\n"
                 "Tower at Goldenrod City!\r"
                 "It can’t be! {STRVAR_1 3, 0, 0}, you solved\n"
                 "this case already!\r", "Do you hear it, {STRVAR_1 3, 0, 0}?\n"
                                         "The radio is saying something strange!\r"
                                         "Team Rocket has occupied the Radio\n"
                                         "Tower at Goldenrod City!\r"
                                         "It can’t be! {STRVAR_1 3, 0, 0}, you solved\n"
                                         "this case already!\r")
    closemessage
    stopbgm(0)
    playse(SEQ_SE_PL_FR03)
    playbgm(SEQ_GS_SENKYO)
    npcmsg("...\n"
           "This is the Radio Tower.\f"
           "This is the Radio Tower.\f"
           "We are pleased to declare\f"
           "Team Rocket’s revival.\f"
           "...Giovanni?\f"
           "...Can you hear us?\f"
           "We have finally made it!\f"
           "...\r")
    stopse(SEQ_SE_PL_FR03)
    closemessage
    applymovement(obj_D45R0102_sakaki, TohjoFalls_HiddenRoom_Movement_GiovanniWalkDown)
    waitmovement
    npcmsg("My old associates need me...\r"
           "We will not repeat the failure of three\n"
           "years ago!\r"
           "{COLOR 1}Team Rocket{COLOR 0} will be born again, and I\n"
           "will rule the world!\r")
    closemessage
    setvar(VAR_UNK_40FE, 3)
    trainerbattle(TRAINER_ROCKET_BOSS_GIOVANNI, 0, 1, 0)
