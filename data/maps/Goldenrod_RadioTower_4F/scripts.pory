script scr_seq_D23R0104_006 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 4) {
        npcmsg("Ben: Team Rocket... There is something\n"
               "they lack. It is music!\r"
               "Music enriches people’s heart and soul.\r"
               "Music lovers would never do such\n"
               "horrible things at a place like the\f"
               "Radio Tower!")
    } else {
        npcmsg("Ben: Do you listen to our music?")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_D23R0104_007 {
    if (defeated(TRAINER_TEAM_ROCKET_F_GRUNT_4)) {
        simplenpcmsg(msg_0068_D23R0104_00014)
        end
    }
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("Proton, the leader of this Radio Tower\n"
           "mission... He is so cool.\r")
    getplayerfacing(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 2) {
        applymovement(obj_D23R0104_rocketw, Goldenrod_RadioTower_4F_Movement_0210)
    } else {
        applymovement(obj_D23R0104_rocketw, Goldenrod_RadioTower_4F_Movement_021C)
    }
    waitmovement
    npcmsg("Who are you?\r"
           "If you are in the way of Proton...\n"
           "I mean Team Rocket. I won’t allow that!\r")
    closemessage
    trainerbattle(TRAINER_TEAM_ROCKET_F_GRUNT_4, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    settrainerflag(TRAINER_TEAM_ROCKET_F_GRUNT_4)
    npcmsg(msg_0068_D23R0104_00014)
    waitbuttonpress
    closemessage
    releaseall
    end
}

