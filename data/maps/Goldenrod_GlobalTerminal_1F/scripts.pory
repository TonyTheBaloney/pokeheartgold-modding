script scr_seq_T25R1201_013 {
    simplenpcmsg("There are several portal machines here\n"
                 "at the Global Terminal.\r"
                 "You must set your Vs. Recorder in\n"
                 "the machines for communication.\r"
                 "Please do give the machines a try, as\n"
                 "they guide you through the operation.")
    end
}

script scr_seq_T25R1201_014 {
    simplenpcmsg("Welcome to the Global Terminal!\r"
                 "Here, you may join the huge community\n"
                 "of Trainers worldwide.\r"
                 "You may view the records of Trainers\n"
                 "like yourself from around the world.\r"
                 "You may also trade Pokémon with the\n"
                 "world’s Trainers.")
    end
}

