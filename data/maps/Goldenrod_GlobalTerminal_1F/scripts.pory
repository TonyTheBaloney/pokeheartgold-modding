script scr_seq_T25R1201_003 {
    simplenpcmsg("Such a small world it is, eh?\r"
                 "Eh? Wait, this is a miniature?\n"
                 "The real Earth is millions of times bigger\f"
                 "than this?\r"
                 "Whoaaaaaaa!")
    end
}

script scr_seq_T25R1201_004 {
    simplenpcmsg("They say if you communicate with\n"
                 "someone, their location is\f"
                 "recorded on this giant globe.")
    end
}

script scr_seq_T25R1201_005 {
    simplenpcmsg("All I need to do is leave a Pokémon\n"
                 "here to trade.\r"
                 "Who knows, it might be traded while\n"
                 "I’m asleep tonight.")
    end
}

script scr_seq_T25R1201_006 {
    simplenpcmsg("Using the equipment here, you can easily\n"
                 "trade Pokémon with other Pokémon fans\f"
                 "on the other side of the world!\r"
                 "That’s incredible!")
    end
}

script scr_seq_T25R1201_007 {
    simplenpcmsg("You can register where you live on\n"
                 "this giant globe.\r"
                 "Once you do, you can show your location\n"
                 "to anyone you communicate with.")
    end
}

script scr_seq_T25R1201_008 {
    simplenpcmsg("Nintendo WFC is so easy to use,\n"
                 "even I can trade Pokémon now!")
    end
}

script scr_seq_T25R1201_009 {
    simplenpcmsg("This week, I’ll do it!\r"
                 "I really want to make the Top 4 of the\n"
                 "rankings.")
    end
}

script scr_seq_T25R1201_010 {
    simplenpcmsg("The Global Terminal has three floors.\r"
                 "You use warp panels for getting from\n"
                 "one floor to another.\r"
                 "A blue panel takes you to the GTS on\n"
                 "the ground floor.\r"
                 "Take a green panel to the studios for\n"
                 "Box Data and Dress-Up Data on 2F.\r"
                 "Take a pink warp panel to the third\n"
                 "floor for the Battle Video Gallery.")
    end
}

