script Viridian_Forest_OnTransition {
    checkregisteredphonenumber(PHONE_CONTACT_BUGSY, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_0047) }
    if (flag(FLAG_GAME_CLEAR)) {
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) != 4) { goto(_0047) }
        clearflag(FLAG_UNK_263)
        end
    _0047:
        setflag(FLAG_UNK_263)
        end
    }
    goto(_0047)
    end
}

script Viridian_Forest_EventScript_Bugsy {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_TEMP_x4002) >= 1) {
        npcmsg("Bugsy: Will you give me your phone\n"
               "number? {YESNO 0}")
        goto(_0065)
        end
    }
    npcmsg("Bugsy: I came to Kanto to look for\n"
           "Bug-type Pokémon, so I can become\f"
           "a stronger Bug-type Pokémon Trainer!\r"
           "Hey, why don’t we swap phone\n"
           "numbers? {YESNO 0}")
_0065:
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0089) }
    if (var(VAR_SPECIAL_RESULT) >= 1) { goto(_00CC) }
    end
_0089:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} registered Bugsy\n"
           "in the Pokégear!")
    playfanfare(SEQ_ME_POKEGEAR_REGIST)
    waitfanfare
    registergearnumber(PHONE_CONTACT_BUGSY)
    npcmsg("Bugsy: We can battle around lunch\n"
           "on Thursdays!\f"
           "Give me a call!")
    waitbuttonpress
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setflag(FLAG_UNK_263)
    removeobject(obj_D46R0101_gsleader2)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
_00CC:
    setvar(VAR_TEMP_x4002, 1)
    npcmsg("Bugsy: Oh, well...\n"
           "That’s OK...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

mapscripts Viridian_Forest_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Viridian_Forest_OnTransition
}
