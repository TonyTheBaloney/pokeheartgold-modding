    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_MEOWTH, 0)
    npcmsg("MEOWTH: Meow!")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

