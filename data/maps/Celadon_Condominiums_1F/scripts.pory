script Celadon_Condominiums_1F_EventScript_OldWoman {
    simplenpcmsg("Do you need anything?\n"
                 "I am the manager of the condominiums.\r"
                 "It’s pretty safe around here, so I\n"
                 "don’t have much to do.\r"
                 "I like to take my Pokémon out to\n"
                 "occupy myself.\r"
                 "...By the way, we have two\n"
                 "elevators here.\f"
                 "Don’t get confused.")
    end
}

