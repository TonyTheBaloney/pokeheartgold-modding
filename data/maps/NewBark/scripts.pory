    } elif (var(VAR_TEMP_x4001) == 401) {
        applymovement(obj_T20_gswoman1, NewBark_Movement_WomanWalkLeftDown2)
    } elif (var(VAR_TEMP_x4001) == 402) {
        applymovement(obj_T20_gswoman1, NewBark_Movement_WomanWalkLeftDown3)
    }
    waitmovement
    npcmsg("What do you think you’re doing?\r")
    closemessage
    if (var(VAR_TEMP_x4001) == 396) {
        applymovement(obj_T20_gswoman1, NewBark_Movement_WomanWalkRightDown1)
        applymovement(obj_player, NewBark_Movement_PlayerWalkRightDown1)
    } elif (var(VAR_TEMP_x4001) == 397) {
        applymovement(obj_T20_gswoman1, NewBark_Movement_WomanWalkRightDown2)
        applymovement(obj_player, NewBark_Movement_PlayerWalkRightDown2)
    } elif (var(VAR_TEMP_x4001) == 398) {
        applymovement(obj_T20_gswoman1, NewBark_Movement_WomanWalkRightDown3)
