script scr_seq_T20_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_NEW_BARK_TOWN_OW) == 0) {
        npcmsg("I like your Bag!")
    } elif (var(VAR_SCENE_NEW_BARK_TOWN_OW) == 1) {
        npcmsg(msg_0542_T20_00005)
    } elif (var(VAR_SCENE_NEW_BARK_TOWN_OW) == 2) {
        npcmsg(msg_0542_T20_00005)
    } elif (var(VAR_SCENE_NEW_BARK_WEST_EXIT) == 1) {
        npcmsg("Wow, your Pokégear is impressive!")
    } else {
        bufferplayersname(0)
        gendermsgbox("Hi, {STRVAR_1 3, 0, 0}!\n"
                     "Leaving again?\r"
                     "You should tell your mom if you\n"
                     "are leaving.", "Hi, {STRVAR_1 3, 0, 0}!\n"
                                     "Leaving again?\r"
                                     "You should tell your mom if you\n"
                                     "are leaving.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

text msg_0542_T20_00005 {
    "Oh! Your Pokémon is adorable!\n"
    "I wish I had one!"
}

