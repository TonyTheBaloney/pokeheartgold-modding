    walk_in_place_left
}

movement NewBark_Movement_LyraFaceLeft6 {
    walk_in_place_left
}

script NewBark_EventScript_Lyra {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    gendermsgbox("Lyra: I wonder what a Kimono Girl\n"
                 "wants from you...", "Ethan: I wonder what a Kimono Girl\n"
                                      "wants from you...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script NewBark_EventScript_Marill {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_MARILL, 0)
    npcmsg("MARILL: Murfu.\r")
    waitcry
    closemessage
    applymovement(obj_T20_tsure_poke_static_marill_2, NewBark_Movement_MarillFaceRight)
    waitmovement
    applymovement(obj_T20_var_1_2, NewBark_Movement_LyraFaceLeft7)
    waitmovement
    gendermsgbox("Lyra: Hmm... My Pokémon may be\n"
                 "putting on some weight lately...", "Ethan: Hmm... My Pokémon may be\n"
                                                     "putting on some weight lately...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement NewBark_Movement_MarillFaceRight {
    jump_in_place_slow_right
    jump_in_place_slow_right
}

movement NewBark_Movement_LyraFaceLeft7 {
    walk_in_place_left
}

script NewBark_EventScript_TrainerTips2 {
    trainertipsex(2, "Elm Pokémon Lab")
    end
}

script NewBark_EventScript_TownSign {
    directionsignpostex(0, 11, "New Bark Town\n"
                               "Winds of a New Beginning")
    end
}

script NewBark_EventScript_FatMan {
    bufferplayersname(0)
    simplenpcmsg("Yo, {STRVAR_1 3, 0, 0}!\r"
                 "I hear Professor Elm discovered some\n"
                 "new Pokémon.")
    end
}

mapscripts NewBark_MapScripts {
    INIT_SCRIPT_ON_FRAME_TABLE [
        VAR_SCENE_PLAYERS_HOUSE_1F, 1: NewBark_EventScript_MarillScene
        VAR_SCENE_NEW_BARK_TOWN_OW, 1: NewBark_EventScript_LyraScene
    ]
    INIT_SCRIPT_ON_TRANSITION: NewBark_OnTransition
    INIT_SCRIPT_ON_RESUME: NewBark_OnResume
}
