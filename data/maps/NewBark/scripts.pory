    releaseall
    end
_054E:
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 396) {
        applymovement(obj_player, NewBark_Movement_PlayerFaceDown1)
