movement NewBark_Movement_FollowMonWalkDown1 {
    lock_dir
    walk_slightly_fast_down * 4
    unlock_dir
}

movement NewBark_Movement_FollowMonWalkDown2 {
    lock_dir
    walk_slightly_fast_down * 6
    unlock_dir
}

movement NewBark_Movement_RivalFaceUp {
    walk_in_place_up
}

movement NewBark_Movement_RivalFaceDown {
    walk_in_place_down
}

movement NewBark_Movement_RivalFaceLeft {
    walk_in_place_left
}

movement NewBark_Movement_025C {
    walk_in_place_right
}

movement NewBark_Movement_RivalWalkLeftDown {
    walk_slightly_fast_left
    face_down
    walk_slightly_fast_down * 2
}

movement NewBark_Movement_RivalWalkUpRight {
    face_up
    walk_up * 2
    face_right
    walk_right
}

movement NewBark_Movement_PlayerWalkDown {
    face_up
    lock_dir
    walk_slightly_fast_down * 2
    jump_far_down
    unlock_dir
}

movement NewBark_Movement_RivalWalkUpLeft {
    walk_slightly_fast_up
    face_left
    walk_slightly_fast_left
    face_down
    walk_slightly_fast_down * 3
}

movement NewBark_Movement_PlayerWalkLeftDown {
    face_right
    lock_dir
    walk_slightly_fast_left
    unlock_dir
    face_up
    lock_dir
    walk_slightly_fast_down * 3
    jump_far_down
    unlock_dir
}

script NewBark_EventScript_Woman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_NEW_BARK_TOWN_OW) == 0) {
        npcmsg("I like your Bag!")
    } elif (var(VAR_SCENE_NEW_BARK_TOWN_OW) == 1) {
        npcmsg(msg_0542_T20_00005)
    } elif (var(VAR_SCENE_NEW_BARK_TOWN_OW) == 2) {
        npcmsg(msg_0542_T20_00005)
    } elif (var(VAR_SCENE_NEW_BARK_WEST_EXIT) == 1) {
        npcmsg("Wow, your Pokégear is impressive!")
    } else {
        bufferplayersname(0)
        gendermsgbox("Hi, {STRVAR_1 3, 0, 0}!\n"
                     "Leaving again?\r"
                     "You should tell your mom if you\n"
                     "are leaving.", "Hi, {STRVAR_1 3, 0, 0}!\n"
                                     "Leaving again?\r"
                                     "You should tell your mom if you\n"
                                     "are leaving.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

text msg_0542_T20_00005 {
    "Oh! Your Pokémon is adorable!\n"
    "I wish I had one!"
}

script NewBark_EventScript_ProfElmTrigger {
    followmonresetmovement
    lockall
    if (flag(FLAG_GOT_POKEGEAR)) {
        dooranimationload(21, 12, 12, 9, 77)
        dooranimationopen(77)
        dooranimationwait(77)
        addobject(obj_T20_doctor)
        movepersonfacing(obj_T20_doctor, 684, 0, 393, DIR_SOUTH)
        applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkDown)
        waitmovement
        dooranimationclose(77)
        dooranimationwait(77)
        dooranimationunload(77)
        npcmsg("Professor Elm: Wait one second!\r")
        closemessage
        applymovement(obj_player, NewBark_Movement_PlayerExclamation)
        waitmovement
        getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) == 396) {
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkDownLeft1)
            applymovement(obj_player, NewBark_Movement_PlayerFaceDown2)
        } elif (var(VAR_TEMP_x4001) == 397) {
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkDownLeft2)
            applymovement(obj_player, NewBark_Movement_PlayerFaceUp3)
        } elif (var(VAR_TEMP_x4001) == 398) {
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkDownLeft3)
            applymovement(obj_player, NewBark_Movement_PlayerFaceUp3)
        } elif (var(VAR_TEMP_x4001) == 399) {
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkDownLeft4)
            applymovement(obj_player, NewBark_Movement_PlayerFaceUp3)
        } elif (var(VAR_TEMP_x4001) == 400) {
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkDownLeft5)
            applymovement(obj_player, NewBark_Movement_PlayerFaceUp3)
        } elif (var(VAR_TEMP_x4001) == 401) {
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkDownLeft6)
            applymovement(obj_player, NewBark_Movement_PlayerFaceUp2)
        } elif (var(VAR_TEMP_x4001) == 402) {
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkDownLeft7)
            applymovement(obj_player, NewBark_Movement_PlayerFaceUp2)
        }
        waitmovement
        npcmsg("I almost completely forgot\n"
               "about this...\f"
               "Here, I’ll give you my number.\r")
        registergearnumber(PHONE_CONTACT_PROF__ELM)
        bufferplayersname(0)
        npcmsg("{STRVAR_1 3, 0, 0} registered Professor Elm\n"
               "in the Pokégear!")
        playfanfare(SEQ_ME_POKEGEAR_REGIST)
        waitfanfare
        npcmsg("Professor Elm: I’ll call you if\n"
               "anything comes up.\r")
        closemessage
        getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) == 396) {
            applymovement(obj_player, NewBark_Movement_PlayerFaceRight)
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkRightUp1)
        } elif (var(VAR_TEMP_x4001) == 397) {
            applymovement(obj_player, NewBark_Movement_PlayerFaceRight)
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkRightUp2)
        } elif (var(VAR_TEMP_x4001) == 398) {
            applymovement(obj_player, NewBark_Movement_PlayerFaceUp2)
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkUpRight1)
        } elif (var(VAR_TEMP_x4001) == 399) {
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkUpRight2)
        } elif (var(VAR_TEMP_x4001) == 400) {
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkUpRight3)
        } elif (var(VAR_TEMP_x4001) == 401) {
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkUpRight4)
        } elif (var(VAR_TEMP_x4001) == 402) {
            applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkUpRight5)
        }
        waitmovement
        dooranimationload(21, 12, 12, 9, 77)
        dooranimationopen(77)
        dooranimationwait(77)
        applymovement(obj_T20_doctor, NewBark_Movement_ProfElmWalkUp)
        waitmovement
        removeobject(obj_T20_doctor)
        dooranimationclose(77)
        dooranimationwait(77)
        dooranimationunload(77)
        setvar(VAR_SCENE_NEW_BARK_WEST_EXIT, 1)
        releaseall
        end
    }
    applymovement(obj_T20_gswoman1, NewBark_Movement_WomanExclamation)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("Wait, {STRVAR_1 3, 0, 0}!", "Wait, {STRVAR_1 3, 0, 0}!")
    wait(20, VAR_SPECIAL_RESULT)
    closemessage
    applymovement(obj_player, NewBark_Movement_PlayerFaceRight)
    waitmovement
    if (var(VAR_SCENE_NEW_BARK_TOWN_OW) == 2) { goto(_054E) }
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 396) {
        applymovement(obj_T20_gswoman1, NewBark_Movement_WomanWalkLeftUp1)
    } elif (var(VAR_TEMP_x4001) == 397) {
        applymovement(obj_T20_gswoman1, NewBark_Movement_WomanWalkLeftUp2)
    } elif (var(VAR_TEMP_x4001) == 398) {
        applymovement(obj_T20_gswoman1, NewBark_Movement_WomanWalkLeftUp3)
    } elif (var(VAR_TEMP_x4001) == 399) {
        applymovement(obj_T20_gswoman1, NewBark_Movement_WomanWalkLeft1)
    } elif (var(VAR_TEMP_x4001) == 400) {
