    } elif (var(VAR_TEMP_x4001) == 401) {
        applymovement(obj_T20_gswoman1, NewBark_Movement_WomanWalkUpRight1)
        applymovement(obj_player, NewBark_Movement_PlayerWalkRightUp2)
    } elif (var(VAR_TEMP_x4001) == 402) {
        applymovement(obj_T20_gswoman1, NewBark_Movement_WomanWalkUpRight2)
        applymovement(obj_player, NewBark_Movement_PlayerWalkRightUp3)
    }
    waitmovement
    npcmsg("It’s dangerous to go out without\n"
           "a Pokémon!\r"
           "Wild Pokémon jump out of the grass\n"
           "on the way to the next town.")
    waitbuttonpress
