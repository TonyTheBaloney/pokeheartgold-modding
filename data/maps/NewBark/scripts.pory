script NewBark_EventScript_MomTrigger {
    followmonresetmovement
    lockall
    if (var(VAR_TEMP_x4007) == 2) {
        npcmsg("I’m getting upset!\r")
        closemessage
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(55)
        applymovement(obj_player, NewBark_Movement_PlayerWalkLeft4)
        waitmovement
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
        releaseall
        end
    }
    dooranimationload(21, 12, 23, 12, 77)
    dooranimationopen(77)
    dooranimationwait(77)
    playse(SEQ_SE_DP_KAIDAN2)
    clearflag(FLAG_HIDE_NEW_BARK_MOM)
    addobject(obj_T20_gsmama)
    waitse(SEQ_SE_DP_KAIDAN2)
    applymovement(obj_T20_gsmama, NewBark_Movement_MomWalkDown1)
    waitmovement
    if (var(VAR_TEMP_x4007) == 0) {
        bufferplayersname(0)
        npcmsg("{STRVAR_1 1, 0, 0}! Where are you going?\r")
        closemessage
    }
    dooranimationclose(77)
    dooranimationwait(77)
    dooranimationunload(77)
    getplayercoords(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    if (var(VAR_SPECIAL_x8005) == 398) {
        applymovement(obj_T20_gsmama, NewBark_Movement_MomWalkDown2)
        applymovement(obj_player, NewBark_Movement_PlayerWalkLeft1)
    } elif (var(VAR_SPECIAL_x8005) == 399) {
        applymovement(obj_T20_gsmama, NewBark_Movement_MomWalkDown3)
        applymovement(obj_player, NewBark_Movement_PlayerWalkLeft2)
    } elif (var(VAR_SPECIAL_x8005) == 400) {
        applymovement(obj_T20_gsmama, NewBark_Movement_MomWalkDown4)
        applymovement(obj_player, NewBark_Movement_PlayerWalkLeft3)
    } elif (var(VAR_SPECIAL_x8005) == 401) {
        applymovement(obj_T20_gsmama, NewBark_Movement_MomWalkDown4)
        applymovement(obj_player, NewBark_Movement_PlayerWalkLeftUp1)
    } else {
        applymovement(obj_T20_gsmama, NewBark_Movement_MomWalkDown4)
        applymovement(obj_player, NewBark_Movement_PlayerWalkLeftUp2)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    if (var(VAR_TEMP_x4007) == 0) {
        npcmsg("Professor Elm has been waiting for you.\f"
               "He said he has something to give you.\r")
    } else {
        npcmsg("Did you not hear me saying that\n"
               "Professor Elm is waiting for you?\r")
    }
    closemessage
    if (var(VAR_SPECIAL_x8005) == 398) {
        applymovement(obj_T20_gsmama, NewBark_Movement_MomWalkUp1)
        waitmovement
    } elif (var(VAR_SPECIAL_x8005) == 399) {
        applymovement(obj_T20_gsmama, NewBark_Movement_MomWalkUp2)
        waitmovement
    } else {
        applymovement(obj_T20_gsmama, NewBark_Movement_MomWalkUp3)
        waitmovement
    }
    dooranimationload(21, 12, 23, 12, 77)
    dooranimationopen(77)
    dooranimationwait(77)
    applymovement(obj_T20_gsmama, NewBark_Movement_MomWalkUp4)
    waitmovement
    setflag(FLAG_HIDE_NEW_BARK_MOM)
    playse(SEQ_SE_DP_KAIDAN2)
    removeobject(obj_T20_gsmama)
    waitse(SEQ_SE_DP_KAIDAN2)
    dooranimationclose(77)
    dooranimationwait(77)
    dooranimationunload(77)
    addvar(VAR_TEMP_x4007, 1)
    releaseall
    end
}

