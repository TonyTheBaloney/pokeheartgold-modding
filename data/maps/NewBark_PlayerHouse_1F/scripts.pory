script scr_seq_T20R0201_001 {
    if (flag(FLAG_GAME_CLEAR)) {
        hasitem(ITEM_S_S__TICKET, 1, VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            simplenpcmsg("Professor Elm told me that\n"
                         "he has something to give you.\f"
                         "Why don’t you visit his lab?")
            end
        _0205:
            playse(SEQ_SE_DP_SELECT)
            lockall
            faceplayer
            if (flag(FLAG_TALKED_TO_MOM_AFTER_NAMING_RIVAL)) {
                npcmsg("Hi! Welcome home!\n"
                       "You’re doing fine, I see.\r"
                       "I’ve kept your room tidy and clean.\n"
                       "Or...\f"
                       "Is this about your money? {YESNO 0}")
                showsavingsbox(1, 1)
                touchscreenmenuhide
                menuinit(1, 1, 0, 1, VAR_SPECIAL_RESULT)
                menuitemadd(29, 255, 0)
                menuitemadd(30, 255, 1)
                menuitemadd(31, 255, 2)
                menuitemadd(32, 255, 3)
                menuexec
                Switch(VAR_SPECIAL_RESULT)
                Case(0, _02DF)
                Case(1, _0335)
                Case(2, _0398)
                goto(_03D1)
                end
            _02DF:
                bankorwalletisfull(1, VAR_SPECIAL_RESULT)
                if (var(VAR_SPECIAL_RESULT) == 1) {
                    touchscreenmenushow
                    hidesavingsbox
                    npcmsg("You have so much money already.\n"
                           "I can’t let you have any more.")
                    waitbuttonpress
                    closemessage
                    releaseall
                    end
                }
                checkbankbalance(VAR_SPECIAL_RESULT, 1)
                if (var(VAR_SPECIAL_RESULT) == 0) { goto(_041C) }
                banktransaction(1, VAR_SPECIAL_RESULT)
                hidesavingsbox
                touchscreenmenushow
                Switch(VAR_SPECIAL_RESULT)
                Case(0, _03E0)
                Case(1, _0411)
                releaseall
                end
            _0335:
                bankorwalletisfull(0, VAR_SPECIAL_RESULT)
                if (var(VAR_SPECIAL_RESULT) == 1) { goto(_042B) }
                hasenoughmoneyvar(VAR_SPECIAL_RESULT, 1)
                if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0389) }
                banktransaction(0, VAR_SPECIAL_RESULT)
                hidesavingsbox
                touchscreenmenushow
                Switch(VAR_SPECIAL_RESULT)
                Case(0, _03FA)
                Case(1, _0411)
                releaseall
                end
            _0389:
                touchscreenmenushow
                hidesavingsbox
                npcmsg("Oh!\n"
                       "You have no money left to save.\r"
                       "Don’t waste your money on\n"
                       "frivolous things, OK?\r"
                       "I know you are sensible like me\n"
                       "and that I can count on you!")
                waitbuttonpress
                closemessage
                releaseall
                end
            _0398:
                npcmsg("Do you want to save some money? {YESNO 0}")
                touchscreenmenuhide
                getmenuchoice(VAR_SPECIAL_RESULT)
                touchscreenmenushow
                hidesavingsbox
                if (var(VAR_SPECIAL_RESULT) == 0) {
                    bufferplayersname(0)
                    npcmsg(msg_0545_T20R0201_00017)
                    setflag(FLAG_SYS_MOMS_SAVINGS)
                } else {
                    npcmsg(msg_0545_T20R0201_00018)
                    clearflag(FLAG_SYS_MOMS_SAVINGS)
                }
                waitbuttonpress
                closemessage
                releaseall
                end
            _03D1:
                hidesavingsbox
                touchscreenmenushow
                npcmsg(msg_0545_T20R0201_00021)
                waitbuttonpress
                closemessage
                releaseall
                end
            _03E0:
                closemessage
                wait(8, VAR_SPECIAL_RESULT)
                playse(SEQ_SE_GS_OKOZUKAI)
                bufferplayersname(0)
                npcmsg("{STRVAR_1 3, 0, 0}\n"
                       "You should think hard how you spend it!")
                waitbuttonpress
                closemessage
                releaseall
                end
            _03FA:
                closemessage
                wait(8, VAR_SPECIAL_RESULT)
                playse(SEQ_SE_GS_OKOZUKAI)
                npcmsg("Your money’s safe here!\n"
                       "Take care of yourself!")
                waitbuttonpress
                closemessage
                releaseall
                end
            _0411:
                npcmsg(msg_0545_T20R0201_00021)
                waitbuttonpress
                closemessage
                releaseall
                end
            _041C:
                touchscreenmenushow
                hidesavingsbox
                npcmsg("Oh!\n"
                       "You have no money saved.")
                waitbuttonpress
                closemessage
                releaseall
                end
            _042B:
                touchscreenmenushow
                hidesavingsbox
                npcmsg("I have saved so much.\n"
                       "I can’t save any more.")
                waitbuttonpress
                closemessage
                releaseall
                end
            }
            checkbadge(BADGE_ZEPHYR, VAR_TEMP_x4000)
            if (var(VAR_TEMP_x4000) == 0) {
                npcmsg("...\n"
                       "So, you’re leaving on an adventure...\r"
                       "OK! I’ll help, too.\n"
                       "But what can I do for you?\r"
                       "I know!\n"
                       "Every time you receive prize money,\f"
                       "I’ll save some of it for you.\r"
                       "On a long journey, money’s important.\r"
                       "Do you want me to save\n"
                       "your money for you? {YESNO 0}")
            } else {
                bufferplayersname(0)
                npcmsg("I want to support you on your\n"
                       "adventure, {STRVAR_1 3, 0, 0}.\f"
                       "OK! I’ll help, too.\f"
                       "But what can I do for you?\r"
                       "I know!\r"
                       "Every time you receive prize money,\n"
                       "I’ll save some of it for you.\r"
                       "On a long journey, money’s important.\n"
                       "Do you want me to save\f"
                       "your money for you? {YESNO 0}")
            }
            setflag(FLAG_TALKED_TO_MOM_AFTER_NAMING_RIVAL)
            setvar(VAR_SCENE_ROUTE_30_PHONE_CALL, 0)
            touchscreenmenuhide
            getmenuchoice(VAR_SPECIAL_RESULT)
            touchscreenmenushow
            if (var(VAR_SPECIAL_RESULT) == 0) {
                npcmsg(msg_0545_T20R0201_00017)
                setflag(FLAG_SYS_MOMS_SAVINGS)
            } else {
                npcmsg(msg_0545_T20R0201_00018)
                clearflag(FLAG_SYS_MOMS_SAVINGS)
            }
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        goto(_0205)
        end
    }
    if (var(VAR_SCENE_ELMS_LAB) >= 4) { goto(_0205) }
    if (flag(FLAG_GOT_STARTER)) {
        playse(SEQ_SE_DP_SELECT)
        lockall
        faceplayer
        if (flag(FLAG_GOT_POKEGEAR)) { goto(_01D4) }
        bufferplayersname(0)
        npcmsg(msg_0545_T20R0201_00007)
        bufferplayersname(0)
        npcmsg("{STRVAR_1 3, 0, 0} received\n"
               "the Pokégear!\r")
        setflag(FLAG_GOT_POKEGEAR)
        playfanfare(SEQ_ME_ITEM)
        waitfanfare
        npcmsg("The Pokémon Gear...\n"
               "or Pokégear, as it’s often called,\f"
               "is what every Trainer should have.\r")
        npcmsg("Guess what?\n"
               "You can use the Pokégear to make a\f"
               "phone call, too.\f"
               "Do you remember how? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 0) {
            npcmsg("Just power on the Pokégear and\n"
                   "touch the telephone button, OK?\r")
        } else {
            npcmsg("Select the POKéGEAR button on the\n"
                   "Touch Screen. Then select the\f"
                   "telephone button.\r")
        }
        npcmsg("The names of the people you can call\n"
               "are automatically registered.\r"
               "Just select one to give him or her\n"
               "a call.\r"
               "Wow, I can’t believe it’s so easy\n"
               "to make a phone call!")
        waitbuttonordpad
        closemessage
        releaseall
        end
    _01D4:
        npcmsg("What’s wrong?\r"
               "Did you forget how to get to\n"
               "Mr. Pokémon’s house?\r"
               "Go north on Route 30.\n"
               "Take care, dear.")
        waitbuttonpress
        closemessage
        releaseall
        end
        simplenpcmsg(msg_0545_T20R0201_00007)
        end
    }
    simplenpcmsg("Professor Elm has been waiting for\n"
                 "you, dear. Please, go and help him.")
    end
}

text msg_0545_T20R0201_00017 {
    "OK, I’ll take care of your money.\r"
    "Be careful.\r"
    "Pokémon are your friends.\n"
    "When you work as a team,\f"
    "you can accomplish anything!\f"
    "Now, go on!"
}

text msg_0545_T20R0201_00018 {
    "OK, but be careful out there.\r"
    "Pokémon are your friends.\n"
    "When you work as a team,\f"
    "you can accomplish anything!\f"
    "Now, go on!"
}

text msg_0545_T20R0201_00021 {
    "Just do what you can."
}

text msg_0545_T20R0201_00007 {
    "Oh! {STRVAR_1 3, 0, 0}!\n"
    "That’s a cute Pokémon you have.\r"
    "Professor Elm must have given it\n"
    "to you?\r"
    "Oh, Professor Elm has a task for you,\n"
    "you say?\f"
    "What kind of task?\r"
    "...\r"
    "I see. That sounds a little difficult.\r"
    "But when someone makes that kind of\n"
    "request of you, it must be important!\r"
    "Oh, that’s right!\n"
    "I completely forgot!\r"
    "Your Pokégear came back from the\n"
    "repair shop!\r"
    "Here you go!\r"
}

