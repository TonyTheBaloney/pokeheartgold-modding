}

script PokemonLeagueBrunoRoom_EventScript_Bruno {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_DEFEATED_BRUNO)) {
        npcmsg("Having lost, I have no right to\n"
               "say anything...\f"
               "Go face your next challenge!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    bufferplayersname(0)
    npcmsg("I am Bruno of the Elite Four.\r"
           "I always train to the extreme because\n"
           "I believe in our potential.\r"
           "That is how we became strong.\n"
           "Can you withstand our power?\r"
           "Hm? I see no fear in you. You look\n"
           "determined. Perfect for battle!\r"
           "Ready, {STRVAR_1 3, 0, 0}?\r"
           "You will bow down to our\n"
           "overwhelming power!\r"
           "Hoo hah!\r")
    closemessage
    if (var(VAR_UNK_4135) >= 8) {
        trainerbattle(TRAINER_ELITE_FOUR_BRUNO_BRUNO_2, 0, 0, 0)
    } else {
        trainerbattle(TRAINER_ELITE_FOUR_BRUNO_BRUNO, 0, 0, 0)
    }
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    setflag(FLAG_DEFEATED_BRUNO)
    npcmsg("Having lost, I have no right to\n"
           "say anything...\f"
           "Go face your next challenge!\r")
    closemessage
    playse(SEQ_SE_DP_KI_GASYAN)
    removeobject(obj_T10R0401_leag_door2)
    removeobject(obj_T10R0401_leag_door2_2)
    removeobject(obj_T10R0401_leag_door2_3)
    releaseall
    end
}

