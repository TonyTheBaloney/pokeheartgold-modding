script Route16_Gatehouse_OnResume {
    if (flag(FLAG_UNK_149)) {
        setbikestatelock(1)
        end
    }
    end
}

script Route16_Gatehouse_EventScript_Trigger1 {
    followmonresetmovement
    lockall
    playeronbikecheck(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        setbikestatelock(1)
        setvar(VAR_UNK_4129, 1)
        setvar(VAR_UNK_412A, 1)
        setflag(FLAG_UNK_149)
        releaseall
        end
    }
    applymovement(obj_player, Route16_Gatehouse_Movement_PlayerFaceUp)
    waitmovement
    npcmsg("You! Stop right there!\r"
           "You have to be on a Bicycle to go on\n"
           "the Cycling Road!\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, Route16_Gatehouse_Movement_PlayerWalkRight)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    releaseall
    end
}

movement Route16_Gatehouse_Movement_PlayerFaceUp {
    walk_in_place_up
}

movement Route16_Gatehouse_Movement_PlayerWalkRight {
    walk_right
}

script Route16_Gatehouse_EventScript_Trigger2 {
    setbikestatelock(0)
    setvar(VAR_UNK_4129, 0)
    setvar(VAR_UNK_412A, 0)
    clearflag(FLAG_UNK_149)
    end
}

script Route16_Gatehouse_EventScript_Attendant {
    simplenpcmsg("Cycling Road starts here.\n"
                 "It’s all downhill, so it’s totally\f"
                 "exhilarating.\r"
                 "Some people prefer convenient and cool\n"
                 "transportation such as the Fast Ship\f"
                 "and the Magnet Train.\f"
                 "You prefer the Bicycle, don’t you?")
    end
}

mapscripts Route16_Gatehouse_MapScripts {
    INIT_SCRIPT_ON_RESUME: Route16_Gatehouse_OnResume
}
