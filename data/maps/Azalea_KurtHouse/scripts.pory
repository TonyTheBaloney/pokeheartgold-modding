script Azalea_KurtHouse_OnTransition {
    if (flag(FLAG_BEAT_AZALEA_ROCKETS)) {
        clearflag(FLAG_HIDE_AZALEA_SLOWPOKES)
        end
    }
    setflag(FLAG_HIDE_AZALEA_SLOWPOKES)
    end
}

script Azalea_KurtHouse_EventScript_KurtScene {
    followmonresetmovement
    lockall
    setvar(VAR_UNK_4080, 3)
    applymovement(obj_T23R0501_gantetsu, Azalea_KurtHouse_Movement_KurtFaceDown)
    waitmovement
    bufferplayersname(0)
    npcmsg("Kurt: Hi, {STRVAR_1 3, 0, 0}!\n"
           "You handled yourself like a real hero.\r"
           "As I mentioned before, Team Rocket was\n"
           "disbanded by a boy called Red three\f"
           "years ago.\r"
           "Now that they have come back...\n"
           "I have a bad feeling about it...\r"
           "In any case, it would please me greatly\n"
           "to make Poké Balls for a Trainer\f"
           "like you, {STRVAR_1 3, 0, 0}.\f"
           "This is all I have now, but take it.\r")
    setvar(VAR_SPECIAL_x8004, 492)
    setvar(VAR_SPECIAL_x8005, 1)
    callstd(std_obtain_item_verbose)
    setflag(FLAG_UNK_07C)
    releaseall
    goto(_011A)
    end
}

script Azalea_KurtHouse_EventScript_Kurt {
    if (flag(FLAG_UNK_07C)) { goto(_011A) }
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    bufferplayersname(0)
    npcmsg("Hm? Who are you?\r"
           "{STRVAR_1 3, 0, 0}, eh? You want me to make\n"
           "some Balls?\r"
           "Sorry, but that’ll have to wait.\r"
           "Do you know Team Rocket?\n"
           "Ah, don’t worry. I’ll tell you anyhow.\r"
           "Team Rocket’s an evil gang that\n"
           "uses Pokémon for their dirty work.\r"
           "They’re supposed to have disbanded\n"
           "three years ago.\r"
           "Anyway, they’re at the well, cutting\n"
           "off SlowpokeTails for sale!\r"
           "So I’m going to go give them a\n"
           "lesson in pain!\r"
           "Hang on, SLOWPOKE!\n"
           "Old Kurt is on his way!")
    waitabpress
    closemessage
    getplayerfacing(VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 0) {
        applymovement(obj_T23R0501_gantetsu, Azalea_KurtHouse_Movement_KurtWalkDown)
    _00AF:
        waitmovement
    _00B1:
        releaseall
        removeobject(obj_T23R0501_gantetsu)
        waitfanfare
        setflag(FLAG_UNK_077)
        setflag(FLAG_UNK_19E)
        setflag(FLAG_UNK_19F)
        end
    _00C7:
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(56)
        getpersoncoords(253, VAR_TEMP_x4002, VAR_TEMP_x4003)
        if (var(VAR_TEMP_x4002) == 5) {
            applymovement(obj_T23R0501_gantetsu, Azalea_KurtHouse_Movement_KurtWalkLeftDown)
        } else {
            playse(SEQ_SE_DP_WALL_HIT)
            applymovement(obj_T23R0501_gantetsu, Azalea_KurtHouse_Movement_KurtWalkDown)
            applymovement(obj_player, Azalea_KurtHouse_Movement_PlayerWalkLeft)
        }
        waitmovement
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
        goto(_00B1)
    _011A:
        playse(SEQ_SE_DP_SELECT)
        lockall
        faceplayer
        getkurtapricornquantity(VAR_SPECIAL_x8000)
        if (var(VAR_SPECIAL_x8000) != 0) {
            if (flag(FLAG_DAILY_KURT_MAKING_BALLS)) { goto(_0204) }
            bufferplayersname(0)
            npcmsg("Kurt: Ah, {STRVAR_1 3, 0, 0}!\f"
                   "I just finished your Poké Ball. Here!\r")
            getkurtball(VAR_SPECIAL_x8004)
            hasspaceforitem(VAR_SPECIAL_x8004, VAR_SPECIAL_x8000, VAR_SPECIAL_RESULT)
            copyvar(VAR_SPECIAL_x8005, VAR_SPECIAL_x8000)
            callstd(std_give_item_verbose)
            clearkurtapricorn
            if (var(VAR_UNK_413B) < 10) {
                addvar(VAR_UNK_413B, 1)
                compare(VAR_UNK_413B, 10)
                callifge(_0227)
            }
            npcmsg("Kurt: That turned out great.\r"
                   "Try catching Pokémon with it.")
            goto(_021F)
            end
            npcmsg("Kurt: Your Bag is full!\n"
                   "Come back when it’s lighter.")
            goto(_021F)
            end
        _0204:
            npcmsg("Kurt: I’m working!\n"
                   "Don’t bother me!")
            goto(_021F)
            end
        }
        gettotalapricorncount(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            npcmsg("Kurt: I make Poké Balls from Apricorns.\r"
                   "Collect them from trees and bring\n"
                   "’em to me.\r"
                   "I’ll make Poké Balls out of them.")
            if (var(VAR_UNK_4080) == 3) { goto(_022D) }
        _021F:
            waitbuttonpress
            closemessage
            releaseall
            end
        _0227:
            setflag(FLAG_UNK_127)
            return
        _022D:
            setvar(VAR_UNK_4080, 4)
            applymovement(obj_T23R0501_gsbabygirl1, Azalea_KurtHouse_Movement_LittleGirlWalkLeft)
            waitmovement
            applymovement(obj_player, Azalea_KurtHouse_Movement_PlayerFaceRight)
            waitmovement
            npcmsg("That’s right!\n"
                   "I’ll give you my grandpa’s number. {YESNO 0}")
        _024A:
            touchscreenmenuhide
            getmenuchoice(VAR_SPECIAL_RESULT)
            touchscreenmenushow
            if (var(VAR_SPECIAL_RESULT) == 0) {
                bufferplayersname(0)
                npcmsg("{STRVAR_1 3, 0, 0} registered Kurt\n"
                       "in the Pokégear!")
                playfanfare(SEQ_ME_POKEGEAR_REGIST)
                waitfanfare
                registergearnumber(PHONE_CONTACT_KURT)
                npcmsg("My grandpa can tell you more\n"
                       "about Apricorns.")
                waitbuttonpress
                closemessage
                releaseall
                end
            }
            if (var(VAR_SPECIAL_RESULT) >= 1) {
                npcmsg("No? Why?\n"
                       "You don’t want to talk to my grandpa?")
                waitbuttonpress
                closemessage
                releaseall
                end
                applymovement(1, Azalea_KurtHouse_Movement_ObjectWalkRight)
                waitmovement
                releaseall
                end
            _02A2:
                npcmsg("You want to talk to my grandpa,\n"
                       "don’t you? {YESNO 0}")
                goto(_024A)
                end
            }
            end
        }
        applymovement(obj_T23R0501_gantetsu, Azalea_KurtHouse_Movement_KurtExclamation)
        waitmovement
        npcmsg("Kurt: You have Apricorns for me?\f"
               "Fine! I’ll turn them into Poké Balls.\r")
        closemessage
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        launchapricornboxforkurt
        restoreoverworld
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        getkurtapricornquantity(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            npcmsg("Kurt: Oh...\n"
                   "That’s a letdown.")
        } else {
            setflag(FLAG_DAILY_KURT_MAKING_BALLS)
            npcmsg("Kurt: It’ll take a day to make you a\n"
                   "Poké Ball. Come back for it later.")
        }
        waitbuttonpress
        closemessage
        if (var(VAR_UNK_4080) == 3) { goto(_022D) }
        releaseall
        end
    }
    goto(_00C7)
    goto(_00AF)
}

movement Azalea_KurtHouse_Movement_KurtFaceDown {
    delay_16
    walk_in_place_fast_down
}

movement Azalea_KurtHouse_Movement_KurtExclamation {
    emote_exclamation_mark
    delay_8
}

movement Azalea_KurtHouse_Movement_PlayerWalkLeft {
    walk_fast_left
    delay_16
}

movement Azalea_KurtHouse_Movement_PlayerFaceRight {
    walk_in_place_fast_right
    face_right
}

movement Azalea_KurtHouse_Movement_KurtWalkDown {
    walk_fast_down * 5
}

movement Azalea_KurtHouse_Movement_KurtWalkLeftDown {
    walk_fast_left
    walk_fast_down * 2
    walk_fast_right
    walk_fast_down * 3
}

movement Azalea_KurtHouse_Movement_LittleGirlWalkLeft {
    walk_left
}

movement Azalea_KurtHouse_Movement_ObjectWalkRight {
    walk_in_place_fast_right
    walk_right
    walk_in_place_fast_left
}

script Azalea_KurtHouse_EventScript_LittleGirl {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_077)) {
        if (flag(FLAG_BEAT_AZALEA_ROCKETS)) {
            checkregisteredphonenumber(PHONE_CONTACT_KURT, VAR_TEMP_x4001)
            if (var(VAR_TEMP_x4001) == 0) { goto(_02A2) }
            if (flag(FLAG_GAME_CLEAR)) {
                npcmsg("Dad works at Silph where he studies\n"
                       "Poké Balls.\r"
                       "I have to stay home with Grandpa\n"
                       "and SLOWPOKE.")
                waitbuttonpress
                closemessage
                releaseall
                end
            }
            npcmsg("The SLOWPOKE my dad gave me came\n"
                   "back! Its tail has grown back, too!")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Grandpa’s gone...\n"
               "I’m so lonely...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("The SLOWPOKE are gone...\n"
           "Were they taken away by bad people?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Azalea_KurtHouse_EventScript_Slowpoke {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_SLOWPOKE, 0)
    npcmsg("SLOWPOKE: ...\n"
           "Yawn?")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Azalea_KurtHouse_EventScript_Sign {
    simplenpcmsg("You see three people, with landscape\n"
                 "in the background.\r"
                 "It’s Kurt, Professor Oak, and...\n"
                 "in the middle,\f"
                 "a lady with determined eyes.")
    end
}

script Azalea_KurtHouse_EventScript_Radio {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 2) {
        npcmsg(msg_0571_T23R0501_00024)
    } elif (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg(msg_0571_T23R0501_00024)
    } elif (var(VAR_SCENE_ROCKET_TAKEOVER) == 4) {
        npcmsg(msg_0571_T23R0501_00024)
    } else {
        npcmsg("The radio is on.\r"
               "It’s Professor Oak’s Pokémon Talk!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

text msg_0571_T23R0501_00024 {
    "The radio is declaring the revival\n"
    "of Team Rocket!"
}

