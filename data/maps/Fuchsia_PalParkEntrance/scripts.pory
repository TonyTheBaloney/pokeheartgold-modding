    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) {
        movemigratedpokemontopc
        npcmsg("Done!\n"
               "Your Pokémon have been boxed away.\r"
               "You’ll now have to save the game.\r")
        npcmsg("If you want to do another Catching\n"
               "Show, come see us again, please!\r")
