script scr_seq_T08GYM0101_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_SOUL, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0778) }
    npcmsg("Fufufufu...\n"
           "I’m sorry to disappoint you...\r"
           "I’m only joking! I’m the real deal!\r"
           "Janine of Fuchsia Gym, that’s me!\r")
    closemessage
    setvar(VAR_TEMP_x400B, 111)
    trainerbattle(TRAINER_LEADER_JANINE_JANINE, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    setvar(VAR_TEMP_x400B, 0)
    givebadge(BADGE_SOUL)
    addvar(VAR_UNK_4135, 1)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    settrainerflag(TRAINER_PICNICKER_CINDY)
    settrainerflag(TRAINER_CAMPER_BARRY)
    settrainerflag(TRAINER_LASS_LINDA)
    settrainerflag(TRAINER_LASS_ALICE)
    npcmsg("Janine: I see... You have defeated\n"
           "Koga, my father and a member of the\f"
           "Elite Four, to come here.\r"
           "No wonder you are strong!\r"
           "You’ve definitely won...\n"
           "Here’s the Soul Badge. Take it.\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Soul Badge from Janine!")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    npcmsg("Janine: You’re so tough!\n"
           "I have a special gift!\r"
           "It’s Poison Jab, a powerful Poison-type\n"
           "move that may poison its victim.\r")
    goto(_074F)
_074F:
    if (!itemspace(ITEM_TM84, 1)) {
        callstd(std_bag_is_full)
        closemessage
        releaseall
        end
    }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM84_FROM_JANINE)
_0778:
    if (!flag(FLAG_GOT_TM84_FROM_JANINE)) { goto(_074F) }
    npcmsg("Janine: I’m going to really apply\n"
           "myself and improve my skills.\r"
           "I want to become much better than\n"
           "both my father and you!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T08GYM0101_002 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_SOUL, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("That was a great battle,\n"
               "Trainer from Johto!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Yo, legend in the making!\n"
           "Whoops! Take a good look around you.\r"
           "The Trainers all look like the\n"
           "Gym Leader, Janine.\r"
           "Which of them is the real Janine?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T08GYM0101_007 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_SOUL, VAR_SPECIAL_RESULT)
    bufferplayersname(0)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Fuchsia City Pokémon Gym")
    } else {
        npcmsg("Fuchsia City Pokémon Gym\r"
               "Leader: Janine\n"
               "Certified Trainer!\f"
               "{STRVAR_1 3, 0, 0}")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

