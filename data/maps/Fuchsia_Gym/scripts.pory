script scr_seq_T08GYM0101_003 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!defeated(TRAINER_LASS_LINDA)) {
        getplayerfacing(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            applymovement(obj_T08GYM0101_gsleader13_4, Fuchsia_Gym_Movement_0620)
        } elif (var(VAR_SPECIAL_RESULT) == 1) {
            applymovement(obj_T08GYM0101_gsleader13_4, Fuchsia_Gym_Movement_05E4)
        } elif (var(VAR_SPECIAL_RESULT) == 2) {
            applymovement(obj_T08GYM0101_gsleader13_4, Fuchsia_Gym_Movement_0604)
        } else {
            applymovement(obj_T08GYM0101_gsleader13_4, Fuchsia_Gym_Movement_0638)
        }
        waitmovement
        clearflag(FLAG_HIDE_FUCHSIA_GYM_LASS_LINDA_REVEALED)
        addobject(obj_T08GYM0101_gsgirl1)
        setflag(FLAG_HIDE_FUCHSIA_GYM_LASS_LINDA_DISGUISED)
        removeobject(obj_T08GYM0101_gsleader13_4)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            applymovement(obj_T08GYM0101_gsgirl1, Fuchsia_Gym_Movement_0698)
        } elif (var(VAR_SPECIAL_RESULT) == 1) {
            applymovement(obj_T08GYM0101_gsgirl1, Fuchsia_Gym_Movement_065C)
        } elif (var(VAR_SPECIAL_RESULT) == 2) {
            applymovement(obj_T08GYM0101_gsgirl1, Fuchsia_Gym_Movement_0680)
        } else {
            applymovement(obj_T08GYM0101_gsgirl1, Fuchsia_Gym_Movement_06B4)
        }
        waitmovement
        npcmsg("Fooled you!\n"
               "Hahaha!\r")
        closemessage
        trainerbattle(TRAINER_LASS_LINDA, 0, 0, 0)
        checkbattlewon(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            whiteout
            releaseall
            setflag(FLAG_HIDE_FUCHSIA_GYM_LASS_LINDA_REVEALED)
            clearflag(FLAG_HIDE_FUCHSIA_GYM_LASS_LINDA_DISGUISED)
            end
        }
        settrainerflag(TRAINER_LASS_LINDA)
    }
    npcmsg("Well? Wasn’t my disguise perfect?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

