script SeafoamIslandsCinnabarGym_OnTransition {
    getphonebookrematch(PHONE_CONTACT_BLAINE, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 0) {
        setflag(FLAG_HIDE_SEAFOAM_GYM_BLAINE)
        end
    }
    checkregisteredphonenumber(PHONE_CONTACT_BLAINE, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_008A) }
    checkbadge(BADGE_EARTH, VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) == 1) { goto(_0069) }
    clearflag(FLAG_HIDE_SEAFOAM_GYM_BLAINE)
    end
_0069:
    getweekday(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) == 2) {
        setflag(FLAG_HIDE_SEAFOAM_GYM_BLAINE)
    } else {
        clearflag(FLAG_HIDE_SEAFOAM_GYM_BLAINE)
    }
    end
_008A:
    getweekday(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) == 4) {
        setflag(FLAG_HIDE_SEAFOAM_GYM_BLAINE)
    } else {
        clearflag(FLAG_HIDE_SEAFOAM_GYM_BLAINE)
    }
    end
}

script SeafoamIslandsCinnabarGym_OnResume {
    callifset(FLAG_UNK_13B, _00D4)
    callifset(FLAG_UNK_13D, _00E2)
    callifset(FLAG_UNK_13E, _00F0)
    end
_00D4:
    movepersonfacing(obj_D11R0106_gsassistantm, 21, 0, 14, DIR_WEST)
    return
_00E2:
    movepersonfacing(obj_D11R0106_gsassistantm_3, 9, 0, 13, DIR_NORTH)
    return
_00F0:
    movepersonfacing(obj_D11R0106_assistantm, 15, 0, 16, DIR_SOUTH)
    return
}

script SeafoamIslandsCinnabarGym_EventScript_Blaine {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_VOLCANO, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        if (!flag(FLAG_GOT_TM50_FROM_BLAINE)) { goto(_0175) }
        npcmsg("Blaine: My Fire-type Pokémon will be\n"
               "even stronger! Just you watch!")
        waitbuttonpress
        closemessage
        releaseall
        end
    _01CC:
        whiteout
        releaseall
        end
    }
    npcmsg("Blaine: Hey, you!\r"
           "My Gym on Cinnabar Island was burned\n"
           "down by the eruption!\r"
           "But I will not give up!\n"
           "Take a look at this cave.\r"
           "We have turned it into a Gym, and I am\n"
           "still acting as a Gym Leader!\r"
           "I will give you the Gym Badge\n"
           "if you manage to defeat me!\r"
           "Are you ready? Here we go!\r")
    closemessage
    trainerbattle(TRAINER_LEADER_BLAINE_BLAINE, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_01CC) }
    givebadge(BADGE_VOLCANO)
    addvar(VAR_UNK_4135, 1)
    setflag(FLAG_UNK_265)
    setflag(FLAG_HIDE_ROUTE_19_WORKMEN_CLOSED)
    clearflag(FLAG_HIDE_ROUTE_19_WORKMEN_OPEN)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    setflag(FLAG_UNK_13F)
    setflag(FLAG_UNK_140)
    setflag(FLAG_UNK_13C)
    npcmsg("Blaine: Awesome. I have burned out...\f"
           "Take this Volcano Badge!\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Volcano Badge from Blaine!")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    npcmsg("Blaine: Here, I will give you this, too.\n"
           "It’s called Overheat!\r"
           "It has a slight drawback, but it’s\n"
           "powerful and well worth it!\r")
    goto(_0175)
_0175:
    if (!itemspace(ITEM_TM50, 1)) { goto(_01AC) }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM50_FROM_BLAINE)
    bufferplayersname(0)
    npcmsg("Blaine: I did lose this time, but I’m\n"
           "going to win next time.\r"
           "When I rebuild my Cinnabar Gym,\n"
           "we have to hold a rematch.")
    waitbuttonpress
    closemessage
    releaseall
    end
_01AC:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

script SeafoamIslandsCinnabarGym_EventScript_Cary {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_13B)) {
        npcmsg("Bitterness leads to improvement\n"
               "tomorrow.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Wow, to see a Gym in a cave like this?\n"
           "I’d love to explore it.\r")
    closemessage
    trainerbattle(TRAINER_SUPER_NERD_CARY, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_01CC) }
    npcmsg("Bitterness leads to improvement\n"
           "tomorrow.\r")
    closemessage
    applymovement(obj_D11R0106_gsassistantm, SeafoamIslandsCinnabarGym_Movement_CaryWalkRight)
    waitmovement
    setflag(FLAG_UNK_13B)
    releaseall
    end
}

script SeafoamIslandsCinnabarGym_EventScript_Waldo {
