               "Who in the world are you?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("I am in the middle of collecting\n"
           "battle records.\r"
           "Can you help me?\r")
    closemessage
    trainerbattle(TRAINER_SUPER_NERD_WALDO, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_01CC) }
    npcmsg("I didn’t expect you to be so good!\n"
           "Who in the world are you?\r")
    closemessage
    getplayerfacing(VAR_SPECIAL_RESULT)
