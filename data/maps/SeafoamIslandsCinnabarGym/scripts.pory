        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Blaine may have lost his Gym, but he\n"
           "never gives up. His perseverance\f"
           "is what motivates me!\r")
    closemessage
    trainerbattle(TRAINER_SCIENTIST_GS_LINDEN, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_01CC) }
    npcmsg("Together with Blaine, we will rebuild\n"
           "our Gym!\r")
    closemessage
    getplayerfacing(VAR_SPECIAL_RESULT)
