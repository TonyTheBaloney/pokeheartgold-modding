script SeafoamIslandsCinnabarGym_EventScript_Linden {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_13F)) {
        npcmsg("Together with Blaine, we will rebuild\n"
