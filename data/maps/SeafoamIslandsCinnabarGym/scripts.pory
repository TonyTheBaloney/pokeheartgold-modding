script SeafoamIslandsCinnabarGym_EventScript_Daniel {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_140)) {
        npcmsg("We take a step back when we are\n"
               "defeated...\r"
               "Don’t you think we are downright\n"
               "honest?\r"
               "Never put us in the same category as\n"
               "Scientists who help bad guys.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("We lost the Gym on Cinnabar Island and\n"
           "felt lost before we came here.\r")
    closemessage
    trainerbattle(TRAINER_SCIENTIST_GS_DANIEL, 0, 0, 0)
