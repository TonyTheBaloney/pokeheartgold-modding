    npcmsg("We take a step back when we are\n"
           "defeated...\r"
           "Don’t you think we are downright\n"
           "honest?\r"
           "Never put us in the same category as\n"
           "Scientists who help bad guys.\r")
    closemessage
    getplayerfacing(VAR_SPECIAL_RESULT)
