script SeafoamIslandsCinnabarGym_EventScript_GymGuide {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_VOLCANO, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("The Gym Leader rebuilding his Gym and\n"
               "the Trainer from Johto who has come to\f"
               "challenge that Gym Leader...\r"
               "I have witnessed a hot battle!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Yo! Legend in the making!\r"
           "This Gym has many Trainers and rocks\n"
           "in the way from the rebuilding.\f"
           "It sure won’t be easy to get to Blaine!\r"
           "But keep your cool and defeat the\n"
           "Trainers one by one, and you will surely\f"
           "find the path!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

