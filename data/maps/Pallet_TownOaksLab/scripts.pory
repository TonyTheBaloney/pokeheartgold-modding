    waitcry
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_096C) }
    setvar(VAR_SPECIAL_x8004, 7)
    setvar(VAR_SPECIAL_x8006, 4)
    call(_0801)
    end
}

script Pallet_TownOaksLab_EventScript_Sign3 {
    if (var(VAR_UNK_4131) == 6) { goto(_0979) }
    if (var(VAR_UNK_4131) == 0) { goto(_097B) }
    if (var(VAR_UNK_4131) == 5) { goto(_097B) }
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_4131) == 3) { goto(_097D) }
    if (var(VAR_UNK_4131) == 4) { goto(_097D) }
    getpersoncoords(0, VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 8) {
        applymovement(obj_T01R0301_ookido, Pallet_TownOaksLab_Movement_ProfOakFaceUp2)
    } else {
        applymovement(obj_T01R0301_ookido, Pallet_TownOaksLab_Movement_ProfOakFaceRight2)
    }
    waitmovement
    showpokemonpicwindow(SPECIES_CHARMANDER, 0)
    playcry(SPECIES_CHARMANDER, 0)
    npcmsg("So, you’re claiming the\n"
           "Fire Pokémon CHARMANDER? {YESNO 0}")
    waitcry
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_096C) }
    setvar(VAR_SPECIAL_x8004, 4)
    setvar(VAR_SPECIAL_x8006, 5)
    call(_0801)
    end
_0801:
    closepokemonpicwindow
    getpartycount(VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_x8005) == 6) {
        touchscreenmenushow
        npcmsg("Huh?\n"
               "You have no room for it right now.\r"
               "Come back when you’ve made room.")
        waitbuttonpress
        closemessage
        releaseall
        return
    }
    if (var(VAR_SPECIAL_x8004) == 1) {
        removeobject(obj_T01R0301_monstarball_3)
        setflag(FLAG_HIDE_OAKS_LAB_BULBASAUR_BALL)
    } elif (var(VAR_SPECIAL_x8004) == 7) {
        removeobject(obj_T01R0301_monstarball_2)
        setflag(FLAG_HIDE_OAKS_LAB_SQUIRTLE_BALL)
    } else {
        removeobject(obj_T01R0301_monstarball)
        setflag(FLAG_HIDE_OAKS_LAB_CHARMANDER_BALL)
    }
    bufferplayersname(0)
    bufferspeciesname(1, VAR_SPECIAL_x8004, 0, 0)
    npcmsg("This Pokémon is really quite energetic!\r")
    npcmsg("{STRVAR_1 3, 0, 0} received the\n"
           "{STRVAR_1 0, 1, 0} from Professor Oak!")
    playfanfare(SEQ_ME_POKEGET)
    waitfanfare
    givemon(VAR_SPECIAL_x8004, 5, 0, 0, 0, VAR_SPECIAL_RESULT)
    bufferspeciesname(1, VAR_SPECIAL_x8004, 0, 0)
    npcmsg("Would you like to give a nickname to\n"
           "the {STRVAR_1 0, 1, 0} you received? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    closemessage
    compare(VAR_SPECIAL_RESULT, 0)
    callifeq(_0929)
    touchscreenmenushow
    getpersoncoords(0, VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) != 8) {
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(55)
        if (var(VAR_SPECIAL_x8004) == 1) {
            applymovement(obj_player, Pallet_TownOaksLab_Movement_PlayerWalkDownLeft1)
        } elif (var(VAR_SPECIAL_x8004) == 7) {
            applymovement(obj_player, Pallet_TownOaksLab_Movement_PlayerWalkDownLeft2)
        } else {
            applymovement(obj_player, Pallet_TownOaksLab_Movement_PlayerWalkDownLeft3)
        }
        waitmovement
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
    } else {
        applymovement(obj_player, Pallet_TownOaksLab_Movement_PlayerFaceDown)
        waitmovement
    }
    npcmsg("Professor Oak: If a wild Pokémon\n"
           "appears, your Pokémon can battle it.\r"
           "With it at your side, you should be able\n"
           "to reach the next town...\r"
           "What am I saying?\n"
           "You already know all this!\f"
           "Hahaha!")
    waitbuttonpress
    closemessage
    releaseall
    copyvar(VAR_UNK_4131, VAR_SPECIAL_x8006)
    setvar(VAR_SCENE_EMBEDDED_TOWER, 1)
    return
_0929:
    setvar(VAR_TEMP_x4000, 0)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    nicknameinput(VAR_SPECIAL_x8005, VAR_TEMP_x4000)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    touchscreenmenuhide
    bufferpartymonnick(1, VAR_SPECIAL_x8005)
    npcmsg("Is {STRVAR_1 1, 1, 0} the nickname\n"
           "you want to give? {YESNO 0}")
    getmenuchoice(VAR_SPECIAL_RESULT)
    closemessage
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0929) }
    return
_096C:
    closepokemonpicwindow
    npcmsg("No need to hurry.\n"
           "Take your time.")
    waitbuttonpress
    closemessage
    touchscreenmenushow
    releaseall
_0979:
    end
_097B:
    end
_097D:
    bufferrivalsname(1)
    npcmsg("This is Professor Oak’s Pokémon.\n"
           "{STRVAR_1 3, 1, 0} will probably not\f"
           "steal it like before...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Pallet_TownOaksLab_Movement_PlayerWalkDownLeft1 {
    walk_down
    walk_left * 3
}

movement Pallet_TownOaksLab_Movement_PlayerWalkDownLeft2 {
    walk_down
    walk_left * 2
}

movement Pallet_TownOaksLab_Movement_PlayerWalkDownLeft3 {
    walk_down
    walk_left
}

movement Pallet_TownOaksLab_Movement_ProfOakFaceRight2 {
    face_right
}

movement Pallet_TownOaksLab_Movement_ProfOakFaceUp2 {
    face_up
}

movement Pallet_TownOaksLab_Movement_PlayerFaceDown {
    face_down
}

mapscripts Pallet_TownOaksLab_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Pallet_TownOaksLab_OnTransition
    INIT_SCRIPT_ON_FRAME_TABLE [
        VAR_UNK_4131, 1: Pallet_TownOaksLab_EventScript_ProfOakScene
    ]
}
