script Pallet_TownOaksLab_EventScript_PC {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    bufferplayersname(0)
    gendermsgbox("There’s an email message on the PC.\r"
                 "...\r"
                 "Hi, Professor Oak!\n"
                 "How is your research coming along?\r"
                 "I’m...doing fine.\r"
                 "I heard that {STRVAR_1 3, 0, 0} is getting\n"
                 "quite a reputation.\r"
                 "That’s what we hear on the grapevine.\n"
                 "I’m delighted to hear that.\f"
                 "           Elm in New Bark Town 8-)", "There’s an email message on the PC.\r"
                                                        "...\r"
                                                        "Hi, Professor Oak!\n"
                                                        "How is your research coming along?\r"
                                                        "I’m...doing fine.\r"
                                                        "I heard that {STRVAR_1 3, 0, 0} is getting\n"
                                                        "quite a reputation.\r"
                                                        "That’s what we hear on the grapevine.\n"
                                                        "I’m delighted to hear that.\f"
                                                        "           Elm in New Bark Town 8-)")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Pallet_TownOaksLab_EventScript_Sign1 {
    if (var(VAR_UNK_4131) == 6) { goto(_0979) }
    if (var(VAR_UNK_4131) == 0) { goto(_097B) }
    if (var(VAR_UNK_4131) == 3) { goto(_097B) }
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_4131) == 4) { goto(_097D) }
    if (var(VAR_UNK_4131) == 5) { goto(_097D) }
    getpersoncoords(0, VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 8) {
        applymovement(obj_T01R0301_ookido, Pallet_TownOaksLab_Movement_ProfOakFaceUp2)
    } else {
        applymovement(obj_T01R0301_ookido, Pallet_TownOaksLab_Movement_ProfOakFaceRight2)
    }
    waitmovement
    showpokemonpicwindow(SPECIES_BULBASAUR, 0)
    playcry(SPECIES_BULBASAUR, 0)
    npcmsg("So, you want to go with\n"
           "the Grass Pokémon BULBASAUR? {YESNO 0}")
    waitcry
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_096C) }
    setvar(VAR_SPECIAL_x8004, 1)
    setvar(VAR_SPECIAL_x8006, 3)
    call(_0801)
    end
}

script Pallet_TownOaksLab_EventScript_Sign2 {
    if (var(VAR_UNK_4131) == 6) { goto(_0979) }
    if (var(VAR_UNK_4131) == 0) { goto(_097B) }
    if (var(VAR_UNK_4131) == 4) { goto(_097B) }
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_4131) == 3) { goto(_097D) }
    if (var(VAR_UNK_4131) == 5) { goto(_097D) }
    getpersoncoords(0, VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 8) {
        applymovement(obj_T01R0301_ookido, Pallet_TownOaksLab_Movement_ProfOakFaceUp2)
    } else {
        applymovement(obj_T01R0301_ookido, Pallet_TownOaksLab_Movement_ProfOakFaceRight2)
    }
    waitmovement
    showpokemonpicwindow(SPECIES_SQUIRTLE, 0)
    playcry(SPECIES_SQUIRTLE, 0)
