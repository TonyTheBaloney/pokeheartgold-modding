text msg_0451_T01R0301_00042 {
    "Professor Oak: You don’t see them\n"
    "very often in Kanto.\f"
    "Choose one and it’ll be yours!\r"
    "...Go ahead!"
}

movement Pallet_TownOaksLab_Movement_PlayerWalkUp {
    walk_up * 5
}

movement Pallet_TownOaksLab_Movement_PlayerWalkUpLeft {
    delay_8 * 2
    walk_up * 3
    walk_left * 2
}

