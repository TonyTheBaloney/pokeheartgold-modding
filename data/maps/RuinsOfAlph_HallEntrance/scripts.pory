script RuinsOfAlph_HallEntrance_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        checkbadge(BADGE_PLAIN, VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) != 0) {
            getweekday(VAR_TEMP_x4000)
            if (var(VAR_TEMP_x4000) == 1) { goto(_006B) }
            if (var(VAR_TEMP_x4000) == 2) { goto(_006B) }
            if (var(VAR_TEMP_x4000) == 4) { goto(_006B) }
        }
        setflag(FLAG_HIDE_CAMERON)
        end
    _006B:
        clearflag(FLAG_HIDE_CAMERON)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script RuinsOfAlph_HallEntrance_EventScript_Sign1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("It’s a replica of an ancient Pokémon.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script RuinsOfAlph_HallEntrance_EventScript_Sign2 {
    followmonresetmovement
    lockall
    movepersonfacing(obj_D24R0211_gsassistantm, 25, 0, 30, DIR_NORTH)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, RuinsOfAlph_HallEntrance_Movement_PlayerWalkRightDown)
    applymovement(obj_D24R0211_gsassistantm, RuinsOfAlph_HallEntrance_Movement_SuperNerdWalkUpRight)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    wait(15, VAR_SPECIAL_x8005)
    npcmsg("Hmmm.\n"
           "When did this appear...?\r"
           "I wonder what these symbols mean...\f"
           "..................\r")
    applymovement(obj_D24R0211_gsassistantm, RuinsOfAlph_HallEntrance_Movement_SuperNerdFaceDown)
    waitmovement
    npcmsg("Hey, you!\n"
           "Let’s go back to the Research Center!\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    warp(MAP_RUINS_OF_ALPH_RESEARCH_CENTER, 0, 7, 4, DIR_EAST)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    setobjectfacingandupdatedraw(2, 2)
    npcmsg("The symbols on the stone panel were\n"
           "like this...\r")
    msgfont3(4)
    npcmsg("I wonder what it means.\n"
           "We need to examine the ruins once again.\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} opened the UNOWN Report\n"
           "and made notes!")
    playfanfare(SEQ_ME_LVUP)
    waitfanfare
    addvar(VAR_UNOWN_REPORT_LEVEL, 1)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement RuinsOfAlph_HallEntrance_Movement_PlayerWalkRightDown {
    delay_4
    walk_right
    face_down
    emote_exclamation_mark
    walk_right
    walk_down * 2
    walk_left * 2
    face_up
}

movement RuinsOfAlph_HallEntrance_Movement_SuperNerdWalkUpRight {
    delay_8 * 4
    walk_fast_up * 4
    walk_fast_right
    walk_fast_up * 6
    walk_fast_left
    walk_in_place_up
}

movement RuinsOfAlph_HallEntrance_Movement_SuperNerdFaceDown {
    face_down
}

script RuinsOfAlph_HallEntrance_EventScript_PokefanM1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0290) }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_02A4) }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, RuinsOfAlph_HallEntrance_Movement_PlayerWalkRightUp)
        applymovement(obj_D24R0211_gsmiddleman1, RuinsOfAlph_HallEntrance_Movement_PokefanMFaceUp)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, RuinsOfAlph_HallEntrance_Movement_PlayerWalkUp)
    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_player, RuinsOfAlph_HallEntrance_Movement_PlayerWalkUpRight)
        applymovement(obj_D24R0211_gsmiddleman1, RuinsOfAlph_HallEntrance_Movement_PokefanMFaceUp)
    } else {
        applymovement(obj_player, RuinsOfAlph_HallEntrance_Movement_PlayerWalkUpLeft)
        applymovement(obj_D24R0211_gsmiddleman1, RuinsOfAlph_HallEntrance_Movement_PokefanMFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, RuinsOfAlph_HallEntrance_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(4)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
_0290:
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 5)
    waitbuttonpress
    closemessage
    releaseall
    end
_02A4:
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 3)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement RuinsOfAlph_HallEntrance_Movement_PlayerWalkRightUp {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement RuinsOfAlph_HallEntrance_Movement_PlayerWalkUp {
    walk_up * 3
    walk_in_place_down
}

movement RuinsOfAlph_HallEntrance_Movement_PlayerWalkUpLeft {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement RuinsOfAlph_HallEntrance_Movement_PlayerWalkUpRight {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement RuinsOfAlph_HallEntrance_Movement_PokefanMFaceUp {
    delay_8
    walk_in_place_up
}

movement RuinsOfAlph_HallEntrance_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

