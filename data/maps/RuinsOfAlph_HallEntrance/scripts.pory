script scr_seq_D24R0211_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("It’s a replica of an ancient Pokémon.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_D24R0211_001 {
    followmonresetmovement
    lockall
    movepersonfacing(obj_D24R0211_gsassistantm, 25, 0, 30, DIR_NORTH)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, RuinsOfAlph_HallEntrance_Movement_0120)
    applymovement(obj_D24R0211_gsassistantm, RuinsOfAlph_HallEntrance_Movement_0144)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    wait(15, VAR_SPECIAL_x8005)
    npcmsg("Hmmm.\n"
           "When did this appear...?\r"
           "I wonder what these symbols mean...\f"
           "..................\r")
    applymovement(obj_D24R0211_gsassistantm, RuinsOfAlph_HallEntrance_Movement_0160)
    waitmovement
    npcmsg("Hey, you!\n"
           "Let’s go back to the Research Center!\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    warp(MAP_RUINS_OF_ALPH_RESEARCH_CENTER, 0, 7, 4, DIR_EAST)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    setobjectfacingandupdatedraw(2, 2)
    npcmsg("The symbols on the stone panel were\n"
           "like this...\r")
    msgfont3(4)
    npcmsg("I wonder what it means.\n"
           "We need to examine the ruins once again.\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} opened the UNOWN Report\n"
           "and made notes!")
    playfanfare(SEQ_ME_LVUP)
    waitfanfare
    addvar(VAR_UNOWN_REPORT_LEVEL, 1)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement RuinsOfAlph_HallEntrance_Movement_0120 {
    delay_4
    walk_right
    face_down
    emote_exclamation_mark
    walk_right
    walk_down * 2
    walk_left * 2
    face_up
}

movement RuinsOfAlph_HallEntrance_Movement_0144 {
    delay_8 * 4
    walk_fast_up * 4
    walk_fast_right
    walk_fast_up * 6
    walk_fast_left
    walk_in_place_up
}

movement RuinsOfAlph_HallEntrance_Movement_0160 {
    face_down
}

