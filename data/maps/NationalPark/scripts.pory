script NationalPark_EventScript_Bugsy {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getweekday(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 5) {
        bufferplayersname(0)
        npcmsg("Bugsy: Hi, {STRVAR_1 3, 0, 0}!\n"
               "We have a Bug-Catching Contest\f"
               "tomorrow!\r"
               "I have won the Contest many\n"
               "times, so I won’t participate.\r"
               "But you should try it.\n"
               "I’m sure you can win!\r"
               "By the way, will you take a\n"
               "picture with me? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Bugsy: Oh, I see...\n"
                   "That’s OK. I’m not sad.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        photoalbumisfull(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Your Photo Album is full.\r"
                   "Access your PC and delete\n"
                   "some pictures.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Bugsy: OK! Let’s take one.\n"
               "Smile!\r")
        closemessage
        setflag(FLAG_UNK_189)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        cameronphoto(7)
        faceplayer
        lockall
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        clearflag(FLAG_UNK_189)
        npcmsg("Bugsy: Yay! This is a good one!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    bufferplayersname(0)
    npcmsg("Bugsy: Hi, {STRVAR_1 3, 0, 0}!\n"
           "We have a Bug-Catching Contest\f"
           "tomorrow!\r"
           "I have won the Contest many\n"
           "times, so I won’t participate.\r"
           "But you should try it.\f"
           "I’m sure you can win!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script NationalPark_EventScript_Woman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GOT_QUICK_CLAW_FROM_NATIONAL_PARK_WOMAN)) {
        npcmsg("Pay attention, please!\r"
               "...Oops, I have to quit thinking like\n"
               "a teacher all the time.\r"
               "You must be a Pokémon Trainer.\r"
               "Since you’re working so hard,\n"
               "I want you to have this.\r")
        if (!itemspace(ITEM_QUICK_CLAW, 1)) {
            callstd(std_bag_is_full)
            closemessage
            releaseall
            end
        }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_QUICK_CLAW_FROM_NATIONAL_PARK_WOMAN)
    }
    npcmsg("Let a Pokémon hold that Quick Claw.\r"
           "Sometimes it will strike first\n"
           "during battle.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

