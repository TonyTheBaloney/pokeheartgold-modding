        applymovement(obj_D22R0101_gsmiddleman1_3, NationalPark_Movement_PokefanMFaceUp)
    } else {
        applymovement(obj_player, NationalPark_Movement_PlayerWalkUpLeft)
        applymovement(obj_D22R0101_gsmiddleman1_3, NationalPark_Movement_PokefanMFaceUp)
    }
    waitmovement
