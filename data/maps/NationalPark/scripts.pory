    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement NationalPark_Movement_PlayerWalkRightUp {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement NationalPark_Movement_PlayerWalkUp {
    walk_up * 3
    walk_in_place_down
}

movement NationalPark_Movement_PlayerWalkUpLeft {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement NationalPark_Movement_PlayerWalkUpRight {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement NationalPark_Movement_PokefanMFaceUp {
    delay_8
    walk_in_place_up
}

movement NationalPark_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

