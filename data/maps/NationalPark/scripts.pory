script NationalPark_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        if (var(VAR_UNK_40F7) == 1) { goto(_0162) }
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 1) { goto(_0154) }
        if (var(VAR_TEMP_x4000) == 3) { goto(_0154) }
        if (var(VAR_TEMP_x4000) == 2) { goto(_0162) }
        if (var(VAR_TEMP_x4000) == 4) { goto(_0162) }
        if (var(VAR_TEMP_x4000) == 5) { goto(_0162) }
        setflag(FLAG_HIDE_CAMERON)
        clearflag(FLAG_UNK_27F)
        goto(_016E)
    _0154:
        clearflag(FLAG_HIDE_CAMERON)
        setflag(FLAG_UNK_27F)
        goto(_016E)
    _0162:
        setflag(FLAG_HIDE_CAMERON)
        setflag(FLAG_UNK_27F)
        clearflag(FLAG_UNK_996)
    _016E:
        if (flag(FLAG_GAME_CLEAR)) {
            getphonebookrematch(PHONE_CONTACT_BUGSY, VAR_TEMP_x4001)
            if (var(VAR_TEMP_x4001) != 0) {
                setflag(FLAG_UNK_288)
                end
            }
            getweekday(VAR_TEMP_x4000)
            if (var(VAR_TEMP_x4000) == 1) { goto(_01C3) }
            if (var(VAR_TEMP_x4000) == 3) { goto(_01C3) }
            if (var(VAR_TEMP_x4000) == 5) { goto(_01C3) }
            setflag(FLAG_UNK_288)
            end
        _01C3:
            clearflag(FLAG_UNK_288)
            end
        }
        setflag(FLAG_UNK_288)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

