script scr_seq_D22R0101_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GOT_QUICK_CLAW_FROM_NATIONAL_PARK_WOMAN)) {
        npcmsg(msg_0062_D22R0101_00002)
        if (!itemspace(ITEM_QUICK_CLAW, 1)) {
            callstd(std_bag_is_full)
            closemessage
            releaseall
            end
        }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_QUICK_CLAW_FROM_NATIONAL_PARK_WOMAN)
    }
    npcmsg(msg_0062_D22R0101_00004)
    waitbuttonpress
    closemessage
    releaseall
    end
}

