    } else {
        npcmsg("My mom will finally participate.\r"
               "I was starting to worry because she\n"
               "never exercises.\r")
    }
    closemessage
    applymovement(obj_D49R0102_gsmiddleman1, PokeathlonDome_Interior_2F_Movement_0610)
