script scr_seq_D49R0102_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getpokeathlonstat(11, VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) >= 500) {
        bufferplayersname(0)
        npcmsg("Pokéathlete {STRVAR_1 3, 0, 0} is\n"
               "always splendid!\r"
               "I can’t take my eyes off\n"
               "that Pokéathlete!\r"
               "...\n"
               "Wait... Wow! Is that really you?")
    } else {
        npcmsg("The Pokéathlon is all about scores.\r"
               "No one knows who’s going to win\n"
               "until the last moment!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

