    if (var(VAR_TEMP_x4000) >= 800) {
        npcmsg("Ahh... My son!\n"
               "I’m so sad to hear that.\r"
               "Let me hear you say you want to be\n"
               "like your dad...\r")
    } else {
        npcmsg("Don’t you dare underestimate your mom.\n"
               "The look on her face when she was\f"
               "selling things at a bargain...\r"
               "It still gives me shivers!\r")
    }
    closemessage
    applymovement(obj_D49R0102_gsmiddleman1, PokeathlonDome_Interior_2F_Movement_0618)
    waitmovement
    releaseall
    end
}

