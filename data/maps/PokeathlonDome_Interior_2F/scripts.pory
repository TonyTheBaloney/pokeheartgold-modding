script scr_seq_D49R0102_010 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getpokeathlonstat(11, VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) >= 800) {
        bufferplayersname(0)
        npcmsg("I’ll grow up to be a great\n"
