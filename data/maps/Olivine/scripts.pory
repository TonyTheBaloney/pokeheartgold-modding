    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_player, Olivine_Movement_057C)
        applymovement(obj_T26_gsmiddleman1, Olivine_Movement_0590)
    } else {
        applymovement(obj_player, Olivine_Movement_0568)
        applymovement(obj_T26_gsmiddleman1, Olivine_Movement_0590)
    }
    waitmovement
    waitfollowingpokemonmovement
