script scr_seq_R34_005 {
    followmonresetmovement
    lockall
    setvar(VAR_TEMP_x4004, 777)
    applymovement(obj_R34_gswoman3_3, Route34_Movement_0930)
    stopbgm(0)
    playbgm(SEQ_GS_EYE_J_SHOUJO)
    waitmovement
    npcmsg("Kate: I must pay you back for taking\n"
           "care of my sisters!\r")
    closemessage
    stopbgm(0)
    trainerbattle(TRAINER_ACE_TRAINER_F_KATE, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0912) }
    setvar(VAR_UNK_4097, 2)
_09A0:
    npcmsg("Kate: You are so strong.\n"
           "We lost with no excuses...\r"
           "Here, take this!\r")
    if (!itemspace(ITEM_POWER_HERB, 1)) {
        callstd(std_bag_is_full)
        closemessage
        goto(_09D5)
        end
    }
    callstd(std_give_item_verbose)
    setvar(VAR_UNK_4097, 3)
    npcmsg(msg_0384_R34_00032)
    waitbuttonpress
    closemessage
_09D5:
    if (var(VAR_TEMP_x4004) == 777) {
        releaseall
    } else {
        releaseall
    }
    end
}

text msg_0384_R34_00032 {
    "Kate: I’m sorry we jumped you.\r"
    "We never expected anyone to find \n"
    "us here.\f"
    "You sure startled us."
}

