script Route34_EventScript_KateTrigger {
    followmonresetmovement
    lockall
    setvar(VAR_TEMP_x4004, 777)
    applymovement(obj_R34_gswoman3_3, Route34_Movement_KateWalkUp)
    stopbgm(0)
    playbgm(SEQ_GS_EYE_J_SHOUJO)
    waitmovement
    npcmsg("Kate: I must pay you back for taking\n"
           "care of my sisters!\r")
    closemessage
    stopbgm(0)
    trainerbattle(TRAINER_ACE_TRAINER_F_KATE, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0912) }
    setvar(VAR_UNK_4097, 2)
_09A0:
    npcmsg("Kate: You are so strong.\n"
           "We lost with no excuses...\r"
           "Here, take this!\r")
    if (!itemspace(ITEM_POWER_HERB, 1)) {
        callstd(std_bag_is_full)
        closemessage
        goto(_09D5)
        end
    }
    callstd(std_give_item_verbose)
    setvar(VAR_UNK_4097, 3)
    npcmsg(msg_0384_R34_00032)
    waitbuttonpress
    closemessage
_09D5:
    if (var(VAR_TEMP_x4004) == 777) {
        releaseall
    } else {
        releaseall
    }
    end
}

text msg_0384_R34_00032 {
    "Kate: I’m sorry we jumped you.\r"
    "We never expected anyone to find \n"
    "us here.\f"
    "You sure startled us."
}

script Route34_EventScript_Irene {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_4097) == 1) {
        npcmsg("Irene: I’ll tell my sister about you!")
    } else {
        npcmsg("Irene: How did you find this place?\f"
               "This is our hideout!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route34_EventScript_Jenn {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_4097) == 1) {
        npcmsg(msg_0384_R34_00026)
    } else {
        npcmsg("Jenn: You and us... We might as well\n"
               "become friends!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route34_EventScript_Kate {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    setvar(VAR_TEMP_x4004, 555)
    if (var(VAR_UNK_4097) == 2) { goto(_09A0) }
    npcmsg(msg_0384_R34_00032)
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route34_EventScript_TrainerTips1 {
    trainertipsex(3, "Trainer Tips\r"
                     "North to Goldenrod City\n"
                     "The Radio Tower at Goldenrod is giving\f"
                     "away Radio Cards.\r"
                     "Answer their questions and receive a\n"
                     "Radio Card!")
    end
}

script Route34_EventScript_TrainerTips2 {
    trainertipsex(2, "Pokémon Day Care\n"
                     "Let us raise your Pokémon for you!")
    end
}

script Route34_EventScript_RouteSign {
    directionsignpostex(1, 4, "Rt. 34\n"
                              "South to Azalea Town")
    end
}

mapscripts Route34_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Route34_OnTransition
    INIT_SCRIPT_ON_FRAME_TABLE [
