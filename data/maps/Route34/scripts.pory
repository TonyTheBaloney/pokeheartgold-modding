script scr_seq_R34_000 {
    getfriendsprite(VAR_OBJ_0)
    checkdaycareegg(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) != 0) {
        setobjectmovementtype(obj_R34_gsoldman1, 16)
    } else {
        setobjectmovementtype(obj_R34_gsoldman1, 15)
    }
    if (!flag(FLAG_UNK_189)) {
        checkbadge(BADGE_PLAIN, VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) != 0) {
            getweekday(VAR_TEMP_x4000)
            if (var(VAR_TEMP_x4000) == 3) { goto(_00A9) }
            if (var(VAR_TEMP_x4000) == 4) { goto(_00A9) }
        }
        setflag(FLAG_HIDE_CAMERON)
        goto(_00AD)
    _00A9:
        clearflag(FLAG_HIDE_CAMERON)
    _00AD:
        getcurrenttimeofday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 3) { goto(_00D5) }
        if (var(VAR_TEMP_x4000) == 4) { goto(_00D5) }
        clearflag(FLAG_UNK_1D1)
        setflag(FLAG_UNK_1D2)
        end
    _00D5:
        clearflag(FLAG_UNK_1D2)
        setflag(FLAG_UNK_1D1)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script scr_seq_R34_001 {
    followmonresetmovement
    lockall
    applymovement(obj_R34_gsoldman1, Route34_Movement_0130)
    applymovement(obj_player, Route34_Movement_0140)
    waitmovement
    npcmsg("I have an idea!\n"
           "I’ll give you our numbers.\r"
           "Then you can check on the Pokémon\n"
           "we raise for you.\r")
    bufferplayersname(0)
    registergearnumber(PHONE_CONTACT_DAY_C_MAN)
    npcmsg("{STRVAR_1 3, 0, 0} registered the\n"
           "Day-Care Man in the Pokégear!")
    playfanfare(SEQ_ME_POKEGEAR_REGIST)
    waitfanfare
    registergearnumber(PHONE_CONTACT_DAY_C_LADY)
    npcmsg("{STRVAR_1 3, 0, 0} registered the\n"
           "Day-Care Lady in the Pokégear!")
    playfanfare(SEQ_ME_POKEGEAR_REGIST)
    waitfanfare
    npcmsg("Call us from time to time when you\n"
           "give us your Pokémon to raise.\r"
           "I’ll be happy to have a use for this\n"
           "Pokégear my grandchild gave me.\r")
    closemessage
    applymovement(obj_R34_gsoldman1, Route34_Movement_014C)
    waitmovement
    setvar(VAR_UNK_408E, 3)
    releaseall
    end
}

