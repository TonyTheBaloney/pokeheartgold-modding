        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_00F7) }
        end
    }
    bufferplayersname(0)
    gendermsgbox("Long time no see, {STRVAR_1 3, 0, 0}.\n"
                 "I’ve been waiting for you.\f"
                 "This is from Professor Elm.\r"
                 "The thing is...we would like you to\n"
                 "take care of an Egg! {YESNO 0}", "Long time no see, {STRVAR_1 3, 0, 0}.\n"
                                                   "I’ve been waiting for you.\f"
                                                   "This is from Professor Elm.\r"
                                                   "The thing is...we would like you to\n"
                                                   "take care of an Egg! {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_00F7) }
_007D:
    getpartycount(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 6) { goto(_0106) }
    givetogepiegg
    setflag(FLAG_GOT_EGG_FROM_ELMS_ASSISTANT)
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Egg from the assistant!")
    playfanfare(SEQ_ME_TAMAGO_GET)
    waitfanfare
    gendermsgbox("After you left, Professor Elm received\n"
                 "a phone call. I have no idea what they\f"
                 "were talking about.\r"
                 "But, after a while, Professor Elm\n"
                 "suddenly cried out, “I can’t think of\f"
                 "anyone more suited than {STRVAR_1 3, 0, 0}!”\r"
                 "Then he insisted that I hand this Egg\n"
                 "to you.\r"
                 "That’s how I came here to deliver the\n"
                 "Egg to you.\r"
                 "It seems that a Pokémon will hatch from\n"
                 "it only when you keep it in your party\f"
                 "of Pokémon.\r"
                 "That’s another reason we’ve\n"
                 "chosen you, {STRVAR_1 3, 0, 0}.\r"
                 "Please take care of it!\r", "After you left, Professor Elm received\n"
                                              "a phone call. I have no idea what they\f"
                                              "were talking about, but after a while,\f"
                                              "Professor Elm suddenly cried out,\f"
                                              "“I can’t think of anyone more suited\f"
                                              "for that than {STRVAR_1 3, 0, 0}!”\r"
                                              "Then he insisted that I hand this Egg\n"
                                              "to you.\r"
                                              "That’s how I came here to deliver the\n"
                                              "Egg to you.\r"
                                              "It seems that a Pokémon will hatch from\n"
                                              "it only when you keep it in your party\f"
                                              "of Pokémon.\r"
                                              "That’s another reason we’ve\n"
                                              "chosen you, {STRVAR_1 3, 0, 0}.\r"
                                              "Please take care of it!\r")
    closemessage
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_T22FS0101_assistantm, Violet_Pokemart_Movement_ScientistWalkDownLeft)
    } else {
        applymovement(obj_T22FS0101_assistantm, Violet_Pokemart_Movement_ScientistWalkLeftDown)
    }
    waitmovement
    playse(SEQ_SE_DP_KAIDAN2)
    removeobject(obj_T22FS0101_assistantm)
    waitse(SEQ_SE_DP_KAIDAN2)
    setflag(FLAG_HIDE_VIOLET_SHOP_LAB_AIDE)
    releaseall
    setvar(VAR_SCENE_VIOLET_CITY_OW, 3)
    clearflag(FLAG_HIDE_VIOLET_KIMONO_GIRL)
    clearflag(FLAG_HIDE_ELMS_LAB_AIDE)
    setvar(VAR_SCENE_ELMS_LAB, 7)
    end
_00F7:
    npcmsg("What?\n"
           "I never expected you’d say no!\f"
           "You must be kidding, right?\r"
           "Professor Elm really wants you to\n"
           "take care of it...\n"
           "\n")
    waitbuttonpress
    closemessage
    releaseall
    setflag(FLAG_UNK_06F)
    end
_0106:
    npcmsg("Your party is full.\n"
           "You cannot take the Egg yet.\f"
           "I’ll wait here for you.")
    waitbuttonpress
    closemessage
    releaseall
    setflag(FLAG_UNK_06F)
    end
}

movement Violet_Pokemart_Movement_ScientistWalkLeftDown {
    walk_left * 2
    walk_down * 3
}

movement Violet_Pokemart_Movement_ScientistWalkDownLeft {
    walk_down * 2
    walk_left * 2
    walk_down
}

script Violet_Pokemart_EventScript_OldWoman {
    simplenpcmsg("When you first catch a Pokémon,\n"
                 "it may be weak.\r"
                 "But it will eventually grow to\n"
                 "be strong.\r"
                 "It’s important to treat Pokémon\n"
                 "with love.")
    end
}

script Violet_Pokemart_EventScript_AceTrainerM {
    simplenpcmsg("Pokémon can hold items like a Potion\n"
                 "or an Antidote.\r"
                 "But they don’t appear to know how\n"
                 "to use man-made items.")
    end
}

