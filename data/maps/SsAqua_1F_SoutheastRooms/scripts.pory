}

script SsAqua_1F_SoutheastRooms_EventScript_Trigger {
    followmonresetmovement
    lockall
    applymovement(obj_player, SsAqua_1F_SoutheastRooms_Movement_PlayerExclamation)
    waitmovement
    npcmsg("A comfy bed!\n"
           "Time to sleep...\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    playfanfare(SEQ_ME_ASA)
    waitfanfare
    healparty
    leaveoverworld
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    npcmsg("Ah, refreshed and restored!\r")
    closemessage
    followmonisactive(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) != 0) {
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(56)
    }
    applymovement(obj_player, SsAqua_1F_SoutheastRooms_Movement_PlayerJumpRight)
    waitmovement
    if (var(VAR_TEMP_x4002) != 0) {
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
    }
    if (var(VAR_SCENE_SS_AQUA) >= 7) {
        if (!flag(FLAG_BOAT_ARRIVED)) {
            playse(SEQ_SE_DP_PINPON)
            waitse(SEQ_SE_DP_PINPON)
            setflag(FLAG_BOAT_ARRIVED)
            if (var(VAR_BOAT_DIRECTION) == 1) {
                npcmsg("Fast Ship S.S. Aqua\n"
                       "has arrived in Vermilion City.")
            } else {
                npcmsg("Fast Ship S.S. Aqua\n"
                       "has arrived in Olivine City.")
            }
            waitbuttonpress
            closemessage
        }
        releaseall
        end
    }
    releaseall
    end
}

movement SsAqua_1F_SoutheastRooms_Movement_PlayerExclamation {
    face_down * 2
    delay_16
    emote_exclamation_mark
}

movement SsAqua_1F_SoutheastRooms_Movement_PlayerJumpRight {
    face_right * 2
    jump_near_fast_right
}

