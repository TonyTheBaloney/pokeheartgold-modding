    face_up * 2
    walk_fast_up * 2
    face_right * 2
    walk_fast_right * 4
    face_down * 2
    walk_fast_down
}

movement SsAqua_1F_SoutheastRooms_Movement_StanlyWalkUp {
    face_up * 2
    walk_fast_up * 7
}

movement SsAqua_1F_SoutheastRooms_Movement_StanlyJumpRight {
    emote_exclamation_mark
    delay_8
    face_left * 2
    face_right * 2
    face_left * 2
    lock_dir
    jump_far_right
    unlock_dir
}

