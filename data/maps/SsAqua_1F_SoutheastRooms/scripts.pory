text msg_0261_P01R0303_00005 {
    "What? You’re saying I was asleep?\n"
    "Show some respect!\r"
    "A crewman on duty would never\n"
    "be so unmindful as to take a nap\f"
    "in a place like this!\r"
    "I resent your implication!\n"
    "I challenge you!\r"
}

text msg_0261_P01R0303_00006 {
    "Losing to you has woken me up.\n"
    "I will mend my ways and work hard.\r"
    "Can you keep it a secret that I was\n"
    "taking a nap here?\f"
    "Please don’t tell the Captain.\r"
}

movement SsAqua_1F_SoutheastRooms_Movement_StanlyJumpLeft {
    emote_exclamation_mark
    delay_8
    face_right * 2
    face_left * 2
    face_right * 2
    lock_dir
    jump_far_left
    unlock_dir
}

