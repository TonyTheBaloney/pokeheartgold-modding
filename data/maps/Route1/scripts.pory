script Route1_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 1) { goto(_0050) }
        if (var(VAR_TEMP_x4000) == 2) { goto(_0050) }
        if (var(VAR_TEMP_x4000) == 6) { goto(_0050) }
        setflag(FLAG_HIDE_CAMERON)
        end
    _0050:
        clearflag(FLAG_HIDE_CAMERON)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

