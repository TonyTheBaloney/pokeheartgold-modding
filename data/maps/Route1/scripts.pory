movement Route1_Movement_0184 {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Route1_Movement_PlayerWalkUp {
    walk_up * 3
    walk_in_place_down
}

movement Route1_Movement_PlayerWalkUpLeft {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Route1_Movement_PlayerWalkUpRight {
