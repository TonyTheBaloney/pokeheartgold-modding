}

movement BattleFrontier_BattleCastle_Movement_07C8 {
    walk_up * 2
    delay_8
    walk_up
}

movement BattleFrontier_BattleCastle_Movement_07D8 {
    walk_up * 2
    delay_8
    walk_up
}

script scr_seq_D32R0501_006 {
    simplenpcmsg("Listen carefully!\r"
                 "If your Pokémon win without taking\n"
                 "damage, you earn more CP.\f"
                 "The more, the merrier!\f"
                 "Look at me. I don’t have much...")
    end
}

script scr_seq_D32R0501_007 {
    simplenpcmsg("Listen!\r"
                 "You can earn more Castle Points or CP\n"
                 "by facing higher-level opponents.\r"
                 "This is what they call high risk,\n"
                 "high return!")
    end
}

script scr_seq_D32R0501_008 {
    simplenpcmsg("Before every battle, you should check\n"
                 "the opponent’s lineup.\r"
                 "Don’t be cheap with your CP.\n"
                 "It’s like that old saying goes about\f"
                 "knowing your enemy.\r"
                 "“Unless you enter the enemy’s lair,\n"
                 "you cannot take their prize.”\r"
                 "...\f"
                 "That’s not the right old saying!")
    end
}

script scr_seq_D32R0501_009 {
    simplenpcmsg("Mr. Darach...\r"
                 "His feelings for Lady Caitlin are\n"
                 "all bottled up...\r"
                 "Oh, how I pine for him...")
    end
}

script scr_seq_D32R0501_010 {
    simplenpcmsg("At first, you can only use CP for\n"
                 "restoring HP.\r"
                 "But you can spend CP to rank up.\n"
                 "Then, you can even restore PP!")
    end
}

script scr_seq_D32R0501_011 {
    simplenpcmsg("If you lose, your entire stock of CP\n"
                 "is cleaned out to zero!\r"
                 "This is the rule at the Battle Castle.")
    end
}

script scr_seq_D32R0501_012 {
    simplenpcmsg("My dream is to wear a beautiful dress\n"
                 "and live in a castle!\r"
                 "That’s not what I meant to say...\r"
                 "My dream is to live in a castle with\n"
                 "someone who wears a beautiful dress!")
    end
}

