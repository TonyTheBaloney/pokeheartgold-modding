}

movement BattleFrontier_BattleCastle_Movement_060C {
    walk_left * 6
    set_invisible
}

movement BattleFrontier_BattleCastle_Movement_0618 {
    walk_left * 3
    walk_up
    walk_left * 3
    set_invisible
}

movement BattleFrontier_BattleCastle_Movement_062C {
    walk_left * 5
    set_invisible
}

movement BattleFrontier_BattleCastle_Movement_0638 {
    walk_left * 2
    walk_up
    walk_left * 3
    set_invisible
}

movement BattleFrontier_BattleCastle_Movement_064C {
    walk_faster_right * 6
    set_visible
    face_left
}

movement BattleFrontier_BattleCastle_Movement_065C {
    walk_faster_right * 6
    walk_faster_down
    set_visible
    face_left
}

movement BattleFrontier_BattleCastle_Movement_0670 {
    walk_faster_right * 5
    set_visible
}

movement BattleFrontier_BattleCastle_Movement_067C {
    walk_faster_down
    walk_faster_right * 5
    set_visible
}

script(local) _068C {
    npcmsg("Welcome to the Battle Castle!\r"
           "I am your guide to the Single and\n"
           "Double Battle challenges.\r"
           "Please be aware that these challenges\n"
           "are designed for a single Trainer.\r")
    return
_0691:
    npcmsg("Welcome to the Battle Castle!\r"
           "I am your guide to the Multi Battle\n"
           "challenge.\r"
           "Please be aware that this challenge\n"
           "requires two Trainers.\r")
    return
_0696:
    npcmsg("Which challenge would you\n"
           "like to take? {YESNO 0}")
    touchscreenmenuhide
    menuinit(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(38, 255, 0)
    menuitemadd(39, 255, 1)
    return
_06B5:
    npcmsg("Would you like to take the Battle\n"
           "Castle Multi Battle challenge? {YESNO 0}")
    touchscreenmenuhide
    menuinit(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(40, 255, 4)
    return
_06CC:
    npcmsg("At the Battle Castle, you may take a\n"
           "Single or Double Battle challenge.\r"
           "Here, you are provided with Castle\n"
           "Points (CP) that you must manage.\r"
           "The CP are used for healing Pokémon,\n"
           "renting items or Berries, and so on.\r"
           "CP are earned by winning matches.\n"
           "The amount varies by how you win.\r"
           "The objective is to keep a winning\n"
           "streak alive while managing your CP.\r"
           "If you manage to win seven matches in\n"
           "a row, you will earn Battle Points (BP).\r"
           "If you want to interrupt your\n"
           "challenge, please save the game.\r"
           "If you don’t save, you will be\n"
           "disqualified from your challenge.\r"
           "Please be aware of that!\r")
    return
_06D1:
    npcmsg("You may team up with a friend for a\n"
           "Multi Battle challenge.\r"
           "Both Trainers are provided with Castle\n"
           "Points (CP) that must be managed.\r"
           "The CP is used for healing Pokémon,\n"
           "renting items or Berries, and so on.\r"
           "Trainers can use their CP on not only\n"
           "their own Pokémon, but also their\f"
           "partner’s.\r"
           "Both Trainers earn CP by winning\n"
           "matches.\r"
           "The objective is to keep a winning\n"
           "streak alive while managing your CP.\r"
           "If you manage to win seven matches in\n"
           "a row, you will earn Battle Points (BP).\r"
           "Please note: a Battle Castle Multi\n"
           "Battle challenge can’t be interrupted.\r")
    return
}

script scr_seq_D32R0501_001 {
    checkfieldheapfreesize(0)
    setvar(VAR_TEMP_x4003, 1)
    setvar(VAR_UNK_4147, 0)
    npcmsg("We’ve missed you!\r"
           "You must save the game before you\n"
           "resume your challenge. Please wait.")
    call(_046A)
    call(_06FD)
    goto(_04CB)
    end
_06FD:
    addwaitingicon
    savegamenormal(VAR_SPECIAL_RESULT)
    removewaitingicon
    playse(SEQ_SE_DP_SAVE)
    waitse(SEQ_SE_DP_SAVE)
    return
}

script scr_seq_D32R0501_002 {
    lockall
    faceplayer
    npcmsg("Excuse me!\r"
           "You didn’t save before you quit your\n"
           "challenge last time.\r"
           "Because of that, you have been\n"
           "disqualified from your challenge!\r")
    battlecastleresetstreak(VAR_UNK_4148)
    compare(VAR_BATTLE_CASTLE_PRINT_PROGRESS, 1)
    callifeq(_073C)
    compare(VAR_BATTLE_CASTLE_PRINT_PROGRESS, 3)
    callifeq(_0744)
    goto(_0126)
    end
_073C:
    setvar(VAR_BATTLE_CASTLE_PRINT_PROGRESS, 0)
    return
_0744:
    setvar(VAR_BATTLE_CASTLE_PRINT_PROGRESS, 2)
    return
}

script scr_seq_D32R0501_003 {
    compare(VAR_UNK_4148, 0)
