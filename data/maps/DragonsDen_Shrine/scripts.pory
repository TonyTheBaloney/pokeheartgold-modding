movement DragonsDen_Shrine_Movement_PlayerWalkUp1 {
    walk_up * 8
}

movement DragonsDen_Shrine_Movement_ElderFaceRight1 {
    delay_8 * 2
    face_right
    delay_8 * 2
}

movement DragonsDen_Shrine_Movement_ElderFaceDown1 {
    face_down
}

movement DragonsDen_Shrine_Movement_PlayerExclamation {
    delay_8
    emote_exclamation_mark
    face_down
    delay_8 * 8
    face_left
}

movement DragonsDen_Shrine_Movement_ClairWalkUpLeft {
    delay_8 * 4
    walk_up * 8
    walk_left
    walk_up * 2
    face_right
}

movement DragonsDen_Shrine_Movement_ClairWalkLeft1 {
    delay_8
    lock_dir
    walk_fast_left
}

movement DragonsDen_Shrine_Movement_ClairWalkLeft2 {
    delay_8
    walk_slow_left
}

movement DragonsDen_Shrine_Movement_ElderWalkDownLeft {
    delay_8
    walk_slow_down
    walk_slow_left
}

movement DragonsDen_Shrine_Movement_ClairExclamation {
    emote_exclamation_mark
}

movement DragonsDen_Shrine_Movement_ClairWalkRight {
    walk_right * 2
}

movement DragonsDen_Shrine_Movement_ElderFaceRight2 {
    delay_8 * 2
    face_right
}

movement DragonsDen_Shrine_Movement_ElderWalkUpRight {
    walk_slow_up
    walk_slow_right
