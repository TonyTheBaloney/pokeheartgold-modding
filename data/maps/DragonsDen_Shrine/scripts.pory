}

movement DragonsDen_Shrine_Movement_PlayerFaceUp {
    delay_16 * 2
    face_up
}

movement DragonsDen_Shrine_Movement_ClairMove {
    unlock_dir
    delay_16 * 2
    face_up
}

movement DragonsDen_Shrine_Movement_ClairWalkDownRight {
    lock_dir
    walk_down
    unlock_dir
    walk_faster_down * 3
    walk_faster_right
    walk_faster_down * 4
}

movement DragonsDen_Shrine_Movement_ElderFaceDown2 {
    walk_in_place_down
}

script DragonsDen_Shrine_EventScript_Elder {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_DRATINI_FROM_MASTER_LONG_AGO)) { goto(_053D) }
    if (flag(FLAG_GOT_DRATINI_FROM_MASTER_JUST_NOW)) { goto(_052E) }
    if (flag(FLAG_GOT_TM59_FROM_CLAIR)) { goto(_04A6) }
    getgameversion(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 7) {
        npcmsg(msg_0130_D44R0103_00020)
    } else {
        npcmsg("There is a huge waterfall deep in the\n"
               "cave there. It is said that LUGIA\r"
               "rests in the deep end of the\n"
               "waterfall basin...\r"
               "You need a Silver Wing to reach the\n"
               "waterfall basin, I’ve heard...")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
_04A6:
    npcmsg("Hm... Good to see you here.\r"
           "Your arrival is most fortunate.\n"
           "I have something for you.\r"
           "Take this DRATINI as proof that I\n"
           "now know your worth.\r")
    getpartycount(VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_x8005) != 6) { goto(_04C3) }
    npcmsg("Hm? Your party is full.")
    goto(_0548)
_04C3:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "DRATINI from the Master!")
    playfanfare(SEQ_ME_SHINKAOME)
    waitfanfare
    givemon(SPECIES_DRATINI, 15, 0, 0, 0, VAR_SPECIAL_RESULT)
    if (!flag(FLAG_FAILED_DRAGONS_DEN_QUIZ)) {
        setmonmove(VAR_SPECIAL_x8005, 0, MOVE_EXTREME_SPEED)
    }
    npcmsg("Give a nickname to the\n"
           "DRATINI you received? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
    } else {
        closemessage
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        nicknameinput(VAR_SPECIAL_x8005, VAR_SPECIAL_RESULT)
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
    }
_052E:
    setflag(FLAG_GOT_DRATINI_FROM_MASTER_JUST_NOW)
    npcmsg("Dragon Pokémon are symbolic of\n"
           "our clan.\r"
           "You have shown that you can be\n"
           "entrusted with one.")
    waitbuttonpress
    closemessage
    releaseall
    end
_053D:
    npcmsg("Clair appears to have learned an\n"
           "invaluable lesson from you.\r"
           "I thank you as her grandfather.")
    waitbuttonpress
    closemessage
    releaseall
    end
_0548:
    waitbuttonpress
    closemessage
    releaseall
    end
}

script DragonsDen_Shrine_EventScript_OldMan1 {
    simplenpcmsg("It’s been quite some time since a\n"
                 "Trainer has gained our Master’s\f"
                 "rare approval.\r"
                 "In fact, not since Master Lance.")
    end
}

script DragonsDen_Shrine_EventScript_OldMan2 {
    simplenpcmsg("You know young Master Lance?\r"
                 "He looks so much like our Master\n"
                 "did in his youth.\f"
                 "It’s in their blood.")
    end
}

script DragonsDen_Shrine_EventScript_PokefanM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 5)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, DragonsDen_Shrine_Movement_PlayerWalkRightUp)
        applymovement(obj_D44R0103_gsmiddleman1, DragonsDen_Shrine_Movement_PokefanMFaceUp)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, DragonsDen_Shrine_Movement_PlayerWalkUp2)
    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_player, DragonsDen_Shrine_Movement_PlayerWalkUpRight)
        applymovement(obj_D44R0103_gsmiddleman1, DragonsDen_Shrine_Movement_PokefanMFaceUp)
    } else {
        applymovement(obj_player, DragonsDen_Shrine_Movement_PlayerWalkUpLeft)
        applymovement(obj_D44R0103_gsmiddleman1, DragonsDen_Shrine_Movement_PokefanMFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, DragonsDen_Shrine_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(46)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement DragonsDen_Shrine_Movement_PlayerWalkRightUp {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement DragonsDen_Shrine_Movement_PlayerWalkUp2 {
    walk_up * 3
    walk_in_place_down
}

movement DragonsDen_Shrine_Movement_PlayerWalkUpLeft {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement DragonsDen_Shrine_Movement_PlayerWalkUpRight {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement DragonsDen_Shrine_Movement_PokefanMFaceUp {
    delay_8
    walk_in_place_up
}

movement DragonsDen_Shrine_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

