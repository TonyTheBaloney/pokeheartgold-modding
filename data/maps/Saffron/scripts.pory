script Saffron_OnTransition {
    if (flag(FLAG_UNK_0A0)) {
        clearflag(FLAG_UNK_0A0)
    }
    if (!flag(FLAG_UNK_189)) {
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 1) { goto(_00B5) }
        if (var(VAR_TEMP_x4000) == 2) { goto(_00B5) }
        if (var(VAR_TEMP_x4000) == 3) { goto(_00B5) }
        if (var(VAR_TEMP_x4000) == 5) { goto(_00BF) }
        if (var(VAR_TEMP_x4000) == 6) { goto(_00BF) }
        setflag(FLAG_HIDE_CAMERON)
        setflag(FLAG_UNK_27F)
        end
    _00B5:
        clearflag(FLAG_HIDE_CAMERON)
        setflag(FLAG_UNK_27F)
        end
    _00BF:
        setflag(FLAG_HIDE_CAMERON)
        clearflag(FLAG_UNK_27F)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script Saffron_EventScript_PokefanM2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_034C) }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0360) }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, Saffron_Movement_PlayerWalkLeftUp)
        applymovement(obj_T11_gsmiddleman1_2, Saffron_Movement_PokefanMFaceUp)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, Saffron_Movement_PlayerWalkUp)
    } else {
        applymovement(obj_player, Saffron_Movement_PlayerWalkUpRight)
        applymovement(obj_T11_gsmiddleman1_2, Saffron_Movement_PokefanMFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, Saffron_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(52)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Saffron_Movement_PlayerWalkLeftUp {
    walk_left
    walk_up * 2
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement Saffron_Movement_PlayerWalkUp {
    walk_up * 3
    walk_in_place_down
}

movement Saffron_Movement_PlayerWalkUpRight {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement Saffron_Movement_PokefanMFaceUp {
    delay_8
    walk_in_place_up
}

movement Saffron_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

