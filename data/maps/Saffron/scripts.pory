script scr_seq_T11_002 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_HIDE_SAFFRON_CITY_COPYCAT_HOUSE_CLEFAIRY_DOLL)) {
        npcmsg("The Copycat girl looked unhappy.\r"
               "She said she lost her cherished\n"
               "Poké Doll--CLEFAIRY.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("This is the house of the Copycat girl.\r"
           "She is so good at being a copycat\n"
           "of the way people talk that it’ll\f"
           "confuse you when you talk to her.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T11_000 {
    simplenpcmsg("Our city was featured on a\n"
                 "radio show.\r"
                 "It’s nice to hear praise for your\n"
                 "city, but it’s a bit embarrassing, too.")
    end
}

script scr_seq_T11_001 {
    simplenpcmsg("I went to the Gym, raring for battles\n"
                 "against Trainers...\r"
                 "It turns out, I stumbled into the\n"
                 "unused Gym next door.\f"
                 "Boy, I was pretty embarrassed.")
    end
}

script scr_seq_T11_003 {
    simplenpcmsg("Going into an alley for the first time\n"
                 "makes me sorta anxious.")
    end
}

script scr_seq_T11_004 {
    simplenpcmsg("Chomp... Chew...\r"
                 "The manager of the Power Plant\n"
                 "used to be a repairman in a\f"
                 "small factory.\r"
                 "Chew... Chew...\r"
                 "His hard work has taken him up the\n"
                 "ladder to eventually become the\f"
                 "manager of the Power Plant.\f"
                 "Chew... Gulp...\r"
                 "Quite impressive, don’t you think?\n"
                 "Haaah, I’m full!")
    end
}

script scr_seq_T11_005 {
    simplenpcmsg("This is Silph Co., famous for\n"
                 "Pokémon merchandise.\r"
                 "In the past, Team Rocket wanted the\n"
                 "company because of that.")
    end
}

script scr_seq_T11_006 {
    simplenpcmsg("There’s a place called Trainer House\n"
                 "in Viridian where Trainers gather from\f"
                 "all over the place.")
    end
}

script scr_seq_T11_007 {
    simplenpcmsg("You came out from Johto?\r"
                 "You can zip back home by hopping on\n"
                 "the Magnet Train.")
    end
}

script scr_seq_T11_008 {
    trainertipsex(2, "Kanto-Johto Magnet Train Line\n"
                     "Saffron City Station")
    end
}

script scr_seq_T11_009 {
