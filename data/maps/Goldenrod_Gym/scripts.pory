script Goldenrod_Gym_OnTransition {
    getphonebookrematch(PHONE_CONTACT_WHITNEY, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 0) {
        setflag(FLAG_HIDE_GOLDENROD_GYM_WHITNEY)
        end
    }
    if (!flag(FLAG_GAME_CLEAR)) { goto(_0100) }
    checkregisteredphonenumber(PHONE_CONTACT_WHITNEY, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_00AF) }
    getcurrenthour(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 12) {
        setflag(FLAG_HIDE_GOLDENROD_GYM_WHITNEY)
    } elif (var(VAR_TEMP_x4000) == 13) {
        setflag(FLAG_HIDE_GOLDENROD_GYM_WHITNEY)
    } elif (var(VAR_TEMP_x4000) == 14) {
        setflag(FLAG_HIDE_GOLDENROD_GYM_WHITNEY)
    } elif (var(VAR_TEMP_x4000) == 15) {
        setflag(FLAG_HIDE_GOLDENROD_GYM_WHITNEY)
    } else {
        goto(_0100)
    }
    end
_00AF:
    getcurrenthour(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 18) {
        setflag(FLAG_HIDE_GOLDENROD_GYM_WHITNEY)
    } elif (var(VAR_TEMP_x4000) == 19) {
        setflag(FLAG_HIDE_GOLDENROD_GYM_WHITNEY)
    } elif (var(VAR_TEMP_x4000) == 20) {
        setflag(FLAG_HIDE_GOLDENROD_GYM_WHITNEY)
    } else {
        goto(_0100)
    }
    end
_0100:
    clearflag(FLAG_HIDE_GOLDENROD_GYM_WHITNEY)
    end
}

script Goldenrod_Gym_EventScript_Whitney {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_PLAIN, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        if (!flag(FLAG_GOT_TM45_FROM_WHITNEY)) { goto(_01C4) }
        npcmsg("Whitney: Ah, that was a good cry!\r"
               "Come for a visit again! Bye-bye!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_UNK_0B7)) { goto(_01A0) }
    if (var(VAR_UNK_410A) != 1) {
        npcmsg("Whitney: Hi! I’m Whitney!\r"
               "...You!\n"
               "I saw you at the Radio Tower just now.\r"
               "Everyone was into Pokémon, so I got\n"
               "into it, too!\r"
               "Pokémon are super cute!\r"
               "You want to battle?\f"
               "I’m warning you--I’m good!\r")
        closemessage
        trainerbattle(TRAINER_LEADER_WHITNEY, 0, 0, 0)
        checkbattlewon(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            whiteout
            releaseall
            end
        }
        settrainerflag(TRAINER_LASS_CARRIE)
        settrainerflag(TRAINER_LASS_CATHY)
        settrainerflag(TRAINER_BEAUTY_VICTORIA)
        settrainerflag(TRAINER_BEAUTY_SAMANTHA)
        addspecialgamestat(SCORE_EVENT_BADGE_GET)
        movepersonfacing(obj_T25GYM0101_gsgirl1, 13, 0, 15, DIR_NORTH)
    }
    npcmsg("Whitney: Waaaaah!\r"
           "Waaaaah!\r"
           "...Snivel, hic.\n"
           "...You meanie!")
    waitbuttonpress
    closemessage
    releaseall
    setvar(VAR_UNK_410A, 1)
    setflag(FLAG_UNK_084)
    setvar(VAR_UNK_40DA, 1)
    clearflag(FLAG_HIDE_PARK_SOUTH_GATE_POKEATHLON_ENTHUSIASTS_UNLOCKED)
    setflag(FLAG_HIDE_PARK_SOUTH_GATE_POKEATHLON_ENTHUSIASTS_LOCKED)
    end
_01A0:
    npcmsg("Whitney: Sniff...\r"
           "What? What do you want? A Badge?\r"
           "Oh, right. I forgot.\n"
           "Here’s the Plain Badge.\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Plain Badge from Whitney.")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    givebadge(BADGE_PLAIN)
    setvar(VAR_UNK_410A, 2)
    clearflag(FLAG_UNK_084)
    setflag(FLAG_UNK_998)
    npcmsg("Whitney: The Plain Badge lets your\n"
           "Pokémon use Strength outside\f"
           "of battle.\r"
           "Oh, you can have this, too!\r")
_01C4:
    if (!itemspace(ITEM_TM45, 1)) { goto(_01F8) }
    callstd(std_give_item_verbose)
    npcmsg("Whitney: It’s Attract!\n"
           "It makes full use of a Pokémon’s charm.\r"
           "Isn’t it just perfect for a cutie\n"
           "like me?\f"
           "That’s right!\r"
           "I heard that this thing called the\n"
           "Pokéathlon Dome is now open right next\f"
           "to the National Park.\r"
           "You should go try it, since you’re\n"
           "so good at battling with your Pokémon!")
    waitbuttonpress
    closemessage
    setflag(FLAG_GOT_TM45_FROM_WHITNEY)
    releaseall
    end
_01F8:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

script Goldenrod_Gym_EventScript_CathyTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_T25GYM0101_gsgirl1, Goldenrod_Gym_Movement_CathyWalkUp)
    waitmovement
    npcmsg("Oh, no. You made Whitney cry.\r"
           "It’s OK. She’ll stop soon.\n"
           "She always cries when she loses.\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_T25GYM0101_gsgirl1, Goldenrod_Gym_Movement_CathyWalkDown)
    applymovement(obj_player, Goldenrod_Gym_Movement_PlayerWalkUp)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    setflag(FLAG_UNK_0B7)
    releaseall
    end
}

movement Goldenrod_Gym_Movement_CathyWalkUp {
    emote_exclamation_mark
    walk_up * 3
}

movement Goldenrod_Gym_Movement_CathyWalkDown {
    walk_down * 3
    walk_in_place_up
}

movement Goldenrod_Gym_Movement_PlayerWalkUp {
    delay_8
    walk_up
}

script Goldenrod_Gym_EventScript_GymGuide {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_PLAIN, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("You won? Great! I was busy admiring\n"
               "the powerful Trainers here.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Yo! Champ in the making!\r"
           "This Gym is home to Normal-type\n"
           "Pokémon Trainers.\r"
           "I recommend you use Fighting-type\n"
           "Pokémon.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Goldenrod_Gym_EventScript_GymSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_PLAIN, VAR_SPECIAL_RESULT)
    bufferplayersname(0)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Goldenrod City Pokémon Gym")
    } else {
        npcmsg("Goldenrod City Pokémon Gym\r"
               "Leader: Whitney\n"
               "Certified Trainer!\f"
               "{STRVAR_1 3, 0, 0}")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

mapscripts Goldenrod_Gym_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Goldenrod_Gym_OnTransition
}
