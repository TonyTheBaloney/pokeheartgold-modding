script scr_seq_T04_011 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 5)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, Cerulean_Movement_0320)
        applymovement(obj_T04_gsmiddleman1, Cerulean_Movement_036C)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, Cerulean_Movement_0338)
    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_player, Cerulean_Movement_0358)
        applymovement(obj_T04_gsmiddleman1, Cerulean_Movement_036C)
    } else {
        applymovement(obj_player, Cerulean_Movement_0344)
        applymovement(obj_T04_gsmiddleman1, Cerulean_Movement_036C)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, Cerulean_Movement_0378)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(55)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Cerulean_Movement_0320 {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Cerulean_Movement_0338 {
    walk_up * 3
    walk_in_place_down
}

movement Cerulean_Movement_0344 {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Cerulean_Movement_0358 {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement Cerulean_Movement_036C {
    delay_8
    walk_in_place_up
}

movement Cerulean_Movement_0378 {
    walk_right
    walk_up
    face_down
}

