script Cerulean_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 4) { goto(_006F) }
        if (var(VAR_TEMP_x4000) == 0) { goto(_006F) }
        setflag(FLAG_HIDE_CAMERON)
        end
    _006F:
        clearflag(FLAG_HIDE_CAMERON)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script Cerulean_EventScript_Man1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_RESTORED_POWER)) {
        npcmsg("You’re collecting every single kind\n"
               "of Pokémon?\r"
               "That must be quite a challenge, but\n"
               "it sounds fun, too.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Kanto’s Power Plant?\r"
           "It’s near the end of Route 9, the road\n"
           "that heads east from here.\r"
           "I think there was an accident of\n"
           "some sort there.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Cerulean_EventScript_Man2 {
    simplenpcmsg("The cape in the north is a good\n"
                 "place for dates.\r"
                 "Girls like it!\r"
                 "Just between you and me...\n"
                 "Misty, the Gym Leader, is sometimes\f"
                 "there at the cape.\r"
                 "Guess I don’t stand a chance!")
    end
}

script Cerulean_EventScript_Woman {
    simplenpcmsg("My SLOWBRO and I make an\n"
                 "awesome combination!\r"
                 "SLOWBRO, show me your Psychic!\r"
                 "...!\n"
                 "SLOWBRO’s Psychic hits hard!")
    end
}

script Cerulean_EventScript_Slowbro {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("SLOWBRO: Yarah?")
    playcry(SPECIES_SLOWBRO, 0)
    waitcry
    npcmsg("SLOWBRO is full of the fighting spirit!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Cerulean_EventScript_FatMan {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROUTE_24_ROCKET) >= 3) {
        npcmsg("I’m a huge fan of Cerulean Gym’s Misty.")
    _012F:
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_UNK_411C) == 2) { goto(_0123) }
    if (var(VAR_UNK_411C) == 1) { goto(_011A) }
    npcmsg("This shady character asked me just now\n"
           "how to get to the Power Plant.\r"
           "He said it must be kept\n"
           "“...confidential.”\r"
           "What does that mean?")
    goto(_012F)
_011A:
    npcmsg("A shady character sneaked into\n"
           "the Gym! What business does\f"
           "he have with Misty?")
    goto(_012F)
_0123:
    npcmsg("I saw this shady guy in black go\n"
           "off toward the Cape.")
    goto(_012F)
}

script Cerulean_EventScript_SchoolKidM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("I heard of a cave here that had\n"
           "horribly powerful Pokémon in it.\f"
           "That’s why I came here.\r")
    npcmsg("Ayuh?\r"
           "My Dowsing Machine is responding...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Cerulean_EventScript_Man3 {
    simplenpcmsg("This is...\n"
                 "The notorious Cerulean Cave!\r"
                 "Horribly powerful Pokémon live here.\n"
                 "Only those who have defeated all eight\f"
                 "Kanto Gym Leaders are allowed to\f"
                 "challenge it.")
    end
}

