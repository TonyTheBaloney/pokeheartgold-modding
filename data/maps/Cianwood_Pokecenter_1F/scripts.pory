            givemon(SPECIES_TENTACOOL, 15, 0, 0, 0, VAR_SPECIAL_RESULT)
            npcmsg("Want to give a nickname to\n"
                   "the TENTACOOL? {YESNO 0}")
            touchscreenmenuhide
            getmenuchoice(VAR_SPECIAL_RESULT)
            if (var(VAR_SPECIAL_RESULT) == 1) {
                touchscreenmenushow
                closemessage
            } else {
                closemessage
                setsavedbottomscreenapp(0)
                fadescreen(6, 1, 0, RGB_BLACK)
                waitfade
                nicknameinput(1, VAR_SPECIAL_RESULT)
                fadescreen(6, 1, 1, RGB_BLACK)
                waitfade
            }
            releaseall
            end
        _00E4:
            npcmsg("You can’t help showing off the Pokémon\n"
                   "you have, don’t you agree?\r"
                   "I’d love to show mine to a friend of mine\n"
                   "who lives in Violet...")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        goto(_007F)
        goto(_007F)
    }
    goto(_005C)
    goto(_005C)
}

script Cianwood_Pokecenter_1F_EventScript_GymGuide {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_STORM, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        bufferplayersname(0)
        npcmsg("{STRVAR_1 3, 0, 0}! You won, didn’t you?\n"
               "Your face tells me you did.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("The Pokémon at this Gym are all rough\n"
           "and tough.\r"
           "They could blow me away in a second.\f"
           "Let me give you a piece of advice.\r"
           "The Gym Leader uses Fighting-type\n"
           "Pokémon.\r"
           "You can try to fool them with\n"
           "Psychic-type Pokémon.\r"
           "Or simply defeat them before they\n"
           "can demonstrate their power.\r"
           "By the way, Chuck, the Gym Leader,\n"
           "is into his waterfall training.\r"
           "He won’t be able to hear you unless\n"
           "you somehow stop the pounding water.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

