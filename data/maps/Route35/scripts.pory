script Route35_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) != 1) {
            if (var(VAR_TEMP_x4000) == 2) { goto(_005C) }
            if (var(VAR_TEMP_x4000) == 5) { goto(_005C) }
            setflag(FLAG_HIDE_CAMERON)
        } else {
        _005C:
            clearflag(FLAG_HIDE_CAMERON)
        }
        getcurrenttimeofday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 3) { goto(_0088) }
        if (var(VAR_TEMP_x4000) == 4) { goto(_0088) }
        clearflag(FLAG_UNK_1CD)
        setflag(FLAG_UNK_1CE)
        end
    _0088:
        clearflag(FLAG_UNK_1CE)
        setflag(FLAG_UNK_1CD)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script Route35_EventScript_PokefanM {
    playse(SEQ_SE_DP_SELECT)
