script NewBark_PlayerHouse_2F_EventScript_PC {
    followmonresetmovement
    lockall
    playse(SEQ_SE_DP_PC_ON)
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} booted up the PC and\n"
           "checked the Mailbox!\r")
    closemessage
    countmailboxmessages(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("There is no Mail...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    openmailbox
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

script NewBark_PlayerHouse_2F_EventScript_ItsAWiiSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("It’s a Wii!\r"
           "Wii is huge in Johto, too!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

