}

script PokeathlonDome_Interior_B1FPotentialRoom_EventScript_Dodrio {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_D49R0106_tsure_poke_static_dodrio, PokeathlonDome_Interior_B1FPotentialRoom_Movement_DodrioFaceDown)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_D49R0106_tsure_poke_static_dodrio, PokeathlonDome_Interior_B1FPotentialRoom_Movement_DodrioFaceUp)
    } elif (var(VAR_SPECIAL_RESULT) == 2) {
        applymovement(obj_D49R0106_tsure_poke_static_dodrio, PokeathlonDome_Interior_B1FPotentialRoom_Movement_DodrioFaceRight)
    } else {
        applymovement(obj_D49R0106_tsure_poke_static_dodrio, PokeathlonDome_Interior_B1FPotentialRoom_Movement_DodrioFaceLeft)
    }
    waitmovement
    playcry(SPECIES_DODRIO, 0)
    npcmsg("DODRIO: Keewn!")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement PokeathlonDome_Interior_B1FPotentialRoom_Movement_DodrioFaceUp {
    jump_in_place_fast_up * 2
}

movement PokeathlonDome_Interior_B1FPotentialRoom_Movement_DodrioFaceDown {
    jump_in_place_fast_down * 2
}

movement PokeathlonDome_Interior_B1FPotentialRoom_Movement_DodrioFaceLeft {
    jump_in_place_fast_left * 2
}

movement PokeathlonDome_Interior_B1FPotentialRoom_Movement_DodrioFaceRight {
    jump_in_place_fast_right * 2
}

script PokeathlonDome_Interior_B1FPotentialRoom_EventScript_CheckedSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} checked\n"
           "the event records.\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    launchpokeathlonrecordsapp(2)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

script PokeathlonDome_Interior_B1FPotentialRoom_EventScript_Sign1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_HIDE_POKEATHLON_POKEGEAR_SIGN)) {
        npcmsg("It is a cool Pokégear to commemorate\n"
               "your 100th victory in the Pokéathlon.\r"
               "That is your model!\n"
               "It is a special Pokégear with\f"
               "the Pokéathlon logo in the back.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Those who have won at the Pokéathlon\n"
           "100 times are commemorated here for\f"
           "their achievement of creating the new,\f"
           "legendary record.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokeathlonDome_Interior_B1FPotentialRoom_EventScript_Sign2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_HIDE_POKEATHLON_BALL_SIGN)) {
        npcmsg("It’s an awesome Poké Ball to\n"
               "commemorate your 50th victory\f"
               "in every Pokéathlon event.\r"
               "It’s your model Poké Ball!\n"
               "The engraving reads, “Stay on Top.”")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Those Pokéathletes who have come in\n"
           "first in every event at the Pokéathlon\f"
           "50 times are commemorated here for\f"
           "their overwhelming might and the\f"
           "arrival of a new legend.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

