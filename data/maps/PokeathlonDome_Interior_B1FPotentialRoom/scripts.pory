    if (var(VAR_TEMP_x4007) == 3) { goto(_01FB) }
    goto(_0235)
    end
_03AC:
    npcmsg("I hope you’ll become a Top Pokéathlete.\n"
           "Good luck!")
    waitbuttonpress
    closemessage
    touchscreenmenushow
    releaseall
    end
}

