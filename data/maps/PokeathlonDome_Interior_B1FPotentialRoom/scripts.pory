        movepersonfacing(obj_D49R0106_pcwoman2, 6, 1, 3, DIR_EAST)
        setvar(VAR_TEMP_x400D, 0)
    }
    end
}

script PokeathlonDome_Interior_B1FPotentialRoom_EventScript_Receptionist1 {
    simplenpcmsg("This is the “Potential” room.\n"
                 "It is to show the infinite potential\f"
                 "of both Pokémon and people.")
    end
}

script PokeathlonDome_Interior_B1FPotentialRoom_EventScript_Receptionist2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_0F1)) {
        npcmsg("This is the “Friendship” room.\n"
               "Please go ahead.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Only the Pokéathletes who have held\n"
           "the best record in every event\f"
           "are allowed here.\r"
           "Continue your hard work toward\n"
           "breaking every record there is.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

