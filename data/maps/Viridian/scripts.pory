script Viridian_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 3) {
            clearflag(FLAG_HIDE_CAMERON)
        } elif (var(VAR_TEMP_x4000) == 5) {
            clearflag(FLAG_HIDE_CAMERON)
        } else {
            setflag(FLAG_HIDE_CAMERON)
        }
        if (!flag(FLAG_UNLOCKED_WEST_KANTO)) {
            setflag(FLAG_UNLOCKED_WEST_KANTO)
            setvar(VAR_UNK_4121, 1)
        }
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script Viridian_EventScript_ProfOakCall {
    phonecall(PHONE_CONTACT_PROF__OAK, 2, 0)
    setvar(VAR_UNK_4096, 2)
    end
}

script Viridian_EventScript_OldMan1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("Hey, kid! I just had a double shot\n"
           "of espresso, and I am wired!\r"
           "I need to talk to someone, so you’ll\n"
           "have to do!\r"
           "I might not look like much now, but\n"
           "I was an expert at catching Pokémon.\r"
           "Do you believe me? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Good, good. Yes, I was something out\n"
               "of the ordinary, let me tell you!")
    } else {
        npcmsg("What? You little whelp!\r"
               "If I were just a bit younger, I’d\n"
               "show you a thing or two. Humph!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Viridian_EventScript_OldMan2 {
    simplenpcmsg("This Gym didn’t have a Leader...\r"
                 "A young man from Pallet Town became the\n"
                 "Leader, but he’s often away.")
    end
}

script Viridian_EventScript_OldMan3 {
    simplenpcmsg("How was it?\n"
                 "Were you able to battle the Leader?")
    end
}

script Viridian_EventScript_FatMan {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GOT_TM85_FROM_VIRIDIAN_CITY_MAN)) {
        npcmsg("Yawn!\n"
               "I must have dozed off in the sun.\r"
               "...I had this dream about a DROWZEE\n"
               "eating my dream.\r"
               "Weird, huh?\f"
               "Huh?\f"
               "What’s this?\r"
               "Where did this TM come from?\n"
               "This is spooky!\f"
               "Here, you can have this TM.\r")
        if (!itemspace(ITEM_TM85, 1)) {
            callstd(std_bag_is_full)
            closemessage
            releaseall
            end
        }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_TM85_FROM_VIRIDIAN_CITY_MAN)
    }
    npcmsg("TM85 contains Dream Eater...\n"
           "...Zzzzz...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Viridian_EventScript_PokefanM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 5)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, Viridian_Movement_PlayerWalkRightUp)
        applymovement(obj_T02_gsmiddleman1, Viridian_Movement_PokefanMFaceUp)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, Viridian_Movement_PlayerWalkUp)
    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_player, Viridian_Movement_PlayerWalkUpRight)
        applymovement(obj_T02_gsmiddleman1, Viridian_Movement_PokefanMFaceUp)
    } else {
        applymovement(obj_player, Viridian_Movement_PlayerWalkUpLeft)
        applymovement(obj_T02_gsmiddleman1, Viridian_Movement_PokefanMFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, Viridian_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(69)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Viridian_Movement_PlayerWalkRightUp {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Viridian_Movement_PlayerWalkUp {
    walk_up * 3
    walk_in_place_down
}

movement Viridian_Movement_PlayerWalkUpLeft {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Viridian_Movement_PlayerWalkUpRight {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement Viridian_Movement_PokefanMFaceUp {
    delay_8
    walk_in_place_up
}

movement Viridian_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

