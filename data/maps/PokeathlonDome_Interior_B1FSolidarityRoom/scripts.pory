script scr_seq_D49R0104_000 {
    simplenpcmsg("This is the “Solidarity” room.\r"
                 "It is to show the solidarity of Pokémon\n"
                 "and people, as well as the history\f"
                 "of the Pokéathlon.")
    end
}

script scr_seq_D49R0104_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_0EF)) {
        npcmsg("This is the “Trust” room.\n"
               "Please go ahead.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Only the Pokéathletes who have\n"
           "come in first in five of the courses\f"
           "are allowed here.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_D49R0104_002 {
    simplenpcmsg("The Pokéathlon does go way back.")
    end
}

script scr_seq_D49R0104_003 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("When you win a course,\n"
           "you receive a Medal!\f"
           "I’ve got to win at every course!\r")
    closemessage
    applymovement(obj_D49R0104_tsure_poke_static_rattata, PokeathlonDome_Interior_B1FSolidarityRoom_Movement_00F0)
    waitmovement
    playcry(SPECIES_RATTATA, 0)
    npcmsg("RATTATA: Kooar!")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement PokeathlonDome_Interior_B1FSolidarityRoom_Movement_00F0 {
    jump_in_place_fast_up * 2
}

script scr_seq_D49R0104_004 {
    simplenpcmsg("I heard that Pokéathletes with great\n"
                 "records are going to have their shoes\f"
                 "displayed at the museum!")
    end
}

