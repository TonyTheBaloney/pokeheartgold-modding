script PokeathlonDome_Interior_B1FSolidarityRoom_OnTransition {
    if (flag(FLAG_UNK_0EF)) {
        setvar(VAR_TEMP_x400B, 1)
        end
    }
    setvar(VAR_TEMP_x400B, 0)
    end
}

script PokeathlonDome_Interior_B1FSolidarityRoom_OnResume {
    if (var(VAR_TEMP_x400B) == 1) {
        movepersonfacing(obj_D49R0104_pcwoman2_2, 2, 1, 3, DIR_EAST)
        setvar(VAR_TEMP_x400B, 0)
    }
    end
}

script PokeathlonDome_Interior_B1FSolidarityRoom_EventScript_Receptionist1 {
    simplenpcmsg("This is the “Solidarity” room.\r"
                 "It is to show the solidarity of Pokémon\n"
                 "and people, as well as the history\f"
                 "of the Pokéathlon.")
    end
}

script PokeathlonDome_Interior_B1FSolidarityRoom_EventScript_Receptionist2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_0EF)) {
        npcmsg("This is the “Trust” room.\n"
               "Please go ahead.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Only the Pokéathletes who have\n"
           "come in first in five of the courses\f"
           "are allowed here.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokeathlonDome_Interior_B1FSolidarityRoom_EventScript_Man {
    simplenpcmsg("The Pokéathlon does go way back.")
    end
}

script PokeathlonDome_Interior_B1FSolidarityRoom_EventScript_Rattata1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("When you win a course,\n"
           "you receive a Medal!\f"
           "I’ve got to win at every course!\r")
    closemessage
    applymovement(obj_D49R0104_tsure_poke_static_rattata, PokeathlonDome_Interior_B1FSolidarityRoom_Movement_RattataFaceUp)
    waitmovement
    playcry(SPECIES_RATTATA, 0)
    npcmsg("RATTATA: Kooar!")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement PokeathlonDome_Interior_B1FSolidarityRoom_Movement_RattataFaceUp {
    jump_in_place_fast_up * 2
}

script PokeathlonDome_Interior_B1FSolidarityRoom_EventScript_Lass {
    simplenpcmsg("I heard that Pokéathletes with great\n"
                 "records are going to have their shoes\f"
                 "displayed at the museum!")
    end
}

script PokeathlonDome_Interior_B1FSolidarityRoom_EventScript_Rattata2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_RATTATA, 0)
    npcmsg("RATTATA: Ffft!")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokeathlonDome_Interior_B1FSolidarityRoom_EventScript_Zubat {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_ZUBAT, 0)
    npcmsg("ZUBAT: Quuooh.")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokeathlonDome_Interior_B1FSolidarityRoom_EventScript_CheckedSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} checked\n"
           "the course record!\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    launchpokeathlonrecordsapp(0)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

script PokeathlonDome_Interior_B1FSolidarityRoom_EventScript_Painting {
    simplenpcmsg("It is an old wall painting.\r"
                 "One person and three Pokémon\n"
                 "seem to be learning something\f"
                 "from looking up at the sky.")
    end
}

script PokeathlonDome_Interior_B1FSolidarityRoom_EventScript_Sign1 {
    simplenpcmsg("It is an old, worn scroll.\r"
                 "“Pokéathlon Myth\r"
                 "When a disease took over the entire\n"
                 "island, one human and three Pokémon\f"
                 "overcame ten obstacles to spread the\f"
                 "word about the cure.”")
    end
}

script PokeathlonDome_Interior_B1FSolidarityRoom_EventScript_Sign2 {
    simplenpcmsg("It’s an old scroll.\r"
                 "“The Beginning of Pokéathlon\r"
                 "To commemorate the friendship of the\n"
                 "person and three Pokémon that\f"
                 "conveyed the words of the cure, people\f"
                 "started to tell of their achievement.”\r"
                 "...\n"
                 "The commemorating eventually took the\f"
                 "form of ten games to compete in, just\f"
                 "like the obstacles in the legend...”")
    end
}

script PokeathlonDome_Interior_B1FSolidarityRoom_EventScript_Sign3 {
    simplenpcmsg("“Pokéathlon Almanac”\r"
                 "There are many Pokéathletes and\n"
                 "Pokémon Medalists shown in\f"
                 "the photos.\n")
    end
}

