    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_T08PC0101_gsgirl1, Fuchsia_Pokecenter_1F_Movement_LassSpin1)
    } elif (var(VAR_SPECIAL_RESULT) == 2) {
        applymovement(obj_T08PC0101_gsgirl1, Fuchsia_Pokecenter_1F_Movement_LassSpin2)
    } else {
        applymovement(obj_T08PC0101_gsgirl1, Fuchsia_Pokecenter_1F_Movement_LassSpin3)
    }
    npcmsg("See? I look just like her now!\r"
           "...?\r"
           "Huh? Didn’t work?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

