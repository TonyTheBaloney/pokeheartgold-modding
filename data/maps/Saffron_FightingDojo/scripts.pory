    lockall
    faceplayer
    npcmsg(msg_0533_T11R0101_00008)
    closemessage
    trainerbattle(TRAINER_LEADER_WHITNEY_2, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    npcmsg(msg_0533_T11R0101_00009)
    waitbuttonpress
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    clearphonerematchseeking(17)
    setflag(FLAG_UNK_2B5)
    removeobject(obj_T11R0101_gsleader3)
