script Saffron_FightingDojo_EventScript_Whitney {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("Whitney: I never break my promises!\n"
           "Are you ready?\r")
    closemessage
    trainerbattle(TRAINER_LEADER_WHITNEY_2, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    npcmsg("Whitney: You really are strong!\n"
           "But I won’t lose next time!")
    waitbuttonpress
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    clearphonerematchseeking(17)
    setflag(FLAG_UNK_2B5)
    removeobject(obj_T11R0101_gsleader3)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

