script Route35_NationalParkPokeathalonGatehouse_EventScript_AttendantScene {
    followmonresetmovement
    lockall
    applymovement(obj_player, Route35_NationalParkPokeathalonGatehouse_Movement_PlayerFaceLeft)
    applymovement(obj_R35R0201_counterm_3, Route35_NationalParkPokeathalonGatehouse_Movement_AttendantFaceRight)
    waitmovement
    callstd(std_bug_contest_guard_ask_end)
    if (var(VAR_UNK_4118) == 1) {
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(55)
        applymovement(obj_player, Route35_NationalParkPokeathalonGatehouse_Movement_PlayerWalkUp1)
        waitmovement
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
        playse(SEQ_SE_DP_KAIDAN2)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        warp(MAP_NATIONAL_PARK_BUG_CATCHING_CONTEST, 0, 40, 86, DIR_NORTH)
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        lock(obj_partner_poke)
        followmonislarge(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            followmonreleasenexttoplayer
        } else {
            followmonmovetoplayer
        }
        applymovement(obj_partner_poke, Route35_NationalParkPokeathalonGatehouse_Movement_FollowMonFaceUp)
        waitmovement
        release(obj_partner_poke)
    }
    releaseall
    end
}

