script Route35_NationalParkPokeathalonGatehouse_EventScript_WorkerTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_R35R0201_workman, Route35_NationalParkPokeathalonGatehouse_Movement_WorkerExclamation)
    waitmovement
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 7) {
        applymovement(obj_R35R0201_workman, Route35_NationalParkPokeathalonGatehouse_Movement_WorkerWalkLeftUp1)
    } elif (var(VAR_TEMP_x4001) == 8) {
        applymovement(obj_R35R0201_workman, Route35_NationalParkPokeathalonGatehouse_Movement_WorkerWalkLeftUp2)
    } elif (var(VAR_TEMP_x4001) == 10) {
        applymovement(obj_R35R0201_workman, Route35_NationalParkPokeathalonGatehouse_Movement_WorkerWalkLeftDown1)
    } else {
        applymovement(obj_R35R0201_workman, Route35_NationalParkPokeathalonGatehouse_Movement_WorkerWalkLeftDown2)
    }
    waitmovement
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(56)
    applymovement(obj_R35R0201_workman, Route35_NationalParkPokeathalonGatehouse_Movement_WorkerWalkRight)
    applymovement(obj_player, Route35_NationalParkPokeathalonGatehouse_Movement_PlayerWalkRight)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("Hey, hey!\n"
           "Watch yourself! The construction\f"
           "makes it dangerous around here.\r"
           "Just wait a little longer for the\n"
           "exciting reveal!\r")
    closemessage
    if (var(VAR_TEMP_x4001) == 7) {
        applymovement(obj_R35R0201_workman, Route35_NationalParkPokeathalonGatehouse_Movement_WorkerWalkDown1)
    } elif (var(VAR_TEMP_x4001) == 8) {
        applymovement(obj_R35R0201_workman, Route35_NationalParkPokeathalonGatehouse_Movement_WorkerWalkDown2)
    } elif (var(VAR_TEMP_x4001) == 10) {
        applymovement(obj_R35R0201_workman, Route35_NationalParkPokeathalonGatehouse_Movement_WorkerWalkUp1)
    } else {
        applymovement(obj_R35R0201_workman, Route35_NationalParkPokeathalonGatehouse_Movement_WorkerWalkUp2)
    }
    waitmovement
    releaseall
    end
}

