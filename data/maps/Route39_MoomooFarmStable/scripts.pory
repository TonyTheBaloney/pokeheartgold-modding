script Route39_MoomooFarmStable_EventScript_LittleGirl1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_100)) {
        npcmsg("We sell Moomoo Milk at home.\f"
               "Don’t forget to drop by!\r")
        closemessage
        goto(_0070)
        end
    }
    if (flag(FLAG_UNK_0AA)) { goto(_007E) }
    npcmsg("Moomoo is sick...\f"
           "She needs lots of Oran Berries.\r")
    closemessage
_0070:
    applymovement(obj_R39R0201_gsbabygirl1, Route39_MoomooFarmStable_Movement_LittleGirlFaceRight)
    waitmovement
    releaseall
    end
_007E:
    npcmsg("Thank you!\n"
           "Moomoo is totally healthy again!\r"
           "I’ll give you this Seal Case for\n"
           "your trouble.\r")
    giveitemnocheck(ITEM_SEAL_CASE, 1)
    npcmsg("You can customize your Poké Balls.\r"
           "Select “BALL CAPSULES” from\n"
           "your PC, and stick your Seals any way\f"
           "you like on a Capsule, then put the\f"
           "Capsule on any of your Poké Balls.\r"
           "Try different things, and you’ll see.\n"
           "My sister can give you Seals!\r")
    closemessage
    setflag(FLAG_UNK_100)
    goto(_0070)
    end
}

