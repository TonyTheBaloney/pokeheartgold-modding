    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} gave an Oran Berry\n"
           "to MILTANK.")
    waitbuttonpress
    closemessage
    if (flag(FLAG_UNK_0B0)) { goto(_033F) }
    if (flag(FLAG_UNK_0AF)) { goto(_0337) }
    if (flag(FLAG_UNK_0AE)) { goto(_0328) }
