script Route32_EventScript_FatMan2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("How would you like to have this\n"
           "tasty, nutritious SlowpokeTail?\r"
           "For you right now, just $1,000,000!\n"
           "You’ll want this! {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Tch! I thought kids these days\n"
               "were loaded...")
    } else {
        npcmsg("You don’t want it?\n"
               "Then scram. Shoo!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route32_EventScript_PokefanM2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 5)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, Route32_Movement_PlayerWalkRightUp)
        applymovement(obj_R32_gsmiddleman1_2, Route32_Movement_PokefanMFaceUp)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, Route32_Movement_PlayerWalkUp3)
    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_player, Route32_Movement_PlayerWalkUpRight)
        applymovement(obj_R32_gsmiddleman1_2, Route32_Movement_PokefanMFaceUp)
    } else {
        applymovement(obj_player, Route32_Movement_PlayerWalkUpLeft)
        applymovement(obj_R32_gsmiddleman1_2, Route32_Movement_PokefanMFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, Route32_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(5)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Route32_Movement_PlayerWalkRightUp {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Route32_Movement_PlayerWalkUp3 {
    walk_up * 3
    walk_in_place_down
}

movement Route32_Movement_PlayerWalkUpLeft {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Route32_Movement_PlayerWalkUpRight {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement Route32_Movement_PokefanMFaceUp {
    delay_8
    walk_in_place_up
}

movement Route32_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

