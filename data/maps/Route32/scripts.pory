script Route32_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        checkbadge(BADGE_PLAIN, VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) != 0) {
            getweekday(VAR_TEMP_x4000)
            if (var(VAR_TEMP_x4000) == 2) { goto(_0083) }
            if (var(VAR_TEMP_x4000) == 4) { goto(_0083) }
            if (var(VAR_TEMP_x4000) == 6) { goto(_0083) }
        }
        setflag(FLAG_HIDE_CAMERON)
        goto(_008D)
    _0083:
        clearflag(FLAG_HIDE_CAMERON)
        goto(_008D)
    _008D:
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 5) {
            clearflag(FLAG_UNK_208)
        } else {
            setflag(FLAG_UNK_208)
        }
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

