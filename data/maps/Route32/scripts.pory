script Route32_EventScript_FatMan1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GOT_TM05_FROM_ROUTE_32_MAN)) {
        npcmsg("WROOOOAR!\r"
               "PEOPLE RUN WHEN I ROAR!\n"
               "BUT YOU CAME LOOKING!\r"
               "THAT PLEASES ME!\n"
               "NOW TAKE THIS!\r")
        if (!itemspace(ITEM_TM05, 1)) {
            callstd(std_bag_is_full)
            closemessage
            releaseall
            end
        }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_TM05_FROM_ROUTE_32_MAN)
    }
    npcmsg("WROOOAR!\n"
           "IT’S ROAR!\r"
           "EVEN POKéMON RUN\n"
           "FROM A GOOD ROAR!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route32_EventScript_PokefanM1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_ZEPHYR, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Have you gone to the Pokémon Gym?\r"
               "You can test your Pokémon and\n"
               "yourself there.\r"
               "It’s a rite of passage for all Trainers!")
        goto(_0284)
        end
    }
    if (!flag(FLAG_GOT_EGG_FROM_ELMS_ASSISTANT)) {
        bufferplayersname(0)
        npcmsg("{STRVAR_1 3, 0, 0}, right?\n"
               "Some guy wearing glasses was looking\f"
               "for you.\r"
               "See for yourself. He’s waiting for\n"
               "you at the Poké Mart.")
        goto(_0284)
        end
    }
    if (!flag(FLAG_UNK_074)) {
        setvar(VAR_TEMP_x4002, 0)
        call(_02B5)
        releaseall
        end
    _02B5:
        if (var(VAR_UNK_408D) == 0) {
            setvar(VAR_UNK_408D, 1)
        }
        npcmsg("You have some good Pokémon there.\r"
               "It must be from the training you gave\n"
               "them around Violet City.\r"
               "The training at the Gym must have\n"
               "been especially helpful.\r"
               "As a souvenir of Violet City, take this.\r"
               "It increases the power of\n"
               "Grass-type moves.\r")
        setvar(VAR_SPECIAL_x8004, 239)
        setvar(VAR_SPECIAL_x8005, 1)
        hasspaceforitem(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005, VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            if (var(VAR_TEMP_x4002) == 0) {
                npcmsg("Hey, your Bag is chock-full.")
                waitbuttonpress
            } else {
                npcmsg("Hey, your Bag is chock-full.\r")
            }
        } else {
            if (var(VAR_TEMP_x4002) == 0) {
                callstd(std_obtain_item_verbose)
            } else {
                callstd(std_give_item_verbose)
            }
            setflag(FLAG_UNK_074)
        }
        closemessage
        return
    }
    npcmsg("Your experiences in Violet City\n"
           "should be useful for your journey.")
_0284:
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route32_EventScript_PokefanMTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_R32_gsmiddleman1, Route32_Movement_PokefanMExclamation)
    waitmovement
    npcmsg("Wait up!\n"
           "What’s the hurry?\r")
    closemessage
    if (flag(FLAG_GOT_EGG_FROM_ELMS_ASSISTANT)) {
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(56)
        getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4000) == 475) {
            applymovement(obj_R32_gsmiddleman1, Route32_Movement_PokefanMWalkLeft)
            applymovement(obj_player, Route32_Movement_PlayerFaceRight1)
            setvar(VAR_TEMP_x4002, 1)
        } else {
            applymovement(obj_R32_gsmiddleman1, Route32_Movement_PokefanMDelay)
            applymovement(obj_player, Route32_Movement_PlayerFaceRight2)
            setvar(VAR_TEMP_x4002, 0)
        }
        waitmovement
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
        call(_02B5)
        if (var(VAR_TEMP_x4000) == 475) {
            applymovement(obj_R32_gsmiddleman1, Route32_Movement_PokefanMWalkRight)
            waitmovement
        }
        releaseall
        end
    }
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(56)
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 475) {
        applymovement(obj_R32_gsmiddleman1, Route32_Movement_PokefanMWalkLeftUp1)
        applymovement(obj_player, Route32_Movement_PlayerWalkUp1)
    } else {
        applymovement(obj_R32_gsmiddleman1, Route32_Movement_PokefanMWalkLeftUp2)
        applymovement(obj_player, Route32_Movement_PlayerWalkUp2)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    checkbadge(BADGE_ZEPHYR, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Have you gone to the Pokémon Gym?\r"
               "You can test your Pokémon and\n"
               "yourself there.\r"
               "It’s a rite of passage for all Trainers!\r")
    } else {
        bufferplayersname(0)
        npcmsg("{STRVAR_1 3, 0, 0}, right?\n"
               "Some guy wearing glasses was looking\f"
               "for you.\r"
               "See for yourself. He’s waiting for\n"
               "you at the Poké Mart.\r")
    }
    closemessage
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 475) {
        applymovement(obj_R32_gsmiddleman1, Route32_Movement_PokefanMWalkDownRight1)
    } else {
        applymovement(obj_R32_gsmiddleman1, Route32_Movement_PokefanMWalkDownRight2)
    }
    waitmovement
    releaseall
    end
}

