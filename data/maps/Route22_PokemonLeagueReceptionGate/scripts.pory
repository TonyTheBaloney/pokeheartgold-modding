script Route22_PokemonLeagueReceptionGate_EventScript_Janine {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkregisteredphonenumber(PHONE_CONTACT_JANINE, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) {
        npcmsg("Janine: I’m done taking lunch to\n"
               "my dad, and now I’m on my way home.\r"
               "Do you want to take a picture\n"
               "with me? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Janine: That’s a pity!")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        photoalbumisfull(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Your Photo Album is full.\r"
                   "Access your PC and delete\n"
                   "some pictures.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Janine: Can you look as cool as me\n"
               "for the picture?\r")
        closemessage
        setflag(FLAG_UNK_189)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        cameronphoto(70)
        faceplayer
        lockall
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        clearflag(FLAG_UNK_189)
        npcmsg("Janine: Don’t you think we look\n"
               "good in the picture?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_TEMP_x4005) >= 1) { goto(_0548) }
    npcmsg("Janine: I’m on the way to my dad’s\n"
           "house to give him his lunch.\r"
           "The Elite Four has no time to rest,\n"
           "day or night. It’s such hard work,\f"
           "you know?\r"
           "Say!\n"
           "Do you want to exchange numbers? {YESNO 0}")
_04D0:
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_04F4) }
    if (var(VAR_SPECIAL_RESULT) >= 1) { goto(_0537) }
    end
_04F4:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} registered Janine\n"
           "in the Pokégear!")
    playfanfare(SEQ_ME_POKEGEAR_REGIST)
    waitfanfare
    registergearnumber(PHONE_CONTACT_JANINE)
    npcmsg("Janine: Call me on Monday around noon\n"
           "if you want to battle!")
    waitbuttonpress
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setflag(FLAG_UNK_270)
    removeobject(obj_R22R0101_gsleader13)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
_0537:
    setvar(VAR_TEMP_x4005, 1)
    npcmsg("Janine: You don’t look like you’re\n"
           "scared, but you are, aren’t you?")
    waitbuttonpress
    closemessage
    releaseall
    end
_0548:
    npcmsg("Janine: Now you want to know\n"
           "my number, don’t you? {YESNO 0}")
    goto(_04D0)
    end
}

