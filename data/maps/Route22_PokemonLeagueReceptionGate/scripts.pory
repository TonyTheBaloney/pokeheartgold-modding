    lockall
    faceplayer
    if (flag(FLAG_UNLOCKED_WEST_KANTO)) {
        npcmsg("West to Mt. Silver.\n"
               "East to the Kanto region.\r"
               "Go north for the Elite Four!\n"
               "But you should know that already,\f"
               "since you defeated the Champion!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Huh?\n"
           "This way leads to Kanto...\f"
           "But this path’s blocked for\f"
           "the time being, I’m afraid.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

