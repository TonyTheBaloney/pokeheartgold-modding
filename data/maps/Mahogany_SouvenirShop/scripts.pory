}

movement Mahogany_SouvenirShop_Movement_BlackBeltWalkRight {
    lock_dir
    walk_faster_right * 2
    unlock_dir
}

movement Mahogany_SouvenirShop_Movement_LanceWalkDown {
    delay_8 * 3
    face_down * 2
    walk_down
    delay_8 * 5
}

movement Mahogany_SouvenirShop_Movement_LanceWalkUpRight {
    face_up * 2
    walk_up * 4
    face_right * 2
    walk_right
    face_up * 2
    delay_8 * 5
}

movement Mahogany_SouvenirShop_Movement_PlayerWalkUp {
    delay_8
    walk_up * 4
}

movement Mahogany_SouvenirShop_Movement_GymGuideWalkLeft {
    emote_exclamation_mark
    delay_8
    lock_dir
    walk_faster_left * 2
    unlock_dir
}

movement Mahogany_SouvenirShop_Movement_LanceWalkUp {
    walk_up
    face_right * 2
    delay_8 * 2
}

movement Mahogany_SouvenirShop_Movement_GymGuideExclamation {
    face_right * 2
    emote_exclamation_mark
}

movement Mahogany_SouvenirShop_Movement_LittleBoyWalkRight {
