        movepersonfacing(obj_D35R0101_stop_2, 9, 0, 4, DIR_SOUTH)
        movepersonfacing(obj_D35R0101_stop_3, 8, 0, 4, DIR_SOUTH)
        end
    }
    if (var(VAR_UNK_40A8) >= 2) { goto(_006D) }
    if (var(VAR_UNK_40A8) == 1) { goto(_005F) }
    end
_005F:
