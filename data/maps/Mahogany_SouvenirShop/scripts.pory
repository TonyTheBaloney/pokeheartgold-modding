script Mahogany_SouvenirShop_EventScript_OldWoman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    setflag(FLAG_SPECIAL_MART_MAHOGANY_GOOD)
    npcmsg("Whistle...whistle...\r"
           "Are you bothered by that noise? That’s\n"
           "me. My false teeth don’t fit right,\f"
           "and the gap makes the noise.\r"
           "Enough about that.\n"
           "Why don’t you buy something?\r")
    holdmsg
    setvar(VAR_SPECIAL_x8004, 29)
    callstd(std_special_mart)
    clearflag(FLAG_SPECIAL_MART_MAHOGANY_GOOD)
    releaseall
    end
}

