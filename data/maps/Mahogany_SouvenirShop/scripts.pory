script scr_seq_D35R0101_002 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_40A8) >= 2) {
        npcmsg("Arrgh...\n"
               "You found the secret stairway...\r"
               "How did you do that?\n"
               "I thought it was well camouflaged...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Huh?\r"
           "You hear wind blowing into this room?\n"
           "That is...just me whistling.\r"
           "Enough about that.\n"
           "Why don’t you buy something? {YESNO 0}")
    holdmsg
    setvar(VAR_SPECIAL_x8004, 28)
    callstd(std_special_mart)
    releaseall
    end
}

script scr_seq_D35R0101_003 {
    if (var(VAR_UNK_40A8) >= 2) {
        simplenpcmsg("Urrgh...\r"
                     "That guy’s Dragon-type Pokémon\n"
