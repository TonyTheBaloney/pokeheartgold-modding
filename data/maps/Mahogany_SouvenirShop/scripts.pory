    movepersonfacing(obj_D35R0101_stop_3, 8, 0, 4, DIR_SOUTH)
    end
}

script Mahogany_SouvenirShop_OnLoad {
    if (var(VAR_UNK_40AC) == 3) {
        clearflag(FLAG_HIDE_ROCKET_HIDEOUT_B3F_GIOVANNI)
        setflag(FLAG_HIDE_ROCKET_HIDEOUT_B3F_PETREL)
        end
    }
    if (var(VAR_UNK_40AC) == 8) { goto(_0105) }
    end
_0105:
    setflag(FLAG_UNK_1E5)
    setflag(FLAG_HIDE_ROCKET_HIDEOUT_B2F_ARIANA)
    end
}

script Mahogany_SouvenirShop_EventScript_LanceScene {
    stopbgm(0)
    playbgm(SEQ_GS_D_AJITO)
    followmonresetmovement
    lockall
    applymovement(obj_player, Mahogany_SouvenirShop_Movement_PlayerExclamation)
    waitmovement
    npcmsg("Lance: DRAGONITE, Hyper Beam.\r")
    closemessage
    playse(SEQ_SE_GS_ZUTUKI)
    applymovement(obj_D35R0101_tsure_poke_static_dragonite, Mahogany_SouvenirShop_Movement_DragoniteWalkRightLeft)
    waitse(SEQ_SE_GS_PRESSHIT)
    applymovement(obj_D35R0101_gsfighter, Mahogany_SouvenirShop_Movement_BlackBeltWalkRight)
    waitmovement
    applymovement(obj_D35R0101_wataru, Mahogany_SouvenirShop_Movement_LanceWalkDown)
    applymovement(obj_D35R0101_tsure_poke_static_dragonite, Mahogany_SouvenirShop_Movement_DragoniteFaceDown)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("What took you so long, {STRVAR_1 3, 0, 0}?\r"
                 "Just as I thought, that strange radio\n"
                 "signal is coming from here.\r", "What took you so long, {STRVAR_1 3, 0, 0}?\r"
                                                  "Just as I thought, that strange radio\n"
                                                  "signal is coming from here.\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_D35R0101_wataru, Mahogany_SouvenirShop_Movement_LanceWalkUpRight)
    applymovement(obj_player, Mahogany_SouvenirShop_Movement_PlayerWalkUp)
    applymovement(obj_D35R0101_tsure_poke_static_dragonite, Mahogany_SouvenirShop_Movement_DragoniteWalkUp)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    applymovement(obj_D35R0101_sunglasses, Mahogany_SouvenirShop_Movement_GymGuideWalkLeft)
    waitmovement
    applymovement(obj_D35R0101_wataru, Mahogany_SouvenirShop_Movement_LanceWalkUp)
    waitmovement
    npcmsg("The stairs are right here.\r")
    closemessage
    applymovement(obj_D35R0101_sunglasses, Mahogany_SouvenirShop_Movement_GymGuideExclamation)
    waitmovement
    playse(SEQ_SE_DP_UG_023)
    applymovement(obj_D35R0101_babyboy1_10, Mahogany_SouvenirShop_Movement_LittleBoyWalkRight)
    applymovement(obj_D35R0101_stop, Mahogany_SouvenirShop_Movement_LittleBoyWalkRight)
    applymovement(obj_D35R0101_stop_2, Mahogany_SouvenirShop_Movement_LittleBoyWalkRight)
    applymovement(obj_D35R0101_stop_3, Mahogany_SouvenirShop_Movement_LittleBoyWalkRight)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("Lance: {STRVAR_1 3, 0, 0}, we should split up\n"
                 "to check this place. I’ll go first.\r", "Lance: {STRVAR_1 3, 0, 0}, we should split up\n"
                                                          "to check this place. I’ll go first.\r")
    closemessage
    applymovement(obj_D35R0101_wataru, Mahogany_SouvenirShop_Movement_LanceWalkRight)
    waitmovement
    removeobject(obj_D35R0101_wataru)
    applymovement(obj_D35R0101_tsure_poke_static_dragonite, Mahogany_SouvenirShop_Movement_DragoniteWalkUpRight)
    waitmovement
    removeobject(obj_D35R0101_tsure_poke_static_dragonite)
    setflag(FLAG_HIDE_MAHOGANY_SHOP_LANCE)
    setvar(VAR_UNK_40A8, 2)
    releaseall
    end
}

