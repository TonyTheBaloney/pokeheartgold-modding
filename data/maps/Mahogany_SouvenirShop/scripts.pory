}

movement Mahogany_SouvenirShop_Movement_DragoniteWalkRightLeft {
    walk_faster_right * 2
    lock_dir
    walk_faster_left * 2
    unlock_dir
}

movement Mahogany_SouvenirShop_Movement_DragoniteFaceDown {
    delay_8 * 3
    face_down * 2
}

movement Mahogany_SouvenirShop_Movement_DragoniteWalkUp {
    delay_8 * 3
    face_up * 2
    walk_up * 2
}

movement Mahogany_SouvenirShop_Movement_DragoniteWalkUpRight {
    delay_8 * 3
    walk_up * 2
    face_right * 2
    walk_right
}

