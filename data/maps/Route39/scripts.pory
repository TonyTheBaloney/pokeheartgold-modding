script Route39_EventScript_Miltank {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_MILTANK, 0)
    npcmsg("MILTANK: Mooo!")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route39_EventScript_BaobaTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_R39_gsgentleman, Route39_Movement_GentlemanExclamation)
    waitmovement
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 171) {
        applymovement(obj_R39_gsgentleman, Route39_Movement_GentlemanWalkUpRight)
    } elif (var(VAR_TEMP_x4001) == 172) {
        applymovement(obj_R39_gsgentleman, Route39_Movement_GentlemanWalkRight)
    } else {
        applymovement(obj_R39_gsgentleman, Route39_Movement_GentlemanWalkDownRight)
    }
    waitmovement
    npcmsg("Baoba: ...Ohh!\n"
           "What you are holding is...\f"
           "what they call...a Pokédex!\f"
           "Haven’t seen one of those in ages.\r"
           "My name is Baoba!\r"
           "I used to run a Safari Zone in\n"
           "Fuchsia City, but it was becoming\f"
           "out of date with new entertainment\f"
           "options coming out.\r"
           "I decided to go overseas to learn\n"
           "the newest technology and open a\f"
           "state-of-the-art Safari Zone\f"
           "in Cianwood.\r"
           "It may be more than a coincidence\n"
           "that we are chatting.\r"
           "Why don’t we register each other’s\n"
           "numbers in the Pokégear?\r"
           "I can give you a call once the Safari\n"
           "Zone is open before I call anyone else!\r")
    npcmsg(msg_0396_R39_00005)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_01E3) }
_0173:
    npcmsg("That’s the way!\r")
    registergearnumber(PHONE_CONTACT_BAOBA)
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} registered Baoba\n"
           "in the Pokégear!")
    playfanfare(SEQ_ME_POKEGEAR_REGIST)
    waitfanfare
    npcmsg("Baoba: I’ll let you know over the\n"
           "Pokégear once it’s ready!\r")
    closemessage
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 171) {
        applymovement(obj_R39_gsgentleman, Route39_Movement_GentlemanWalkDownLeft1)
    } elif (var(VAR_TEMP_x4001) == 172) {
        applymovement(obj_R39_gsgentleman, Route39_Movement_GentlemanWalkDownLeft2)
    } else {
        applymovement(obj_R39_gsgentleman, Route39_Movement_GentlemanWalkDownLeft3)
    }
    waitmovement
    removeobject(obj_R39_gsgentleman)
    setflag(FLAG_UNK_228)
    releaseall
    setvar(VAR_UNK_408F, 1)
    end
_01E3:
    npcmsg("Huh, I didn’t expect you to say no.\n"
           "You can get hard-to-find Pokémon, too.\r"
           "You’ll be able to make good progress\n"
           "with your Pokédex, too...\r")
    npcmsg(msg_0396_R39_00005)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_01E3) }
    goto(_0173)
    end
}

text msg_0396_R39_00005 {
    "Do you want to register? {YESNO 0}"
}

movement Route39_Movement_GentlemanExclamation {
    emote_exclamation_mark
    walk_in_place_right
}

movement Route39_Movement_GentlemanWalkUpRight {
    walk_up
    walk_right * 2
}

movement Route39_Movement_GentlemanWalkRight {
    walk_right * 2
}

movement Route39_Movement_GentlemanWalkDownRight {
    walk_down
    walk_right * 2
}

movement Route39_Movement_GentlemanWalkDownLeft1 {
    walk_down
    walk_left * 2
    walk_down * 9
}

movement Route39_Movement_GentlemanWalkDownLeft2 {
    walk_down
    walk_left * 2
    walk_down * 8
}

movement Route39_Movement_GentlemanWalkDownLeft3 {
    walk_down
    walk_left * 2
    walk_down * 7
}

script Route39_EventScript_PokefanM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 5)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, Route39_Movement_PlayerWalkRightUp)
        applymovement(obj_R39_gsmiddleman1_2, Route39_Movement_PokefanMFaceUp)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, Route39_Movement_PlayerWalkUp)
    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_player, Route39_Movement_PlayerWalkUpRight)
        applymovement(obj_R39_gsmiddleman1_2, Route39_Movement_PokefanMFaceUp)
    } else {
        applymovement(obj_player, Route39_Movement_PlayerWalkUpLeft)
        applymovement(obj_R39_gsmiddleman1_2, Route39_Movement_PokefanMFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, Route39_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(28)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Route39_Movement_PlayerWalkRightUp {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Route39_Movement_PlayerWalkUp {
    walk_up * 3
    walk_in_place_down
}

movement Route39_Movement_PlayerWalkUpLeft {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Route39_Movement_PlayerWalkUpRight {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement Route39_Movement_PokefanMFaceUp {
    delay_8
    walk_in_place_up
}

movement Route39_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

script Route39_EventScript_LtSurge {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("Lt. Surge: Hey, you!\r"
           "Don’t you want a good memory of us\n"
           "together? How about taking a\f"
           "picture with me? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Lt. Surge: That’s OK...\r"
               "Let me know if you change your mind.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Your Photo Album is full.\r"
               "Access your PC to delete some pictures\n"
               "before you come back.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Lt. Surge: OK! OK!\r"
           "Show me a very good smile!\r")
    closemessage
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(80)
    faceplayer
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    npcmsg("Lt. Surge: Wow!\n"
           "This turned out to be a really\f"
           "good one!\r"
           "We root for Route 39!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

