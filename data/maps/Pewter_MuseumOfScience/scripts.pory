}

movement Pewter_MuseumOfScience_Movement_09F0 {
    walk_faster_up
    walk_faster_right
    face_down
}

script scr_seq_T03R0101_002 {
    simplenpcmsg("They say that meteorites struck\n"
                 "somewhere near Pewter City.\r"
                 "We would love to display them here\n"
                 "in our museum, but...\r"
                 "These meteorites are said to\n"
                 "emit strange energy and cannot\f"
                 "be carried away...")
    end
}

script scr_seq_T03R0101_003 {
    simplenpcmsg("There are two places that I love!\n"
                 "One is the Ruins of Alph in Johto...\r"
                 "The other is the Pewter Museum!\n"
                 "It’s so quiet and makes me feel calm.\r"
                 "Do you feel its admirable history\n"
                 "silently creeping up on you?")
    end
}

script scr_seq_T03R0101_004 {
    simplenpcmsg("I should be grateful for my long life.\r"
                 "Never did I think I would get to\n"
                 "see the bones of a dragon!")
    end
}

script scr_seq_T03R0101_005 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("Stringy and winding...\n"
           "Is this a plant Fossil?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T03R0101_006 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("It’s a curving, sharp Fossil.\n"
           "This may be...\f"
           "the Fossil of a carnivore?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T03R0101_007 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("It’s flat and looks hard.\n"
           "This may be...\f"
           "a part that protected its body?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T03R0101_008 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("Solid amber tree sap has\n"
           "something inside!\r"
           "If you can take it out, you can\n"
           "extract a Pokémon from\f"
           "ancient times...?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T03R0101_009 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("Small bones are put together to form\n"
           "some kind of a Pokémon!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T03R0101_010 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("The rough stone has words etched\n"
           "into it...\r"
           "“This is an unidentified object\n"
           "found at Mt. Moon. It is possibly a\f"
           "moon rock.”")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T03R0101_011 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("There are thick and well-read books!\r"
           "“The Principles of Fossil Extraction”\f"
           "“Archaeology Manual”\f"
           "“Lost Pokémon”\f"
           "“Pokémon Ancestors”\f"
           "“Friendships of Trainers and Pokémon”\f"
           "“Caring at the Loamy Layer of Kanto”")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T03R0101_012 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("Our museum mainly displays\n"
           "Fossils and specimens from Kanto.\r"
           "Please enjoy the extinct Pokémon\n"
           "through their remembrance, and\f"
           "step through time to the ancient world.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

mapscripts Pewter_MuseumOfScience_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: scr_seq_T03R0101_014
    INIT_SCRIPT_ON_LOAD: scr_seq_T03R0101_017
    INIT_SCRIPT_ON_RESUME: scr_seq_T03R0101_018
}
