script scr_seq_T03R0101_016 {
    followmonresetmovement
    lockall
    hasitem(ITEM_ENIGMA_STONE, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 0) {
        checkeventkey(0, VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) != 0) {
            applymovement(obj_T03R0101_daigo, Pewter_MuseumOfScience_Movement_0968)
            waitmovement
            npcmsg("Steven: People who dedicate themselves\n"
                   "to what they believe stand out in\f"
                   "a crowd.\r"
                   "But, my passion is no less than yours.\r")
            closemessage
            applymovement(obj_T03R0101_daigo, Pewter_MuseumOfScience_Movement_0970)
            waitmovement
            npcmsg("Wow!\n"
                   "The thing you have...\r")
            npcmsg("This stone is...so mysterious!\r"
                   "Something seems to be shining inside...\n"
                   "The stone is modest...yet hiding\f"
                   "something wonderful!\r"
                   "You should have it studied\n"
                   "by experts.\r")
            closemessage
            applymovement(obj_T03R0101_daigo, Pewter_MuseumOfScience_Movement_097C)
            applymovement(obj_T03R0101_gsassistantm, Pewter_MuseumOfScience_Movement_09C8)
            waitmovement
            getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
            togglefollowingpokemonmovement(0)
            waitfollowingpokemonmovement
            followingpokemonmovement(55)
            if (var(VAR_TEMP_x4001) == 6) {
                applymovement(obj_player, Pewter_MuseumOfScience_Movement_0998)
            } else {
                applymovement(obj_player, Pewter_MuseumOfScience_Movement_098C)
            }
            waitmovement
            waitfollowingpokemonmovement
            togglefollowingpokemonmovement(1)
            followingpokemonmovement(48)
            applymovement(obj_player, Pewter_MuseumOfScience_Movement_09A4)
            waitmovement
            bufferplayersname(0)
            npcmsg("{STRVAR_1 3, 0, 0} handed the Enigma Stone\n"
                   "to the researcher!\r")
            closemessage
            applymovement(obj_T03R0101_gsassistantm, Pewter_MuseumOfScience_Movement_09D0)
            waitmovement
            npcmsg("I will check it.\n"
                   "Can you hold on a second?\r")
            closemessage
            fadescreen(6, 1, 0, RGB_BLACK)
            waitfade
            wait(30, VAR_SPECIAL_RESULT)
            release(obj_T03R0101_daigo)
            movepersonfacing(obj_T03R0101_daigo, 25, 0, 7, DIR_SOUTH)
            wait(10, VAR_SPECIAL_RESULT)
            lock(obj_T03R0101_daigo)
            if (var(VAR_TEMP_x4001) != 6) {
                followmonisactive(VAR_TEMP_x4009)
                if (var(VAR_TEMP_x4009) != 0) {
                    applymovement(obj_partner_poke, Pewter_MuseumOfScience_Movement_09F0)
                    waitmovement
                }
            }
            fadescreen(6, 1, 1, RGB_BLACK)
            waitfade
            wait(10, VAR_SPECIAL_RESULT)
            applymovement(obj_T03R0101_gsassistantm, Pewter_MuseumOfScience_Movement_09D0)
            waitmovement
            npcmsg("Thank you for your patience!\n"
                   "It took me a little while,\f"
                   "but I have confirmed it!\r"
                   "This is an Orb that contains\n"
                   "what is called {COLOR 2}Soul Dew{COLOR 0}.\r")
            closemessage
            applymovement(obj_T03R0101_gsassistantm, Pewter_MuseumOfScience_Movement_09D8)
            waitmovement
            takeitem(ITEM_ENIGMA_STONE, 1, VAR_SPECIAL_RESULT)
            setvar(VAR_SPECIAL_x8004, 225)
            setvar(VAR_SPECIAL_x8005, 1)
            callstd(std_obtain_item_verbose)
            closemessage
            applymovement(obj_T03R0101_daigo, Pewter_MuseumOfScience_Movement_09B8)
            waitmovement
            applymovement(obj_player, Pewter_MuseumOfScience_Movement_0968)
            waitmovement
            npcmsg("Steven: Soul Dew is said to be the\n"
                   "solidified spirits of LATIAS and LATIOS.\r"
                   "It has the power to bring out the\n"
                   "true potential of LATIAS and LATIOS.\r"
                   "The spirits of these Pokémon and\n"
                   "Soul Dew are said to call out to\f"
                   "each other...\r"
                   "The only thing that puzzles me is\n"
                   "the place Soul Dew was found.\f"
                   "Why Kanto?\r")
            closemessage
            applymovement(obj_T03R0101_daigo, Pewter_MuseumOfScience_Movement_09C0)
            waitmovement
            setvar(VAR_UNK_4083, 2)
            removeobject(obj_T03R0101_daigo)
        }
    }
    releaseall
    end
}

