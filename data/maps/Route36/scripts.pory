script Route36_OnTransition {
    getweekday(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 4) {
        clearflag(FLAG_UNK_1C4)
    } else {
        setflag(FLAG_UNK_1C4)
    }
    end
}

script Route36_OnLoad {
    if (flag(FLAG_ENGAGING_STATIC_POKEMON)) {
        setflag(FLAG_HIDE_ROUTE_36_SUDOWOODO)
        removeobject(obj_R36_usokky)
        clearflag(FLAG_ENGAGING_STATIC_POKEMON)
        end
    }
    end
}

