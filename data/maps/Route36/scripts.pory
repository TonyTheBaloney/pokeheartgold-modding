script Route36_EventScript_SchoolKidM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getpartyleadalive(VAR_SPECIAL_x8002)
    monhasribbon(VAR_SPECIAL_RESULT, VAR_SPECIAL_x8002, RIBBON_CARELESS)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 41)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_DAILY_GOT_SHOCK_RIBBON)) {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 43)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_NUM_MET_WEEKDAY_SIBLINGS) == 7) { goto(_0490) }
    if (flag(FLAG_GOT_HARD_STONE_FROM_ARTHUR)) { goto(_0472) }
    getweekday(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 4) {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 15)
    } else {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 12)
        if (!itemspace(ITEM_HARD_STONE, 1)) { goto(_0486) }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_HARD_STONE_FROM_ARTHUR)
        addvar(VAR_NUM_MET_WEEKDAY_SIBLINGS, 1)
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 13)
    }
_046A:
    waitbuttonpress
    closemessage
    releaseall
    end
_0472:
    getstdmsgnaix(0, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 14)
    waitbuttonpress
    closemessage
    releaseall
    end
_0486:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
_0490:
    getweekday(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 4) { goto(_04B3) }
    getstdmsgnaix(0, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 15)
    goto(_046A)
_04B3:
    getstdmsgnaix(0, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 40)
    buffermonspeciesname(0, VAR_SPECIAL_x8002)
    msgboxextern(VAR_SPECIAL_RESULT, 42)
    giveribbon(VAR_SPECIAL_x8002, RIBBON_CARELESS)
    playfanfare(SEQ_ME_ITEM)
    waitfanfare
    setflag(FLAG_DAILY_GOT_SHOCK_RIBBON)
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route36_EventScript_Lass1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    hasitem(ITEM_SQUIRTBOTTLE, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("I’m the Flower Shop’s Floria!\r"
               "Listen, listen! When I sprinkled water\n"
               "on that wiggly tree, it jumped right up!\r"
               "It just has to be a Pokémon.\r"
               "I bet it would be shocked out of\n"
               "disguising itself if you soaked it!")
    } else {
        npcmsg("I’m the Flower Shop’s Floria!\r"
               "Listen, listen! When I sprinkled water\n"
               "on that wiggly tree, it jumped right up!\f"
               "It just has to be a Pokémon.\f"
               "If you soaked it...\r"
               "Oh, that’s the SquirtBottle!\r"
               "Soak the tree for me!\n"
               "I want to see what happens!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Route36_Movement_LassFaceUp {
    face_up
}

script Route36_EventScript_FatMan {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getitemquantity(ITEM_HM06, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Yo!\r"
               "Haven’t you had trouble with a boulder\n"
               "blocking your way? Of course you have!\r"
               "For people like you, there’s an HM\n"
               "that will come to your rescue!\r")
        giveitemnocheck(ITEM_HM06, 1)
    }
    npcmsg(msg_0390_R36_00005)
    waitbuttonpress
    closemessage
    releaseall
    end
    npcmsg(msg_0390_R36_00005)
    waitbuttonpress
    closemessage
    releaseall
    end
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

text msg_0390_R36_00005 {
    "It contains make-’em-faint Rock Smash.\r"
    "You can even use it to smash boulders\n"
    "once you’ve earned the Violet City\f"
    "Gym Badge!\r"
    "But beware!\n"
    "Hidden moves like this are hard for\f"
    "your Pokémon to forget once they’ve\f"
    "learned them.\r"
    "You should think carefully which\n"
    "Pokémon should learn it."
}

script Route36_EventScript_Lass2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_HIDE_ROUTE_36_SUDOWOODO)) {
        npcmsg("An odd tree is blocking the way\n"
               "to Ecruteak City.\r"
               "It’s preventing me from shopping.\f"
               "Something should be done about it.")
    } else {
        npcmsg("The odd tree is gone, as if it just\n"
               "walked away...!\f"
               "What? It was a Pokémon?\r"
               "Well, finally I can go to Ecruteak\n"
               "to do some shopping.\r"
               "If you follow the path from where the\n"
               "odd tree was, you’ll reach\f"
               "Ecruteak City!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route36_EventScript_RouteSign {
    directionsignpostex(1, 15, "Rt. 36\n"
                               "North to Ecruteak City")
    end
}

script Route36_EventScript_TrainerTips1 {
    trainertipsex(2, "Ruins of Alph\n"
                     "North Entrance")
    end
}

script Route36_EventScript_TrainerTips2 {
    trainertipsex(3, "Trainer Tips\r"
                     "The same kind of Pokémon may look the\n"
                     "same, but they can grow differently.\r"
                     "Their strengths may look the same\n"
                     "in the beginning, but those strengths\f"
                     "can change as they grow.")
    end
}

script Route36_EventScript_TrainerTips3 {
    trainertipsex(3, "Trainer Tips\r"
                     "The move Dig can take you back to\n"
                     "the entrance when you use it.\r"
                     "If you want to explore a cave or\n"
                     "something similar, a Pokémon with\f"
                     "Dig will be quite useful.")
    end
}

