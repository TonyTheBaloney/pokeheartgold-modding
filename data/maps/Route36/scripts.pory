            if (var(VAR_TEMP_x4000) == TRUE) { goto(_0251) }
            releaseall
            end
        }
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_025B) }
        end
    }
    hasitem(ITEM_SQUIRTBOTTLE, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_R36_gsgirl1_2, Route36_Movement_LassFaceUp)
        waitmovement
    }
    playse(SEQ_SE_GS_KI_UGOKU)
    applymovement(obj_R36_usokky, Route36_Movement_UsokkyFaceUp1)
    waitmovement
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_00B9) }
    releaseall
    end
_00B9:
    npcmsg(msg_0390_R36_00000)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_00E0) }
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_025B) }
    end
_00E0:
    bufferplayersname(0)
    npcmsg(msg_0390_R36_00001)
    playse(SEQ_SE_GS_ZENIGAME_JOURO)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == DIR_WEST) {
        applymovement(obj_player, Route36_Movement_PlayerFaceLeft)
    } elif (var(VAR_SPECIAL_RESULT) == DIR_SOUTH) {
        applymovement(obj_player, Route36_Movement_PlayerFaceDown)
    } else {
        applymovement(obj_player, Route36_Movement_PlayerFaceUp)
    }
    waitmovement
    setflag(FLAG_UNK_0B4)
    npcmsg(msg_0390_R36_00002)
    closemessage
    playse(SEQ_SE_GS_KI_UGOKU)
    applymovement(obj_R36_usokky, Route36_Movement_UsokkyFaceUp2)
    waitmovement
    setflag(FLAG_ENGAGING_STATIC_POKEMON)
    wildbattle(SPECIES_SUDOWOODO, 20, 0)
    clearflag(FLAG_ENGAGING_STATIC_POKEMON)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0255) }
    getstaticencounteroutcome(VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == BATTLE_OUTCOME_DRAW) { goto(_0251) }
    compare(VAR_TEMP_x4001, BATTLE_OUTCOME_MON_CAUGHT)
    callifeq(_023F)
    setflag(FLAG_UNK_0B5)
