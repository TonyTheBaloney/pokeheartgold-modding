script Route46_EventScript_Man {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GAVE_RIVAL_NAME_TO_OFFICER)) {
        npcmsg("You should try different routes\n"
               "sometime.\r"
               "You never know what Pokémon\n"
               "you’re gonna get!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("A dead end...?\r"
           "Did I take the wrong path?\r"
           "I didn’t know this was only\n"
           "one way.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

