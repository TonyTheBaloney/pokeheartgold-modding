script EmbeddedTowerKyogreRoom_OnTransition {
    if (var(VAR_SCENE_EMBEDDED_TOWER) >= 4) { goto(_007C) }
    getgameversion(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) != 7) {
        goto(_0040)
    _003E:
        end
    _0040:
        setflag(FLAG_HIDE_EMBEDDED_TOWER_KYOGRE)
        setflag(FLAG_HIDE_EMBEDDED_TOWER_KYOGRE_HIKER)
        end
    _004A:
        if (flag(FLAG_BEAT_OR_ESCAPED_FROM_GROUDON_OR_KYOGRE)) { goto(_007C) }
        hasitem(ITEM_BLUE_ORB, 1, VAR_TEMP_x4000)
