script Pewter_Gym_OnTransition {
    getphonebookrematch(PHONE_CONTACT_BROCK, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 0) {
        setflag(FLAG_HIDE_PEWTER_GYM_BROCK)
        end
    }
    checkregisteredphonenumber(PHONE_CONTACT_BROCK, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_00A4) }
    checkbadge(BADGE_EARTH, VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) == 1) { goto(_0053) }
    goto(_00F5)
    end
_0053:
    getcurrenthour(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 12) {
        setflag(FLAG_HIDE_PEWTER_GYM_BROCK)
    } elif (var(VAR_TEMP_x4000) == 13) {
        setflag(FLAG_HIDE_PEWTER_GYM_BROCK)
    } elif (var(VAR_TEMP_x4000) == 14) {
        setflag(FLAG_HIDE_PEWTER_GYM_BROCK)
    } else {
        goto(_00F5)
    }
    end
_00A4:
    getcurrenthour(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 17) {
        setflag(FLAG_HIDE_PEWTER_GYM_BROCK)
    } elif (var(VAR_TEMP_x4000) == 18) {
        setflag(FLAG_HIDE_PEWTER_GYM_BROCK)
    } elif (var(VAR_TEMP_x4000) == 19) {
        setflag(FLAG_HIDE_PEWTER_GYM_BROCK)
    } else {
        goto(_00F5)
    }
    end
_00F5:
    clearflag(FLAG_HIDE_PEWTER_GYM_BROCK)
    end
}

script Pewter_Gym_EventScript_Brock {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_BOULDER, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0195) }
    npcmsg("Brock: Wow, it’s not often that we\n"
           "get a challenger from Johto.\r"
           "I’m Brock, the Pewter Gym Leader.\f"
           "I’m an expert on Rock-type Pokémon.\r"
           "My Pokémon are impervious to most\n"
           "physical attacks.\r"
           "You’ll have a hard time inflicting\n"
           "any damage.\r"
           "Come on!\r")
    closemessage
    trainerbattle(TRAINER_LEADER_BROCK_BROCK, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    givebadge(BADGE_BOULDER)
    addvar(VAR_UNK_4135, 1)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    settrainerflag(TRAINER_CAMPER_JERRY)
    settrainerflag(TRAINER_HIKER_EDWIN)
    npcmsg("Brock: Your Pokémon’s powerful\n"
           "attacks overcame my\f"
           "rock-hard resistance...\r"
           "You’re stronger than\n"
           "I expected...\f"
           "Go ahead--take this Badge.\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Boulder Badge from Brock!")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    bufferplayersname(0)
    gendermsgbox("Brock: I really enjoyed the battle\n"
                 "with you, {STRVAR_1 3, 0, 0}!\f"
                 "I’ll give you the move Rock Slide, too.\r"
                 "It can sometimes cause your foe\n"
                 "to flinch.\r", "Brock: I really enjoyed the battle\n"
                                 "with you, {STRVAR_1 3, 0, 0}!\f"
                                 "I’ll give you the move Rock Slide, too.\r"
                                 "It can sometimes cause your foe\n"
                                 "to flinch.\r")
    goto(_016C)
_016C:
    if (!itemspace(ITEM_TM80, 1)) { goto(_01AE) }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM80_FROM_BROCK)
_0195:
    if (!flag(FLAG_GOT_TM80_FROM_BROCK)) { goto(_016C) }
    bufferplayersname(0)
    npcmsg("Brock: The world is huge. There are\n"
           "still many strong Trainers like you.\r"
           "Just wait and see.\r"
           "I’m going to become a lot\n"
           "stronger, too.")
    waitbuttonpress
    closemessage
    releaseall
    end
_01AE:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

script Pewter_Gym_EventScript_GymGuide {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_BOULDER, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Yo! Legend in the making! That Gym\n"
               "didn’t give you much trouble.\r"
               "The way you took charge was\n"
               "really inspiring.\f"
               "I mean that seriously.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Yo! Legend in the making! You look...\f"
           "really rocking.\r"
           "Are you battling the Gym Leaders\n"
           "of Kanto?\r"
           "They’re strong and dedicated people,\n"
           "just like Johto’s Gym Leaders.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Pewter_Gym_EventScript_GymSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_BOULDER, VAR_SPECIAL_RESULT)
    bufferplayersname(0)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Pewter City Pokémon Gym")
    } else {
        npcmsg("Pewter City Pokémon Gym\r"
               "Leader: Brock\n"
               "Certified Trainer!\f"
               "{STRVAR_1 3, 0, 0}")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

mapscripts Pewter_Gym_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Pewter_Gym_OnTransition
}
