script Celadon_DepartmentStore_4F_EventScript_Falkner {
    checkregisteredphonenumber(PHONE_CONTACT_FALKNER, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) {
        playse(SEQ_SE_DP_SELECT)
        lockall
        faceplayer
        npcmsg("Falkner: Hey, why don’t we take\n"
               "a picture together? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Falkner: That’s all right.\n"
                   "I’ll just take one with my dad...")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        photoalbumisfull(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Your Photo Album is full.\r"
                   "Access your PC and delete\n"
                   "some pictures.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Falkner: All right!\n"
               "Are you ready?\r")
        closemessage
        setflag(FLAG_UNK_189)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        cameronphoto(2)
        faceplayer
        lockall
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        clearflag(FLAG_UNK_189)
        npcmsg("Falkner: Yes!\n"
               "We look good.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_TEMP_x4004) != 1) { goto(_00CC) }
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("Falkner: So, you did change your mind.\n"
           "You now think my dad\f"
           "is greater? {YESNO 0}")
    goto(_011B)
    end
}

