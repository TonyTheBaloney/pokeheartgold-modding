script Blackthorn_EastHouse_EventScript_Lass {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_TRADE_BLACKTHORN_CITY_DRAGONAIR_DODRIO)) {
        npcmsg("How is that DODRIO I traded you doing?\r"
               "Your DRAGONAIR’s so cute!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("DRAGONAIR’s cute, but I don’t have\n"
           "it. Do you have DRAGONAIR㊛?\r"
           "Want to trade it for my DODRIO? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_003B) }
    goto(_00BF)
_003B:
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    choosepartymonfortrade
    getpartyselection(VAR_SPECIAL_RESULT)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_RESULT) == 255) { goto(_00BF) }
    loadnpctrade(3)
    copyvar(VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT)
    getpartymonspecies(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    mongetgender(VAR_SPECIAL_x8004, VAR_SPECIAL_x8006)
    if (var(VAR_SPECIAL_x8006) == 0) { goto(_00B2) }
    npctradegetreqspecies(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_x8005) != VAR_SPECIAL_RESULT) { goto(_00B2) }
    npctradeexec(VAR_SPECIAL_x8004)
    npctradeend
    setflag(FLAG_TRADE_BLACKTHORN_CITY_DRAGONAIR_DODRIO)
    npcmsg("Wow! Thank you!\n"
           "I always wanted DRAGONAIR!")
    waitbuttonpress
    closemessage
    releaseall
    end
_00B2:
    npctradeend
    npcmsg("That’s not DRAGONAIR㊛.\n"
           "Please trade with me if you get one.")
    waitbuttonpress
    closemessage
    releaseall
    end
_00BF:
    npcmsg("You don’t want to trade?\n"
           "Oh, darn...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

