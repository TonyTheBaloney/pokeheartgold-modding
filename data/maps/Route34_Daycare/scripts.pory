movement Route34_Daycare_Movement_FriendExclamation {
    emote_exclamation_mark
}

movement Route34_Daycare_Movement_FriendWalkUp1 {
    delay_8
    walk_up * 3
}

movement Route34_Daycare_Movement_MarillWalkUp {
    walk_fast_up * 3
    jump_in_place_fast_up * 2
}

movement Route34_Daycare_Movement_PlayerWalkUp {
    delay_8
    walk_up * 3
}

movement Route34_Daycare_Movement_FriendFaceDown {
    walk_in_place_down
}

movement Route34_Daycare_Movement_FriendWalkLeftDown {
    walk_left
    walk_down * 3
    delay_8
    emote_exclamation_mark
    walk_in_place_up
}

movement Route34_Daycare_Movement_MarillWalkLeftDown {
    walk_left * 2
    walk_down * 2
}

movement Route34_Daycare_Movement_PlayerFaceLeft {
    walk_in_place_left
}

movement Route34_Daycare_Movement_FriendWalkUp2 {
    delay_8
    walk_up
    walk_in_place_right
}

movement Route34_Daycare_Movement_MarillJumpLeft {
    walk_in_place_right
    lock_dir
    jump_near_fast_left
    unlock_dir
}

movement Route34_Daycare_Movement_FriendFaceRight {
    walk_in_place_right
}

movement Route34_Daycare_Movement_FriendFaceUp {
    walk_in_place_up
}

movement Route34_Daycare_Movement_MarillFaceUp {
    walk_in_place_up
}

movement Route34_Daycare_Movement_FriendExit {
    walk_down * 2
    walk_right
    walk_down
    set_invisible
}

movement Route34_Daycare_Movement_MarillWalkDownRight {
    delay_8
    jump_in_place_fast_up * 2
    delay_8
    walk_fast_down * 3
    walk_fast_right * 2
    walk_in_place_fast_down
}

movement Route34_Daycare_Movement_PlayerFaceDown {
    delay_8 * 2
    walk_in_place_down
}

script Route34_Daycare_OnResume {
    updatedaycaremonobjects
    end
}

