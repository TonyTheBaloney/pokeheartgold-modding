script PokeathlonDome_Interior_1F_EventScript_Nurse1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_UNK_114)) {
        npcmsg("Hello. Oh, you must be new here.\n"
               "Welcome to the Athlete Shop!\r"
               "Have you and your Pokémon\n"
               "been exercising?\r"
               "Flying sweat!\n"
               "Breathing in unison!\f"
               "Newborn friendship!\r"
               "We support your Pokéathlete lifestyle.\n"
               "The Athlete Points you have earned\f"
               "can be used here for prizes.\r"
               "Let me say this again.\n"
               "Welcome to the Athlete Shop! {YESNO 0}")
        setflag(FLAG_UNK_114)
        goto(_0377)
        end
    }
    checkpokeathlondailymarthasstock(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("We are closed for the day.\n"
               "Please come back tomorrow for\f"
               "a whole new set of prizes!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Welcome to the Athlete Shop! {YESNO 0}")
_0377:
    touchscreenmenuhide
    menuinitstdgmm(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(msg_0191_00325, 255, 0)
    menuitemadd(msg_0191_00324, 255, 1)
    menuitemadd(msg_0191_00323, 255, 2)
    menuexec
    Switch(VAR_SPECIAL_RESULT)
    Case(0, _03C7)
    Case(1, _03D7)
    goto(_03E4)
    closemessage
    releaseall
    end
_03C7:
    holdmsg
    setsavedbottomscreenapp(0)
    pokeathlondailymart
    goto(_03E4)
    end
_03D7:
    touchscreenmenushow
    npcmsg("The scores in the Pokéathlon...\n"
           "The proof of your friendship with your\f"
           "Pokémon, so to speak, give you\f"
           "Athlete Points.\r"
           "You can trade them here for\n"
           "various prizes.\r"
           "Score as much as possible and come back\n"
           "here for prizes!\r"
           "Is there anything else I can do\n"
           "for you? {YESNO 0}")
    goto(_0377)
    end
_03E4:
    touchscreenmenushow
    npcmsg(msg_0138_D49R0101_00051)
    waitbuttonpress
    closemessage
    releaseall
    end
}

