script PokeathlonDome_Interior_1F_EventScript_Sign11 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("Opening the Pokéathlon Data...\r")
_0AF3:
    npcmsg("Which data would you like to see? {YESNO 0}")
    touchscreenmenuhide
    menuinit(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(94, 255, 0)
    menuitemadd(95, 255, 1)
    menuitemadd(96, 255, 2)
    menuitemadd(97, 255, 3)
    menuexec
    Switch(VAR_SPECIAL_RESULT)
    Case(0, _0B57)
    Case(1, _0B65)
    Case(2, _0B73)
    goto(_0BA5)
    end
_0B57:
    setvar(VAR_TEMP_x4007, 0)
    goto(_0B81)
    end
_0B65:
    setvar(VAR_TEMP_x4007, 1)
    goto(_0B81)
    end
_0B73:
    setvar(VAR_TEMP_x4007, 2)
    goto(_0B81)
    end
_0B81:
    npcmsg("Accessing......")
    wait(4, VAR_SPECIAL_RESULT)
    npcmsg("Accessing............")
    wait(4, VAR_SPECIAL_RESULT)
    closemessage
    playse(SEQ_SE_DP_DECIDE)
    showpokeathlonrecords(VAR_TEMP_x4007)
    goto(_0AF3)
    end
_0BA5:
    touchscreenmenushow
    npcmsg("Thank you for accessing!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokeathlonDome_Interior_1F_EventScript_OldMan {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_152)) { goto(_0C4C) }
    npcmsg("Wow, you have such good eyes! Can\n"
           "I tell you about my last dream? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Hmmm... My discerning eyes must have\n"
               "become weak...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("I used to love Jump events.\r"
           "The record I have from when I was fully\n"
           "active as a Pokéathlete is 998 jumps!\r"
           "Just two more!\n"
           "All I had to make was two more!\r"
           "I had to retire due to my age...\n"
           "Could I ask you to jump 1,000 times\f"
           "for me?\r")
    getpokeathlonstat(14, VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) >= 1000) {
        npcmsg("Oh! You!\n"
               "It is so wonderful of you!\f"
               "You have jumped 1,000 times.\r"
               "Thank you so much!\n"
               "This is just a token of my appreciation.\r")
        if (!itemspace(ITEM_RARE_CANDY, 1)) { goto(_0C42) }
        callstd(std_give_item_verbose)
        adjustpokeathlonstat11(0, 100)
        setflag(FLAG_UNK_152)
        goto(_0C4C)
        end
    _0C42:
        callstd(std_bag_is_full)
        closemessage
        releaseall
        end
    _0C4C:
        npcmsg("I’m now your fan. I’m old as you see,\n"
               "but I will support you no matter what.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Well, the record may make you dizzy.\n"
           "But you’re still young.\f"
           "You can do it!\r"
           "I’ll just sit and wait.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokeathlonDome_Interior_1F_EventScript_Man2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_153)) { goto(_0CF0) }
    getpokeathlonstat(15, VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) < 500) {
        npcmsg("You know what?\n"
               "I have tackled over 500 times finally!\r")
    } elif (var(VAR_TEMP_x4000) < 1000) {
        npcmsg("You know what?\n"
               "I have tackled over 1,000 times!\f"
               "Finally!\r")
    } else {
        npcmsg("You know what? I’ve finally tackled\n"
               "over 2,000 times! I bet no one can\f"
               "break this record easily!\r")
    }
    if (var(VAR_TEMP_x4000) >= 2001) {
        npcmsg("......!\n"
               "No! That’s not right!\f"
               "Your record beats mine?\r"
               "Nooooo!\n"
               "...OK. You win.\r"
               "I admit complete defeat.\n"
               "Please take this.\r")
        if (!itemspace(ITEM_RARE_CANDY, 1)) { goto(_0C42) }
        callstd(std_give_item_verbose)
        adjustpokeathlonstat11(0, 100)
        setflag(FLAG_UNK_153)
        goto(_0CF0)
        end
    _0CF0:
        npcmsg("Whew!\n"
               "It’s strange, but I feel great.\r"
               "I do regret that I lost, but it made\n"
               "me know where I am.\r"
               "I understand that there are many\n"
               "Pokéathletes better than me.\r"
               "This is where I begin to grow again!\n"
               "Keep up the good work!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Haha!\n"
           "You’re doing fine, but not as good\f"
           "as me. I wonder if any Pokéathlete\f"
           "could be better at tackling than me.\f"
           "Sigh...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

mapscripts PokeathlonDome_Interior_1F_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: PokeathlonDome_Interior_1F_OnTransition
}
