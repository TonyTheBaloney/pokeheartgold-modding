script PokeathlonDome_Interior_1F_EventScript_WhitneyTrigger {
    followmonresetmovement
    lockall
    getplayerfacing(VAR_TEMP_x400A)
    if (var(VAR_TEMP_x400A) == 0) {
        applymovement(obj_player, PokeathlonDome_Interior_1F_Movement_PlayerExclamation1)
    } else {
        applymovement(obj_player, PokeathlonDome_Interior_1F_Movement_PlayerExclamation2)
    }
    waitmovement
    clearflag(FLAG_HIDE_POKEATHLON_RECEPTION_WHITNEY)
    addobject(obj_D49R0101_gsleader3)
    movepersonfacing(obj_D49R0101_gsleader3, 23, 0, 20, DIR_NORTH)
    if (var(VAR_TEMP_x400A) == 0) {
        applymovement(obj_D49R0101_gsleader3, PokeathlonDome_Interior_1F_Movement_WhitneyWalkRightUp1)
        applymovement(obj_player, PokeathlonDome_Interior_1F_Movement_PlayerFaceRight2)
    } else {
        applymovement(obj_D49R0101_gsleader3, PokeathlonDome_Interior_1F_Movement_WhitneyWalkUp2)
    }
    waitmovement
    bufferplayersname(0)
    npcmsg("Whitney: Hi, {STRVAR_1 3, 0, 0}! Are you here\n"
           "for the Pokéathlon? Me, too!\r"
           "I have been so excited since its\n"
           "construction. It is close to Goldenrod\f"
           "City, you know?\r")
    closemessage
    wait(30, VAR_SPECIAL_RESULT)
    if (var(VAR_TEMP_x400A) == 0) {
        applymovement(obj_D49R0101_gsleader3, PokeathlonDome_Interior_1F_Movement_WhitneyWalkLeft)
    } else {
        applymovement(obj_D49R0101_gsleader3, PokeathlonDome_Interior_1F_Movement_WhitneyWalkUp1)
    }
    waitmovement
    npcmsg("Huh?\r"
           "Were you going to participate in\n"
           "the Pokéathlon looking like that?\r"
           "You’re not prepared at all, are you?\r"
           "So...\n"
           "Are you a medium or a small?\f"
           "You look more like a medium...\r"
           "OK!\n"
           "I’ll get you a jersey that suits you!\r"
           "You want to look your best if you’re\n"
           "going to participate in the Pokéathlon,\f"
           "don’t you?\r"
           "Wait right there!\r")
    closemessage
    if (var(VAR_TEMP_x400A) == 0) {
        applymovement(obj_D49R0101_gsleader3, PokeathlonDome_Interior_1F_Movement_WhitneyWalkRightUp2)
    } elif (var(VAR_TEMP_x400A) == 3) {
        applymovement(obj_D49R0101_gsleader3, PokeathlonDome_Interior_1F_Movement_WhitneyWalkRightUp3)
        applymovement(obj_player, PokeathlonDome_Interior_1F_Movement_PlayerFaceRight1)
    } else {
        applymovement(obj_D49R0101_gsleader3, PokeathlonDome_Interior_1F_Movement_WhitneyWalkRightUp4)
        applymovement(obj_player, PokeathlonDome_Interior_1F_Movement_PlayerFaceRight1)
        waitmovement
        applymovement(obj_D49R0101_gsleader3, PokeathlonDome_Interior_1F_Movement_WhitneyFaceUp)
        applymovement(obj_player, PokeathlonDome_Interior_1F_Movement_PlayerFaceDown)
    }
    waitmovement
    npcmsg("This is just right for you!\r")
    closemessage
    npcmsg("{STRVAR_1 3, 0, 0} received a jersey!")
    playfanfare(SEQ_ME_ITEM)
    waitfanfare
    npcmsg("You look perfect.\n"
           "Now that you are ready, I will...\r"
           "Oh, no!\n"
           "Where are my Pokémon?\r"
           "I have to go back.\n"
           "See ya!\r")
    closemessage
    if (var(VAR_TEMP_x400A) == 0) {
        applymovement(obj_D49R0101_gsleader3, PokeathlonDome_Interior_1F_Movement_WhitneyWalkDownLeft1)
    } elif (var(VAR_TEMP_x400A) == 3) {
        applymovement(obj_D49R0101_gsleader3, PokeathlonDome_Interior_1F_Movement_WhitneyWalkDownLeft2)
    } else {
        applymovement(obj_D49R0101_gsleader3, PokeathlonDome_Interior_1F_Movement_WhitneyWalkDown)
    }
    applymovement(obj_player, PokeathlonDome_Interior_1F_Movement_PlayerFaceDown)
    waitmovement
    removeobject(obj_D49R0101_gsleader3)
    setflag(FLAG_HIDE_POKEATHLON_RECEPTION_WHITNEY)
    releaseall
    setvar(VAR_UNK_40E2, 1)
    end
}

movement PokeathlonDome_Interior_1F_Movement_WhitneyWalkLeft {
    lock_dir
    jump_near_fast_right
    unlock_dir
    delay_16 * 2
    walk_fast_left
}

movement PokeathlonDome_Interior_1F_Movement_WhitneyWalkUp1 {
    lock_dir
    jump_near_fast_down
    unlock_dir
    delay_16 * 2
    walk_fast_up
}

