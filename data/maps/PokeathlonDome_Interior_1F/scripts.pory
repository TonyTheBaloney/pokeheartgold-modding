        goto(_0C4C)
        end
    _0C42:
        callstd(std_bag_is_full)
        closemessage
        releaseall
        end
    _0C4C:
        npcmsg(msg_0138_D49R0101_00108)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg(msg_0138_D49R0101_00106)
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_D49R0101_022 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_153)) { goto(_0CF0) }
    getpokeathlonstat(15, VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) < 500) {
        npcmsg(msg_0138_D49R0101_00109)
    } elif (var(VAR_TEMP_x4000) < 1000) {
        npcmsg(msg_0138_D49R0101_00111)
    } else {
        npcmsg(msg_0138_D49R0101_00112)
    }
    if (var(VAR_TEMP_x4000) >= 2001) {
        npcmsg(msg_0138_D49R0101_00113)
        if (!itemspace(ITEM_RARE_CANDY, 1)) { goto(_0C42) }
        callstd(std_give_item_verbose)
        adjustpokeathlonstat11(0, 100)
        setflag(FLAG_UNK_153)
        goto(_0CF0)
        end
    _0CF0:
        npcmsg(msg_0138_D49R0101_00114)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg(msg_0138_D49R0101_00110)
    waitbuttonpress
    closemessage
    releaseall
    end
}

mapscripts PokeathlonDome_Interior_1F_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: scr_seq_D49R0101_023
}
