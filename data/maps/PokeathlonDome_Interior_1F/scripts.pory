}

movement PokeathlonDome_Interior_1F_Movement_PlayerFaceRight2 {
    delay_2
    delay_8 * 8
    walk_in_place_right
}

movement PokeathlonDome_Interior_1F_Movement_WhitneyWalkRightUp2 {
    walk_in_place_down
