script PokeathlonDome_Interior_1F_EventScript_Sign1 {
    simplenpcmsg("“Hurdle Dash”\r"
                 "Many Hurdles await your Pokémon!\n"
                 "Be faster and more precise than\f"
                 "everyone else! Jump over the Hurdles\f"
                 "and aim for number one!")
    end
}

script PokeathlonDome_Interior_1F_EventScript_Sign2 {
    simplenpcmsg("“Pennant Capture”\r"
                 "Pennants are hidden on the beach.\n"
                 "Fight over them and come back with as\f"
                 "many Pennants as you can!")
    end
}

script PokeathlonDome_Interior_1F_EventScript_Sign3 {
    simplenpcmsg("“Circle Push”\r"
                 "The time has come to show off your\n"
                 "Pokémon’s Power!\f"
                 "Push them away and stay in the Circle!")
    end
}

script PokeathlonDome_Interior_1F_EventScript_Sign4 {
    simplenpcmsg("“Block Smash”\r"
                 "A mountain of Blocks awaits\n"
                 "your Pokémon!\f"
                 "Use its Power to smash them all!")
    end
}

script PokeathlonDome_Interior_1F_EventScript_Sign5 {
    simplenpcmsg("“Disc Catch”\r"
                 "Discs are thrown at you. Jump and\n"
                 "catch them in the air!\r"
                 "Don’t get cornered by others.\n"
                 "Catch as many as you can!")
    end
}

script PokeathlonDome_Interior_1F_EventScript_Sign6 {
    simplenpcmsg("“Lamp Jump”\r"
                 "You never know how high you’re going\n"
                 "to bounce! Use your Pokémon’s Jump\f"
                 "and Skill to score!")
    end
}

script PokeathlonDome_Interior_1F_EventScript_Sign7 {
    simplenpcmsg("“Relay Run”\r"
                 "Keep running until you can’t run\n"
                 "any more! Three Pokémon work together\f"
                 "to achieve victory!")
    end
}

script PokeathlonDome_Interior_1F_EventScript_Sign8 {
    simplenpcmsg("“Ring Drop”\r"
                 "Pokémon tackle! Go beyond your Stamina\n"
                 "limit and stay in the Ring!")
    end
}

script PokeathlonDome_Interior_1F_EventScript_Sign9 {
    simplenpcmsg("“Snow Throw”\r"
                 "On an incredibly cold playfield,\n"
                 "millions of balls of Snow await!\r"
                 "Aim and throw!\n"
                 "Time it right to show your skill!")
    end
}

script PokeathlonDome_Interior_1F_EventScript_Sign10 {
    simplenpcmsg("“Goal Roll”\r"
                 "Put your heart into hitting the ball!\n"
                 "Attack! Defend your Goal!\r"
                 "Aim for the other Goals!\n"
                 "Who gets the victory?")
    end
}

script PokeathlonDome_Interior_1F_EventScript_SchoolKidM {
    simplenpcmsg("So they have ten events?\n"
                 "...Which Pokémon should I choose?")
    end
}

script PokeathlonDome_Interior_1F_EventScript_Woman {
    simplenpcmsg("There are five Pokéathlon courses!\r"
                 "They are divided into Speed, Power,\n"
                 "Stamina, Jump, and Skill.\r"
                 "You have to choose your Pokémon\n"
                 "carefully according to the course.")
    end
}

script PokeathlonDome_Interior_1F_EventScript_PokefanM {
    simplenpcmsg("Some Pokémon are good at Speed events.\n"
