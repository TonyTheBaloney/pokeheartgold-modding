            Switch(VAR_SPECIAL_x8000)
            Case(0, _07C0)
            Case(1, _07CC)
            Case(2, _07D8)
            touchscreenmenushow
            npcmsg(msg_0138_D49R0101_00091)
            goto(_0A5C)
            end
        }
        hasspaceforitem(VAR_SPECIAL_x8001, 1, VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0A35) }
