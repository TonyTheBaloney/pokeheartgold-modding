        callifeq(_0844)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            touchscreenmenushow
            if (var(VAR_TEMP_x4005) == 0) {
                npcmsg("Not enough money...")
            } elif (var(VAR_TEMP_x4005) == 1) {
                npcmsg("Not enough points...")
            }
            goto(_0A5C)
        _0A35:
            touchscreenmenushow
            callstd(std_bag_is_full)
            closemessage
            if (var(VAR_TEMP_x4005) == 0) {
