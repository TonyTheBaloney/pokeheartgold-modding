    walk_in_place_up
    delay_8
    walk_fast_right * 6
    walk_fast_up * 6
    walk_left
    set_invisible
    delay_16 * 2
    face_right
    set_visible
    walk_right
    walk_fast_down * 6
    walk_fast_left * 6
}

movement PokeathlonDome_Interior_1F_Movement_WhitneyWalkRightUp3 {
    walk_fast_right * 7
    walk_in_place_down
    delay_8
    walk_in_place_up
    delay_8
    walk_fast_up * 7
    walk_left
    set_invisible
    delay_16 * 2
    face_right
    set_visible
    walk_right
    walk_fast_down * 6
    walk_fast_left * 6
}

movement PokeathlonDome_Interior_1F_Movement_WhitneyWalkRightUp4 {
    walk_fast_right * 7
    walk_in_place_down
    delay_8
    walk_in_place_up
    delay_8
