text msg_0066_D23R0102_00032 {
    "Buena: Tune in to my show again\n"
    "tomorrow!\r"
}

script Goldenrod_RadioTower_2F_EventScript_Beauty2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 4) {
        npcmsg("Somebody needs to put a beating on this\n"
               "mean Team Rocket!\f"
               "Like three years ago even!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    hasitem(ITEM_BLUE_CARD, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) >= 1) { goto(_05B0) }
    npcmsg("Save up the Blue Card points for some\n"
           "choice prizes!")
    waitbuttonpress
    closemessage
    releaseall
    end
_05B0:
    bufferint(0, VAR_BLUE_CARD_POINTS)
    npcmsg("Your points total on your\n"
           "Blue Card is now {STRVAR_1 51, 0, 0}.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Goldenrod_RadioTower_2F_Movement_PlayerWalkDownLeft1 {
    face_down
    walk_down * 2
    walk_left
    walk_in_place_left
}

movement Goldenrod_RadioTower_2F_Movement_FollowMonWalkDownLeft {
    walk_down * 2
    walk_left
    walk_in_place_up
}

movement Goldenrod_RadioTower_2F_Movement_PlayerWalkDown {
    face_down
    walk_down
    walk_in_place_left
}

movement Goldenrod_RadioTower_2F_Movement_FollowMonWalkDown {
    walk_down
    walk_in_place_up
}

movement Goldenrod_RadioTower_2F_Movement_PlayerFaceUp {
    walk_in_place_up
}

movement Goldenrod_RadioTower_2F_Movement_PlayerWalkDownLeft2 {
    walk_down
    walk_left * 2
}

movement Goldenrod_RadioTower_2F_Movement_BuenaFaceLeft {
    walk_in_place_left
}

movement Goldenrod_RadioTower_2F_Movement_BuenaFaceDown {
    walk_in_place_down
}

movement Goldenrod_RadioTower_2F_Movement_BuenaWalkDown {
    walk_down
}

movement Goldenrod_RadioTower_2F_Movement_BuenaWalkUp {
    face_up
    walk_up
    walk_in_place_left
}

movement Goldenrod_RadioTower_2F_Movement_BeautyWalkDownRight {
    walk_down * 2
    walk_right * 3
}

movement Goldenrod_RadioTower_2F_Movement_BeautyWalkLeftUp {
    walk_left * 3
    walk_up * 2
    walk_in_place_down
}

mapscripts Goldenrod_RadioTower_2F_MapScripts {
