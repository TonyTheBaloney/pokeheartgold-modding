            closemessage
            getplayerfacing(VAR_TEMP_x4000)
            followmonisactive(VAR_TEMP_x4002)
            if (var(VAR_TEMP_x4002) != 0) {
                release(obj_partner_poke)
                if (var(VAR_TEMP_x4000) == 2) {
                    applymovement(obj_player, Goldenrod_RadioTower_2F_Movement_PlayerWalkDownLeft1)
                    applymovement(obj_partner_poke, Goldenrod_RadioTower_2F_Movement_FollowMonWalkDownLeft)
                } else {
                    applymovement(obj_player, Goldenrod_RadioTower_2F_Movement_PlayerWalkDown)
                    applymovement(obj_partner_poke, Goldenrod_RadioTower_2F_Movement_FollowMonWalkDown)
                }
                waitmovement
                lock(obj_partner_poke)
            } else {
                if (var(VAR_TEMP_x4000) == 2) {
