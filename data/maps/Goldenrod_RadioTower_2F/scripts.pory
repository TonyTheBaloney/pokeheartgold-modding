script Goldenrod_RadioTower_2F_OnTransition {
    setflag(FLAG_HIDE_ROCKET_TAKEOVER_1)
    setflag(FLAG_HIDE_ROCKET_TAKEOVER_2)
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 4) {
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_1)
    } elif (var(VAR_SCENE_ROCKET_TAKEOVER) < 2) {
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_2)
    } else {
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_2)
    }
    end
}

script Goldenrod_RadioTower_2F_OnResume {
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 5) {
        movepersonfacing(obj_D23R0102_policeman, 2, 1, 7, DIR_EAST)
    }
    end
}

script Goldenrod_RadioTower_2F_EventScript_2FSalesSign {
    simplenpcmsg("2F Sales")
    end
}

script Goldenrod_RadioTower_2F_EventScript_Sign {
    simplenpcmsg("Pokémon Talk with Professor Oak\n"
                 "The Hottest Show on the Air!")
    end
}

script Goldenrod_RadioTower_2F_EventScript_2FStudio2Sign {
    simplenpcmsg("2F Studio 2")
    end
}

script Goldenrod_RadioTower_2F_EventScript_Jigglypuff {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_JIGGLYPUFF, 0)
    npcmsg("JIGGLYPUFF: Jiggly...")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Goldenrod_RadioTower_2F_EventScript_Beauty1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 4) {
        npcmsg("Why would they want to take over the\n"
               "Radio Tower?")
    } else {
        npcmsg("Lullabies on the radio make wild\n"
               "Pokémon sleepy.\r"
               "That’s why you don’t see many Pokémon\n"
               "when the radio plays lullabies in the\f"
               "tall grass.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Goldenrod_RadioTower_2F_EventScript_Man {
    simplenpcmsg("Radio is good, you know?\r"
                 "Cool music and Pokémon information...\n"
                 "Surprising news and moving dramas...\f"
                 "It has everything!\r"
                 "The only thing missing would be images.\r"
                 "..................\n"
                 "Oops, they call that a TV!")
    end
}

script Goldenrod_RadioTower_2F_EventScript_Policeman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 5) {
        npcmsg("Feel free to look around anywhere.\n"
               "The Director is nice again, just as he\f"
               "was before.")
    } else {
        npcmsg("Sorry. Authorized personnel only\n"
               "beyond this point.\r"
               "It wasn’t that way before. There’s\n"
               "something wrong with the Director...")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

