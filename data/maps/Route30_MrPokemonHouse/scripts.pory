script scr_seq_R30R0201_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_EMBEDDED_TOWER) < 4) {
        if (var(VAR_SCENE_EMBEDDED_TOWER) >= 2) { goto(_02CD) }
    }
    if (flag(FLAG_EXCHANGED_RED_SCALE)) {
        if (!flag(FLAG_UNK_107)) { goto(_011F) }
