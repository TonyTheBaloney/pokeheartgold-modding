            applymovement(obj_R30R0201_gsgentleman, Route30_MrPokemonHouse_Movement_0220)
        }
        waitmovement
        releaseall
        end
    }
    if (flag(FLAG_GOT_RED_SCALE)) { goto(_012A) }
    if (var(VAR_SCENE_MR_POKEMONS_HOUSE) >= 2) { goto(_011F) }
    npcmsg("Sorry to trouble you, having you go\n"
           "back and forth.\r"
           "But please make sure to hand it to\n"
           "Professor Elm!")
    waitbuttonpress
    closemessage
    releaseall
    end
_011F:
