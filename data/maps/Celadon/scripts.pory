    npcmsg("Jasmine: Ah, yes!\n"
           "Maybe I can bring myself to\f"
           "enter the Contest!\r")
    closemessage
    applymovement(obj_T07_gsleader12, Celadon_Movement_045C)
    waitmovement
    npcmsg("Erika: How about a fancy, light blue\n"
