}

script scr_seq_T07_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_POLIWRATH, 0)
    npcmsg("POLIWRATH: Poli poli!")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

