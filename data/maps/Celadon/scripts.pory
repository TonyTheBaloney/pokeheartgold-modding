script(local) _046C {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("Erika: Hi!\n"
           "Good to see you here.\r"
           "How would you like to take a picture\n"
           "with me? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Erika: Oh, that’s too bad...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Your Photo Album is full.\r"
               "Access your PC and delete\n"
               "some pictures.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Erika: Try and look cool now.\r")
    closemessage
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(81)
    faceplayer
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    npcmsg("Erika: Good job.\n"
           "It looks good!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

