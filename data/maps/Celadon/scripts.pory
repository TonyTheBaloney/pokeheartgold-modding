    npcmsg("Erika: How did it go?\r")
    closemessage
    applymovement(obj_T07_gsleader6, Celadon_Movement_0464)
    waitmovement
    npcmsg("Jasmine: I couldn’t bring myself to\n"
           "go to the Contest.\r")
    closemessage
    applymovement(obj_T07_gsleader12, Celadon_Movement_045C)
