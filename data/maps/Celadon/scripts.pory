    closemessage
    applymovement(obj_T07_gsleader12, Celadon_Movement_045C)
    waitmovement
    npcmsg("Erika: I see.\n"
           "You think Clair from Blackthorn is a\f"
           "little embarrassing...\f"
           "I’m just taking notes.\r")
    closemessage
    applymovement(obj_T07_gsleader6, Celadon_Movement_0464)
