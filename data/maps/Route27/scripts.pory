script Route27_EventScript_FatManTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_R27_gsbigman, Route27_Movement_FatManExclamation)
    waitmovement
    npcmsg("Hey!\r")
    closemessage
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 402) {
        applymovement(obj_R27_gsbigman, Route27_Movement_FatManWalkUpLeft)
    } elif (var(VAR_TEMP_x4001) == 403) {
        applymovement(obj_R27_gsbigman, Route27_Movement_FatManWalkLeft)
    } else {
        applymovement(obj_R27_gsbigman, Route27_Movement_FatManWalkDownLeft)
    }
    waitmovement
    npcmsg(msg_0369_R27_00001)
    waitbuttonpress
    closemessage
    releaseall
    setvar(VAR_UNK_408A, 1)
    end
}

