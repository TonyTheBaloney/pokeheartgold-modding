}

text msg_0110_D32R0601_00035 {
    "Congratulations!\r"
    "In honor of your victory, we present\n"
    "you with this commemorative print!\r"
}

script BattleFrontier_BattleArcade_EventScript_Scene4 {
    goto(_0132)
    end
}

movement BattleFrontier_BattleArcade_Movement_07D8 {
    walk_up * 2
    delay_8
    walk_up
}

movement BattleFrontier_BattleArcade_Movement_07E8 {
    walk_up * 2
    delay_8
    walk_up
}

script BattleFrontier_BattleArcade_EventScript_Worker {
    simplenpcmsg("The game board is like your life.\r"
                 "It goes round and round\n"
                 "as your fortune goes up and down...\f"
                 "How did that sound?\r"
                 "It almost made some kind of sense,\n"
                 "didn’t it?")
    end
}

script BattleFrontier_BattleArcade_EventScript_AceTrainerF {
    simplenpcmsg("There’s an aspect of luck in\n"
                 "Pokémon battles...\r"
                 "The Battle Arcade reminds me of that,\n"
                 "decisively. Very decisively...")
    end
}

script BattleFrontier_BattleArcade_EventScript_Psychic {
    simplenpcmsg("What quality is most needed here?\n"
                 "Is it strength?\f"
                 "Wisdom?\f"
                 "Luck?\f"
                 "No. The answer is...flexibility.\f"
                 "That’s what my gut tells me.")
    end
}

script BattleFrontier_BattleArcade_EventScript_BugCatcher {
    simplenpcmsg("Do you know what I mean by\n"
                 "“stop on the spot”?\r"
                 "It’s the skill of stopping the\n"
                 "game board at the right time!\r"
                 "But, remember...\f"
                 "If you don’t stop it in 30 seconds,\n"
                 "it will stop by itself.")
    end
}

script BattleFrontier_BattleArcade_EventScript_Beauty1 {
    simplenpcmsg("I thought I was fully prepared with my\n"
                 "prized Pokémon, but I had to swap them\f"
                 "and use my opponent’s instead!\f"
                 "I need to rethink all my strategies.")
    end
}

script BattleFrontier_BattleArcade_EventScript_Camper {
    simplenpcmsg("I chose Pokémon that are good at\n"
                 "attacking.\f"
                 "But my opponent went for speed!\r"
                 "Next time, I’ll try Pokémon with\n"
                 "superior speed.")
    end
}

script BattleFrontier_BattleArcade_EventScript_Beauty2 {
    simplenpcmsg("There are advantages to be gained from\n"
                 "“stop on the spot” skills!\r"
                 "But there’s a lot of fun in letting the\n"
                 "unknown hand of luck decide...")
    end
}

script BattleFrontier_BattleArcade_EventScript_LittleGirl {
    simplenpcmsg("The game board shows better choices\n"
                 "the greater the wins you achieve...\r"
                 "Could this board be alive...?")
    end
}

script BattleFrontier_BattleArcade_EventScript_Hiker1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("Did you figure this one out?\r"
           "Paralyzing events here won’t\n"
           "affect Ground-type Pokémon.\r"
           "You should tell everybody!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script BattleFrontier_BattleArcade_EventScript_Hiker2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("I’ll tell you something.\r"
           "Poisoning or freezing events can be\n"
           "made ineffective.\r"
           "...If the Pokémon’s type or ability\n"
           "protects it from such status problems.\r"
           "Might be worth knowing!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

