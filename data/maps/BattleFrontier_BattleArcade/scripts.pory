movement BattleFrontier_BattleArcade_Movement_PlayerExit1 {
    walk_up * 2
    walk_right
    walk_up * 2
    set_invisible
}

movement BattleFrontier_BattleArcade_Movement_PlayerExit2 {
    walk_up * 4
    set_invisible
}

movement BattleFrontier_BattleArcade_Movement_ObjectExit1 {
    walk_up
    walk_right
    walk_up * 2
    set_invisible
}

movement BattleFrontier_BattleArcade_Movement_ObjectExit2 {
    walk_up * 3
    set_invisible
}

movement BattleFrontier_BattleArcade_Movement_PlayerWalkDownLeft {
    walk_faster_down * 2
    walk_faster_left
    walk_faster_down * 2
    face_up
    set_visible
}

movement BattleFrontier_BattleArcade_Movement_PlayerWalkDown {
    walk_faster_down * 4
    face_up
    set_visible
}

movement BattleFrontier_BattleArcade_Movement_ObjectWalkDownLeft {
    walk_faster_down
    walk_faster_left
    walk_faster_down * 2
    set_visible
}

movement BattleFrontier_BattleArcade_Movement_ObjectWalkDown {
    walk_faster_down * 3
    set_visible
}

script(local) _06A0 {
    npcmsg("Welcome to the Battle Arcade!\r"
           "I am your guide to the Single and\n"
           "Double Battle challenges.\r"
           "Please be aware that these challenges\n"
           "are designed for a single Trainer.\r")
    return
_06A5:
    npcmsg("Welcome to the Battle Arcade!\r"
           "I am your guide to the Multi Battle\n"
           "challenge.\r"
           "Please be aware that this challenge\n"
           "requires two Trainers.\r")
    return
_06AA:
    npcmsg("Which challenge would you like\n"
           "to take?{YESNO 0}")
    touchscreenmenuhide
    menuinit(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(38, 255, 0)
    menuitemadd(39, 255, 1)
    return
_06C9:
    npcmsg("Would you like to take the Battle\n"
           "Arcade Multi Battle challenge?{YESNO 0}")
    touchscreenmenuhide
    menuinit(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(40, 255, 4)
    return
_06E0:
    npcmsg("At the Battle Arcade, you may take a\n"
           "Single or Double Battle challenge.\r"
           "Here, a game board is activated\n"
           "before every match.\r"
           "Depending on what comes up on the\n"
           "game board, an event takes place.\r"
           "Some events will be good for the\n"
           "challenger, while others won’t be.\r"
           "The objective is to keep a winning\n"
           "streak alive as long as possible.\r"
           "During your challenge, any items held by\n"
           "your Pokémon will be kept in storage.\r"
           "If you manage to win seven matches in\n"
           "a row, you will earn Battle Points (BP).\r"
           "If you want to interrupt your\n"
           "challenge, please save the game.\r"
           "If you don’t save, you will be\n"
           "disqualified from your challenge.\r"
           "Please be aware of that!\r")
    return
_06E5:
    npcmsg("You may team up with a friend for a\n"
           "Multi Battle challenge.\r"
           "Here, a game board is activated\n"
           "before every match.\r"
           "Depending on what comes up on the\n"
           "game board, an event takes place.\r"
           "The events may have great impact on\n"
           "the match’s outcome, good or bad.\r"
           "The objective is to keep a winning\n"
           "streak alive as long as possible.\r"
           "During your challenge, any items held by\n"
           "your Pokémon will be kept in storage.\r"
           "If you manage to win seven matches in\n"
           "a row, you will earn Battle Points (BP).\r"
           "Please note: a Battle Arcade Multi\n"
           "Battle challenge can’t be interrupted.\r")
    return
}

script BattleFrontier_BattleArcade_EventScript_Scene1 {
    checkfieldheapfreesize(0)
    setvar(VAR_TEMP_x4003, 1)
    setvar(VAR_UNK_414A, 0)
    npcmsg("We’ve missed you!\r"
           "You must save the game before you\n"
           "resume your challenge. Please wait.")
    call(_0476)
    call(_0711)
    goto(_04D7)
    end
_0711:
    addwaitingicon
    savegamenormal(VAR_SPECIAL_RESULT)
    removewaitingicon
    playse(SEQ_SE_DP_SAVE)
    waitse(SEQ_SE_DP_SAVE)
    return
}

script BattleFrontier_BattleArcade_EventScript_Scene2 {
    npcmsg("Excuse me!\r"
           "You didn’t save before you quit your\n"
           "challenge last time.\r"
           "Because of that, you have been\n"
           "disqualified from your challenge!\r")
    battlearcaderesetstreak(VAR_UNK_4149)
    compare(VAR_BATTLE_ARCADE_PRINT_PROGRESS, 1)
    callifeq(_074C)
    compare(VAR_BATTLE_ARCADE_PRINT_PROGRESS, 3)
    callifeq(_0754)
    goto(_0132)
    end
_074C:
    setvar(VAR_BATTLE_ARCADE_PRINT_PROGRESS, 0)
    return
_0754:
    setvar(VAR_BATTLE_ARCADE_PRINT_PROGRESS, 2)
    return
}

script BattleFrontier_BattleArcade_EventScript_Scene3 {
    compare(VAR_UNK_4149, 0)
    callifeq(_0798)
    compare(VAR_UNK_4149, 1)
    callifeq(_0798)
    compare(VAR_BATTLE_ARCADE_PRINT_PROGRESS, 1)
    callifeq(_079E)
    compare(VAR_BATTLE_ARCADE_PRINT_PROGRESS, 3)
    callifeq(_07B5)
    goto(_0132)
    end
_0798:
    addspecialgamestat2(SCORE_EVENT_BATTLE_ARCADE_SET_WON)
    return
_079E:
    npcmsg(msg_0110_D32R0601_00035)
    bufferplayersname(0)
    npcmsg("The Silver Print was added to\n"
           "{STRVAR_1 3, 0, 0}’s Vs. Recorder!\r")
    playfanfare(SEQ_ME_ITEM)
    waitfanfare
    setvar(VAR_BATTLE_ARCADE_PRINT_PROGRESS, 2)
    return
_07B5:
    npcmsg(msg_0110_D32R0601_00035)
    bufferplayersname(0)
    npcmsg("The Gold Print was added to\n"
           "{STRVAR_1 3, 0, 0}’s Vs. Recorder!\r")
    playfanfare(SEQ_ME_ITEM)
    waitfanfare
    setvar(VAR_BATTLE_ARCADE_PRINT_PROGRESS, 4)
