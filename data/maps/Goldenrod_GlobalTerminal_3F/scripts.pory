script scr_seq_T25R1203_011 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    setvar(VAR_SPECIAL_x8005, 2)
    goto(_0113)
    end
_0113:
    npcmsg("Connect to Nintendo Wi-Fi\n"
           "Connection for Battle Videos? {YESNO 0}")
    touchscreenmenuhide
    menuinit(21, 11, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(13, 255, 0)
    menuitemadd(14, 255, 1)
    menuitemadd(15, 255, 2)
    menuexec
    Switch(VAR_SPECIAL_RESULT)
    Case(0, _016A)
    Case(1, _018F)
    goto(_0162)
    end
_0162:
    touchscreenmenushow
_0164:
    closemessage
    releaseall
    end
_016A:
    callstd(std_prompt_save)
    copyvar(VAR_SPECIAL_RESULT, VAR_TEMP_x4000)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0164) }
    closemessage
    setsavedbottomscreenapp(0)
    callstd(std_enter_global_terminal)
    releaseall
    end
_018F:
    npcmsg("Here, you may post a Battle Video of\n"
           "your Pokémon.\r"
           "You may also view Battle Videos posted\n"
           "by other Trainers.\r"
           "The Battle Videos may be sorted by\n"
