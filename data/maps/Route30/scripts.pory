script Route30_EventScript_ProfElmCall {
    setflag(FLAG_GOT_ELMS_PANIC_CALL)
    phonecall(PHONE_CONTACT_PROF__ELM, 2, 0)
    setvar(VAR_SCENE_ROUTE_30_OW, 3)
    end
}

script Route30_EventScript_Youngster {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("Go, RATTATA!\r"
           "Tackle!\r")
    closemessage
    applymovement(obj_R30_tsure_poke_static_rattata, Route30_Movement_RattataFaceUp)
    waitmovement
    applymovement(obj_R30_tsure_poke_static_pidgey, Route30_Movement_PidgeyFaceDown)
    waitmovement
    playse(SEQ_SE_DP_SELECT)
    faceplayer
    npcmsg("What? This is a big battle!\f"
           "Leave me alone!\r")
    closemessage
    applymovement(obj_R30_gsboy2_3, Route30_Movement_YoungsterFaceUp)
    waitmovement
    releaseall
    end
}

movement Route30_Movement_RattataFaceUp {
    jump_in_place_fast_up * 3
}

movement Route30_Movement_PidgeyFaceDown {
    jump_in_place_fast_down * 2
}

movement Route30_Movement_YoungsterFaceUp {
    walk_in_place_up
}

script Route30_EventScript_PokefanMTrigger {
    followmonresetmovement
    lockall
    dooranimationload(17, 11, 11, 3, 77)
    dooranimationopen(77)
    dooranimationwait(77)
    clearflag(FLAG_HIDE_ROUTE_30_APRICORN_MAN)
    addobject(obj_R30_gsmiddleman1)
    applymovement(obj_R30_gsmiddleman1, Route30_Movement_PokefanMWalkDown)
    waitmovement
    dooranimationclose(77)
    dooranimationwait(77)
    dooranimationunload(77)
    applymovement(obj_R30_gsmiddleman1, Route30_Movement_PokefanMFaceRight)
    waitmovement
    npcmsg("Hey, kiddo!\r"
           "How in the world can you be so\n"
           "oblivious to my eye-catching house?\f"
           "Hold it right there!\r")
    closemessage
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    if (var(VAR_TEMP_x4000) == 558) {
        applymovement(obj_player, Route30_Movement_PlayerWalkDownLeft1)
    } elif (var(VAR_TEMP_x4000) == 559) {
        applymovement(obj_player, Route30_Movement_PlayerWalkDownLeft2)
    } elif (var(VAR_TEMP_x4000) == 560) {
        applymovement(obj_player, Route30_Movement_PlayerWalkDownLeft3)
    } else {
        applymovement(obj_player, Route30_Movement_PlayerWalkDownLeft4)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("When you follow that path up north,\n"
           "you will see Mr. Pokémon’s house.\r"
           "But before you go, let me finish what\n"
           "I have to say.\r"
           "Do you...have any Apricorns?\f"
           "Apricorn trees bear fruit once a day.\f"
           "I have one of those trees, too!\r"
           "Apricorns are really something.\n"
           "You can make Poké Balls and\f"
           "other things.\r"
           "They are quite useful.\r"
           "I have a feeling this is meant to be,\n"
           "because I have something for you!\r")
    giveitemnocheck(ITEM_APRICORN_BOX, 1)
    npcmsg("With that Apricorn Box, you can carry\n"
           "so many Apricorns.\r"
           "You’ll be a decent Apricorn collector!\r")
    closemessage
    applymovement(obj_R30_gsmiddleman1, Route30_Movement_PokefanMFaceUp)
    waitmovement
    dooranimationload(17, 11, 11, 3, 77)
    dooranimationopen(77)
    dooranimationwait(77)
    applymovement(obj_R30_gsmiddleman1, Route30_Movement_PokefanMExit)
    waitmovement
    dooranimationclose(77)
    dooranimationwait(77)
    dooranimationunload(77)
    removeobject(obj_R30_gsmiddleman1)
    setflag(FLAG_HIDE_ROUTE_30_APRICORN_MAN)
    releaseall
    setflag(FLAG_GOT_APRICORN_BOX)
    setvar(VAR_SCENE_ROUTE_30_OW, 1)
    end
}

movement Route30_Movement_PokefanMWalkDown {
    walk_down
}

movement Route30_Movement_PokefanMExit {
    walk_up
    set_invisible
}

movement Route30_Movement_PokefanMFaceRight {
    walk_in_place_right
}

movement Route30_Movement_PokefanMFaceUp {
    walk_in_place_up
}

movement Route30_Movement_PlayerWalkDownLeft1 {
    walk_down * 2
    walk_in_place_left
    delay_8 * 2
    walk_left * 2
}

movement Route30_Movement_PlayerWalkDownLeft2 {
    walk_down * 2
    walk_in_place_left
    delay_8 * 2
    walk_left * 3
}

movement Route30_Movement_PlayerWalkDownLeft3 {
    walk_down * 2
    walk_in_place_left
    delay_8 * 2
    walk_left * 4
}

movement Route30_Movement_PlayerWalkDownLeft4 {
    walk_down * 2
    walk_in_place_left
    delay_8 * 2
    walk_left * 5
}

script Route30_EventScript_BugCatcher {
    simplenpcmsg("Oh! You’re wearing the Running Shoes.\r"
                 "They make you feel like you are flying,\n"
                 "don’t they?\r"
                 "But beware of wild Pokémon and\n"
                 "Trainers!\r"
                 "When you run, the noise will\n"
                 "attract them.")
    end
}

script Route30_EventScript_MomCall {
    followmonresetmovement
    lockall
    phonecall(PHONE_CONTACT_MOTHER, 2, 0)
    setvar(VAR_SCENE_ROUTE_30_PHONE_CALL, 0)
    setflag(FLAG_TALKED_TO_MOM_AFTER_NAMING_RIVAL)
    releaseall
    end
}

