script scr_seq_R30_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("Go, RATTATA!\r"
           "Tackle!\r")
    closemessage
    applymovement(obj_R30_tsure_poke_static_rattata, Route30_Movement_0088)
    waitmovement
    applymovement(obj_R30_tsure_poke_static_pidgey, Route30_Movement_0090)
    waitmovement
    playse(SEQ_SE_DP_SELECT)
    faceplayer
    npcmsg("What? This is a big battle!\f"
           "Leave me alone!\r")
    closemessage
    applymovement(obj_R30_gsboy2_3, Route30_Movement_0098)
    waitmovement
    releaseall
    end
}

