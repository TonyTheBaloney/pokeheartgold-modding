script Route30_EventScript_Man {
    if (flag(FLAG_GOT_POKEDEX)) {
        simplenpcmsg("A Pokémon can use its moves as long\n"
                     "as the moves still have PP.\r"
                     "When a move has no PP remaining, that\n"
                     "Pokémon cannot use that move.\r"
                     "Then you should take your Pokémon to\n"
                     "the Pokémon Center.")
        end
    }
    simplenpcmsg("A Pokémon can use its moves as long\n"
                 "as the moves still have PP.\r"
                 "When a move has no PP remaining, that\n"
                 "Pokémon cannot use that move.\r"
                 "Then you should take your Pokémon to\n"
                 "the Pokémon Center.")
    end
}

script Route30_EventScript_Girl {
    simplenpcmsg("I’m not a Trainer.\r"
                 "But if you look one in the eyes,\n"
                 "prepare to battle.")
    end
}

