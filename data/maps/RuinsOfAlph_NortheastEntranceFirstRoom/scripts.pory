script scr_seq_D24R0202_002 {
    followmonresetmovement
    lockall
    if (flag(FLAG_OPENED_ALPH_ESCAPE_ROPE_SECRET_ROOM)) {
        wait(10, VAR_SPECIAL_x8004)
        npcmsg("Nothing happened...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    wait(2, VAR_SPECIAL_x8004)
    screenshake(0, 2, 10, 6)
    wait(10, VAR_SPECIAL_x8004)
    applymovement(obj_player, RuinsOfAlph_NortheastEntranceFirstRoom_Movement_PlayerExclamation)
    waitmovement
    removeobject(obj_D24R0202_babyboy1_12)
    setflag(FLAG_OPENED_ALPH_ESCAPE_ROPE_SECRET_ROOM)
    playse(SEQ_SE_DP_UG_008)
    releaseall
    end
}

movement RuinsOfAlph_NortheastEntranceFirstRoom_Movement_PlayerExclamation {
    emote_exclamation_mark
}

script RuinsOfAlph_NortheastEntranceFirstRoom_EventScript_Receptionist {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_188)) {
        npcmsg("You reconstructed the stone panel?\r"
               "That’s great!\n"
               "We have an archaeology genius here!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Welcome to this chamber!\r"
           "We are reconstructing ancient Pokémon\n"
           "stone panels.\r"
           "You can rotate stone-panel pieces by\n"
           "touching them for a short time.\r"
           "If you touch a piece and slide it,\n"
           "you can move it around.\r"
           "We think we should be able to put them\n"
           "back to where they were...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

