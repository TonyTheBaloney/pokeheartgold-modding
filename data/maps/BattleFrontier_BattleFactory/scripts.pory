movement BattleFrontier_BattleFactory_Movement_PlayerExit1 {
    walk_up * 3
    walk_right
    walk_up * 4
    set_invisible
}

movement BattleFrontier_BattleFactory_Movement_PlayerExit2 {
    walk_up * 3
    walk_left
    walk_up * 4
    set_invisible
}

movement BattleFrontier_BattleFactory_Movement_ObjectExit1 {
    walk_up * 2
    walk_right
    walk_up * 4
    set_invisible
}

movement BattleFrontier_BattleFactory_Movement_ObjectExit2 {
    walk_up * 2
    walk_left
    walk_up * 4
    set_invisible
}

movement BattleFrontier_BattleFactory_Movement_PlayerWalkDownLeft {
    walk_faster_down * 3
    walk_faster_left
    walk_faster_down * 4
    face_up
    set_visible
}

movement BattleFrontier_BattleFactory_Movement_PlayerWalkDownRight {
    walk_faster_down * 3
    walk_faster_right
    walk_faster_down * 4
    face_up
    set_visible
}

movement BattleFrontier_BattleFactory_Movement_ObjectWalkDownLeft {
    walk_faster_down * 2
    walk_faster_left
    walk_faster_down * 4
    set_visible
}

movement BattleFrontier_BattleFactory_Movement_ObjectWalkDownRight {
    walk_faster_down * 2
    walk_faster_right
    walk_faster_down * 4
    set_visible
}

script(local) _057C {
    npcmsg("Welcome to the Battle Factory!\r"
           "I am your guide to the Single and\n"
           "Double Battle challenges.\r"
           "Please be aware that these challenges\n"
           "are designed for a single Trainer.\r")
    return
_0581:
    npcmsg("Welcome to the Battle Factory!\r"
           "I am your guide to the Multi Battle\n"
           "challenge.\r"
           "Please be aware that this challenge\n"
           "requires two Trainers.\r")
    return
_0586:
    npcmsg("Which challenge would\n"
           "you like to take? {YESNO 0}")
    touchscreenmenuhide
    menuinit(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(16, 255, 0)
    menuitemadd(17, 255, 1)
    return
_05A5:
    npcmsg("Would you like to take the Battle\n"
           "Factory Multi Battle challenge? {YESNO 0}")
    touchscreenmenuhide
    menuinit(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(18, 255, 4)
    return
_05BC:
    npcmsg("At the Battle Factory, you may take\n"
           "Single or Double Battle challenges\f"
           "using rental Pokémon.\r"
           "Once entered, your challenge lasts\n"
           "until you lose.\r"
           "After each win, you may trade a rented\n"
           "Pokémon for one of the opponent’s.\r"
           "The Level 50 option starts you off with\n"
           "Pokémon that only know weak moves.\r"
           "The Open Level option gives you access\n"
           "to Lv. 100 Pokémon with powerful moves\f"
           "from the start.\r"
           "If you manage to win seven matches in\n"
           "a row, you will earn Battle Points (BP).\r"
           "If you want to interrupt your\n"
           "challenge, please save the game.\r"
           "If you don’t save, you will be\n"
           "disqualified from your challenge.\r"
           "Please be aware of that!\r")
    return
_05C1:
    npcmsg("You may team up with a friend for a\n"
           "Multi Battle challenge using rental\f"
           "Pokémon.\r"
           "Both partners will be provided with two\n"
           "rental Pokémon each.\r"
           "Once entered, you and your partner\n"
           "conduct Multi Battles until you lose.\r"
           "After each win, you or your partner\n"
           "may trade a single rented Pokémon.\r"
           "If you manage to win seven matches in\n"
           "a row, you will earn Battle Points (BP).\r"
           "The Level 50 option starts with rental\n"
           "Pokémon that only know weak moves.\r"
           "The Open Level option lets you rent\n"
           "Lv. 100 Pokémon with powerful moves\f"
           "from the start.\r"
           "Please note: a Battle Factory Multi\n"
           "Battle challenge can’t be interrupted.\r")
    return
}

script BattleFrontier_BattleFactory_EventScript_Scene1 {
    checkfieldheapfreesize(0)
    setvar(VAR_TEMP_x4003, 1)
    setvar(VAR_UNK_4142, 0)
    npcmsg("We’ve missed you!\r"
           "You must save the game before you\n"
           "resume your challenge. Please wait.")
    call(_0399)
    call(_05ED)
    goto(_03A1)
    end
_05ED:
    addwaitingicon
    savegamenormal(VAR_SPECIAL_RESULT)
    removewaitingicon
    playse(SEQ_SE_DP_SAVE)
    waitse(SEQ_SE_DP_SAVE)
    return
}

script BattleFrontier_BattleFactory_EventScript_Scene2 {
    lockall
    faceplayer
    npcmsg("Excuse me!\r"
           "You didn’t save before you quit your\n"
           "challenge last time.\r"
           "Because of that, you have been\n"
           "disqualified from your challenge!\r")
    battlefactoryresetstreak(VAR_UNK_4143, VAR_UNK_4144)
    compare(VAR_BATTLE_FACTORY_PRINT_PROGRESS, 1)
    callifeq(_062E)
    compare(VAR_BATTLE_FACTORY_PRINT_PROGRESS, 3)
    callifeq(_0636)
    goto(_0126)
    end
_062E:
    setvar(VAR_BATTLE_FACTORY_PRINT_PROGRESS, 0)
    return
_0636:
    setvar(VAR_BATTLE_FACTORY_PRINT_PROGRESS, 2)
    return
}

script BattleFrontier_BattleFactory_EventScript_Scene3 {
    compare(VAR_UNK_4143, 0)
    callifeq(_067A)
    compare(VAR_UNK_4143, 1)
    callifeq(_067A)
    compare(VAR_BATTLE_FACTORY_PRINT_PROGRESS, 1)
    callifeq(_0680)
    compare(VAR_BATTLE_FACTORY_PRINT_PROGRESS, 3)
    callifeq(_0697)
    goto(_0126)
    end
_067A:
    addspecialgamestat2(SCORE_EVENT_BATTLE_FACTORY_SET_WON)
    return
_0680:
    npcmsg(msg_0107_D32R0301_00013)
    bufferplayersname(0)
    npcmsg("The Silver Print was added to\n"
           "{STRVAR_1 3, 0, 0}’s Vs. Recorder!\r")
    playfanfare(SEQ_ME_ITEM)
    waitfanfare
    setvar(VAR_BATTLE_FACTORY_PRINT_PROGRESS, 2)
    return
_0697:
    npcmsg(msg_0107_D32R0301_00013)
    bufferplayersname(0)
    npcmsg("The Gold Print was added to\n"
           "{STRVAR_1 3, 0, 0}’s Vs. Recorder!\r")
    playfanfare(SEQ_ME_ITEM)
    waitfanfare
    setvar(VAR_BATTLE_FACTORY_PRINT_PROGRESS, 4)
