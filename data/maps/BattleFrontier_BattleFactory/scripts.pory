    return
}

text msg_0107_D32R0301_00013 {
    "Congratulations!\r"
    "In recognition of your victory, we\n"
    "present you this commemorative print!\r"
}

script BattleFrontier_BattleFactory_EventScript_Scene4 {
    goto(_0126)
    end
}

movement BattleFrontier_BattleFactory_Movement_06BC {
    walk_up * 2
    delay_8
    walk_up
}

movement BattleFrontier_BattleFactory_Movement_06CC {
    walk_up * 2
    delay_8
    walk_up
}

script BattleFrontier_BattleFactory_EventScript_Woman {
    simplenpcmsg("The staff tell you about the next\n"
                 "Trainer you’ll face.\r"
                 "They’re very helpful here.\n"
                 "Don’t you think?\n")
    end
}

script BattleFrontier_BattleFactory_EventScript_Sailor {
    simplenpcmsg("They tell you about the next Trainer\n"
                 "you’ll face? That’s really nice.\r"
                 "You know, you can prepare for it\n"
                 "once you know what kind of Trainer\f"
                 "the next one is!")
    end
}

script BattleFrontier_BattleFactory_EventScript_Beauty {
    simplenpcmsg("It’ll help you choose a Pokémon when\n"
                 "you remember what kind of Pokémon\f"
                 "the other Trainer had and what moves\f"
                 "they used.")
    end
}

script BattleFrontier_BattleFactory_EventScript_Youngster {
    simplenpcmsg("This is a place to battle with rental\n"
                 "Pokémon, right?\r"
                 "It is a good chance to try Pokémon\n"
                 "you’ve never trained.\r"
                 "You’ll learn about new Pokémon\n"
                 "while having exciting battles!\r"
                 "What more could you want?")
    end
}

script BattleFrontier_BattleFactory_EventScript_Gentleman {
    simplenpcmsg("Do you have a lot of Pokémon?\r"
                 "I’m not too proud to say this, but...\n"
                 "I have only a few!\r"
                 "But there is nothing to worry about.\n"
                 "Do you know why?\r"
                 "This facility, the Battle Factory, has\n"
                 "you use rental Pokémon for battles!")
    end
}

script BattleFrontier_BattleFactory_EventScript_Lady {
    simplenpcmsg("So you have to battle with Pokémon\n"
                 "you just met instead of with your\f"
                 "cherished Pokémon you’ve always\f"
                 "battled with?\r"
                 "Oh, I don’t know if I could...\n"
                 "Will they be nice to me...?\f"
                 "I’m a little worried.")
    end
}

script BattleFrontier_BattleFactory_EventScript_Policeman {
    simplenpcmsg("All the Trainers gathered at the\n"
                 "Battle Frontier are nice,\f"
                 "pleasant people!\r"
                 "I’m patrolling here on duty, but\n"
                 "otherwise I would love to change\f"
                 "my uniform to participate!")
    end
}

