script SproutTower_3F_EventScript_ElderTrigger {
    followmonresetmovement
    lockall
    setvar(VAR_UNK_40A4, 1)
    applymovement(obj_player, SproutTower_3F_Movement_PlayerExclamation)
    waitmovement
    getplayercoords(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    createcameratarget(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    applymovement(241, SproutTower_3F_Movement_ObjectWalkUp)
    waitmovement
    applymovement(obj_D15R0103_chourou, SproutTower_3F_Movement_ElderFaceDown)
    waitmovement
    npcmsg("Elder: You showed us what you’ve got,\n"
           "and it is indeed good...\r"
           "Take this Technical Machine.\r"
           "However, you should care more about\n"
           "your Pokémon.\r"
           "The way you treat your Pokémon can\n"
           "be too harsh...\r"
           "Remember, Pokémon are not tools\n"
           "of war...\r")
    closemessage
    wait(15, VAR_SPECIAL_RESULT)
    callstd(std_play_rival_outro_music)
    bufferrivalsname(0)
    applymovement(obj_D15R0103_gsrivel, SproutTower_3F_Movement_RivalWalkDown)
    waitmovement
    npcmsg("{STRVAR_1 3, 0, 0}: ...\r"
           "...Humph!\n"
           "He calls himself the Elder, but he was\f"
           "no match for me.\r"
           "Sure enough, those who lecture how\n"
           "you should be “nice” to Pokémon...\f"
           "They cannot defeat me.\r"
           "All I care about are strong Pokémon\n"
           "that win every time.\r"
           "The rest of them don’t mean anything\n"
           "to me.\r")
    closemessage
    wait(15, VAR_SPECIAL_RESULT)
    bufferrivalsname(0)
    npcmsg("{STRVAR_1 3, 0, 0} used\n"
           "an Escape Rope!")
    waitabpress
    closemessage
    playse(SEQ_SE_DP_KAIDAN2)
    applymovement(obj_D15R0103_gsrivel, SproutTower_3F_Movement_RivalSpin)
    waitmovement
    removeobject(obj_D15R0103_gsrivel)
    setflag(FLAG_UNK_078)
    callstd(std_fade_end_rival_outro_music)
    applymovement(241, SproutTower_3F_Movement_ObjectWalkDown)
    waitmovement
    removecameratarget
    releaseall
    end
}

movement SproutTower_3F_Movement_PlayerExclamation {
    emote_exclamation_mark
    delay_8
}

movement SproutTower_3F_Movement_ObjectWalkUp {
    walk_up * 5
}

movement SproutTower_3F_Movement_ObjectWalkDown {
    walk_down * 5
}

movement SproutTower_3F_Movement_ElderFaceDown {
    walk_in_place_down * 2
}

movement SproutTower_3F_Movement_RivalWalkDown {
