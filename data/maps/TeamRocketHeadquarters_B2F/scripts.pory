script scr_seq_D35R0103_006 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    setvar(VAR_TEMP_x400A, 3)
    setflag(FLAG_ENGAGING_STATIC_POKEMON)
