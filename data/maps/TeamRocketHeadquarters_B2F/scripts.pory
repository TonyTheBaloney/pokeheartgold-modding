    end
_089C:
    whiteout
    releaseall
    end
_08A2:
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    if (var(VAR_TEMP_x4001) == 16) {
        applymovement(obj_player, TeamRocketHeadquarters_B2F_Movement_09E0)
    } elif (var(VAR_TEMP_x4001) == 14) {
        applymovement(obj_player, TeamRocketHeadquarters_B2F_Movement_09EC)
    } else {
        applymovement(obj_player, TeamRocketHeadquarters_B2F_Movement_09F8)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    applymovement(obj_D35R0103_wataru, TeamRocketHeadquarters_B2F_Movement_0A04)
    applymovement(obj_D35R0103_tsure_poke_static_dragonite, TeamRocketHeadquarters_B2F_Movement_0A0C)
    waitmovement
    npcmsg("Lance: That odd signal has finally\n"
           "stopped. The lake should be back to\f"
           "normal. You’re the best!\r"
           "Let me thank you on behalf of all the\n"
           "Pokémon. Oh, yes. You should take this.\r"
           "I found it here, but I don’t have any\n"
           "need for it.\r")
    giveitemnocheck(ITEM_HM05, 1)
    npcmsg("Lance: That’s Whirlpool.\r"
           "Teach it to a Pokémon to get across wild\n"
           "water. But keep this in mind.\r"
           "You can use that out of battle only with\n"
           "the Badge from Mahogany Gym.\r")
    closemessage
    applymovement(obj_D35R0103_wataru, TeamRocketHeadquarters_B2F_Movement_0A18)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("{STRVAR_1 3, 0, 0}...\r"
                 "The journey to becoming the Pokémon\n"
                 "Champion is long and difficult.\r"
                 "Knowing that, will you keep going?\r"
                 "..................\r"
                 "I see. No, you’re right.\r"
                 "If you would give up that easily,\n"
                 "you would have never chased that\f"
                 "dream in the first place.\r"
                 "I look forward to seeing you again!\r", "{STRVAR_1 3, 0, 0}...\r"
                                                          "The journey to becoming the Pokémon\n"
                                                          "Champion is long and difficult.\r"
                                                          "Knowing that, will you keep going?\r"
                                                          "..................\r"
                                                          "I see. No, you’re right.\r"
                                                          "If you would give up that easily,\n"
                                                          "you would have never chased that\f"
                                                          "dream in the first place.\r"
                                                          "I look forward to seeing you again!\r")
    closemessage
    applymovement(obj_D35R0103_wataru, TeamRocketHeadquarters_B2F_Movement_0A20)
    applymovement(obj_D35R0103_tsure_poke_static_dragonite, TeamRocketHeadquarters_B2F_Movement_0A2C)
    waitmovement
    removeobject(obj_D35R0103_wataru)
    removeobject(obj_D35R0103_tsure_poke_static_dragonite)
    setflag(FLAG_UNK_1E5)
    releaseall
    stopse(SEQ_SE_GS_N_MOTER)
    setflag(FLAG_ROCKET_HIDEOUT_CLEARED)
    clearflag(FLAG_HIDE_ROUTE_43_GATE_GUARD)
    setflag(FLAG_HIDE_ROUTE_43_GATE_ROCKETS)
