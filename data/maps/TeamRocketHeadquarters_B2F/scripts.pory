script TeamRocketHeadquarters_B2F_EventScript_Electrode1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    setvar(VAR_TEMP_x400A, 1)
    setflag(FLAG_ENGAGING_STATIC_POKEMON)
    wildbattle(SPECIES_ELECTRODE, 23, 0)
    clearflag(FLAG_ENGAGING_STATIC_POKEMON)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_089C) }
    staticwildwonorcaughtcheck(VAR_TEMP_x4000, 0)
    if (var(VAR_TEMP_x4000) == TRUE) { goto(_07D0) }
    setflag(FLAG_REMOVED_ROCKET_HIDEOUT_B3F_ELECTRODE_1)
    if (!flag(FLAG_REMOVED_ROCKET_HIDEOUT_B3F_ELECTRODE_2)) { goto(_07D0) }
    if (!flag(FLAG_REMOVED_ROCKET_HIDEOUT_B3F_ELECTRODE_3)) { goto(_07D0) }
    goto(_08A2)
_07D0:
    releaseall
    end
}

script TeamRocketHeadquarters_B2F_EventScript_Electrode2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    setvar(VAR_TEMP_x400A, 2)
