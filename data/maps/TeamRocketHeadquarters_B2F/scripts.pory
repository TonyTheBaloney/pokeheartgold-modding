            npcmsg("“The Radio Transmitter”\r"
                   "It seems that this door checks the\n"
                   "voice of the person saying the password\f"
                   "before it opens...")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        bufferplayersname(0)
        npcmsg("The door’s closed...\r"
               "{STRVAR_1 3, 0, 0} entered the password.\r"
               "The door opened!\r")
        closemessage
        playse(SEQ_SE_DP_DOOR10)
        applymovement(obj_D35R0103_babyboy1_9, TeamRocketHeadquarters_B2F_Movement_03B0)
        applymovement(obj_D35R0103_babyboy1_9_2, TeamRocketHeadquarters_B2F_Movement_03B8)
        waitmovement
        releaseall
    }
    end
}

