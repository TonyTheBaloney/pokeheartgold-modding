script TeamRocketHeadquarters_B2F_EventScript_ArianaTrigger {
    followmonresetmovement
    lockall
    npcmsg("Ariana: Hold it right there!")
    applymovement(obj_player, TeamRocketHeadquarters_B2F_Movement_PlayerExclamation)
    waitmovement
    closemessage
    clearflag(FLAG_HIDE_ROCKET_HIDEOUT_B2F_ARIANA)
    addobject(obj_D35R0103_rkanbuw)
    addobject(obj_D35R0103_rocketm_4)
    movepersonfacing(obj_D35R0103_rkanbuw, 32, 1, 30, DIR_EAST)
    movepersonfacing(obj_D35R0103_rocketm_4, 30, 1, 30, DIR_NORTH)
    stopbgm(0)
    playbgm(SEQ_GS_EYE_ROCKET)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 30) {
        applymovement(obj_player, TeamRocketHeadquarters_B2F_Movement_PlayerWalkDown)
    } else {
        applymovement(obj_player, TeamRocketHeadquarters_B2F_Movement_PlayerWalkDownLeft)
    }
    applymovement(obj_D35R0103_rkanbuw, TeamRocketHeadquarters_B2F_Movement_ArianaWalkUp)
    applymovement(obj_D35R0103_rocketm_4, TeamRocketHeadquarters_B2F_Movement_RocketGruntWalkUp1)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    applymovement(obj_D35R0103_rkanbuw, TeamRocketHeadquarters_B2F_Movement_ArianaFaceLeft)
    waitmovement
    npcmsg("Ariana: We can’t let a brat like you\n"
           "do as you please forever.\r"
           "It’ll hurt Team Rocket’s pride over and\n"
           "over again. Making it lessen, you see.\r"
           "...So, it’s time to finish you. However\n"
           "strong you may be, if the two of us\f"
           "fight at the same time, you’ll have no\f"
           "chance of winning. Don’t you agree?\r"
           "Hee hee hee! Sorry, baby. Now, get\n"
           "ready to be thrashed.\r")
    closemessage
    clearflag(FLAG_UNK_1E5)
    addobject(obj_D35R0103_wataru)
    addobject(obj_D35R0103_tsure_poke_static_dragonite)
    movepersonfacing(obj_D35R0103_wataru, 20, 1, 25, DIR_EAST)
    movepersonfacing(obj_D35R0103_tsure_poke_static_dragonite, 19, 1, 25, DIR_NORTH)
    applymovement(obj_D35R0103_wataru, TeamRocketHeadquarters_B2F_Movement_LanceWalkRight2)
    applymovement(obj_D35R0103_tsure_poke_static_dragonite, TeamRocketHeadquarters_B2F_Movement_DragoniteWalkRight2)
    waitmovement
    npcmsg("Lance: Hold it!\r"
           "A two-on-one battle?\n"
           "That is so unfair!\r"
           "Typical of Team Rocket to be so sneaky.\n"
           "Allow me to join the battle!\r")
    closemessage
    applymovement(obj_D35R0103_tsure_poke_static_dragonite, TeamRocketHeadquarters_B2F_Movement_DragoniteFaceRight)
    playcry(SPECIES_DRAGONITE, 0)
    waitcry
    applymovement(obj_D35R0103_rkanbuw, TeamRocketHeadquarters_B2F_Movement_ArianaFaceLeft)
    waitmovement
    npcmsg("Ariana: What? You had an accomplice?\n"
           "Where is your sense of dignity?\r"
           "As interim boss in place of Giovanni,\n"
           "I’ll show you how wrong it is to meddle\f"
           "with Team Rocket!\r")
    closemessage
    applymovement(obj_D35R0103_rkanbuw, TeamRocketHeadquarters_B2F_Movement_ArianaWalkLeft)
    applymovement(obj_D35R0103_rocketm_4, TeamRocketHeadquarters_B2F_Movement_RocketGruntWalkUp2)
    waitmovement
    multibattle(TRAINER_PKMN_TRAINER_LANCE_LANCE, TRAINER_EXECUTIVE_ARIANA_ARIANA_2, TRAINER_TEAM_ROCKET_GRUNT_25, 1)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        setflag(FLAG_HIDE_ROCKET_HIDEOUT_B2F_ARIANA)
        setflag(FLAG_UNK_1E5)
        releaseall
        end
    }
    npcmsg("Ariana: But that’s fine. The broadcast\n"
           "experiment was a total success.\r"
           "It doesn’t matter what happens to this\n"
           "hideout now.\r"
           "We have much bigger plans.\n"
           "You’ll come to appreciate Team\f"
           "Rocket’s true power soon enough.\r"
           "Enjoy yourself while you can...\n"
           "Hee hee hee...\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    movepersonfacing(obj_D35R0103_wataru, 28, 1, 24, DIR_SOUTH)
    movepersonfacing(obj_D35R0103_tsure_poke_static_dragonite, 27, 1, 24, DIR_EAST)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, TeamRocketHeadquarters_B2F_Movement_PlayerWalkUpRight)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    removeobject(obj_D35R0103_rkanbuw)
    removeobject(obj_D35R0103_rocketm_4)
    removeobject(obj_D35R0103_rocketm_2)
    removeobject(obj_D35R0103_rocketm_3)
    removeobject(obj_D35R0103_rocketm)
    setflag(FLAG_HIDE_ROCKET_HIDEOUT_B2F_ARIANA)
    setflag(FLAG_HIDE_MAHOGANY_SHOP_SHADY_SALESMAN)
    setflag(FLAG_UNK_1E8)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    applymovement(obj_D35R0103_wataru, TeamRocketHeadquarters_B2F_Movement_LanceWalkRight3)
    applymovement(obj_D35R0103_tsure_poke_static_dragonite, TeamRocketHeadquarters_B2F_Movement_DragoniteWalkRight3)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("Sorry, {STRVAR_1 3, 0, 0}. I saw how well you\n"
                 "were doing, so I just hung back.\r"
                 "Now all there is left to do is to turn\n"
                 "off that odd radio signal.\r", "Sorry, {STRVAR_1 3, 0, 0}. I saw how well you\n"
                                                 "were doing, so I just hung back.\r"
                                                 "Now all there is left to do is to turn\n"
                                                 "off that odd radio signal.\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, TeamRocketHeadquarters_B2F_Movement_PlayerWalkUp)
    applymovement(obj_D35R0103_wataru, TeamRocketHeadquarters_B2F_Movement_LanceWalkUpLeft)
    applymovement(obj_D35R0103_tsure_poke_static_dragonite, TeamRocketHeadquarters_B2F_Movement_DragoniteWalkRightUp)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    playcry(SPECIES_DRAGONITE, 0)
    waitcry
    applymovement(obj_D35R0103_wataru, TeamRocketHeadquarters_B2F_Movement_LanceWalkLeft1)
    applymovement(obj_D35R0103_tsure_poke_static_dragonite, TeamRocketHeadquarters_B2F_Movement_DragoniteWalkLeft1)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("It’s this machine that’s causing all the\n"
