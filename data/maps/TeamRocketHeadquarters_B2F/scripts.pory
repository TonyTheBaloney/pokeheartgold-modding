script TeamRocketHeadquarters_B2F_OnLoad {
    if (flag(FLAG_ENGAGING_STATIC_POKEMON)) {
        staticwildwonorcaughtcheck(VAR_TEMP_x4000, 1)
        if (var(VAR_TEMP_x4000) != 1) {
            if (var(VAR_TEMP_x400A) == 1) {
                setflag(FLAG_UNK_96B)
                removeobject(obj_D35R0103_tsure_poke_static_electrode)
                removeobject(obj_D35R0103_tsure_poke_static_electrode_4)
                setflag(FLAG_HIDE_ROCKET_HIDEOUT_B3F_ELECTRODE_1_AND_4)
            } elif (var(VAR_TEMP_x400A) == 2) {
                setflag(FLAG_UNK_96C)
                removeobject(obj_D35R0103_tsure_poke_static_electrode_2)
                removeobject(obj_D35R0103_tsure_poke_static_electrode_5)
                setflag(FLAG_HIDE_ROCKET_HIDEOUT_B3F_ELECTRODE_2_AND_5)
            } else {
                setflag(FLAG_UNK_96D)
                removeobject(obj_D35R0103_tsure_poke_static_electrode_3)
                removeobject(obj_D35R0103_tsure_poke_static_electrode_6)
                setflag(FLAG_HIDE_ROCKET_HIDEOUT_B3F_ELECTRODE_3_AND_6)
            }
        }
        clearflag(FLAG_ENGAGING_STATIC_POKEMON)
        end
    }
    end
}

script TeamRocketHeadquarters_B2F_EventScript_LanceScene {
    followmonresetmovement
    lockall
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, TeamRocketHeadquarters_B2F_Movement_PlayerWalkRightUp)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("Lance: Are you all right?\r"
           "Your Pokémon are hurt and tired.\n"
           "Here, give them some of my medicine.\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    playfanfare(SEQ_ME_ASA)
    waitfanfare
    healparty
    leaveoverworld
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    bufferplayersname(0)
    gendermsgbox("Lance: {STRVAR_1 3, 0, 0}, let’s give our\n"
                 "best for Pokémon.\r", "Lance: {STRVAR_1 3, 0, 0}, let’s give our\n"
                                        "best for Pokémon.\r")
    closemessage
    applymovement(obj_D35R0103_wataru, TeamRocketHeadquarters_B2F_Movement_LanceWalkRight1)
    applymovement(obj_D35R0103_tsure_poke_static_dragonite, TeamRocketHeadquarters_B2F_Movement_DragoniteWalkRight1)
    waitmovement
    removeobject(obj_D35R0103_wataru)
    removeobject(obj_D35R0103_tsure_poke_static_dragonite)
    setflag(FLAG_UNK_1E5)
    releaseall
    setvar(VAR_UNK_40A9, 1)
    end
}

