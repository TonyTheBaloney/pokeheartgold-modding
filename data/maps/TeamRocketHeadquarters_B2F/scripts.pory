script TeamRocketHeadquarters_B2F_EventScript_Radio {
    releaseall
    if (!flag(FLAG_REMOVED_ROCKET_HIDEOUT_B3F_ELECTRODE_1)) { goto(_0AE4) }
    if (!flag(FLAG_REMOVED_ROCKET_HIDEOUT_B3F_ELECTRODE_2)) { goto(_0AE4) }
    if (!flag(FLAG_REMOVED_ROCKET_HIDEOUT_B3F_ELECTRODE_3)) { goto(_0AE4) }
    npcmsg("The radio transmitter has finally\n"
           "stopped its evil broadcast.")
    closemessage
    releaseall
    end
_0AE4:
    npcmsg("It’s the radio transmitter that’s\n"
           "sending the sinister signal.\r"
           "It’s working at full capacity.")
    closemessage
    releaseall
    end
}

