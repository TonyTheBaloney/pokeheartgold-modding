           "Hmm, {STRVAR_1 3, 0, 0}, huh?\r")
    npcmsg("You know what?\n"
           "I’m the one who developed\f"
           "the system to transfer Pokémon.\r"
           "But it couldn’t have been done by\n"
           "me alone.\r"
           "For example, do you know the Hoenn\n"
           "region? This girl Lanette from Hoenn\f"
           "made the Pokémon Storage System\f"
           "easier to use.\r"
           "My friends all over the world are\n"
           "working together to improve\f"
           "the Pokémon trade and\f"
           "storage systems.\r"
           "I have to hurry on back to Goldenrod\n"
           "and see my folks.\f"
           "Buh-bye!\r")
    closemessage
    applymovement(obj_T27PC0101_masaki, Ecruteak_Pokecenter_1F_Movement_BillWalkRightDown)
    applymovement(obj_player, Ecruteak_Pokecenter_1F_Movement_PlayerFaceDown)
    waitmovement
    removeobject(obj_T27PC0101_masaki)
    setflag(FLAG_UNK_1C5)
    clearflag(FLAG_HIDE_GOLDENROD_BILL)
    setflag(FLAG_SYS_MET_BILL)
    setvar(VAR_UNK_410D, 1)
    releaseall
    end
}

movement Ecruteak_Pokecenter_1F_Movement_BillWalkDownRight {
    walk_down * 4
    walk_right * 6
    walk_up * 2
    delay_4 * 12
    face_down
    delay_4 * 4
}

movement Ecruteak_Pokecenter_1F_Movement_PlayerWalkUp {
    delay_4 * 20
    walk_up * 4
}

movement Ecruteak_Pokecenter_1F_Movement_BillWalkRightDown {
    walk_right
    walk_down * 4
    walk_left
    walk_down * 2
}

movement Ecruteak_Pokecenter_1F_Movement_PlayerFaceDown {
    delay_4 * 6
    face_down
}

