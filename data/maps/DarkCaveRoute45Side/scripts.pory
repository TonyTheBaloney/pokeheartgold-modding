script DarkCaveRoute45Side_EventScript_GymGuide {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GOT_BLACKGLASSES_FROM_DARK_CAVE_MAN)) {
        npcmsg("Whoa! You startled me there!\r"
               "I had my BlackGlasses on, so I didn’t\n"
               "notice you at all.\r"
               "What am I doing here?\r"
               "Hey, don’t you worry about it.\n"
               "I’ll give you a pair of BlackGlasses, so\f"
               "forget you saw me, OK?\r")
        if (!itemspace(ITEM_BLACKGLASSES, 1)) {
            npcmsg("You don’t have room for this...")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_BLACKGLASSES_FROM_DARK_CAVE_MAN)
    }
    npcmsg("BlackGlasses up the power of\n"
           "Dark-type moves.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

