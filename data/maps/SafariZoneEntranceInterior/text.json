    },
    {
      "id": "msg_0135_D47R0101_00056",
      "en_US": [
        "OK.\n",
        "Please come again!"
      ]
    },
    {
      "id": "msg_0135_D47R0101_00057",
      "from": "SafariZoneEntranceInterior_EventScript_Attendant5#3"
    },
    {
      "id": "msg_0135_D47R0101_00058",
      "from": "SafariZoneEntranceInterior_EventScript_Attendant5#4"
    },
    {
      "id": "msg_0135_D47R0101_00059",
      "from": "SafariZoneEntranceInterior_EventScript_Attendant5#5"
    },
    {
      "id": "msg_0135_D47R0101_00060",
      "from": "SafariZoneEntranceInterior_EventScript_Attendant5#1"
    },
    {
      "id": "msg_0135_D47R0101_00061",
      "en_US": [
        "You still have time left. Are you sure\n",
        "you want to leave the Safari Zone?"
      ]
    },
    {
      "id": "msg_0135_D47R0101_00062",
      "en_US": [
        "Certainly.\r",
        "Please return any Safari Balls\n",
        "you may have remaining.\r"
      ]
    },
    {
      "id": "msg_0135_D47R0101_00063",
      "en_US": [
        "Did you have fun?\n",
        "Please come again!"
      ]
    },
    {
      "id": "msg_0135_D47R0101_00064",
      "en_US": [
        "I am sorry.\n",
        "You don’t have enough money.\r",
        "I hope you drop by again."
      ]
    },
    {
      "id": "msg_0135_D47R0101_00065",
      "from": "SafariZoneEntranceInterior_EventScript_Attendant4#0"
    },
    {
      "id": "msg_0135_D47R0101_00066",
      "from": "SafariZoneEntranceInterior_EventScript_Attendant4#1"
    },
    {
      "id": "msg_0135_D47R0101_00067",
      "en_US": "Would you like to save the game?"
    },
    {
      "id": "msg_0135_D47R0101_00068",
      "en_US": [
        "There is already a saved file.\n",
        "Is it OK to overwrite it?"
      ]
    },
    {
      "id": "msg_0135_D47R0101_00069",
      "en_US": [
        "Saving...\n",
        "Don’t turn off the power."
      ]
    },
    {
      "id": "msg_0135_D47R0101_00070",
      "en_US": "{STRVAR_1 3, 0, 0} saved the game."
    },
    {
      "id": "msg_0135_D47R0101_00071",
      "from": "SafariZoneEntranceInterior_EventScript_Attendant4#2"
    },
    {
      "id": "msg_0135_D47R0101_00072",
      "en_US": [
        "Choose the player to exchange\n",
        "Safari Zones with. {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_D47R0101_00073",
      "en_US": "Awaiting {STRVAR_1 3, 0, 0}’s response..."
    },
    {
      "id": "msg_0135_D47R0101_00074",
      "en_US": "{STRVAR_1 3, 0, 0} sent back an “OK”!"
    },
    {
      "id": "msg_0135_D47R0101_00075",
      "en_US": "{STRVAR_1 3, 0, 0} replied, “No”..."
    },
    {
      "id": "msg_0135_D47R0101_00076",
      "en_US": "Do you want to leave the group?"
    },
    {
      "id": "msg_0135_D47R0101_00077",
      "en_US": "You have left the group."
    },
    {
      "id": "msg_0135_D47R0101_00078",
      "en_US": "Awaiting contact from your friend."
    },
    {
      "id": "msg_0135_D47R0101_00079",
      "en_US": [
        "{STRVAR_1 3, 0, 0} has responded!\r",
        "Would you like to exchange Safari\n",
        "Zones with {STRVAR_1 3, 0, 0}? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_D47R0101_00080",
      "en_US": [
        "An “OK” was sent\n",
        "to {STRVAR_1 3, 0, 0}."
      ]
    },
