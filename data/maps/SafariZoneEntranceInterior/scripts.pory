script scr_seq_D47R0101_002 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_4057) == 0) { goto(_09DC) }
    if (var(VAR_UNK_4057) == 1) { goto(_09DC) }
    if (var(VAR_UNK_4057) == 2) { goto(_09DC) }
    if (var(VAR_UNK_4057) == 3) { goto(_09DC) }
    npcmsg("This is the Area Customizer.\n"
           "What would you like to know about? {YESNO 0}")
    touchscreenmenuhide
_0919:
    menuinitstdgmm(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(457, 255, 0)
    menuitemadd(458, 255, 1)
    menuitemadd(459, 255, 2)
    menuitemadd(460, 255, 3)
    menuitemadd(461, 255, 4)
    menuitemadd(462, 255, 5)
    menuexec
    Switch(VAR_SPECIAL_RESULT)
    Case(0, _09A2)
    Case(1, _09AB)
    Case(2, _09B4)
    Case(3, _09BD)
    Case(4, _09C6)
    goto(_09CF)
    end
_09A2:
    npcmsg("The Safari Zone has six Areas.\r"
           "Plains Area...\n"
           "Peak Area...\f"
           "and so on.\r"
           "The Area Customizer allows you to\n"
           "change the combination of these Areas.\r"
           "What would you like to know? {YESNO 0}")
    goto(_0919)
_09AB:
    npcmsg("Check out the machine, and you’ll see\n"
           "the Area Customizer screen.\r"
           "The lower window shows the current\n"
           "Safari Zone setting.\r"
           "Select an Area with the A Button to\n"
           "swap it with another.\r"
           "What would you like to know? {YESNO 0}")
    goto(_0919)
_09B4:
    npcmsg("When you select an Area, then select\n"
           "Swap, you will see 12 new Areas.\r"
           "Select one of them by highlighting it and\n"
           "pressing the A Button.\r"
           "What would you like to know? {YESNO 0}")
    goto(_0919)
_09BD:
    npcmsg("When you select an Area, then select\n"
           "Order, the Area type will not change,\f"
           "but the location can now be changed.\r"
           "What would you like to know? {YESNO 0}")
    goto(_0919)
_09C6:
    npcmsg("Different Areas have different Pokémon\n"
           "living in them, so when you change\f"
           "Areas, you will see different Pokémon.\r"
           "Please do try the different Areas!\n"
           "What would you like to know? {YESNO 0}")
    goto(_0919)
_09CF:
    touchscreenmenushow
    npcmsg("Please enjoy the Area Customizer!")
    waitbuttonpress
    closemessage
    releaseall
    end
_09DC:
    npcmsg("I am sorry, but this can’t be used yet.\n"
           "Warden Baoba has a great plan for this\f"
           "machine...or so he says. But even we\f"
           "don’t know what it is. It’s a secret.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_D47R0101_003 {
