    setvar(VAR_SPECIAL_x8005, 0)
    commclubjoin(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005, 0, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0B05) }
    if (var(VAR_SPECIAL_RESULT) == 3) { goto(_0B11) }
