script scr_seq_D47R0101_004 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_4057) == 7) {
        if (flag(FLAG_UNK_183)) { goto(_0C4C) }
        npcmsg(msg_0135_D47R0101_00018)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
_0C4C:
    dummy247
    natdexflagaction(2, VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 0) { goto(_0DF2) }
    checksafarizonelinked(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) != 0) {
        setvar(VAR_TEMP_x4000, 0)
        buffersafarilinkleadername(VAR_TEMP_x4000)
        npcmsg("Welcome to {STRVAR_1 3, 0, 0}’s Safari Zone!\r"
               "For just $500, you can play the\n"
               "Safari Game.\r"
               "You can roam the wide-open Safari Zone\n"
               "and catch what you like.\f"
               "Would you like to play? {YESNO 0}")
    } else {
        npcmsg("You don’t have your friend’s\n"
               "Safari Zone.\f"
               "Sorry, but you cannot enter here.\r"
               "Please talk to the attendant next\n"
               "to me.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    showmoneybox(20, 2)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0D9F) }
    countpcemptyspace(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        getpartycount(VAR_SPECIAL_x8004)
        if (var(VAR_SPECIAL_x8004) == 6) { goto(_0DAC) }
    }
    hasenoughmoneyimmediate(VAR_SPECIAL_RESULT, 500)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0DCF) }
    setvar(VAR_SPECIAL_RESULT, 500)
    bufferint(1, VAR_SPECIAL_RESULT)
    npcmsg("That’ll be ${STRVAR_1 52, 1, 0}, please!\r")
    playse(SEQ_SE_DP_REGI)
    submoneyimmediate(500)
    updatemoneybox
    npcmsg("Here are your Safari Balls.\r")
    bufferplayersname(0)
    setvar(VAR_SPECIAL_RESULT, 30)
    bufferint(1, VAR_SPECIAL_RESULT)
    npcmsg("{STRVAR_1 3, 0, 0} received {STRVAR_1 51, 1, 0} Safari Balls.")
    playfanfare(SEQ_ME_ITEM)
    waitfanfare
    npcmsg("We’ll call you when you run out of\n"
           "Safari Balls.\r"
           "Well, I’ll wish you the best of luck!\r")
    closemessage
    hidemoneybox
    followmonrecall
    applymovement(obj_player, SafariZoneEntranceInterior_Movement_08C4)
    waitmovement
    dooranimationload(0, 0, 19, 5, 77)
    call(_08AF)
    applymovement(obj_player, SafariZoneEntranceInterior_Movement_08D0)
    waitmovement
    call(_08B7)
    setvar(VAR_SCENE_SAFARI_ZONE_ENTRANCE, 3)
    safarizoneaction(0, 1)
    setdynamicwarp(MAP_SAFARI_ZONE_ENTRANCE_INTERIOR, 2, 19, 2, 1)
    playse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    warp(MAP_SAFARI_ZONE_ENTRANCE_EXTERIOR, 0, 79, 100, DIR_NORTH)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    lock(obj_partner_poke)
    followmonreleasenexttoplayer
    applymovement(obj_partner_poke, SafariZoneEntranceInterior_Movement_0200)
    waitmovement
    release(obj_partner_poke)
    releaseall
    end
_0D9F:
    hidemoneybox
    npcmsg(msg_0135_D47R0101_00003)
    waitbuttonpress
    closemessage
    releaseall
    end
_0DAC:
    hidemoneybox
    if (var(VAR_UNK_4057) >= 6) {
        npcmsg(msg_0135_D47R0101_00013)
    } else {
        npcmsg(msg_0135_D47R0101_00012)
    }
    waitbuttonpress
    closemessage
    releaseall
    end
_0DCF:
    hidemoneybox
    if (var(VAR_UNK_4057) >= 6) {
        npcmsg(msg_0135_D47R0101_00011)
    } else {
        npcmsg(msg_0135_D47R0101_00010)
    }
    waitbuttonpress
    closemessage
    releaseall
    end
_0DF2:
