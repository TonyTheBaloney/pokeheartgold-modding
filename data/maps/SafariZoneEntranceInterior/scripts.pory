text msg_0135_D47R0101_00042 {
    "Slow down.\r"
    "Once the next test is ready, I will call\n"
    "you using the Pokégear.\r"
    "Give me some time, OK?"
}

script scr_seq_D47R0101_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_4057) >= 6) {
        npcmsg("Welcome, Owner!\n"
               "Should I explain the Safari Zone? {YESNO 0}")
    } else {
        npcmsg("Hi! Is it your first time here at\n"
               "the Safari Zone? {YESNO 0}")
    }
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Have fun at the Safari Zone!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    setvar(VAR_SPECIAL_x8004, 30)
    bufferint(1, VAR_SPECIAL_x8004)
    setvar(VAR_SPECIAL_x8005, 1000)
    bufferint(2, VAR_SPECIAL_x8005)
    npcmsg("At the Safari Zone, you can enjoy a\n"
           "Safari Game where you are given {STRVAR_1 51, 1, 0}\f"
           "Safari Balls to try to catch Pokémon.\r"
           "When you have run out of Safari Balls,\n"
           "the game is over.\r"
           "When you see a Pokémon, you can choose\n"
           "to throw Bait or Mud.\r"
           "If you throw Bait, Pokémon tend to stay\n"
           "but will become more difficult to catch.\r"
           "If you throw Mud, it will become easier\n"
           "to catch, but the Pokémon may flee.\r"
           "Have fun at the Safari Zone!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_D47R0101_001 {
    playse(SEQ_SE_DP_SELECT)
