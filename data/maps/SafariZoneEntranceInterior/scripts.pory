               "Safari Game.\r"
               "You can roam the wide-open Safari Zone\n"
               "and catch what you like.\f"
               "Would you like to play? {YESNO 0}\n")
    } else {
        setvar(VAR_SPECIAL_RESULT, 500)
        bufferint(1, VAR_SPECIAL_RESULT)
        npcmsg("Welcome to the Safari Zone!\r"
               "For just ${STRVAR_1 52, 1, 0}, you can play the\n"
               "Safari Game.\r"
               "You can roam the wide-open Safari Zone\n"
               "and catch whatever you like.\f"
               "Would you like to play? {YESNO 0}")
    }
    showmoneybox(20, 2)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
