script scr_seq_D47R0101_008 {
    followmonresetmovement
    lockall
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_D47R0101_gsgentleman, SafariZoneEntranceInterior_Movement_0310)
    applymovement(obj_player, SafariZoneEntranceInterior_Movement_03B8)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("Hi, I have been waiting for you!\n"
           "What do you think?\r"
           "This is a brand-new Safari Zone.\n"
           "By the way...\r"
           "I just had an idea.\n"
           "Would you like to take the Owner\f"
           "Aptitude Test? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_025B) }
_024A:
    npcmsg("Right on!\n"
           "Let me explain how the test works.\f"
           "It’s very easy.\r"
           "All you have to do is to catch one\n"
           "GEODUDE at the Safari and show it to me.\r"
           "They are in the grass closest to the\n"
           "entrance. It shouldn’t take long\f"
           "before you catch one.\r"
           "Good luck!")
    waitbuttonpress
    closemessage
    setvar(VAR_UNK_4057, 2)
    releaseall
    end
_025B:
    npcmsg("Wow, I never thought anyone\n"
           "would decline!\r"
           "You can become the Safari Zone Owner,\n"
           "don’t you see?\r"
           "Owner...\n"
           "It’s got a nice ring to it, doesn’t it?\r"
           "You should try the test! {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_025B) }
    goto(_024A)
}

