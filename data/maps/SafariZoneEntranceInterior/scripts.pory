    npcmsg("That’ll be ${STRVAR_1 52, 1, 0}, please!\r")
    playse(SEQ_SE_DP_REGI)
    submoneyimmediate(500)
    updatemoneybox
    npcmsg("Here are your Safari Balls!\r")
    bufferplayersname(0)
    setvar(VAR_SPECIAL_RESULT, 30)
