script scr_seq_D47R0101_010 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_183)) { goto(_0599) }
    if (var(VAR_UNK_4057) == 2) {
        checksafarizonechallengecompleted(0, VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            npcmsg("Show me the GEODUDE once you’ve\n"
                   "caught one.\r"
                   "They are in the grass closest to the\n"
                   "entrance. It shouldn’t take long.\r"
                   "Good luck!")
        } else {
            npcmsg("Oh, wonderful!\n"
                   "You’ve caught a GEODUDE!\f"
                   "You’ve passed the first test.\r"
                   "..................\r"
                   "Huh? Didn’t I tell you that there are\n"
                   "two tests?\r"
                   "That’s right!\n"
                   "Becoming an owner is not that easy.\r"
                   "The second test is...\n"
                   "Well, I am still preparing for it.\r"
                   "I will let you know once it’s ready.\n"
                   "You need to wait just a little.\f"
                   "I will call you with the Pokégear.")
            setvar(VAR_UNK_4057, 3)
            updatesafarizoneigt
        }
        goto(_0587)
        end
    }
    if (var(VAR_UNK_4057) == 3) { goto(_048B) }
    if (var(VAR_UNK_4057) == 5) {
        checksafarizonechallengecompleted(1, VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) != 0) {
            npcmsg("You did it!\r"
                   "You caught a SANDSHREW!\n"
                   "I knew you could do it.\r"
                   "You’ve passed the test!\n"
                   "You are now the Safari Zone Owner!\r")
            closemessage
            togglefollowingpokemonmovement(0)
            waitfollowingpokemonmovement
            followingpokemonmovement(55)
            getplayerfacing(VAR_SPECIAL_RESULT)
            if (var(VAR_SPECIAL_RESULT) == 1) {
                applymovement(obj_D47R0101_gsgentleman, SafariZoneEntranceInterior_Movement_034C)
                applymovement(obj_player, SafariZoneEntranceInterior_Movement_03E0)
                waitmovement
            } elif (var(VAR_SPECIAL_RESULT) == 3) {
                applymovement(obj_D47R0101_gsgentleman, SafariZoneEntranceInterior_Movement_0360)
                applymovement(obj_player, SafariZoneEntranceInterior_Movement_03F8)
                waitmovement
            } else {
                applymovement(obj_D47R0101_gsgentleman, SafariZoneEntranceInterior_Movement_0360)
                applymovement(obj_player, SafariZoneEntranceInterior_Movement_0404)
                waitmovement
            }
            npcmsg("I’ve always wanted to see young people\n"
                   "playing at the safari!\r"
                   "I thought I might get some new ideas.\n"
                   "That should help you complete your\f"
                   "Pokédex.\r"
                   "That’s what I have been thinking.\r")
            closemessage
            applymovement(obj_D47R0101_gsgentleman, SafariZoneEntranceInterior_Movement_0370)
            applymovement(obj_player, SafariZoneEntranceInterior_Movement_040C)
            waitmovement
            waitfollowingpokemonmovement
            togglefollowingpokemonmovement(1)
            followingpokemonmovement(48)
            npcmsg("By the way, though you are now the\n"
                   "Safari Zone Owner, would you kindly\f"
                   "continue to pay admission?\f"
                   "We have our reasons.\r"
                   "Don’t be upset. I’ll keep thinking about\n"
                   "how I can create new fun ways to\f"
                   "help you complete your Pokédex.\r"
                   "Go have fun at the Safari Zone!")
            setvar(VAR_UNK_4057, 6)
            updatesafarizoneigt
        } else {
            npcmsg("Show me the SANDSHREW once you’ve\n"
                   "caught one. SANDSHREW live in the\f"
                   "desert! Good luck!")
            goto(_0587)
        }
    _0587:
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_UNK_4057) == 6) { goto(_0494) }
