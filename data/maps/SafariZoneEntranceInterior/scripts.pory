    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_D47R0101_011 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    dummy247
    natdexflagaction(2, VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 0) {
        npcmsg("This is the reception for the\n"
               "Safari Zone Link.\r"
               "...Or should I say...is going to be.\r"
               "We’re still not ready.\n"
               "Please come back later.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_UNK_4057) >= 6) {
        npcmsg("Owner!\n"
               "This is the Safari Zone Link reception.\r"
               "Would you like to know about the\n"
               "Safari Zone Link? {YESNO 0}")
    } else {
        npcmsg("This is the Safari Zone Link reception.\r"
               "Would you like to know about\n"
               "the Safari Zone Link? {YESNO 0}")
    }
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0E68) }
    npcmsg("You can exchange Safari Zones with your\n"
           "friends using the Safari Zone Link.\r"
           "You will be able to play in their\n"
           "Safari Zone!\r"
           "Areas and Pokémon will be different.\n"
           "Beware!\r"
           "The Safari Zone you receive will \n"
           "disappear after 24 hours or if you\f"
           "receive another Safari Zone.\r"
           "To your right is the reception for the\n"
           "Safari Zone Link.\r"
           "To your left is the reception to play in\n"
           "your friend’s Safari Zone.\r"
           "Enjoy the Safari Zone Link!")
    waitbuttonpress
    closemessage
    releaseall
    end
_0E68:
    npcmsg("OK! Enjoy the Safari Zone Link!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_D47R0101_005 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_4057) == 0) { goto(_0EF1) }
    if (var(VAR_UNK_4057) == 1) { goto(_0EF1) }
    if (var(VAR_UNK_4057) == 2) { goto(_0EF1) }
    if (var(VAR_UNK_4057) == 3) { goto(_0EF1) }
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} turned on\n"
           "the Area Customizer!\r")
    closemessage
    clearflag(FLAG_UNK_99D)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    launchsafariareacustomizer
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (flag(FLAG_UNK_99D)) {
        screenshake(0, 2, 10, 6)
        playse(SEQ_SE_DP_KI_GASYAN)
        npcmsg("The Safari Zone Areas have\n"
               "been swapped.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    releaseall
    end
_0EF1:
    npcmsg("It is still under development.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

