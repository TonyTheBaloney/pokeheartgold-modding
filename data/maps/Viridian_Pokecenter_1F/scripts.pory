script Viridian_Pokecenter_1F_EventScript_AceTrainerM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_UNK_129)) {
        npcmsg("Where in the world is Viridian’s\n"
               "Gym Leader?\f"
               "I wanted to challenge him...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Viridian’s Gym Leader does not\n"
           "rely on others!\r"
           "The Gym Leader claims that his policy\n"
           "is to lose to no one without having\f"
           "any underlings.\r"
           "That makes him even more popular,\n"
           "and many Trainers have come to work\f"
           "for him.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Viridian_Pokecenter_1F_EventScript_AceTrainerF {
    simplenpcmsg("I heard that the Gym in Cinnabar\n"
                 "is gone.\r"
                 "I wonder what became of Blaine,\n"
                 "the Gym Leader.")
    end
}

