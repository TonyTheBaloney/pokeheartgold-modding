script Route31_VioletGatehouse_EventScript_LyraTrigger {
    followmonresetmovement
    lockall
    callstd(std_play_friend_music)
    applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillExit1)
    waitmovement
    playse(SEQ_SE_DP_KAIDAN2)
    movepersonfacing(obj_R31R0101_var_1, 10, 1, 7, DIR_WEST)
    movepersonfacing(obj_R31R0101_tsure_poke_static_marill, 10, 1, 7, DIR_WEST)
    applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_FriendExclamation)
    waitmovement
    waitse(SEQ_SE_DP_KAIDAN2)
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    followmonisactive(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) == 1) {
        if (var(VAR_TEMP_x4001) == 6) {
            applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_FriendWalkLeftUp1)
            applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillWalkLeftUp1)
        } elif (var(VAR_TEMP_x4001) == 7) {
            applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_FriendWalkLeft1)
            applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillWalkLeft1)
        } else {
            applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_FriendWalkLeftDown1)
            applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillWalkLeftDown1)
        }
    } elif (var(VAR_TEMP_x4001) == 6) {
        applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_FriendWalkLeftUp2)
        applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillWalkLeftUp2)
    } elif (var(VAR_TEMP_x4001) == 7) {
        applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_FriendWalkLeft2)
        applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillWalkLeft2)
    } else {
        applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_FriendWalkLeftDown2)
        applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillWalkLeftDown2)
    }
    waitmovement
    applymovement(obj_player, Route31_VioletGatehouse_Movement_PlayerFaceRight)
    if (var(VAR_TEMP_x4002) == 1) {
        applymovement(obj_partner_poke, Route31_VioletGatehouse_Movement_PlayerFaceRight)
    }
    waitmovement
    bufferplayersname(0)
    gendermsgbox("Lyra: I knew it was you, {STRVAR_1 3, 0, 0}!\r"
                 "How did you get past me?\n"
                 "Here is something neat for\f"
                 "surprising me, {STRVAR_1 3, 0, 0}!\r", "Ethan: I knew it was you, {STRVAR_1 3, 0, 0}!\r"
                                                         "How did you get past me?\n"
                                                         "Here is something neat for\f"
                                                         "surprising me, {STRVAR_1 3, 0, 0}!\r")
    giveitemnocheck(ITEM_VS__RECORDER, 1)
    gendermsgbox("The Vs. Recorder can record\n"
                 "your Pokémon battles.\r"
                 "I have to go now!\f"
                 "I won’t let you pass me again!\r", "The Vs. Recorder can record\n"
                                                     "your Pokémon battles.\r"
                                                     "I have to go now!\f"
                                                     "I won’t let you pass me again!\r")
    closemessage
    applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_PlayerFaceRight)
    waitmovement
    gendermsgbox("Let’s go, MARILL!\r", "Come on, MARILL!\r")
    closemessage
    applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillFaceLeft)
    waitmovement
    if (var(VAR_TEMP_x4002) == 1) {
        if (var(VAR_TEMP_x4001) == 6) {
            applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_FriendExit1)
            applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillExit2)
        } elif (var(VAR_TEMP_x4001) == 7) {
            applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_FriendExit2)
            applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillExit3)
        } else {
            applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_FriendExit3)
            applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillExit4)
        }
    } elif (var(VAR_TEMP_x4001) == 6) {
        applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_FriendExit4)
        applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillExit5)
    } elif (var(VAR_TEMP_x4001) == 7) {
        applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_FriendExit5)
        applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillExit6)
    } else {
        applymovement(obj_R31R0101_var_1, Route31_VioletGatehouse_Movement_FriendExit6)
        applymovement(obj_R31R0101_tsure_poke_static_marill, Route31_VioletGatehouse_Movement_MarillExit7)
    }
    wait(16, VAR_SPECIAL_RESULT)
    applymovement(obj_player, Route31_VioletGatehouse_Movement_PlayerFaceLeft)
    if (var(VAR_TEMP_x4002) == 1) {
        applymovement(obj_partner_poke, Route31_VioletGatehouse_Movement_PlayerFaceLeft)
    }
    waitmovement
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    movepersonfacing(obj_R31R0101_var_1, 12, 0, 28, DIR_NORTH)
    movepersonfacing(obj_R31R0101_tsure_poke_static_marill, 12, 0, 28, DIR_NORTH)
    callstd(std_fade_end_friend_music)
    releaseall
    setvar(VAR_UNK_4132, 1)
    end
}

