scrdefs {
    Ecruteak_Gym_OnTransition
    Ecruteak_Gym_EventScript_Morty
    Ecruteak_Gym_EventScript_WarpToEcruteakGym
    Ecruteak_Gym_EventScript_GymGuide
    Ecruteak_Gym_EventScript_OldManScene
