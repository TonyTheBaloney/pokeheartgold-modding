}

script Ecruteak_Gym_OnTransition {
    ecruteakgyminit
    getphonebookrematch(PHONE_CONTACT_MORTY, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 0) {
        setflag(FLAG_HIDE_ECRUTEAK_GYM_MORTY)
        end
    }
    if (!flag(FLAG_GAME_CLEAR)) { goto(_00A6) }
    checkregisteredphonenumber(PHONE_CONTACT_MORTY, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_0085) }
    getweekday(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 1) {
        setflag(FLAG_HIDE_ECRUTEAK_GYM_MORTY)
    } elif (var(VAR_TEMP_x4000) == 2) {
        setflag(FLAG_HIDE_ECRUTEAK_GYM_MORTY)
    } else {
        clearflag(FLAG_HIDE_ECRUTEAK_GYM_MORTY)
    }
    end
_0085:
    getweekday(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 5) {
        setflag(FLAG_HIDE_ECRUTEAK_GYM_MORTY)
    } else {
        clearflag(FLAG_HIDE_ECRUTEAK_GYM_MORTY)
    }
    end
_00A6:
    clearflag(FLAG_HIDE_ECRUTEAK_GYM_MORTY)
    end
}

script Ecruteak_Gym_EventScript_OldManScene {
    followmonresetmovement
    lockall
    applymovement(obj_T27GYM0101_gsoldman1, Ecruteak_Gym_Movement_OldManWalkDown)
    waitmovement
    npcmsg("You have business with the Gym Leader?\r"
           "Morty, the Gym Leader, has gone to\n"
           "the Burned Tower.\r"
           "Sorry, but you’ll have to leave.\n"
           "Ho ho ho.\r")
    closemessage
    applymovement(obj_T27GYM0101_gsoldman1, Ecruteak_Gym_Movement_OldManWalkDownUp)
    applymovement(obj_player, Ecruteak_Gym_Movement_PlayerWalkDown)
    waitmovement
    setvar(VAR_UNK_4079, 1)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    warp(MAP_ECRUTEAK, 7, 376, 182, DIR_SOUTH)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

movement Ecruteak_Gym_Movement_OldManWalkDown {
    emote_exclamation_mark
    walk_down * 3
    delay_8
}

movement Ecruteak_Gym_Movement_OldManWalkDownUp {
    walk_slow_down
    lock_dir
    walk_up
}

movement Ecruteak_Gym_Movement_PlayerWalkDown {
    delay_8
    walk_down
    delay_8
}

script Ecruteak_Gym_EventScript_Morty {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_FOG, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        if (!flag(FLAG_GOT_TM30_FROM_MORTY)) { goto(_019B) }
        npcmsg("Morty: I get it...\r"
               "The person the Kimono Girls were\n"
               "talking about must be you...\r"
               "Never mind.\r"
               "You should be strong enough to go\n"
               "across the sea.\r"
               "When you go west and then south,\n"
               "you’ll reach Olivine City.\f"
               "Why don’t you head for it?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Morty: It’s good of you to have come.\r"
           "Here in Ecruteak, Pokémon have long\n"
           "been revered.\r"
           "It’s said that a rainbow-hued\n"
           "Pokémon will come down to appear\f"
           "before a truly powerful Trainer.\r"
           "I believed that tale, so I have\n"
           "secretly trained here all my life.\r"
           "As a result, I can now see what\n"
           "others cannot.\r"
           "I see a shadow of the person who\n"
           "will make the Pokémon appear.\r"
           "I believe that person is me!\r"
           "You’re going to help me reach\n"
           "that level!\r")
    closemessage
    trainerbattle(TRAINER_LEADER_MORTY_MORTY, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    npcmsg("Morty: I don’t think our potentials are\n"
           "so different. But you seem to have\f"
           "something more than that...\r"
           "So be it. This Badge is yours.\r")
    givebadge(BADGE_FOG)
    addvar(VAR_MIDGAME_BADGES, 1)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    setflag(FLAG_UNK_998)
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Fog Badge from Morty!")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    npcmsg("Morty: By having the Fog Badge,\n"
           "Pokémon up to Lv. 50, including traded\f"
           "Pokémon, will obey you.\r"
           "Also, Pokémon will be able to use Surf.\r"
           "Here is another thing...\n"
           "I want you to have this, too.\r")
    goto(_019B)
_019B:
    if (!itemspace(ITEM_TM30, 1)) { goto(_01CF) }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM30_FROM_MORTY)
    npcmsg("Morty: It’s Shadow Ball. It causes\n"
           "damage and may reduce Special Defense.\f"
           "Use it if it appeals to you.")
    waitbuttonpress
    closemessage
    releaseall
    end
_01CF:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

script Ecruteak_Gym_EventScript_WarpToEcruteakGym {
    followmonresetmovement
    lockall
    playse(SEQ_SE_DP_GYURU)
    applymovement(obj_player, Ecruteak_Gym_Movement_PlayerExit)
    waitmovement
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    warp(MAP_ECRUTEAK_GYM, 0, 16, 49, DIR_NORTH)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

movement Ecruteak_Gym_Movement_PlayerExit {
    face_down * 2
    face_left * 2
    face_up * 2
    face_right * 2
    face_down * 2
    face_left * 2
    face_up * 2
    face_right * 2
    face_down * 2
    face_left * 2
    face_up * 2
    face_right * 2
    face_down * 2
    face_left * 2
    face_up * 2
    face_right
    set_invisible * 0
}

script Ecruteak_Gym_EventScript_GymGuide {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_FOG, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        bufferplayersname(0)
        npcmsg("Whew, {STRVAR_1 3, 0, 0}.\n"
               "You did great!\r"
               "I was cowering in the corner out of\n"
               "pure terror!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Yo! Champ in the making!\n"
           "The Trainers here use Ghost-type\f"
           "Pokémon at will.\r"
           "A ghost is like a shade or a phantom...\n"
           "It won’t do any good to use physical\f"
           "strength alone.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Ecruteak_Gym_EventScript_GymSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_FOG, VAR_SPECIAL_RESULT)
    bufferplayersname(0)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Ecruteak City Pokémon Gym")
    } else {
        npcmsg("Ecruteak City Pokémon Gym\r"
               "Leader: Morty\n"
               "Certified Trainer!\f"
               "{STRVAR_1 3, 0, 0}")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

