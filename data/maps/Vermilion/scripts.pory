script Vermilion_EventScript_Woman {
    simplenpcmsg("Vermilion Port is Kanto’s\n"
                 "seaside gateway.\r"
                 "Luxury liners from around the world\n"
                 "dock here.")
    end
}

script Vermilion_EventScript_Man {
    simplenpcmsg("There are eight Gyms in Kanto.\r"
                 "That big building is Vermilion’s\n"
                 "Pokémon Gym.")
    end
}

script Vermilion_EventScript_OldMan {
    simplenpcmsg("My Pokémon is preparing the land\n"
                 "for construction.\r"
