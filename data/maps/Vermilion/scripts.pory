script Vermilion_EventScript_PokefanM1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    dummy491(247)
    if (flag(FLAG_GOT_PP_MAX_FROM_VERMILLION_CITY_MAN)) {
        npcmsg("PP Max is a powerful item that\n"
               "raises a move’s top PP to its maximum.\f"
               "It can change the way you battle!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_UNK_4135) >= 8) {
        npcmsg("Congratulations!\n"
               "You got all the Kanto Gym Badges.\r"
               "I’ve got a reward for your efforts.\r")
        if (!itemspace(ITEM_PP_MAX, 1)) {
            callstd(std_bag_is_full)
            closemessage
            releaseall
            end
        }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_PP_MAX_FROM_VERMILLION_CITY_MAN)
        npcmsg("PP Max is a powerful item that\n"
               "raises a move’s top PP to its maximum.\f"
               "It can change the way you battle!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_UNK_4135) >= 5) { goto(_01F4) }
    if (var(VAR_UNK_4135) >= 1) { goto(_01E9) }
    npcmsg("Skilled Trainers gather in Kanto.\n"
           "Gym Leaders are especially strong.\r"
           "They won’t be easy to defeat.")
    waitbuttonpress
    closemessage
    releaseall
    end
_01E9:
    npcmsg("You’ve started to collect Kanto\n"
           "Gym Badges?\r"
           "Don’t you agree that the Trainers\n"
           "here are tough?")
    waitbuttonpress
    closemessage
    releaseall
    end
_01F4:
    npcmsg("I guess you’ll be finished with your\n"
           "conquest of Kanto Gyms soon.\r"
           "Let me know if you get all\n"
           "eight Badges.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

