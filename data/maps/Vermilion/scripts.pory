script Vermilion_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 4) {
            clearflag(FLAG_HIDE_CAMERON)
        } elif (var(VAR_TEMP_x4000) == 0) {
            clearflag(FLAG_HIDE_CAMERON)
        } else {
            setflag(FLAG_HIDE_CAMERON)
        }
        setvar(VAR_UNK_4085, 0)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script Vermilion_EventScript_StevenScene {
    followmonresetmovement
    lockall
    applymovement(obj_T06_daigo, Vermilion_Movement_StevenWalkLeft)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, Vermilion_Movement_PlayerWalkDown1)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("Hi!\n"
           "My name is Steven.\f"
           "The Champion from the Hoenn region.\r"
           "Have we met...before?\r"
           "That’s not possible.\n"
           "All the Trainers I have battled\f"
           "seem to have the same look, anyway.\r"
           "Especially the ones who gave me\n"
           "tough battles...\r")
    closemessage
    applymovement(obj_T06_daigo, Vermilion_Movement_StevenFaceLeft)
    waitmovement
    getgameversion(VAR_TEMP_x4004)
    if (var(VAR_TEMP_x4004) == 8) {
        showpokemonpicwindow(SPECIES_LATIOS, 0)
        npcmsg("Steven: By the way, have you heard of\n"
               "a Pokémon called LATIOS?\r"
               "I am investigating why LATIOS,\n"
               "a Pokémon from Hoenn, decided to\f"
               "leave Hoenn to come here.\r")
        closemessage
        createroamer(3)
        closepokemonpicwindow
        applymovement(obj_T06_daigo, Vermilion_Movement_StevenFaceLeft)
        waitmovement
        npcmsg("LATIOS is a Pokémon that has a lot\n"
               "to do with Soul Dew, a gemlike Orb.\r"
               "Considering the fact that LATIOS is now\n"
               "in Kanto, it is possible to assume that\f"
               "this has to do with Soul Dew.\r")
        closemessage
        applymovement(obj_T06_daigo, Vermilion_Movement_StevenFaceLeft)
        waitmovement
        npcmsg("LATIOS is a Pokémon that travels\n"
               "a great distance.\r"
               "It’ll be difficult to find without any\n"
               "machine to track it with.\r"
               "But any Trainer will be drawn to it,\n"
               "won’t they?\r")
        closemessage
        goto(_013F)
        end
    _013F:
        applymovement(obj_T06_daigo, Vermilion_Movement_StevenFaceLeft)
        waitmovement
        npcmsg("Steven: I must go.\n"
               "May our journeys cross again.\r")
        closemessage
        applymovement(obj_T06_daigo, Vermilion_Movement_StevenWalkRight)
        waitmovement
        setvar(VAR_UNK_4130, 2)
        removeobject(obj_T06_daigo)
        setflag(FLAG_HIDE_VERMILION_CITY_STEVEN)
        releaseall
        end
    }
    showpokemonpicwindow(SPECIES_LATIAS, 1)
    npcmsg("Steven: By the way, have you heard of\n"
           "a Pokémon called LATIAS?\r"
           "I am investigating why LATIAS,\n"
           "a Pokémon from Hoenn, decided to\f"
           "leave Hoenn to come here.\r")
    closemessage
    createroamer(2)
    closepokemonpicwindow
    applymovement(obj_T06_daigo, Vermilion_Movement_StevenFaceLeft)
    waitmovement
    npcmsg("LATIAS is a Pokémon that has a lot\n"
           "to do with Soul Dew, a gemlike Orb.\r"
           "Considering the fact that LATIAS is now\n"
           "in Kanto, it is possible to assume that\f"
           "this has to do with the Soul Dew.\r")
    closemessage
    applymovement(obj_T06_daigo, Vermilion_Movement_StevenFaceLeft)
    waitmovement
    npcmsg("LATIAS is a Pokémon that travels\n"
           "a great distance.\r"
           "It’ll be difficult to find without any\n"
           "machine to track it with.\r"
           "But any Trainer will be drawn to it,\n"
           "won’t they?\r")
    closemessage
    goto(_013F)
    end
}

