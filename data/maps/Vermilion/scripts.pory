text msg_0483_T06_00014 {
    "Eusine: That was so close!\n"
    "I thought I could corner it by\f"
    "ambushing it here...\r"
    "But running on the water...\n"
    "is beyond me.\r"
    "Still, I am starting to see a pattern.\f"
    "SUICUNE prefers water!\f"
    "That means...\r"
}

text msg_0483_T06_00015 {
