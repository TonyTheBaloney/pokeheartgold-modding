script scr_seq_T29_008 {
    simplenpcmsg("Did my eyes deceive me? I saw a \n"
                 "red GYARADOS in the Lake of Rage...\r"
                 "But I thought GYARADOS were\n"
                 "usually blue?")
    end
}

script scr_seq_T29_009 {
    simplenpcmsg("I heard this lake was made by rampaging\n"
                 "GYARADOS.\r"
                 "I wonder if there is any connection\n"
                 "to their mass outbreak now?")
    end
    simplenpcmsg(msg_0626_T29_00000)
    end
}

script scr_seq_T29_010 {
    simplenpcmsg("Battle with the great catch\n"
                 "I just got!")
    end
}

script scr_seq_T29_011 {
    simplenpcmsg("I can only land the same kind of\n"
                 "Pokémon. No matter how long I fish!")
