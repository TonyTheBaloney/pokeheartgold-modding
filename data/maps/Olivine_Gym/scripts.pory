    if (var(VAR_TEMP_x4001) == 1) { goto(_007A) }
    getcurrenthour(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 13) {
        setflag(FLAG_HIDE_JASMINE_IN_GYM)
    } else {
        goto(_009D)
    }
    end
_007A:
    getcurrenthour(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 12) {
        setflag(FLAG_HIDE_JASMINE_IN_GYM)
    } else {
        goto(_009D)
    }
    end
_009D:
    checkregisteredphonenumber(PHONE_CONTACT_ERIKA, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_015A) }
    checkbadge(BADGE_EARTH, VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) == 1) { goto(_00CB) }
    goto(_015A)
    end
_00CB:
    getweekday(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) != 6) { goto(_00E8) }
    goto(_0109)
    goto(_0107)
_00E8:
    if (var(VAR_TEMP_x4000) != 0) { goto(_0101) }
    goto(_0109)
    goto(_0107)
_0101:
    goto(_015A)
_0107:
    end
_0109:
    getcurrenthour(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 14) {
        setflag(FLAG_HIDE_JASMINE_IN_GYM)
    } elif (var(VAR_TEMP_x4000) == 15) {
        setflag(FLAG_HIDE_JASMINE_IN_GYM)
    } elif (var(VAR_TEMP_x4000) == 16) {
        setflag(FLAG_HIDE_JASMINE_IN_GYM)
    } else {
        goto(_015A)
    }
    end
_015A:
    end
}

script Olivine_Gym_EventScript_Jasmine {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_MINERAL, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        if (!flag(FLAG_GOT_TM23_FROM_JASMINE)) { goto(_01CE) }
        checkregisteredphonenumber(PHONE_CONTACT_JASMINE, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) == 1) {
            if (flag(FLAG_TRADE_JASMINE_STEELIX)) {
                if (var(VAR_TEMP_x4000) == 55) {
                    npcmsg(msg_0606_T26GYM0101_00011)
                } else {
                    npcmsg("Jasmine: Don’t you sometimes feel like\n"
                           "scrubbing Steel-type Pokémon?\f"
                           "Don’t you?")
                }
                waitbuttonpress
                closemessage
                releaseall
                end
            }
            if (var(VAR_TEMP_x4000) == 77) { goto(_0264) }
            setvar(VAR_TEMP_x4000, 77)
            npcmsg("Jasmine: Long time, no see.\r"
                   "Um... I’m fine, thank you.\r"
                   "I don’t know how to say this,\n"
                   "but...nothing...")
            waitbuttonpress
            closemessage
            releaseall
            end
        _0264:
            npcmsg("Jasmine: Um... Er...\r"
                   "Will you trade your Pokémon\n"
                   "for mine? {YESNO 0}")
            touchscreenmenuhide
            getmenuchoice(VAR_SPECIAL_RESULT)
            touchscreenmenushow
            if (var(VAR_SPECIAL_RESULT) == 1) { goto(_034B) }
            npcmsg("Jasmine: Really? Thank you very much!\r"
                   "I’ll be happy with any Pokémon!\r")
            closemessage
            fadescreen(6, 1, 0, RGB_BLACK)
            waitfade
            choosepartymonfortrade
            getpartyselection(VAR_SPECIAL_RESULT)
            restoreoverworld
            fadescreen(6, 1, 1, RGB_BLACK)
            waitfade
            if (var(VAR_SPECIAL_RESULT) == 255) { goto(_034B) }
            copyvar(VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT)
            getpartymonspecies(VAR_SPECIAL_x8004, VAR_TEMP_x4003)
            getpartymonform2(VAR_SPECIAL_x8004, VAR_TEMP_x4004)
            if (var(VAR_TEMP_x4003) == 0) { goto(_0356) }
            if (var(VAR_TEMP_x4004) != 0) {
                if (var(VAR_TEMP_x4003) == 487) { goto(_0364) }
                if (var(VAR_TEMP_x4003) == 492) { goto(_0364) }
                if (var(VAR_TEMP_x4003) == 172) { goto(_0364) }
                if (var(VAR_TEMP_x4003) == 479) { goto(_0364) }
            }
            bufferpartymonnick(1, VAR_SPECIAL_x8004)
            npcmsg("Will you trade {STRVAR_1 1, 1, 0}? {YESNO 0}")
            touchscreenmenuhide
            getmenuchoice(VAR_SPECIAL_RESULT)
            touchscreenmenushow
            if (var(VAR_SPECIAL_RESULT) == 1) { goto(_034B) }
            closemessage
            loadnpctrade(5)
            npctradeexec(VAR_SPECIAL_x8004)
            npctradeend
            setflag(FLAG_TRADE_JASMINE_STEELIX)
            setvar(VAR_TEMP_x4000, 55)
            npcmsg(msg_0606_T26GYM0101_00011)
            waitbuttonpress
            closemessage
            releaseall
            end
        _034B:
            npcmsg("Jasmine: Oh, uh-huh, I see.\n"
                   "That’s disappointing, but I understand.")
            waitbuttonpress
            closemessage
            releaseall
            end
        _0356:
            bufferplayersname(0)
            npcmsg("Jasmine: I like Eggs, too, but\n"
                   "I’d like a Pokémon, {STRVAR_1 3, 0, 0}.\f"
                   "One that might have a little training...")
            waitbuttonpress
            closemessage
            releaseall
            end
        _0364:
            npcmsg("Jasmine: I’d appreciate it so much...\n"
                   "Except that I cannot accept such\f"
                   "a precious Pokémon.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Jasmine: Um...\r"
               "I don’t know how to say this, but\n"
               "good luck...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Jasmine: Thank you for your help\n"
           "at the Lighthouse...\r"
           "But this is different. Please allow me to\n"
           "introduce myself.\r"
           "I am Jasmine, a Gym Leader.\n"
           "I use the...clang!\f"
           "Steel type!\r"
           "...Do you know about the Steel type?\r"
           "They are very hard, cold, sharp,\n"
           "and really strong!\f"
           "Um... I’m not lying.\r")
    closemessage
    trainerbattle(TRAINER_LEADER_JASMINE_JASMINE, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    npcmsg("Jasmine: ...You are a better Trainer\n"
           "than me, in both skill and kindness.\r"
           "In accordance with League rules,\n"
           "I confer upon you this Badge.\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Mineral Badge from Jasmine!")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    givebadge(BADGE_MINERAL)
    addvar(VAR_MIDGAME_BADGES, 1)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    if (var(VAR_MIDGAME_BADGES) == 3) {
        setvar(VAR_SCENE_ROCKET_TAKEOVER, 1)
    }
    npcmsg("Jasmine: With that Badge,\n"
           "all Pokémon, including traded\f"
           "Pokémon up to Lv. 70, will obey\f"
           "you without question.\f"
           "Um... Please take this, too...\r")
_01CE:
    if (!itemspace(ITEM_TM23, 1)) { goto(_0202) }
    callstd(std_give_item_verbose)
    npcmsg("Jasmine: It is called Iron Tail...\r"
           "Your Pokémon will hit the target\n"
           "with its hard tail, occasionally\f"
           "lowering the target’s Defense...")
    waitbuttonpress
    closemessage
    releaseall
    setflag(FLAG_GOT_TM23_FROM_JASMINE)
    end
_0202:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

text msg_0606_T26GYM0101_00011 {
    "Jasmine: Thank you so much.\n"
    "I’ll take good care of it."
}

script Olivine_Gym_EventScript_GentlemanTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_T26GYM0101_gsgentleman, Olivine_Gym_Movement_GentlemanExclamation)
    waitmovement
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 5) {
        applymovement(obj_T26GYM0101_gsgentleman, Olivine_Gym_Movement_GentlemanWalkRight1)
    } elif (var(VAR_TEMP_x4000) == 6) {
        applymovement(obj_T26GYM0101_gsgentleman, Olivine_Gym_Movement_GentlemanWalkRight2)
    } else {
        applymovement(obj_T26GYM0101_gsgentleman, Olivine_Gym_Movement_GentlemanWalkRight3)
    }
    applymovement(obj_player, Olivine_Gym_Movement_PlayerFaceLeft)
    waitmovement
    npcmsg(msg_0606_T26GYM0101_00019)
    waitbuttonpress
    closemessage
    releaseall
    if (var(VAR_UNK_410E) == 1) {
        setvar(VAR_UNK_410E, 2)
    }
    end
}

text msg_0606_T26GYM0101_00019 {
    "I knew you’d come here.\r"
    "Thank you for helping the Gym Leader,\n"
    "but battle is a separate matter.\r"
    "Go for it!"
}

movement Olivine_Gym_Movement_GentlemanExclamation {
    emote_exclamation_mark
}

movement Olivine_Gym_Movement_GentlemanWalkRight1 {
    walk_right
}

movement Olivine_Gym_Movement_GentlemanWalkRight2 {
    walk_right * 2
}

movement Olivine_Gym_Movement_GentlemanWalkRight3 {
    walk_right * 3
}

movement Olivine_Gym_Movement_PlayerFaceLeft {
    walk_in_place_left
}

movement Olivine_Gym_Movement_PlayerFaceRight {
    walk_in_place_right
}

script Olivine_Gym_EventScript_LassTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_T26GYM0101_gsgirl1, Olivine_Gym_Movement_GentlemanExclamation)
    waitmovement
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 5) {
        applymovement(obj_T26GYM0101_gsgirl1, Olivine_Gym_Movement_LassWalkLeft1)
    } elif (var(VAR_TEMP_x4000) == 6) {
        applymovement(obj_T26GYM0101_gsgirl1, Olivine_Gym_Movement_LassWalkLeft2)
    } else {
        applymovement(obj_T26GYM0101_gsgirl1, Olivine_Gym_Movement_LassWalkLeft3)
    }
    applymovement(obj_player, Olivine_Gym_Movement_PlayerFaceRight)
    waitmovement
    npcmsg(msg_0606_T26GYM0101_00021)
    waitbuttonpress
    closemessage
    releaseall
    if (var(VAR_UNK_410E) == 2) {
        setvar(VAR_UNK_410E, 3)
    }
    end
}

text msg_0606_T26GYM0101_00021 {
    "Giggle...\r"
    "I know how capable you are\n"
    "from the Lighthouse.\r"
    "It’s time you showed that side of\n"
    "yourself to Jasmine! Good luck!"
}

movement Olivine_Gym_Movement_LassWalkLeft1 {
    walk_left * 3
}

movement Olivine_Gym_Movement_LassWalkLeft2 {
    walk_left * 2
}

movement Olivine_Gym_Movement_LassWalkLeft3 {
    walk_left
}

script Olivine_Gym_EventScript_Gentleman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_MINERAL, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Impressive!\r"
               "You should continue your journey to\n"
               "different places.\r"
               "Since you can use Surf, why don’t you\n"
               "try it on the Lake of Rage?")
    } else {
        npcmsg(msg_0606_T26GYM0101_00019)
    }
    waitbuttonpress
    closemessage
    releaseall
    if (var(VAR_UNK_410E) == 1) {
        setvar(VAR_UNK_410E, 2)
    }
    end
}

script Olivine_Gym_EventScript_Lass {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_MINERAL, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("You are amazing...\r"
               "You should aim even higher, since\n"
               "you have such potential.\r"
               "Have you been to Mahogany Town?")
    } else {
        npcmsg(msg_0606_T26GYM0101_00021)
    }
    waitbuttonpress
    closemessage
    releaseall
    if (var(VAR_UNK_410E) == 2) {
        setvar(VAR_UNK_410E, 3)
    }
    end
}

script Olivine_Gym_EventScript_GymGuide {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_MINERAL, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("That was awesome.\f"
               "The Steel type, huh?\f"
               "That was one heated battle you had!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_UNK_410E) == 0) {
        npcmsg("Jasmine, the Gym Leader?\n"
               "She’s at the Lighthouse.\r"
               "She’s been tending to a sick Pokémon.\r"
               "A strong Trainer is compassionate\n"
               "at the same time...")
    } else {
        npcmsg("Jasmine uses Steel-type Pokémon.\r"
               "She’s trying to hide her tenderness\n"
               "behind her steely coldness.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Olivine_Gym_EventScript_GymSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_MINERAL, VAR_SPECIAL_RESULT)
    bufferplayersname(0)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Olivine City Pokémon Gym")
    } else {
        npcmsg("Olivine City Pokémon Gym\r"
               "Leader: Jasmine\n"
               "Certified Trainer!\f"
               "{STRVAR_1 3, 0, 0}")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

mapscripts Olivine_Gym_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Olivine_Gym_OnTransition
}
