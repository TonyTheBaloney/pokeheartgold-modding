script Goldenrod_Tunnel_1F_EventScript_Man {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 2) {
        npcmsg(msg_0116_D37R0101_00002)
    } elif (var(VAR_SCENE_ROCKET_TAKEOVER) == 4) {
        npcmsg(msg_0116_D37R0101_00002)
    } elif (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("You look like an earnest youth.\n"
               "How come you ended up in\f"
               "Team Rocket...?")
    } else {
        npcmsg("I was challenged to a battle\n"
               "downstairs.\r"
               "It’s rough down there. You’d better\n"
               "be careful.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

text msg_0116_D37R0101_00002 {
    "Team Rocket never stops bothering\n"
    "people, do they?"
}

script Goldenrod_Tunnel_1F_EventScript_Woman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 2) {
        npcmsg(msg_0116_D37R0101_00005)
    } elif (var(VAR_SCENE_ROCKET_TAKEOVER) == 4) {
        npcmsg(msg_0116_D37R0101_00005)
    } elif (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("Yes...\n"
               "Team Rocket can use the tunnel, too.")
    } else {
        npcmsg("There are some shops downstairs...\r"
               "But there are also Trainers.\n"
               "I’m scared to go down there.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

text msg_0116_D37R0101_00005 {
    "All the people working at the tunnel\n"
    "left. No one wants Team Rocket to\f"
    "give them a hard time."
}

mapscripts Goldenrod_Tunnel_1F_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Goldenrod_Tunnel_1F_OnTransition
    INIT_SCRIPT_ON_FRAME_TABLE [
