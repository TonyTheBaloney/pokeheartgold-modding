movement Goldenrod_Tunnel_1F_Movement_MarillWalkLeft {
    walk_slightly_fast_left
    walk_in_place_fast_right
    jump_in_place_fast_left * 2
    walk_fast_left * 3
    face_up
    delay_1
    face_right
    delay_1
    face_down
    delay_1
    face_left
    delay_1
    face_up
    delay_1
    face_right
    delay_1
    face_down
}

movement Goldenrod_Tunnel_1F_Movement_PlayerWalkUp {
    walk_up * 3
}

movement Goldenrod_Tunnel_1F_Movement_FriendWalkLeft {
    walk_left
    emote_exclamation_mark
}

movement Goldenrod_Tunnel_1F_Movement_FriendWalkLeftDown {
    walk_left
    walk_down * 2
    walk_left
}

movement Goldenrod_Tunnel_1F_Movement_MarillWalkRightDown {
    delay_8 * 3
    walk_right
    walk_down
}

movement Goldenrod_Tunnel_1F_Movement_FriendExit1 {
    walk_down * 2
    walk_left
    walk_down
    set_invisible
}

movement Goldenrod_Tunnel_1F_Movement_MarillExit1 {
    walk_down * 3
    walk_left
    walk_down
    set_invisible
}

movement Goldenrod_Tunnel_1F_Movement_MarillFaceRight {
    walk_in_place_right
}

movement Goldenrod_Tunnel_1F_Movement_PlayerFaceDown {
    walk_in_place_down
}

