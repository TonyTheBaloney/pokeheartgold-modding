script Goldenrod_Tunnel_1F_EventScript_LyraScene {
    followmonresetmovement
    lockall
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 3) { goto(_0228) }
    clearflag(FLAG_HIDE_GOLDENROD_UNDERGROUND_FRIEND)
    addobject(obj_D37R0101_tsure_poke_static_marill)
    if (var(VAR_TEMP_x4001) == 30) {
        movepersonfacing(obj_D37R0101_tsure_poke_static_marill, 9, 0, 25, DIR_WEST)
    }
    playse(SEQ_SE_DP_KAIDAN2)
    applymovement(obj_D37R0101_tsure_poke_static_marill, Goldenrod_Tunnel_1F_Movement_MarillWalkLeft)
    waitmovement
    wait(8, VAR_SPECIAL_RESULT)
    playcry(SPECIES_MARILL, 0)
    waitcry
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, Goldenrod_Tunnel_1F_Movement_PlayerWalkUp)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    clearflag(FLAG_HIDE_GOLDENROD_UNDERGROUND_FRIEND)
    addobject(obj_D37R0101_var_1)
    if (var(VAR_TEMP_x4001) == 30) {
        movepersonfacing(obj_D37R0101_var_1, 9, 0, 25, DIR_WEST)
    }
    playse(SEQ_SE_DP_KAIDAN2)
    callstd(std_play_friend_music)
    applymovement(obj_D37R0101_var_1, Goldenrod_Tunnel_1F_Movement_FriendWalkLeft)
    waitmovement
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 0) {
        applymovement(obj_D37R0101_tsure_poke_static_marill, Goldenrod_Tunnel_1F_Movement_MarillFaceRight)
        applymovement(obj_player, Goldenrod_Tunnel_1F_Movement_MarillFaceRight)
        applymovement(obj_partner_poke, Goldenrod_Tunnel_1F_Movement_MarillFaceRight)
        waitmovement
    } else {
        applymovement(obj_D37R0101_tsure_poke_static_marill, Goldenrod_Tunnel_1F_Movement_MarillFaceRight)
        applymovement(obj_player, Goldenrod_Tunnel_1F_Movement_MarillFaceRight)
        waitmovement
    }
    bufferplayersname(0)
    gendermsgbox(msg_0116_D37R0101_00006, msg_0116_D37R0101_00009)
    closemessage
    applymovement(obj_D37R0101_var_1, Goldenrod_Tunnel_1F_Movement_FriendWalkLeftDown)
    applymovement(obj_D37R0101_tsure_poke_static_marill, Goldenrod_Tunnel_1F_Movement_MarillWalkRightDown)
    waitmovement
    gendermsgbox(msg_0116_D37R0101_00007, msg_0116_D37R0101_00010)
    giveitemnocheck(ITEM_FASHION_CASE, 1)
    call(_0354)
    gendermsgbox(msg_0116_D37R0101_00008, msg_0116_D37R0101_00011)
    closemessage
    applymovement(obj_D37R0101_var_1, Goldenrod_Tunnel_1F_Movement_FriendExit1)
    applymovement(obj_D37R0101_tsure_poke_static_marill, Goldenrod_Tunnel_1F_Movement_MarillExit1)
    waitmovement
    playse(SEQ_SE_DP_KAIDAN2)
    setflag(FLAG_HIDE_GOLDENROD_UNDERGROUND_FRIEND)
    removeobject(obj_D37R0101_var_1)
    removeobject(obj_D37R0101_tsure_poke_static_marill)
    waitse(SEQ_SE_DP_KAIDAN2)
    callstd(std_fade_end_friend_music)
    setvar(VAR_UNK_40F8, 1)
    setflag(FLAG_UNK_14C)
    releaseall
    end
}

text msg_0116_D37R0101_00006 {
    "Lyra: Hi, {STRVAR_1 3, 0, 0}.\n"
    "You are just in time!\r"
}

text msg_0116_D37R0101_00009 {
    "Ethan: Hi, {STRVAR_1 3, 0, 0}.\n"
    "You are just in time!\r"
}

text msg_0116_D37R0101_00007 {
    "Lyra: When you follow this tunnel,\n"
    "you’ll see a Dress-Up Shop.\r"
    "That’s where your Pokémon can put on\n"
    "Accessories to dress up and\f"
    "take pictures!\r"
    "By the way, here is the Fashion Case!\r"
    "Did you say you want it?\n"
    "I knew it!\r"
    "This is a present from me!\r"
}

text msg_0116_D37R0101_00010 {
    "Ethan: When you follow this tunnel,\n"
    "you’ll see a Dress-Up Shop.\r"
    "That’s where your Pokémon can put on\n"
