script BellTowerRoof_EventScript_KimonoGirl1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_108)) {
        if (var(VAR_TEMP_x4005) == 5) {
            npcmsg(msg_0058_D17R0110_00008)
        } elif (var(VAR_TEMP_x4005) == 6) {
            npcmsg(msg_0058_D17R0110_00008)
        } elif (var(VAR_TEMP_x4005) == 4) {
            npcmsg("You have not only made HO-OH appear,\n"
                   "but you have also caught it...\r"
                   "You are so wonderful.\n"
                   "There is nothing more for us to say.\r"
                   "Take good care of yourself in\n"
                   "your journey...")
        } else {
            npcmsg("If that is what you believe, we will not\n"
                   "try to convince you otherwise.\r"
                   "Still, if you want to see HO-OH once\n"
                   "more, perhaps you can come back here\f"
                   "after everything has been settled...")
        }
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg(msg_0058_D17R0110_00001)
    waitbuttonpress
    closemessage
    releaseall
    end
}

text msg_0058_D17R0110_00008 {
    "I think when you turn your back to it,\n"
    "HO-OH will not come back for\f"
    "some time...\r"
    "If you want to see HO-OH, perhaps you\n"
    "can come back here after everything\f"
    "has been settled..."
}

text msg_0058_D17R0110_00001 {
    "This is all we can do for you...\n"
    "What you do now is entirely up to you..."
}

