}

script BellTowerRoof_EventScript_KimonoGirl2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_108)) {
        npcmsg("You have done a great job.\n"
               "Say hello to Professor Elm for us.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg(msg_0058_D17R0110_00001)
    waitbuttonpress
    closemessage
    releaseall
    end
}

