script scr_seq_D17R0110_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_108)) {
        if (var(VAR_TEMP_x4005) == 5) {
            npcmsg(msg_0058_D17R0110_00008)
        } elif (var(VAR_TEMP_x4005) == 6) {
            npcmsg(msg_0058_D17R0110_00008)
        } elif (var(VAR_TEMP_x4005) == 4) {
            npcmsg(msg_0058_D17R0110_00006)
        } else {
            npcmsg(msg_0058_D17R0110_00007)
        }
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg(msg_0058_D17R0110_00001)
    waitbuttonpress
    closemessage
    releaseall
    end
}

