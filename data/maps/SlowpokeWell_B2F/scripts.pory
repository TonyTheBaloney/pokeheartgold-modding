script SlowpokeWell_B2F_EventScript_SuperNerd {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_KINGS_ROCK_FROM_SLOWPOKE_WELL_MAN)) { goto(_004F) }
    npcmsg("I’m waiting to see SLOWPOKE’s moment\n"
           "of evolution. Through observation,\f"
           "I made a new discovery.\r"
           "A SLOWPOKE with a King’s Rock often\n"
           "gets bitten by a SHELLDER.\r"
           "Here, I’ll share a King’s Rock with you.")
    waitabpress
    closemessage
    if (!itemspace(ITEM_KINGS_ROCK, 1)) {
        callstd(std_bag_is_full)
        closemessage
        releaseall
        end
        end
    }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_KINGS_ROCK_FROM_SLOWPOKE_WELL_MAN)
    goto(_004F)
_004F:
    npcmsg("I’m going to be like SLOWPOKE.\r"
           "I’ll wait patiently so I can see\n"
           "one evolve.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

