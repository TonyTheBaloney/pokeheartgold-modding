text msg_0100_D32_00021 {
    "Welcome to the Exchange Service\n"
    "Corner!\r"
    "Would you like to trade in your BP\n"
    "for some prizes? {YESNO 0}"
}

script BattleFrontier_EventScript_Attendant2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    setvar(VAR_SPECIAL_x8000, 1)
    scriptoverlaycmd(3, 0)
    showpointsbox(1, 21, 1)
    npcmsg(msg_0100_D32_00021)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0B02) }
_0B44:
    npcmsg("Please choose the TM you\n"
