script BattleFrontier_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) != 3) {
            if (var(VAR_TEMP_x4000) == 5) { goto(_00D7) }
            setflag(FLAG_HIDE_CAMERON)
        } else {
        _00D7:
            setflag(FLAG_HIDE_CAMERON)
        }
        setflag(FLAG_UNK_234)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script BattleFrontier_EventScript_PokefanM2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 5)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, BattleFrontier_Movement_PlayerWalkRightUp)
        applymovement(obj_D32_gsmiddleman1_2, BattleFrontier_Movement_PokefanMFaceUp)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, BattleFrontier_Movement_PlayerWalkUp)
    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_player, BattleFrontier_Movement_PlayerWalkUpRight)
        applymovement(obj_D32_gsmiddleman1_2, BattleFrontier_Movement_PokefanMFaceUp)
    } else {
        applymovement(obj_player, BattleFrontier_Movement_PlayerWalkUpLeft)
        applymovement(obj_D32_gsmiddleman1_2, BattleFrontier_Movement_PokefanMFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, BattleFrontier_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(31)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement BattleFrontier_Movement_PlayerWalkRightUp {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement BattleFrontier_Movement_PlayerWalkUp {
    walk_up * 3
    walk_in_place_down
}

movement BattleFrontier_Movement_PlayerWalkUpLeft {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement BattleFrontier_Movement_PlayerWalkUpRight {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement BattleFrontier_Movement_PokefanMFaceUp {
    delay_8
    walk_in_place_up
}

movement BattleFrontier_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

script BattleFrontier_EventScript_LittleBoy1 {
    simplenpcmsg("Battle Tower... It’s so tall!\n"
                 "I wonder how many times my height it is?")
    end
}

script BattleFrontier_EventScript_BlackBelt {
    simplenpcmsg("All the places in the Battle Frontier\n"
                 "let you team up with a friend!\f"
                 "That’s so cool, don’t you think?\f"
                 "I wish I had a friend to team up with...")
    end
}

script BattleFrontier_EventScript_Idol {
    simplenpcmsg("I am the super Idol in Johto!\r"
                 "I’ve come all the way to the\n"
                 "Battle Frontier to promote my\f"
                 "latest song!\r"
                 "But...\r"
                 "Everybody seems to be a\n"
                 "Poké Maniac here!")
    end
}

script BattleFrontier_EventScript_Fisherman1 {
    simplenpcmsg("Fishing won’t keep me calm since I came\n"
                 "to know about the Battle Frontier.\f"
                 "When I go fishing, I find myself quitting\f"
                 "early and coming here.")
    end
}

script BattleFrontier_EventScript_LittleGirl {
    simplenpcmsg("The place I like best among the five\n"
                 "facilities here would be the\f"
                 "Battle Castle, because you can see\f"
                 "Lady Caitlin there!")
    end
}

script BattleFrontier_EventScript_Woman1 {
    simplenpcmsg("What makes me the most happy being\n"
                 "a Trainer?\r"
                 "The fact that Pokémon will always bring\n"
                 "me lots of friends!")
    end
}

script BattleFrontier_EventScript_OldMan {
    simplenpcmsg("Just like people go through different\n"
                 "things they can learn from, Pokémon\f"
                 "learn different things from battles.\r"
                 "Behind every experience, there is a\n"
                 "story. Isn’t that right, dear?")
    end
}

script BattleFrontier_EventScript_OldWoman {
    simplenpcmsg("All experiences lead to a tale.\n"
                 "I’m not wrong, am I, dear?")
    end
}

script BattleFrontier_EventScript_Woman2 {
    simplenpcmsg("I’ve come to the Battle Frontier to\n"
                 "get a job!\r"
                 "Thanks to my previous job, I’m good\n"
                 "at cooking, cleaning, and laundry!")
    end
}

script BattleFrontier_EventScript_Cowgirl {
    simplenpcmsg("To be strong is to be weak.\n"
                 "To be weak is to be strong.\r"
                 "Somebody told me that before.\n"
                 "I don’t quite understand it yet,\f"
                 "but it sounds deep.\r"
                 "I’ll just give myself some time\n"
                 "to figure it out.")
    end
}

script BattleFrontier_EventScript_Roughneck {
    simplenpcmsg("Watching these people who care so much\n"
                 "about Pokémon makes me feel ashamed\f"
                 "of my selfishness.\r"
                 "I’ll try and face my Pokémon for real!")
    end
}

script BattleFrontier_EventScript_PokefanM1 {
    simplenpcmsg("I wonder how many years it’s been since\n"
                 "I first met a Pokémon? ...Forty-nine!\r"
                 "Oh, I lost the page that kept track of\n"
                 "how many years, days, and hours...\r"
                 "Could it be my Pokémon nibbling on it?")
    end
}

script BattleFrontier_EventScript_FatMan {
    simplenpcmsg("Trainers care about Pokémon\n"
                 "as the battle progresses.\r"
                 "In return, Pokémon repay that trust\n"
                 "by using moves the best they can.\r"
                 "What you see in a battle is the trust\n"
                 "between people and Pokémon.\r"
                 "This may seem obvious, but it’s actually\n"
                 "incredibly amazing!")
    end
}

script BattleFrontier_EventScript_Gentleman {
    simplenpcmsg("You cannot try anything if you are\n"
                 "afraid of losing battles.\r"
                 "But!\r"
                 "Getting into a battle knowing you have\n"
                 "no chance of winning will only make your\f"
                 "Pokémon suffer.\r"
                 "That’s not courage!\n"
                 "Truly good Trainers know the balance\f"
                 "between courage and cautiousness.")
    end
}

script BattleFrontier_EventScript_AceTrainerM {
    simplenpcmsg("If you want to graduate from being\n"
                 "a so-so Trainer, mark my words!\r"
                 "The Pokémon’s type!\r"
                 "The moves to be learned!\r"
                 "The items to be held!\r"
                 "You can’t overlook a single detail.")
    end
}

script BattleFrontier_EventScript_Picnicker {
    simplenpcmsg("When people win a battle, some laugh\n"
                 "at their opponent.\r"
                 "Some brag about his or her strengths.\r"
                 "Some even start to dance around \n"
                 "claiming he or she is number one\f"
                 "in the world.\r"
                 "I respect people who win and then\n"
                 "care about their opponent.")
    end
}

script BattleFrontier_EventScript_Woman3 {
    simplenpcmsg("Have you heard of the Brains of the\n"
                 "Battle Frontier?\r"
                 "There are five facilities in the\n"
                 "Battle Frontier.\r"
                 "At every one, you can win your way\n"
                 "through to challenge the bosses\f"
                 "called the Frontier Brains.\f"
                 "They’re out-of-this-world tough!")
    end
}

script BattleFrontier_EventScript_Man {
    simplenpcmsg("Allowing us to enjoy battles,\n"
                 "helping us work,\f"
                 "taking us to places far away,\f"
                 "or just being good friends...\r"
                 "Pokémon are so deep.\n"
                 "I wanna be like Pokémon.")
    end
}

script BattleFrontier_EventScript_SchoolKidM {
    simplenpcmsg("At the Battle Factory, you have to\n"
                 "keep winning with rental Pokémon.\r"
                 "I may not stand a chance at other\n"
                 "facilities, but I may go all the\f"
                 "way here!")
    end
}

script BattleFrontier_EventScript_Fisherman2 {
    simplenpcmsg("The Battle Hall is where Pokémon battle\n"
                 "one-on-one for as long as they can.\r"
                 "Even my MAGIKARP has a shot at\n"
                 "number one!\r"
                 "Wow!\r"
                 "Just the thought of it makes\n"
                 "me excited!")
    end
}

script BattleFrontier_EventScript_LittleBoy2 {
    simplenpcmsg("Life is full of ebbs and flows.\n"
                 "I’ll keep my inflatable tube close.\r"
                 "I could call it the wisdom I gained\n"
                 "in the last five years of my life.")
    end
}

