script scr_seq_D32_023 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    scratchoffcard
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

script BattleFrontier_EventScript_TrainerTips1 {
    trainertipsex(3, "Battle Tower\n"
                     "Never Lose! Keep Winning!")
    end
}

script BattleFrontier_EventScript_TrainerTips2 {
    trainertipsex(3, "Battle Hall\n"
                     "Let Each Pokémon Seek No. 1")
    end
}

script BattleFrontier_EventScript_TrainerTips3 {
    trainertipsex(3, "Battle Castle\n"
                     "Manage Battles with Castle Points")
    end
}

script BattleFrontier_EventScript_TrainerTips4 {
    trainertipsex(3, "Battle Arcade\n"
                     "Where Events Sway Outcomes")
    end
}

script BattleFrontier_EventScript_TrainerTips5 {
    trainertipsex(3, "Battle Factory\n"
                     "Win Consecutively with Rental Pokémon")
    end
}

script BattleFrontier_EventScript_Statue {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("A Trainer who just caught a Pokémon.\n"
           "That’s what this statue represents.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script BattleFrontier_EventScript_Sign1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("“Boastful of Capture”...\n"
           "That seems to be the title.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script BattleFrontier_EventScript_Sign2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("This...!\n"
           "A scale model of the Battle Frontier.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script BattleFrontier_EventScript_WarpToBattleFrontierBattleHall {
    followmonresetmovement
    lockall
    followmonrecall
    applymovement(obj_player, BattleFrontier_Movement_PlayerWalkLeft1)
    waitmovement
    playse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    warp(MAP_BATTLE_FRONTIER_BATTLE_HALL, 0, 25, 9, DIR_WEST)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

movement BattleFrontier_Movement_PlayerWalkLeft1 {
    walk_fast_left * 5
}

