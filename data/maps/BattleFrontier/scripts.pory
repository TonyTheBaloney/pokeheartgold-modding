movement BattleFrontier_Movement_0234 {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement BattleFrontier_Movement_024C {
    walk_up * 3
    walk_in_place_down
}

movement BattleFrontier_Movement_0258 {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement BattleFrontier_Movement_026C {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement BattleFrontier_Movement_0280 {
    delay_8
    walk_in_place_up
}

movement BattleFrontier_Movement_028C {
    walk_right
    walk_up
    face_down
}

