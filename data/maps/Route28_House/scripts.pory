// Script numbers, from 1, in this order (map.json and mapscripts use the labels).
scrdefs {
    Route28_House_EventScript_Lass
    Route28_House_EventScript_Fearow
    Route28_House_EventScript_LassScene
}

script Route28_House_EventScript_LassScene {
    applymovement(obj_R28R0101_gsgirl1, Route28_House_Movement_LassExclamation)
    waitmovement
    setvar(VAR_UNK_4126, 1)
    end
}

movement Route28_House_Movement_LassExclamation {
    face_down
    emote_exclamation_mark
}

script Route28_House_EventScript_Lass {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GOT_TM47_FROM_ROUTE_28_CELEBRITY)) {
        faceplayer
        getplayerfacing(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            applymovement(obj_R28R0101_gsgirl1, Route28_House_Movement_LassFaceUp)
        } elif (var(VAR_SPECIAL_RESULT) == 2) {
            applymovement(obj_R28R0101_gsgirl1, Route28_House_Movement_LassFaceLeft)
        } elif (var(VAR_SPECIAL_RESULT) == 3) {
            applymovement(obj_R28R0101_gsgirl1, Route28_House_Movement_LassFaceRight)
        } else {
            applymovement(obj_R28R0101_gsgirl1, Route28_House_Movement_LassFaceDown)
        }
        waitmovement
        npcmsg("Alas!\n"
               "You’ve found me...\r"
               "My peace and quiet to heal myself from\n"
               "the exhaustion of standing in the\f"
               "spotlight has been exposed!\r")
        if (var(VAR_SPECIAL_RESULT) == 0) {
            applymovement(obj_R28R0101_gsgirl1, Route28_House_Movement_LassFaceDown)
        } elif (var(VAR_SPECIAL_RESULT) == 2) {
            applymovement(obj_R28R0101_gsgirl1, Route28_House_Movement_LassFaceRight)
        } elif (var(VAR_SPECIAL_RESULT) == 3) {
            applymovement(obj_R28R0101_gsgirl1, Route28_House_Movement_LassFaceLeft)
        } else {
            applymovement(obj_R28R0101_gsgirl1, Route28_House_Movement_LassFaceUp)
        }
        waitmovement
        npcmsg("What? You are not the media?\n"
               "Then you must be one of my fans.\r"
               "Why didn’t you say so?\n"
               "Giggle...\r"
               "You can keep it to yourself that\n"
               "I’m here, right?\r"
               "I’ll give you this for that!\r")
        if (!itemspace(ITEM_TM47, 1)) {
            callstd(std_bag_is_full)
            closemessage
            releaseall
            end
        }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_TM47_FROM_ROUTE_28_CELEBRITY)
    }
    npcmsg("It contains Steel Wing!\r"
           "I remember I was wearing a dress\n"
           "inspired by this move on my\f"
           "debut stage...\r"
           "Alas...\n"
           "Being a legendary Idol is so demanding.\r"
           "I’ve been retired for some time, but\n"
           "people never stop chasing after me...\f"
           "like you!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Route28_House_Movement_LassFaceUp {
    delay_8
    walk_in_place_up
}

movement Route28_House_Movement_LassFaceLeft {
    delay_8
    walk_in_place_left
}

movement Route28_House_Movement_LassFaceRight {
    delay_8
    walk_in_place_right
}

movement Route28_House_Movement_LassFaceDown {
    delay_8
    walk_in_place_down
}

script Route28_House_EventScript_Fearow {
    playcry(SPECIES_FEAROW, 0)
    simplenpcmsg("FEAROW: Feero!")
    waitcry
    end
}

mapscripts Route28_House_MapScripts {
    INIT_SCRIPT_ON_FRAME_TABLE [
        VAR_UNK_4126, 0: Route28_House_EventScript_LassScene
    ]
}
