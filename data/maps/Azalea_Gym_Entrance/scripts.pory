script Azalea_Gym_Entrance_EventScript_GymGuide {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_HIVE, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Well done! That was a great clash\n"
               "of talented young Trainers.\r"
               "With people like you, the future of\n"
               "Pokémon is bright!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Yo, challenger!\n"
           "Bugsy made this Gym. It’s a huge nest\f"
           "of Bug-type Pokémon.\r"
           "Bugsy’s young, but he’s a master of\n"
           "Bug-type Pokémon!\r"
           "It’s going to be tough without\n"
           "my advice.\r"
           "Let’s see... Bug-type Pokémon don’t\n"
           "like fire.\r"
           "Flying-type moves are\n"
           "super effective, too.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Azalea_Gym_Entrance_EventScript_GymSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_HIVE, VAR_SPECIAL_RESULT)
    bufferplayersname(0)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Azalea Town Pokémon Gym")
    } else {
        npcmsg("Azalea Town Pokémon Gym\r"
               "Leader: Bugsy\n"
               "Certified Trainer!\f"
               "{STRVAR_1 3, 0, 0}")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

