script Route10_PowerPlantRepaired_EventScript_SuperNerd4 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_TRADE_POWER_PLANT_DUGTRIO_MAGNETON)) {
        npcmsg("Hi, how’s my old MAGNETON doing?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("I collect Pokémon.\n"
           "Do you have a DUGTRIO?\r"
           "Want to trade it for my MAGNETON? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0134) }
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    choosepartymonfortrade
    getpartyselection(VAR_SPECIAL_RESULT)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_RESULT) == 255) { goto(_0134) }
    loadnpctrade(8)
    copyvar(VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT)
    getpartymonspecies(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    npctradegetreqspecies(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_x8005) != VAR_SPECIAL_RESULT) { goto(_0127) }
    npctradeexec(VAR_SPECIAL_x8004)
    npctradeend
    setflag(FLAG_TRADE_POWER_PLANT_DUGTRIO_MAGNETON)
    npcmsg("Yay! I got myself a DUGTRIO!\n"
           "Thanks!")
    waitbuttonpress
    closemessage
    releaseall
    end
_0127:
    npctradeend
    npcmsg("Huh? That’s not DUGTRIO.\n"
           "What a letdown...")
    waitbuttonpress
    closemessage
    releaseall
    end
_0134:
    npcmsg("You don’t want to trade? Aww...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

