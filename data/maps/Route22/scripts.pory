    applymovement(obj_R22_var_1, Route22_Movement_PlayerFaceDown)
    waitmovement
    applymovement(obj_R22_gsrivel, Route22_Movement_RivalWalkRightDown2)
    applymovement(obj_player, Route22_Movement_PlayerFaceDown)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    removeobject(obj_R22_sakaki)
    removeobject(obj_R22_gsrivel)
    setflag(FLAG_HIDE_ROUTE_22_GIOVANNI_RIVAL)
    callstd(std_fade_end_rival_intro_music)
    gendermsgbox("Lyra: Who does he think he is?\n"
                 "That was unnecessary!\r"
                 "But what were they talking about?\n"
                 "The revival of {COLOR 1}Team Rocket{COLOR 0}...?\r"
                 "They say that Team Rocket was\n"
                 "removed from the Kanto region\f"
                 "by a child three years ago.\r"
                 "So this really is three years ago!\r", "Ethan: Who does he think he is?\n"
                                                         "That was unnecessary!\r"
                                                         "But what were they talking about?\n"
                                                         "The revival of {COLOR 1}Team Rocket{COLOR 0}...?\r"
                                                         "They say that Team Rocket was\n"
                                                         "removed from the Kanto region\f"
                                                         "by a child three years ago.\r"
                                                         "So this really is three years ago!\r")
    closemessage
    fadeoutbgm(20, 30)
    applymovement(obj_partner_poke, Route22_Movement_FollowMonJumpDown)
    waitmovement
    playse(SEQ_SE_GS_SUZUSYUTUGEN_HO)
