    fadeoutbgm(0, 30)
    applymovement(obj_R22_gsrivel, Route22_Movement_RivalWalkLeft)
    waitmovement
    bufferrivalsname(0)
    npcmsg("{STRVAR_1 3, 0, 0}: You told me...\n"
