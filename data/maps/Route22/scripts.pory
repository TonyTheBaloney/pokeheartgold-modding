    walk_down
}

movement Route22_Movement_FriendWalkDown2 {
    walk_down
    walk_in_place_right
}

movement Route22_Movement_FriendWalkUpLeft {
    walk_up * 2
    walk_left * 2
    walk_up
}

movement Route22_Movement_FriendSpin {
    walk_in_place_left
    delay_16
    walk_in_place_right
    delay_16
    walk_in_place_down
}

movement Route22_Movement_FriendWalkUpRight {
    emote_exclamation_mark
    delay_8
    walk_up * 2
    walk_right
    walk_up * 2
}

movement Route22_Movement_FollowMonJumpDown {
    face_down
    jump_far_down
    lock_dir
    jump_near_fast_up
    lock_dir
}

movement Route22_Movement_0368 {
    lock_dir
    walk_fast_right * 2
    unlock_dir
    face_left
}

