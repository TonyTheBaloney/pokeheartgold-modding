script Route22_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        if (var(VAR_UNK_40FE) == 1) {
            setflag(FLAG_HIDE_CAMERON)
            end
        }
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 4) { goto(_0058) }
        if (var(VAR_TEMP_x4000) == 0) { goto(_0058) }
        setflag(FLAG_HIDE_CAMERON)
        end
    _0058:
        clearflag(FLAG_HIDE_CAMERON)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script Route22_OnResume {
    if (var(VAR_UNK_40FE) == 1) {
        movepersonfacing(obj_R22_sakaki, 947, 1, 266, DIR_WEST)
        movepersonfacing(obj_R22_gsrivel, 950, 1, 266, DIR_WEST)
        movepersonfacing(obj_R22_var_1, 952, 1, 280, DIR_EAST)
        end
    }
    end
}

