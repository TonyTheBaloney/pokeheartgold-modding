    applymovement(obj_player, Route22_Movement_PlayerExclamation)
    applymovement(obj_R22_var_1, Route22_Movement_FriendSpin)
    waitmovement
    gendermsgbox("Oh no! It’s happening again...!\r"
                 "It’s CELEBI’s {COLOR 1}Time Travel{COLOR 0}!\r", "Oh no! It’s happening again...!\r"
                                                                   "It’s CELEBI’s {COLOR 1}Time Travel{COLOR 0}!\r")
    closemessage
    playse(SEQ_SE_GS_TIMESLIP)
