}

movement Route22_Movement_FriendExclamation {
    emote_exclamation_mark
    delay_8
    walk_in_place_right
    delay_16
}

movement Route22_Movement_FriendWalkUp {
    walk_fast_up * 2
    delay_8
    walk_in_place_left
    delay_16
    walk_in_place_right
    delay_16
}

