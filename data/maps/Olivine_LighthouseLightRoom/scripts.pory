               "Palulu!")
        waitcry
    } else {
        playcry(SPECIES_AMPHAROS, 12)
        npcmsg("Amphy: ...\n"
               "...Pa...paloo...\r")
        waitcry
        npcmsg("Its breathing is slight...")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

