script scr_seq_D27R0107_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_LIGHTHOUSE_JASMINE) >= 2) {
        playcry(SPECIES_AMPHAROS, 0)
