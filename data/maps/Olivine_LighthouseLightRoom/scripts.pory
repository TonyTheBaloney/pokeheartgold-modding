script Olivine_LighthouseLightRoom_EventScript_Jasmine {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_SECRETPOTION)) {
        npcmsg("Jasmine: ...Will that medicine cure\n"
               "Amphy? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Jasmine: ...I see...\r")
            closemessage
            applymovement(obj_D27R0107_gsleader6, Olivine_LighthouseLightRoom_Movement_JasmineFaceRight)
            waitmovement
            npcmsg("...Amphy, hang on!\r")
            closemessage
            playcry(SPECIES_AMPHAROS, 12)
            waitcry
            releaseall
            end
        }
        takeitem(ITEM_SECRETPOTION, 1, VAR_SPECIAL_RESULT)
        bufferplayersname(0)
        npcmsg("{STRVAR_1 3, 0, 0} handed the SecretPotion\n"
               "to Jasmine.")
        playfanfare(SEQ_ME_ITEM)
        waitfanfare
        npcmsg("Jasmine: ...Um, please don’t be\n"
               "offended...\r"
               "Amphy will not take anything from\n"
               "anyone but me...\r")
        closemessage
        applymovement(obj_D27R0107_gsleader6, Olivine_LighthouseLightRoom_Movement_JasmineFaceRight)
        waitmovement
        npcmsg("Jasmine: ...\r"
               "Amphy, how are you feeling?\r")
        closemessage
        applymovement(obj_D27R0107_tsure_poke_static_ampharos, Olivine_LighthouseLightRoom_Movement_AmphyFaceLeft1)
        waitmovement
        playcry(SPECIES_AMPHAROS, 0)
        npcmsg("Amphy: Palu!\n"
               "Palulu!\r")
        waitcry
        closemessage
        lighthouselightup
        applymovement(obj_D27R0107_tsure_poke_static_ampharos, Olivine_LighthouseLightRoom_Movement_AmphyFaceLeft2)
        waitmovement
        playcry(SPECIES_AMPHAROS, 0)
        waitcry
        npcmsg("Jasmine: ...Oh, I’m so relieved...\n"
               "This is just so wonderful...\r"
               "Thank you so very, very much.\n"
               "...I will return to the Gym...\r")
        closemessage
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(56)
        applymovement(obj_player, Olivine_LighthouseLightRoom_Movement_PlayerWalkDown)
        applymovement(obj_D27R0107_gsleader6, Olivine_LighthouseLightRoom_Movement_JasmineWalkDownRight2)
        waitmovement
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
        removeobject(obj_D27R0107_gsleader6)
        releaseall
        setflag(FLAG_UNK_96A)
        setvar(VAR_SCENE_LIGHTHOUSE_JASMINE, 2)
        setvar(VAR_UNK_410E, 1)
        setflag(FLAG_UNK_1D7)
        clearflag(FLAG_HIDE_JASMINE_IN_GYM)
        setflag(FLAG_UNK_1DA)
        setflag(FLAG_UNK_1DB)
        clearflag(FLAG_HIDE_OLIVINE_GYM_GENTLEMAN)
        clearflag(FLAG_HIDE_OLIVINE_GYM_GIRL)
        setflag(FLAG_UNK_998)
        end
    }
    if (var(VAR_SCENE_LIGHTHOUSE_JASMINE) == 0) { goto(_0062) }
    npcmsg("...May I ask you to get some medicine\n"
           "for me? Please?\r")
    closemessage
    applymovement(obj_D27R0107_gsleader6, Olivine_LighthouseLightRoom_Movement_JasmineFaceRight)
    waitmovement
    releaseall
    end
_0062:
    npcmsg("Jasmine: ...This Pokémon always kept\n"
           "the sea lit at night.\r"
           "...But it suddenly got sick...\n"
           "It’s gasping for air...\r"
           "...I understand that there is a\n"
           "wonderful Pharmacy in Cianwood...\r"
           "But that’s across the sea...\n"
           "And I can’t leave Amphy unattended...\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(56)
    applymovement(obj_player, Olivine_LighthouseLightRoom_Movement_PlayerWalkRight)
    applymovement(obj_D27R0107_gsleader6, Olivine_LighthouseLightRoom_Movement_JasmineWalkDownRight1)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    playse(SEQ_SE_DP_DOOR)
    removeobject(obj_D27R0107_stop)
    removeobject(obj_D27R0107_babyboy1_8)
    waitse(SEQ_SE_DP_DOOR)
    applymovement(obj_D27R0107_gsleader6, Olivine_LighthouseLightRoom_Movement_JasmineWalkLeftUp)
    waitmovement
    releaseall
    setvar(VAR_SCENE_LIGHTHOUSE_JASMINE, 1)
    setflag(FLAG_UNK_1D8)
    end
}

movement Olivine_LighthouseLightRoom_Movement_AmphyFaceLeft1 {
    walk_in_place_slow_left
}

movement Olivine_LighthouseLightRoom_Movement_AmphyFaceLeft2 {
    jump_in_place_fast_left * 3
}

movement Olivine_LighthouseLightRoom_Movement_JasmineFaceRight {
    walk_in_place_slow_right
}

movement Olivine_LighthouseLightRoom_Movement_JasmineWalkDownRight1 {
    delay_8
    walk_down * 3
    walk_right
    walk_in_place_down
    delay_16
}

movement Olivine_LighthouseLightRoom_Movement_PlayerWalkRight {
    face_left
    lock_dir
    walk_right
    unlock_dir
    delay_8 * 3
    delay_4
    walk_in_place_down
}

movement Olivine_LighthouseLightRoom_Movement_JasmineWalkLeftUp {
    walk_left
    walk_up * 3
    walk_in_place_right
}

movement Olivine_LighthouseLightRoom_Movement_JasmineWalkDownRight2 {
    delay_8
    walk_down
    walk_right * 2
    walk_in_place_down
    walk_down
}

movement Olivine_LighthouseLightRoom_Movement_PlayerWalkDown {
    face_up
    lock_dir
    walk_down
    unlock_dir
    delay_8 * 2
    delay_4
    walk_in_place_right
}

movement Olivine_LighthouseLightRoom_Movement_0238 {
    walk_slow_left * 2
}

script Olivine_LighthouseLightRoom_EventScript_Amphy {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_LIGHTHOUSE_JASMINE) >= 2) {
        playcry(SPECIES_AMPHAROS, 0)
        npcmsg("Amphy: Palu!\n"
               "Palulu!")
        waitcry
    } else {
        playcry(SPECIES_AMPHAROS, 12)
        npcmsg("Amphy: ...\n"
               "...Pa...paloo...\r")
        waitcry
        npcmsg("Its breathing is slight...")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

