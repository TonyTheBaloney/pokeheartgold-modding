script scr_seq_T25_018 {
    setflag(FLAG_HIDE_ROCKET_TAKEOVER_3)
    setflag(FLAG_HIDE_ROCKET_TAKEOVER_4)
    setflag(FLAG_HIDE_ROCKET_TAKEOVER_1)
    setflag(FLAG_HIDE_ROCKET_TAKEOVER_5)
    setflag(FLAG_HIDE_ROCKET_TAKEOVER_2)
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 0) {
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_2)
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_3)
    } elif (var(VAR_SCENE_ROCKET_TAKEOVER) == 1) {
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_2)
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_3)
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_4)
    } elif (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_3)
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_4)
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_1)
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_5)
    } elif (var(VAR_SCENE_ROCKET_TAKEOVER) == 5) {
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_2)
    } else {
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_3)
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_4)
        clearflag(FLAG_HIDE_ROCKET_TAKEOVER_1)
    }
    end
}

script scr_seq_T25_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_40DA) == 1) {
        if (var(VAR_UNK_40DB) == 0) {
            npcmsg("I think I’ll give my Pokémon cool\n"
                   "nicknames as a reward if they do\f"
                   "well in the Pokéathlon.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
    }
    npcmsg("The man at that tent rates your\n"
           "Pokémon names.\r"
           "He can even rename your Pokémon.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) < 2) {
        npcmsg("Is that man in black dressed up\n"
               "like a Team Rocket member?\f"
               "How silly!")
    } else {
        npcmsg("Was that man in black really part\n"
               "of Team Rocket?\f"
               "I can’t believe it!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_002 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_RADIO_CARD)) {
        npcmsg("The Radio Tower in Goldenrod City is\n"
               "a landmark.\r"
               "They’re running a promotional campaign\n"
               "right now.\r"
               "They’ll modify your Pokégear so it can\n"
               "also serve as a radio.\r"
               "Oh, your Pokégear works as a radio!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("The Radio Tower in Goldenrod City is\n"
           "a landmark.\r"
           "They’re running a promotional campaign\n"
           "right now.\r"
           "They’ll modify your Pokégear so it can\n"
           "also serve as a radio.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_003 {
    simplenpcmsg("E-he-he-he...\n"
                 "I got in trouble for playing in the\f"
                 "basement of the department store.")
    end
}

script scr_seq_T25_004 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playeronbikecheck(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("The fact that you have a Bike...\n"
               "means you got it from a Bike Shop,\f"
               "right?\r"
               "All right!\n"
               "I can say that there is a Bike Shop\f"
               "somewhere in this city!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("I know there’s a new Bike Shop,\n"
           "but I can’t find it anywhere.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_005 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_40DA) == 1) {
        if (var(VAR_UNK_40DB) == 0) {
            npcmsg("Have you visited the Pokéathlon Dome?\n"
                   "It is a huge sports facility where\f"
                   "Pokémon compete with each other.\r"
                   "It was quite a sight!")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
    }
    npcmsg("They built the new Radio Tower to\n"
           "replace the old, creaky one.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_006 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_40DA) == 1) {
        if (var(VAR_UNK_40DB) == 0) {
            npcmsg("I know that you can find the\n"
                   "Pokéathlon Dome when you take\f"
                   "Route 35 north and go past the\f"
                   "left gate...\r"
                   "But I seem to get lost every time\n"
                   "I come to this town...")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
    }
    npcmsg("Whew! This is one big town.\n"
           "I don’t know where anything is.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_007 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("So this is the Radio Tower...\r")
    closemessage
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_T25_rocketm, Goldenrod_Movement_02F8)
        waitmovement
    } elif (var(VAR_SPECIAL_RESULT) == 2) {
        applymovement(obj_T25_rocketm, Goldenrod_Movement_0308)
        waitmovement
    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_T25_rocketm, Goldenrod_Movement_0300)
        waitmovement
    }
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("What are you doing?\n"
               "Get to your position right away!\r")
    } else {
        npcmsg("What do you want, you pest?\n"
               "Scram!\r")
    }
    closemessage
    if (var(VAR_TEMP_x4001) != 350) {
        applymovement(obj_T25_rocketm, Goldenrod_Movement_02F0)
        waitmovement
    }
    releaseall
    end
}

movement Goldenrod_Movement_02F0 {
    walk_in_place_up
}

movement Goldenrod_Movement_02F8 {
    walk_in_place_down
}

movement Goldenrod_Movement_0300 {
    walk_in_place_left
}

movement Goldenrod_Movement_0308 {
    walk_in_place_right
}

script scr_seq_T25_008 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("We are on guard here.\n"
               "Don’t you worry!")
    } else {
        npcmsg("Pokémon? They’re nothing more than\n"
               "tools for making money!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_009 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("You look awfully young...\n"
               "Are you new?")
    } else {
        npcmsg("Take over the Radio Tower...\r"
               "What? It’s none of your business!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_010 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("Hey, hey!\n"
               "I’ve got this covered!\r"
               "Why don’t you go to the Radio Tower?")
    } else {
        npcmsg("Hey, brat! You don’t belong here!\f"
               "Get lost!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_011 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("Our dream will soon come true...\n"
               "It was such a long struggle...")
    } else {
        npcmsg("Friendship with Pokémon?\r"
               "That makes me laugh!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_012 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("For a young one like you to decide\n"
               "to become a member of Team Rocket...\f"
               "That’s great, kiddo!")
    } else {
        npcmsg("Who are you? A newcomer?\r"
               "We’ve run out of Team Rocket\n"
               "uniforms.\r"
               "One of my guys is going to get more...\r"
               "What’s taking him so long?\r"
               "The studio in the tunnel is just around\n"
               "the corner.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_013 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("You don’t appear scary enough to be a\n"
               "Team Rocket member in that uniform...\f"
               "Make a scarier face and say, “Yeee!”\r"
               "All the while, clenching your teeth!")
    } else {
        npcmsg("Wh-what are you trying to do?\n"
               "Can’t you see this cool, pitch-black\f"
               "uniform I’m wearing?\r"
               "You’re not afraid of Team Rocket? Huh?")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_030 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("Get out of my way!\r"
           "We, as Gym Trainers, will never allow\n"
           "Team Rocket to do nasty things here\f"
           "in our city!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_032 {
    simplenpcmsg("The Gym Leader, Whitney, went flying by\n"
                 "saying, “I have got to\f"
                 "get a Radio Card!”")
    end
}

script scr_seq_T25_031 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("Tee hee!\r"
           "You Gym Trainers can be a problem.\n"
           "Stay in the Gym and stay out of\f"
           "the way!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_014 {
    simplenpcmsg("Where do you think you’re going?\n"
                 "We are right in the middle of\f"
                 "the mission!")
    end
}

script scr_seq_T25_015 {
    simplenpcmsg("Where do you think you are going?\n"
                 "The Radio Tower is not here!")
    end
}

script scr_seq_T25_016 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("If you love to trade so much, wait until\n"
               "the Radio Tower mission is over.\r"
               "Then you’ll have plenty of time!")
    } else {
        npcmsg("The GTS lets you trade Pokémon\n"
               "all over the world!\r"
               "...Except that we have something\n"
               "more important to do right now!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25_017 {
    followmonresetmovement
    lockall
    applymovement(obj_T25_rocketm_9, Goldenrod_Movement_06E4)
    waitmovement
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 354) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_06EC)
    } elif (var(VAR_TEMP_x4000) == 355) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_06F4)
