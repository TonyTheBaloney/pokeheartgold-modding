    } elif (var(VAR_TEMP_x4000) == 359) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_07A4)
    } elif (var(VAR_TEMP_x4000) == 360) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_07B0)
    } elif (var(VAR_TEMP_x4000) == 361) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_07C0)
    } elif (var(VAR_TEMP_x4000) == 362) {
