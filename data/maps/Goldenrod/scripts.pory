    } elif (var(VAR_TEMP_x4000) == 363) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_0734)
    }
    waitmovement
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(56)
    applymovement(obj_T25_rocketm_9, Goldenrod_Movement_073C)
    applymovement(obj_player, Goldenrod_Movement_0744)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("Slow down!\r"
           "I’m the only one who was sent here.\f"
           "Don’t give me any more trouble, OK?\r")
    closemessage
    if (var(VAR_TEMP_x4000) == 354) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_0754)
    } elif (var(VAR_TEMP_x4000) == 355) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_0764)
    } elif (var(VAR_TEMP_x4000) == 356) {
