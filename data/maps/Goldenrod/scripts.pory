}

script Goldenrod_EventScript_RocketGrunt4 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("Hey, hey!\n"
