script Goldenrod_EventScript_RocketGrunt10 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("If you love to trade so much, wait until\n"
               "the Radio Tower mission is over.\r"
               "Then you’ll have plenty of time!")
    } else {
        npcmsg("The GTS lets you trade Pokémon\n"
               "all over the world!\r"
               "...Except that we have something\n"
               "more important to do right now!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Goldenrod_EventScript_RocketGruntTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntExclamation)
    waitmovement
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 354) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkLeft1)
    } elif (var(VAR_TEMP_x4000) == 355) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkLeft2)
    } elif (var(VAR_TEMP_x4000) == 356) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkLeft3)
    } elif (var(VAR_TEMP_x4000) == 357) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkLeft4)
    } elif (var(VAR_TEMP_x4000) == 358) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkLeft5)
    } elif (var(VAR_TEMP_x4000) == 359) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntDelay)
    } elif (var(VAR_TEMP_x4000) == 360) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkRight1)
    } elif (var(VAR_TEMP_x4000) == 361) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkRight2)
    } elif (var(VAR_TEMP_x4000) == 362) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkRight3)
    } elif (var(VAR_TEMP_x4000) == 363) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkRight4)
    }
    waitmovement
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(56)
    applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkUp)
    applymovement(obj_player, Goldenrod_Movement_PlayerWalkUp)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("Slow down!\r"
           "I’m the only one who was sent here.\f"
           "Don’t give me any more trouble, OK?\r")
    closemessage
    if (var(VAR_TEMP_x4000) == 354) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkDownRight1)
    } elif (var(VAR_TEMP_x4000) == 355) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkDownRight2)
    } elif (var(VAR_TEMP_x4000) == 356) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkDownRight3)
    } elif (var(VAR_TEMP_x4000) == 357) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkDownRight4)
    } elif (var(VAR_TEMP_x4000) == 358) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkDownRight5)
    } elif (var(VAR_TEMP_x4000) == 359) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkDown)
    } elif (var(VAR_TEMP_x4000) == 360) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkDownLeft1)
    } elif (var(VAR_TEMP_x4000) == 361) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkDownLeft2)
    } elif (var(VAR_TEMP_x4000) == 362) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkDownLeft3)
    } elif (var(VAR_TEMP_x4000) == 363) {
        applymovement(obj_T25_rocketm_9, Goldenrod_Movement_RocketGruntWalkDownLeft4)
    }
    waitmovement
    releaseall
    end
}

