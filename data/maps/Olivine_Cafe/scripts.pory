script Olivine_Cafe_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 5) {
            setflag(FLAG_HIDE_CAMERON)
        } else {
            setflag(FLAG_HIDE_CAMERON)
        }
        if (!flag(FLAG_GAME_CLEAR)) { goto(_00C3) }
        checkregisteredphonenumber(PHONE_CONTACT_JASMINE, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) == 1) {
            getphonebookrematch(PHONE_CONTACT_JASMINE, VAR_TEMP_x4001)
            if (var(VAR_TEMP_x4001) != 0) { goto(_00C3) }
            getcurrenthour(VAR_TEMP_x4000)
            if (var(VAR_TEMP_x4000) == 12) {
                clearflag(FLAG_UNK_2CB)
            } else {
                setflag(FLAG_UNK_2CB)
            }
            end
        _00C3:
            setflag(FLAG_UNK_2CB)
            end
        }
        getcurrenthour(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 13) {
            clearflag(FLAG_UNK_2CB)
        } else {
            goto(_00C3)
        }
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script Olivine_Cafe_EventScript_Sailor3 {
    simplenpcmsg("You!\n"
                 "How is your Pokémon training\f"
                 "coming along?\r"
                 "Have you ever noticed that in the\n"
                 "mountains, sometimes there are round\f"
                 "boulders right in your way...?\r"
                 "You can move them with the\n"
                 "hidden move Strength!\r"
                 "Hikers at Mt. Mortar sometimes have\n"
                 "extra, or so I’ve heard...")
    end
}

script Olivine_Cafe_EventScript_Sailor1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("Gobble...gobble...\r"
           "...Choke!\n"
           "Ack... I’m choking!\r"
           "Whew! That was close.\n"
           "I should chew before I swallow my food.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Olivine_Cafe_EventScript_Sailor2 {
    simplenpcmsg("Whenever I roll into Olivine, I always\n"
                 "visit the Olivine Café.\r"
                 "Everything on the menu makes me feel\n"
                 "stronger. I can’t stop eating!")
    end
}

script Olivine_Cafe_EventScript_Fisherman {
    simplenpcmsg("Olivine Café’s menu is chock-full\n"
                 "of hearty fare for beefy Sailors!")
    end
}

