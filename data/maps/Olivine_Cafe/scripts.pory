    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, Olivine_Cafe_Movement_PlayerWalkUp)
    } else {
        applymovement(obj_player, Olivine_Cafe_Movement_PlayerWalkUpLeft)
        applymovement(obj_T26R0701_gsmiddleman1, Olivine_Cafe_Movement_PokefanMFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, Olivine_Cafe_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(25)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
    getplayerfacing(VAR_SPECIAL_RESULT)
    comparevartovalue(VAR_SPECIAL_RESULT, 0)
    gotoifne(_0237)
    applymovement(obj_player, Olivine_Cafe_Movement_PlayerWalkRightUp)
    goto(_025A)
_0237:
    comparevartovalue(VAR_SPECIAL_RESULT, 1)
    gotoifne(_0252)
    applymovement(obj_player, Olivine_Cafe_Movement_PlayerWalkUp)
    goto(_025A)
_0252:
    applymovement(obj_player, Olivine_Cafe_Movement_PlayerWalkUpLeft)
_025A:
    waitmovement
    return
}

movement Olivine_Cafe_Movement_PlayerWalkRightUp {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Olivine_Cafe_Movement_PlayerWalkUp {
    walk_up * 3
    walk_in_place_down
}

movement Olivine_Cafe_Movement_PlayerWalkUpLeft {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Olivine_Cafe_Movement_PokefanMFaceUp {
    delay_8
    walk_in_place_up
}

movement Olivine_Cafe_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

script Olivine_Cafe_EventScript_Jasmine {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkregisteredphonenumber(PHONE_CONTACT_JASMINE, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) {
        npcmsg("Jasmine: We seem to...bump into each\n"
               "other often.\r"
               "Why don’t we take a picture\n"
               "to make this a memory? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Jasmine: I see...")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        photoalbumisfull(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Your Photo Album is full.\r"
                   "Access your PC to delete\n"
                   "some pictures.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Jasmine: Are you ready?\r")
        closemessage
        setflag(FLAG_UNK_189)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        cameronphoto(89)
        faceplayer
        lockall
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        clearflag(FLAG_UNK_189)
        npcmsg("Jasmine: You did a fine job.\n"
               "We look good.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_TEMP_x4004) >= 1) { goto(_037F) }
    npcmsg("Jasmine: Hi!\n"
           "...!\r"
           "These empty dishes in front of me\n"
           "are not all mine...\r"
           "Er...\r"
           "Actually, the person who sat here\n"
           "ahead of me ate a lot...\r"
           "Anyway, do you want to exchange\n"
           "phone numbers? {YESNO 0}")
_0307:
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_032B) }
    if (var(VAR_SPECIAL_RESULT) >= 1) { goto(_036E) }
    end
_032B:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} registered Jasmine\n"
           "in the Pokégear!")
    playfanfare(SEQ_ME_POKEGEAR_REGIST)
    waitfanfare
    registergearnumber(PHONE_CONTACT_JASMINE)
    npcmsg("Jasmine: Now we can contact each\n"
           "other anytime.\r"
           "I should be able to battle you around\n"
           "noon on Wednesdays.\f"
           "I’ll be waiting for your call!")
    waitbuttonpress
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setflag(FLAG_UNK_2CB)
    removeobject(obj_T26R0701_gsleader6)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
_036E:
    setvar(VAR_TEMP_x4004, 1)
    npcmsg("Jasmine: Oh... I understand...")
    waitbuttonpress
    closemessage
    releaseall
    end
_037F:
    npcmsg("Jasmine: Did you change your mind?\n"
           "Will you exchange numbers? {YESNO 0}")
    goto(_0307)
    end
}

