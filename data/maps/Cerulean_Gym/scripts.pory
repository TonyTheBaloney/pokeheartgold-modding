script Cerulean_Gym_OnTransition {
    getphonebookrematch(PHONE_CONTACT_MISTY, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 0) {
        setflag(FLAG_HIDE_CERULEAN_GYM_POPULATION)
        end
    }
    checkbadge(BADGE_EARTH, VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 0) { goto(_00E5) }
    if (var(VAR_SCENE_ROUTE_25) == 1) { goto(_00E7) }
    if (var(VAR_SCENE_ROUTE_25) == 2) { goto(_00E7) }
    checkregisteredphonenumber(PHONE_CONTACT_MISTY, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) { goto(_00AD) }
    getcurrenthour(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 16) {
        setflag(FLAG_HIDE_CERULEAN_GYM_POPULATION)
    } elif (var(VAR_TEMP_x4000) == 17) {
        setflag(FLAG_HIDE_CERULEAN_GYM_POPULATION)
    } else {
        clearflag(FLAG_HIDE_CERULEAN_GYM_POPULATION)
    }
    end
_00AD:
    getcurrenthour(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 14) {
        setflag(FLAG_HIDE_CERULEAN_GYM_POPULATION)
    } elif (var(VAR_TEMP_x4000) == 15) {
        setflag(FLAG_HIDE_CERULEAN_GYM_POPULATION)
    } else {
        clearflag(FLAG_HIDE_CERULEAN_GYM_POPULATION)
    }
    end
_00E5:
    end
_00E7:
    clearflag(FLAG_HIDE_CERULEAN_GYM_POPULATION)
    end
}

script Cerulean_Gym_EventScript_RocketGruntScene {
    followmonresetmovement
    lockall
    stopbgm(SEQ_GS_GYM)
    playbgm(SEQ_GS_EYE_ROCKET)
    applymovement(obj_T04GYM0101_rocketm, Cerulean_Gym_Movement_RocketGruntWalkDown1)
    waitmovement
    playse(SEQ_SE_DP_WALL_HIT2)
    npcmsg("{SIZE 200}Bump!{SIZE 100}\r")
    applymovement(obj_T04GYM0101_rocketm, Cerulean_Gym_Movement_RocketGruntWalkDown2)
    waitmovement
    npcmsg("Oops! I so sorry!\n"
           "You not hurt, OK?\f"
           "I very busy.\f"
           "No time for talking with you.\f"
           "Not good for me if seen by somebody.\r")
    applymovement(obj_T04GYM0101_rocketm, Cerulean_Gym_Movement_RocketGruntWalkUp)
    waitmovement
    npcmsg("Oh no! You seen me already!\f"
           "I make big mistake!\r")
    applymovement(obj_T04GYM0101_rocketm, Cerulean_Gym_Movement_RocketGruntWalkDown3)
    waitmovement
    npcmsg("Hey, you! Forget you see me, OK?\n"
           "You seen, heard, known nothing, OK?\f"
           "Bye!\f"
           "Bye-bye a go-go!\r")
    closemessage
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_T04GYM0101_rocketm, Cerulean_Gym_Movement_RocketGruntWalkDown4)
        applymovement(obj_player, Cerulean_Gym_Movement_PlayerWalkLeft)
        waitmovement
    _018B:
        playse(SEQ_SE_DP_KAIDAN2)
        removeobject(obj_T04GYM0101_rocketm)
        waitse(SEQ_SE_DP_KAIDAN2)
        stopbgm(SEQ_GS_EYE_ROCKET)
        playbgm(SEQ_GS_GYM)
        setflag(FLAG_HIDE_CERULEAN_GYM_ROCKET)
        clearflag(FLAG_HIDE_ROUTE_24_ROCKET)
        clearflag(FLAG_HIDE_ROUTE_25_MISTY)
        clearflag(FLAG_HIDE_ROUTE_25_MISTYS_BOYFRIEND)
        setvar(VAR_UNK_411C, 2)
        setvar(VAR_SCENE_ROUTE_24_ROCKET, 1)
        setvar(VAR_UNK_4088, 1)
        releaseall
        end
    }
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0159) }
    end
_0159:
    applymovement(obj_T04GYM0101_rocketm, Cerulean_Gym_Movement_RocketGruntWalkDown4)
    applymovement(obj_player, Cerulean_Gym_Movement_PlayerWalkLeft)
    applymovement(obj_partner_poke, Cerulean_Gym_Movement_FollowMonWalkLeft)
    waitmovement
    goto(_018B)
}

movement Cerulean_Gym_Movement_RocketGruntWalkDown1 {
    walk_faster_down * 5
}

movement Cerulean_Gym_Movement_RocketGruntWalkDown2 {
    lock_dir
    jump_far_up
    delay_8 * 2
    walk_fast_down * 2
}

movement Cerulean_Gym_Movement_RocketGruntWalkUp {
    emote_exclamation_mark
    lock_dir
    walk_up * 2
}

movement Cerulean_Gym_Movement_RocketGruntWalkDown3 {
    walk_down * 2
}

movement Cerulean_Gym_Movement_RocketGruntWalkDown4 {
    walk_fast_down
}

movement Cerulean_Gym_Movement_PlayerWalkLeft {
    walk_fast_left
    face_right
}

movement Cerulean_Gym_Movement_FollowMonWalkLeft {
    walk_fast_left
}

script Cerulean_Gym_OnLoad {
    setflag99a
    if (flag(FLAG_HIDE_CERULEAN_GYM_MACHINE_PART)) {
        end
    }
    makeobjectvisible(obj_T04GYM0101_stop)
    makeobjectvisible(obj_T04GYM0101_stop_2)
    end
}

script Cerulean_Gym_EventScript_InvisibleObject {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    bufferplayersname(0)
    npcmsg("...!\r"
           "{STRVAR_1 3, 0, 0} picked up the black item\n"
           "that was by the pool.\r"
           "It’s a Part from a machine!\r")
    if (!itemspace(ITEM_MACHINE_PART, 1)) {
        callstd(std_bag_is_full)
        closemessage
        releaseall
        end
    }
    callstd(std_obtain_item_verbose)
    removeobject(obj_T04GYM0101_stop)
    removeobject(obj_T04GYM0101_stop_2)
    setflag(FLAG_HIDE_CERULEAN_GYM_MACHINE_PART)
    setvar(VAR_SCENE_ROUTE_24_ROCKET, 4)
    closemessage
    releaseall
    end
}

script Cerulean_Gym_EventScript_Misty {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_CASCADE, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        if (!flag(FLAG_GOT_TM03_FROM_MISTY)) { goto(_0307) }
        npcmsg("Misty: Does Johto have a lot of\n"
               "powerful Trainers?\r"
               "I will someday go on my journey\n"
               "to battle with powerful Trainers!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Misty: I was expecting you,\n"
           "you pest!\r"
           "You may have a lot of Johto Gym Badges,\n"
           "but you’d better not take me\f"
           "too lightly.\r"
           "My Water-type Pokémon are tough!\r")
    closemessage
    trainerbattle(TRAINER_LEADER_MISTY_MISTY, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    _0364:
        clearflag(FLAG_HIDE_ROUTE_25_SUICUNE)
        setvar(VAR_SCENE_ROUTE_25, 1)
        return
    }
    givebadge(BADGE_CASCADE)
    addvar(VAR_UNK_4135, 1)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    settrainerflag(TRAINER_SWIMMER_F_DIANA)
    settrainerflag(TRAINER_SWIMMER_F_BRIANA)
    settrainerflag(TRAINER_SWIMMER_F_JOY)
    settrainerflag(TRAINER_SAILOR_PARKER)
    settrainerflag(TRAINER_SAILOR_EDDIE)
    npcmsg("Misty: You really are good...\r"
           "I’ll admit that you are skilled...\r"
           "Here you go.\n"
           "It’s the Cascade Badge.\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Cascade Badge from Misty!")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    callifset(FLAG_UNK_14D, _0364)
    bufferplayersname(0)
    npcmsg("Misty: Here is another memento\n"
           "from this battle. Take it!\r")
    goto(_0307)
_0307:
    if (!itemspace(ITEM_TM03, 1)) { goto(_033E) }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM03_FROM_MISTY)
    bufferplayersname(0)
    npcmsg("Misty: It contains the move\n"
           "Water Pulse.\r"
           "It can sometimes confuse your foe.\r"
           "You’ve managed to defeat Trainers\n"
           "all the way from Johto.\f"
           "I’m sure you have a good use for it.")
    waitbuttonpress
    closemessage
    releaseall
    end
_033E:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

script Cerulean_Gym_EventScript_GymSign1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_4088) != 2) {
        npcmsg("Sorry, I’ll be out for a while.\n"
               "Misty, Gym Leader")
        goto(_03F6)
    }
    checkbadge(BADGE_CASCADE, VAR_SPECIAL_RESULT)
    bufferplayersname(0)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg(msg_0469_T04GYM0101_00006)
    } else {
        npcmsg(msg_0469_T04GYM0101_00007)
    }
    goto(_03F6)
}

text msg_0469_T04GYM0101_00006 {
    "Cerulean City Pokémon Gym"
}

text msg_0469_T04GYM0101_00007 {
    "Cerulean City Pokémon Gym\r"
    "Leader: Misty\n"
    "Certified Trainer!\f"
    "{STRVAR_1 3, 0, 0}"
}

script Cerulean_Gym_EventScript_GymSign2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_4088) == 2) {
        checkbadge(BADGE_CASCADE, VAR_SPECIAL_RESULT)
        bufferplayersname(0)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            npcmsg(msg_0469_T04GYM0101_00006)
        } else {
            npcmsg(msg_0469_T04GYM0101_00007)
        }
    } else {
        npcmsg("Since Misty’s out, we’ll be away, too.\n"
               "Gym Trainers")
    }
_03F6:
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Cerulean_Gym_EventScript_GymGuide {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_CASCADE, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Hoo, you showed me how tough you are.\r"
               "As always, that was one great battle!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Yo! Legend in the making!\r"
           "Since Misty was away, I went out\n"
           "for some fun, too.\f"
           "He-he-he.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

