script RuinsOfAlph_UndergroundHall_SinjohEvent_EventScript_BusinessmanScene1 {
    followmonresetmovement
    lockall
    applymovement(obj_D24R0216_suit, RuinsOfAlph_UndergroundHall_SinjohEvent_Movement_BusinessmanWalkLeft1)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
