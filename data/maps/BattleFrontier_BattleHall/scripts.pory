                 "Your streaks of winnings are kept per\n"
                 "each kind of Pokémon.\f"
                 "Every Pokémon can get up there.\r"
                 "Don’t you think it’s wonderful\n"
                 "you can aim for the top with\f"
                 "any Pokémon?")
    end
}

script BattleFrontier_BattleHall_EventScript_LittleGirl {
    simplenpcmsg("Slow...\r"
                 "My SLOWBRO is a cutie, but he’s even\n"
                 "battled the Brain here.\r"
                 "The Brain will take your Pokémon on at\n"
                 "the same level, to be fair.")
    end
}

script BattleFrontier_BattleHall_EventScript_Slowbro {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    waitse(SEQ_SE_DP_SELECT)
    playcry(SPECIES_SLOWBRO, 0)
    npcmsg("SLOWBRO: ...Slow?")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

script BattleFrontier_BattleHall_EventScript_OldMan {
    simplenpcmsg("Here is a tip!\r"
                 "You should try the Battle Hall with\n"
                 "not just your favorite Pokémon,\r"
                 "but different kinds of Pokémon\n"
                 "if you want to build your\f"
                 "overall record as well.")
    end
}

script BattleFrontier_BattleHall_EventScript_Idol {
    simplenpcmsg("At the Battle Hall, if it’s the same kind\n"
                 "of Pokémon, you can enter different\f"
                 "ones and still keep your record.\r"
                 "You may want to have different ones\n"
                 "knowing different types of moves.")
    end
}

script BattleFrontier_BattleHall_EventScript_PokefanF {
    simplenpcmsg("You know how HOPPIP has two types--\n"
                 "Grass and Flying?\r"
                 "That means it can appear as a\n"
                 "Grass type and as a Flying type.\r"
                 "Me?\r"
                 "You could think of me as...\n"
                 "a “Lighthearted” type and\f"
                 "a “Beautiful” type, I guess.")
    end
}

script BattleFrontier_BattleHall_EventScript_Beauty {
    simplenpcmsg("A piece of advice...\r"
                 "At the Battle Hall, the opposing\n"
                 "Pokémon are matched in level to yours.\r"
                 "That way, you can choose any of your\n"
                 "Pokémon without worrying about\f"
                 "their levels.")
    end
}

script BattleFrontier_BattleHall_EventScript_BugCatcher {
    simplenpcmsg("The Battle Hall lets you keep the\n"
                 "winning-streak records.\f"
                 "That’s neat, huh?\r"
                 "...Wait a sec!\r"
                 "My friend and I can start challenges\n"
                 "with identical conditions and see who\f"
                 "can stretch their win streak\f"
                 "the longest.\f"
                 "That’s even more fun!")
    end
}

script BattleFrontier_BattleHall_EventScript_Attendant3 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_MET_HALL_STREAK_TRACKER_DUDE)) {
        setflag(FLAG_MET_HALL_STREAK_TRACKER_DUDE)
        npcmsg(msg_0108_D32R0401_00068)
        goto(_0B0E)
        end
    _0B0E:
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    bufferbattlehallstreak(1, 2, 3, 4, VAR_BATTLE_HALL_WIN_STREAK_LEVEL, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0AD5) }
    if (var(VAR_SPECIAL_RESULT) == 2) { goto(_0AE0) }
    if (var(VAR_SPECIAL_RESULT) == 3) { goto(_0AF1) }
    bufferplayersname(0)
    npcmsg("When your total win-streak record hits\n"
           "certain figures, you will earn BP as\f"
           "a reward.\r"
           "{STRVAR_1 3, 0, 0}, your total win-streak\n"
           "record is presently {STRVAR_1 55, 1, 0}.\r")
    npcmsg("Your total win-streak record has\n"
           "reached {STRVAR_1 55, 2, 0}.\f"
           "Here is your BP reward.\r")
    playfanfare(SEQ_ME_BPGET)
    npcmsg("{STRVAR_1 3, 0, 0} received {STRVAR_1 53, 4, 0} BP!")
    waitfanfare
    goto(_0B0E)
    end
_0AD5:
    npcmsg(msg_0108_D32R0401_00068)
    goto(_0B0E)
    end
_0AE0:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0}, your total win-streak\n"
           "record stands at {STRVAR_1 55, 1, 0}.\r")
    npcmsg("When your total win-streak record\n"
           "reaches {STRVAR_1 55, 3, 0}, you will earn BP.")
    goto(_0B0E)
    end
_0AF1:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0}, your total win-streak\n"
           "record stands at {STRVAR_1 55, 1, 0}.\r"
           "...My goodness!\n"
           "That’s a fantastic record!")
    goto(_0B0E)
    end
}

text msg_0108_D32R0401_00068 {
    "I keep track of the total number of\n"
    "wins from your longest Single Battle\f"
    "win streaks at the Battle Hall.\r"
    "To explain, I add only the longest win\n"
    "streaks of each kind of Pokémon."
}

script BattleFrontier_BattleHall_EventScript_Winston {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getplayergender(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0C4A) }
    goto(_0B37)
    end
_0B37:
    bufferplayersname(0)
    battlehallcountusedspecies(VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_x8005) >= 475) {
        npcmsg("Winston: The love for Pokémon you\n"
               "exhibited at the Battle Hall is as\f"
               "infinitely deep as it is wide...\r"
               "You can count on me, Winston, to be\n"
               "your lifelong fan.\r"
               "Just as you love Pokémon, I love you\n"
               "as the Pokémon superstar!")
        goto(_0C21)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 351) {
        npcmsg("Winston: You’re phenomenal.\n"
               "All the battles you waged on stage...\f"
               "All those moments of glory...\r"
               "Your star burns so bright and huge!\n"
               "I can barely open my eyes around you!")
        goto(_0C21)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 251) {
        npcmsg("Winston: Go, {STRVAR_1 3, 0, 0}, go!\n"
               "Go, {STRVAR_1 3, 0, 0}, go!\r"
               "I’m thinking up some dance steps and\n"
               "cheers I can do to support you.\r"
               "If you want to see them, you’ll need to\n"
               "keep working on your records!")
        goto(_0C21)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 151) {
        npcmsg("Winston: I’ve never seen Pokémon\n"
               "battle as enjoyably as yours do.\r"
               "You’re the first of a kind for me as\n"
               "Trainers go.\r"
               "You know, I brag about you to everyone\n"
               "who’s willing to listen.\r"
               "I was saying that you’re going to be a\n"
               "star before you even got a record!")
        goto(_0C21)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 101) {
        npcmsg("Winston: Awesome!\n"
               "Seriously awesome!\f"
               "You’re beyond awesome, even!\r"
               "The love you show so many Pokémon...\n"
               "It’s no easy feat, I can tell ya!")
        goto(_0C21)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 51) {
        npcmsg("Winston: Hey, there!\n"
               "What are you going to do this time?\r"
               "Which Pokémon are you going for a\n"
               "record with next?\r"
               "When I get to thinking about that,\n"
               "I get too wound up to sleep at night.\r"
               "That’s why I’ve been sleeping in lately!")
        goto(_0C21)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 31) {
        npcmsg("Winston: I check you out every time\n"
               "you get up on stage.\r"
               "You’re fun to watch, let me tell you.\r"
               "Now I’m always looking forward to\n"
               "seeing the combo of you and your\f"
               "Pokémon on stage.")
        goto(_0C21)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 11) {
        npcmsg("Winston: ...\n"
               "...Oh, sorry for staring!\r"
               "I saw you on stage the last time.\n"
               "You’ve got some star quality.\r"
               "I think I’m going to keep an eye on you.\n"
               "There’s real charisma there.")
        goto(_0C21)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 1) {
        npcmsg("Winston: Let me take a wild guess.\n"
               "Are you getting into the Battle Hall?\f"
               "It’s addictively fun, huh?\r"
               "The more you win, the more kinds of\n"
               "Pokémon you get to see, too.")
        goto(_0C21)
        end
    _0C21:
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Winston: The Battle Hall’s been kind of\n"
           "boring lately.\r"
           "There haven’t been any dazzling\n"
           "challengers who can electrify crowds.\r"
           "The kind of challenger who can beat the\n"
           "Brain... Aren’t there any around?")
    goto(_0C21)
    end
}

script scr_seq_D32R0401_018 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getplayergender(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0B37) }
    goto(_0C4A)
    end
_0C4A:
    bufferplayersname(0)
    battlehallcountusedspecies(VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_x8005) >= 475) {
        npcmsg("Serena: Your Pokémon love that you’ve\n"
               "shown at the Battle Hall is as infinitely\f"
               "deep as it is wide...\r"
               "It’s amazing, but you love every kind of\n"
               "Pokémon there is.\r"
               "I love you for being so amazing and\n"
               "dedicated!")
        goto(_0D34)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 351) {
        npcmsg("Serena: You’re so inspiring to me.\r"
               "All the glory you earned while battling\n"
               "so often on that shining stage...\r"
               "Just seeing you makes me feel all\n"
               "happy inside. ♫")
        goto(_0D34)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 251) {
        npcmsg("Serena: Hurray, hurray, {STRVAR_1 3, 0, 0}!\n"
               "Go, Pokémon, go!\r"
               "...Oh! Um... Excuse me.\r"
               "I was working on cheers and a dance\n"
               "routine for you.\r"
               "B-but, I’m sorry for being so silly and\n"
               "giddy and...")
        goto(_0D34)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 151) {
        npcmsg("Serena: I’ve never seen Pokémon\n"
               "battle as enjoyably as yours do.\r"
               "You’re the first Trainer ever who’s\n"
               "done that.\r"
               "I... I brag about you to all my friends.\n"
               "I hope you don’t mind.\r"
               "I tell them I wish I could be as\n"
               "wonderful a Trainer as you!")
        goto(_0D34)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 101) {
        npcmsg("Serena: Um... Excuse me?\r"
               "Fantastic! It’s fantastic!\n"
               "You’re fabulously fantastic!\r"
               "The love you show so many Pokémon...\n"
               "It must take extraordinary effort.")
        goto(_0D34)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 51) {
        npcmsg("Serena: Um... Excuse me?\r"
               "Can you tell me what kind of Pokémon\n"
               "you’re going for a record with next?\r"
               "When I start thinking about that, I get\n"
               "sort of all choked up.\r"
               "I have trouble sleeping at night when\n"
               "I get that way.")
        goto(_0D34)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 31) {
        npcmsg("Serena: Um... Excuse me?\r"
               "I cheer for you the best I can.\r"
               "I can’t get up on stage with you, but\n"
               "I want to lend my support to your\f"
               "Pokémon and you for trying so hard.")
        goto(_0D34)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 11) {
        npcmsg("Serena: Um... Excuse me?\r"
               "I watched you when you were on stage.\n"
               "It made me feel all tingly seeing you.\r"
               "Um... You won’t mind if I cheer for you\n"
               "from now on, will you? Please, may I?")
        goto(_0D34)
        end
    }
    if (var(VAR_SPECIAL_x8005) >= 1) {
        npcmsg("Serena: Um... Excuse me?\r"
               "If you don’t mind me asking, are you\n"
               "getting into the Battle Hall?\r"
               "It’s fun in an engrossing way, isn’t it?\n"
               "Did you know?\r"
               "The more you win, the more kinds of\n"
               "Pokémon appear.")
        goto(_0D34)
        end
    _0D34:
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Serena: It’s about the Battle Hall...\n"
           "It hasn’t excited me lately.\r"
           "There’s been no gorgeous sort of\n"
           "challenger who can dazzle me.\r"
           "The kind of challenger who can make me\n"
           "a fan... Aren’t there any around?")
    goto(_0D34)
    end
}

script BattleFrontier_BattleHall_EventScript_Ethan {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    bufferplayersname(0)
    copyvar(VAR_TEMP_x4001, VAR_OBJ_1)
    if (var(VAR_TEMP_x4001) == 0) {
        npcmsg("Ethan: The Battle Hall is great for\n"
               "Pokémon fans like me!\r"
               "I get to see so many new kinds of\n"
               "Pokémon I’ve never seen.\r"
               "It’s so cool!")
        goto(_0DC7)
        end
    }
    if (var(VAR_TEMP_x4001) == 97) {
        npcmsg("Lyra: Hi, {STRVAR_1 3, 0, 0}.\n"
               "I love watching you battle here.\r"
               "Cause...\n"
               "you have fun whether you win\f"
               "or lose!")
        goto(_0DC7)
        end
    }
    if (var(VAR_TEMP_x4001) == 365) {
        npcmsg("Mom: {STRVAR_1 3, 0, 0}!\r"
               "I couldn’t help checking up on you!\r"
               "Everyone is working hard, but I have\n"
               "to say you look more delighted than\f"
               "anyone else!\r"
               "Oh, {STRVAR_1 3, 0, 0}, that’s right!\r"
               "I should go to the Department Store\n"
               "in Goldenrod and buy some useful\f"
               "items for you on the way home!")
        goto(_0DC7)
        end
    }
    if (var(VAR_TEMP_x4001) == 366) {
        npcmsg("Professor Oak: You keep amazing me\n"
               "over and over again.\r"
               "What a Trainer you turned out to be!\r"
               "It’s not enough that you caught\n"
               "Pokémon in numbers beyond belief.\r"
               "That alone is fantastic enough.\n"
               "But you’ve bonded and battled with\f"
               "them as well.\r"
               "I am so proud to know you!")
        goto(_0DC7)
        end
    }
    if (var(VAR_TEMP_x4001) == 354) {
        npcmsg("Whitney: I love showy events like\n"
               "the Battle Hall.\r"
               "I’m not saying that I want to stand out\n"
               "in the crowd...\r"
               "I just love seeing cute Pokémon\n"
               "getting lots of attention!")
        goto(_0DC7)
        end
    _0DC7:
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    end
}

mapscripts BattleFrontier_BattleHall_MapScripts {
    INIT_SCRIPT_ON_LOAD: BattleFrontier_BattleHall_OnLoad
    INIT_SCRIPT_ON_TRANSITION: BattleFrontier_BattleHall_OnTransition
    INIT_SCRIPT_ON_RESUME: BattleFrontier_BattleHall_OnResume
    INIT_SCRIPT_ON_FRAME_TABLE [
        VAR_UNK_4145, 1: BattleFrontier_BattleHall_EventScript_Scene3
        VAR_UNK_4145, 2: BattleFrontier_BattleHall_EventScript_Scene1
        VAR_UNK_4145, 3: BattleFrontier_BattleHall_EventScript_Scene4
        VAR_UNK_4145, 255: BattleFrontier_BattleHall_EventScript_Scene2
    ]
}
