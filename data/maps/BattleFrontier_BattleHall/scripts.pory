movement BattleFrontier_BattleHall_Movement_PlayerExit1 {
    walk_left * 4
    walk_down * 3
    set_invisible
}

movement BattleFrontier_BattleHall_Movement_PlayerExit2 {
    walk_left * 2
    walk_up
    walk_left * 2
    walk_down * 3
    set_invisible
}

movement BattleFrontier_BattleHall_Movement_ObjectExit1 {
    walk_left * 3
    walk_down * 3
    set_invisible
}

movement BattleFrontier_BattleHall_Movement_ObjectExit2 {
    walk_left
    walk_up
    walk_left * 2
    walk_down * 3
    set_invisible
}

movement BattleFrontier_BattleHall_Movement_PlayerWalkRightUp {
    walk_faster_right * 4
    walk_faster_up * 3
    face_left
    set_visible
}

movement BattleFrontier_BattleHall_Movement_PlayerWalkRightDown {
    walk_faster_right * 2
    walk_faster_down
    walk_faster_right * 2
    walk_faster_up * 3
    face_left
    set_visible
}

movement BattleFrontier_BattleHall_Movement_ObjectWalkUpRight1 {
    walk_faster_up * 3
    walk_faster_right * 3
    set_visible
}

movement BattleFrontier_BattleHall_Movement_ObjectWalkUpRight2 {
    walk_faster_up * 2
    walk_faster_right * 3
    set_visible
}

script(local) _0868 {
    npcmsg("Welcome to the Battle Hall!\r"
           "I am your guide to the Single and\n"
           "Double Battle challenges.\r"
           "Please be aware that these challenges\n"
           "are designed for a single Trainer.\r")
    return
_086D:
    npcmsg("Welcome to the Battle Hall!\r"
           "I am your guide to the Multi Battle\n"
           "challenge.\r"
           "Please be aware that this challenge\n"
           "requires two Trainers.\r")
    return
_0872:
    npcmsg("Which challenge would you\n"
           "like to take?{YESNO 0}")
    touchscreenmenuhide
    menuinit(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(16, 255, 0)
    menuitemadd(17, 255, 1)
    return
_0891:
    npcmsg("Would you like to take the Battle\n"
           "Hall Multi Battle challenge? {YESNO 0}")
    touchscreenmenuhide
    menuinit(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(18, 255, 4)
    return
_08A8:
    npcmsg("At the Battle Hall, you may take Single\n"
           "or Double Battle challenges alone.\r"
           "For the Single Battle challenge, you\n"
           "enter one Pokémon of at least Lv. 30.\r"
           "The Double Battle Challenge requires\n"
           "you to enter two of the same kind of\f"
           "Pokémon that are at least Lv. 30 each.\r"
           "Winning-streak records are kept for\n"
           "individual kinds of Pokémon.\r"
           "That makes it possible for any kind of\n"
           "Pokémon to aim for no. 1.\r"
           "When you enter the Hall, you will be\n"
           "asked to choose the type and rank of\f"
           "the Pokémon you want to battle.\r"
           "If you manage to win ten matches in\n"
           "a row, you will earn Battle Points (BP).\r"
           "If you want to interrupt your\n"
           "challenge, please save the game.\r"
           "If you don’t save, you will be\n"
           "disqualified from your challenge.\r"
           "Please be aware of that!\r")
    return
_08AD:
    npcmsg("You may team up with a friend for a\n"
           "Multi Battle challenge using the\f"
           "same kind of Pokémon that are at\f"
           "least Lv. 30 each.\r"
           "When you enter the Hall, you will be\n"
           "asked to choose the type and rank of\f"
           "the Pokémon you want to battle.\r"
           "If you manage to win ten matches in\n"
           "a row, you will earn Battle Points (BP).\r"
           "Please note: a Battle Hall Multi Battle\n"
           "challenge can’t be interrupted.\r")
    return
}

script BattleFrontier_BattleHall_EventScript_Scene1 {
    checkfieldheapfreesize(0)
    setvar(VAR_TEMP_x4003, 1)
    setvar(VAR_UNK_4145, 0)
    npcmsg("We’ve missed you!\r"
           "You must save the game before you\n"
           "resume your challenge. Please wait.")
    call(_066C)
    call(_08D9)
    goto(_0689)
    end
_08D9:
    addwaitingicon
    savegamenormal(VAR_SPECIAL_RESULT)
    removewaitingicon
    playse(SEQ_SE_DP_SAVE)
    waitse(SEQ_SE_DP_SAVE)
    return
}

script BattleFrontier_BattleHall_EventScript_Scene2 {
    npcmsg("Excuse me!\r"
           "You didn’t save before you quit your\n"
           "challenge last time.\r"
           "Because of that, you have been\n"
           "disqualified from your challenge!\r")
    battlehallresetstreak(VAR_UNK_4146)
    compare(VAR_BATTLE_HALL_PRINT_PROGRESS, 1)
    callifeq(_0914)
    compare(VAR_BATTLE_HALL_PRINT_PROGRESS, 3)
    callifeq(_091C)
    goto(_02F5)
    end
_0914:
    setvar(VAR_BATTLE_HALL_PRINT_PROGRESS, 0)
    return
_091C:
    setvar(VAR_BATTLE_HALL_PRINT_PROGRESS, 2)
    return
}

