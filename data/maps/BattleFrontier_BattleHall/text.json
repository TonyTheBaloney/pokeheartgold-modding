    {
      "id": "msg_0108_D32R0401_00007",
      "en_US": [
        "Which challenge level would you like to\n",
        "play? Level 50 or Open Level?"
      ]
    },
    {
      "id": "msg_0108_D32R0401_00008",
      "en_US": [
        "You must save the game before\n",
        "I show you in. Is that OK?{YESNO 0}"
      ]
    },
    {
      "id": "msg_0108_D32R0401_00009",
      "from": "text"
    },
    {
      "id": "msg_0108_D32R0401_00010",
      "en_US": "We look forward to your next visit.\r"
    },
