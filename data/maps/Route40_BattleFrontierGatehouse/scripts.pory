script Route40_BattleFrontierGatehouse_EventScript_Attendant {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GAME_CLEAR)) {
        npcmsg("This is the entrance to the\n"
               "Battle Frontier.\f"
               "You shouldn’t make a line here.")
    } else {
        npcmsg("The Battle Frontier is open!\r"
               "Please go ahead.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

