script Route40_BattleFrontierGatehouse_EventScript_PokefanM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    if (flag(FLAG_UNK_0FB)) {
        npcmsg("Zzz... Zzz...\n"
               "...\r"
               "He doesn’t seem like he’ll wake up\n"
               "anytime soon!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_GAME_CLEAR)) { goto(_00B1) }
    getplayerfacing(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 3) {
        applymovement(obj_W40R0101_gsmiddleman1, Route40_BattleFrontierGatehouse_Movement_PokefanMFaceLeft)
    } elif (var(VAR_TEMP_x4000) == 2) {
        applymovement(obj_W40R0101_gsmiddleman1, Route40_BattleFrontierGatehouse_Movement_PokefanMFaceRight)
    } else {
        applymovement(obj_W40R0101_gsmiddleman1, Route40_BattleFrontierGatehouse_Movement_PokefanMFaceDown)
    }
    waitmovement
    npcmsg("What? I’m the first to arrive!\r"
           "There will soon be a Battle Frontier\n"
           "past here.\r"
           "I’m in line to be the first one there.\n"
           "I haven’t slept for days.\r"
           "Get in line if you want to be the second\n"
           "one in!\r")
    closemessage
    applymovement(obj_W40R0101_gsmiddleman1, Route40_BattleFrontierGatehouse_Movement_PokefanMFaceUp)
    waitmovement
    releaseall
    end
_00B1:
    npcmsg("Zzz...\n"
           "...\r"
           "He is standing...but asleep!\r")
    closemessage
    releaseall
    setflag(FLAG_UNK_0FB)
    end
}

