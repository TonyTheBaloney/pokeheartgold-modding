script scr_seq_D37R0104_004 {
    followmonresetmovement
    lockall
    callstd(std_play_rival_intro_music)
    movepersonfacing(obj_D37R0104_gsrivel, 28, 0, 4, DIR_WEST)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_D37R0104_gsrivel, Goldenrod_Tunnel_B2F_Movement_06E0)
    applymovement(obj_player, Goldenrod_Tunnel_B2F_Movement_06F4)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    bufferrivalsname(0)
    npcmsg("{STRVAR_1 3, 0, 0}: Hold it!\r"
           "What I told you before was to deceive\n"
           "you. I thought it would let me tail you,\f"
           "and it would lead me to Lance.\r"
           "Well, he never showed up.\f"
           "...No matter.\r"
           "I was planning to beat you after Lance,\n"
           "but since you are here, I will repay\f"
           "my debts!\r")
    closemessage
    getstarterchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 152) {
        trainerbattle(TRAINER_RIVAL_SILVER_18, 0, 0, 0)
    } elif (var(VAR_SPECIAL_RESULT) == 155) {
        trainerbattle(TRAINER_RIVAL_SILVER_12, 0, 0, 0)
    } else {
        trainerbattle(TRAINER_RIVAL_SILVER_17, 0, 0, 0)
    }
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    callstd(std_play_rival_outro_music)
    bufferrivalsname(0)
    npcmsg("{STRVAR_1 3, 0, 0}: ...I don’t understand.\r"
           "Is what that Lance guy said true?\n"
           "That I don’t treat Pokémon properly?\r"
           "Love...\r"
           "Trust...\r"
           "Are they really what I lack?\n"
           "Are they keeping me from winning?\r"
           "I... I just don’t understand. But it’s\n"
           "not going to end here. Not now.\f"
           "Not because of this.\r"
           "I won’t give up my dream of becoming\n"
           "the world’s best Pokémon Trainer!\r")
    closemessage
    setvar(VAR_UNK_40A0, 1)
    applymovement(obj_D37R0104_gsrivel, Goldenrod_Tunnel_B2F_Movement_0700)
    waitmovement
    removeobject(obj_D37R0104_gsrivel)
    callstd(std_fade_end_rival_outro_music)
    releaseall
    end
}

movement Goldenrod_Tunnel_B2F_Movement_06E0 {
    delay_4 * 6
    walk_left * 3
    walk_down
    walk_left * 4
}

movement Goldenrod_Tunnel_B2F_Movement_06F4 {
    emote_exclamation_mark
    walk_right
}

movement Goldenrod_Tunnel_B2F_Movement_0700 {
    walk_right * 4
    walk_up
    walk_right * 4
}

