text msg_0115_D36R0101_00002 {
    "Wow!\n"
    "You got me both of them.\f"
    "Thank you so much!\r"
    "My boss’s Pokémon won’t obey me,\n"
    "because I don’t have a Badge.\r"
    "Phew. You saved me."
}

text msg_0115_D36R0101_00000 {
    "Oh, man... My boss is going to be\n"
    "angry...\r"
    "The FARFETCH’D that cut trees for\n"
    "charcoal took off in the forest.\r"
    "Can you catch them for me?\n"
    "FARFETCH’D have sensitive ears.\r"
    "If you step on a branch, they will face\n"
    "toward you. That’s your chance.\r"
    "Sneak up from behind and catch them...\n"
    "Do you think you can do that?"
}

script IlexForest_EventScript_SchoolKidMTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_D36R0101_gsboy1, IlexForest_Movement_SchoolKidMExclamation)
    applymovement(obj_player, IlexForest_Movement_PlayerFaceUp)
    waitmovement
    npcmsg(msg_0115_D36R0101_00000)
    waitbuttonpress
    closemessage
    setvar(VAR_UNK_40F4, 0)
    releaseall
    end
}

movement IlexForest_Movement_SchoolKidMExclamation {
    emote_exclamation_mark
}

movement IlexForest_Movement_PlayerFaceUp {
    delay_8 * 2
    face_up
}

script IlexForest_EventScript_BlackBelt {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_HM01)) {
        npcmsg(msg_0115_D36R0101_00010)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg(msg_0115_D36R0101_00006)
    if (!itemspace(ITEM_HM01, 1)) {
        callstd(std_bag_is_full)
        closemessage
        releaseall
        end
    _1207:
        clearflag(FLAG_HIDE_ILEX_CUT_MASTER)
        addobject(obj_D36R0101_gsfighter)
        clearflag(FLAG_HIDE_FARFETCHD_2_FOUND)
        wait(20, VAR_SPECIAL_x8004)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        warp(MAP_ILEX_FOREST, 0, 15, 65, DIR_NORTH)
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        wait(5, VAR_SPECIAL_x8004)
        npcmsg(msg_0115_D36R0101_00002)
        waitbuttonpress
        closemessage
        applymovement(obj_D36R0101_gsfighter, IlexForest_Movement_BlackBeltWalkUpRight)
        applymovement(obj_player, IlexForest_Movement_PlayerFaceLeft1)
        waitmovement
        if (flag(FLAG_GOT_HM01)) {
            npcmsg(msg_0115_D36R0101_00010)
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg(msg_0115_D36R0101_00006)
        if (!itemspace(ITEM_HM01, 1)) {
            callstd(std_bag_is_full)
            closemessage
            releaseall
            end
        }
        callstd(std_give_item_verbose)
        setflag(FLAG_HIDE_ILEX_CUT_MASTER)
        setflag(FLAG_HIDE_ILEX_APPRENTICE)
        setflag(FLAG_HIDE_FARFETCHD_1_LOST)
        setflag(FLAG_HIDE_FARFETCHD_2_LOST)
        setflag(FLAG_HIDE_FARFETCHD_1_FOUND)
        setflag(FLAG_HIDE_FARFETCHD_2_FOUND)
        setflag(FLAG_GOT_HM01)
        clearflag(FLAG_UNK_1AE)
        clearflag(FLAG_UNK_1AC)
        npcmsg(msg_0115_D36R0101_00008)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_HM01)
    clearflag(FLAG_UNK_1AE)
    clearflag(FLAG_UNK_1AC)
    npcmsg(msg_0115_D36R0101_00008)
    waitbuttonpress
    closemessage
    releaseall
    end
}

text msg_0115_D36R0101_00010 {
    "Do you want to apprentice as a charcoal\n"
    "maker with me?\r"
    "You’ll be first-rate in ten years!"
}

text msg_0115_D36R0101_00006 {
    "Ah!\n"
    "My Far and Fetch’d!\r"
    "You found them for us, kid?\n"
    "Without them, we wouldn’t be able to\f"
    "cut trees for charcoal.\r"
    "Thanks, kid!\r"
    "Now, how can I thank you...?\n"
    "I know! Here, take this.\r"
}

text msg_0115_D36R0101_00008 {
    "That’s the HM Cut. Teach that to a\n"
    "Pokémon to clear small trees.\r"
    "Of course, you have to have the Gym\n"
    "Badge from Azalea to use it."
}

script IlexForest_EventScript_Farfetchd3 {
    playcry(SPECIES_FARFETCHD, 0)
    simplenpcmsg("FARFETCH’D: Kwaa!")
    end
}

movement IlexForest_Movement_BlackBeltWalkUpRight {
    walk_up * 10
    walk_right * 3
}

movement IlexForest_Movement_PlayerFaceLeft1 {
    delay_8 * 12
    face_left
}

script IlexForest_EventScript_KimonoGirlTrigger {
    followmonresetmovement
    lockall
    callstd(std_play_kimono_girl_music)
    applymovement(obj_D36R0101_dancer, IlexForest_Movement_KimonoGirlExclamation)
    waitmovement
    getplayercoords(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_x8004) == 40) {
        applymovement(obj_D36R0101_dancer, IlexForest_Movement_KimonoGirlWalkDownRight1)
    } else {
        applymovement(obj_D36R0101_dancer, IlexForest_Movement_KimonoGirlWalkDownRight2)
    }
    waitmovement
    npcmsg("Kimono Girl, Kimono Girl, lost and all\n"
           "alone. Poor girl lost in the dark\f"
           "Ilex Forest.\r")
    closemessage
    applymovement(obj_D36R0101_dancer, IlexForest_Movement_KimonoGirlSpin)
    waitmovement
    npcmsg("What?\n"
           "You remember me from Violet City?\f"
           "You must be imagining.\r"
           "Anyway, will you show me\n"
           "how to get out of this forest? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("You will...?\n"
               "Aren’t you lost in the forest as well?\f"
               "How do you know how to get out of here?\r")
    } else {
        npcmsg("Me oh my...\n"
               "You are lost yourself, aren’t you?\r")
    }
    closemessage
    getpartyleadalive(VAR_TEMP_x4000)
    getpartymonspecies(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 50) {
        if (var(VAR_TEMP_x4001) == 51) { goto(_13D5) }
        release(obj_partner_poke)
        if (var(VAR_SPECIAL_x8004) == 40) {
            applymovement(obj_player, IlexForest_Movement_PlayerWalkRight)
            applymovement(obj_partner_poke, IlexForest_Movement_FollowMonWalkUpLeft1)
        } else {
            applymovement(obj_partner_poke, IlexForest_Movement_FollowMonWalkLeftUp1)
        }
        waitmovement
        lock(obj_partner_poke)
    } else {
    _13D5:
        release(obj_partner_poke)
        if (var(VAR_SPECIAL_x8004) == 40) {
            applymovement(obj_player, IlexForest_Movement_PlayerWalkRight)
            applymovement(obj_partner_poke, IlexForest_Movement_FollowMonWalkUpLeft2)
        } else {
            applymovement(obj_partner_poke, IlexForest_Movement_FollowMonWalkLeftUp2)
        }
        waitmovement
        lock(obj_partner_poke)
    }
    if (var(VAR_SPECIAL_x8004) == 40) {
        applymovement(obj_D36R0101_dancer, IlexForest_Movement_KimonoGirlFaceLeft)
    } else {
        applymovement(obj_D36R0101_dancer, IlexForest_Movement_KimonoGirlWalkLeft)
    }
    waitmovement
    npcmsg("Wow! Are you going to\n"
           "show me how to get out?\f"
           "You are such a smart Pokémon!\r")
    closemessage
    applymovement(obj_D36R0101_dancer, IlexForest_Movement_KimonoGirlFaceDown)
    waitmovement
    npcmsg("See you.\r")
    closemessage
    applymovement(obj_D36R0101_dancer, IlexForest_Movement_KimonoGirlWalkLeftUp)
    waitmovement
    removeobject(obj_D36R0101_dancer)
    setflag(FLAG_UNK_23D)
    callstd(std_fade_end_kimono_girl_music)
    release(obj_partner_poke)
    applymovement(obj_partner_poke, IlexForest_Movement_FollowMonWalkRightDown1)
    waitmovement
    lock(obj_partner_poke)
    releaseall
    setvar(VAR_UNK_40E9, 1)
    end
}

movement IlexForest_Movement_KimonoGirlExclamation {
    emote_exclamation_mark
    walk_in_place_down
}

movement IlexForest_Movement_KimonoGirlWalkDownRight1 {
    walk_down
    walk_right * 2
    walk_down
}

movement IlexForest_Movement_KimonoGirlWalkDownRight2 {
    walk_down
    walk_right * 3
    walk_down
}

movement IlexForest_Movement_KimonoGirlSpin {
    face_left
    delay_2
    face_up
    delay_2
    face_right
    delay_2
    face_down
    delay_2
    face_left
    delay_2
    face_up
    delay_2
    face_right
    delay_2
    face_down
    delay_2
}

movement IlexForest_Movement_PlayerWalkRight {
    face_left
    lock_dir
    walk_right
    unlock_dir
}

