text msg_0115_D36R0101_00036 {
    "You need to catch it from behind."
}

text msg_0115_D36R0101_00003 {
    "FARFETCH’D: Kwaa!\r"
}

text msg_0115_D36R0101_00037 {
    "You snuck up and caught it from\n"
    "behind before it noticed you!"
}

text msg_0115_D36R0101_00001 {
    "Wow! You found a FARFETCH’D!\n"
    "Thank you!\r"
    "But...\n"
    "There is one more missing.\r"
    "If you step on a branch, it will face\n"
    "that way, remember?\r"
    "That’s your chance to catch it.\n"
    "Sneak up on it slowly from behind."
}

script IlexForest_EventScript_FarfetchdTrigger1 {
    followmonresetmovement
    lockall
    if (var(FARFETCHD1_BOTTOM_RIGHT_FACING_UP) == TRUE) { goto(_farfetchd1_look_left) }
    setvar(FARFETCHD1_BLIND_SPOT, TRUE)
    setvar(VAR_FARFETCHD1_STICKS1, STICKS_INACTIVE)
