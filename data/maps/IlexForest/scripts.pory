    walk_in_place_fast_down * 5
}

movement _walk_in_place_face_right {
    walk_in_place_fast_right * 5
}

script IlexForest_EventScript_FatManTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_player, IlexForest_Movement_PlayerExclamation1)
    waitmovement
    applymovement(obj_D36R0101_gsbigman, IlexForest_Movement_FatManJumpUp)
    waitmovement
    playse(SEQ_SE_DP_KI_GASYAN)
    screenshake(0, 2, 10, 5)
    applymovement(obj_D36R0101_gsbigman, IlexForest_Movement_FatManWalkDown)
    waitmovement
    applymovement(obj_D36R0101_gsbigman, IlexForest_Movement_FatManJumpUp)
    waitmovement
    playse(SEQ_SE_DP_KI_GASYAN)
    screenshake(0, 2, 10, 5)
    applymovement(obj_D36R0101_gsbigman, IlexForest_Movement_FatManWalkDown)
    waitmovement
    setvar(VAR_UNK_40EA, 1)
    releaseall
    end
}

movement IlexForest_Movement_PlayerExclamation1 {
    emote_exclamation_mark
    walk_in_place_up
}

movement IlexForest_Movement_FatManJumpUp {
    jump_near_fast_up
}

movement IlexForest_Movement_FatManWalkDown {
    lock_dir
    walk_slow_down
    unlock_dir
}

script IlexForest_EventScript_FatMan {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("What am I doing?\r"
           "I’m shaking trees using Headbutt.\r"
           "It’s fun. Here, you try it with your\n"
           "Pokémon, too! {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_1086) }
    npcmsg("Which Pokémon should learn it?\r")
    closemessage
_0F0B:
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    partyselectui
    getpartyselection(VAR_SPECIAL_RESULT)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_RESULT) == 255) {
        npcmsg(msg_0115_D36R0101_00013)
        waitbuttonpress
        closemessage
        touchscreenmenushow
        releaseall
        end
    }
    getpartymonspecies(VAR_SPECIAL_RESULT, VAR_SPECIAL_x8005)
    setorcopyvar(VAR_SPECIAL_x8006, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_x8005) == 0) {
        npcmsg("Hmmm...\n"
               "Even I couldn’t teach an Egg a move.\r")
        closemessage
        goto(_0F0B)
    _10AB:
        npcmsg(msg_0115_D36R0101_00019)
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0F99) }
        goto(_1086)
    _10C7:
        npcmsg(msg_0115_D36R0101_00019)
        getmenuchoice(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0F99) }
        goto(_1086)
    }
    monhasmove(VAR_SPECIAL_RESULT, MOVE_HEADBUTT, VAR_SPECIAL_x8006)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        buffermonspeciesname(0, VAR_SPECIAL_x8006)
        npcmsg("Your {STRVAR_1 0, 0, 0}\n"
               "has already learned Headbutt.\r")
        closemessage
        goto(_0F0B)
        end
    }
    moncanlearnheadbuttfromtutor(VAR_SPECIAL_x8006, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0F84) }
    npcmsg("Sorry...\n"
           "That Pokémon cannot learn Headbutt.\r")
    closemessage
    goto(_0F0B)
_0F84:
    countmonmoves(VAR_SPECIAL_x8002, VAR_SPECIAL_x8006)
    if (var(VAR_SPECIAL_x8002) > 3) {
        touchscreenmenuhide
    _0F99:
        bufferpartymonnick(0, VAR_SPECIAL_x8006)
        npcmsg("{STRVAR_1 1, 0, 0} is trying to learn\n"
               "Headbutt.\r"
               "But {STRVAR_1 1, 0, 0} can’t learn more\n"
               "than four moves.\r"
               "Delete an older move to make\n"
               "room for Headbutt? {YESNO 0}")
        getmenuchoice(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_10C7) }
        closemessage
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        pokemonsummaryscreen(1, VAR_SPECIAL_x8006, 29)
        getmoveselection(1, VAR_SPECIAL_x8001)
        restoreoverworld
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        if (var(VAR_SPECIAL_x8001) == 4) { goto(_10AB) }
        bufferpartymonmovename(1, VAR_SPECIAL_x8006, VAR_SPECIAL_x8001)
        npcmsg("Is it OK to forget the\n"
               "move {STRVAR_1 6, 1, 0}? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_10C7) }
        setmonmove(VAR_SPECIAL_x8006, VAR_SPECIAL_x8001, MOVE_HEADBUTT)
        npcmsg("1,{PAUSE 20} 2,{PAUSE 20} and...{PAUSE 20} ...{PAUSE 20} Poof!")
        playse(SEQ_SE_DP_KON)
        waitse(SEQ_SE_DP_KON)
        wait(30, VAR_SPECIAL_RESULT)
        npcmsg("{STRVAR_1 1, 0, 0} forgot how to\n"
               "use {STRVAR_1 6, 1, 0}.\r"
               "And...")
        wait(32, VAR_SPECIAL_RESULT)
        npcmsg("{STRVAR_1 1, 0, 0} learned Headbutt.")
        playfanfare(SEQ_ME_LVUP)
        waitfanfare
        wait(16, VAR_SPECIAL_RESULT)
        playcry(VAR_SPECIAL_x8005, 0)
    } else {
        bufferpartymonnick(0, VAR_SPECIAL_x8006)
        setmonmove(VAR_SPECIAL_x8006, VAR_SPECIAL_x8002, MOVE_HEADBUTT)
        npcmsg("1,{PAUSE 20} 2,{PAUSE 20} and...{PAUSE 20} ...{PAUSE 20} Poof!")
        wait(30, VAR_SPECIAL_RESULT)
        npcmsg("{STRVAR_1 1, 0, 0} learned Headbutt!")
        playfanfare(SEQ_ME_LVUP)
        waitfanfare
        wait(32, VAR_SPECIAL_RESULT)
        playcry(VAR_SPECIAL_x8005, 0)
        npcmsg(msg_0115_D36R0101_00022)
        waitbuttonpress
        closemessage
        touchscreenmenushow
        releaseall
        end
    }
    npcmsg(msg_0115_D36R0101_00022)
    waitbuttonpress
    closemessage
    touchscreenmenushow
    releaseall
    end
_1086:
    npcmsg(msg_0115_D36R0101_00013)
    waitbuttonpress
    closemessage
    touchscreenmenushow
    releaseall
    end
}

