script IlexForest_EventScript_SchoolKidM {
    if (!flag(FLAG_FOUND_FIRST_FARFETCHD)) {
    } else {
        if (flag(FLAG_FOUND_SECOND_FARFETCHD)) {
            simplenpcmsg(msg_0115_D36R0101_00002)
            end
        _1139:
            simplenpcmsg(msg_0115_D36R0101_00001)
            end
        _114C:
            playse(SEQ_SE_DP_SELECT)
            lockall
