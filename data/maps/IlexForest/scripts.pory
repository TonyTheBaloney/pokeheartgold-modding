script IlexForest_EventScript_Lyra {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    setvar(VAR_TEMP_x4008, 1)
    call(_1987)
    if (var(VAR_SPECIAL_x8004) == 0) {
        call(_1F3F)
    } else {
        call(_1AFB)
    }
    releaseall
    end
_1F3F:
    npcmsg("It’s been waiting for you\n"
           "all this time.\r"
           "Talk to it. That’ll make it happy.")
    waitbuttonpress
    closemessage
    return
_1F48:
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    applymovement(obj_partner_poke, IlexForest_Movement_FollowMonJumpDown)
    waitmovement
    fadeoutbgm(0, 30)
    callstd(std_play_friend_music)
    touchscreenmenuhide
    clearflag(FLAG_HIDE_ILEX_FOREST_FRIEND)
    addobject(obj_D36R0101_var_1)
    addobject(obj_D36R0101_tsure_poke_static_marill)
    applymovement(obj_D36R0101_var_1, IlexForest_Movement_FriendWalkDownRight)
    applymovement(obj_D36R0101_tsure_poke_static_marill, IlexForest_Movement_MarillWalkDownRight)
    waitmovement
    applymovement(obj_player, IlexForest_Movement_PlayerFaceLeft3)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("Lyra: Hi, {STRVAR_1 3, 0, 0}.\n"
                 "Have you heard of the legend of\f"
                 "the shrine?\r"
                 "They say that people disappear when\n"
                 "they tamper with it.\r", "Ethan: Hi, {STRVAR_1 3, 0, 0}.\n"
                                           "Have you heard of the legend of\f"
                                           "the shrine?\r"
                                           "They say that people disappear when\n"
                                           "they tamper with it.\r")
    closemessage
    callstd(std_fade_end_friend_music)
    playse(SEQ_SE_GS_SUZUSYUTUGEN_HO)
    fadescreen(6, 6, 0, RGB_WHITE)
    waitfade
    wait(15, VAR_SPECIAL_RESULT)
    fadescreen(6, 6, 1, RGB_WHITE)
    waitfade
    applymovement(obj_player, IlexForest_Movement_PlayerExclamation3)
    applymovement(obj_D36R0101_var_1, IlexForest_Movement_FriendWalkRightUp)
    waitmovement
    gendermsgbox("Lyra: ...\n"
                 "What was that?\r", "Ethan: ...\n"
                                     "What was that?\r")
    closemessage
    playse(SEQ_SE_GS_TIMESLIP)
    celebitimetravel
    setvar(VAR_UNK_40FE, 1)
    clearflag(FLAG_HIDE_ROUTE_22_GIOVANNI_RIVAL)
    clearflag(FLAG_HIDE_ROUTE_22_FRIEND)
    setflag(FLAG_HIDE_ILEX_FOREST_FRIEND)
    warp(MAP_ROUTE_22, 0, 954, 280, DIR_SOUTH)
    fadescreen(6, 15, 1, RGB_WHITE)
    waitfade
    releaseall
    end
}

