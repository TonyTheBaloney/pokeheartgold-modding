    walk_in_place_up
}

movement IlexForest_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

script IlexForest_EventScript_Shrine {
    playeronbikecheck(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_1803) }
    if (var(VAR_UNK_412B) >= 2) { goto(_17C1) }
    if (var(VAR_UNK_412B) == 1) { goto(_1803) }
    getpartyleadalive(VAR_TEMP_x4000)
    followerpokeiseventtrigger(EVENT_SPIKY_EARED_PICHU, VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 0) {
        clearflag(FLAG_HIDE_ILEX_FOREST_SPIKY_EAR_PICHU)
        goto(_1816)
    _17C1:
        if (var(VAR_UNK_40FE) >= 4) { goto(_1803) }
        if (!flag(FLAG_BEAT_RADIO_TOWER_ROCKETS)) { goto(_1803) }
        getpartyleadalive(VAR_TEMP_x4006)
        followerpokeiseventtrigger(EVENT_CELEBI, VAR_TEMP_x4006, VAR_TEMP_x4007)
        if (var(VAR_TEMP_x4007) != 0) {
            goto(_1F48)
        _1803:
            simplenpcmsg("Ilex Forest Shrine...\r"
                         "It’s a tribute to the forest’s\n"
                         "protector...")
            end
        _1816:
            followmonresetmovement
            lockall
            stopbgm(0)
            clearflag(FLAG_HIDE_ILEX_FOREST_SPIKY_EAR_PICHU)
            addobject(obj_D36R0101_tsure_poke_static_pichu_spiky)
            applymovement(obj_D36R0101_tsure_poke_static_pichu_spiky, IlexForest_Movement_PichuJumpRight1)
            waitmovement
            playcry(SPECIES_PICHU, 0)
            waitcry
            applymovement(obj_player, IlexForest_Movement_PlayerExclamation2)
            waitmovement
            callstd(std_play_pichu_music)
            applymovement(obj_D36R0101_tsure_poke_static_pichu_spiky, IlexForest_Movement_PichuWalkDownLeft)
            togglefollowingpokemonmovement(0)
            waitfollowingpokemonmovement
            followingpokemonmovement(55)
            applymovement(obj_player, IlexForest_Movement_PlayerWalkDown1)
            waitmovement
            waitfollowingpokemonmovement
            togglefollowingpokemonmovement(1)
            followingpokemonmovement(48)
            npcmsg("It’s a PICHU...!\n"
                   "One of its ears is spiky!\r")
            closemessage
            applymovement(obj_partner_poke, IlexForest_Movement_FollowMonWalkRightDown2)
            waitmovement
            applymovement(obj_D36R0101_tsure_poke_static_pichu_spiky, IlexForest_Movement_PichuJumpRight2)
            waitmovement
            applymovement(obj_partner_poke, IlexForest_Movement_FollowMonExclamation)
            waitmovement
            applymovement(obj_D36R0101_tsure_poke_static_pichu_spiky, IlexForest_Movement_PichuWalkLeftUp)
            applymovement(obj_partner_poke, IlexForest_Movement_FollowMonWalkDownLeft)
            waitmovement
            clearflag(FLAG_HIDE_ILEX_FOREST_OLD_MAN)
            addobject(obj_D36R0101_gsoldman1)
            applymovement(obj_D36R0101_gsoldman1, IlexForest_Movement_LyraWalkDownRight)
            applymovement(obj_D36R0101_tsure_poke_static_pichu_spiky, IlexForest_Movement_PichuWalkDownRight)
            applymovement(obj_partner_poke, IlexForest_Movement_FollowMonWalkDownRight)
            waitmovement
            applymovement(obj_player, IlexForest_Movement_PlayerFaceLeft2)
            waitmovement
            npcmsg("Hey, hey!\n"
                   "You should not tamper with that shrine!\f"
                   "People are said to disappear.\r")
            closemessage
            applymovement(obj_D36R0101_gsoldman1, IlexForest_Movement_LyraFaceUp)
            waitmovement
            npcmsg("Kids and Pokémon sometimes disappear\n"
                   "around this shrine.\r"
                   "It is believed that a Pokémon which\n"
                   "wanders across time does that.\r"
                   "It is truly a strange thing...\r")
            closemessage
            applymovement(obj_D36R0101_gsoldman1, IlexForest_Movement_LyraExclamation)
            applymovement(obj_D36R0101_tsure_poke_static_pichu_spiky, IlexForest_Movement_PichuFaceUp)
            applymovement(obj_player, IlexForest_Movement_PlayerFaceDown)
            waitmovement
            npcmsg("Well, well, this must be...\r"
                   "This must be the PICHU that has lived in\n"
                   "this forest for some time.\r"
                   "When I saw it the first time, it looked\n"
                   "lonely. It is full of energy today.\r")
            closemessage
            applymovement(obj_D36R0101_tsure_poke_static_pichu_spiky, IlexForest_Movement_PichuFaceRight1)
            applymovement(obj_partner_poke, IlexForest_Movement_FollowMonJumpLeft)
            waitmovement
            npcmsg("I see.\n"
                   "It seems that these old friends\f"
                   "finally meet again after a long time.\r")
            closemessage
            applymovement(obj_partner_poke, IlexForest_Movement_FollowMonFaceLeft)
            waitmovement
            applymovement(obj_D36R0101_tsure_poke_static_pichu_spiky, IlexForest_Movement_PichuFaceRight2)
            waitmovement
            applymovement(obj_partner_poke, IlexForest_Movement_FollowMonFaceUp)
            waitmovement
            togglefollowingpokemonmovement(0)
            waitfollowingpokemonmovement
            followingpokemonmovement(55)
            applymovement(obj_player, IlexForest_Movement_PlayerWalkDown2)
            waitmovement
            waitfollowingpokemonmovement
            togglefollowingpokemonmovement(1)
            followingpokemonmovement(48)
            npcmsg("It wants to join your party.\n"
                   "Let it join you!\r")
            playcry(SPECIES_PICHU, 0)
            npcmsg(msg_0115_D36R0101_00043)
            waitcry
            closemessage
            call(_1987)
            compare(VAR_SPECIAL_x8004, 1)
            callifge(_1AFB)
            compare(VAR_SPECIAL_x8004, 0)
            callifeq(_19AC)
            releaseall
            end
        _1987:
            getpartycount(VAR_SPECIAL_RESULT)
            if (var(VAR_SPECIAL_RESULT) >= 6) {
                setvar(VAR_SPECIAL_x8004, 1)
            } else {
                setvar(VAR_SPECIAL_x8004, 0)
            }
            return
        _19AC:
            npcmsg(msg_0115_D36R0101_00052)
            closemessage
            togglefollowingpokemonmovement(0)
            waitfollowingpokemonmovement
            followingpokemonmovement(55)
            applymovement(obj_player, IlexForest_Movement_PlayerWalkUp3)
            waitmovement
            waitfollowingpokemonmovement
            togglefollowingpokemonmovement(1)
            followingpokemonmovement(48)
        _19CF:
            getplayerfacing(VAR_TEMP_x4005)
            if (var(VAR_TEMP_x4005) == 3) {
                applymovement(obj_D36R0101_gsoldman1, IlexForest_Movement_LyraFaceLeft)
            } else {
                applymovement(obj_D36R0101_gsoldman1, IlexForest_Movement_LyraFaceRight)
            }
            waitmovement
            playfanfare(SEQ_ME_ITEM)
            bufferplayersname(0)
            npcmsg("{STRVAR_1 3, 0, 0} received the Poké Ball!")
            waitfanfare
            npcmsg("It seems that Spiky-eared PICHU\n"
                   "wants to stay in your Poké Ball.\r")
            togglefollowingpokemonmovement(0)
            waitfollowingpokemonmovement
            followingpokemonmovement(55)
            if (var(VAR_TEMP_x4005) == 3) {
                applymovement(obj_player, IlexForest_Movement_PlayerWalkDown3)
            } else {
                applymovement(obj_player, IlexForest_Movement_PlayerWalkDown4)
            }
            waitmovement
            waitfollowingpokemonmovement
            togglefollowingpokemonmovement(1)
            followingpokemonmovement(48)
            if (var(VAR_TEMP_x4008) == 0) {
                callstd(std_fade_end_pichu_music)
            }
            givespikyearpichu
            removeobject(obj_D36R0101_tsure_poke_static_pichu_spiky)
            setvar(VAR_UNK_412B, 2)
            playfanfare(SEQ_ME_SHINKAOME)
            npcmsg("Spiky-eared PICHU has joined\n"
                   "your party!")
            waitfanfare
            touchscreenmenuhide
            npcmsg("Would you like to give a nickname\n"
                   "to the Spiky-eared PICHU? {YESNO 0}")
            getmenuchoice(VAR_SPECIAL_RESULT)
            if (var(VAR_SPECIAL_RESULT) != 1) {
                closemessage
                getpartycount(VAR_TEMP_x4009)
                subvar(VAR_TEMP_x4009, 1)
                setvar(VAR_TEMP_x400A, 0)
                nopvar490(VAR_TEMP_x4009)
                fadescreen(6, 1, 0, RGB_BLACK)
                waitfade
                nicknameinput(VAR_TEMP_x4009, VAR_TEMP_x400A)
                fadescreen(6, 1, 1, RGB_BLACK)
                waitfade
                if (var(VAR_TEMP_x400A) != 1) {
                    bufferpartymonnick(0, VAR_TEMP_x4009)
                    npcmsg("You named it {STRVAR_1 1, 0, 0}?\n"
                           "Such a cute name!\r")
                }
            }
            npcmsg("Being with friends should make it happy.\n"
                   "Take good care of it.\r")
            closemessage
            touchscreenmenushow
            if (var(VAR_TEMP_x4005) == 3) {
                applymovement(obj_D36R0101_gsoldman1, IlexForest_Movement_LyraWalkDownLeft)
            } else {
                applymovement(obj_D36R0101_gsoldman1, IlexForest_Movement_LyraWalkLeftUp)
            }
            waitmovement
            removeobject(obj_D36R0101_gsoldman1)
            setflag(FLAG_HIDE_ILEX_FOREST_OLD_MAN)
            return
        _1AFB:
            npcmsg("You are carrying a lot of Pokémon.\r"
                   "Why don’t you store one of them\n"
                   "at the Pokémon Center?\f"
                   "I will take care of it in the mean time.")
            waitbuttonpress
            closemessage
            if (var(VAR_TEMP_x4008) == 0) {
                callstd(std_fade_end_pichu_music)
            }
            setvar(VAR_UNK_412B, 1)
            return
        }
        goto(_1803)
        goto(_1803)
    }
    goto(_17C1)
    goto(_17C1)
}

text msg_0115_D36R0101_00043 {
    "Spiky-eared PICHU: Zapzap chu!\r"
}

text msg_0115_D36R0101_00052 {
    "Oh, here it is!\n"
    "Young Pokémon Trainer,\f"
    "I will give you this Poké Ball.\r"
    "I used to use them when I was younger.\r"
    "Don’t worry.\n"
    "It’s still in good condition.\r"
}

script IlexForest_EventScript_Pichu {
    followmonresetmovement
    lockall
    setvar(VAR_TEMP_x4008, 1)
    getplayerfacing(VAR_TEMP_x4005)
    if (var(VAR_TEMP_x4005) == 3) {
        applymovement(obj_D36R0101_tsure_poke_static_pichu_spiky, IlexForest_Movement_PichuFaceLeft)
    } elif (var(VAR_TEMP_x4005) == 2) {
        applymovement(obj_D36R0101_tsure_poke_static_pichu_spiky, IlexForest_Movement_PichuFaceRight3)
    } else {
        applymovement(obj_D36R0101_tsure_poke_static_pichu_spiky, IlexForest_Movement_PichuFaceDown)
    }
    waitmovement
    playcry(SPECIES_PICHU, 0)
    npcmsg(msg_0115_D36R0101_00043)
    waitcry
    closemessage
    call(_1987)
    if (var(VAR_SPECIAL_x8004) < 1) {
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(55)
        getplayerfacing(VAR_TEMP_x4005)
        if (var(VAR_TEMP_x4005) == 3) {
            applymovement(obj_D36R0101_gsoldman1, IlexForest_Movement_LyraFaceLeft)
        } elif (var(VAR_TEMP_x4005) == 2) {
            applymovement(obj_D36R0101_gsoldman1, IlexForest_Movement_LyraFaceRight)
        } else {
            applymovement(obj_D36R0101_gsoldman1, IlexForest_Movement_LyraFaceDown)
        }
        waitmovement
        npcmsg(msg_0115_D36R0101_00052)
        closemessage
        getplayerfacing(VAR_TEMP_x4005)
        if (var(VAR_TEMP_x4005) == 3) {
            applymovement(obj_player, IlexForest_Movement_PlayerWalkUp2)
        } elif (var(VAR_TEMP_x4005) == 2) {
            applymovement(obj_player, IlexForest_Movement_PlayerWalkUp3)
        } else {
            applymovement(obj_player, IlexForest_Movement_PlayerWalkRightUp2)
        }
        waitmovement
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
        call(_19CF)
    } else {
        npcmsg("...Your party is full!\r"
               "First go store a Pokémon in a PC Box.")
        waitbuttonpress
        closemessage
    }
    releaseall
    end
}

