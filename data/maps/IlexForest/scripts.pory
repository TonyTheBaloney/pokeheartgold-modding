movement _exclaim_face_down {
    face_down
    emote_exclamation_mark
}

movement _exclaim_face_up {
    face_up
    emote_exclamation_mark
}

movement _exclaim_face_left {
    face_left
    emote_exclamation_mark
}

movement _exclaim_face_right {
    face_right
    emote_exclamation_mark
}

movement _farfetchd_run_up {
    emote_exclamation_mark
    walk_fast_up * 10
    face_down
}

movement _farfetchd_run_down {
    emote_exclamation_mark
    walk_fast_down * 10
    face_up
}

movement _farfetchd1_run_right {
    emote_exclamation_mark
    walk_fast_right * 7
    face_left
}

movement _farfetchd1_run_left {
    emote_exclamation_mark
    walk_fast_left * 7
    face_right
}

movement _farfetchd2_run_right {
    emote_exclamation_mark
    walk_fast_right * 8
    face_left
}

movement _farfetchd2_run_left {
    emote_exclamation_mark
    walk_fast_left * 8
    face_right
}

