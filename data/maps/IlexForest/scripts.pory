    walk_left
    walk_up * 2
    walk_left * 3
    walk_in_place_right
}

movement IlexForest_Movement_KimonoGirlFaceLeft {
    walk_in_place_left
}

movement IlexForest_Movement_KimonoGirlWalkLeft {
    walk_left
}

movement IlexForest_Movement_KimonoGirlFaceDown {
    walk_in_place_down
}

movement IlexForest_Movement_FollowMonWalkRightDown1 {
    walk_right * 3
    walk_down * 2
    walk_right
    walk_down
    walk_in_place_right
}

movement IlexForest_Movement_KimonoGirlWalkLeftUp {
    walk_left * 2
    walk_up * 2
    walk_left * 6
}

script IlexForest_EventScript_PokefanM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 5)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == DIR_NORTH) {
        applymovement(obj_player, IlexForest_Movement_PlayerWalkRightUp1)
        applymovement(obj_D36R0101_gsmiddleman1, IlexForest_Movement_PokefanMFaceUp)
    } elif (var(VAR_SPECIAL_RESULT) == DIR_SOUTH) {
        applymovement(obj_player, IlexForest_Movement_PlayerWalkUp1)
    } elif (var(VAR_SPECIAL_RESULT) == DIR_EAST) {
        applymovement(obj_player, IlexForest_Movement_PlayerWalkUpRight)
        applymovement(obj_D36R0101_gsmiddleman1, IlexForest_Movement_PokefanMFaceUp)
    } else {
        stopse(SEQ_SE_GS_N_SESERAGI)
        applymovement(obj_player, IlexForest_Movement_PlayerWalkUpLeft)
        applymovement(obj_D36R0101_gsmiddleman1, IlexForest_Movement_PokefanMFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, IlexForest_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(8)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

