script IlexForest_EventScript_LyraScene {
    followmonresetmovement
    lockall
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_D36R0101_var_1, IlexForest_Movement_FriendFaceRight)
    applymovement(obj_player, IlexForest_Movement_PlayerWalkDown5)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    gendermsgbox("Lyra: Traveling through time\n"
                 "sure doesn’t feel good.\r", "Ethan: Traveling through time\n"
                                              "sure doesn’t feel good.\r")
    closemessage
    applymovement(obj_D36R0101_tsure_poke_static_marill, IlexForest_Movement_MarillJumpRight)
    waitmovement
    callstd(std_play_friend_music)
    applymovement(obj_D36R0101_var_1, IlexForest_Movement_FriendExclamation)
    waitmovement
    gendermsgbox("Hey, my MARILL!\r", "Hey, my MARILL!\r")
    closemessage
    applymovement(obj_D36R0101_var_1, IlexForest_Movement_FriendWalkLeft)
    waitmovement
    gendermsgbox("I missed you so much!\r"
                 "Wait a sec...\n"
                 "So we must be back to our time!\r", "I thought I would never see you again!\r"
                                                      "Wait a sec...\n"
                                                      "So we must be back to our time!\r")
    closemessage
    applymovement(obj_D36R0101_var_1, IlexForest_Movement_FriendWalkRight)
    applymovement(obj_D36R0101_tsure_poke_static_marill, IlexForest_Movement_MarillWalkRight)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("It was all so bizarre.\n"
                 "But now that we are safely back to our\f"
                 "time and Team Rocket’s terrible design\f"
                 "fell through, we can say...\f"
                 "all’s well that ends well, right?\r"
                 "{STRVAR_1 3, 0, 0}, you never cease to\n"
                 "inspire great adventures!\r"
                 "It sure was an exhausting day, though.\n"
                 "I better get going.\r"
                 "See you!\r", "It was all so bizarre.\n"
                               "But now that we are safely back to our\f"
                               "time and Team Rocket’s terrible design\f"
                               "fell through, we can say...\f"
                               "all’s well that ends well, right?\r"
                               "{STRVAR_1 3, 0, 0}, you never cease to\n"
                               "inspire great adventures!\r"
                               "It sure was an exhausting day, though.\n"
                               "I better get going.\r"
                               "See you!\r")
    closemessage
    applymovement(obj_D36R0101_var_1, IlexForest_Movement_FriendWalkLeftUp)
    applymovement(obj_D36R0101_tsure_poke_static_marill, IlexForest_Movement_MarillWalkLeftUp)
    waitmovement
    callstd(std_fade_end_friend_music)
    touchscreenmenushow
    setvar(VAR_UNK_40FE, 5)
    removeobject(obj_D36R0101_var_1)
    removeobject(obj_D36R0101_tsure_poke_static_marill)
    setflag(FLAG_HIDE_ILEX_FOREST_FRIEND)
    releaseall
    end
}

