script Route32_Pokecenter_1F_EventScript_Fisherman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_OLD_ROD)) {
        npcmsg("When you want to go fishing,\n"
               "face the water and use the Rod first.\r"
               "Then concentrate and look closely\n"
               "at the water!\r"
               "An “!” appears when a Pokémon\n"
               "has taken a bite!\r"
               "Press the A Button quickly to pull back\n"
               "on the line.\r"
               "You’ll see what happens next.\n")
        waitbuttonpress
        closemessage
        releaseall
        end
    _0097:
        callstd(std_bag_is_full)
        closemessage
        releaseall
        end
    }
    npcmsg("This area is great for fishing.\n"
           "Looking at all those people fishing,\f"
           "did you feel like you wanted to try\f"
           "fishing, too?\r"
           "Would you like one of my Rods? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0058) }
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Oh. That’s rather disappointing...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    end
_0058:
    if (!itemspace(ITEM_OLD_ROD, 1)) { goto(_0097) }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_OLD_ROD)
    npcmsg("When you want to go fishing,\n"
           "face the water and use the Rod first.\r"
           "Then concentrate and look closely\n"
           "at the water!\r"
           "An “!” appears when a Pokémon\n"
           "has taken a bite!\r"
           "Press the A Button quickly to pull back\n"
           "on the line.\r"
           "You’ll see what happens next.\r"
           "If there’s water, be it the sea or\n"
           "a stream, try out your Rod.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route32_Pokecenter_1F_EventScript_PokefanM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_LURE_BALL_FROM_ROUTE_32_KURT_FAN)) {
        npcmsg("Kurt is the hero of every Apricorn\n"
               "collector out there.\r"
               "If you are to go to Azalea Town,\n"
               "be sure to visit him.\r"
               "Apricorn, Apricornier, Apricorniest!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Bonjour.\n"
           "How are you?\f"
           "Are you picking Apricorns? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Way to go, little Apricorn collector!\r"
               "I feel so great, I want to give\n"
               "you this!\r")
    } else {
        npcmsg("How come? What a waste!\r"
               "I will show you how great\n"
               "Apricorns are!\r"
               "Take this first.\r")
    }
    if (!itemspace(ITEM_LURE_BALL, 2)) { goto(_0117) }
    callstd(std_give_item_verbose)
    npcmsg("Lure Ball!\n"
           "This Poké Ball makes it easy to catch\f"
           "the Pokémon that appear when you\f"
           "go fishing!\r"
           "Actually, this is made from Apricorns.\n"
           "Consider those two as small gifts\f"
           "from me.\r"
           "If you want more, go to Azalea Town.\n"
           "A man called Kurt can make special\f"
           "Poké Balls out of Apricorns.\r"
           "Apricorns rule!")
    waitbuttonpress
    closemessage
    releaseall
    setflag(FLAG_GOT_LURE_BALL_FROM_ROUTE_32_KURT_FAN)
    end
_0117:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

