    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    setflag(FLAG_HIDE_BURNED_TOWER_B1F_RAIKOU)
    setflag(FLAG_HIDE_BURNED_TOWER_B1F_ENTEI)
    setflag(FLAG_HIDE_BURNED_TOWER_B1F_SUICUNE)
    removeobject(obj_D18R0102_tsure_poke_static_raikou)
    removeobject(obj_D18R0102_tsure_poke_static_entei)
    removeobject(obj_D18R0102_tsure_poke_static_suicune)
    createroamer(0)
    createroamer(1)
    wait(15, VAR_SPECIAL_RESULT)
    clearflag(FLAG_HIDE_BURNED_TOWER_B1F_EUSINE)
    playse(SEQ_SE_DP_KAIDAN2)
    addobject(obj_D18R0102_minaki)
