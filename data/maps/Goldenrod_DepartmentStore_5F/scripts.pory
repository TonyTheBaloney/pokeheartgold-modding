script scr_seq_T25R1005_006 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_08E)) { goto(_0219) }
    getpartyleadalive(VAR_SPECIAL_x8000)
    buffermonspeciesname(0, VAR_SPECIAL_x8000)
    npcmsg("Hello. Oh, your Pokémon...\r")
    mongetfriendship(VAR_SPECIAL_RESULT, VAR_SPECIAL_x8000)
    if (var(VAR_SPECIAL_RESULT) >= 149) {
        npcmsg("It’s very attached to you.\r"
               "This move should be perfect for a\n"
               "pair like you.\r")
        setvar(VAR_SPECIAL_x8004, 354)
        setvar(VAR_SPECIAL_x8005, 1)
        callstd(std_obtain_item_verbose)
        closemessage
        goto(_0219)
    }
    if (var(VAR_SPECIAL_RESULT) <= 50) {
        npcmsg("It looks a little bit evil.\n"
               "How about this TM for it?\r")
        setvar(VAR_SPECIAL_x8004, 348)
        setvar(VAR_SPECIAL_x8005, 1)
        callstd(std_obtain_item_verbose)
        closemessage
        goto(_0219)
    _0219:
        npcmsg("There are sure to be TMs that are\n"
               "just perfect for your Pokémon.")
        setflag(FLAG_UNK_08E)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("It’s adorable!\r"
           "You should teach it good TM moves.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

