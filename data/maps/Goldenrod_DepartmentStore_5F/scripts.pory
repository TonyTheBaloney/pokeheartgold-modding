}

script scr_seq_T25R1005_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("You shouldn’t wear a black suit like\n"
               "that. People will think you are a part\f"
               "of Team Rocket.\r"
               "What? You are one of them?")
    } else {
        npcmsg("You can’t rename a Pokémon you get in\n"
               "a trade.\r"
               "The name is a reflection of the original\n"
               "Trainer’s feelings for it.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25R1005_002 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("Team Rocket...\n"
               "Why are they here?")
    } else {
        npcmsg("On Sundays, a lady comes to check\n"
               "out Pokémon.\r"
               "She even gives away TMs!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25R1005_003 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_SYS_ROCKET_COSTUME)) {
        npcmsg("Huh? You...are part of Team Rocket?\n"
               "Since when?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_TRADE_GOLDENROD_CITY_DROWZEE_MACHOP)) { goto(_0172) }
    npcmsg("I collect Pokémon.\n"
           "Do you have a DROWZEE?\r"
           "Want to trade it for my MACHOP? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_00F6) }
    goto(_0167)
_00F6:
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    choosepartymonfortrade
    getpartyselection(VAR_SPECIAL_RESULT)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_RESULT) == 255) { goto(_0167) }
    loadnpctrade(1)
    copyvar(VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT)
    getpartymonspecies(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    npctradegetreqspecies(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_x8005) != VAR_SPECIAL_RESULT) { goto(_015A) }
    npctradeexec(VAR_SPECIAL_x8004)
    npctradeend
    setflag(FLAG_TRADE_GOLDENROD_CITY_DROWZEE_MACHOP)
    npcmsg("Yay! I got myself a DROWZEE!\f"
           "Thanks!")
    waitbuttonpress
    closemessage
    releaseall
    end
_015A:
    npctradeend
    npcmsg("Huh? That’s not DROWZEE.\n"
           "What a letdown...")
    waitbuttonpress
    closemessage
    releaseall
    end
_0167:
    npcmsg("You don’t want to trade? Aww...")
    waitbuttonpress
    closemessage
    releaseall
    end
_0172:
    npcmsg("Hi, how’s my old MACHOP doing?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

