script PokeathlonDome_EventScript_Youngster {
    simplenpcmsg("Running and jumping and...\n"
                 "There are so many events for Pokémon\f"
                 "to choose from. Which one should I try?")
    end
}

script PokeathlonDome_EventScript_Oddish {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_ODDISH, 0)
    npcmsg("ODDISH: Odd! Odd!")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

