script scr_seq_D49_003 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getpokeathlonstat(12, VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) >= 1) {
        if (flag(FLAG_UNK_154)) { goto(_07CB) }
        npcmsg("Huff huff!\n"
               "Everyday training is the sure way\f"
               "to glory!\r"
               "Dashing 1,000 times!\n"
               "That’s my goal for now.\r")
        getpokeathlonstat(16, VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) >= 1000) {
            npcmsg("............\n"
                   "Oh, you have done the dash 1,000 times?\r"
                   "I thought it was basically impossible,\n"
                   "but you make me feel courageous.\r"
                   "Thank you!\n"
                   "Please take this!\r")
            if (!itemspace(ITEM_RARE_CANDY, 1)) {
                callstd(std_bag_is_full)
                closemessage
                releaseall
                end
            }
            callstd(std_give_item_verbose)
            adjustpokeathlonstat11(0, 100)
            setflag(FLAG_UNK_154)
        _07CB:
            npcmsg("I’ve become your fan! I would run\n"
                   "anywhere for you!\f"
                   "I’ll be supporting you!")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("What’s your goal?\n"
               "Having a goal lets you enjoy life more.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("It’s not good at battles...but no\n"
           "Pokémon can beat it at running, thanks\f"
           "to the walk we take every morning!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

