        applymovement(obj_D49_tsure_poke_static_poliwrath, PokeathlonDome_Movement_PoliwrathWalkDownUp)
        applymovement(obj_player, PokeathlonDome_Movement_PlayerWalkUp1)
    } elif (var(VAR_TEMP_x4000) == 43) {
