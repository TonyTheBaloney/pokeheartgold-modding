    } else {
        applymovement(obj_D49_thlonowner, PokeathlonDome_Movement_MagnusWalkDownRight3)
        applymovement(obj_D49_tsure_poke_static_poliwrath, PokeathlonDome_Movement_PoliwrathWalkRightDown7)
    }
    waitmovement
    npcmsg("Hmmm...\r")
    closemessage
    applymovement(obj_D49_thlonowner, PokeathlonDome_Movement_MagnusWalkDown1)
    applymovement(obj_D49_tsure_poke_static_poliwrath, PokeathlonDome_Movement_MagnusWalkDown1)
    waitmovement
    playeronbikecheck(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("I feel it!\r"
               "The twinkle in your eyes!\n"
               "The twinkle of friendship!\r"
               "You’re ready to participate in the\n"
               "Pokéathlon, bud!\r"
               "Most of all, your mutual trust and\n"
               "teamwork with Pokémon makes me\f"
               "believe anything is possible!\r"
               "All right. Follow me, bud!\r")
    } else {
        getpartyleadalive(VAR_SPECIAL_x8000)
        buffermonspeciesname(1, VAR_SPECIAL_x8000)
        npcmsg("I feel it!\r"
               "The twinkle in your eyes!\n"
               "The twinkle of friendship!\r"
               "You’re quite something.\n"
               "Your {STRVAR_1 0, 1, 0} is quite a Pokémon!\r"
               "It’s ready to participate in the\n"
               "Pokéathlon, bud!\r"
               "Most of all, your solidarity with and\n"
               "trust of Pokémon makes me\f"
               "believe in infinite potential!\r"
               "All right. Follow me!\r")
    }
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    if (var(VAR_TEMP_x4000) == 40) {
        applymovement(obj_D49_thlonowner, PokeathlonDome_Movement_MagnusWalkRightUp2)
        applymovement(obj_D49_tsure_poke_static_poliwrath, PokeathlonDome_Movement_PoliwrathWalkDownRight2)
        applymovement(obj_player, PokeathlonDome_Movement_PlayerWalkUpRight2)
    } elif (var(VAR_TEMP_x4000) == 41) {
        applymovement(obj_D49_thlonowner, PokeathlonDome_Movement_MagnusWalkRightUp3)
        applymovement(obj_D49_tsure_poke_static_poliwrath, PokeathlonDome_Movement_PoliwrathWalkDownRight3)
        applymovement(obj_player, PokeathlonDome_Movement_PlayerWalkUpRight3)
    } elif (var(VAR_TEMP_x4000) == 42) {
