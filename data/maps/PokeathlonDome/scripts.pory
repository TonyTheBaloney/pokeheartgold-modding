    closemessage
    getplayercoords(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    createcameratarget(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    applymovement(241, PokeathlonDome_Movement_ObjectWalkUp)
    waitmovement
    npcmsg("Pokéathlon is a sports festival for\n"
           "Trainers and Pokémon!\r"
           "Inside the Dome are various challenges\n"
           "awaiting Trainers and Pokémon to test\f"
           "their friendship.\f"
           "Why don’t you try it?\r")
    closemessage
    applymovement(241, PokeathlonDome_Movement_ObjectWalkDown)
    waitmovement
    removecameratarget
    npcmsg("You’re amazing, bud!\n"
           "This is a pleasant surprise!\r"
           "To see a Pokéathlete with strong\n"
           "potential is such a pleasure! I’m glad\f"
           "I held the Pokéathlon here in Johto.\r"
           "...My name is Magnus.\n"
           "We shall meet again, bud.\r"
           "Magnus: See you, young Pokéathlete!\r")
