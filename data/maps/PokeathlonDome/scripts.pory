    applymovement(obj_D49_thlonowner, PokeathlonDome_Movement_MagnusWalkUp2)
    applymovement(obj_D49_tsure_poke_static_poliwrath, PokeathlonDome_Movement_PoliwrathWalkRightUp)
    waitmovement
    dooranimationload(1, 0, 10, 22, 77)
    dooranimationopen(77)
    dooranimationwait(77)
    applymovement(obj_D49_thlonowner, PokeathlonDome_Movement_MagnusWalkUp3)
    applymovement(obj_D49_tsure_poke_static_poliwrath, PokeathlonDome_Movement_PoliwrathWalkUp)
    waitmovement
    removeobject(obj_D49_thlonowner)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    applymovement(obj_D49_tsure_poke_static_poliwrath, PokeathlonDome_Movement_PoliwrathFaceDown)
    waitmovement
    playcry(SPECIES_POLIWRATH, 0)
    waitcry
    applymovement(obj_D49_tsure_poke_static_poliwrath, PokeathlonDome_Movement_PoliwrathWalkUp)
    waitmovement
    removeobject(obj_D49_tsure_poke_static_poliwrath)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    dooranimationclose(77)
    dooranimationwait(77)
    dooranimationunload(77)
    releaseall
    setvar(VAR_UNK_40DB, 1)
    setflag(FLAG_UNK_225)
    setflag(FLAG_UNK_982)
    end
}

