script PokeathlonDome_EventScript_Clerk {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_UNK_997)) { goto(_093E) }
    npcmsg("Energy drink!\n"
           "Welcome to the Aprijuice stand!\r"
           "Are you giving your Pokémon Aprijuice?\n"
           "I can explain anything you\f"
           "need to know about it! {YESNO 0}")
_08D1:
    touchscreenmenuhide
    menuinitstdgmm(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(326, 255, 0)
    menuitemadd(327, 255, 1)
    menuitemadd(157, 255, 2)
    menuexec
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Aprijuice improves a Pokémon’s\n"
               "Performance! Pokémon have strengths\f"
               "and weaknesses.\r"
               "But there is no need to worry. Give it\n"
               "Aprijuice, and you can max out its\f"
               "Performance!\r"
               "You will need it!\r"
               "Do you have any more questions? {YESNO 0}")
        goto(_08D1)
        end
    }
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Choose from the three Apriblenders.\r"
               "The labels tell you what kind of drink\n"
               "it is. Different drinks have\f"
               "different effects.\r"
               "You should use them to suit the event\n"
               "you want to participate in. That’s how\f"
               "to make a top Pokéathlete.\r"
               "But remember this!\n"
               "If your Pokémon’s Performance is maxed\f"
               "out, you cannot make it higher.\r"
               "You should check your Pokémon’s\n"
               "Performance before you\f"
               "give it Aprijuice.\r"
               "Do you have any more questions? {YESNO 0}")
        goto(_08D1)
        end
    _0933:
        npcmsg("Charge yourself with friendship!\n"
               "Get in the know about Aprijuice!\f"
               "Pick one from the shelf!")
        waitbuttonpress
        closemessage
        releaseall
        end
    _093E:
        npcmsg("Energy drink!\n"
               "Welcome to the Aprijuice stand!\r"
               "Huh? What’s that confused look about?\n"
               "You don’t know about Aprijuice?\f"
               "There, take this!\r")
        bufferplayersname(0)
        npcmsg("{STRVAR_1 3, 0, 0} received\n"
               "the Apriblender!")
        playfanfare(SEQ_ME_KEYITEM)
        waitfanfare
        npcmsg("You put away the Apriblender\n"
               "in the Apricorn Box.\r")
        setflag(FLAG_UNK_997)
        npcmsg("When you have the Apriblender, you can\n"
               "make Aprijuice to let your Pokémon show\f"
               "their true potential!\r"
               "It’s so easy to make! All you have to\n"
               "do is to put Apricorns in the\f"
               "Apriblender. Put in as many as you can!\r"
               "The more, the merrier!\n"
               "Then you walk!\r"
               "You can run if you want...\n"
               "98...99...100 steps!\r"
               "Here! Then you open it, give it to your\n"
               "Pokémon, or drink it yourself.\r"
               "You can buy Aprijuice here.\n"
               "Why don’t you try and see how it works?\r"
               "Do you have any more questions? {YESNO 0}")
        goto(_08D1)
        end
    _095F:
        applymovement(obj_D49_shopm1_2, PokeathlonDome_Movement_ClerkExclamation)
        waitmovement
        npcmsg("Hi! What can I do for you?\r")
        closemessage
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(55)
        if (var(VAR_TEMP_x4007) == 0) {
            applymovement(obj_player, PokeathlonDome_Movement_PlayerWalkRight1)
        } elif (var(VAR_TEMP_x4007) == 1) {
            applymovement(obj_player, PokeathlonDome_Movement_PlayerWalkRight2)
        } else {
            applymovement(obj_player, PokeathlonDome_Movement_PlayerWalkRight3)
        }
        waitmovement
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
        applymovement(obj_D49_shopm1_2, PokeathlonDome_Movement_ClerkFaceDown)
        waitmovement
        goto(_093E)
        end
    }
    goto(_0933)
    closemessage
    releaseall
    end
}

movement PokeathlonDome_Movement_ClerkExclamation {
    face_left
    emote_exclamation_mark
}

movement PokeathlonDome_Movement_PlayerWalkRight1 {
    walk_right * 3
    walk_in_place_up
}

movement PokeathlonDome_Movement_PlayerWalkRight2 {
    walk_right * 2
    walk_in_place_up
}

movement PokeathlonDome_Movement_PlayerWalkRight3 {
    walk_right
    walk_in_place_up
}

script PokeathlonDome_EventScript_Sign1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    setvar(VAR_TEMP_x4007, 0)
    if (!flag(FLAG_UNK_997)) { goto(_095F) }
_0A1D:
    showmoneybox(21, 1)
    getapricornjuiceoffer(VAR_TEMP_x4007, VAR_SPECIAL_x8000, VAR_SPECIAL_x8001, VAR_SPECIAL_x8002)
    applymovement(obj_D49_shopm1_2, PokeathlonDome_Movement_ClerkFaceLeft)
    waitmovement
    npcmsg("So discerning of you!\n"
           "{STRVAR_1 3, 0, 0}’s {STRVAR_1 8, 1, 0}!\f"
           "Only ${STRVAR_1 53, 2, 0}! Quite a bargain! {YESNO 0}")
_0A3A:
    touchscreenmenuhide
    menuinitstdgmm(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(328, 255, 0)
    menuitemadd(329, 255, 1)
    menuitemadd(44, 255, 2)
    menuexec
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 2) { goto(_0AD6) }
    if (var(VAR_SPECIAL_RESULT) == 1) {
        if (var(VAR_SPECIAL_x8002) >= 2000) {
            npcmsg("Owner’s Comment\n"
                   "{STRVAR_1 8, 1, 0} of the legendary\f"
                   "Pokéathlete!\r"
                   "It grew side by side with {STRVAR_1 3, 0, 0}!\r"
                   "The road to victory is shown when you\n"
                   "drink it! This will make you a legend!\r")
            goto(_0B89)
        _0B89:
            npcmsg("Its richness is {STRVAR_1 52, 3, 0}!\n"
                   "Its smoothness is {STRVAR_1 52, 4, 0}!\r")
            npcmsg("{STRVAR_1 3, 0, 0}’s {STRVAR_1 8, 1, 0}!\n"
                   "Only ${STRVAR_1 53, 2, 0}! Quite a bargain! {YESNO 0}")
            goto(_0A3A)
            end
        }
        if (var(VAR_SPECIAL_x8002) >= 1000) { goto(_0B77) }
        if (var(VAR_SPECIAL_x8002) >= 500) { goto(_0B6E) }
        if (var(VAR_SPECIAL_x8002) >= 300) { goto(_0B65) }
        if (var(VAR_SPECIAL_x8002) >= 200) { goto(_0B5C) }
        if (var(VAR_SPECIAL_x8002) >= 100) { goto(_0B53) }
        goto(_0B4A)
    _0B4A:
        npcmsg("Owner’s Comment\n"
               "Somebody, somewhere put it together!\f"
               "The mysterious {STRVAR_1 8, 1, 0}!\r"
               "It may go up.\n"
               "It may go down.\f"
               "May your luck be with this juice!\r")
        goto(_0B89)
    _0B53:
        npcmsg("Owner’s Comment\n"
               "Not many people know about it!\r"
               "It’s the newcomer Pokéathlete\n"
               "{STRVAR_1 3, 0, 0}’s {STRVAR_1 8, 1, 0}!\r"
               "It’s a long way to perfection!\n"
               "But it’s irresistible to some!\f"
               "It’s a gleam of {STRVAR_1 8, 1, 0}!\r")
        goto(_0B89)
    _0B5C:
        npcmsg("Owner’s Comment\n"
               "You know who’s around here!\r"
               "This {STRVAR_1 8, 1, 0} is what has helped\n"
               "make you-know-who who they\f"
               "are today!\f"
               "Try it if you feel sluggish!\r")
        goto(_0B89)
    _0B65:
        npcmsg("Owner’s Comment\n"
               "You don’t know it?\f"
               "That’s the last thing you want to hear!\r"
               "It is time you try {STRVAR_1 3, 0, 0}’s\n"
               "{STRVAR_1 8, 1, 0}, the sign of a new era!\r")
        goto(_0B89)
    _0B6E:
        npcmsg("Owner’s Comment\n"
               "{STRVAR_1 8, 1, 0} was developed by\f"
               "that popular Pokéathlete!\r"
               "You may never be able to shake hands,\n"
               "but you can still drink the same juice!\r"
               "This is a must-buy juice for every\n"
               "Pokéathlete!\r")
        goto(_0B89)
    _0B77:
        npcmsg("Owner’s Comment\n"
               "{STRVAR_1 8, 1, 0}!\f"
               "Developed by that elite Pokéathlete!\r"
               "You may never see it again.\n"
               "If you won’t win today, when will you?\r"
               "For those who want to win today, here\n"
               "is the juice of victory!\r")
        goto(_0B89)
    }
    hasenoughmoneyvar(VAR_SPECIAL_RESULT, VAR_SPECIAL_x8001)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0AEB) }
    npcmsg("Thank you!\n"
           "Which Pokémon do you want to give it to?\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    hidemoneybox
    launchapricornboxforjuice(VAR_SPECIAL_x8000, VAR_SPECIAL_x8003)
    restoreoverworld
    showmoneybox(21, 1)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_x8003) == 0) {
        npcmsg("That’s a pity!\n"
               "Come back when you want to win!\r")
    } else {
        submoneyvar(VAR_SPECIAL_x8001)
        updatemoneybox
    _0AD6:
        npcmsg("Charge yourself with friendship!\n"
               "Come back again when you want more!\r")
    }
_0AD9:
    closemessage
    hidemoneybox
    applymovement(obj_D49_shopm1_2, PokeathlonDome_Movement_ClerkFaceDown)
    waitmovement
    releaseall
    end
_0AEB:
    npcmsg("Oh, you don’t have enough money!\r")
    goto(_0AD9)
    end
}

