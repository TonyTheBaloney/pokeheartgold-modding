movement PokeathlonDome_Movement_PlayerWalkRightUp {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement PokeathlonDome_Movement_PlayerWalkUp2 {
    walk_up * 3
    walk_in_place_down
}

movement PokeathlonDome_Movement_PlayerWalkUpLeft4 {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement PokeathlonDome_Movement_PlayerWalkUpRight4 {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

