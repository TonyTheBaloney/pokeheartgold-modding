        applymovement(obj_D49_tsure_poke_static_poliwrath, PokeathlonDome_Movement_PoliwrathWalkDownLeft1)
        applymovement(obj_player, PokeathlonDome_Movement_PlayerWalkUpLeft1)
    } elif (var(VAR_TEMP_x4000) == 44) {
        applymovement(obj_D49_thlonowner, PokeathlonDome_Movement_MagnusWalkLeftUp2)
        applymovement(obj_D49_tsure_poke_static_poliwrath, PokeathlonDome_Movement_PoliwrathWalkDownLeft2)
        applymovement(obj_player, PokeathlonDome_Movement_PlayerWalkUpLeft2)
    } elif (var(VAR_TEMP_x4000) == 39) {
        applymovement(obj_D49_thlonowner, PokeathlonDome_Movement_MagnusWalkRightUp1)
        applymovement(obj_D49_tsure_poke_static_poliwrath, PokeathlonDome_Movement_PoliwrathWalkDownRight1)
        applymovement(obj_player, PokeathlonDome_Movement_PlayerWalkUpRight1)
    } else {
        applymovement(obj_D49_thlonowner, PokeathlonDome_Movement_MagnusWalkLeftUp3)
        applymovement(obj_D49_tsure_poke_static_poliwrath, PokeathlonDome_Movement_PoliwrathWalkDownLeft3)
        applymovement(obj_player, PokeathlonDome_Movement_PlayerWalkUpLeft3)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
