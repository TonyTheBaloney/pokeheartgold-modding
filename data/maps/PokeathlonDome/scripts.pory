script scr_seq_D49_001 {
    simplenpcmsg("Running and jumping and...\n"
                 "There are so many events for Pokémon\f"
                 "to choose from. Which one should I try?")
    end
}

script scr_seq_D49_007 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_ODDISH, 0)
    npcmsg("ODDISH: Odd! Odd!")
    waitcry
