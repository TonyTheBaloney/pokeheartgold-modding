}

script Saffron_SilphCoHq_OnResume {
    if (var(VAR_TEMP_x4009) == 1) {
        movewarp(1, 23, 2)
    }
    if (var(VAR_TEMP_x4008) == 0) {
        if (var(VAR_UNK_4130) <= 3) {
            movepersonfacing(obj_T11R0701_daigo, 22, 0, 8, DIR_NORTH)
        }
    }
    end
}

script Saffron_SilphCoHq_EventScript_Receptionist {
    simplenpcmsg("Welcome. This is Silph Co.’s\n"
                 "head office building.")
    end
}

script Saffron_SilphCoHq_EventScript_Policeman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GOT_UPGRADE_FROM_SAFFRON_CITY_GUARD)) {
        npcmsg("Hey, you! The elevator there is out of\n"
               "order now.\r"
               "Something is wrong with the electricity,\n"
               "and it won’t work right.\r"
               "I feel sorry that you wasted a trip,\n"
               "so here is a gift for you!\r")
        if (!itemspace(ITEM_UPGRADE, 1)) {
            callstd(std_bag_is_full)
            closemessage
            releaseall
            end
        }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_UPGRADE_FROM_SAFFRON_CITY_GUARD)
    }
    npcmsg("It’s Silph Co.’s latest product.\n"
           "It’s not for sale anywhere yet.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Saffron_SilphCoHq_EventScript_Steven {
    if (flag(FLAG_GOT_HOENN_STARTER_FROM_STEVEN)) { goto(_03E8) }
    if (var(VAR_UNK_4130) == 3) {
        playse(SEQ_SE_DP_SELECT)
        lockall
        faceplayer
        npcmsg("Steven: I will ask again.\n"
               "Which color do you choose? {YESNO 0}")
        goto(_022C)
    }
    playse(SEQ_SE_DP_SELECT)
    lockall
    setvar(VAR_UNK_4130, 3)
    npcmsg("Hello...\n"
           "You’re breaking up...\f"
           "I think it depends on how my dad feels.\r"
           "I see...\n"
           "I’ll be on my way. See you soon.\r")
    closemessage
    getplayerfacing(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) == 0) {
        applymovement(obj_T11R0701_daigo, Saffron_SilphCoHq_Movement_StevenFaceDown)
    } elif (var(VAR_TEMP_x4002) == 2) {
        applymovement(obj_T11R0701_daigo, Saffron_SilphCoHq_Movement_StevenFaceRight)
    } else {
        applymovement(obj_T11R0701_daigo, Saffron_SilphCoHq_Movement_StevenFaceLeft)
    }
    waitmovement
    applymovement(obj_T11R0701_daigo, Saffron_SilphCoHq_Movement_StevenExclamation)
    waitmovement
    npcmsg("Steven: You are...\n"
           "I remember your eyes.\r"
           "When I see a Trainer whose eyes\n"
           "twinkle, I always remember.\r")
    if (var(VAR_TEMP_x4002) == 0) {
        applymovement(obj_T11R0701_daigo, Saffron_SilphCoHq_Movement_StevenFaceDown)
    } elif (var(VAR_TEMP_x4002) == 2) {
        applymovement(obj_T11R0701_daigo, Saffron_SilphCoHq_Movement_StevenFaceRight)
    } else {
        applymovement(obj_T11R0701_daigo, Saffron_SilphCoHq_Movement_StevenFaceLeft)
    }
    waitmovement
    npcmsg("Steven: You have a Pokédex!\n"
           "So you are also in search of Pokémon.\f"
           "Let me see...\r"
           "I think I can help you with that.\r"
           "Let’s say that you have stones in\n"
           "front of you.\f"
           "Which color would you pick? {YESNO 0}")
_022C:
    touchscreenmenuhide
    menuinit(1, 1, 0, 1, VAR_SPECIAL_x8004)
    menuitemadd(17, 255, 0)
    menuitemadd(18, 255, 1)
    menuitemadd(19, 255, 2)
    menuitemadd(27, 255, 3)
    menuexec
    touchscreenmenushow
    Switch(VAR_SPECIAL_x8004)
    Case(3, _0346)
    getpartycount(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 6) { goto(_033B) }
    if (var(VAR_SPECIAL_x8004) == 0) {
        setvar(VAR_SPECIAL_x8004, 252)
    } elif (var(VAR_SPECIAL_x8004) == 1) {
        setvar(VAR_SPECIAL_x8004, 255)
    } else {
        setvar(VAR_SPECIAL_x8004, 258)
    }
    bufferspeciesname(1, VAR_SPECIAL_x8004, 0, 0)
    bufferplayersname(0)
    npcmsg("Steven: You chose correctly!\n"
           "I will give you {STRVAR_1 0, 1, 0}!\r")
    playfanfare(SEQ_ME_POKEGET)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the {STRVAR_1 0, 1, 0} from Steven!")
    waitfanfare
    givemon(VAR_SPECIAL_x8004, 5, 0, 0, 0, VAR_SPECIAL_RESULT)
    touchscreenmenuhide
    npcmsg("Would you like to give a nickname\n"
           "to {STRVAR_1 0, 1, 0}? {YESNO 0}")
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0351) }
    touchscreenmenushow
_02F3:
    npcmsg("Steven: Take good care of it.\n"
           "Your caring for it will make me\f"
           "very happy.\r")
    closemessage
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_T11R0701_daigo, Saffron_SilphCoHq_Movement_StevenWalkDownLeft)
    } else {
        applymovement(obj_T11R0701_daigo, Saffron_SilphCoHq_Movement_StevenWalkLeftDown)
    }
    waitmovement
    removeobject(obj_T11R0701_daigo)
    setflag(FLAG_HIDE_SAFFRON_CITY_STEVEN)
    setflag(FLAG_GOT_HOENN_STARTER_FROM_STEVEN)
    setvar(VAR_UNK_4130, 4)
    clearflag(FLAG_HIDE_STEVEN_IN_HOUSE_AFTER_LATIS)
    releaseall
    end
_033B:
    npcmsg("Steven: I see...\n"
           "For the choice you’ve made,\f"
           "I’d like to give you this Pokémon.\r"
           "Except your party is full.\r"
           "Why don’t you go to the PC to make\n"
           "some room? I’ll be waiting here.")
    waitbuttonpress
    closemessage
    releaseall
    end
_0346:
    npcmsg("Steven: You seem to be quite cautious.\r"
           "Are you avoiding any chance when a\n"
           "person might trick you?\f"
           "You really are better than I thought.")
    waitbuttonpress
    closemessage
    releaseall
    end
_0351:
    closemessage
    getpartycount(VAR_SPECIAL_RESULT)
    subvar(VAR_SPECIAL_RESULT, 1)
    setvar(VAR_TEMP_x4000, 0)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setsavedbottomscreenapp(0)
    nicknameinput(VAR_SPECIAL_RESULT, VAR_TEMP_x4000)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_TEMP_x4000) == 1) { goto(_02F3) }
    npcmsg("Steven: You did a great job naming it!\r")
    goto(_02F3)
}

movement Saffron_SilphCoHq_Movement_StevenFaceDown {
    walk_in_place_down
}

movement Saffron_SilphCoHq_Movement_StevenFaceLeft {
    walk_in_place_left
}

movement Saffron_SilphCoHq_Movement_StevenFaceRight {
    walk_in_place_right
}

movement Saffron_SilphCoHq_Movement_StevenExclamation {
    emote_exclamation_mark
}

movement Saffron_SilphCoHq_Movement_StevenWalkLeftDown {
    walk_left * 2
    walk_down * 3
    walk_left * 8
}

movement Saffron_SilphCoHq_Movement_StevenWalkDownLeft {
    walk_down * 3
    walk_left * 10
}

script(local) _03E8 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    setvar(VAR_UNK_4130, 6)
    if (var(VAR_TEMP_x400A) == 77) {
        npcmsg("Steven: Will you trade FORRETRESS\n"
               "for my BELDUM? {YESNO 0}")
    } else {
        npcmsg("Steven: We meet again!\n"
               "Have you been to Hoenn before?\r"
               "It’s such a beautiful place, with the\n"
               "clearest ocean you can imagine.\r"
               "You should visit sometime.\f"
               "Hey!\r"
               "Why don’t we trade Pokémon?\r"
               "I’ve been looking for FORRETRESS.\n"
               "I can trade my BELDUM for it. {YESNO 0}")
        setvar(VAR_TEMP_x400A, 77)
    }
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_04EA) }
    npcmsg("Steven: OK, let’s trade!\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    choosepartymonfortrade
    getpartyselection(VAR_SPECIAL_RESULT)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_RESULT) == 255) { goto(_04EA) }
    loadnpctrade(12)
    copyvar(VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT)
    mongetfriendship(VAR_TEMP_x4002, VAR_SPECIAL_x8004)
    getpartymonspecies(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    npctradegetreqspecies(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_x8005) != VAR_SPECIAL_RESULT) {
        npctradeend
        npcmsg("Steven: Are you telling me that\n"
               "you think that’s a FORRETRESS?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npctradeexec(VAR_SPECIAL_x8004)
    npctradeend
    setflag(FLAG_TRADE_STEVEN_FORRETRESS_BELDUM)
    if (var(VAR_TEMP_x4002) >= 200) {
        npcmsg("Steven: This Pokémon seems to like\n"
               "you a lot. Do you happen to like\f"
               "Steel-type Pokémon?\r"
               "I had a feeling.\n"
               "That particular texture!\r"
               "The cool and glowing bodies!\n"
               "Such uniquenesses are only for\f"
               "Steel-type Pokémon!\r"
               "When it comes to the solitariness and\n"
               "nobleness you sense through the \f"
               "rugged body, which is almost rebuffing\f"
               "when you hug, nothing comes close to\f"
               "BELDUM, I must say...\r"
               "In short, my METAGROSS is\n"
               "truly strong and cool!\r"
               "...\n"
               "Oh, it seems that I got carried away.\r"
               "It was a pleasure talking to you.\n"
               "Bye!\r")
    } else {
        npcmsg("Steven: You don’t see FORRETRESS in\n"
               "the Hoenn region.\r"
               "It’s my first time to actually see one.\n"
               "Thank you so much!\r"
               "Oh, look at the time. I really must go.\r")
    }
    closemessage
    getplayerfacing(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 0) {
        applymovement(obj_T11R0701_daigo, Saffron_SilphCoHq_Movement_StevenExit1)
    } else {
        applymovement(obj_T11R0701_daigo, Saffron_SilphCoHq_Movement_StevenExit2)
    }
    waitmovement
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    removeobject(obj_T11R0701_daigo)
    setflag(FLAG_HIDE_SAFFRON_CITY_STEVEN)
    setvar(VAR_UNK_4130, 7)
    releaseall
    end
_04EA:
    npcmsg("Steven: That’s too bad.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Saffron_SilphCoHq_Movement_StevenExit1 {
    walk_left * 2
    walk_down * 5
    walk_left
    walk_down
    set_invisible
}

movement Saffron_SilphCoHq_Movement_StevenExit2 {
    walk_down * 5
    walk_left * 3
    walk_down
    set_invisible
}

script Saffron_SilphCoHq_EventScript_Sign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("This elevator is out of order.\r"
           "It may electrocute you. Stay away.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

