        waitmovement
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
        applymovement(obj_P01R0103_seaman_2, SsAquaVermilionPortInterior_Movement_SailorWalkLeftDown)
        waitmovement
        releaseall
        end
    }
    getweekday(VAR_SPECIAL_RESULT)
