}

movement SsAquaVermilionPortInterior_Movement_SailorWalkDownRight {
    lock_dir
    walk_down
    unlock_dir
    face_left * 2
    lock_dir
    walk_right
    unlock_dir
}

movement SsAquaVermilionPortInterior_Movement_PlayerWalkDown {
    walk_down * 2
}

movement SsAquaVermilionPortInterior_Movement_SailorWalkUpRight {
    lock_dir
    walk_up
    unlock_dir
    face_left * 2
    lock_dir
    walk_right
    unlock_dir
}

movement SsAquaVermilionPortInterior_Movement_PlayerWalkUp {
    delay_8
    walk_up * 4
}

movement SsAquaVermilionPortInterior_Movement_SailorWalkLeftDown {
    walk_left
    face_down * 2
    walk_down
    walk_in_place_up
}

script SsAquaVermilionPortInterior_EventScript_Man {
    simplenpcmsg("You came from Johto?\r"
                 "I envy you!\n"
                 "I hear many rare Pokémon live\f"
                 "over there.")
    end
}

mapscripts SsAquaVermilionPortInterior_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: SsAquaVermilionPortInterior_OnTransition
}
