    goto(_0142)
    goto(_00EF)
_00D0:
    if (var(VAR_SPECIAL_RESULT) != 5) { goto(_00E9) }
    goto(_0142)
    goto(_00EF)
_00E9:
    goto(_0142)
_00EF:
    npcmsg("Welcome to the S.S. Aqua!\r"
           "Your Ticket is...right there.\n"
