        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 49)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_DAILY_GOT_SHOCK_RIBBON)) {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 51)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_NUM_MET_WEEKDAY_SIBLINGS) == 7) { goto(_01B7) }
    if (flag(FLAG_GOT_SOFT_SAND_FROM_SANTOS)) { goto(_0199) }
    getweekday(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 6) {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 23)
    } else {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 20)
        if (!itemspace(ITEM_SOFT_SAND, 1)) { goto(_01AD) }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_SOFT_SAND_FROM_SANTOS)
        addvar(VAR_NUM_MET_WEEKDAY_SIBLINGS, 1)
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 21)
    }
_0191:
    waitbuttonpress
    closemessage
    releaseall
    end
_0199:
    getstdmsgnaix(0, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 22)
    waitbuttonpress
    closemessage
    releaseall
    end
_01AD:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
_01B7:
    getweekday(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 6) { goto(_01DA) }
    getstdmsgnaix(0, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 23)
