}

script Blackthorn_EventScript_Man1 {
    simplenpcmsg("I am sorry.\r"
                 "Clair, our Gym Leader, entered\n"
                 "the Dragon’s Den behind the Gym.\r"
                 "I have no idea when our Leader\n"
                 "will return.")
    end
}

script Blackthorn_EventScript_Man2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_0D1)) {
        npcmsg("You defeated Clair?\n"
               "That’s amazing!\r"
               "I’ve never heard of her losing to\n"
               "anyone other than Lance.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Clair, our Gym Leader, is waiting\n"
           "for you.\r"
           "However, it would be impossible for\n"
           "a run-of-the-mill Trainer to win.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Blackthorn_EventScript_OldMan1 {
    simplenpcmsg("No. Only chosen Trainers may train\n"
                 "here. Please leave.")
    end
}

script Blackthorn_EventScript_OldMan2 {
    simplenpcmsg("If Clair allows it, her grandfather--\n"
                 "our Master--will also.\r"
                 "You may enter.")
    end
}

script Blackthorn_EventScript_BlackBelt {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 2) {
        npcmsg("My radio’s busted?\n"
               "Lately, I only get this weird signal.")
    } else {
        npcmsg("Arooo! Voices in my head!\r"
               "Huh? I’m listening to my radio!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Blackthorn_EventScript_PokefanM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 5)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, Blackthorn_Movement_PlayerWalkLeftUp)
        applymovement(obj_T30_gsmiddleman1, Blackthorn_Movement_PokefanMFaceUp)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, Blackthorn_Movement_PlayerWalkUp)
    } else {
        applymovement(obj_player, Blackthorn_Movement_PlayerWalkUpRight)
        applymovement(obj_T30_gsmiddleman1, Blackthorn_Movement_PokefanMFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, Blackthorn_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(44)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Blackthorn_Movement_PlayerWalkLeftUp {
    walk_left
    walk_up * 2
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement Blackthorn_Movement_PlayerWalkUp {
    walk_up * 3
    walk_in_place_down
}

movement Blackthorn_Movement_PlayerWalkUpRight {
    walk_up
    walk_right
    walk_up * 3
    walk_in_place_down
}

movement Blackthorn_Movement_PokefanMFaceUp {
    delay_8
    walk_in_place_up
}

movement Blackthorn_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

