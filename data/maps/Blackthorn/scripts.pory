script Blackthorn_OnTransition {
    if (var(VAR_UNK_40C4) == 1) {
        setflag(FLAG_HIDE_VICTORY_ROAD_CLAIR)
        setvar(VAR_UNK_40C4, 2)
    }
    if (!flag(FLAG_UNK_189)) {
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 0) {
            clearflag(FLAG_HIDE_CAMERON)
        } elif (var(VAR_TEMP_x4000) == 2) {
            clearflag(FLAG_HIDE_CAMERON)
        } else {
            setflag(FLAG_HIDE_CAMERON)
        }
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 6) {
            clearflag(FLAG_UNK_204)
        } else {
            setflag(FLAG_UNK_204)
        }
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script Blackthorn_EventScript_ProfElmCall {
    phonecall(PHONE_CONTACT_PROF__ELM, 2, 3)
    setvar(VAR_UNK_407B, 2)
    end
}

