script scr_seq_T30GYM0101_005 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_RISING, VAR_SPECIAL_RESULT)
    bufferplayersname(0)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Blackthorn City Pokémon Gym")
    } else {
        npcmsg("Blackthorn City Pokémon Gym\r"
               "Leader: Clair\n"
               "Certified Trainer!\f"
               "{STRVAR_1 3, 0, 0}")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

