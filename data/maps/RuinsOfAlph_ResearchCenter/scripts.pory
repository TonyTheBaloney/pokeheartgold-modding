text msg_0073_D24R0102_00004 {
    "The ruins are about 1,500 years old.\n"
    "That’s all we know about them.\r"
    "But it’s not known why they were\n"
    "built...or by whom."
}

script RuinsOfAlph_ResearchCenter_EventScript_SuperNerd2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkseenallletterunown(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Huh?\n"
               "I seem to be doing nothing?\r"
               "Come on!\n"
               "I may not look it, but I’m the one who\f"
               "developed the UNOWN Report!")
        goto(_0366)
    }
    countunownlettersregistered(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_03A1) }
    npcmsg("The strange Pokémon you saw in\n"
           "the ruins?\r"
           "They appear to be very much like the\n"
           "drawings on the walls there.\r"
           "Hmm...\r"
           "That must mean there are many\n"
           "different kinds of them...")
    goto(_0366)
_03A1:
    npcmsg("There are odd patterns drawn on the\n"
           "walls of the ruins.\r"
           "They must be the keys for unraveling\n"
           "the mystery of the ruins.")
    goto(_0366)
}

script RuinsOfAlph_ResearchCenter_EventScript_Sign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNOWN_REPORT_LEVEL) >= 7) {
        npcmsg("Ruins of Alph Research Report\r"
               "I dedicate this report to the\n"
               "Research Center’s founder,\f"
               "Professor Silktree...")
        goto(_0366)
    }
    checkseenallletterunown(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_03E2) }
    npcmsg("Ruins of Alph\n"
           "Exploration Year 10")
    goto(_0366)
_03E2:
    npcmsg("Mystery Pokémon\n"
           "Name: UNOWN\f"
           "A total of 26 kinds found.")
    goto(_0366)
}

script RuinsOfAlph_ResearchCenter_EventScript_Bookshelf {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("There are many academic books.\r"
           "“Mysteries of the Ancients”\n"
           "“Code-Breaking Guidebook”\f"
           "“Weathering Ruins”")
    goto(_0366)
}

