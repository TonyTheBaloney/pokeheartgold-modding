script RuinsOfAlph_ResearchCenter_EventScript_Businessman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    countunownlettersregistered(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 28) {
        npcmsg("I managed to unravel quite a lot of the\n"
               "mystery of UNOWN with your help!\r"
               "Thank you, thank you.\n"
               "Thank you, again!")
        goto(_0366)
    }
    if (var(VAR_UNK_40EC) >= 1) { goto(_008A) }
    if (!flag(FLAG_UNK_10F)) {
        npcmsg("Bravo!\r"
               "A promising youth who is about to start\n"
               "the journey of archaeology has\f"
               "just arrived!\r")
        setflag(FLAG_UNK_10F)
        getplayerfacing(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            applymovement(obj_D24R0102_suit, RuinsOfAlph_ResearchCenter_Movement_BusinessmanExclamation1)
        } else {
            applymovement(obj_D24R0102_suit, RuinsOfAlph_ResearchCenter_Movement_BusinessmanExclamation2)
        }
        waitmovement
    }
    npcmsg("What? Just a visitor?\n"
           "Oh, I see...\f"
           "You got me excited for nothing.")
    goto(_0366)
_008A:
    npcmsg("My staff here at the Ruins Research\n"
           "Center is excellent, and the research\f"
           "makes good progress with absolutely\f"
           "no effort on my part.\r"
           "If you have any questions, feel free to\n"
           "talk to my staff!")
    goto(_0366)
}

movement RuinsOfAlph_ResearchCenter_Movement_BusinessmanExclamation1 {
    face_left
    face_up
    face_right
    face_down
    face_left
    face_up
    face_right
    face_down
    face_left
    face_up
    face_right
    face_down
    face_left
    face_up
    face_right
    face_down
    emote_exclamation_mark
}

movement RuinsOfAlph_ResearchCenter_Movement_BusinessmanExclamation2 {
    face_down
    face_left
    face_up
    face_right
    face_down
    face_left
    face_up
    face_right
    face_down
    face_left
    face_up
    face_right
    face_down
    face_left
    face_up
    face_right
    emote_exclamation_mark
}

