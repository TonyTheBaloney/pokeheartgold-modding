    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GOT_CLEANSE_TAG_FROM_ROUTE_5_GRANDMA)) {
        npcmsg("Eeyaaaah!\r"
               "I sense a sinister shadow hovering\n"
               "over you.\f"
               "Take this to ward it off!\r")
        if (!itemspace(ITEM_CLEANSE_TAG, 1)) {
            callstd(std_bag_is_full)
