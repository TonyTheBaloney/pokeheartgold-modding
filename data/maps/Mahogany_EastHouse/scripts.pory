script scr_seq_T28R0201_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_BEAT_RADIO_TOWER_ROCKETS)) {
        if (flag(FLAG_UNK_0C5)) {
            npcmsg("I’ve been hearing laughter on\n"
                   "the radio...\f"
                   "It’s creepy.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
    }
    npcmsg("My top radio show?\n"
           "I’d say Pokémon Music.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

