script Saffron_SilphCoRotomRoom_EventScript_Sign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    counttranformedrotomsinparty(VAR_SPECIAL_x8003, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_x8003) == 0) {
        npcmsg("There was an appliance here.\n"
               "The one with the oddly shaped motor.")
        waitbuttonpress
        closemessage
        goto(_08A4)
        end
    _089C:
        touchscreenmenushow
        closemessage
        releaseall
        end
    _08A4:
        releaseall
        end
    }
    npcmsg("Oh? ROTOM appears as if it wants to\n"
           "revert to its original form.\r"
           "Would you like to recall it from\n"
           "the motor? {YESNO 0}")
    touchscreenmenuhide
    menuinit(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(14, 255, 0)
    menuitemadd(19, 255, 1)
    menuexec
    Switch(VAR_SPECIAL_RESULT)
    Case(0, _0231)
    goto(_089C)
    end
}

script Saffron_SilphCoRotomRoom_EventScript_LittleBoy {
    simplenpcmsg("There is a mysterious notebook here.\n"
                 "Its age is impossible to tell.\r"
                 "“It was by pure chance that I obtained\n"
                 "information about the Pokémon ROTOM.\r"
                 "“Remarkably, ROTOM has the ability to\n"
                 "enter and merge with special motors.\r"
                 "“It’s now known that ROTOM can stay\n"
                 "inside a motor almost indefinitely.\r"
                 "“However, it will emerge if it enters a\n"
                 "Union Room or a Wi-Fi Club.\r"
                 "“ROTOM will also emerge from the motor\n"
                 "if it is left at the Day Care.\r"
                 "“ROTOM may also forget certain moves\n"
                 "when it leaves a motor.\r"
                 "“This Pokémon requires\n"
                 "exhaustive observation and analysis.\r"
                 "“To ensure I get all the credit,\n"
                 "my ROTOM research must be kept secret.\r"
                 "“They will come to revere me as the\n"
                 "scientific genius Char...”\r"
                 "The rest of the notebook is blank.")
    end
}

mapscripts Saffron_SilphCoRotomRoom_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Saffron_SilphCoRotomRoom_OnTransition
}
