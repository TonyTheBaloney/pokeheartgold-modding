script Route25_EventScript_Eusine3 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_SUICUNE, 0)
    release(obj_R25_tsure_poke_static_suicune)
    spinobject(obj_R25_tsure_poke_static_suicune, 2, 90, 2, 0)
    lock(obj_R25_tsure_poke_static_suicune)
    waitcry
    setflag(FLAG_ENGAGING_STATIC_POKEMON)
    wildbattle(SPECIES_SUICUNE, 40, 0)
    clearflag(FLAG_ENGAGING_STATIC_POKEMON)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    _07B0:
        setflag(FLAG_CAUGHT_SUICUNE)
        return
    }
    getstaticencounteroutcome(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) != 3) {
        compare(VAR_TEMP_x4002, 4)
        callifeq(_07B0)
        if (var(VAR_TEMP_x4002) == 5) {
            wait(20, VAR_SPECIAL_x8004)
            applymovement(obj_player, Route25_Movement_PlayerFaceDown3)
            waitmovement
            bufferplayersname(0)
            npcmsg("Eusine: {STRVAR_1 3, 0, 0}...\n"
                   "There is nothing to be ashamed of.\r"
                   "No one can pick on you just because\n"
                   "you ran from SUICUNE.\r"
                   "It’s just that SUICUNE is such an\n"
                   "amazing Pokémon. That’s all.\f"
                   "Anyway, SUICUNE is gone again.\f"
                   "It’s back to square one...\r")
            closemessage
            if (flag(FLAG_HIDE_ROUTE_25_EUSINE_2)) { goto(_0766) }
            goto(_0786)
        }
        bufferplayersname(0)
        npcmsg("Eusine: {STRVAR_1 3, 0, 0}...\n"
               "You two are truly amazing...\r"
               "I have never seen a battle\n"
               "this intense!\f"
               "I have no regrets...\r"
               "Farewell, SUICUNE!\n"
               "Farewell...{STRVAR_1 3, 0, 0}!\r")
        closemessage
        if (!flag(FLAG_HIDE_ROUTE_25_EUSINE_2)) {
        } else {
        _0766:
            applymovement(obj_player, Route25_Movement_PlayerFaceLeft3)
            applymovement(obj_R25_minaki, Route25_Movement_EusineWalkLeft)
            waitmovement
            removeobject(obj_R25_minaki)
            setflag(FLAG_HIDE_ROUTE_25_EUSINE)
            goto(_07A0)
        }
    _0786:
        applymovement(obj_player, Route25_Movement_PlayerFaceLeft3)
        applymovement(obj_R25_minaki_2, Route25_Movement_EusineWalkLeft)
        waitmovement
        removeobject(obj_R25_minaki_2)
        setflag(FLAG_HIDE_ROUTE_25_EUSINE_2)
    _07A0:
        setvar(VAR_SCENE_ROUTE_25, 3)
    }
    releaseall
    end
}

