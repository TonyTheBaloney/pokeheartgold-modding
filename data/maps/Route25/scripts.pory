               "Water-type Pokémon!\f"
               "Can I take a picture with it? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Misty: What a letdown...")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        photoalbumisfull(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Your Photo Album is full.\r"
                   "Access your PC and delete\n"
                   "some pictures.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Misty: Way to go!\r"
               "Let’s see a big smile!\r")
        closemessage
        setflag(FLAG_UNK_189)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        cameronphoto(84)
        faceplayer
        lockall
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        clearflag(FLAG_UNK_189)
        npcmsg("Misty: We look good!\n"
               "I really like Water-type Pokémon!")
        waitbuttonpress
        closemessage
        releaseall
        end
    _04DA:
        npcmsg(msg_0363_R25_00003)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_TEMP_x4002) >= 1) { goto(_044B) }
    npcmsg("Misty: I love the sunset here!\n"
           "It gives me courage to go on, you know?\r"
           "Right!\r"
           "Why don’t we exchange numbers? {YESNO 0}")
_03D3:
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_03F7) }
    if (var(VAR_SPECIAL_RESULT) >= 1) { goto(_043A) }
    end
_03F7:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} registered Misty\n"
           "in the Pokégear!")
    playfanfare(SEQ_ME_POKEGEAR_REGIST)
    waitfanfare
    registergearnumber(PHONE_CONTACT_MISTY)
    npcmsg(msg_0363_R25_00003)
    waitbuttonpress
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setflag(FLAG_UNK_2CD)
    removeobject(obj_R25_gsleader11_2)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
_043A:
    setvar(VAR_TEMP_x4002, 1)
    npcmsg("Misty: That’s a shame!")
    waitbuttonpress
    closemessage
    releaseall
    end
_044B:
    npcmsg("Misty: So you do want to know\n"
           "my number? {YESNO 0}")
    goto(_03D3)
    end
}

text msg_0363_R25_00003 {
    "Misty: Give me a call on Wednesday\n"
    "morning if you want another\f"
    "battle with me!"
}

script scr_seq_R25_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GOT_NUGGET_FROM_ACE_TRAINER_M_KEVIN)) {
        npcmsg("You took on one more battle than\n"
               "you expected, but you won anyway.\r"
               "As promised, you win a prize.\r")
        if (!itemspace(ITEM_NUGGET, 1)) {
            callstd(std_bag_is_full)
            closemessage
            releaseall
            end
        }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_NUGGET_FROM_ACE_TRAINER_M_KEVIN)
        npcmsg("But after seeing how you battle,\n"
               "I want to see how I’ll fare.\f"
               "How about it? Let me take you on.\r")
        closemessage
        trainerbattle(TRAINER_ACE_TRAINER_M_KEVIN, 0, 0, 0)
        checkbattlewon(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            whiteout
            releaseall
            end
        }
    }
    npcmsg("I’ve never had a battle this\n"
           "wonderful!\r"
           "You and your Pokémon are\n"
           "really strong!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_R25_004 {
    followmonresetmovement
    lockall
    setflag(FLAG_HIDE_ROUTE_14_EUSINE_2)
    clearflag(FLAG_HIDE_ROUTE_25_EUSINE)
    addobject(obj_R25_minaki)
    applymovement(obj_player, Route25_Movement_0648)
    waitmovement
    playcry(SPECIES_SUICUNE, 0)
    release(obj_R25_tsure_poke_static_suicune)
    spinobject(obj_R25_tsure_poke_static_suicune, 2, 90, 2, 0)
    lock(obj_R25_tsure_poke_static_suicune)
    waitcry
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 40) {
        applymovement(obj_player, Route25_Movement_0650)
    } elif (var(VAR_TEMP_x4001) == 41) {
        applymovement(obj_player, Route25_Movement_065C)
    } else {
        applymovement(obj_player, Route25_Movement_0670)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    callstd(std_play_eusine_music)
    applymovement(obj_R25_minaki, Route25_Movement_069C)
    applymovement(obj_player, Route25_Movement_0690)
    waitmovement
    npcmsg("Eusine: Puff, puff...\n"
           "I am...no match for you.\f"
           "...As I predicted.\r"
           "..................\n"
           "...Go ahead.\r"
           "Since I met you in the Burned Tower\n"
           "at Ecruteak City, I’ve sort of known\f"
           "that SUICUNE would choose you.\r")
    closemessage
    applymovement(obj_R25_minaki, Route25_Movement_06B0)
    applymovement(obj_player, Route25_Movement_0684)
    waitmovement
    npcmsg(msg_0363_R25_00017)
    waitbuttonpress
    closemessage
    callstd(std_fade_end_eusine_music)
    setvar(VAR_SCENE_ROUTE_25, 2)
    releaseall
    end
}

