script Route25_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        if (var(VAR_SCENE_ROUTE_25) == 2) {
            clearflag(FLAG_HIDE_ROUTE_25_EUSINE_2)
            setflag(FLAG_HIDE_ROUTE_25_EUSINE)
        }
        checkbadge(BADGE_EARTH, VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 0) { goto(_011B) }
        if (var(VAR_SCENE_ROUTE_25) == 1) { goto(_011B) }
        if (var(VAR_SCENE_ROUTE_25) == 2) { goto(_011B) }
        getphonebookrematch(PHONE_CONTACT_MISTY, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) != 0) { goto(_0115) }
        checkregisteredphonenumber(PHONE_CONTACT_MISTY, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) == 1) {
            getcurrenthour(VAR_TEMP_x4000)
            if (var(VAR_TEMP_x4000) == 14) {
                clearflag(FLAG_UNK_2CD)
            } elif (var(VAR_TEMP_x4000) == 15) {
                clearflag(FLAG_UNK_2CD)
            } else {
                setflag(FLAG_UNK_2CD)
            }
            end
        _0115:
            setflag(FLAG_UNK_2CD)
            end
        _011B:
            setflag(FLAG_UNK_2CD)
            end
        }
        getcurrenthour(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 16) {
            clearflag(FLAG_UNK_2CD)
        } elif (var(VAR_TEMP_x4000) == 17) {
            clearflag(FLAG_UNK_2CD)
        } else {
            goto(_0115)
        }
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script Route25_OnLoad {
    if (flag(FLAG_ENGAGING_STATIC_POKEMON)) {
        setflag(FLAG_HIDE_ROUTE_25_SUICUNE)
        removeobject(obj_R25_tsure_poke_static_suicune)
        clearflag(FLAG_ENGAGING_STATIC_POKEMON)
        end
    }
    end
}

script Route25_EventScript_MistyTrigger {
    followmonresetmovement
    lockall
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 40) {
        applymovement(obj_R25_gsleader11, Route25_Movement_MistyFaceUp)
        applymovement(obj_R25_gsman1, Route25_Movement_ManWalkUpLeft1)
        applymovement(obj_player, Route25_Movement_PlayerFaceDown1)
    } elif (var(VAR_TEMP_x4001) == 41) {
        applymovement(obj_R25_gsleader11, Route25_Movement_MistyFaceUp)
        applymovement(obj_R25_gsman1, Route25_Movement_ManWalkUpLeft2)
        applymovement(obj_player, Route25_Movement_PlayerFaceDown1)
    } else {
        applymovement(obj_R25_gsleader11, Route25_Movement_MistyFaceUp)
        applymovement(obj_R25_gsman1, Route25_Movement_ManWalkUpLeft3)
        applymovement(obj_player, Route25_Movement_PlayerSpin)
    }
    waitmovement
    stopbgm(SEQ_GS_R_12_24)
    playbgm(SEQ_GS_EYE_K_SHOUJO)
    if (var(VAR_TEMP_x4001) == 40) {
        applymovement(obj_R25_gsleader11, Route25_Movement_MistyWalkUpLeft1)
        applymovement(obj_player, Route25_Movement_PlayerFaceRight)
    } elif (var(VAR_TEMP_x4001) == 41) {
        applymovement(obj_R25_gsleader11, Route25_Movement_MistyWalkUpLeft2)
        applymovement(obj_player, Route25_Movement_PlayerFaceRight)
    } else {
        applymovement(obj_R25_gsleader11, Route25_Movement_MistyWalkUpLeft3)
        applymovement(obj_player, Route25_Movement_PlayerFaceRight)
    }
    waitmovement
    npcmsg("Misty: Aww! Why did you have to\n"
           "show up and bug us now?\r"
           "Do you know what they call people\n"
           "like you?\r"
           "Pests! You heard me right, pest!\r"
           "...\r"
           "...Oh? Those Badges you have...\n"
           "Are they Johto Gym Badges?\r"
           "If you have eight, you must be good.\r"
           "OK, then. Come to Cerulean Gym.\n"
           "I’ll be happy to take you on.\r"
           "I’m Misty, the Gym Leader\n"
           "in Cerulean.\r")
    closemessage
    if (var(VAR_TEMP_x4001) == 40) {
        applymovement(obj_R25_gsleader11, Route25_Movement_MistyWalkDownLeft1)
        applymovement(obj_player, Route25_Movement_PlayerFaceLeft1)
    } elif (var(VAR_TEMP_x4001) == 41) {
        applymovement(obj_R25_gsleader11, Route25_Movement_MistyWalkDownLeft2)
        applymovement(obj_player, Route25_Movement_PlayerFaceLeft1)
    } else {
        applymovement(obj_R25_gsleader11, Route25_Movement_MistyWalkUpLeft4)
        applymovement(obj_player, Route25_Movement_PlayerFaceLeft2)
    }
    waitmovement
    removeobject(obj_R25_gsman1)
    removeobject(obj_R25_gsleader11)
    stopbgm(SEQ_GS_EYE_K_SHOUJO)
    playbgm(SEQ_GS_R_12_24)
    setflag(FLAG_HIDE_ROUTE_25_MISTYS_BOYFRIEND)
    setflag(FLAG_HIDE_ROUTE_25_MISTY)
    clearflag(FLAG_HIDE_CERULEAN_GYM_POPULATION)
    setvar(VAR_UNK_4088, 2)
    releaseall
    end
}

