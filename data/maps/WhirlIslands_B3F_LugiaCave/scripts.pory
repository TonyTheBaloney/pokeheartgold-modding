script WhirlIslands_B3F_LugiaCave_EventScript_KimonoGirl1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_109)) {
        if (var(VAR_TEMP_x4005) == 5) {
            npcmsg(msg_0125_D40R0107_00008)
        } elif (var(VAR_TEMP_x4005) == 6) {
            npcmsg(msg_0125_D40R0107_00008)
        } elif (var(VAR_TEMP_x4005) == 4) {
            npcmsg("You have not only made LUGIA appear,\n"
                   "but you also caught it...\r"
                   "You are so wonderful.\n"
                   "There is nothing more for us to say.\r"
                   "Take good care of yourself in\n"
                   "your journey...")
        } else {
            npcmsg("If that is what you believe, we will not\n"
                   "try to convince you otherwise.\r"
                   "Still, if you wish to see LUGIA once\n"
                   "more, perhaps you can come back here\f"
                   "after all has been settled...")
        }
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg(msg_0125_D40R0107_00001)
    waitbuttonpress
    closemessage
    releaseall
    end
}

text msg_0125_D40R0107_00008 {
    "I think once you turn your back to it,\n"
    "LUGIA will not come back for\f"
    "some time...\r"
    "If you want to see LUGIA, perhaps you\n"
    "can come back here after all\f"
    "has been settled..."
}

text msg_0125_D40R0107_00001 {
    "This is all we can do for you...\n"
    "What you do now is entirely up to you..."
}

script WhirlIslands_B3F_LugiaCave_EventScript_KimonoGirl2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_109)) {
        npcmsg("You’ve done a great job. Say hello to\n"
               "Professor Elm for us.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg(msg_0125_D40R0107_00001)
    waitbuttonpress
    closemessage
    releaseall
    end
}

