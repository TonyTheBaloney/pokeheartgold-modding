           "LUGIA... It must have been waiting for\n"
           "someone like you all this time.\f"
           "Wouldn’t you agree...?")
    waitbuttonpress
    closemessage
    releaseall
    setflag(FLAG_UNK_10B)
    setvar(VAR_UNK_40FA, 2)
    end
