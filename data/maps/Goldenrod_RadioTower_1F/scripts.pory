script Goldenrod_RadioTower_1F_EventScript_RocketGrunt {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        if (var(VAR_TEMP_x400A) == 1) {
            getplayerfacing(VAR_SPECIAL_RESULT)
            if (var(VAR_SPECIAL_RESULT) == 3) {
                setvar(VAR_TEMP_x400B, 33)
            } elif (var(VAR_SPECIAL_RESULT) == 0) {
                setvar(VAR_TEMP_x400B, 11)
            }
            npcmsg("What are you doing?\n"
                   "Go upstairs and take your position!")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Ha! You must be new!\n"
               "You look pretty good in the Team Rocket\f"
               "uniform!\r"
               "Go on ahead!\r")
        closemessage
        getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) == 5) {
            applymovement(obj_D23R0101_rocketm, Goldenrod_RadioTower_1F_Movement_RocketGruntWalkDown1)
        } elif (var(VAR_TEMP_x4001) == 6) {
            applymovement(obj_D23R0101_rocketm, Goldenrod_RadioTower_1F_Movement_RocketGruntWalkLeft1)
        }
        waitmovement
        releaseall
        setvar(VAR_TEMP_x400A, 1)
        end
    }
    npcmsg("Who are you?\n"
           "We have some business going on.\r"
           "I was told not to let anyone pass but\n"
           "Team Rocket!\r"
           "Do you understand?\r"
           "You are only allowed to come through\n"
           "when you are wearing the cool black\f"
           "uniform for Team Rocket!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

