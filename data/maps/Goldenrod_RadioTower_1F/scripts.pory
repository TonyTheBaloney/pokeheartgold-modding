script Goldenrod_RadioTower_1F_EventScript_Receptionist2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_4136) != 0) { goto(_0B86) }
    if (flag(FLAG_UNK_AA6)) { goto(_09CF) }
    if (flag(FLAG_UNK_AA5)) { goto(_09AF) }
    npcmsg("This is the Pokémon Lottery Corner.\n"
           "I’m Felicity, your attendant today.\r"
           "If the drawn number matches the ID No.\n"
           "of any of your Pokémon, you could win\f"
           "fabulous gifts.\r"
           "Would you like to check today’s\n"
           "lucky number? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_09E5) }
    goto(_09DA)
_09AF:
    npcmsg("This is the Pokémon Lottery Corner.\r"
           "Would you like to check today’s\n"
           "lucky number again? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_09E5) }
    goto(_09DA)
    end
_09CF:
    npcmsg("You’ve already drawn a Loto Ticket\n"
           "today. Please come back tomorrow.")
    waitbuttonpress
    closemessage
    releaseall
    end
_09DA:
    npcmsg("Oh. I see.\n"
           "Please do visit us again.")
    waitbuttonpress
    closemessage
    releaseall
    end
_09E5:
    setflag(FLAG_UNK_AA5)
    npcmsg("First, I’ll look up today’s Pokémon\n"
           "Lottery Corner lucky number.\r"
           "...\r")
    lotoidget(VAR_SPECIAL_x8000)
    bufferintex(0, VAR_SPECIAL_x8000, 2, 5)
    npcmsg("Your Loto Ticket number is {STRVAR_1 54, 0, 0}.\r"
           "Now, let’s see if it matches the\n"
           "ID No. of any of your Pokémon.\r")
    lotoidsearch(VAR_SPECIAL_x8001, VAR_SPECIAL_x8002, VAR_SPECIAL_x8003, VAR_SPECIAL_x8000)
    if (var(VAR_SPECIAL_x8002) == 0) { goto(_0A24) }
    if (var(VAR_SPECIAL_x8003) == 0) { goto(_0A2F) }
    goto(_0A3D)
_0A24:
    npcmsg("I’m sorry.\n"
           "You didn’t get a match...")
    waitbuttonpress
    closemessage
    releaseall
    end
_0A2F:
    bufferpartymonnick(0, VAR_SPECIAL_x8001)
    npcmsg("Congratulations!\r"
           "The ID No. of your team’s\n"
           "{STRVAR_1 1, 0, 0} matches your Loto\f"
           "Ticket number!\r")
    goto(_0A4B)
_0A3D:
    bufferboxmonnick(0, VAR_SPECIAL_x8001)
    npcmsg("Congratulations!\r"
           "The ID No. of your PC-boxed\n"
           "{STRVAR_1 1, 0, 0} matches your Loto\f"
           "Ticket number!\r")
    goto(_0A4B)
_0A4B:
    Switch(VAR_SPECIAL_x8002)
    Case(1, _0A94)
    Case(2, _0A9F)
    Case(3, _0AA8)
    Case(4, _0AB1)
    Case(5, _0ABA)
    end
_0A94:
    npcmsg("The last digit matched, so you\n"
           "win the fourth prize!\r")
    goto(_0AC3)
    end
_0A9F:
    npcmsg("The last two digits matched, so you\n"
           "win the third prize!\r")
    goto(_0AC3)
_0AA8:
    npcmsg("The last three digits matched, so you\n"
           "win the second prize!\r")
    goto(_0AC3)
_0AB1:
    npcmsg("The last four digits matched, so you\n"
           "win the first prize!\r")
    goto(_0AC3)
_0ABA:
    npcmsg("Oh, my goodness, all five digits\n"
           "matched!\r"
           "You’ve won the jackpot prize!\n"
           "This is just so incredible!\r"
           "...Oh, I’m sorry! Your prize!\n"
           "I got carried away there.\r"
           "Here you go!\r")
    goto(_0AC3)
_0AC3:
    Switch(VAR_SPECIAL_x8002)
    Case(1, _0B0C)
    Case(2, _0B1A)
    Case(3, _0B26)
    Case(4, _0B32)
    Case(5, _0B3E)
    end
_0B0C:
    setvar(VAR_SPECIAL_x8003, 2)
    goto(_0B4A)
    end
_0B1A:
    setvar(VAR_SPECIAL_x8003, 51)
    goto(_0B4A)
_0B26:
    setvar(VAR_SPECIAL_x8003, 216)
    goto(_0B4A)
_0B32:
    setvar(VAR_SPECIAL_x8003, 29)
    goto(_0B4A)
_0B3E:
    setvar(VAR_SPECIAL_x8003, 1)
    goto(_0B4A)
_0B4A:
    if (!itemspace(VAR_SPECIAL_x8003, 1)) { goto(_0B75) }
    callstd(std_give_item_verbose)
    goto(_0B98)
_0B75:
    copyvar(VAR_UNK_4136, VAR_SPECIAL_x8002)
    npcmsg("...Oh?\n"
           "You seem to have no room for this.\r"
           "Please make room in your Bag and\n"
           "then let me know.")
    waitbuttonpress
    closemessage
    releaseall
    end
_0B86:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0}?\n"
           "Yes, I’ve been expecting you.\r"
           "This is the prize we’ve been holding\n"
           "for you. Here you go!\r")
    copyvar(VAR_SPECIAL_x8002, VAR_UNK_4136)
    goto(_0AC3)
_0B98:
    setvar(VAR_UNK_4136, 0)
    setflag(FLAG_UNK_AA6)
    npcmsg("Please do visit again!\n"
           "Good-bye from Felicity, your attendant!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

mapscripts Goldenrod_RadioTower_1F_MapScripts {
    INIT_SCRIPT_ON_TRANSITION: Goldenrod_RadioTower_1F_OnTransition
