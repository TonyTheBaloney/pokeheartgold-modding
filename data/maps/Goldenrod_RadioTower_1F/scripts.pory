script scr_seq_D23R0101_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 2) {
        npcmsg(msg_0065_D23R0101_00001)
    } elif (var(VAR_SCENE_ROCKET_TAKEOVER) == 4) {
        npcmsg(msg_0065_D23R0101_00001)
    } elif (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("Um, yes. I have been telling visitors\n"
               "to go home as you instructed...")
    } else {
        npcmsg("Welcome to Goldenrod’s Radio Tower!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

text msg_0065_D23R0101_00001 {
    "Welcome to Goldenrod’s Radio Tower!\r"
    "...Or, maybe not.\n"
    "I am sorry to tell you this, but no one\f"
    "can visit the tower now."
}

script scr_seq_D23R0101_010 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("Whitney: Hi!\n"
           "My name is Whitney!\r"
           "I heard about the Quiz to win a Radio\n"
           "Card, so I came here to get one...\r"
           "But this Quiz is so hard!\r")
    applymovement(obj_D23R0101_gsleader3, Goldenrod_RadioTower_1F_Movement_036C)
    waitmovement
    closemessage
    releaseall
    end
}

script scr_seq_D23R0101_002 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_RADIO_CARD)) {
        npcmsg("Please tune in to our radio shows!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("We have a special Quiz campaign!\r"
           "Answer five questions correctly in a\n"
           "row to win a Radio Card!\r"
           "When you load it into the Pokégear, you\n"
           "will be able to listen to the radio...\f"
           "anytime, anywhere!\r"
           "Would you like to try our Quiz? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0221) }
    npcmsg("The first question!\r"
           "Can you check the Town Map with\n"
           "your Pokégear? {YESNO 0}")
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_022E) }
    playse(SEQ_SE_DP_PINPON)
    waitse(SEQ_SE_DP_PINPON)
    npcmsg("You are correct.\n"
           "The second question!\r"
           "NIDORINA can only be female.\n"
           "True? {YESNO 0}")
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_022E) }
    playse(SEQ_SE_DP_PINPON)
    waitse(SEQ_SE_DP_PINPON)
    npcmsg("You are correct.\n"
           "The third question!\r"
           "Kurt, the Poké Ball creator, uses\n"
           "apricots as ingredients? {YESNO 0}")
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_022E) }
    playse(SEQ_SE_DP_PINPON)
    waitse(SEQ_SE_DP_PINPON)
    npcmsg("You are correct again.\n"
           "The fourth question!\r"
           "It’s impossible to use a TM on\n"
           "MAGIKARP. True? {YESNO 0}")
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_022E) }
    playse(SEQ_SE_DP_PINPON)
    waitse(SEQ_SE_DP_PINPON)
    npcmsg("Wow!\n"
           "I have only one more question to go.\r"
           "In Professor Oak’s popular show,\n"
           "Pokémon Talk, is he on with Marie? {YESNO 0}")
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_022E) }
    wait(30, VAR_SPECIAL_RESULT)
    playse(SEQ_SE_DP_PINPON)
    waitse(SEQ_SE_DP_PINPON)
    touchscreenmenushow
    npcmsg("Bingo! You got it!\n"
           "Congratulations!\f"
           "Here’s your prize, a Radio Card!\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} can now listen to the\n"
           "radio with the Pokégear!")
    playfanfare(SEQ_ME_KEYITEM)
    waitfanfare
    closemessage
    registerpokegearcard(2)
    setflag(FLAG_GOT_RADIO_CARD)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_D23R0101_gsleader3, Goldenrod_RadioTower_1F_Movement_0250)
    applymovement(obj_player, Goldenrod_RadioTower_1F_Movement_0270)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("Whitney: Wow, you did it!\n"
           "I thought the answer to the third\f"
           "question was surely apricots!\r"
           "Oops!\n"
           "It’s time to go back to the Gym!\r")
    closemessage
    applymovement(obj_D23R0101_gsleader3, Goldenrod_RadioTower_1F_Movement_0264)
    wait(24, VAR_SPECIAL_RESULT)
    applymovement(obj_player, Goldenrod_RadioTower_1F_Movement_036C)
    waitmovement
    removeobject(obj_D23R0101_gsleader3)
    setflag(FLAG_UNK_318)
    releaseall
    end
_0221:
    npcmsg("Oh. I see.\n"
           "Please see me if you change your mind.")
    waitbuttonpress
    closemessage
    touchscreenmenushow
    releaseall
    end
_022E:
    playse(SEQ_SE_DP_BOX03)
    waitse(SEQ_SE_DP_BOX03)
    npcmsg("Oh, dear.\n"
           "Sorry, but you got it wrong.\f"
           "Please try again!")
    waitbuttonpress
    closemessage
    touchscreenmenushow
    releaseall
    end
}

