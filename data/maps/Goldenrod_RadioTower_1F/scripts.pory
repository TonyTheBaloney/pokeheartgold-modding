script scr_seq_D23R0101_009 {
    followmonresetmovement
    lockall
    movepersonfacing(obj_D23R0101_gsrivel, 13, 1, 6, DIR_EAST)
    callstd(std_play_rival_intro_music)
    getpersoncoords(6, VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 5) {
        applymovement(obj_D23R0101_gsrivel, Goldenrod_RadioTower_1F_Movement_0670)
        if (var(VAR_TEMP_x400B) == 33) {
            applymovement(obj_D23R0101_rocketm, Goldenrod_RadioTower_1F_Movement_069C)
        }
    } elif (var(VAR_TEMP_x4001) == 6) {
        applymovement(obj_D23R0101_gsrivel, Goldenrod_RadioTower_1F_Movement_067C)
        if (var(VAR_TEMP_x400B) == 11) {
            applymovement(obj_D23R0101_rocketm, Goldenrod_RadioTower_1F_Movement_06A8)
        }
    }
    waitmovement
    bufferrivalsname(1)
    npcmsg("{STRVAR_1 3, 1, 0}: Hey, Team Rocket!\r"
           "Stop going around in groups and\n"
           "troubling people. You cowards!\r")
    closemessage
    applymovement(obj_D23R0101_gsrivel, Goldenrod_RadioTower_1F_Movement_0664)
    waitmovement
    if (var(VAR_TEMP_x4001) == 5) {
        applymovement(obj_D23R0101_gsrivel, Goldenrod_RadioTower_1F_Movement_0684)
        applymovement(obj_D23R0101_rocketm, Goldenrod_RadioTower_1F_Movement_06B4)
    } elif (var(VAR_TEMP_x4001) == 6) {
        applymovement(obj_D23R0101_gsrivel, Goldenrod_RadioTower_1F_Movement_0690)
        applymovement(obj_D23R0101_rocketm, Goldenrod_RadioTower_1F_Movement_06C8)
    }
    waitmovement
    if (var(VAR_TEMP_x4001) == 5) {
        applymovement(obj_player, Goldenrod_RadioTower_1F_Movement_06E4)
    } elif (var(VAR_TEMP_x4001) == 6) {
        applymovement(obj_player, Goldenrod_RadioTower_1F_Movement_06EC)
    }
    waitmovement
    bufferplayersname(0)
    bufferrivalsname(1)
    npcmsg("{STRVAR_1 3, 1, 0}: ...Huh?\n"
           "Are you {STRVAR_1 3, 0, 0}?\f"
           "What are you doing here?\r"
           "No way... You think you’re strong now\n"
           "that you look like them?\r"
           "That’s foolish!\n"
           "You shouldn’t wear those things!\r")
    closemessage
    if (var(VAR_TEMP_x4001) == 5) {
        applymovement(obj_player, Goldenrod_RadioTower_1F_Movement_06FC)
    } elif (var(VAR_TEMP_x4001) == 6) {
        applymovement(obj_player, Goldenrod_RadioTower_1F_Movement_07BC)
    }
    wait(50, VAR_SPECIAL_RESULT)
    setavatarbits(PLAYER_TRANSITION_WALKING)
    updateavatarstate
    rocketcostumeflagaction(0)
    waitmovement
    if (var(VAR_TEMP_x4001) == 5) {
        applymovement(obj_D23R0101_rocketm, Goldenrod_RadioTower_1F_Movement_0874)
    } elif (var(VAR_TEMP_x4001) == 6) {
        applymovement(obj_D23R0101_rocketm, Goldenrod_RadioTower_1F_Movement_0890)
    }
    waitmovement
    if (var(VAR_TEMP_x4001) == 5) {
        applymovement(obj_D23R0101_rocketm, Goldenrod_RadioTower_1F_Movement_08AC)
        applymovement(obj_D23R0101_gsrivel, Goldenrod_RadioTower_1F_Movement_08BC)
    } elif (var(VAR_TEMP_x4001) == 6) {
        applymovement(obj_D23R0101_rocketm, Goldenrod_RadioTower_1F_Movement_08B4)
        applymovement(obj_D23R0101_gsrivel, Goldenrod_RadioTower_1F_Movement_08D4)
    }
    waitmovement
    npcmsg("What? You!\n"
           "You’re not a newcomer?\f"
           "Then battle with me!\r")
    closemessage
    trainerbattle(TRAINER_TEAM_ROCKET_GRUNT_3, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        setvar(VAR_SCENE_ROCKET_TAKEOVER, 2)
        whiteout
        releaseall
        end
    }
    npcmsg("You are too powerful.\r"
           "You could spoil our plan.\n"
           "I have to inform the others...\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(56)
    if (var(VAR_TEMP_x4001) == 5) {
        applymovement(obj_D23R0101_rocketm, Goldenrod_RadioTower_1F_Movement_08EC)
        applymovement(obj_player, Goldenrod_RadioTower_1F_Movement_0900)
    } elif (var(VAR_TEMP_x4001) == 6) {
        applymovement(obj_D23R0101_rocketm, Goldenrod_RadioTower_1F_Movement_08F4)
        applymovement(obj_player, Goldenrod_RadioTower_1F_Movement_0914)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    removeobject(obj_D23R0101_rocketm)
    callstd(std_play_rival_outro_music)
    if (var(VAR_TEMP_x4001) == 5) {
        applymovement(obj_D23R0101_gsrivel, Goldenrod_RadioTower_1F_Movement_0928)
    } elif (var(VAR_TEMP_x4001) == 6) {
        applymovement(obj_D23R0101_gsrivel, Goldenrod_RadioTower_1F_Movement_0930)
    }
    waitmovement
    if (var(VAR_TEMP_x4001) == 5) {
        applymovement(obj_player, Goldenrod_RadioTower_1F_Movement_06DC)
    } elif (var(VAR_TEMP_x4001) == 6) {
        applymovement(obj_player, Goldenrod_RadioTower_1F_Movement_06F4)
    }
    waitmovement
    bufferrivalsname(1)
    npcmsg("{STRVAR_1 3, 1, 0}: I see.\n"
           "You were trying to be sneaky...\r"
           "Huh!\n"
           "A typical idea of the meek!\r"
           "No matter.\n"
           "I’ll let you handle this.\r"
           "I have to defeat the Dragon Tamer...\n"
           "What’s his name...? Lance!\r"
           "After that...it will be your turn.\n"
           "Be ready for it!\r")
    closemessage
    applymovement(obj_D23R0101_gsrivel, Goldenrod_RadioTower_1F_Movement_0938)
    waitmovement
    removeobject(obj_D23R0101_gsrivel)
    callstd(std_fade_end_rival_outro_music)
    releaseall
    setvar(VAR_SCENE_ROCKET_TAKEOVER, 4)
    setflag(FLAG_HIDE_RADIO_TOWER_RIVAL)
    setvar(VAR_UNK_409F, 1)
    end
}

