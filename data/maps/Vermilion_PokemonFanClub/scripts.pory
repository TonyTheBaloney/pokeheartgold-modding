    end
}

script scr_seq_T06R0301_002 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getitemquantity(ITEM_LOST_ITEM, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 0) { goto(_0141) }
    getitemquantity(ITEM_PASS, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 0) { goto(_0141) }
    if (flag(FLAG_UNK_119)) {
        npcmsg("I love CLEFAIRY, but I could never\n"
               "catch one. So I’m making do with a\f"
               "Poké Doll that I found.\r"
               "What?\n"
               "The girl who lost this Poké Doll\f"
               "is sad...!\r"
               "OK. Could you take this Poké Doll\n"
               "back to that poor little girl?\r"
               "I’ll befriend a real CLEFAIRY on\n"
               "my own one day!\r")
        removeobject(obj_T06R0301_mono_pip)
        setflag(FLAG_HIDE_VERMILION_FAN_CLUB_LOST_ITEM)
        giveitemnocheck(ITEM_LOST_ITEM, 1)
        setvar(VAR_UNK_4130, 1)
        clearflag(FLAG_HIDE_VERMILION_CITY_STEVEN)
        closemessage
        releaseall
        end
    _0141:
        npcmsg("You watch. I’m going to get a\n"
               "real CLEFAIRY as my friend.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_RESTORED_POWER)) { goto(_010B) }
    npcmsg("I love the way CLEFAIRY opens up\n"
           "its arms!\r"
           "It’s so adorable!")
    waitbuttonpress
    closemessage
    releaseall
    end
_010B:
    npcmsg("I love CLEFAIRY, but I could never\n"
           "catch one.\r"
           "So I’m making do with a Poké Doll\n"
           "that I found.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

