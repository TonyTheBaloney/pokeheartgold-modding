    waitmovement
    if (var(VAR_TEMP_x4000) == 0) {
        applymovement(obj_T07R0102_leader3, Celadon_DepartmentStore_2F_Movement_CrasherWakeFaceDown)
    } elif (var(VAR_TEMP_x4000) == 2) {
        applymovement(obj_T07R0102_leader3, Celadon_DepartmentStore_2F_Movement_CrasherWakeFaceRight)
    } else {
        applymovement(obj_T07R0102_leader3, Celadon_DepartmentStore_2F_Movement_CrasherWakeFaceLeft)
    }
    waitmovement
    npcmsg("Wake: Huh? You talking to me?\r"
           "Your eyes...are on my\n"
           "Crasher Wake mask?\r"
           "No, no, no!\n"
           "I can never let it go!\r"
           "...\n"
           "Huh? That’s not it?\f"
           "You want the other mask?\r"
           "Hmm.\n"
           "OK.\r")
    setvar(VAR_SPECIAL_x8004, 92)
    setvar(VAR_SPECIAL_x8005, 1)
    callstd(std_receive_accessory)
    npcmsg("Wake: What?\n"
           "That’s not enough?\r"
           "You’re quite a negotiator for your\n"
           "age... All right, I’ll give you this, too!\r")
    setvar(VAR_SPECIAL_x8004, 93)
    setvar(VAR_SPECIAL_x8005, 1)
    callstd(std_receive_accessory)
    npcmsg("Wake: ...\r"
           "Arrr, all right, all right! I will give you\n"
           "this much-valued one as well!\r")
    setvar(VAR_SPECIAL_x8004, 94)
    setvar(VAR_SPECIAL_x8005, 1)
    callstd(std_receive_accessory)
    npcmsg("Wake: It’s OK.\n"
           "I’ve already paid for you.\r"
           "Presents for you from the one\n"
           "who wears masks the best.\f"
           "Don’t be shy.\f"
           "Ha ha ha!\r")
    closemessage
    compare(VAR_TEMP_x4000, 3)
    callifeq(_01A0)
    if (var(VAR_TEMP_x4000) == 3) {
        applymovement(obj_T07R0102_leader3, Celadon_DepartmentStore_2F_Movement_CrasherWakeWalkDownLeft)
    } else {
        applymovement(obj_T07R0102_leader3, Celadon_DepartmentStore_2F_Movement_CrasherWakeWalkLeftDown)
    }
    waitmovement
    removeobject(obj_T07R0102_leader3)
    setflag(FLAG_HIDE_CELADON_DEPT_STORE_2F_CRASHER_WAKE)
    clearflag(FLAG_HIDE_ROUTE_47_CRASHER_WAKE)
    releaseall
    end
_01A0:
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getpersoncoords(253, VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
        if (var(VAR_SPECIAL_x8005) == 5) {
            release(obj_partner_poke)
            applymovement(obj_partner_poke, Celadon_DepartmentStore_2F_Movement_FollowMonWalkLeftUp)
            waitmovement
            lock(obj_partner_poke)
        }
    }
    return
}

