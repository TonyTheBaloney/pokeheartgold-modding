        applymovement(obj_T07R0102_leader3, Celadon_DepartmentStore_2F_Movement_CrasherWakeWalkLeftRight)
    } else {
        applymovement(obj_T07R0102_leader3, Celadon_DepartmentStore_2F_Movement_CrasherWakeWalkRightLeft)
    }
    waitmovement
    npcmsg("Wake: Ha! This is quite a mask...\r")
