        npcmsg("Wake: Hmm... Hmm... Humm...\r"
               "Ha! This is quite a mask...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Wake: Hmm... Hmm... Humm...\r")
    getplayerfacing(VAR_TEMP_x4000)
