script Violet_EventScript_ProfElmCall {
    setflag(FLAG_GOT_PICK_UP_EGG_CALL_FROM_ELM)
    phonecall(PHONE_CONTACT_PROF__ELM, 2, 1)
    setvar(VAR_SCENE_VIOLET_CITY_OW, 2)
    clearflag(FLAG_HIDE_VIOLET_SHOP_LAB_AIDE)
    setflag(FLAG_HIDE_ELMS_LAB_AIDE)
    end
}

script Violet_EventScript_KimonoGirlScene {
    followmonresetmovement
    lockall
    callstd(std_play_kimono_girl_music)
    applymovement(obj_T22_dancer, Violet_Movement_KimonoGirlWalkLeftUp)
    waitmovement
    npcmsg("Me oh my...\n"
           "That Egg must be...!\r")
    closemessage
    applymovement(obj_T22_dancer, Violet_Movement_KimonoGirlWalkUp)
    waitmovement
    npcmsg("I see...\n"
           "So it was handed from Mr. Pokémon to\f"
           "Professor Elm, then from Professor Elm\f"
           "to you.\r"
           "Now I get it...\r")
    closemessage
    applymovement(obj_T22_dancer, Violet_Movement_KimonoGirlWalkDown)
    waitmovement
    npcmsg("That Egg is truly an important Egg.\n"
           "Please do take good care of it for me.\r"
           "Is that understood?\r")
    closemessage
    applymovement(obj_T22_dancer, Violet_Movement_KimonoGirlSpin)
    waitmovement
    npcmsg("I am counting on you.\r")
    closemessage
    applymovement(obj_T22_dancer, Violet_Movement_KimonoGirlWalkDownLeft)
    waitmovement
    callstd(std_fade_end_kimono_girl_music)
    removeobject(obj_T22_dancer)
    setflag(FLAG_HIDE_VIOLET_KIMONO_GIRL)
    releaseall
    setvar(VAR_SCENE_VIOLET_CITY_OW, 4)
    end
}

movement Violet_Movement_KimonoGirlWalkLeftUp {
    emote_exclamation_mark
    walk_left * 5
    walk_up
}

movement Violet_Movement_KimonoGirlWalkUp {
    walk_up
}

movement Violet_Movement_KimonoGirlWalkDown {
    lock_dir
    walk_slow_down
    unlock_dir
}

movement Violet_Movement_KimonoGirlWalkDownLeft {
    walk_down * 2
    walk_left
    walk_down * 7
}

movement Violet_Movement_KimonoGirlSpin {
    face_right
    delay_2
    face_down
    delay_2
    face_left
    delay_2
    face_up
    delay_2
    face_right
    delay_2
    face_down
    delay_2
    face_left
    delay_2
    face_up
    delay_2
}

script Violet_EventScript_AceTrainerF {
    simplenpcmsg("We care about the traditional buildings\n"
                 "around here. That’s why even the\f"
                 "Poké Mart and Pokémon Center are\f"
                 "painted a bit somberly to blend in.")
    end
}

