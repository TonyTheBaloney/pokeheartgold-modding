script scr_seq_T22_004 {
    followmonresetmovement
    lockall
    callstd(std_play_kimono_girl_music)
    applymovement(obj_T22_dancer, Violet_Movement_00CC)
    waitmovement
    npcmsg("Me oh my...\n"
           "That Egg must be...!\r")
    closemessage
    applymovement(obj_T22_dancer, Violet_Movement_00DC)
    waitmovement
    npcmsg("I see...\n"
           "So it was handed from Mr. Pokémon to\f"
           "Professor Elm, then from Professor Elm\f"
           "to you.\r"
           "Now I get it...\r")
    closemessage
    applymovement(obj_T22_dancer, Violet_Movement_00E4)
    waitmovement
    npcmsg("That Egg is truly an important Egg.\n"
           "Please do take good care of it for me.\r"
           "Is that understood?\r")
    closemessage
    applymovement(obj_T22_dancer, Violet_Movement_0104)
    waitmovement
    npcmsg("I am counting on you.\r")
    closemessage
    applymovement(obj_T22_dancer, Violet_Movement_00F4)
    waitmovement
    callstd(std_fade_end_kimono_girl_music)
    removeobject(obj_T22_dancer)
    setflag(FLAG_HIDE_VIOLET_KIMONO_GIRL)
    releaseall
    setvar(VAR_SCENE_VIOLET_CITY_OW, 4)
    end
}

