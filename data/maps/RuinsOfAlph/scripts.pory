script RuinsOfAlph_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        if (var(VAR_SCENE_SINJOH_MYSTRI_ROOM) < 9) {
            setvar(VAR_SCENE_SINJOH_MYSTRI_ROOM, 1)
        }
        checkbadge(BADGE_PLAIN, VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) != 0) {
            getweekday(VAR_TEMP_x4000)
            if (var(VAR_TEMP_x4000) == 5) { goto(_010E) }
            if (var(VAR_TEMP_x4000) == 6) { goto(_010E) }
            if (var(VAR_TEMP_x4000) == 0) { goto(_010E) }
        }
        setflag(FLAG_HIDE_CAMERON)
        goto(_0112)
    _010E:
        clearflag(FLAG_HIDE_CAMERON)
    _0112:
        if (var(VAR_UNOWN_REPORT_LEVEL) >= 7) { goto(_005E) }
        if (var(VAR_UNOWN_REPORT_LEVEL) == 6) { goto(_0080) }
        goto(_003C)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script RuinsOfAlph_EventScript_PokefanM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 0)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 5)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 1)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, RuinsOfAlph_Movement_PlayerWalkRightUp)
        applymovement(obj_D24R0101_gsmiddleman1, RuinsOfAlph_Movement_PokefanMFaceUp)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, RuinsOfAlph_Movement_PlayerWalkUp)
    } else {
        applymovement(obj_player, RuinsOfAlph_Movement_PlayerWalkUpLeft)
        applymovement(obj_D24R0101_gsmiddleman1, RuinsOfAlph_Movement_PokefanMFaceUp)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, RuinsOfAlph_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(3)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement RuinsOfAlph_Movement_PlayerWalkRightUp {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement RuinsOfAlph_Movement_PlayerWalkUp {
    walk_up * 3
    walk_in_place_down
}

movement RuinsOfAlph_Movement_PlayerWalkUpLeft {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement RuinsOfAlph_Movement_PokefanMFaceUp {
    delay_8
    walk_in_place_up
}

movement RuinsOfAlph_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

script RuinsOfAlph_EventScript_BusinessmanTrigger {
    followmonresetmovement
    lockall
    getpartyleadalive(VAR_TEMP_x4005)
    followerpokeiseventtrigger(EVENT_ARCEUS_MOVIE_GIFT, VAR_TEMP_x4005, VAR_TEMP_x4006)
    if (var(VAR_TEMP_x4006) != 0) {
    } else {
        followerpokeiseventtrigger(EVENT_ARCEUS_HALL_OF_ORIGIN, VAR_TEMP_x4005, VAR_TEMP_x4007)
        if (var(VAR_TEMP_x4007) == 0) { goto(_0530) }
    }
    playeronbikecheck(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 1) {
        dooranimationload(13, 8, 25, 29, 77)
        dooranimationopen(77)
        dooranimationwait(77)
        clearflag(FLAG_HIDE_ALPH_OUTSIDE_ARCEUS_EVENT_SUIT)
        addobject(obj_D24R0101_suit)
        dooranimationclose(77)
        dooranimationwait(77)
        dooranimationunload(77)
        applymovement(obj_D24R0101_suit, RuinsOfAlph_Movement_BusinessmanWalkDownUp)
        applymovement(obj_player, RuinsOfAlph_Movement_PlayerWalkDown)
        getplayerfacing(VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) == 3) {
            applymovement(obj_partner_poke, RuinsOfAlph_Movement_FollowMonWalkLeft)
        } elif (var(VAR_TEMP_x4001) == 2) {
            applymovement(obj_partner_poke, RuinsOfAlph_Movement_FollowMonFaceDown)
        } else {
            applymovement(obj_partner_poke, RuinsOfAlph_Movement_FollowMonWalkDown1)
        }
        waitmovement
        npcmsg("Ouch!\r")
        closemessage
        applymovement(obj_D24R0101_suit, RuinsOfAlph_Movement_BusinessmanWalkDown)
        if (var(VAR_TEMP_x4001) == 3) {
            applymovement(obj_partner_poke, RuinsOfAlph_Movement_FollowMonWalkDownRight)
        } elif (var(VAR_TEMP_x4001) == 2) {
            applymovement(obj_partner_poke, RuinsOfAlph_Movement_FollowMonWalkDown2)
        } else {
            applymovement(obj_partner_poke, RuinsOfAlph_Movement_FollowMonWalkUpRight)
        }
        waitmovement
        npcmsg("Are you OK?\n"
               "I was in a hurry and...\f"
               "Sorry, did I hurt you?\r")
        closemessage
        if (var(VAR_TEMP_x4001) == 3) {
            applymovement(obj_D24R0101_suit, RuinsOfAlph_Movement_BusinessmanWalkRight1)
        } else {
            applymovement(obj_D24R0101_suit, RuinsOfAlph_Movement_BusinessmanWalkRight2)
        }
        waitmovement
        npcmsg("No way!\n"
               "Could it be a Pokémon from Sinnoh...\f"
               "The one they call ARCEUS...?\r")
        closemessage
        applymovement(obj_D24R0101_suit, RuinsOfAlph_Movement_BusinessmanWalkRightLeft)
        waitmovement
        npcmsg("Oh, could it be...?\n"
               "ARCEUS causing all this...?\r"
               "I cannot explain it any other way...\r")
        closemessage
        applymovement(obj_D24R0101_suit, RuinsOfAlph_Movement_BusinessmanExclamation)
        waitmovement
        npcmsg("ARCEUS may be the key to solving the\n"
               "mystery of the UNOWN and the\f"
               "Ruins of Alph...?\r")
        closemessage
        applymovement(obj_D24R0101_suit, RuinsOfAlph_Movement_BusinessmanWalkLeftDown)
        waitmovement
        npcmsg("Can you come to the Ruins of Alph with\n"
               "me? Please! You must!\r"
               "I am trembling with excitement.\n"
               "I think something is about to happen!\r")
        closemessage
        setvar(VAR_SCENE_SINJOH_MYSTRI_ROOM, 2)
        setflag(FLAG_HIDE_ALPH_OUTSIDE_ARCEUS_EVENT_SUIT)
        clearflag(FLAG_HIDE_ALPH_MAIN_CHAMBER_ARCEUS_EVENT_PEOPLE)
        playse(SEQ_SE_DP_KAIDAN2)
        if (var(VAR_UNOWN_REPORT_LEVEL) == 6) {
            fadescreen(6, 1, 0, RGB_BLACK)
            waitfade
            warp(MAP_RUINS_OF_ALPH_UNDERGROUND_HALL_SINJOH_EVENT, 0, 15, 24, DIR_WEST)
            fadescreen(6, 1, 1, RGB_BLACK)
            waitfade
        } elif (var(VAR_UNOWN_REPORT_LEVEL) == 7) {
            fadescreen(6, 1, 0, RGB_BLACK)
            waitfade
            warp(MAP_RUINS_OF_ALPH_UNDERGROUND_HALL_SINJOH_EVENT_2, 0, 15, 24, DIR_WEST)
            fadescreen(6, 1, 1, RGB_BLACK)
            waitfade
        } elif (var(VAR_UNOWN_REPORT_LEVEL) == 8) {
            fadescreen(6, 1, 0, RGB_BLACK)
            waitfade
            warp(MAP_RUINS_OF_ALPH_UNDERGROUND_HALL_SINJOH_EVENT_2, 0, 15, 24, DIR_WEST)
            fadescreen(6, 1, 1, RGB_BLACK)
            waitfade
        } elif (var(VAR_UNOWN_REPORT_LEVEL) == 9) {
            fadescreen(6, 1, 0, RGB_BLACK)
            waitfade
            warp(MAP_RUINS_OF_ALPH_UNDERGROUND_HALL_SINJOH_EVENT_2, 0, 15, 24, DIR_WEST)
            fadescreen(6, 1, 1, RGB_BLACK)
            waitfade
        } else {
            fadescreen(6, 1, 0, RGB_BLACK)
            waitfade
            warp(MAP_RUINS_OF_ALPH_UNDERGROUND_HALL, 0, 15, 24, DIR_WEST)
            fadescreen(6, 1, 1, RGB_BLACK)
            waitfade
        }
    }
_0530:
    releaseall
    end
}

movement RuinsOfAlph_Movement_BusinessmanWalkDownUp {
    delay_4
    walk_fast_down * 3
    lock_dir
    walk_faster_up
    unlock_dir
}

movement RuinsOfAlph_Movement_BusinessmanWalkDown {
    walk_fast_down
}

movement RuinsOfAlph_Movement_BusinessmanWalkRight1 {
