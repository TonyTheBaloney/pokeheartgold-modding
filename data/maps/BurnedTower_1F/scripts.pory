script BurnedTower_1F_EventScript_RivalTrigger {
    followmonresetmovement
    lockall
    callstd(std_play_rival_intro_music)
    applymovement(obj_D18R0101_gsrivel, BurnedTower_1F_Movement_RivalWalkDownLeft1)
    waitmovement
    bufferrivalsname(0)
    npcmsg("{STRVAR_1 3, 0, 0}: ..................\r"
           "......Oh, it’s you.\r"
           "You must be here to catch the\n"
           "legendary Pokémon to make yourself\f"
           "look strong.\r"
           "That is only a dream.\r"
           "You see, the legendary Pokémon suits a\n"
           "Trainer like me who has sworn to become\f"
           "the strongest Trainer.\r"
           "A battle with Team Rocket Grunts\n"
           "is just right for you!\r")
    closemessage
    getstarterchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 152) {
        trainerbattle(TRAINER_RIVAL_SILVER_8, 0, 0, 0)
    } elif (var(VAR_SPECIAL_RESULT) == 155) {
        trainerbattle(TRAINER_RIVAL_SILVER_11, 0, 0, 0)
    } else {
        trainerbattle(TRAINER_RIVAL_SILVER_4, 0, 0, 0)
    }
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    callstd(std_play_rival_outro_music)
    bufferrivalsname(0)
    npcmsg("{STRVAR_1 3, 0, 0}: ...Aw, whatever.\r"
           "You would never be able to catch a\n"
           "legendary Pokémon anyway.\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(56)
    applymovement(obj_player, BurnedTower_1F_Movement_PlayerWalkDownRight)
    applymovement(obj_D18R0101_gsrivel, BurnedTower_1F_Movement_RivalWalkDownLeft2)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    removeobject(obj_D18R0101_gsrivel)
    callstd(std_fade_end_rival_outro_music)
    setflag(FLAG_HIDE_BURNED_TOWER_1F_RIVAL)
    setvar(VAR_UNK_40A6, 1)
    releaseall
    end
}

movement BurnedTower_1F_Movement_RivalWalkDownLeft1 {
    face_down
    emote_exclamation_mark
    walk_down * 4
    walk_left
    face_down
}

movement BurnedTower_1F_Movement_PlayerWalkDownRight {
    walk_down * 2
    walk_right
    face_left
}

movement BurnedTower_1F_Movement_RivalWalkDownLeft2 {
    walk_down * 3
    walk_left
    walk_down
    walk_left * 3
    walk_down
    walk_left * 4
    walk_down * 3
}

script BurnedTower_1F_EventScript_EusineTrigger {
    followmonresetmovement
    lockall
    callstd(std_play_eusine_music)
    applymovement(obj_D18R0101_minaki, BurnedTower_1F_Movement_EusineWalkLeft)
    waitmovement
    bufferplayersname(0)
    npcmsg("Eusine: My name is Eusine.\r"
           "I’m on the trail of a Pokémon named\n"
           "SUICUNE.\r"
           "And you are...?\n"
           "{STRVAR_1 3, 0, 0}? Glad to meet you.\r"
           "I heard rumors that SUICUNE is here,\n"
           "so I came to look.\r"
           "Take a look at the basement through\n"
           "the hole in the floor.\r"
           "There. SUICUNE is down there.\r"
           "I could go downstairs, but I know it\n"
           "would run away in no time.\r"
           "I know.\n"
           "I have tried it many times...")
    waitbuttonpress
    closemessage
    callstd(std_fade_end_eusine_music)
    setvar(VAR_UNK_40A2, 1)
    releaseall
    end
}

script BurnedTower_1F_EventScript_Eusine {
    simplenpcmsg("Eusine: There seems to be more than\n"
                 "meets the eye with you...")
    end
}

movement BurnedTower_1F_Movement_EusineWalkLeft {
    face_left
    emote_exclamation_mark
    walk_left * 3
}

script BurnedTower_1F_EventScript_Morty {
    simplenpcmsg("Morty: My name is Morty.\n"
                 "I am Ecruteak’s Gym Leader.\r"
                 "Because my old friend Eusine is here\n"
                 "on the trail of SUICUNE, I decided to\f"
                 "investigate the Burned Tower.\r"
                 "Ecruteak has a legend about these\n"
                 "legendary Pokémon:\f"
                 "SUICUNE, ENTEI, and RAIKOU.\r"
                 "As the Gym Leader of Ecruteak, I must\n"
                 "have a proper understanding of it.")
    end
}

