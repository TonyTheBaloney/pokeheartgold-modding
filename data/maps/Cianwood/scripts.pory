script Cianwood_EventScript_Sign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 6)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(2, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 9)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 7)
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_player, Cianwood_Movement_PlayerWalkRightUp)
    } elif (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, Cianwood_Movement_PlayerWalkUp)
    } else {
        applymovement(obj_player, Cianwood_Movement_PlayerWalkUpLeft)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    followmonisactive(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_partner_poke, Cianwood_Movement_FollowMonWalkRightUp)
        waitmovement
    }
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(35)
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    getstdmsgnaix(2, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 8)
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Cianwood_Movement_PlayerWalkRightUp {
    walk_right
    walk_up * 2
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Cianwood_Movement_PlayerWalkUp {
    walk_up * 3
    walk_in_place_down
}

movement Cianwood_Movement_PlayerWalkUpLeft {
    walk_up
    walk_left
    walk_up * 3
    walk_in_place_down
}

movement Cianwood_Movement_FollowMonWalkRightUp {
    walk_right
    walk_up
    face_down
}

