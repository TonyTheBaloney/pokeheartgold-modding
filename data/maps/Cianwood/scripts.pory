script Cianwood_EventScript_PokefanFScene {
    followmonresetmovement
    lockall
    applymovement(obj_T24_middlewoman1_2, Cianwood_Movement_PokefanFWalkUp)
    applymovement(obj_player, Cianwood_Movement_PlayerFaceRight)
    waitmovement
    npcmsg("That’s Cianwood’s Gym Badge!\r"
           "Then you should take this HM.\r")
    if (!itemspace(ITEM_HM02, 1)) {
        callstd(std_bag_is_full)
        closemessage
        releaseall
        end
    }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_HM02)
    setvar(VAR_UNK_4116, 2)
    npcmsg("Teach Fly to your Pokémon.\r"
           "You will be able to Fly instantly\n"
           "to anywhere you have visited.")
    waitbuttonpress
    closemessage
    applymovement(obj_T24_middlewoman1_2, Cianwood_Movement_PokefanFWalkDown)
    waitmovement
    if (var(VAR_MIDGAME_BADGES) == 4) { goto(_00F0) }
    releaseall
    end
}

movement Cianwood_Movement_PokefanFWalkUp {
    walk_in_place_fast_up
    emote_exclamation_mark
    walk_up * 2
    face_left
}

movement Cianwood_Movement_PokefanFWalkDown {
    walk_down * 2
    walk_in_place_fast_up
}

movement Cianwood_Movement_PlayerFaceRight {
    delay_16 * 3
    face_right
}

