script Cianwood_EventScript_EusineTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_player, Cianwood_Movement_PlayerExclamation)
    waitmovement
    playcry(SPECIES_SUICUNE, 0)
    release(obj_T24_tsure_poke_static_suicune)
    spinobject(obj_T24_tsure_poke_static_suicune, 2, 90, 2, 0)
    lock(obj_T24_tsure_poke_static_suicune)
    waitcry
    applymovement(obj_T24_tsure_poke_static_suicune, Cianwood_Movement_SuicuneMove)
    waitmovement
    applymovement(obj_T24_tsure_poke_static_suicune, Cianwood_Movement_SuicuneFaceDown)
    applymovement(obj_player, Cianwood_Movement_PlayerFaceUp)
    waitmovement
    wait(30, VAR_SPECIAL_RESULT)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_T24_tsure_poke_static_suicune, Cianwood_Movement_SuicuneExit)
    applymovement(obj_player, Cianwood_Movement_PlayerWalkRight)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    removeobject(obj_T24_tsure_poke_static_suicune)
    setflag(FLAG_HIDE_CIANWOOD_SUICUNE)
    addvar(VAR_UNK_4076, 1)
    clearflag(FLAG_HIDE_CIANWOOD_EUSINE)
    addobject(obj_T24_minaki)
    callstd(std_play_eusine_music)
    applymovement(obj_T24_minaki, Cianwood_Movement_EusineWalkUpRight)
    applymovement(obj_player, Cianwood_Movement_PlayerFaceDown)
    waitmovement
    bufferplayersname(0)
    npcmsg("Eusine: Yo, {STRVAR_1 3, 0, 0}.\r"
           "Wasn’t that SUICUNE just now?\r"
           "I only caught a quick glimpse, but I\n"
           "thought I saw SUICUNE running on\f"
           "the waves.\r"
           "SUICUNE is beautiful and grand.\n"
           "And it races through towns and\f"
           "roads at simply awesome speeds.\r"
           "It’s wonderful...\r"
           "I want to see SUICUNE up close...\r"
           "I’ve decided.\n"
           "I’ll battle you as a Trainer to earn\f"
           "SUICUNE’s respect!\r"
           "Come on, {STRVAR_1 3, 0, 0}.\n"
           "Let’s battle now!")
    waitabpress
    closemessage
    trainerbattle(TRAINER_MYSTERY_MAN_EUSINE, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        removeobject(obj_T24_minaki)
        setflag(FLAG_HIDE_CIANWOOD_EUSINE)
        clearflag(FLAG_HIDE_ROUTE_42_SUICUNE)
        setvar(VAR_UNK_4092, 1)
        whiteout
        releaseall
    scr_seq_T24_003:
        end
    }
    bufferplayersname(0)
    npcmsg("You’re amazing, {STRVAR_1 3, 0, 0}!\r"
           "I’m starting to understand why SUICUNE\n"
           "was keeping an eye on you.\r"
           "I’m going to keep searching\n"
           "for SUICUNE.\r"
           "I have a feeling we’ll see each other\n"
           "again. See you around!\r")
    closemessage
    applymovement(obj_T24_minaki, Cianwood_Movement_EusineWalkDownLeft)
    waitmovement
    removeobject(obj_T24_minaki)
    setflag(FLAG_HIDE_CIANWOOD_EUSINE)
    clearflag(FLAG_HIDE_ROUTE_42_SUICUNE)
    setvar(VAR_UNK_4092, 1)
    releaseall
    end
}

script Cianwood_EventScript_PokefanF1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GAME_CLEAR)) {
        checkregisteredphonenumber(PHONE_CONTACT_CHUCK, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4001) == 1) { goto(_02CD) }
        if (var(VAR_TEMP_x4002) >= 1) {
            npcmsg("Do you want to exchange your\n"
                   "number for my husband’s? {YESNO 0}")
            goto(_0299)
            end
        }
        npcmsg("His only hobby is to battle\n"
               "tough Trainers.\r"
               "Do you want to have my\n"
               "husband’s phone number? {YESNO 0}")
    _0299:
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 0) { goto(_02BD) }
        if (var(VAR_SPECIAL_RESULT) >= 1) { goto(_02D8) }
        end
    _02BD:
        bufferplayersname(0)
        npcmsg("{STRVAR_1 3, 0, 0} registered Chuck\n"
               "in the Pokégear!")
        playfanfare(SEQ_ME_POKEGEAR_REGIST)
        waitfanfare
        registergearnumber(PHONE_CONTACT_CHUCK)
    _02CD:
        npcmsg("He takes a break from the pounding\n"
               "waterfall on Wednesday nights.\r"
               "He should be able to chat with\n"
               "you then.")
        waitbuttonpress
        closemessage
        releaseall
        end
    _02D8:
        setvar(VAR_TEMP_x4002, 1)
        npcmsg("Oh, I see.\n"
               "My husband won’t be a good match?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_GOT_HM02)) { goto(_026B) }
    npcmsg("You crossed the sea to get here?\r"
           "That must have been hard.\r"
           "It would be much easier if your\n"
           "Pokémon knew how to Fly...\r")
    npcmsg("But you can’t use Fly without this\n"
           "city’s Gym Badge.\r"
           "If you beat the Gym Leader here,\n"
           "come see me.\f"
           "I’ll have a nice gift for you.")
    waitbuttonpress
    closemessage
    releaseall
    end
_026B:
    npcmsg("My husband lost to you, so he needs\n"
           "to train harder.\r"
           "That’s good, since he was getting a\n"
           "little chubby.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

