script scr_seq_T07GYM0101_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_RAINBOW, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_01A5) }
    npcmsg("Erika: Hello...\n"
           "Lovely weather, isn’t it?\r"
           "It’s so pleasant...\n"
           "I’m afraid I might doze off...\r"
           "My name is Erika.\n"
           "I am the Leader of Celadon Gym.\r"
           "...Oh? You are from Johto, you say?\f"
           "How nice...\r"
           "Oh. I’m sorry, I didn’t realize that\n"
           "you wished to challenge me.\r"
           "I know.\r"
           "I have been training myself on\n"
           "not only flower arrangement\f"
           "but also Pokémon battle.\r"
           "I shall not lose.\r")
    closemessage
    trainerbattle(TRAINER_LEADER_ERIKA_ERIKA, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    givebadge(BADGE_RAINBOW)
    addvar(VAR_UNK_4135, 1)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    settrainerflag(TRAINER_TWINS_JO_AND_ZOE)
    settrainerflag(TRAINER_LASS_MICHELLE)
    settrainerflag(TRAINER_PICNICKER_TANYA)
    settrainerflag(TRAINER_BEAUTY_JULIA)
    npcmsg("Erika: Oh!\n"
           "I concede defeat...\r"
           "You are remarkably strong...\n"
           "I shall give you the Rainbow Badge...\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Rainbow Badge.")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    npcmsg("Erika: That was a delightful match.\n"
           "I felt inspired.\r"
           "Please, I wish you to have this TM19\n"
           "as a special token.\r"
           "It is Giga Drain.\n"
           "It is a wonderful move that drains\f"
           "half the damage it inflicts to heal\f"
           "your Pokémon.\r"
           "It is indeed a horrifying move.\r")
    goto(_017C)
_017C:
    if (!itemspace(ITEM_TM19, 1)) {
        callstd(std_bag_is_full)
        closemessage
        releaseall
        end
    }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM19_FROM_ERIKA)
_01A5:
    if (!flag(FLAG_GOT_TM19_FROM_ERIKA)) { goto(_017C) }
    npcmsg("Erika: Losing leaves a\n"
           "bitter aftertaste...\r"
           "But knowing that there are strong\n"
           "Trainers spurs me to do better...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

