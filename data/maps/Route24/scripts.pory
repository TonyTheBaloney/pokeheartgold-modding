script Route24_EventScript_GruntTrigger {
    followmonresetmovement
    lockall
    getplayerfacing(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 0) {
        applymovement(obj_R24_rocketm, Route24_Movement_GruntWalkLeft1)
        applymovement(obj_R24_gsman1, Route24_Movement_ManFaceDown)
        applymovement(obj_R24_gswoman2, Route24_Movement_BeautyWalkDown)
    } else {
        applymovement(obj_R24_rocketm, Route24_Movement_GruntWalkLeft2)
        applymovement(obj_R24_gsman1, Route24_Movement_ManFaceDown)
        applymovement(obj_R24_gswoman2, Route24_Movement_BeautyWalkDown)
    }
    waitmovement
    setvar(VAR_SCENE_ROUTE_24_ROCKET, 2)
    releaseall
    end
}

movement Route24_Movement_GruntWalkLeft1 {
    emote_exclamation_mark
    walk_fast_left * 3
}

movement Route24_Movement_GruntWalkLeft2 {
    face_up
    emote_exclamation_mark
    walk_fast_left * 3
}

movement Route24_Movement_ManFaceDown {
    delay_16 * 3
    face_down
}

movement Route24_Movement_BeautyWalkDown {
    delay_16 * 3
    walk_fast_down
    face_up
}

script Route24_EventScript_Grunt {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    stopbgm(SEQ_GS_R_12_24)
    playbgm(SEQ_GS_EYE_ROCKET)
    npcmsg("Oh no!\r"
           "Hiding I was, but you did\n"
           "me found in no time!\r"
           "...\n"
           "Me only one from another country.\r"
           "Yet! No big business, OK?\r"
           "Think I did, if stop the energy,\n"
           "be big panic and unlucky\f"
           "for here people!\r"
           "Secret it is my mission,\n"
           "so tell you I not!\r"
           "But! If win you do versus me,\n"
           "a man I be and mine secret\f"
           "to you tell. You understand?\f"
           "Battle begin we do!\r")
    closemessage
    trainerbattle(TRAINER_TEAM_ROCKET_GRUNT_24, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    npcmsg("OK. Tell you mine secret will I.\r"
           "Machine Part steal by me. Hide it\n"
           "I did in Gym of the Cerulean.\r"
           "Near inflatable tube put it I did.\n"
           "Look for Gym at.\r"
           "But you forget me not!\n"
           "Beat you for sure will Team Rocket.\r"
           "Come from Johto will they, mine\n"
           "allies, yes. Will revenge they are.\r")
    closemessage
    fadeoutbgm(0, 30)
    npcmsg("...\r"
           "You say what? Team Rocket bye-bye\n"
           "a go-go? Broken up it is says you?\r"
           "Oh, no! Should I do what now on\n"
           "from, me?\r"
           "...OK.\r"
           "I my country go home.\r"
           "Make Team Rocket I will.\n"
           "Good-bye! So long!\r")
    closemessage
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(56)
    applymovement(obj_R24_rocketm, Route24_Movement_GruntWalkRightDown)
    applymovement(obj_player, Route24_Movement_PlayerWalkRight)
    applymovement(obj_R24_gsman1, Route24_Movement_ManFaceLeft)
    applymovement(obj_R24_gswoman2, Route24_Movement_BeautyWalkUp)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    removeobject(obj_R24_rocketm)
    setflag(FLAG_HIDE_ROUTE_24_ROCKET)
    clearflag(FLAG_HIDE_CERULEAN_GYM_MACHINE_PART)
    playbgm(SEQ_GS_R_12_24)
    setvar(VAR_SCENE_ROUTE_24_ROCKET, 3)
    releaseall
    end
}

movement Route24_Movement_GruntWalkRightDown {
    walk_fast_right
    walk_fast_down * 10
}

movement Route24_Movement_PlayerWalkRight {
    lock_dir
    walk_fast_right
    unlock_dir
    face_down
}

movement Route24_Movement_ManFaceLeft {
    delay_4 * 12
    face_left
}

movement Route24_Movement_BeautyWalkUp {
    delay_4
    face_down
    delay_4 * 10
    walk_up
    face_left
}

script Route24_EventScript_Man {
    playse(SEQ_SE_DP_SELECT)
    lockall
    if (var(VAR_SCENE_ROUTE_24_ROCKET) != 2) {
        if (var(VAR_SCENE_ROUTE_24_ROCKET) != 3) {
            faceplayer
            npcmsg("Can you leave us alone?\r"
                   "I am building a chemistry between us,\n"
                   "and it’s finally working.")
            goto(_01DF)
        _01DC:
            npcmsg("Who is this guy in black?\n"
                   "Coming between me and my girlfriend...!")
        _01DF:
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        faceplayer
        npcmsg("We are finally alone.\n"
               "You will not bother us, right?")
        goto(_01DF)
        goto(_01DC)
    }
    goto(_01DC)
    goto(_01DC)
}

