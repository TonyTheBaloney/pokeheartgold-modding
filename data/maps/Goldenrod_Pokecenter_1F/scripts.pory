scrdefs {
    Goldenrod_Pokecenter_1F_EventScript_Nurse
    Goldenrod_Pokecenter_1F_EventScript_Boy
    Goldenrod_Pokecenter_1F_EventScript_LittleGirl
    Goldenrod_Pokecenter_1F_EventScript_FatMan
}

script Goldenrod_Pokecenter_1F_EventScript_Nurse {
    setvar(VAR_SPECIAL_x8007, 0)
    callstd(std_nurse_joy)
    end
}

script Goldenrod_Pokecenter_1F_EventScript_FatMan {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("Team Rocket...!")
    } else {
        npcmsg("I wonder how many kinds of Pokémon\n"
               "there are in the world.\r"
               "A long time ago, Professor Oak said\n"
               "there were 150 different kinds...\r"
               "Since then, many new Pokémon have\n"
               "been discovered in different regions.\r"
               "There are almost 500 different kinds\n"
               "known now...")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Goldenrod_Pokecenter_1F_EventScript_LittleGirl {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("I think I’ve met you before...\r"
               "You must have a reason for\n"
               "looking like that...?")
    } else {
        npcmsg("A higher level Pokémon doesn’t\n"
               "always win.\r"
               "After all, it may have a type\n"
               "disadvantage.\r"
               "I don’t think there is a single\n"
               "Pokémon that is the toughest.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Goldenrod_Pokecenter_1F_EventScript_Boy {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("Oh, you are a Team Rocket member...")
    } else {
        npcmsg("The Colosseum upstairs is for\n"
               "link battles.\r"
               "Battle records, such as how many times\n"
               "you had link battles and the results,\f"
               "are recorded on the back of your\f"
               "Trainer Card.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

mapscripts Goldenrod_Pokecenter_1F_MapScripts {
    INIT_SCRIPT_ON_RESUME: std_wireless_reset_state
    INIT_SCRIPT_ON_FRAME_TABLE [
        VAR_UNK_4133, 2: std_union_room_return
        VAR_UNK_4133, 1: std_wireless_colosseum_return
    ]
}
