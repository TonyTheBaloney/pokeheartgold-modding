script Route40_OnTransition {
    getweekday(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 1) {
        clearflag(FLAG_UNK_206)
    } else {
        setflag(FLAG_UNK_206)
    }
    end
}

script Route40_EventScript_Woman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getpartyleadalive(VAR_SPECIAL_x8002)
    monhasribbon(VAR_SPECIAL_RESULT, VAR_SPECIAL_x8002, RIBBON_ALERT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 29)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_DAILY_GOT_SHOCK_RIBBON)) {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 31)
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_NUM_MET_WEEKDAY_SIBLINGS) == 7) { goto(_011F) }
    if (flag(FLAG_GOT_SHARP_BEAK_FROM_MONICA)) { goto(_0101) }
    getweekday(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 1) {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 3)
    } else {
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 0)
        if (!itemspace(ITEM_SHARP_BEAK, 1)) { goto(_0115) }
        callstd(std_give_item_verbose)
        setflag(FLAG_GOT_SHARP_BEAK_FROM_MONICA)
        addvar(VAR_NUM_MET_WEEKDAY_SIBLINGS, 1)
        getstdmsgnaix(0, VAR_SPECIAL_RESULT)
        msgboxextern(VAR_SPECIAL_RESULT, 1)
    }
_00F9:
    waitbuttonpress
    closemessage
    releaseall
    end
_0101:
    getstdmsgnaix(0, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 2)
    waitbuttonpress
    closemessage
    releaseall
    end
_0115:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
_011F:
    getweekday(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0142) }
    getstdmsgnaix(0, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 3)
    goto(_00F9)
_0142:
    getstdmsgnaix(0, VAR_SPECIAL_RESULT)
    msgboxextern(VAR_SPECIAL_RESULT, 28)
    buffermonspeciesname(0, VAR_SPECIAL_x8002)
    msgboxextern(VAR_SPECIAL_RESULT, 30)
    giveribbon(VAR_SPECIAL_x8002, RIBBON_ALERT)
    playfanfare(SEQ_ME_ITEM)
    waitfanfare
    setflag(FLAG_DAILY_GOT_SHOCK_RIBBON)
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route40_EventScript_PokefanMTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_W40_gsmiddleman1, Route40_Movement_PokefanMExclamation)
    waitmovement
    getplayercoords(VAR_SPECIAL_x8000, VAR_SPECIAL_x8001)
    if (var(VAR_SPECIAL_x8000) == 252) {
        applymovement(obj_W40_gsmiddleman1, Route40_Movement_PokefanMWalkUp1)
    } elif (var(VAR_SPECIAL_x8000) == 253) {
        applymovement(obj_W40_gsmiddleman1, Route40_Movement_PokefanMWalkUpRight1)
    } elif (var(VAR_SPECIAL_x8000) == 254) {
        applymovement(obj_W40_gsmiddleman1, Route40_Movement_PokefanMWalkUpRight2)
    } else {
        applymovement(obj_W40_gsmiddleman1, Route40_Movement_PokefanMWalkUpRight3)
    }
    waitmovement
    followmonisactive(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) != 0) {
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(56)
    }
    applymovement(obj_W40_gsmiddleman1, Route40_Movement_PokefanMWalkUp2)
    applymovement(obj_player, Route40_Movement_PlayerWalkUp)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("Hey!\n"
           "Great waves here!\r"
           "No one can resist such\n"
           "good waves!\r")
    closemessage
    applymovement(obj_W40_gsmiddleman1, Route40_Movement_PokefanMExclamation)
    waitmovement
    npcmsg("I see... You don’t have Surf yet...\n"
           "This is just between you and me...\r"
           "I got Surf from a man at Ecruteak,\n"
           "and I think he’s still there.\r"
           "Why don’t you try going there?\r")
    closemessage
    getplayercoords(VAR_SPECIAL_x8000, VAR_SPECIAL_x8001)
    if (var(VAR_SPECIAL_x8000) == 252) {
        applymovement(obj_W40_gsmiddleman1, Route40_Movement_PokefanMWalkDown)
    } elif (var(VAR_SPECIAL_x8000) == 253) {
        applymovement(obj_W40_gsmiddleman1, Route40_Movement_PokefanMWalkDownLeft1)
    } elif (var(VAR_SPECIAL_x8000) == 254) {
        applymovement(obj_W40_gsmiddleman1, Route40_Movement_PokefanMWalkDownLeft2)
    } else {
        applymovement(obj_W40_gsmiddleman1, Route40_Movement_PokefanMWalkDownLeft3)
    }
    waitmovement
    releaseall
    end
}

movement Route40_Movement_PlayerWalkUp {
    lock_dir
    walk_up
    unlock_dir
}

movement Route40_Movement_PokefanMExclamation {
    emote_exclamation_mark
    delay_8
}

movement Route40_Movement_PokefanMWalkUp1 {
    walk_fast_up * 5
    walk_in_place_up * 2
}

movement Route40_Movement_PokefanMWalkUpRight1 {
    walk_fast_up * 2
    walk_fast_right
    walk_fast_up * 3
    walk_in_place_up * 2
}

movement Route40_Movement_PokefanMWalkUpRight2 {
    walk_fast_up * 2
    walk_fast_right * 2
    walk_fast_up * 3
    walk_in_place_up * 2
}

movement Route40_Movement_PokefanMWalkUpRight3 {
    walk_fast_up * 2
    walk_fast_right * 3
    walk_fast_up * 3
    walk_in_place_up * 2
}

movement Route40_Movement_PokefanMWalkUp2 {
    walk_up
}

movement Route40_Movement_PokefanMWalkDown {
    walk_fast_down * 6
    walk_in_place_up
}

movement Route40_Movement_PokefanMWalkDownLeft1 {
    walk_fast_down * 3
    walk_fast_left
    walk_fast_down * 3
    walk_in_place_up
}

movement Route40_Movement_PokefanMWalkDownLeft2 {
    walk_fast_down * 3
    walk_fast_left * 2
    walk_fast_down * 3
    walk_in_place_up
}

movement Route40_Movement_PokefanMWalkDownLeft3 {
    walk_fast_down * 3
    walk_fast_left * 3
    walk_fast_down * 3
    walk_in_place_up
}

