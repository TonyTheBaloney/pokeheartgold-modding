script scr_seq_T26R0601_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_GOOD_ROD)) {
        npcmsg("How are things?\n"
               "Land the big one?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Olivine is on the sea!\r"
           "And if it’s on the sea, there is bound\n"
           "to be something to catch!\r"
           "I’ve fished here for 30 years.\r"
           "Would you like to face the sea\n"
           "and fish? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0040) }
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0079) }
    end
_0040:
    if (!itemspace(ITEM_GOOD_ROD, 1)) { goto(_0084) }
    npcmsg("Ah, hahah!\n"
           "We have ourselves a new angler!")
    waitbuttonpress
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_GOOD_ROD)
    npcmsg("Water-type Pokémon aren’t found\n"
           "in the sea alone.\f"
           "They go wherever there is water.")
    waitbuttonpress
    closemessage
    releaseall
    end
_0079:
    npcmsg("Whaaat? You don’t like to fish!?\f"
           "Incomprehensible!")
    waitbuttonpress
    closemessage
    releaseall
    end
_0084:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

