                    setvar(VAR_SPECIAL_x8005, 2)
                } else {
                    setvar(VAR_SPECIAL_x8005, 1)
                }
                bufferplayersname(0)
                bufferint(1, VAR_SPECIAL_x8004)
                bufferint(2, VAR_SPECIAL_x8005)
                gendermsgbox("Lyra: Hi, {STRVAR_1 3, 0, 0}!\n"
