}

script NewBark_RivalHouse_2F_EventScript_Marill {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("MARILL: Qurururoon.")
    playcry(SPECIES_MARILL, 0)
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

script NewBark_RivalHouse_2F_EventScript_ItsAWiiSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("It’s a Wii!\r"
           "Wii is huge in Johto, too!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script NewBark_RivalHouse_2F_EventScript_PC {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("You shouldn’t mess with someone\n"
           "else’s PC!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

