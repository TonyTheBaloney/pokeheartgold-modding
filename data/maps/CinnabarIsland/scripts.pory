script CinnabarIsland_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        if (flag(FLAG_UNK_129)) {
            setflag(FLAG_UNK_25A)
            getphonebookrematch(PHONE_CONTACT_BLUE, VAR_TEMP_x4001)
            if (var(VAR_TEMP_x4001) == 0) {
                if (var(VAR_UNK_40FD) != 0) {
                    getweekday(VAR_TEMP_x4002)
                    if (var(VAR_TEMP_x4002) == 5) {
                        clearflag(FLAG_UNK_25A)
                    } else {
                        setflag(FLAG_UNK_25A)
                    }
                }
            }
            checkregisteredphonenumber(PHONE_CONTACT_BLAINE, VAR_TEMP_x4001)
            if (var(VAR_TEMP_x4001) == 1) {
                getphonebookrematch(PHONE_CONTACT_BLAINE, VAR_TEMP_x4001)
                if (var(VAR_TEMP_x4001) != 0) { goto(_0102) }
                getweekday(VAR_TEMP_x4002)
                if (var(VAR_TEMP_x4002) == 4) {
                    clearflag(FLAG_UNK_27D)
                } else {
                    goto(_0102)
                }
                end
            _0102:
                setflag(FLAG_UNK_27D)
                end
            }
            checkbadge(BADGE_EARTH, VAR_TEMP_x4002)
            if (var(VAR_TEMP_x4002) == 1) { goto(_00A9) }
            goto(_0102)
            end
        _00A9:
            getweekday(VAR_TEMP_x4002)
            if (var(VAR_TEMP_x4002) == 2) {
                clearflag(FLAG_UNK_27D)
            } else {
                goto(_0102)
            }
            end
        }
        setflag(FLAG_UNK_27D)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script CinnabarIsland_EventScript_Blue {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    release(obj_partner_poke)
    applymovement(obj_partner_poke, CinnabarIsland_Movement_FollowMonDelay)
    waitmovement
    lock(obj_partner_poke)
    if (var(VAR_UNK_40FD) != 0) { goto(_0304) }
    if (!flag(FLAG_UNK_128)) {
        setflag(FLAG_UNK_128)
        npcmsg("Who are you?\r"
               "My name’s Blue.\n"
               "I was once the Kanto Champion.\r"
               "Although it was short-lived thanks\n"
               "to Red...\f"
               "Anyway, take a good look around you...\r")
        closemessage
        getplayerfacing(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 0) {
            applymovement(obj_T09_gsleader16, CinnabarIsland_Movement_BlueSpin1)
        } else {
            applymovement(obj_T09_gsleader16, CinnabarIsland_Movement_BlueSpin2)
        }
        waitmovement
        npcmsg("Blue: A volcano erupts, and just\n"
               "like that, a whole town disappears.\r"
               "We can go on winning and losing in\n"
               "Pokémon, but if nature so much as\f"
               "twitches, we can be overwhelmed\f"
               "in a second...\r"
               "That’s the way it is...\n"
               "But, anyway, I’m still a Trainer.\r"
               "If I see a strong opponent, it makes me\n"
               "want to battle.\r")
    }
    if (var(VAR_UNK_4135) >= 7) {
        npcmsg("If you want to battle me...for real,\n"
               "come to the Viridian Gym.\r")
        closemessage
        getplayerfacing(VAR_TEMP_x4000)
        getpersoncoords(253, VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
        if (var(VAR_TEMP_x4000) == 0) {
            if (var(VAR_SPECIAL_x8004) == 1035) {
                applymovement(obj_partner_poke, CinnabarIsland_Movement_FollowMonWalkDownRight)
                waitmovement
            }
        } elif (var(VAR_SPECIAL_x8005) == 495) {
            applymovement(obj_partner_poke, CinnabarIsland_Movement_FollowMonWalkLeftUp)
            waitmovement
        }
        if (var(VAR_TEMP_x4000) == 0) {
            applymovement(obj_T09_gsleader16, CinnabarIsland_Movement_BlueWalkLeftDown)
        } else {
            applymovement(obj_T09_gsleader16, CinnabarIsland_Movement_BlueWalkDownLeft1)
        }
        waitmovement
        npcmsg("I’ll be waiting for you!\r")
        closemessage
        if (var(VAR_TEMP_x4000) == 0) {
            applymovement(obj_T09_gsleader16, CinnabarIsland_Movement_BlueWalkDownLeft2)
            applymovement(obj_player, CinnabarIsland_Movement_PlayerFaceDown)
            applymovement(obj_partner_poke, CinnabarIsland_Movement_PlayerFaceDown)
        } else {
            applymovement(obj_T09_gsleader16, CinnabarIsland_Movement_BlueWalkDownLeft3)
            applymovement(obj_player, CinnabarIsland_Movement_PlayerFaceDown)
            applymovement(obj_partner_poke, CinnabarIsland_Movement_PlayerFaceDown)
        }
        waitmovement
        removeobject(obj_T09_gsleader16)
        setflag(FLAG_UNK_25A)
        setflag(FLAG_UNK_129)
        setflag(FLAG_HIDE_VIRIDIAN_CITY_OLD_MAN_OUTSIDE_GYM_LOCKED)
        clearflag(FLAG_HIDE_VIRIDIAN_CITY_OLD_MAN_OUTSIDE_GYM_UNLOCKED)
        releaseall
        end
    }
    bufferint(0, VAR_UNK_4135)
    npcmsg("If you want to battle me...for real,\n"
           "show me how many Kanto Badges\f"
           "you’ve got.\r"
           "...\n"
           "{STRVAR_1 50, 0, 0}...\r"
           "You’re not ready to battle me...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement CinnabarIsland_Movement_BlueSpin1 {
    walk_in_place_right
    delay_8 * 2
    walk_in_place_up
    delay_8 * 2
    walk_in_place_down
}

movement CinnabarIsland_Movement_BlueSpin2 {
    walk_in_place_up
    delay_8 * 2
    walk_in_place_right
    delay_8 * 2
    walk_in_place_left
}

movement CinnabarIsland_Movement_BlueWalkLeftDown {
    walk_left
    walk_down
}

movement CinnabarIsland_Movement_BlueWalkDownLeft1 {
    walk_down
    walk_left
}

movement CinnabarIsland_Movement_BlueWalkDownLeft2 {
    walk_down * 2
    walk_left * 2
    walk_down * 8
}

movement CinnabarIsland_Movement_BlueWalkDownLeft3 {
    walk_down
    walk_down * 2
    walk_left * 2
    walk_down * 7
}

movement CinnabarIsland_Movement_FollowMonWalkDownRight {
    walk_down
    walk_right
    walk_in_place_left
}

movement CinnabarIsland_Movement_FollowMonWalkLeftUp {
    walk_left
    walk_up
    walk_in_place_right
}

movement CinnabarIsland_Movement_PlayerFaceDown {
    walk_in_place_down
}

movement CinnabarIsland_Movement_FollowMonDelay {
    delay_1
}

script(local) _0304 {
    npcmsg("Blue: You are quite something!\n"
           "You defeated Red!?\f"
           "That’s great!\r"
           "Let’s take a picture together! {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Blue: Oh, well...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    photoalbumisfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Your Photo Album is full.\r"
               "Access your PC and delete\n"
               "some pictures.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Blue: All right!\r")
    closemessage
    setflag(FLAG_UNK_189)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    cameronphoto(92)
    faceplayer
    lockall
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    clearflag(FLAG_UNK_189)
    npcmsg("Blue: Thanks for the nice picture!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script CinnabarIsland_EventScript_Blaine {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkregisteredphonenumber(PHONE_CONTACT_BLAINE, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) {
        npcmsg("Blaine: Oh, it is you!\n"
               "Say, do you want to take a picture\f"
               "with me right here? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Blaine: Noooo!")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        photoalbumisfull(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Your Photo Album is full.\r"
                   "Access your PC to delete\n"
                   "some pictures.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Blaine: There, stand next to me!\r")
        closemessage
        setflag(FLAG_UNK_189)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        cameronphoto(85)
        faceplayer
        lockall
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        clearflag(FLAG_UNK_189)
        npcmsg("Blaine: Oh, this is a good picture!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_TEMP_x4004) >= 1) { goto(_041E) }
    npcmsg("Blaine: I’ll never give up until the \n"
           "day I’ve rebuilt the Cinnabar Gym!\r"
           "Why not exchange numbers! {YESNO 0}")
_03A6:
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_03CA) }
    if (var(VAR_SPECIAL_RESULT) >= 1) { goto(_040D) }
    end
_03CA:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} registered Blaine\n"
           "in the Pokégear!")
    playfanfare(SEQ_ME_POKEGEAR_REGIST)
    waitfanfare
    registergearnumber(PHONE_CONTACT_BLAINE)
    npcmsg("Blaine: Hmmm...\n"
           "We should be able to battle\f"
           "on Tuesday evenings!")
    waitbuttonpress
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setflag(FLAG_UNK_27D)
    removeobject(obj_T09_gsleader15)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
_040D:
    setvar(VAR_TEMP_x4004, 1)
    npcmsg("Blaine: Oh...how disappointing!")
    waitbuttonpress
    closemessage
    releaseall
    end
_041E:
    npcmsg("Blaine: Do we want to exchange\n"
           "numbers? {YESNO 0}")
    goto(_03A6)
    end
}

script CinnabarIsland_EventScript_TrainerTips {
    trainertipsex(2, "There is a notice here...\r"
                     "The Cinnabar Gym has relocated\n"
                     "to Seafoam Islands.\f"
                     "           Blaine")
    end
}

script CinnabarIsland_EventScript_CinnabarIslandSign {
    directionsignpostex(0, 9, "Cinnabar Island\n"
                              "The Ravaged Town of the Past")
    end
}

