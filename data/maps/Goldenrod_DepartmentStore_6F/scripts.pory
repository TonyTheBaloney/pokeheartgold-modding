script scr_seq_T25R1006_005 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getweekday(VAR_TEMP_x4000)
    if (var(VAR_TEMP_x4000) == 0) {
        npcmsg("Sunday’s prizes will be:\r"
               "No. 1, TM02!\n"
               "No. 2, Luxury Ball!\f"
               "Or No. 3, a Berry!")
    } elif (var(VAR_TEMP_x4000) == 1) {
        npcmsg("Monday’s prizes will be:\r"
               "No. 1, TM65!\n"
               "No. 2, Nest Ball!\f"
               "Or No. 3, a Berry!")
    } elif (var(VAR_TEMP_x4000) == 2) {
        npcmsg("Tuesday’s prizes will be:\r"
               "No. 1, TM91!\n"
               "No. 2, Repeat Ball!\f"
               "Or No. 3, a Berry!")
    } elif (var(VAR_TEMP_x4000) == 3) {
        npcmsg("Wednesday’s prizes will be:\r"
               "No. 1, TM57!\n"
               "No. 2, Net Ball!\f"
               "Or No. 3, a Berry!")
    } elif (var(VAR_TEMP_x4000) == 4) {
        npcmsg("Thursday’s prizes will be:\r"
               "No. 1, TM60!\n"
               "No. 2, Quick Ball!\f"
               "Or No. 3, a Berry!")
    } elif (var(VAR_TEMP_x4000) == 5) {
        npcmsg("Friday’s prizes will be:\r"
               "No. 1, TM42!\n"
               "No. 2, Dusk Ball!\f"
               "Or No. 3, a Berry!")
    } else {
        npcmsg("Saturday’s prizes will be:\r"
               "No. 1, TM62!\n"
               "No. 2, Timer Ball!\f"
               "Or No. 3, a Berry!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25R1006_000 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("Team Rocket...\r"
               "You should have a drink from the\n"
               "vending machine and take a break.\r"
               "It’s about time you started thinking\n"
               "of how you want to live your life.")
    } else {
        npcmsg("If you’re tired, try the Vending\n"
               "Machine’s drinks.\f"
               "Your Pokémon will love them, too.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25R1006_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 3) {
        npcmsg("Even Team Rocket would understand\n"
               "how refreshing it is to listen to the\f"
               "Radio on the rooftop, right?")
    } else {
        npcmsg("Do you listen to the radio?\r"
               "Which shows do you prefer?\r"
               "I like Buena’s Password!\r"
               "When I catch it, I take notes so\n"
               "I don’t forget the password.\r"
               "That’s why my Pokégear is full\n"
               "of scribbles!")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_T25R1006_007 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkregisteredphonenumber(PHONE_CONTACT_WHITNEY, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 1) {
        npcmsg("Whitney: Why don’t we take a\n"
               "picture together? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Whitney: That’s a shame!")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        photoalbumisfull(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Your Photo Album is full.\r"
                   "Access your PC to delete\n"
                   "some pictures.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Whitney: OK!\n"
               "Stand right next to me, right here!\r")
        closemessage
        setflag(FLAG_UNK_189)
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        cameronphoto(15)
        faceplayer
        lockall
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        clearflag(FLAG_UNK_189)
        npcmsg("Whitney: Don’t we look good together?")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_TEMP_x4002) >= 1) { goto(_066F) }
    npcmsg("Whitney: What a coincidence!\n"
           "This must be meant to be.\r"
           "Do you want to exchange\n"
           "phone numbers? Please? {YESNO 0}")
_05F7:
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_061B) }
    if (var(VAR_SPECIAL_RESULT) >= 1) { goto(_065E) }
    end
_061B:
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} registered Whitney\n"
           "in the Pokégear!")
    playfanfare(SEQ_ME_POKEGEAR_REGIST)
    waitfanfare
    registergearnumber(PHONE_CONTACT_WHITNEY)
    npcmsg("Whitney: I’m available around noon\n"
           "on Saturdays.\r"
           "Give me a call when you’ve got time.")
    waitbuttonpress
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setflag(FLAG_UNK_26F)
    removeobject(obj_T25R1006_gsleader3)
    playse(SEQ_SE_DP_KAIDAN2)
    waitse(SEQ_SE_DP_KAIDAN2)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
_065E:
    setvar(VAR_TEMP_x4002, 1)
    npcmsg("Whitney: Don’t be so mean.")
    waitbuttonpress
    closemessage
    releaseall
    end
_066F:
    npcmsg("Whitney: Do you want to know\n"
           "my phone number now? {YESNO 0}")
    goto(_05F7)
    end
}

