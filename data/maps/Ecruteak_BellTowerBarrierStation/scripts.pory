}

movement Ecruteak_BellTowerBarrierStation_Movement_SageWalkUpRight {
    walk_up
    walk_right
    face_left
}

movement Ecruteak_BellTowerBarrierStation_Movement_SageWalkDownRight {
    walk_down
    walk_right
    face_left
}

script Ecruteak_BellTowerBarrierStation_EventScript_Sage2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_108)) {
        npcmsg("Such a young one to take on HO-OH...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_UNK_103)) { goto(_0157) }
    getgameversion(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 7) {
        npcmsg("Only those who possess the Rainbow Wing\n"
               "are given permission to go up to\f"
               "the top of the Bell Tower...\r"
               "But the rainbow-hued Pokémon will\n"
               "not come down for just anybody who\f"
               "goes up there.\r"
               "There must be something else you need.\n"
               "I’ve heard the Kimono Girls know\f"
               "something about it.")
    } else {
        npcmsg("The Johto region has two legends.\r"
               "One is the legend about Whirl Islands.\n"
               "The other is the Bell Tower legend...\r"
               "We have been passing down the\n"
               "Bell Tower legend for generations\f"
               "in Ecruteak City.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
_0157:
    npcmsg("The Bell Tower shook!\r"
           "It must be HO-OH...\n"
           "HO-OH must have returned to the top!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Ecruteak_BellTowerBarrierStation_EventScript_Sage3 {
    simplenpcmsg("The rainbow-hued Pokémon flying\n"
                 "gracefully over the tower...\r"
                 "The silvery, sparkling Pokémon resting\n"
                 "gently upon the whirling seabed...\r"
                 "All of this is far beyond my imagination.")
    end
}

mapscripts Ecruteak_BellTowerBarrierStation_MapScripts {
    INIT_SCRIPT_ON_RESUME: Ecruteak_BellTowerBarrierStation_OnResume
}
