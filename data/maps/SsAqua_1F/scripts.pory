script SsAqua_1F_EventScript_SailorScene {
    followmonresetmovement
    lockall
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, SsAqua_1F_Movement_PlayerWalkUp)
    applymovement(obj_P01R0301_seaman_2_2, SsAqua_1F_Movement_SailorWalkLeftRight)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    setvar(VAR_UNK_40DC, 1)
    releaseall
    end
}

movement SsAqua_1F_Movement_PlayerWalkUp {
    walk_up * 4
}

movement SsAqua_1F_Movement_SailorWalkLeftRight {
    lock_dir
    walk_slow_left
    unlock_dir
    face_right * 2
    delay_16
    walk_slow_right
    face_up * 2
}

script SsAqua_1F_EventScript_Sailor1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_BOAT_DIRECTION) > 1) {
        goto(_0138)
