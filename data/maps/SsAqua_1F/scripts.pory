        if (flag(FLAG_BOAT_ARRIVED)) {
            if (var(VAR_TEMP_x4000) == 1) {
                npcmsg("Fast Ship S.S. Aqua\n"
                       "has arrived in Vermilion City.")
                waitbuttonpress
                closemessage
                releaseall
                end
            _0138:
                if (flag(FLAG_BOAT_ARRIVED)) {
                    if (var(VAR_TEMP_x4000) == 1) {
                        npcmsg("Fast Ship S.S. Aqua\n"
                               "has arrived in Olivine City.")
                        waitbuttonpress
                        closemessage
                        releaseall
                        end
                    }
                    npcmsg("Fast Ship S.S. Aqua\n"
                           "has arrived in Olivine City.\r")
                    closemessage
                    applymovement(obj_P01R0301_seaman_2_2, SsAqua_1F_Movement_SailorWalkDownRight)
                    waitmovement
                    setvar(VAR_TEMP_x4000, 1)
                    releaseall
                    end
                }
                npcmsg("Fast Ship S.S. Aqua\n"
                       "is en route to Olivine City.\r"
                       "We will make an announcement when\n"
                       "we arrive.")
                waitbuttonpress
                closemessage
                releaseall
                end
            }
            npcmsg("Fast Ship S.S. Aqua\n"
                   "has arrived in Vermilion City.\r")
            closemessage
            applymovement(obj_P01R0301_seaman_2_2, SsAqua_1F_Movement_SailorWalkDownRight)
            waitmovement
            setvar(VAR_SCENE_SS_AQUA, 7)
            setvar(VAR_TEMP_x4000, 1)
            releaseall
            end
        }
        npcmsg("Fast Ship S.S. Aqua is en route to\n"
               "Vermilion City.\r"
               "We will make an announcement when\n"
               "we arrive.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    goto(_00EB)
    goto(_00EB)
}

movement SsAqua_1F_Movement_SailorWalkDownRight {
    lock_dir
    walk_down
    unlock_dir
    face_left * 2
    lock_dir
    walk_right
    unlock_dir
}

script SsAqua_1F_EventScript_GentlemanTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_player, SsAqua_1F_Movement_PlayerExclamation)
    waitmovement
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 22) {
        movepersonfacing(obj_P01R0301_gsgentleman, 31, 0, VAR_TEMP_x4001, DIR_WEST)
    } elif (var(VAR_TEMP_x4000) == 23) {
        movepersonfacing(obj_P01R0301_gsgentleman, 32, 0, VAR_TEMP_x4001, DIR_WEST)
    } elif (var(VAR_TEMP_x4000) == 24) {
        movepersonfacing(obj_P01R0301_gsgentleman, 33, 0, VAR_TEMP_x4001, DIR_WEST)
    } elif (var(VAR_TEMP_x4000) == 25) {
        movepersonfacing(obj_P01R0301_gsgentleman, 34, 0, VAR_TEMP_x4001, DIR_WEST)
    } else {
        movepersonfacing(obj_P01R0301_gsgentleman, 35, 0, VAR_TEMP_x4001, DIR_WEST)
    }
    applymovement(obj_P01R0301_gsgentleman, SsAqua_1F_Movement_GentlemanWalkLeft)
    applymovement(obj_player, SsAqua_1F_Movement_PlayerFaceRight)
    waitmovement
    applymovement(obj_P01R0301_gsgentleman, SsAqua_1F_Movement_GentlemanFaceLeft)
    waitmovement
    npcmsg("Whoa! Excuse me. I was in a hurry!\r"
           "My granddaughter is missing!\r"
           "She’s just a wee girl. If you see\n"
           "her, please let me know!\r")
    closemessage
    applymovement(obj_P01R0301_gsgentleman, SsAqua_1F_Movement_GentlemanWalkUpLeft)
    waitmovement
    removeobject(obj_P01R0301_gsgentleman)
    setflag(FLAG_UNK_215)
    setvar(VAR_SCENE_SS_AQUA, 2)
    stopse(SEQ_SE_GS_N_UMIBE)
    releaseall
    end
}

movement SsAqua_1F_Movement_PlayerExclamation {
    emote_exclamation_mark
}

movement SsAqua_1F_Movement_GentlemanWalkLeft {
    walk_fast_left * 9
    lock_dir
    jump_near_fast_right
    unlock_dir
    delay_16
}

movement SsAqua_1F_Movement_PlayerFaceRight {
    delay_2 * 5
    face_right * 2
    delay_2 * 5
    jump_in_place_fast_right
    delay_16
}

movement SsAqua_1F_Movement_GentlemanFaceLeft {
    jump_in_place_fast_left * 4
}

movement SsAqua_1F_Movement_GentlemanWalkUpLeft {
    walk_in_place_fast_left * 2
    face_up * 2
    walk_fast_up
    face_left * 2
    walk_fast_left * 10
}

script SsAqua_1F_EventScript_Sailor2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    nopvar490(VAR_SCENE_SS_AQUA)
    if (var(VAR_SCENE_SS_AQUA) >= 7) {
        npcmsg("Here’s your cabin.\r"
               "You can heal your Pokémon\n"
               "by taking a nap in the bed.\r"
               "The ship will arrive while\n"
               "you’re sleeping.")
    } else {
        npcmsg("Here’s your cabin.\r"
               "If your Pokémon are hurt, take a\n"
               "nap in the bed.\f"
               "That will heal them.")
    }
    waitbuttonpress
    closemessage
    releaseall
    end
}

