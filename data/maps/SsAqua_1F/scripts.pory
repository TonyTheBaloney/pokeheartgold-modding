script SsAqua_1F_OnResume {
    if (var(VAR_BOAT_DIRECTION) <= 1) {
        movewarp(0, 27, 20)
        end
    }
    if (var(VAR_BOAT_DIRECTION) >= 2) {
        movewarp(12, 27, 20)
        end
    }
    end
}

