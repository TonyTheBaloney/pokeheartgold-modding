                 "gone. I was really amazed.\r"
                 "...Yes? I’m on the phone.\n"
                 "Go away!")
    end
}

script Pewter_Pokecenter_1F_EventScript_Jigglypuff {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_JIGGLYPUFF, 0)
    npcmsg("JIGGLYPUFF: Puu pupuu.")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Pewter_Pokecenter_1F_EventScript_LittleBoy {
    simplenpcmsg("Most Pokémon get drowsy if they\n"
                 "hear a JIGGLYPUFF singing.\r"
                 "There are several moves that can be\n"
                 "used only while a Pokémon is asleep.")
    end
}

