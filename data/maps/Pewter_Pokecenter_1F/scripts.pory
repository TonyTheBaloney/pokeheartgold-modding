script Pewter_Pokecenter_1F_EventScript_PokefanM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_TRADE_PEWTER_CITY_HAUNTER_XATU)) {
        npcmsg("How do you like the cool XATU\n"
               "I traded you?\r"
               "It’s so cool, because it used to be\n"
               "with cool me!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Aw...\n"
           "If only I had a HAUNTER...\r"
           "If you have a HAUNTER,\n"
           "you will trade it for my XATU,\f"
           "won’t you? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_00BE) }
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    choosepartymonfortrade
    getpartyselection(VAR_SPECIAL_RESULT)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_RESULT) == 255) { goto(_00BE) }
    loadnpctrade(9)
    copyvar(VAR_SPECIAL_x8004, VAR_SPECIAL_RESULT)
    getpartymonspecies(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    npctradegetreqspecies(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_x8005) != VAR_SPECIAL_RESULT) { goto(_00B1) }
    npctradeexec(VAR_SPECIAL_x8004)
    npctradeend
    setflag(FLAG_TRADE_PEWTER_CITY_HAUNTER_XATU)
    npcmsg("How wonderful! You made my day!\r"
           "Thanks to you, I have finally got the\n"
           "Pokémon I’ve been looking for...\f"
           "since forever!")
    waitbuttonpress
    closemessage
    releaseall
    end
_00B1:
    npctradeend
    npcmsg("It has to be a HAUNTER!\r"
           "HAUNTER!!")
    waitbuttonpress
    closemessage
    releaseall
    end
_00BE:
    npcmsg("You’d never turn down a trade\n"
           "if you had a HAUNTER.\r"
           "That means you just don’t have one.\n"
           "That must be it...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Pewter_Pokecenter_1F_EventScript_Woman {
