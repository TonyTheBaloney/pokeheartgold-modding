script PokeathlonDome_Interior_B1FTrustRoom_OnTransition {
    if (flag(FLAG_UNK_0F0)) {
        setvar(VAR_TEMP_x400C, 1)
        end
    }
    setvar(VAR_TEMP_x400C, 0)
    end
}

script PokeathlonDome_Interior_B1FTrustRoom_OnResume {
    if (var(VAR_TEMP_x400C) == 1) {
        movepersonfacing(obj_D49R0105_pcwoman2_2, 2, 1, 3, DIR_EAST)
        setvar(VAR_TEMP_x400C, 0)
    }
    end
}

script PokeathlonDome_Interior_B1FTrustRoom_EventScript_Receptionist1 {
    simplenpcmsg("This is the “Trust” room.\r"
                 "It is to show the mutual reliance\n"
                 "between Pokémon and people.")
    end
}

script PokeathlonDome_Interior_B1FTrustRoom_EventScript_Receptionist2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_0F0)) {
        npcmsg("This is the “Potential” room.\n"
               "Please go ahead.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Only the Pokéathletes who have\n"
           "come first in five courses with\f"
           "one Pokémon are allowed here.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokeathlonDome_Interior_B1FTrustRoom_EventScript_AceTrainerF {
    simplenpcmsg("To win Medals with different kinds of\n"
                 "Pokémon, it is essential to believe in\f"
                 "your Pokémon.")
    end
}

script PokeathlonDome_Interior_B1FTrustRoom_EventScript_AceTrainerM {
    simplenpcmsg("I would love to see my own shoes here!")
    end
}

script PokeathlonDome_Interior_B1FTrustRoom_EventScript_BlackBelt {
    simplenpcmsg("This Dome contains so many\n"
                 "other Domes...")
    end
}

script PokeathlonDome_Interior_B1FTrustRoom_EventScript_Abra {
    playse(SEQ_SE_DP_SELECT)
    lockall
    npcmsg("ABRA: ...\n"
           "...\f"
           "...\r"
           "It must be asleep!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokeathlonDome_Interior_B1FTrustRoom_EventScript_Dratini {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_DRATINI, 0)
    npcmsg("DRATINI: Achoo!")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokeathlonDome_Interior_B1FTrustRoom_EventScript_CheckedTheMedalSign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} checked the Medal!\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    launchpokeathlonrecordsapp(1)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

script PokeathlonDome_Interior_B1FTrustRoom_EventScript_Sign1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_HIDE_POKEATHLON_CLOTHES_SIGN)) {
        npcmsg("It’s your jersey with\n"
               "your autograph!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Those who have participated in the\n"
           "Pokéathlon 50 times are commemorated\f"
           "here for their never-yielding spirits.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokeathlonDome_Interior_B1FTrustRoom_EventScript_Sign2 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_HIDE_POKEATHLON_SHOES_SIGN)) {
        npcmsg("Cool shoes!\n"
               "And they’re your model!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Those who have dashed 5,000 times\n"
           "are commemorated here for their\f"
           "achievement in breaking the\f"
           "legendary record.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokeathlonDome_Interior_B1FTrustRoom_EventScript_Sign3 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_HIDE_POKEATHLON_FLAG_SIGN)) {
        npcmsg("It’s a cool flag!\n"
               "And it’s yours!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Those who have switched 200 times\n"
           "are commemorated here for great\f"
           "teamwork and their bond with\f"
           "their Pokémon.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script PokeathlonDome_Interior_B1FTrustRoom_EventScript_Sign4 {
    simplenpcmsg("Pokéathlon Medals...\r"
                 "Those are the proof of the hard work\n"
                 "of both Pokéathletes and Pokémon.\r"
                 "Those Pokémon that have won all five\n"
                 "Medals are called “Medalist Pokémon”\f"
                 "to commemorate the trust they’ve\f"
                 "earned from their Pokéathlete.")
    end
}

mapscripts PokeathlonDome_Interior_B1FTrustRoom_MapScripts {
    INIT_SCRIPT_ON_RESUME: PokeathlonDome_Interior_B1FTrustRoom_OnResume
    INIT_SCRIPT_ON_TRANSITION: PokeathlonDome_Interior_B1FTrustRoom_OnTransition
