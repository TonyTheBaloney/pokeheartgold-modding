script scr_seq_D49R0105_006 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    playcry(SPECIES_DRATINI, 0)
    npcmsg("DRATINI: Achoo!")
    waitcry
    waitbuttonpress
    closemessage
    releaseall
    end
}

script scr_seq_D49R0105_007 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} checked the Medal!\r")
    closemessage
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    launchpokeathlonrecordsapp(1)
    restoreoverworld
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    releaseall
    end
}

script scr_seq_D49R0105_008 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_HIDE_POKEATHLON_CLOTHES_SIGN)) {
        npcmsg("It’s your jersey with\n"
               "your autograph!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Those who have participated in the\n"
           "Pokéathlon 50 times are commemorated\f"
           "here for their never-yielding spirits.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

