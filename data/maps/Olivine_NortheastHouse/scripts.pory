script Olivine_NortheastHouse_EventScript_LittleGirl {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_UNK_AB9)) {
        npcmsg("I can give you better ones tomorrow!")
    } else {
        npcmsg("My sister gave me a lot of Seals!\f"
               "Here, have some!\r")
        hasitem(ITEM_SEAL_CASE, 1, VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 0) {
            npcmsg("Huh?\n"
                   "You don’t have a Seal Case?\f"
                   "I was gonna give you some Seals...")
        } else {
            giverandomseal(VAR_SPECIAL_x8000, VAR_SPECIAL_x8001, VAR_SPECIAL_x8002)
            if (var(VAR_SPECIAL_x8000) == 0) {
                npcmsg("Wow!\n"
                       "You have so many Seals!\r"
                       "You can cover your Poké Balls in Seals!")
            } else {
                setflag(FLAG_UNK_AB9)
                buffersealname(0, VAR_SPECIAL_x8000)
                npcmsg("There!\n"
                       "I’ll give you this!\r")
                playfanfare(SEQ_ME_ITEM)
                npcmsg(msg_0609_T26R0501_00011)
                waitfanfare
                if (var(VAR_SPECIAL_x8001) == 0) { goto(_00EB) }
                buffersealname(0, VAR_SPECIAL_x8001)
                npcmsg("Have another!\r")
                playfanfare(SEQ_ME_ITEM)
                npcmsg(msg_0609_T26R0501_00011)
                waitfanfare
                if (var(VAR_SPECIAL_x8002) == 0) { goto(_00EB) }
                buffersealname(0, VAR_SPECIAL_x8002)
                npcmsg("Have more!\r")
                playfanfare(SEQ_ME_ITEM)
                npcmsg(msg_0609_T26R0501_00011)
                waitfanfare
                npcmsg("Stick them on your Ball Capsules!")
            }
        }
    }
_00E3:
    waitbuttonpress
    closemessage
    releaseall
    end
_00EB:
    npcmsg("Your Seal Case is full!")
    goto(_00E3)
    end
}

