}

script Violet_PokemonSchool_EventScript_Sign {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("The blackboard explains Pokémon\n"
           "status changes in battle.\r")
    goto(_0207)
    end
_0207:
    npcmsg("Read which topic? {YESNO 0}")
    touchscreenmenuhide
    menuinit(1, 1, 0, 1, VAR_SPECIAL_RESULT)
    menuitemadd(24, 255, 1)
    menuitemadd(25, 255, 2)
    menuitemadd(26, 255, 3)
    menuitemadd(27, 255, 4)
    menuitemadd(28, 255, 5)
    menuitemadd(29, 255, 0)
    menuexec
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) != 1) {
        if (var(VAR_SPECIAL_RESULT) != 2) {
            if (var(VAR_SPECIAL_RESULT) != 3) {
                if (var(VAR_SPECIAL_RESULT) != 4) {
                    if (var(VAR_SPECIAL_RESULT) != 5) {
                        closemessage
                        releaseall
                    _02D8:
                        end
                    }
                    npcmsg("If your Pokémon is frozen,\n"
                           "it can’t do a thing.\r"
                           "It remains frozen after battle.\n"
                           "Thaw it out with an Ice Heal.\r")
                    goto(_0207)
                    goto(_02D8)
                }
                npcmsg("A burn consumes HP, little by little,\n"
                       "and also reduces the Attack stat.\r"
                       "A burn lingers after battle.\n"
                       "Use a Burn Heal as the cure.\r")
                goto(_0207)
                goto(_02D8)
            }
            npcmsg("If asleep, your Pokémon can use only\n"
                   "certain moves, such as Sleep Talk and\f"
                   "Snore.\r"
                   "A sleeping Pokémon doesn’t wake up\n"
                   "after battle.\f"
                   "Wake it up with an Awakening.\r")
            goto(_0207)
            goto(_02D8)
        }
        npcmsg("Paralysis reduces speed and may\n"
               "prevent movement.\r"
               "It remains after battle, so use\n"
               "a Parlyz Heal.\r")
        goto(_0207)
        goto(_02D8)
    }
    npcmsg("If poisoned, a Pokémon steadily\n"
           "loses HP.\r"
           "The poison lingers after the battle,\n"
           "and HP is lost as you walk.\f"
           "To cure it, use an Antidote.\r")
    goto(_0207)
    goto(_02D8)
}

script Violet_PokemonSchool_EventScript_Girl {
    simplenpcmsg("Pokémon have what are called\n"
                 "abilities!\r"
                 "It seems that each kind of Pokémon has\n"
                 "distinct abilities.\r"
                 "They say these abilities come in handy\n"
                 "in battle!")
    end
}

script Violet_PokemonSchool_EventScript_Notebook {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("It’s this kid’s notebook...\r"
           "“Catch Pokémon using Poké Balls.\n"
           "Up to six can be in your party.”\r"
           "Keep reading? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0353) }
    npcmsg("“Before throwing a Poké Ball, weaken\n"
           "the target first.”\r"
           "“A poisoned or burned Pokémon is\n"
           "easier to catch.”\r"
           "Keep reading? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0353) }
    npcmsg("“Some moves may cause confusion.\n"
           "Confusion may make a Pokémon attack\f"
           "itself.”\r"
           "“Leaving battle clears up any\n"
           "confusion.”\r"
           "Keep reading? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0353) }
    npcmsg("“People who catch and use Pokémon\n"
           "in battle are called Pokémon Trainers.”\r"
           "“They are expected to visit Pokémon\n"
           "Gyms and defeat other Trainers.”\r"
           "The next page is... Blank!\r")
    closemessage
    touchscreenmenushow
    applymovement(obj_T22R0301_gsboy1, Violet_PokemonSchool_Movement_SchoolKidMFaceUp)
    waitmovement
    npcmsg("Boy: E-he-he...\n"
           "I haven’t written any more...")
    waitbuttonpress
    closemessage
    releaseall
    end
_0353:
    closemessage
    touchscreenmenushow
    releaseall
    end
}

movement Violet_PokemonSchool_Movement_SchoolKidMFaceUp {
    walk_in_place_up
}

