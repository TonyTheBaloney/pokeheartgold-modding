script Violet_PokemonSchool_EventScript_FatMan {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    getplayerfacing(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 2) {
        applymovement(obj_T22R0301_gsbigman, Violet_PokemonSchool_Movement_FatManSpin1)
    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_T22R0301_gsbigman, Violet_PokemonSchool_Movement_FatManSpin2)
    } elif (var(VAR_SPECIAL_RESULT) == 0) {
        applymovement(obj_T22R0301_gsbigman, Violet_PokemonSchool_Movement_FatManSpin3)
    } else {
        applymovement(obj_T22R0301_gsbigman, Violet_PokemonSchool_Movement_FatManSpin4)
    }
    waitmovement
    npcmsg("Earl, I am!\n"
           "Wonderful are Pokémon, yes!\r"
           "Teach you I will to be a better Trainer!\r"
           "What you want to know?\n"
           "Want to be a winner is you? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Good! Teach you, I will!\n"
               "In battle, Pokémon top on list,\f"
               "the walking one, jump out first!\r"
               "Change order in list, make battle\n"
               "easy, maybe!\r"
               "More from me you want to hear? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 0) { goto(_00D7) }
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0157) }
        end
    _00D7:
        npcmsg("So, want to know how to raise\n"
               "Pokémon well? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 0) {
            npcmsg("Fine! Teach you, I will!\n"
                   "If Pokémon come out in battle even\f"
                   "briefly, some Exp. Points it gets.\r"
                   "Keep out weak Pokémon,\n"
                   "switch in battle quick!\r"
                   "This way, weak Pokémon very\n"
                   "strong become!\f"
                   "More from me you want to hear? {YESNO 0}")
            touchscreenmenuhide
            getmenuchoice(VAR_SPECIAL_RESULT)
            touchscreenmenushow
            if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0125) }
            if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0157) }
            end
        _0125:
            npcmsg("So, want to know how to\n"
                   "battle well? {YESNO 0}")
            touchscreenmenuhide
            getmenuchoice(VAR_SPECIAL_RESULT)
            touchscreenmenushow
            if (var(VAR_SPECIAL_RESULT) == 0) {
                npcmsg("Fine! Teach you, I will!\n"
                       "Pokémon have goods and bads\f"
                       "because many types.\r"
                       "High-level Pokémon not win always\n"
                       "if bad types.\r"
                       "Pokémon with good types\n"
                       "for the foe, you choose.\f"
                       "Smart battle, it is!")
                waitbuttonpress
                closemessage
                releaseall
                end
            _0157:
                npcmsg("Oh! Smart student you are!\n"
                       "Nothing more do I teach!\r"
                       "Good to Pokémon you must be!")
                waitbuttonpress
                closemessage
                releaseall
                end
            }
            if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0157) }
            end
        }
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0125) }
        end
    }
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_00D7) }
    end
}

movement Violet_PokemonSchool_Movement_FatManSpin1 {
    face_down
    face_left
    face_up
    face_right
    face_down
    face_left
    face_up
    face_right
}

