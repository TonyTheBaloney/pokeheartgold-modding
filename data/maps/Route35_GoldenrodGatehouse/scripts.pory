// Script numbers, from 1, in this order (map.json and mapscripts use the labels).
scrdefs {
    Route35_GoldenrodGatehouse_EventScript_Attendant
    Route35_GoldenrodGatehouse_EventScript_PokefanF
}

script Route35_GoldenrodGatehouse_EventScript_PokefanF {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_RADIO_CARD)) {
        npcmsg("I may not look it, but I’m pretty good\n"
               "at mechanics.\r"
               "Do you want to know how to\n"
               "listen to the radio? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Was I being a backseat driver?")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("You open your Pokégear and press the\n"
               "radio button. Then you see the screen\f"
               "for tuning in a signal.\r"
               "The middle of the screen is the\n"
               "radio-reception map.\r"
               "You can move the blinking mark on the\n"
               "map around to tune in to different\f"
               "radio shows.\r"
               "For those who think this is a pain,\n"
               "there are four channels, two on each\f"
               "side, for easy tuning.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("I can’t believe such a tiny change\n"
           "turns the Pokégear into a radio!\r"
           "Oh, your Pokégear doesn’t have\n"
           "that feature yet?\r"
           "It’s a shame!\r"
           "They happen to give quizzes at the\n"
           "Radio Tower reception on the\f"
           "first floor.\r"
           "If you can answer them correctly,\n"
           "they’ll give you the Radio Card!\r"
           "You better try it while they\n"
           "have some left!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Route35_GoldenrodGatehouse_EventScript_Attendant {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_LOAN_SPEAROW) != 1) {
        if (var(VAR_LOAN_SPEAROW) >= 2) {
            if (var(VAR_LOAN_SPEAROW) >= 4) { goto(_016D) }
            npcmsg("Thank you for making the delivery!\r"
                   "...What about a cave exploration?\n"
                   "Ah, you can go right through here.\r"
                   "I want you to have this for\n"
                   "your kindness!\r")
            if (!itemspace(ITEM_HP_UP, 1)) { goto(_0163) }
            callstd(std_give_item_verbose)
            if (var(VAR_LOAN_SPEAROW) == 3) {
                setvar(VAR_LOAN_SPEAROW, 5)
            } else {
                setvar(VAR_LOAN_SPEAROW, 4)
            }
            npcmsg("My pal was snoozing, right?\n"
                   "Heh, he’s always sleeping.")
            waitbuttonpress
            closemessage
            releaseall
            end
        _0163:
            callstd(std_bag_is_full)
            closemessage
            releaseall
            end
        _016D:
            npcmsg("Everything is fine!")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Excuse me, kid!\n"
               "I received this letter the other day\f"
               "from a friend of mine.\r"
               "Here’s the reply that I wrote.\r"
               "I am stuck here and was wondering\n"
               "if you could deliver it...\r"
               "He’s on Route 31.\f"
               "Can you help a guy out? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_00EE) }
        getpartycount(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 6) { goto(_00F9) }
        npcmsg("Wow, thanks!\r")
        giveloanmon(7, 20, 101)
        setvar(VAR_LOAN_SPEAROW, 1)
        bufferplayersname(0)
        npcmsg("{STRVAR_1 3, 0, 0} received the\n"
               "SPEAROW with Mail!")
        playfanfare(SEQ_ME_PT_SPECIAL)
        waitfanfare
    }
    kenyacheckpartyormailbox(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        setvar(VAR_LOAN_SPEAROW, 6)
        npcmsg("What?!\n"
               "You lost the Mail?\f"
               "Oh, well. That’s OK.\f"
               "Don’t worry about it.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_UNK_0B5)) { goto(_00E3) }
    npcmsg("My friend is on Route 31.\r"
           "Oh, yeah.\n"
           "There was a weird tree\f"
           "blocking the road.\f"
           "I wonder if it’s been cleared?")
    waitbuttonpress
    closemessage
    releaseall
    end
_00E3:
    npcmsg("My friend is on Route 31.\r"
           "He looks obviously eager to read\n"
           "letters, so you’ll know who he is\f"
           "right away!")
    waitbuttonpress
    closemessage
    releaseall
    end
_00EE:
    npcmsg("Oh... Never mind, then...\n"
           "You must be busy, too.")
    waitbuttonpress
    closemessage
    releaseall
    end
_00F9:
    npcmsg("Huh?\n"
           "Your party is full!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

