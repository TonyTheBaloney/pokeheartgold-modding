script Mahogany_EventScript_ProfElmCall {
    setvar(VAR_SCENE_ROCKET_TAKEOVER, 2)
    setflag(FLAG_UNK_0C5)
    setflag(FLAG_ROCKET_TAKEOVER_ACTIVE)
    if (var(VAR_UNK_40F8) == 0) {
        setvar(VAR_UNK_40F8, 2)
    }
    phonecall(PHONE_CONTACT_PROF__ELM, 2, 2)
    setvar(VAR_MIDGAME_BADGES, 5)
    end
}

script Mahogany_EventScript_PokefanM {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_ROCKET_TAKEOVER) == 5) {
        if (!flag(FLAG_GOT_RAGECANDYBAR)) {
            npcmsg("What? RageCandyBar?\n"
                   "You want to buy one?\r"
                   "Right on!\r"
                   "Same as before, it can be yours for\n"
                   "just $300! Want one? {YESNO 0}")
            touchscreenmenuhide
            getmenuchoice(VAR_SPECIAL_RESULT)
            touchscreenmenushow
            if (var(VAR_SPECIAL_RESULT) == 0) { goto(_009D) }
            if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0101) }
        }
        npcmsg("What? RageCandyBar?\n"
               "You want to buy another?\r"
               "I think one is enough for you.")
        waitbuttonpress
    _014C:
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_GOT_RAGECANDYBAR)) { goto(_010C) }
    npcmsg(msg_0620_T28_00000)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0101) }
_009D:
    hasenoughmoneyimmediate(VAR_SPECIAL_RESULT, 200)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_00EC) }
    if (!itemspace(ITEM_RAGECANDYBAR, 1)) { goto(_00F7) }
    callstd(std_give_item_verbose)
    submoneyimmediate(200)
    npcmsg("I remember a person from as far as\n"
           "Kanto came to buy one a long time ago.\r"
           "I happened to have none in stock then.\n"
           "That person left rather upset.\r"
           "I felt kind of sorry for that.")
    waitbuttonpress
    setflag(FLAG_GOT_RAGECANDYBAR)
    goto(_014C)
_00EC:
    npcmsg("You don’t have enough money.")
    waitbuttonpress
    goto(_014C)
_00F7:
    callstd(std_bag_is_full)
    goto(_014C)
_0101:
    npcmsg("Oh, fine then...")
    waitbuttonpress
    goto(_014C)
_010C:
    npcmsg("I don’t want to upset you after\n"
           "buying one from me, but...\r"
           "Buying a RageCandyBar has nothing to\n"
           "do with whether I’d allow you to\f"
           "pass through here.\r"
           "...Johto has many places to visit,\n"
           "such as the Lighthouse at Olivine and\f"
           "the Pharmacy at Cianwood.\r"
           "Why don’t you slow down and\n"
           "enjoy sightseeing?")
    waitbuttonpress
    goto(_014C)
}

text msg_0620_T28_00000 {
    "Hiya, kid!\r"
    "I see you’re new in Mahogany Town.\n"
    "Since you’re new, you should try a\f"
    "yummy RageCandyBar!\r"
    "Right now, it can be yours for just\n"
    "$300! Want one? {YESNO 0}"
}

script Mahogany_EventScript_PokefanMTrigger {
    followmonresetmovement
    lockall
    applymovement(obj_T28_gsmiddleman1, Mahogany_Movement_PokefanMExclamation)
    waitmovement
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(56)
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 176) {
        applymovement(obj_T28_gsmiddleman1, Mahogany_Movement_PokefanMWalkRightDown1)
        applymovement(obj_player, Mahogany_Movement_PlayerWalkLeft1)
    } else {
        applymovement(obj_T28_gsmiddleman1, Mahogany_Movement_PokefanMWalkRightDown2)
        applymovement(obj_player, Mahogany_Movement_PlayerWalkLeft2)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    if (flag(FLAG_GOT_RAGECANDYBAR)) {
        npcmsg("I don’t want to upset you after\n"
               "buying one from me, but...\r"
               "Buying a RageCandyBar has nothing to\n"
               "do with whether I’d allow you to\f"
               "pass through here.\r"
               "...Johto has many places to visit,\n"
               "such as the Lighthouse at Olivine and\f"
               "the Pharmacy at Cianwood.\r"
               "Why don’t you slow down and\n"
               "enjoy sightseeing?\r")
        closemessage
        goto(_0228)
    }
    npcmsg(msg_0620_T28_00000)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) != 0) {
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0257) }
    }
    hasenoughmoneyimmediate(VAR_SPECIAL_RESULT, 300)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0262) }
    if (!itemspace(ITEM_RAGECANDYBAR, 1)) { goto(_00F7) }
    callstd(std_give_item_verbose)
    submoneyimmediate(300)
    npcmsg("I remember a person from as far as\n"
           "Kanto came to buy one a long time ago.\r"
           "I happened to have none in stock then.\n"
           "That person left rather upset.\r"
           "I felt kind of sorry for that.\r")
    closemessage
    setflag(FLAG_GOT_RAGECANDYBAR)
_0228:
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 176) {
        applymovement(obj_T28_gsmiddleman1, Mahogany_Movement_PokefanMWalkUp1)
    } else {
        applymovement(obj_T28_gsmiddleman1, Mahogany_Movement_PokefanMWalkUp2)
    }
    waitmovement
    releaseall
    end
_0257:
    npcmsg("Oh, fine then...\r")
    closemessage
    goto(_0228)
_0262:
    npcmsg("You don’t have enough money.\r")
    closemessage
    goto(_0228)
}

movement Mahogany_Movement_PokefanMExclamation {
    face_down
    emote_exclamation_mark
}

movement Mahogany_Movement_PokefanMWalkRightDown1 {
    walk_fast_right
    walk_fast_down
    walk_fast_left
}

movement Mahogany_Movement_PlayerWalkLeft1 {
    delay_4 * 2
    walk_fast_left
    face_right
}

movement Mahogany_Movement_PokefanMWalkRightDown2 {
    walk_fast_right
    walk_fast_down * 2
    walk_fast_left
}

movement Mahogany_Movement_PlayerWalkLeft2 {
    delay_4 * 3
    walk_fast_left
    face_right
}

movement Mahogany_Movement_PokefanMWalkUp1 {
    walk_up
    face_down
}

movement Mahogany_Movement_PokefanMWalkUp2 {
    walk_up * 2
    face_down
}

script Mahogany_EventScript_OldMan {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_RED_SCALE)) {
        npcmsg("MAGIKARP have returned to\n"
               "Lake of Rage.\r"
               "That should be splendid news for the\n"
               "anglers there.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Are you off to see the GYARADOS\n"
           "rampage at the lake?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Mahogany_EventScript_Lass {
    simplenpcmsg("Visit Grandma’s shop. She sells\n"
                 "stuff that nobody else has...\r"
                 "You want to buy stuff, right?\n"
                 "So buy stuff at my grandma’s!")
    end
}

script Mahogany_EventScript_FatMan {
    simplenpcmsg("Have you seen this guy with a\n"
                 "black cape?\r"
                 "He has been going back and forth\n"
                 "between here and the Lake of Rage\f"
                 "saying strange radio waves are\f"
                 "being transmitted.\r"
                 "Who is he, I wonder.\n")
    end
}

