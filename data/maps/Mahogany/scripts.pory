    "$300! Want one? {YESNO 0}"
}

script scr_seq_T28_001 {
    followmonresetmovement
    lockall
    applymovement(obj_T28_gsmiddleman1, Mahogany_Movement_0278)
    waitmovement
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(56)
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 176) {
        applymovement(obj_T28_gsmiddleman1, Mahogany_Movement_0284)
        applymovement(obj_player, Mahogany_Movement_0294)
    } else {
        applymovement(obj_T28_gsmiddleman1, Mahogany_Movement_02A4)
        applymovement(obj_player, Mahogany_Movement_02B4)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    if (flag(FLAG_GOT_RAGECANDYBAR)) {
        npcmsg("I don’t want to upset you after\n"
               "buying one from me, but...\r"
               "Buying a RageCandyBar has nothing to\n"
               "do with whether I’d allow you to\f"
               "pass through here.\r"
               "...Johto has many places to visit,\n"
               "such as the Lighthouse at Olivine and\f"
               "the Pharmacy at Cianwood.\r"
               "Why don’t you slow down and\n"
               "enjoy sightseeing?\r")
        closemessage
        goto(_0228)
    }
    npcmsg(msg_0620_T28_00000)
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) != 0) {
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0257) }
    }
    hasenoughmoneyimmediate(VAR_SPECIAL_RESULT, 300)
    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0262) }
    if (!itemspace(ITEM_RAGECANDYBAR, 1)) { goto(_00F7) }
    callstd(std_give_item_verbose)
    submoneyimmediate(300)
    npcmsg("I remember a person from as far as\n"
           "Kanto came to buy one a long time ago.\r"
           "I happened to have none in stock then.\n"
           "That person left rather upset.\r"
           "I felt kind of sorry for that.\r")
    closemessage
    setflag(FLAG_GOT_RAGECANDYBAR)
_0228:
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 176) {
        applymovement(obj_T28_gsmiddleman1, Mahogany_Movement_02C4)
    } else {
        applymovement(obj_T28_gsmiddleman1, Mahogany_Movement_02D0)
    }
    waitmovement
    releaseall
    end
_0257:
    npcmsg("Oh, fine then...\r")
    closemessage
    goto(_0228)
_0262:
    npcmsg("You don’t have enough money.\r")
    closemessage
    goto(_0228)
}

movement Mahogany_Movement_0278 {
    face_down
    emote_exclamation_mark
}

movement Mahogany_Movement_0284 {
    walk_fast_right
    walk_fast_down
    walk_fast_left
}

movement Mahogany_Movement_0294 {
    delay_4 * 2
    walk_fast_left
    face_right
}

movement Mahogany_Movement_02A4 {
    walk_fast_right
    walk_fast_down * 2
    walk_fast_left
}

movement Mahogany_Movement_02B4 {
    delay_4 * 3
    walk_fast_left
    face_right
}

movement Mahogany_Movement_02C4 {
    walk_up
    face_down
}

movement Mahogany_Movement_02D0 {
    walk_up * 2
    face_down
}

script scr_seq_T28_002 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_RED_SCALE)) {
        npcmsg("MAGIKARP have returned to\n"
               "Lake of Rage.\r"
               "That should be splendid news for the\n"
               "anglers there.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Are you off to see the GYARADOS\n"
           "rampage at the lake?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

