    waitbuttonpress
    goto(_014C)
_010C:
    npcmsg("I don’t want to upset you after\n"
           "buying one from me, but...\r"
           "Buying a RageCandyBar has nothing to\n"
           "do with whether I’d allow you to\f"
           "pass through here.\r"
           "...Johto has many places to visit,\n"
           "such as the Lighthouse at Olivine and\f"
           "the Pharmacy at Cianwood.\r"
           "Why don’t you slow down and\n"
