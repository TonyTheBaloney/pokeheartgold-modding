script scr_seq_T20R0101_012 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_STARTER)) {
        if (flag(FLAG_GOT_TM51_FROM_FALKNER)) {
            npcmsg("There are no valuable Pokémon left...\r"
                   "You wonder who Professor Elm gave the\n"
                   "last Pokémon to?")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        if (flag(FLAG_MET_PASSERBY_BOY)) { goto(_0352) }
        npcmsg("There are two valuable Pokémon left!\n"
               "...But they belong to Professor Elm.")
        waitbuttonpress
        closemessage
        releaseall
        end
    _0352:
        npcmsg("There is one valuable Pokémon left!\n"
               "You didn’t notice before, but it is\f"
               "behind thick glass walls now so\f"
               "nothing bad can happen to it!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    choosestarter
    setflag(FLAG_GOT_STARTER)
    followmonsetpositionnexttoplayer(3, 2)
    togglefollowingpokemonmovement(0)
    followmonspawnreleaseball
    wait(10, VAR_SPECIAL_RESULT)
    togglefollowingpokemonmovement(1)
    getpartymonspecies(0, VAR_TEMP_x4001)
    setstarterchoice(VAR_TEMP_x4001)
    bufferplayersname(0)
    buffermonspeciesname(1, 0)
    npcmsg("{STRVAR_1 3, 0, 0} received {STRVAR_1 0, 1, 0}\n"
           "from Professor Elm!")
    playfanfare(SEQ_ME_POKEGET)
    waitfanfare
    touchscreenmenuhide
    buffermonspeciesname(1, 0)
    npcmsg("Give a nickname to the {STRVAR_1 0, 1, 0}\n"
           "you received? {YESNO 0}")
    getmenuchoice(VAR_SPECIAL_RESULT)
    closemessage
    compare(VAR_SPECIAL_RESULT, 0)
    callifeq(_02EE)
    touchscreenmenushow
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, NewBark_ElmsLab_1F_Movement_0370)
    applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0388)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    npcmsg("Professor Elm: How do you like walking\n"
           "with your Pokémon? It’s not bad, is it?\r"
           "You can take it all the way to\n"
           "Mr. Pokémon’s house.\r"
           "If your Pokémon gets hurt...\r")
    closemessage
    applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0380)
    waitmovement
    npcmsg("You should heal it with this machine.\r"
           "It’s so easy to use.\n"
           "Just check the PC on my desk!\r")
    closemessage
    applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0390)
    waitmovement
    bufferplayersname(0)
    gendermsgbox(msg_0543_T20R0101_00012, msg_0543_T20R0101_00013)
    waitbuttonpress
    closemessage
    setvar(VAR_SCENE_ELMS_LAB, 1)
    setvar(VAR_SCENE_NEW_BARK_TOWN_OW, 1)
    clearflag(FLAG_ELMS_LAB_PREVENT_PLAYER_ESCAPE)
    releaseall
    end
_02EE:
    setvar(VAR_TEMP_x4000, 0)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    nicknameinput(0, VAR_TEMP_x4000)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    touchscreenmenuhide
    bufferpartymonnick(1, 0)
    npcmsg("Is {STRVAR_1 1, 1, 0} the nickname\n"
           "you want to give? {YESNO 0}")
