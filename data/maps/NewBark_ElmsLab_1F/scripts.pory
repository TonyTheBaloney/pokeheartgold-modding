script scr_seq_T20R0101_002 {
    followmonresetmovement
    lockall
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, NewBark_ElmsLab_1F_Movement_0A68)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    applymovement(obj_T20R0101_policeman, NewBark_ElmsLab_1F_Movement_0A7C)
    waitmovement
    npcmsg("Who are you?\n"
           "We are investigating the case of the\f"
           "missing Pokémon here...\r"
           "Rule number one!\n"
           "“Whoever did it will come\f"
           "back to the site.”\r"
           "Oh my... So you must be...\n"
           "the one who did it?\r")
    closemessage
    clearflag(FLAG_HIDE_ELMS_LAB_FRIEND)
    playse(SEQ_SE_DP_KAIDAN2)
    addobject(obj_T20R0101_var_1)
    waitse(SEQ_SE_DP_KAIDAN2)
    callstd(std_play_friend_music)
    applymovement(obj_T20R0101_var_1, NewBark_ElmsLab_1F_Movement_0ADC)
    applymovement(obj_T20R0101_policeman, NewBark_ElmsLab_1F_Movement_0A84)
    waitmovement
    gendermsgbox("Lyra: Hold on a second!\n"
                 "He has nothing to do with it!\r"
                 "I saw it.\n"
                 "There was a red-haired boy\f"
                 "looking into the building!\r", "Ethan: Hold on a second!\n"
                                                 "She has nothing to do with it!\r"
                                                 "I saw it.\n"
                                                 "There was a red-haired boy\f"
                                                 "looking into the building!\r")
    closemessage
    applymovement(obj_T20R0101_policeman, NewBark_ElmsLab_1F_Movement_0A90)
    waitmovement
    npcmsg("What?\n"
           "You battled a boy like that?\r"
           "He must be the one who did it...\n"
           "Did you happen to get his name?\r")
    closemessage
    callstd(std_fade_end_friend_music)
_0904:
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    namerival(VAR_SPECIAL_RESULT)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0904) }
    applymovement(obj_T20R0101_policeman, NewBark_ElmsLab_1F_Movement_0A7C)
    waitmovement
    bufferrivalsname(1)
    npcmsg("I see! So {STRVAR_1 3, 1, 0} was\n"
           "his name. {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("That’s not it?\r"
               "Then can you tell me\n"
               "what the name was?\r")
        closemessage
        goto(_0904)
        end
    }
    closemessage
    npcmsg("Thanks for helping my investigation!\r"
           "My next assignment is to search for\n"
           "this red-haired individual.\r")
    closemessage
    applymovement(obj_T20R0101_var_1, NewBark_ElmsLab_1F_Movement_0AEC)
    applymovement(obj_T20R0101_policeman, NewBark_ElmsLab_1F_Movement_0ABC)
    waitmovement
    playse(SEQ_SE_DP_KAIDAN2)
    removeobject(obj_T20R0101_policeman)
    waitse(SEQ_SE_DP_KAIDAN2)
    applymovement(obj_T20R0101_var_1, NewBark_ElmsLab_1F_Movement_0B08)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("Lyra: {STRVAR_1 3, 0, 0}!\n"
                 "I’m glad they understand you are\f"
                 "innocent.\r"
                 "See you later!\r", "Ethan: {STRVAR_1 3, 0, 0}!\n"
                                     "I’m glad they understand you are\f"
                                     "innocent.\r"
                                     "See you later!\r")
    closemessage
    applymovement(obj_T20R0101_var_1, NewBark_ElmsLab_1F_Movement_0B18)
    waitmovement
    setflag(FLAG_HIDE_NEW_BARK_FRIENDS_ROOM_FRIEND)
    playse(SEQ_SE_DP_KAIDAN2)
    removeobject(obj_T20R0101_var_1)
    waitse(SEQ_SE_DP_KAIDAN2)
    setflag(FLAG_HIDE_ELMS_LAB_OFFICER)
    setflag(FLAG_HIDE_ELMS_LAB_FRIEND)
    setflag(FLAG_GAVE_RIVAL_NAME_TO_OFFICER)
    applymovement(obj_player, NewBark_ElmsLab_1F_Movement_0A74)
    waitmovement
    applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0B2C)
    waitmovement
    bufferplayersname(0)
    gendermsgbox("Professor Elm: {STRVAR_1 3, 0, 0}, this\n"
                 "is terrible...\r"
                 "Oh, yes, what was Mr. Pokémon’s\n"
                 "big discovery?\r", "Professor Elm: {STRVAR_1 3, 0, 0}, this\n"
                                     "is terrible...\r"
                                     "Oh, yes, what was Mr. Pokémon’s\n"
                                     "big discovery?\r")
    closemessage
    npcmsg("{STRVAR_1 3, 0, 0} handed the Mystery Egg\n"
           "to Professor Elm.")
    playfanfare(SEQ_ME_ITEM)
    waitfanfare
    takeitemnocheck(ITEM_MYSTERY_EGG, 1)
    applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0B34)
    waitmovement
    npcmsg("Professor Elm: Huh?\n"
           "This is an...Egg, isn’t it?\r"
           "This Egg may be something I’ve never\n"
           "seen...still it’s just an Egg.\r"
           "Mr. Pokémon is always fascinated\n"
           "by Eggs.\r"
           "Well, since he gave it to us, we might\n"
           "as well find out what secret it holds.\r"
           "I’ll keep it for a while to find out\n"
           "about the Egg.\r")
    closemessage
    applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0B48)
    waitmovement
    gendermsgbox("Professor Elm: What?!\r"
                 "Professor Oak gave you a Pokédex?\r"
                 "{STRVAR_1 3, 0, 0}, is that true? Th-that’s\n"
                 "incredible!\r"
                 "He is superb at seeing the potential\n"
                 "of people as Trainers.\r"
                 "Wow, {STRVAR_1 3, 0, 0}.\n"
                 "I knew you were a little different.\f"
                 "Things are going to be fun!\r"
                 "Your Pokémon seem to really like you,\n"
                 "so why don’t you...take the\f"
                 "Pokémon Gym challenge?\r"
                 "If you manage to defeat all the\n"
                 "Gym Leaders, you’ll eventually\f"
                 "challenge the Pokémon League\f"
                 "Champion!\r"
                 "...Or not! Ha ha!\r"
                 "Becoming the Champion is not at all\n"
                 "easy, but you can certainly\f"
                 "challenge Violet City’s Gym.\r", "Professor Elm: What?!\r"
                                                   "Professor Oak gave you a Pokédex?\r"
                                                   "{STRVAR_1 3, 0, 0}, is that true? Th-that’s\n"
                                                   "incredible!\r"
                                                   "He is superb at seeing the potential\n"
                                                   "of people as Trainers.\r"
                                                   "Wow, {STRVAR_1 3, 0, 0}.\n"
                                                   "I knew you were a little different.\f"
                                                   "Things are going to be fun!\r"
                                                   "Your Pokémon seem to really like you,\n"
                                                   "so why don’t you...take the\f"
                                                   "Pokémon Gym challenge?\r"
                                                   "If you manage to defeat all the\n"
                                                   "Gym Leaders, you’ll eventually\f"
                                                   "challenge the Pokémon League\f"
                                                   "Champion!\r"
                                                   "...Or not! Ha ha!\r"
                                                   "Becoming the Champion is not at all\n"
                                                   "easy, but you can certainly\f"
                                                   "challenge Violet City’s Gym.\r")
    closemessage
    applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0B50)
    waitmovement
    gendermsgbox("...{STRVAR_1 3, 0, 0}. Challenging the\n"
                 "Gyms scattered around will be\f"
                 "a long journey.\r"
                 "Before you leave, make sure\n"
                 "that you talk to your mom.\r", "...{STRVAR_1 3, 0, 0}. Challenging the\n"
                                                 "Gyms scattered around will be\f"
                                                 "a long journey.\r"
                                                 "Before you leave, make sure\n"
                                                 "that you talk to your mom.\r")
    closemessage
    applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0B64)
    waitmovement
    setflag(FLAG_HIDE_ROUTE_30_BATTLERS)
    clearflag(FLAG_HIDE_ROUTE_30_YOUNGSTER_JOEY)
    setvar(VAR_SCENE_ELMS_LAB, 4)
    setvar(VAR_UNK_408B, 1)
    clearflag(FLAG_HIDE_ROUTE_29_FRIEND)
    clearflag(FLAG_HIDE_ROUTE_29_MARILL)
    setvar(VAR_SCENE_MR_POKEMONS_HOUSE, 2)
    setvar(VAR_SCENE_NEW_BARK_TOWN_OW, 3)
    clearflag(FLAG_HIDE_CHERRYGROVE_MART_SPECIAL_CLERK)
    setvar(VAR_SCENE_ROUTE_30_PHONE_CALL, 1)
    releaseall
    end
}

