                                          "Let me thank you once again for\n"
                                          "your support!")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
    }
    getpartycount(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) != 0) {
        getpartyleadalive(VAR_TEMP_x4000)
        getpartymonspecies(VAR_TEMP_x4000, VAR_TEMP_x4001)
