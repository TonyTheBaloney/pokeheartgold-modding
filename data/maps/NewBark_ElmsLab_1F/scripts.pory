script scr_seq_T20R0101_003 {
    followmonresetmovement
    lockall
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4000) == 3) {
        applymovement(obj_T20R0101_assistantm, NewBark_ElmsLab_1F_Movement_081C)
    } elif (var(VAR_TEMP_x4000) == 4) {
        applymovement(obj_T20R0101_assistantm, NewBark_ElmsLab_1F_Movement_082C)
    } elif (var(VAR_TEMP_x4000) == 5) {
        applymovement(obj_T20R0101_assistantm, NewBark_ElmsLab_1F_Movement_083C)
    } elif (var(VAR_TEMP_x4000) == 6) {
        applymovement(obj_T20R0101_assistantm, NewBark_ElmsLab_1F_Movement_084C)
    }
    waitmovement
    bufferplayersname(0)
    gendermsgbox("{STRVAR_1 3, 0, 0}, I want you to have these\n"
                 "to help you with your task.\r", "{STRVAR_1 3, 0, 0}, I want you to have these\n"
                                                  "to help you with your task.\r")
    if (!itemspace(ITEM_POTION, 5)) { goto(_0805) }
    setvar(VAR_SPECIAL_x8004, ITEM_POTION)
    setvar(VAR_SPECIAL_x8005, 5)
    callstd(std_obtain_item_verbose)
    closemessage
    setvar(VAR_SCENE_ELMS_LAB, 2)
    npcmsg("Pokémon are weak in the beginning.\r"
           "Don’t hesitate to use a Potion if you\n"
           "think yours is in danger.\r")
    closemessage
    if (var(VAR_TEMP_x4000) == 3) {
        applymovement(obj_T20R0101_assistantm, NewBark_ElmsLab_1F_Movement_0864)
    } elif (var(VAR_TEMP_x4000) == 4) {
        applymovement(obj_T20R0101_assistantm, NewBark_ElmsLab_1F_Movement_0870)
    } elif (var(VAR_TEMP_x4000) == 5) {
        applymovement(obj_T20R0101_assistantm, NewBark_ElmsLab_1F_Movement_087C)
    } elif (var(VAR_TEMP_x4000) == 6) {
        applymovement(obj_T20R0101_assistantm, NewBark_ElmsLab_1F_Movement_0888)
    }
    waitmovement
    releaseall
    end
}

script scr_seq_T20R0101_001 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_40FC) == 3) {
        npcmsg("The one who took it...\n"
               "I mean the red-haired boy\f"
               "came up with the Pokémon.\r"
               "But I saw his face as he passed\n"
               "me here. He looked so happy!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_SCENE_ELMS_LAB) == 0) {
        npcmsg("Huh? Me?\n"
               "I’m not the professor.\r"
               "He’s at the back of the room.\n")
    } elif (var(VAR_SCENE_ELMS_LAB) == 2) {
        npcmsg("Pokémon are weak in the beginning.\r"
               "Don’t hesitate to use a Potion if you\n"
               "think yours is in danger.")
    } elif (var(VAR_SCENE_ELMS_LAB) == 4) {
        npcmsg("There was a loud noise outside...\n"
               "When we went to look, someone\f"
               "stole a Pokémon.\r"
               "Sigh... \n"
               "That stolen Pokémon.\r"
               "I wonder how it’s doing.\n"
               "They say a Pokémon raised by a bad\f"
               "person turns bad itself.")
        setvar(VAR_SCENE_ELMS_LAB, 5)
    } elif (var(VAR_SCENE_ELMS_LAB) == 6) {
        npcmsg(msg_0543_T20R0101_00055)
    } else {
        npcmsg(msg_0543_T20R0101_00055)
    }
    waitbuttonpress
    closemessage
    releaseall
    end
_0805:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

