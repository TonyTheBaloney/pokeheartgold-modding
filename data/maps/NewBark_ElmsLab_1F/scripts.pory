script scr_seq_T20R0101_013 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (!flag(FLAG_GOT_STARTER)) {
        npcmsg("This PC is connected to the\n"
               "healing machine!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Would you like to heal\n"
           "your Pokémon? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    closemessage
    if (var(VAR_SPECIAL_RESULT) != 1) {
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        playfanfare(SEQ_ME_ASA)
        healparty
        leaveoverworld
        restoreoverworld
        waitfanfare
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
    }
    releaseall
    end
}

script scr_seq_T20R0101_015 {
    followmonresetmovement
    lockall
    applymovement(obj_T20R0101_assistantm, NewBark_ElmsLab_1F_Movement_113C)
    waitmovement
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0}!\n"
           "Guess what!\r"
           "The person who took the Professor’s\n"
           "Pokémon has...come back to return it!\r"
           "That’s the last thing I expected!\n"
           "Guess what Professor Elm said to him.\r"
           "...\n"
           "“It seems that your Pokémon already\f"
           "likes you so much.\r"
           "For a Pokémon, the best happiness is\n"
           "to be with someone it loves.\f"
           "I think it should stay with you.”\r"
           "...\n"
           "Isn’t it moving? It made me cry!\r")
    closemessage
    applymovement(obj_T20R0101_assistantm, NewBark_ElmsLab_1F_Movement_1148)
    waitmovement
    setvar(VAR_UNK_40FC, 3)
    releaseall
    end
}

