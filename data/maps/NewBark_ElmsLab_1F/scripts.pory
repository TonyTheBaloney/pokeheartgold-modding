script(local) _0FE4 {
    mongetfriendship(VAR_SPECIAL_RESULT, VAR_TEMP_x4000)
    if (var(VAR_SPECIAL_RESULT) >= 220) {
        call(_0DE3)
        gendermsgbox("Oh, wow, your Spiky-eared PICHU seems\n"
                     "to like you a lot already, {STRVAR_1 3, 0, 0}.\r", "Oh, wow, your Spiky-eared PICHU seems\n"
                                                                         "to like you a lot already, {STRVAR_1 3, 0, 0}.\r")
        closemessage
        applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0F60)
        waitmovement
        npcmsg("Something’s funny...\n"
               "I would expect it to evolve into\f"
               "PIKACHU since it likes its Trainer\f"
               "this much...\r")
        closemessage
        applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0F50)
        waitmovement
        npcmsg("Let me see...\r"
               "Hmm...\r"
               "Could it be...\r"
               "Just as I thought!\r")
        closemessage
        applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0FBC)
        waitmovement
        npcmsg("It seems that this PICHU will never\n"
               "evolve. It’s so strange!\r"
               "Its structure and the traveling\n"
               "through time must have affected\f"
               "its DNA.\r"
               "I’ve never heard of a Pokémon that\n"
               "doesn’t evolve when it’s\f"
               "supposed to...!")
        waitbuttonpress
        closemessage
        setvar(VAR_UNK_412F, 2)
        releaseall
        end
    _1044:
        npcmsg("Professor Elm: Your Spiky-eared PICHU\n"
               "looks just fine!\r"
               "I’ve never heard of a Pokémon that\n"
               "doesn’t evolve when it’s\f"
               "supposed to.\f"
               "Please take good care of it.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    goto(_03F5)
    end
}

