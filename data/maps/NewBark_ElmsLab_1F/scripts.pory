script(local) _0CDC {
    if (var(VAR_TEMP_x4006) == 1) {
        npcmsg("Professor Elm: This PICHU doesn’t\n"
               "seem like a regular PICHU.\f"
               "I’ll find out more about it.")
        waitbuttonpress
        closemessage
        addvar(VAR_TEMP_x4006, 1)
        releaseall
        end
    _0DE3:
        bufferplayersname(0)
        gendermsgbox("Professor Elm: Hi, {STRVAR_1 3, 0, 0}!\r", "Professor Elm: Hi, {STRVAR_1 3, 0, 0}!\r")
        closemessage
        getplayerfacing(VAR_TEMP_x4005)
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(55)
        getpersoncoords(0, VAR_SPECIAL_x8006, VAR_SPECIAL_x8007)
        if (var(VAR_TEMP_x4005) == 0) {
            applymovement(obj_player, NewBark_ElmsLab_1F_Movement_0EB8)
            waitmovement
            applymovement(obj_partner_poke, NewBark_ElmsLab_1F_Movement_0F0C)
        } elif (var(VAR_TEMP_x4005) == 3) {
            applymovement(obj_player, NewBark_ElmsLab_1F_Movement_0EC4)
            waitmovement
            applymovement(obj_partner_poke, NewBark_ElmsLab_1F_Movement_0F1C)
        } elif (var(VAR_TEMP_x4005) == 2) {
            applymovement(obj_player, NewBark_ElmsLab_1F_Movement_0ED4)
            waitmovement
            applymovement(obj_partner_poke, NewBark_ElmsLab_1F_Movement_0F30)
        } elif (var(VAR_SPECIAL_x8006) == 4) {
            applymovement(obj_player, NewBark_ElmsLab_1F_Movement_0EF8)
            waitmovement
            applymovement(obj_partner_poke, NewBark_ElmsLab_1F_Movement_0F30)
        } else {
            applymovement(obj_player, NewBark_ElmsLab_1F_Movement_0EE4)
            waitmovement
            applymovement(obj_partner_poke, NewBark_ElmsLab_1F_Movement_0F1C)
        }
        waitmovement
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
        return
    }
    if (var(VAR_UNK_412F) >= 2) { goto(_1044) }
    if (var(VAR_UNK_412F) == 1) { goto(_0FE4) }
    call(_0DE3)
    applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0F48)
    waitmovement
    npcmsg("Professor Elm: That is quite a\n"
           "rare PICHU!\f"
           "Can I take a look at it closely?\r")
    closemessage
    applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0F50)
    waitmovement
    applymovement(obj_partner_poke, NewBark_ElmsLab_1F_Movement_0F38)
    waitmovement
    npcmsg("Hmm...\n"
           "One of the ears is spiky...\f"
           "That’s strange.\f"
           "There seems to be something more to it.\r"
           "It really is a rare sight.\r")
    closemessage
    applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0F48)
    waitmovement
    npcmsg("You met it at the Ilex Forest?\r"
           "A mysterious Pokémon called CELEBI\n"
           "has been sighted there, or so I heard.\r")
    closemessage
    applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0F60)
    waitmovement
    npcmsg("Speaking of that...\r")
    closemessage
    applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0FBC)
    waitmovement
    npcmsg("Professor Oak once wrote about\n"
           "CELEBI and {COLOR 1}Time Travel{COLOR 0} in a research\f"
           "paper he presented at a conference!\r")
    closemessage
    getpersoncoords(0, VAR_SPECIAL_x8006, VAR_SPECIAL_x8007)
    if (var(VAR_SPECIAL_x8006) == 4) {
        applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0F98)
    } else {
        applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0F6C)
    }
    waitmovement
    npcmsg("Professor Elm: CELEBI can use its\n"
           "mystic power called {COLOR 1}Time Travel{COLOR 0}...to\f"
           "travel to the past and future.\r")
    closemessage
    if (var(VAR_SPECIAL_x8006) == 4) {
        applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0FDC)
        waitmovement
    } else {
        applymovement(obj_T20R0101_doctor, NewBark_ElmsLab_1F_Movement_0FCC)
        waitmovement
    }
    bufferplayersname(0)
    gendermsgbox("If this PICHU has traveled through\n"
                 "time, perhaps you should take\f"
                 "extra care of it, {STRVAR_1 3, 0, 0}.\r"
                 "It seems that this PICHU has been\n"
                 "affected by traveling so far through\f"
                 "time with CELEBI.\r"
                 "I’ll inform the Pokémon Center of it.\r"
                 "The lady at the reception should be\n"
                 "able to tell you if anything may affect\f"
                 "that PICHU.", "If this PICHU has traveled through\n"
                                "time, perhaps you should take\f"
                                "extra care of it, {STRVAR_1 3, 0, 0}.\r"
                                "It seems that this PICHU has been\n"
                                "affected by traveling so far through\f"
                                "time with CELEBI.\r"
                                "I’ll inform the Pokémon Center of it.\r"
                                "The lady at the reception should be\n"
                                "able to tell you if anything may affect\f"
                                "that PICHU.")
    waitbuttonpress
    closemessage
    setvar(VAR_UNK_412F, 1)
    addvar(VAR_TEMP_x4006, 1)
    releaseall
    end
}

