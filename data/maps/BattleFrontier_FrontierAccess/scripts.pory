script BattleFrontier_FrontierAccess_OnTransition {
    if (!flag(FLAG_UNK_189)) {
        getweekday(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 2) { goto(_0078) }
        if (var(VAR_TEMP_x4000) == 6) { goto(_0078) }
        setflag(FLAG_HIDE_CAMERON)
        end
    _0078:
        clearflag(FLAG_HIDE_CAMERON)
        end
    }
    clearflag(FLAG_UNK_189)
    end
}

script BattleFrontier_FrontierAccess_EventScript_PokefanM1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_40E5) == 2) {
        npcmsg("Click, click, click...\n"
               "Oh! It is you!\r"
               "I’ve gotten over being first all\n"
               "the time.\r"
               "Now I’m counting the number of people\n"
               "coming to the Battle Frontier.\f"
               "Of course no one asked me to.\f"
               "It’s just a hobby.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Stupid, stupid me...\n"
           "Sob...sob...")
    waitbuttonpress
    closemessage
    releaseall
    end
}

