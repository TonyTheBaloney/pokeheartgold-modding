        applymovement(obj_D32R0102_gsmiddleman1, BattleFrontier_FrontierAccess_Movement_PokefanMWalkRightUp1)
        applymovement(obj_player, BattleFrontier_FrontierAccess_Movement_PlayerFaceRight)
    } elif (var(VAR_SPECIAL_x8004) == 15) {
        applymovement(obj_D32R0102_gsmiddleman1, BattleFrontier_FrontierAccess_Movement_PokefanMWalkUp2)
        applymovement(obj_player, BattleFrontier_FrontierAccess_Movement_PlayerFaceLeft)
    } elif (var(VAR_SPECIAL_x8004) == 16) {
        applymovement(obj_D32R0102_gsmiddleman1, BattleFrontier_FrontierAccess_Movement_PokefanMWalkRightUp2)
        applymovement(obj_player, BattleFrontier_FrontierAccess_Movement_PlayerFaceLeft)
    } else {
        applymovement(obj_D32R0102_gsmiddleman1, BattleFrontier_FrontierAccess_Movement_PokefanMWalkRightUp3)
        applymovement(obj_player, BattleFrontier_FrontierAccess_Movement_PlayerFaceLeft)
