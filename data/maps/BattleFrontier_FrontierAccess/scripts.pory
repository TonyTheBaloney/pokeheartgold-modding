    face_down
}

movement BattleFrontier_FrontierAccess_Movement_0444 {
    face_up
}

script scr_seq_D32R0102_006 {
    simplenpcmsg("Finally!\n"
                 "I’m here at the Battle Frontier!\r"
                 "When a Pokémon battle on the road\n"
                 "doesn’t satisfy you any longer, you\f"
                 "have to come to the Battle Frontier!\r"
                 "Wouldn’t you agree?")
    end
}

script scr_seq_D32R0102_007 {
    simplenpcmsg("Normally, choosing which Pokémon is all\n"
                 "there is to a Pokémon battle.\r"
                 "But when you change certain rules or\n"
                 "limitations, the battle suddenly\f"
                 "becomes even more fun.\r"
                 "And this place you can have such fun...\n"
                 "is called the Battle Frontier!")
    end
}

