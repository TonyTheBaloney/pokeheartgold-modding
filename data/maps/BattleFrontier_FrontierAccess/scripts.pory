script scr_seq_D32R0102_005 {
    if (!flag(FLAG_UNK_150)) {
        playse(SEQ_SE_DP_SELECT)
        lockall
        npcmsg("I can’t stop shivering!\r"
               "I told my family that I would conquer\n"
               "the Battle Frontier when I left home...\r"
               "But now I’m here, and somehow I\n"
               "can’t stop shivering!\r"
               "What am I gonna do if I get beaten\n"
               "to a pulp?\r")
        applymovement(obj_D32R0102_gsman1, BattleFrontier_FrontierAccess_Movement_043C)
        waitmovement
        npcmsg("...You look quite young.\r"
               "...\n"
               "...\r"
               "I will pull myself together and\n"
               "challenge the Battle Frontier...\f"
               "Maybe!\r")
        closemessage
        setflag(FLAG_UNK_150)
    } else {
        playse(SEQ_SE_DP_SELECT)
        lockall
        faceplayer
        npcmsg("I will pull myself together and\n"
               "challenge the Battle Frontier!\r"
               "...\n"
               "Or I might not!\r")
        closemessage
    }
    applymovement(obj_D32R0102_gsman1, BattleFrontier_FrontierAccess_Movement_0444)
    waitmovement
    releaseall
    end
}

