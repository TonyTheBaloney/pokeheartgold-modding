script BattleFrontier_FrontierAccess_EventScript_Man {
    if (!flag(FLAG_UNK_150)) {
        playse(SEQ_SE_DP_SELECT)
        lockall
        npcmsg("I can’t stop shivering!\r"
               "I told my family that I would conquer\n"
               "the Battle Frontier when I left home...\r"
               "But now I’m here, and somehow I\n"
               "can’t stop shivering!\r"
               "What am I gonna do if I get beaten\n"
               "to a pulp?\r")
        applymovement(obj_D32R0102_gsman1, BattleFrontier_FrontierAccess_Movement_ManFaceDown)
        waitmovement
        npcmsg("...You look quite young.\r"
               "...\n"
               "...\r"
               "I will pull myself together and\n"
               "challenge the Battle Frontier...\f"
               "Maybe!\r")
        closemessage
        setflag(FLAG_UNK_150)
    } else {
        playse(SEQ_SE_DP_SELECT)
        lockall
        faceplayer
        npcmsg("I will pull myself together and\n"
               "challenge the Battle Frontier!\r"
               "...\n"
               "Or I might not!\r")
        closemessage
    }
    applymovement(obj_D32R0102_gsman1, BattleFrontier_FrontierAccess_Movement_ManFaceUp)
    waitmovement
    releaseall
    end
}

movement BattleFrontier_FrontierAccess_Movement_ManFaceDown {
    face_down
}

movement BattleFrontier_FrontierAccess_Movement_ManFaceUp {
    face_up
}

script BattleFrontier_FrontierAccess_EventScript_Hiker {
    simplenpcmsg("Finally!\n"
                 "I’m here at the Battle Frontier!\r"
                 "When a Pokémon battle on the road\n"
                 "doesn’t satisfy you any longer, you\f"
                 "have to come to the Battle Frontier!\r"
                 "Wouldn’t you agree?")
    end
}

script BattleFrontier_FrontierAccess_EventScript_Girl {
    simplenpcmsg("Normally, choosing which Pokémon is all\n"
                 "there is to a Pokémon battle.\r"
                 "But when you change certain rules or\n"
                 "limitations, the battle suddenly\f"
                 "becomes even more fun.\r"
                 "And this place you can have such fun...\n"
                 "is called the Battle Frontier!")
    end
}

script BattleFrontier_FrontierAccess_EventScript_TrainerTips {
    trainertipsex(2, "This Is the Battle Frontier\r"
                     "Come, Proud Trainers\n"
                     "Aim for the Top!")
    end
}

