}

script CliffEdgeGate_EventScript_ChuckScene {
    followmonresetmovement
    lockall
    if (var(VAR_TEMP_x4001) == 2) {
        applymovement(obj_D48R0101_gsleader5, CliffEdgeGate_Movement_ChuckWalkRightDown)
    } else {
        applymovement(obj_D48R0101_gsleader5, CliffEdgeGate_Movement_ChuckWalkDownLeft)
    }
    waitmovement
    bufferplayersname(0)
    npcmsg("Chuck: Hey, {STRVAR_1 3, 0, 0}!\n"
           "Good to see you again! But I never\f"
           "expected to see you around here.\r"
           "Could it be...that you are on the way\n"
           "to the Embedded Tower?\r"
           "The Embedded Tower is a huge tower\n"
           "piercing the sky.\r"
           "It is said to have something to do with\n"
           "the mythical Pokémon that stretched\f"
           "the seas and that Pokémon that widened\f"
           "the lands.\r"
           "But the tower no longer is standing.\r")
    closemessage
    if (var(VAR_TEMP_x4001) == 2) {
        applymovement(obj_D48R0101_gsleader5, CliffEdgeGate_Movement_ChuckExclamation1)
    } else {
        applymovement(obj_D48R0101_gsleader5, CliffEdgeGate_Movement_ChuckExclamation2)
    }
    waitmovement
    npcmsg("Chuck: The way to the Embedded Tower\n"
           "is harder than you can imagine.\r"
           "You need to use Rock Climb\n"
           "as well as Surf.\r")
    closemessage
    if (var(VAR_TEMP_x4001) == 2) {
        applymovement(obj_D48R0101_gsleader5, CliffEdgeGate_Movement_ChuckFaceRight)
    } else {
        applymovement(obj_D48R0101_gsleader5, CliffEdgeGate_Movement_ChuckFaceDown)
    }
    waitmovement
    npcmsg("Chuck: I see! So you’ve defeated all\n"
           "the Gym Leaders in Kanto as well!\r"
           "Then there’s nothing to worry about.\n"
           "Believe in yourself and walk your path.\r"
           "Yahaha!\r")
    closemessage
    if (var(VAR_TEMP_x4001) == 2) {
        applymovement(obj_player, CliffEdgeGate_Movement_PlayerWalkUp)
        applymovement(obj_D48R0101_gsleader5, CliffEdgeGate_Movement_ChuckWalkRight)
    } else {
        applymovement(obj_D48R0101_gsleader5, CliffEdgeGate_Movement_ChuckWalkUpRight)
    }
    waitmovement
    playse(SEQ_SE_DP_KAIDAN2)
    setflag(FLAG_HIDE_CLIFFS_EDGE_GATE_CHUCK)
    removeobject(obj_D48R0101_gsleader5)
    setvar(VAR_SCENE_EMBEDDED_TOWER, 3)
    releaseall
    end
}

movement CliffEdgeGate_Movement_ChuckWalkRightDown {
    walk_in_place_right
    delay_8
    walk_right * 2
    walk_down
    walk_right
}

movement CliffEdgeGate_Movement_ChuckWalkDownLeft {
    walk_in_place_down
    delay_8
    walk_down * 3
    walk_left
    walk_down
}

movement CliffEdgeGate_Movement_ChuckExclamation1 {
    emote_exclamation_mark
    delay_8
}

movement CliffEdgeGate_Movement_ChuckExclamation2 {
    emote_exclamation_mark
    delay_8
}

movement CliffEdgeGate_Movement_ChuckFaceRight {
    walk_in_place_right
}

movement CliffEdgeGate_Movement_ChuckFaceDown {
    walk_in_place_down
}

movement CliffEdgeGate_Movement_ChuckWalkRight {
    delay_8
    walk_right * 2
}

movement CliffEdgeGate_Movement_ChuckWalkUpRight {
    delay_8
    walk_up * 4
    walk_right * 2
    walk_up * 9
}

movement CliffEdgeGate_Movement_PlayerWalkUp {
    lock_dir
    walk_up
    unlock_dir
    walk_in_place_down
}

script CliffEdgeGate_EventScript_PokefanF {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_40EB) == 1) {
        npcmsg("See? The Safari Zone was fun?\n"
               "No need to say anything!\f"
               "Your face says it was really fun!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (flag(FLAG_UNK_0F5)) { goto(_01E7) }
    npcmsg("Did you know?\n"
           "They are constructing a Safari Zone\f"
           "just around the corner.\r"
           "They say it’ll be really fun!\n"
           "You will see many different kinds of\f"
           "Pokémon, and it’s all you can catch!\r"
           "There is no reason not to go, right?\n"
           "I’m so looking forward to the\f"
           "Safari Zone!\r"
           "Finish the construction already!")
    waitbuttonpress
    closemessage
    releaseall
    end
_01E7:
