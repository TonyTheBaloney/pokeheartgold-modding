script scr_seq_D37R0102_006 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("Welcome to the Memorial Photo Studio.\n"
           "We are no ordinary studio!\r"
           "You can wear a Team Rocket uniform\n"
           "to take a picture!\r"
           "Would you like to try it? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 0) {
        photoalbumisfull(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Hmm. Your Photo Album is full.\r"
                   "Access your PC and delete\n"
                   "some pictures.")
            waitbuttonpress
            closemessage
            releaseall
            end
        }
        npcmsg("Please stand in front of the camera\n"
               "once you have changed.\r")
        closemessage
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        setavatarbits(PLAYER_TRANSITION_ROCKET)
        updateavatarstate
        rocketcostumeflagaction(1)
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(55)
        applymovement(obj_player, Goldenrod_Tunnel_B1F_Movement_0FE8)
        applymovement(obj_D37R0102_gsmiddleman1, Goldenrod_Tunnel_B1F_Movement_1000)
        waitmovement
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
        followmonisactive(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            release(obj_partner_poke)
            applymovement(obj_partner_poke, Goldenrod_Tunnel_B1F_Movement_0FF8)
            lock(obj_partner_poke)
            waitmovement
        }
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        npcmsg("Are you ready?\r"
               "Come on!\n"
               "Look cool as if you own the world!\r")
        closemessage
        fadescreen(6, 1, 0, RGB_BLACK)
        waitfade
        cameronphoto(10)
        lockall
        setavatarbits(PLAYER_TRANSITION_WALKING)
        updateavatarstate
        rocketcostumeflagaction(0)
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(55)
        applymovement(obj_player, Goldenrod_Tunnel_B1F_Movement_1010)
        waitmovement
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
        fadescreen(6, 1, 1, RGB_BLACK)
        waitfade
        npcmsg("Good job.\r"
               "You can check the picture using the PC.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("...Fair enough.\r"
           "No one should look up to Team Rocket.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

