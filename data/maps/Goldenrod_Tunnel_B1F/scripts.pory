script scr_seq_D37R0102_011 {
    followmonresetmovement
    lockall
    callstd(std_play_kimono_girl_music)
    getplayercoords(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_x8005) == 31) {
        applymovement(obj_D37R0102_dancer, Goldenrod_Tunnel_B1F_Movement_10B4)
    } else {
        applymovement(obj_D37R0102_dancer, Goldenrod_Tunnel_B1F_Movement_10C8)
    }
    waitmovement
    npcmsg("Team Rocket members in black suits\n"
           "have been running around...\r"
           "I was wondering what was going on.\n"
           "So, you took on Team Rocket?\f"
           "You are impressive!\r"
           "You may be able to face the\n"
           "legendary Poké...\r")
    closemessage
    applymovement(obj_D37R0102_dancer, Goldenrod_Tunnel_B1F_Movement_10E4)
    waitmovement
    npcmsg("Hahaha! Never mind.\r"
           "I must go now.\r")
    closemessage
    getplayercoords(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    if (var(VAR_SPECIAL_x8005) == 31) {
        applymovement(obj_D37R0102_dancer, Goldenrod_Tunnel_B1F_Movement_10F0)
    } else {
        applymovement(obj_D37R0102_dancer, Goldenrod_Tunnel_B1F_Movement_1120)
    }
    waitmovement
    removeobject(obj_D37R0102_dancer)
    setflag(FLAG_HIDE_UNDERGROUND_KIMONO_GIRL)
    callstd(std_fade_end_kimono_girl_music)
    releaseall
    setvar(VAR_UNK_40E7, 3)
    end
}

