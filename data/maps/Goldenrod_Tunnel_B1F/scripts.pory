script scr_seq_D37R0102_023 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkgiftaccessoriesfull(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        checkhasallbackdrops(VAR_SPECIAL_RESULT)
        if (var(VAR_SPECIAL_RESULT) == 1) {
            npcmsg("Wow, you are great!\n"
                   "So many Accessories and wallpapers!\r"
                   "Go ahead and dress up your Pokémon!")
            waitbuttonpress
            closemessage
            goto(_1568)
            end
        _1530:
            npcmsg("Please come again!")
            waitbuttonpress
            closemessage
            goto(_1568)
            end
        }
    }
    npcmsg("Take a look!\r"
           "This is a drawing for Accessories.\n"
           "You never know what you’re gonna get.\r"
           "Would you like to try for $100? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_RESULT)
    touchscreenmenushow
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_1530) }
    hasenoughmoneyimmediate(VAR_SPECIAL_RESULT, 100)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg("Oh, no!\n"
               "You’re short on funds.")
        waitbuttonpress
        closemessage
        goto(_1568)
        end
    }
    submoneyimmediate(100)
    randomchance(5, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg(msg_0117_D37R0102_00064)
        closemessage
        goto(_1530)
        end
    }
    getrandomgiftaccessory(VAR_SPECIAL_x8004)
    cangiveaccessory(VAR_SPECIAL_x8004, 1, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        npcmsg(msg_0117_D37R0102_00064)
        closemessage
        goto(_14EB)
        end
    _1568:
        releaseall
        end
    }
    npcmsg("Here we go!\r"
           "..................\n"
           "..................\f"
           "......\f"
           "You win!\r")
    setvar(VAR_SPECIAL_x8005, 1)
    callstd(std_receive_accessory)
_14EB:
    checkhasallbackdrops(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_1530) }
    randomchance(95, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) { goto(_1530) }
    getrandommissingbackdrop(VAR_SPECIAL_x8004)
    npcmsg("How about a wallpaper?\r")
    callstd(std_receive_background)
    goto(_1530)
    end
}

