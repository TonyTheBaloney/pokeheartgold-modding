script scr_seq_D37R0102_004 {
    followmonresetmovement
    lockall
    applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0AC4)
    waitmovement
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) == 7) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0ACC)
    } elif (var(VAR_TEMP_x4001) == 8) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0AD4)
    } elif (var(VAR_TEMP_x4001) == 9) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0ADC)
    } elif (var(VAR_TEMP_x4001) == 10) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0AE4)
    } elif (var(VAR_TEMP_x4001) == 11) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0AEC)
    } elif (var(VAR_TEMP_x4001) == 12) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0AF4)
    } elif (var(VAR_TEMP_x4001) == 13) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0AFC)
    }
    waitmovement
    npcmsg("Huh?\n"
           "Are you a newcomer, too?\r"
           "We had to recruit new members for the\n"
           "Radio Tower mission.\f"
           "Then we ran out of uniforms.\r"
           "I heard this studio has some, so I\n"
           "decided to “borrow” one.\r"
           "Since you are here, why don’t you\n"
           "change as well?\r")
    closemessage
    getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    if (var(VAR_TEMP_x4001) == 7) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0B04)
        applymovement(obj_player, Goldenrod_Tunnel_B1F_Movement_0B70)
    } elif (var(VAR_TEMP_x4001) == 8) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0B10)
        applymovement(obj_player, Goldenrod_Tunnel_B1F_Movement_0B7C)
    } elif (var(VAR_TEMP_x4001) == 9) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0B20)
        applymovement(obj_player, Goldenrod_Tunnel_B1F_Movement_0B88)
    } elif (var(VAR_TEMP_x4001) == 10) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0B30)
        applymovement(obj_player, Goldenrod_Tunnel_B1F_Movement_0B94)
    } elif (var(VAR_TEMP_x4001) == 11) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0B40)
        applymovement(obj_player, Goldenrod_Tunnel_B1F_Movement_0BA0)
    } elif (var(VAR_TEMP_x4001) == 12) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0B50)
        applymovement(obj_player, Goldenrod_Tunnel_B1F_Movement_0BAC)
    } elif (var(VAR_TEMP_x4001) == 13) {
        applymovement(obj_D37R0102_rocketm, Goldenrod_Tunnel_B1F_Movement_0B60)
        applymovement(obj_player, Goldenrod_Tunnel_B1F_Movement_0BB8)
    }
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    fadescreen(6, 1, 0, RGB_BLACK)
    waitfade
    setavatarbits(PLAYER_TRANSITION_ROCKET)
    updateavatarstate
    rocketcostumeflagaction(1)
    playse(SEQ_SE_DP_CARD2)
    wait(24, VAR_SPECIAL_RESULT)
    playse(SEQ_SE_DP_CARD2)
    waitse(SEQ_SE_DP_CARD2)
    fadescreen(6, 1, 1, RGB_BLACK)
    waitfade
    setvar(VAR_SCENE_ROCKET_TAKEOVER, 3)
    npcmsg(msg_0117_D37R0102_00037)
    waitbuttonpress
    closemessage
    releaseall
    end
}

