script scr_seq_D37R0102_005 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    setvar(VAR_SPECIAL_x8007, 0)
    callifunset(FLAG_UNK_08C, _0C0E)
    if (var(VAR_TEMP_x400A) == 0) {
        npcmsg("Ooh, your Pokémon are so very\n"
               "charming! How enchanting!\r"
               "If you dress up your Pokémon here,\n"
               "make it a sight to behold!\r"
               "Then I will even hang a picture of one\n"
               "in the other room!\r"
               "You will do this, won’t you? {YESNO 0}")
        goto(_0C58)
    }
    if (var(VAR_TEMP_x400A) >= 1) {
        npcmsg("If you dress up any Pokémon again,\n"
               "the photo here will be changed.\r"
               "Would you like to dress up\n"
               "a Pokémon, dearie? {YESNO 0}")
        goto(_0C58)
    _0C28:
        npcmsg("Ooh, ooh, yes! How nice!\n"
               "Let’s not delay!\r"
               "Should I explain to you how\n"
               "to dress up your Pokémon? {YESNO 0}")
        touchscreenmenuhide
        getmenuchoice(VAR_SPECIAL_RESULT)
        touchscreenmenushow
        if (var(VAR_SPECIAL_RESULT) == 0) {
            npcmsg("You have a Fashion Case, don’t you?\n"
                   "Ah, oui, wonderful!\r"
                   "Just choose the Accessories and put\n"
                   "them on your Pokémon.\r"
                   "When you’re done, I will snap a photo\n"
                   "and put it up beside me!\r"
                   "If you mix your records with others,\n"
                   "you can get their photos, too!\r"
                   "I think it will be much easier if \n"
                   "you will just try! {YESNO 0}")
            goto(_0C7C)
        _0C58:
            touchscreenmenuhide
            getmenuchoice(VAR_SPECIAL_RESULT)
            touchscreenmenushow
            if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0C28) }
            if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0DDA) }
            end
        _0C7C:
            touchscreenmenuhide
            getmenuchoice(VAR_SPECIAL_RESULT)
            touchscreenmenushow
            if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0CA0) }
            if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0DDA) }
            end
        _0CA0:
            getpartycount(VAR_SPECIAL_RESULT)
            if (var(VAR_SPECIAL_RESULT) == 1) {
                setvar(VAR_TEMP_x4002, 0)
                goto(_0D17)
            _0CCC:
                npcmsg("Ooh, I wonder which Pokémon you’ll\n"
                       "dress up?\r")
                closemessage
                fadescreen(6, 1, 0, RGB_BLACK)
                waitfade
                partyselectui
                getpartyselection(VAR_TEMP_x4002)
                restoreoverworld
                fadescreen(6, 1, 1, RGB_BLACK)
                waitfade
                if (var(VAR_TEMP_x4002) == 255) { goto(_0DDA) }
                getpartymonspecies(VAR_TEMP_x4002, VAR_SPECIAL_RESULT)
                if (var(VAR_SPECIAL_RESULT) == 0) {
                    npcmsg("Ooh, non, non, non! That’s an Egg!\n"
                           "It’s too young to be dressing up!\r")
                    goto(_0CCC)
                _0DEE:
                    fadescreen(6, 1, 0, RGB_BLACK)
                    waitfade
                    prompteasychatoneword(0, VAR_SPECIAL_RESULT, VAR_SPECIAL_x8004)
                    restoreoverworld
                    fadescreen(6, 1, 1, RGB_BLACK)
                    waitfade
                    if (var(VAR_SPECIAL_RESULT) == 0) { goto(_0E35) }
                    fashionentrysetmailword(VAR_SPECIAL_x8004)
                    buffereasychatword(0, VAR_SPECIAL_x8004)
                    npcmsg("{STRVAR_1 28, 0, 0}...\r"
                           "Ooh, yes, yes! I get it now!\n"
                           "Your aesthetics shine through!\r")
                    npcmsg("I put your photo up right here.\n"
                           "It just looks so perfect there!")
                    waitbuttonpress
                    closemessage
                    releaseall
                    end
                _0E35:
                    npcmsg("Oh, non, non, non!\n"
                           "It will be forlorn without a title.\r")
                    closemessage
                    goto(_0DEE)
                }
                goto(_0D17)
            _0D17:
                npcmsg("Teeheehee...\n"
                       "I hope you will dress it up adorably!\r")
                closemessage
                getplayerfacing(VAR_SPECIAL_x8006)
                if (var(VAR_SPECIAL_x8006) == 0) { goto(_0D49) }
                if (var(VAR_SPECIAL_x8006) == 2) { goto(_0D4F) }
                if (var(VAR_SPECIAL_x8006) == 3) { goto(_0D55) }
                end
            _0D49:
                goto(_0D5B)
            _0D4F:
                goto(_0D5B)
            _0D55:
                goto(_0D5B)
            _0D5B:
                setflag(FLAG_UNK_08C)
                fadescreen(6, 1, 0, RGB_BLACK)
                waitfade
                opendressup(VAR_TEMP_x4002, VAR_SPECIAL_x8005, VAR_SPECIAL_x8007)
                restoreoverworld
                fadescreen(6, 1, 1, RGB_BLACK)
                waitfade
                if (var(VAR_SPECIAL_x8006) == 0) { goto(_0DAA) }
                if (var(VAR_SPECIAL_x8006) == 2) { goto(_0DB0) }
                if (var(VAR_SPECIAL_x8006) == 3) { goto(_0DB6) }
                end
            _0DAA:
                goto(_0DBC)
            _0DB0:
                goto(_0DBC)
            _0DB6:
                goto(_0DBC)
            _0DBC:
                if (var(VAR_SPECIAL_x8005) == 0) {
                    npcmsg("Oh... You came out without doing\n"
                           "anything... How disappointing.")
                    waitbuttonpress
                    closemessage
                    releaseall
                    end
                }
                setvar(VAR_TEMP_x400A, 1)
                npcmsg("Ooh, nice work!\n"
                       "Let’s display the photo right away!\f"
                       "Oh, but it needs to have a title!\r")
                closemessage
                goto(_0DEE)
            _0DDA:
                npcmsg("Oh, you silly thing...\n"
                       "Where’s your sense of adventure?")
                waitbuttonpress
                closemessage
                releaseall
                end
            }
            if (var(VAR_SPECIAL_RESULT) != 1) { goto(_0CCC) }
            end
        }
        if (var(VAR_SPECIAL_RESULT) == 1) { goto(_0CA0) }
        end
    }
    releaseall
    end
_0C0E:
    setvar(VAR_SPECIAL_x8007, 1)
    return
}

