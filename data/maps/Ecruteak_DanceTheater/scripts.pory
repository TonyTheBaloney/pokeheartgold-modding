    walk_up * 5
    walk_left * 4
    walk_up * 5
    walk_right * 4
    walk_in_place_up
}

movement Ecruteak_DanceTheater_Movement_KimonoGirlWalkUp {
    walk_up
    walk_in_place_down
}

movement Ecruteak_DanceTheater_Movement_KimonoGirlWalkRight2 {
    face_right
    delay_2
    face_up
    delay_2
    face_left
    delay_2
    face_down
    delay_2
    walk_in_place_right
    walk_right * 5
    walk_in_place_down
}

