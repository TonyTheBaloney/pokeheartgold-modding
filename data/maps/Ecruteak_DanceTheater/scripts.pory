}

text msg_0618_T27R0501_00026 {
    "Wonderful!\n"
    "You were so courageous for your age!\r"
    "It was a rare sight to see!\n"
    "I want you to have this.\f"
    "Don’t be shy--take it!\r"
}

text msg_0618_T27R0501_00028 {
    "That’s Surf.\n"
    "It’s a move that lets Pokémon swim\f"
    "across water with ease.\r"
}

