script Ecruteak_DanceTheater_EventScript_KimonoGirl1 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_UNK_410C) == 1) {
        npcmsg("...")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_TEMP_x400A) == 10) {
        bufferplayersname(0)
        npcmsg("You must be {STRVAR_1 3, 0, 0}, correct?\n"
               "That was indeed excellent.\f"
               "Kind and strong...\f"
               "Good at raising Pokémon as well...\r"
               "That person does know what to look for\n"
               "in people...\r"
               "Ohoho! That was just me talking to\n"
               "myself.\f"
               "Never mind.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("For Kimono Girls like me, dancing\n"
           "is everything.\r"
           "I have never gone a day without\n"
           "a dance practice.\r"
           "Pokémon are the same.\r"
           "They grow with you little by little\n"
           "each day.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

