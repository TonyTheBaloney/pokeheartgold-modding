    waitmovement
    getgameversion(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 7) {
        npcmsg(msg_0618_T27R0501_00021)
    } else {
        npcmsg(msg_0618_T27R0501_00022)
    }
    closemessage
    applymovement(obj_T27R0501_dancer_6, Ecruteak_DanceTheater_Movement_0BE4)
    waitmovement
    bufferplayersname(0)
    if (var(VAR_SPECIAL_RESULT) == 7) {
