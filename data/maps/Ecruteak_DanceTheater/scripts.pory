script Ecruteak_DanceTheater_EventScript_Grunt {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    stopbgm(0)
    playbgm(SEQ_GS_EYE_ROCKET)
    npcmsg("Huh? Who are you?\r"
           "You dare to get in my way?\r")
    closemessage
    setvar(VAR_TEMP_x4009, 222)
    trainerbattle(TRAINER_TEAM_ROCKET_GRUNT_26, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    npcmsg("Oh, no!\n"
           "You make me look like a villain!\r")
    closemessage
    getplayerfacing(VAR_SPECIAL_x8004)
    if (var(VAR_SPECIAL_x8004) == 0) {
        applymovement(obj_T27R0501_rocketm_2, Ecruteak_DanceTheater_Movement_RocketGruntWalkUp)
    } elif (var(VAR_SPECIAL_x8004) == 1) {
        applymovement(obj_T27R0501_rocketm_2, Ecruteak_DanceTheater_Movement_RocketGruntWalkDown)
    } elif (var(VAR_SPECIAL_x8004) == 2) {
        applymovement(obj_T27R0501_rocketm_2, Ecruteak_DanceTheater_Movement_RocketGruntWalkLeft)
    } else {
        applymovement(obj_T27R0501_rocketm_2, Ecruteak_DanceTheater_Movement_RocketGruntWalkRight)
    }
    waitmovement
    npcmsg("Oops!\n"
           "I have an important mission.\r"
           "If they find out I was wasting time\n"
           "here, they’ll make me start over\f"
           "as the lowest Team Rocket Grunt!\r"
           "I better leave now!\r")
    closemessage
    if (var(VAR_SPECIAL_x8004) == 0) {
        applymovement(obj_T27R0501_rocketm_2, Ecruteak_DanceTheater_Movement_RocketGruntWalkLeftDown1)
    } elif (var(VAR_SPECIAL_x8004) == 1) {
        applymovement(obj_T27R0501_rocketm_2, Ecruteak_DanceTheater_Movement_RocketGruntWalkLeftDown2)
    } elif (var(VAR_SPECIAL_x8004) == 2) {
        applymovement(obj_T27R0501_rocketm_2, Ecruteak_DanceTheater_Movement_RocketGruntWalkLeftDown3)
    } else {
        applymovement(obj_T27R0501_rocketm_2, Ecruteak_DanceTheater_Movement_RocketGruntWalkDownRight)
    }
    waitmovement
    removeobject(obj_T27R0501_rocketm_2)
    setflag(FLAG_UNK_23A)
    releaseall
    setvar(VAR_UNK_410C, 2)
    setvar(VAR_TEMP_x400A, 10)
    end
}

