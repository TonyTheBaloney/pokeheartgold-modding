    }
    closemessage
    applymovement(obj_T27R0501_dancer, Ecruteak_DanceTheater_Movement_0D1C)
    applymovement(obj_T27R0501_dancer_2, Ecruteak_DanceTheater_Movement_0D28)
    applymovement(obj_T27R0501_dancer_6, Ecruteak_DanceTheater_Movement_0D38)
