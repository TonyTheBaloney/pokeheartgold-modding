script Ecruteak_DanceTheater_OnResume {
    if (var(VAR_UNK_410C) <= 1) {
        makeobjectvisible(obj_T27R0501_rocketm_2)
    }
    if (var(VAR_UNK_410C) == 0) {
        movepersonfacing(obj_T27R0501_rocketm, 6, 0, 6, DIR_EAST)
        movepersonfacing(obj_T27R0501_dancer_3, 8, 0, 6, DIR_WEST)
    }
    if (var(VAR_TEMP_x4009) == 222) {
        movepersonfacing(obj_T27R0501_rocketm, 29, 0, 29, DIR_SOUTH)
        makeobjectvisible(obj_T27R0501_rocketm)
        getplayerfacing(VAR_TEMP_x4000)
        if (var(VAR_TEMP_x4000) == 0) {
            movepersonfacing(obj_T27R0501_rocketm_2, 7, 0, 6, DIR_SOUTH)
        } elif (var(VAR_TEMP_x4000) == 1) {
            movepersonfacing(obj_T27R0501_rocketm_2, 7, 0, 6, DIR_NORTH)
        } elif (var(VAR_TEMP_x4000) == 2) {
            movepersonfacing(obj_T27R0501_rocketm_2, 7, 0, 6, DIR_EAST)
        } else {
            movepersonfacing(obj_T27R0501_rocketm_2, 7, 0, 6, DIR_WEST)
        }
        makeobjectinvisible(obj_T27R0501_rocketm_2)
        setvar(VAR_TEMP_x4009, 0)
    }
    if (var(VAR_TEMP_x400A) != 10) {
        if (var(VAR_UNK_410C) == 3) {
            movepersonfacing(obj_T27R0501_dancer_3, 7, 0, 6, DIR_SOUTH)
        }
    }
    end
}

script Ecruteak_DanceTheater_EventScript_GruntScene {
    followmonresetmovement
    lockall
    npcmsg("{SIZE 200}Hey! Hey!{SIZE 100}\r")
    closemessage
    applymovement(obj_T27R0501_rocketm, Ecruteak_DanceTheater_Movement_GruntFaceRight1)
    waitmovement
    getplayercoords(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    createcameratarget(VAR_SPECIAL_x8004, VAR_SPECIAL_x8005)
    applymovement(241, Ecruteak_DanceTheater_Movement_ObjectWalkUp)
    waitmovement
    wait(10, VAR_SPECIAL_RESULT)
    applymovement(obj_T27R0501_rocketm, Ecruteak_DanceTheater_Movement_GruntWalkRight)
    waitmovement
    npcmsg("Stop dancing such a serious dance!\n"
           "Show me something like a hula dance!\r")
    closemessage
    applymovement(obj_T27R0501_dancer_3, Ecruteak_DanceTheater_Movement_KimonoGirlFaceLeft1)
    waitmovement
    npcmsg("...You mustn’t push such a request\n"
           "on me.\r")
    closemessage
    applymovement(obj_T27R0501_rocketm, Ecruteak_DanceTheater_Movement_GruntFaceRight2)
    waitmovement
    npcmsg("Huh?\n"
           "Are you telling me you don’t respect\f"
           "what the customer wants?\r")
    closemessage
    applymovement(obj_T27R0501_dancer_3, Ecruteak_DanceTheater_Movement_KimonoGirlWalkRight1)
    waitmovement
    npcmsg("Well, then I’ll show you how to dance.\r"
           "I’ll show you a great one.\n"
           "Wahahaha!\r")
    closemessage
    applymovement(obj_T27R0501_rocketm, Ecruteak_DanceTheater_Movement_GruntFaceDown)
    waitmovement
    applymovement(obj_T27R0501_rocketm, Ecruteak_DanceTheater_Movement_GruntSpin)
    applymovement(241, Ecruteak_DanceTheater_Movement_ObjectWalkDown)
    waitmovement
    removecameratarget
    releaseall
    setvar(VAR_UNK_410C, 1)
    end
}

