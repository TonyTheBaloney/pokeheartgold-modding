script Ecruteak_DanceTheater_EventScript_Man {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_TEMP_x400A) == 10) {
        npcmsg("I was supposed to be the hero...!\r"
               "So much for getting close to\n"
               "a Kimono Girl!\n")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_UNK_410C) == 1) {
        if (var(VAR_TEMP_x400B) == 0) {
            npcmsg("Oh... Ouch...!\r"
                   "This stomachache!\r"
                   "I wouldn’t let this guy act like that\n"
                   "were it not for this pain...!")
        } elif (var(VAR_TEMP_x400B) == 1) {
            npcmsg("Oh... Ouch...!\r"
                   "This back pain!\r"
                   "I wouldn’t let this guy act like that\n"
                   "were it not for this pain...!")
        } else {
            npcmsg("Oh... Ouch...!\r"
                   "This toothache!\r"
                   "I wouldn’t let this guy act like that\n"
                   "were it not for this pain...! ")
        }
        waitbuttonpress
        closemessage
        releaseall
        if (var(VAR_TEMP_x400B) < 2) {
            addvar(VAR_TEMP_x400B, 1)
        } else {
            setvar(VAR_TEMP_x400B, 0)
        }
        end
    }
    npcmsg("That man’s always with his PSYDUCK.\r"
           "Says he wants a Pokémon that can\n"
           "Surf and dance.\r"
           "Is he trying to make a Pokémon\n"
           "that stars at synchronized swimming?")
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Ecruteak_DanceTheater_EventScript_OldWoman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_TEMP_x400A) == 10) {
        npcmsg("Quite the Trainer for your age indeed!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    if (var(VAR_UNK_410C) == 1) {
        npcmsg("To do such a terrible thing to\n"
               "a Kimono Girl!\r"
               "I don’t understand how young people\n"
               "behave these days.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("The Kimono Girls are so beautiful...\r"
           "But they have to go through rigorous\n"
           "training.\r"
           "And they have to learn to follow\n"
           "customs before appearing in public.\r"
           "But if you love something, anything\n"
           "is possible.")
    waitbuttonpress
    closemessage
    releaseall
    end
}

