script Ecruteak_DanceTheater_EventScript_ZukiScene {
    followmonresetmovement
    lockall
    setvar(VAR_SPECIAL_x8000, 11)
    setvar(VAR_UNK_410C, 5)
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    applymovement(obj_player, Ecruteak_DanceTheater_Movement_PlayerWalkUpLeft)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    getgameversion(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 7) {
        npcmsg("Welcome.\n"
               "My name is Zuki.\f"
               "I met you previously in Violet City.\r"
               "In order to bring back HO-OH, we\n"
               "needed someone with the right bond\f"
               "with Pokémon.\r"
               "We asked Mr. Pokémon to give this\n"
