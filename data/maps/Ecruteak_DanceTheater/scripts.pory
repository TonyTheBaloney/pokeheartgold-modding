script Ecruteak_DanceTheater_EventScript_Gentleman {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (flag(FLAG_GOT_HM03)) {
        npcmsg("Not only are the Kimono Girls great\n"
               "dancers, they’re also skilled at\f"
               "Pokémon.\r"
               "But they battle only for good reasons.\r"
               "I don’t know if you could defeat them if\n"
               "they showed what they can do...")
        waitbuttonpress
        closemessage
        releaseall
        end
    _05A9:
        callstd(std_bag_is_full)
        closemessage
        releaseall
        end
    }
    npcmsg("What’s the deal with that Team Rocket\n"
           "Grunt, messing with my Kimono Girl?\r"
           "You are a Trainer, aren’t you?\f"
           "Please help her!")
    waitbuttonpress
    closemessage
    releaseall
    end
}

movement Ecruteak_DanceTheater_Movement_GentlemanWalkUpLeft {
    walk_up
    walk_left * 5
    walk_up * 2
}

movement Ecruteak_DanceTheater_Movement_GentlemanWalkDownRight {
    walk_down * 2
    walk_right * 5
    walk_down
    face_up
}

movement Ecruteak_DanceTheater_Movement_GentlemanWalkUpRight {
    walk_up
    walk_right * 3
    walk_up * 2
}

movement Ecruteak_DanceTheater_Movement_GentlemanWalkDownLeft {
    walk_down * 2
    walk_left * 3
    walk_down
    face_up
}

