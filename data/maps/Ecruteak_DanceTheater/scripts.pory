    waitmovement
    removeobject(obj_T27R0501_dancer)
    removeobject(obj_T27R0501_dancer_2)
    removeobject(obj_T27R0501_dancer_6)
    removeobject(obj_T27R0501_dancer_4)
    removeobject(obj_T27R0501_dancer_5)
    removeobject(obj_T27R0501_gsbabygirl1)
    setflag(FLAG_HIDE_DANCE_STUDIO_KIMONO_GIRLS)
    setflag(FLAG_HIDE_DANCE_STUDIO_LITTLE_GIRL)
    call(_0BB0)
    setvar(VAR_UNK_410C, 6)
    setvar(VAR_UNK_40FA, 1)
    if (var(VAR_SPECIAL_RESULT) == 7) {
        clearflag(FLAG_HIDE_BELL_TOWER_SUMMIT_KIMONO_GIRLS)
    } else {
        clearflag(FLAG_HIDE_WHIRL_ISLANDS_BOTTOM_KIMONO_GIRLS)
    }
    end
_0BB0:
    if (var(VAR_SPECIAL_x8000) == 77) {
        releaseall
    } else {
        releaseall
    }
    return
_0BC9:
    whiteout
    call(_0BB0)
    end
_0BD3:
    npcmsg(msg_0618_T27R0501_00014)
