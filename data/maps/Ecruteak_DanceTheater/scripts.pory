script Ecruteak_DanceTheater_EventScript_KimonoGirl4 {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    setvar(VAR_SPECIAL_x8000, 77)
    if (flag(FLAG_UNK_108)) { goto(_0868) }
    if (flag(FLAG_UNK_109)) { goto(_0868) }
    npcmsg("I will test you to see if you are a good\n"
           "Pokémon Trainer.\r"
           "Are you ready? {YESNO 0}")
    touchscreenmenuhide
    getmenuchoice(VAR_SPECIAL_x8004)
    touchscreenmenushow
    if (var(VAR_SPECIAL_x8004) == 1) { goto(_0BD3) }
    closemessage
    getplayerfacing(VAR_SPECIAL_RESULT)
    compare(VAR_SPECIAL_RESULT, 0)
    callifne(_07BA)
    goto(_0944)
    end
_07BA:
    togglefollowingpokemonmovement(0)
    waitfollowingpokemonmovement
    followingpokemonmovement(55)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        applymovement(obj_player, Ecruteak_DanceTheater_Movement_PlayerWalkRightDown)
    } elif (var(VAR_SPECIAL_RESULT) == 2) {
        applymovement(obj_player, Ecruteak_DanceTheater_Movement_PlayerWalkDownLeft)
    } elif (var(VAR_SPECIAL_RESULT) == 3) {
        applymovement(obj_player, Ecruteak_DanceTheater_Movement_PlayerWalkDownRight)
    }
    applymovement(obj_T27R0501_dancer_6, Ecruteak_DanceTheater_Movement_KimonoGirlFaceDown)
    waitmovement
    waitfollowingpokemonmovement
    togglefollowingpokemonmovement(1)
    followingpokemonmovement(48)
    return
}

