    SinjohRuinsExterior_EventScript_Hiker
    SinjohRuinsExterior_OnResume
    SinjohRuinsExterior_EventScript_TrainerTips
}

script SinjohRuinsExterior_OnResume {
    if (var(VAR_SCENE_SINJOH_MYSTRI_ROOM) == 5) {
        movepersonfacing(obj_D51R0101_mount_2, 13, 1, 28, DIR_NORTH)
        end
    }
    end
}

script SinjohRuinsExterior_EventScript_HikerScene {
    followmonresetmovement
    lockall
    applymovement(obj_D51R0101_mount_2, SinjohRuinsExterior_Movement_HikerWalkUp1)
    waitmovement
    applymovement(obj_player, SinjohRuinsExterior_Movement_PlayerFaceRight)
    waitmovement
    npcmsg("Well, hello!\r"
           "It’s so freezing, isn’t it?\r"
           "For a youngster like you to be\n"
           "interested in the Sinjoh Ruins is\f"
           "not something we see every day.\r"
           "Take a look at them.\r"
           "From the design of the pillars at the\n"
           "Sinjoh Ruins, you can see that the\f"
           "cultures of Sinnoh and Johto\f"
           "have blended.\r")
    closemessage
    applymovement(obj_D51R0101_mount_2, SinjohRuinsExterior_Movement_HikerExclamation)
    waitmovement
    npcmsg("What was I thinking?\r"
           "We don’t need to be standing here.\n"
           "Why don’t you come to the cabin\f"
           "around the corner for more discussion?\r")
    closemessage
    applymovement(obj_D51R0101_mount_2, SinjohRuinsExterior_Movement_HikerWalkDownLeft)
    waitmovement
    movepersonfacing(obj_D51R0101_mount_2, 13, 1, 28, DIR_NORTH)
    setvar(VAR_SCENE_SINJOH_MYSTRI_ROOM, 5)
    releaseall
    end
}

movement SinjohRuinsExterior_Movement_HikerWalkUp1 {
    walk_in_place_up
    emote_exclamation_mark
    delay_8
    walk_up * 3
    walk_in_place_left
}

movement SinjohRuinsExterior_Movement_PlayerFaceRight {
    walk_in_place_right
}

movement SinjohRuinsExterior_Movement_HikerExclamation {
    emote_exclamation_mark
    delay_8
}

movement SinjohRuinsExterior_Movement_HikerWalkDownLeft {
    walk_down * 4
    walk_left
    walk_down * 4
}

script SinjohRuinsExterior_EventScript_Hiker {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    npcmsg("By the way, we happen to have a person\n"
           "at the cabin.\r"
           "Any Trainer should know who she is.\n"
           "The famous Trainer from Sinnoh!\r"
           "She is traveling around to study\n"
           "myths and ancient ruins.\f"
           "Isn’t that something?\r")
    closemessage
    applymovement(obj_D51R0101_mount_2, SinjohRuinsExterior_Movement_HikerWalkRightUp)
    waitmovement
    dooranimationload(0, 0, 20, 25, 77)
    dooranimationopen(77)
    dooranimationwait(77)
    applymovement(obj_D51R0101_mount_2, SinjohRuinsExterior_Movement_HikerWalkUp2)
    waitmovement
    removeobject(obj_D51R0101_mount_2)
    setflag(FLAG_UNK_2DB)
    dooranimationclose(77)
    dooranimationwait(77)
    dooranimationunload(77)
    setvar(VAR_SCENE_SINJOH_MYSTRI_ROOM, 6)
    releaseall
    end
}

movement SinjohRuinsExterior_Movement_HikerWalkRightUp {
    walk_right * 7
    walk_up * 2
}

movement SinjohRuinsExterior_Movement_HikerWalkUp2 {
    walk_up
}

script SinjohRuinsExterior_EventScript_TrainerTips {
    trainertipsex(2, "The Sinjoh Ruins")
    end
}

mapscripts SinjohRuinsExterior_MapScripts {
