            applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaFaceDown1)
        } elif (var(VAR_TEMP_x4002) == 3) {
            applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaFaceLeft1)
        } else {
            applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaFaceRight)
        }
        waitmovement
        npcmsg("Cynthia: This is where one might say,\n"
               "“The lead enters the {COLOR 1}Mystri Stage{COLOR 0}\f"
               "at last.”\r"
               "All my study of ruins and Pokémon\n"
               "mythology in Sinnoh may have been\f"
               "to bring you up on this stage\f"
               "here today...\r")
        closemessage
        togglefollowingpokemonmovement(0)
        waitfollowingpokemonmovement
        followingpokemonmovement(55)
        if (var(VAR_TEMP_x4002) == 2) {
            applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaWalkLeft)
        } else {
            applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaWalkRight)
        }
        waitmovement
        if (var(VAR_TEMP_x4002) == 0) {
            applymovement(obj_player, SinjohRuinsMystriStage_Movement_PlayerWalkUp)
            applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaWalkLeftUp)
        } elif (var(VAR_TEMP_x4002) == 3) {
            applymovement(obj_player, SinjohRuinsMystriStage_Movement_PlayerWalkRightUp)
            applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaWalkLeftUp)
        } else {
            applymovement(obj_player, SinjohRuinsMystriStage_Movement_PlayerWalkLeftUp)
            applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaWalkRightUp)
        }
        waitmovement
        waitfollowingpokemonmovement
        togglefollowingpokemonmovement(1)
        followingpokemonmovement(48)
        npcmsg("Cynthia: Depicted on the {COLOR 1}Mystri Stage{COLOR 0}\n"
               "are the Pokémon that shaped\f"
               "this world.\r"
               "The circle in the middle is ARCEUS,\n"
               "the origin of it all...\r")
        closemessage
        applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaWalkRightDown1)
        waitmovement
        npcmsg("Cynthia: This is the pattern that\n"
               "represents PALKIA, the master of\f"
               "space and dimensions...\r")
        closemessage
        applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaWalkDownLeft)
        waitmovement
        npcmsg("Cynthia: This is the pattern that\n"
               "represents DIALGA, the guardian\f"
               "of time...\r")
        closemessage
        applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaWalkUpRight)
        waitmovement
        npcmsg("Cynthia: This is the pattern that\n"
               "represents GIRATINA, the ruler of\f"
               "the world that is on the opposite side\f"
               "of ours, the world of antimatter...\r")
        closemessage
        applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaWalkDown)
        waitmovement
        npcmsg("Cynthia: ARCEUS has accepted you as\n"
               "a Trainer.\r"
               "ARCEUS, having shaped the world,\n"
               "is said to show you a glimpse of\f"
               "its true power.\r"
               "The power of possibly making life\n"
               "appear out of nothing...\r")
        closemessage
        applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaWalkRightDown2)
        applymovement(obj_player, SinjohRuinsMystriStage_Movement_PlayerFaceRight)
        waitmovement
        npcmsg("Cynthia: It seems that something\n"
               "will happen when you choose one\f"
               "of the circles...\r"
               "You’ll want to be well prepared.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
