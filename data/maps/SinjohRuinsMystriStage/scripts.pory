        waitmovement
        npcmsg("Cynthia: This is the pattern that\n"
               "represents PALKIA, the master of\f"
               "space and dimensions...\r")
        closemessage
        applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_0334)
        waitmovement
        npcmsg("Cynthia: This is the pattern that\n"
