script SinjohRuinsMystriStage_EventScript_Cynthia {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    if (var(VAR_SCENE_SINJOH_MYSTRI_ROOM) == 8) {
        npcmsg("Cynthia: Once you are ready, choose a\n"
               "circle and stand in the middle of it.")
        waitbuttonpress
        closemessage
        releaseall
        end
    _0170:
        setvar(VAR_SCENE_SINJOH_MYSTRI_ROOM, 8)
