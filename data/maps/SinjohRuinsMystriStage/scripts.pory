    if (var(VAR_TEMP_x4006) == 1) { goto(_011A) }
    followerpokeiseventtrigger(EVENT_ARCEUS_HALL_OF_ORIGIN, VAR_TEMP_x4005, VAR_TEMP_x4007)
    if (var(VAR_TEMP_x4007) == 1) { goto(_011A) }
    npcmsg("Cynthia: The {COLOR 1}Sinjoh Ruins{COLOR 0} are what\n"
           "remains of a temple built to show\f"
           "respect for ARCEUS.")
    waitbuttonpress
    closemessage
    releaseall
    end
_011A:
    if (var(VAR_TEMP_x4004) == 1) { goto(_0154) }
    npcmsg("Cynthia: This is the {COLOR 1}Mystri Stage{COLOR 0}. The\n"
           "mythical stage built to show respect\f"
           "for ARCEUS.\r"
           "It is said that people used to\n"
           "celebrate its magnificent might with\f"
           "music and dance.\r"
           "Some people in Johto still pass down\n"
           "this tradition.\r")
    closemessage
    getpartycount(VAR_SPECIAL_x8004)
    if (var(VAR_SPECIAL_x8004) >= 2) { goto(_0154) }
    applymovement(obj_D51R0201_champion, SinjohRuinsMystriStage_Movement_CynthiaFaceUp1)
    waitmovement
    npcmsg("Cynthia: According to an ancient\n"
           "document, time, space, and antimatter,\f"
           "or what combined we call the world,\f"
           "shall be born when ARCEUS stands\f"
           "on the {COLOR 1}Mystri Stage{COLOR 0}.\r")
    closemessage
    goto(_0170)
    end
_0154:
    npcmsg("Cynthia: The {COLOR 1}Mystri Stage{COLOR 0} allows a\n"
           "single ARCEUS and nothing else to\f"
           "get on the stage...\r"
           "If you wish to go up there, you have\n"
           "to deposit your other Pokémon in\f"
           "a PC Box at the cabin.")
    waitbuttonpress
    closemessage
    setvar(VAR_TEMP_x4004, 1)
    releaseall
    end
}

