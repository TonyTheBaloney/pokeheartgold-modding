}

script Viridian_Gym_OnTransition {
    viridiangyminit
    setvar(VAR_UNK_4127, 0)
    getphonebookrematch(PHONE_CONTACT_BLUE, VAR_TEMP_x4001)
    if (var(VAR_TEMP_x4001) != 0) {
        setflag(FLAG_HIDE_VIRIDIAN_GYM_BLUE)
        end
    }
    if (var(VAR_UNK_40FD) == 0) { goto(_005F) }
    getweekday(VAR_TEMP_x4002)
    if (var(VAR_TEMP_x4002) == 5) {
        setflag(FLAG_HIDE_VIRIDIAN_GYM_BLUE)
    } else {
        clearflag(FLAG_HIDE_VIRIDIAN_GYM_BLUE)
    }
    end
_005F:
    clearflag(FLAG_HIDE_VIRIDIAN_GYM_BLUE)
    end
}

script Viridian_Gym_EventScript_Blue {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_EARTH, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        if (!flag(FLAG_GOT_TM92_FROM_BLUE)) { goto(_00F0) }
        npcmsg("Blue: ...\r"
               "All right, I was wrong. You’re the\n"
               "real deal.\f"
               "You are a good Trainer.\r"
               "But I’m going to beat you someday.\n"
               "Don’t you forget it!")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Blue: Yo! Finally got here, huh?\r"
           "I wasn’t in the mood at Cinnabar,\n"
           "but now I’m ready to battle you.\r"
           "...\r"
           "You’re telling me you conquered all\n"
           "the Gyms in Johto?\r"
           "Hahaha!\f"
           "Heh! Johto’s Gyms are that pathetic?\r"
           "Hey, don’t worry about it.\n"
           "I’ll know if you are good or not by\f"
           "battling you right now.\r")
    closemessage
    trainerbattle(TRAINER_LEADER_BLUE_BLUE, 0, 0, 0)
    checkbattlewon(VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 0) {
        whiteout
        releaseall
        end
    }
    givebadge(BADGE_EARTH)
    addvar(VAR_UNK_4135, 1)
    setflag(FLAG_UNK_998)
    addspecialgamestat(SCORE_EVENT_BADGE_GET)
    settrainerflag(TRAINER_ACE_TRAINER_M_ARABELLA)
    settrainerflag(TRAINER_ACE_TRAINER_F_SALMA)
    settrainerflag(TRAINER_ACE_TRAINER_M_BONITA)
    settrainerflag(TRAINER_DOUBLE_TEAM_ELAN_AND_IDA)
    setflag(FLAG_UNK_97F)
    clearflag(FLAG_HIDE_ROUTE_10_ZAPDOS)
    setflag(FLAG_HIDE_CERULEAN_CITY_MAN_OUTSIDE_CAVE)
    setvar(VAR_UNK_4096, 1)
    npcmsg("Blue: No way!\r"
           "How the heck did I lose to you?\r"
           "...\r"
           "Tch, all right...\f"
           "Here, take this.\f"
           "It’s the Earth Badge.\r")
    bufferplayersname(0)
    npcmsg("{STRVAR_1 3, 0, 0} received\n"
           "the Earth Badge from Blue!")
    playfanfare(SEQ_ME_BADGE)
    waitfanfare
    npcmsg("Blue: With this Badge, you’ll be able\n"
           "to use the HM move Rock Climb!\f"
           "Here!\r"
           "Take this as well!\r")
    goto(_00F0)
_00F0:
    if (!itemspace(ITEM_TM92, 1)) { goto(_0127) }
    callstd(std_give_item_verbose)
    setflag(FLAG_GOT_TM92_FROM_BLUE)
    bufferplayersname(0)
    npcmsg("Blue: It contains Trick Room!\r"
           "It allows slower Pokémon to move\n"
           "before faster Pokémon for a while.\r"
           "It’s a very tricky move, isn’t it?\n"
           "Hence the name!")
    waitbuttonpress
    closemessage
    releaseall
    end
_0127:
    callstd(std_bag_is_full)
    closemessage
    releaseall
    end
}

script Viridian_Gym_EventScript_GymGuide {
    playse(SEQ_SE_DP_SELECT)
    lockall
    faceplayer
    checkbadge(BADGE_EARTH, VAR_SPECIAL_RESULT)
    if (var(VAR_SPECIAL_RESULT) == 1) {
        npcmsg("Man, you are truly tough...\r"
               "That was such an inspirational battle.\n"
               "It brought tears to my eyes.")
        waitbuttonpress
        closemessage
        releaseall
        end
    }
    npcmsg("Yo, legend in the making!\r"
           "The floor here is unstable,\n"
           "so you should put away your Pokémon\f"
           "...now!\r"
           "The Gym Leader is a guy who battled\n"
           "the Champion three years ago.\r"
           "He’s no pushover.\n"
           "Give it everything you’ve got!")
    followmonrecall
    setfollowmoninhibitstate(1)
    followmonmovetoplayer
    changeobjectmovement(253, 56)
    setvar(VAR_UNK_4127, 1)
    waitbuttonpress
    closemessage
    releaseall
    end
}

script Viridian_Gym_EventScript_GymGuideTrigger {
    followmonresetmovement
    lockall
    if (!flag(FLAG_UNK_13A)) {
        getplayercoords(VAR_TEMP_x4000, VAR_TEMP_x4001)
        if (var(VAR_TEMP_x4000) == 1) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideWalkLeft1)
            applymovement(obj_player, Viridian_Gym_Movement_PlayerFaceRight1)
        } elif (var(VAR_TEMP_x4000) == 2) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideWalkLeft2)
            applymovement(obj_player, Viridian_Gym_Movement_PlayerFaceRight1)
        } elif (var(VAR_TEMP_x4000) == 3) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideWalkLeft3)
            applymovement(obj_player, Viridian_Gym_Movement_PlayerFaceRight1)
        } elif (var(VAR_TEMP_x4000) == 4) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideWalkLeft4)
            applymovement(obj_player, Viridian_Gym_Movement_PlayerFaceRight2)
        } elif (var(VAR_TEMP_x4000) == 5) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideWalkLeft5)
            applymovement(obj_player, Viridian_Gym_Movement_PlayerFaceRight2)
        } elif (var(VAR_TEMP_x4000) == 6) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideExclamation1)
            applymovement(obj_player, Viridian_Gym_Movement_PlayerFaceRight2)
        } elif (var(VAR_TEMP_x4000) == 8) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideExclamation2)
            applymovement(obj_player, Viridian_Gym_Movement_PlayerFaceLeft)
        } else {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideWalkRight1)
            applymovement(obj_player, Viridian_Gym_Movement_PlayerFaceLeft)
        }
        waitmovement
        npcmsg("Yo, legend in the making!\r"
               "The floor here is unstable,\n"
               "so you should put away your Pokémon\f"
               "...now!\r"
               "The Gym Leader is a guy who battled\n"
               "the Champion three years ago.\r"
               "He’s no pushover.\n"
               "Give it everything you’ve got!\r")
        closemessage
        setflag(FLAG_UNK_13A)
        if (var(VAR_TEMP_x4000) == 1) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideWalkRight2)
        } elif (var(VAR_TEMP_x4000) == 2) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideWalkRight3)
        } elif (var(VAR_TEMP_x4000) == 3) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideWalkRight4)
        } elif (var(VAR_TEMP_x4000) == 4) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideWalkRight5)
        } elif (var(VAR_TEMP_x4000) == 5) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideWalkRight6)
        } elif (var(VAR_TEMP_x4000) == 6) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideFaceDown)
        } elif (var(VAR_TEMP_x4000) == 8) {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideFaceDown)
        } else {
            applymovement(obj_T02GYM0101_sunglasses, Viridian_Gym_Movement_GymGuideWalkLeft6)
        }
        waitmovement
    }
    followmonrecall
    setfollowmoninhibitstate(1)
    followmonmovetoplayer
    changeobjectmovement(253, 56)
    setvar(VAR_UNK_4127, 1)
    releaseall
    end
}

